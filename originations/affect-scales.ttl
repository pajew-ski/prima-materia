@prefix pm:      <https://pajew.ski/prima-materia/ontology#> .
@prefix pmc:     <https://pajew.ski/prima-materia/concepts/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#
# prima-materia — modern claims that circulate as old ones
#
# The first file in this directory, and the reason the directory exists. What
# is held here orders no tradition and witnesses none; it begins with a named
# author in a datable work and is afterwards reported as ancient. That is the
# kind of node SPEC §0 calls the most valuable, because it removes a gate
# nobody else is removing.
#

pmc:HawkinsConsciousnessScale a pm:Originating ;
    rdfs:label "The ranking of emotions by measured level"@en, "Die Ordnung der Affekte nach gemessener Stufe"@de ;
    skos:definition "The claim that emotional and mental states occupy fixed positions on a single numbered scale, ascending from shame through fear, anger and pride to reason, love, joy, peace and enlightenment, and that the position can be established by testing."@en ;
    pm:originatedBy "David R. Hawkins" ;
    pm:circulatesAs "A perennial map of consciousness, reported as the distilled agreement of the mystical traditions." ;
    skos:note "No tradition located so far ranks emotions by reach or by energy on a single ordered scale. The seventeen steps, the relative order of shame, guilt, fear and anger, and the placement of willingness are the specific things a later list can be measured against, and they begin here."@en ;
    dcterms:date "1995" ;
    dcterms:source "D. R. Hawkins, Power vs. Force (1995)" .

pmc:HicksEmotionalGuidanceScale a pm:Originating ;
    rdfs:label "The emotional guidance scale"@en, "Die Skala der emotionalen Führung"@de ;
    skos:definition "The claim that emotions form a graded ladder that indicates how near a person stands to a desired state, with joy, knowledge, empowerment, freedom, love and appreciation at its top rung."@en ;
    pm:originatedBy "Esther Hicks and Jerry Hicks" ;
    pm:circulatesAs "A law of the emotions, presented as a description of how feeling works rather than as one author's arrangement." ;
    skos:note "The upper block of this scale reappears almost word for word in later lists that present themselves as older. Recorded so that the wording has a dated first appearance to be checked against."@en ;
    dcterms:date "2004" ;
    dcterms:source "E. Hicks and J. Hicks, Ask and It Is Given (2004), ch. 22" .
