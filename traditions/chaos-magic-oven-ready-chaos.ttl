pmc:ChaosMagicOrcActingAsIfYieldsRitualTension a pm:Yielding ;
    rdfs:label "As-if belief yields ritual tension"@en, "Als-ob-Glaube ergibt rituelle Spannung"@de ;
    skos:definition "Treating the gods as real during the rite builds the required tension."@en ;
    skos:note "The 1995 text carries the practice (pmp:ChaosMagicCondCActingAsIfGodsReal) and the tension (pmc:ChaosMagicCondCRitualTension) but no node joining them."@en ;
    pm:byPractice pmp:ChaosMagicCondCActingAsIfGodsReal ;
    pm:yieldsCapacity pmc:ChaosMagicCondCRitualTension ;
    pm:attestedBy pm:textualAttestation ;
