pmc:ChaosMagicOrcSuspendingDisbelief a pm:Conceptualizing ;
    rdfs:label "Suspension of disbelief"@en, "Aufhebung des Unglaubens"@de ;
    skos:definition "Being able to set one's disbelief aside for a while, named beside adopted belief as a useful faculty for the magician."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:OvenReadyChaos ;
