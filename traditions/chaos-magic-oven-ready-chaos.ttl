    skos:definition "The reading exercise trains suspension of disbelief."@en ;
    skos:note "The 1995 text carries the exercise (pmp:ChaosMagicCondCSuspensionOfDisbelief) but no capacity for it to yield."@en ;
    pm:byPractice pmp:ChaosMagicCondCSuspensionOfDisbelief ;
    pm:yieldsCapacity pmc:ChaosMagicOrcSuspendingDisbelief ;
