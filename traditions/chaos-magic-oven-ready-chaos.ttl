pmc:ChaosMagicOrcSpockInvocationYieldsGradeA a pm:Yielding ;
    rdfs:label "Spock invocation: colleague got an A"@en, "Spock-Anrufung: Kollege erhielt eine Eins"@de ;
    skos:definition "Hine reports that his colleague, after invoking Spock, was awarded an A in the computer exam, and offers this jokingly as the final proof of his argument about belief."@en ;
    skos:note "Differs from pmc:ChaosMagicCondCSpockInvocationYieldsExamResult (Condensed Chaos, 1995): The 1995 node says the colleague scored higher than he otherwise expected; the 1992 text says he got an 'A', offered with 'so there!' as the final proof of the argument."@en ;
    pm:byPractice pmp:ChaosMagicCondCSpockInvocation ;
    pm:yieldsCapacity pmc:ChaosMagicCondCGodFormConcentration ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:OvenReadyChaos ;
