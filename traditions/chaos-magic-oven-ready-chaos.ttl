pmp:ChaosMagicOrcHowlingRetreatPreparation a pm:Practicing ;
    rdfs:label "Preparing the Howling retreat"@en, "Vorbereitung des Howling-Rückzugs"@de ;
    skos:definition "Arrange seclusion; lay in simple, nourishing, easily prepared food (natural substances optional); prepare a black, windowless, bare temple heaped with junk and materials: hardboard, clay, bottles, broken radios, skip rubbish, paints, tools, a spray-gun."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:OvenReadyChaos ;
    dcterms:source "Hine, Oven-Ready Chaos, version 1.4 (on-line edition typeset by the author, text of 1992 first published by Chaos International as Condensed Chaos), Howling; read in the full text of the TealDOC conversion of 2000" .

pmc:ChaosMagicOrcLegionNaming a pm:Naming ;
    rdfs:label "Legion, the Dweller Within"@en, "Legion, der innere Bewohner"@de ;
    skos:definition "The inner dweller to be brought forth is named Legion, i.e. a multitude of one's own demons."@en ;
    pm:nameForm "Legion" ;
    pm:nameRole "the multiple Dweller Within, sum of one's inner demons" ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
