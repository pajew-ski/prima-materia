pmc:ChaosMagicOrcMercuryHermesNaming a pm:Naming ;
    rdfs:label "Mercury / Hermes"@en, "Merkur / Hermes"@de ;
    skos:definition "Considered by Hine's colleague as god-forms to invoke for concentrating the mind on programming, before he settled on Spock."@en ;
    skos:note "Named only as the god-forms Hine's colleague considered and passed over for Mr. Spock (pmc:ChaosMagicCondCSpockNaming). Condensed Chaos carries Hermes only as the messenger of the Eris myth (pmc:ChaosMagicCondAHermesNaming)."@en ;
    pm:nameForm "Mercury", "Hermes" ;
    pm:nameRole "candidate god-forms for mental concentration" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
