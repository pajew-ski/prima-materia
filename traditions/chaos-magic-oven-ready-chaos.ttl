pmp:ChaosMagicOrcFloodingAndVomiting a pm:Practicing ;
    rdfs:label "Flooding and vomiting to evoke demons"@en, "Fluten und Erbrechen zur Evokation von Dämonen"@de ;
    skos:definition "Flood awareness with specific images (taking in and expelling) to call forth a demon, give it form and flesh and at last a name or sigil; play the scrambled tapes as auditory sigils, intensively replaying memories to raise emotional storms; unleash cynicism on a cherished ideal or goal."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:OvenReadyChaos ;
    dcterms:source "Hine, Oven-Ready Chaos, version 1.4 (on-line edition typeset by the author, text of 1992 first published by Chaos International as Condensed Chaos), Howling; read in the full text of the TealDOC conversion of 2000" .

pmp:ChaosMagicOrcOverloadDeprivationGnosis a pm:Practicing ;
    rdfs:label "Gnosis by overload and deprivation"@en, "Gnosis durch Überlastung und Entzug"@de ;
    skos:definition "Use sensory overload, hyperventilation, hunger, thirst and exhaustion; Hine reports going 120 hours without sleep."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:OvenReadyChaos ;
    dcterms:source "Hine, Oven-Ready Chaos, version 1.4 (on-line edition typeset by the author, text of 1992 first published by Chaos International as Condensed Chaos), Howling; read in the full text of the TealDOC conversion of 2000" .

pmc:ChaosMagicOrcParanoiacEdge a pm:Conceptualizing ;
    rdfs:label "Paranoiac edge of consciousness"@en, "Paranoische Bewusstseinsschärfe"@de ;
    skos:definition "A sharp, paranoid edge to consciousness, which Hine says five days awake produced in him."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:OvenReadyChaos ;
    dcterms:source "Hine, Oven-Ready Chaos, version 1.4 (on-line edition typeset by the author, text of 1992 first published by Chaos International as Condensed Chaos), Howling; read in the full text of the TealDOC conversion of 2000" .

pmc:ChaosMagicOrcSleepDeprivationYieldsParanoiacEdge a pm:Yielding ;
    rdfs:label "Sleep deprivation yields paranoiac edge"@en, "Schlafentzug ergibt paranoische Schärfe"@de ;
    skos:definition "120 hours awake produced a paranoiac edge."@en ;
    pm:byPractice pmp:ChaosMagicOrcOverloadDeprivationGnosis ;
    pm:yieldsCapacity pmc:ChaosMagicOrcParanoiacEdge ;
