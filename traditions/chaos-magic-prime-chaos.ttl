pmc:ChaosMagicPrcBSumbleYieldsSelfOwnershipGroup a pm:Yielding ;
    rdfs:label "Sumble yields self-ownership and group cohesion"@en, "Sumble erzeugt Selbstannahme und Gruppenzusammenhalt"@de ;
    skos:definition "Performing the Sumble produces the listed personal and group benefits."@en ;
    pm:byPractice pmp:ChaosMagicPrcBSumble ;
    pm:yieldsCapacity pmc:ChaosMagicPrcBOwningValuesAchievementsGroupConfidence ;
