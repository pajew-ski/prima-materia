pmc:ChaosMagicPrcADiscerningWhatPillOffered a pm:Conceptualizing ;
    rdfs:label "Discerning what pill one is offered"@en, "Erkennen, welche Pille angeboten wird"@de ;
    skos:definition "Magical skill of sensing whether a proffered pill is ecstasy or a vitamin capsule."@en ;
    pm:attestedBy pm:firstPersonReport ;
