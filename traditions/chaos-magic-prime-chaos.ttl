pmp:ChaosMagicPrcAPersonalGrimoireReadingNotes a pm:Practicing ;
    rdfs:label "Personal grimoire from reading notes"@en, "Persönliches Grimoire aus Lesenotizen"@de ;
    skos:definition "After reading a book, note its key points and practical items, then work from the notes rather than the book."@en ;
