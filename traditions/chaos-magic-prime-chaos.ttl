    rdfs:label "Invocation is tricky without due care"@en, "Invokation ist heikel ohne gebührende Sorgfalt"@de ;
    skos:definition "Like any powerful technique, invocation can go awry without proper care and attention."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondCInvocation ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:PrimeChaos ;
