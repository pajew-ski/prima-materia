pmc:ChaosMagicPrcBInspirationThroughBaphomet a pm:Conceptualizing ;
    rdfs:label "Inspiration through Baphomet"@en, "Inspiration durch Baphomet"@de ;
    skos:definition "One might invoke Baphomet for inspiration."@en ;
    pm:attestedBy pm:textualAttestation ;
