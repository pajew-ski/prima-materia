pmp:NewThoughtShinnLawOfDivineProtection a pm:Practicing ;
    rdfs:label "Put whatever you love under divine protection"@en, "Alles, was man liebt, unter göttlichen Schutz stellen"@de ;
    skos:definition "Place loved persons and things under divine protection's law rather than relying on outer safeguards."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnPowerOfTheSpokenWord ;
