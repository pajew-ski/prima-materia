    rdfs:label "Reason drives intuition out"@en, "Der Verstand vertreibt die Intuition"@de ;
    skos:definition "When reasoning enters, intuition leaves; intuition never explains itself."@en ;
    pm:cautionsAbout pmc:NewThoughtShinnIntuition ;
