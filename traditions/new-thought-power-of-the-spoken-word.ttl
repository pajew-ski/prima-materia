pmc:NewThoughtShinnAttainPeace a pm:Conceptualizing ;
    rdfs:label "Peace of mind"@en, "Seelenfrieden"@de ;
    skos:definition "Inner calm reached in the midst of turmoil."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
