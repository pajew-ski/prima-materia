pmc:NewThoughtShinnFaceOfABotticelli a pm:Conceptualizing ;
    rdfs:label "Case: grief-stricken woman transformed into a radiant one"@en, "Fall: verzweifelte Frau in eine strahlende verwandelt"@de ;
    skos:definition "A weeping, haggard, demagnetized woman left by her lover returned within one or two weeks happy, carefree and pretty; conversation and book had given her peace."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnPowerOfTheSpokenWord ;
