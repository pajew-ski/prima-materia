    rdfs:label "Each demonstration proves our power and dominion"@en, "Jede Demonstration beweist unsere Macht und Herrschaft"@de ;
    skos:definition "Every answered demand counts for the author as proof of man's given power and dominion."@en ;
    pm:attestedBy pm:textualAttestation ;
