pmc:NewThoughtShinnWallsAreYourConsciousness a pm:Conceptualizing ;
    rdfs:label "Walls are consciousness; rest in the Christ within"@en, "Mauern sind Bewusstsein; Ruhe im inneren Christus"@de ;
    skos:definition "Jesus' offer of rest refers to the Christ within, the superconscious, free of burdens and battles; doubts, fears and negative pictures dwell in the subconscious."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnPowerOfTheSpokenWord ;
