    rdfs:label "Being spared criticism"@en, "Von Kritik verschont bleiben"@de ;
    skos:definition "The one who does not criticize is said to be kept from being criticized in turn."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
