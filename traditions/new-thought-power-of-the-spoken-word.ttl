pmc:NewThoughtShinnFearPicturesAppearOnTheExternal a pm:Cautioning ;
    rdfs:label "Fear-pictures appear outwardly"@en, "Angstbilder erscheinen im Außen"@de ;
    skos:definition "Distorted imagination projects feared images into external events."@en ;
    pm:cautionsAbout pmc:NewThoughtShinnImagingFaculty ;
    pm:attestedBy pm:textualAttestation ;
