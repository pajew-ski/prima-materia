pmc:NewThoughtShinnProtectsGuidesAndProvidesPresupposesLawOfDivineProtection a pm:Presupposing ;
    rdfs:label "Knowing loved things are divinely protected, in order to keep them"@en, "Wissen um göttlichen Schutz des Geliebten, um es zu behalten"@de ;
    skos:definition "To hold what one prizes one must know it is divinely protected and so beyond harm; behind outer precautions lies a devastating fear picture."@en ;
    pm:dependentStep pmc:NewThoughtShinnProtectsGuidesAndProvides ;
    pm:priorStep pmp:NewThoughtShinnLawOfDivineProtection ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "People lose what they prize through constant fear of its loss." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnPowerOfTheSpokenWord ;
