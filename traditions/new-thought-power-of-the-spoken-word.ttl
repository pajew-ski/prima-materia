pmc:NewThoughtShinnDistributorOfGodPower a pm:Conceptualizing ;
    rdfs:label "Man distributes God-power but does not create it"@en, "Der Mensch verteilt Gotteskraft, erschafft sie aber nicht"@de ;
    skos:definition "Cited from Judge Troward."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
