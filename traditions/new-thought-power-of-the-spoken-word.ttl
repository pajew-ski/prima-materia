pmc:NewThoughtShinnNeverSubmitAHunch a pm:Cautioning ;
    rdfs:label "Never put a hunch before a reasoner"@en, "Eine Eingebung nie jemandem auf der Verstandesebene vorlegen"@de ;
    skos:definition "Obey intuitive leads instantly instead of having them judged by reasoners."@en ;
    pm:cautionsAbout pmp:NewThoughtShinnCommittingYourWaysUntoTheLord ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
