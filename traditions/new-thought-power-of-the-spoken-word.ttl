pmc:NewThoughtShinnExpandingRapidlyIntoTheDivinePlan a pm:Conceptualizing ;
    rdfs:label "Expansion into the Divine Plan: renewed body and environment"@en, "Hineinwachsen in den göttlichen Plan: erneuerter Leib und Umwelt"@de ;
    skos:definition "Rapid changes are promised: new ideas and ideals, a chemical change in the body, improved surroundings, entry into a state where conditions are permanently perfect."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnPowerOfTheSpokenWord ;
