    rdfs:label "At-one-ment with Divine Mind"@en, "Einssein mit dem göttlichen Geist"@de ;
    skos:definition "Attainment of a consciousness uninfluenced by outer sensation and in complete union with Divine Mind."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
