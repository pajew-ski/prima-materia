pmp:NewThoughtShinnMoreThanEqualToEverySituation a pm:Practicing ;
    rdfs:label "Realize that you are fully equipped and equal to every situation"@en, "Verwirklichen, dass man voll ausgerüstet und jeder Lage gewachsen ist"@de ;
    skos:definition "Get the inner realization behind the statements that one is completely furnished for the Divine Plan and above any situation."@en ;
    skos:note "Statement to be realized; functions as an affirmation."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
