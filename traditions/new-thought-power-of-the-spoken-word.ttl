pmc:NewThoughtShinnSubtleSilentAndIrresistible a pm:Naming ;
    rdfs:label "God-power as subtle, silent, irresistible"@en, "Gotteskraft als fein, still, unwiderstehlich"@de ;
    skos:definition "It levels mountains, fills valleys and knows no defeat."@en ;
    pm:nameForm "God power" ;
    pm:nameRole "undefeatable divine agency" ;
    pm:attestedBy pm:textualAttestation ;
