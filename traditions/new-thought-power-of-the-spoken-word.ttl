    rdfs:label "Affirmation: I only desire what Infinite Intelligence desires through me"@en, "Affirmation: ich begehre nur, was die Unendliche Intelligenz durch mich begehrt"@de ;
    skos:definition "Declare that one wishes only what the divine wishes through one and claim one's own by Divine right, under Grace and in a perfect way."@en ;
    skos:note "Affirmation."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
