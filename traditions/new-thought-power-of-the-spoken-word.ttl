pmc:NewThoughtShinnPoorNellie a pm:Cautioning ;
    rdfs:label "Do not call someone 'poor': it demagnetizes them"@en, "Niemanden 'arm' nennen: das entmagnetisiert"@de ;
    skos:definition "The mother's constant pity-phrase was helping to demagnetize her daughter."@en ;
    pm:cautionsAbout pmp:NewThoughtShinnLuckyNellie ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnPowerOfTheSpokenWord ;
