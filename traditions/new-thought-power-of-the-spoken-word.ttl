pmp:NewThoughtShinnTransmuteFearIntoFaith a pm:Practicing ;
    rdfs:label "Transmute fear into faith"@en, "Furcht in Glauben verwandeln"@de ;
    skos:definition "Since fear is faith's opposite, convert it into faith."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
