pmc:NewThoughtShinnOutOfTheWoods a pm:Conceptualizing ;
    rdfs:label "Finding the way out of any difficulty"@en, "Den Ausweg aus jeder Schwierigkeit finden"@de ;
    skos:definition "Led by intuition one gets out of the woods, out of a jungle, or steers a ship; intuition tells one to step over the illusory rope of doubt."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnPowerOfTheSpokenWord ;
