pmp:NewThoughtShinnPictureOfPeaceHarmonyAndBeauty a pm:Practicing ;
    rdfs:label "Build up an inner image of peace, harmony, beauty"@en, "Ein Bild von Frieden, Harmonie und Schönheit aufbauen"@de ;
    skos:definition "Hold and develop in consciousness an image of peaceful, harmonious and beautiful conditions until it externalizes."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnPowerOfTheSpokenWord ;
