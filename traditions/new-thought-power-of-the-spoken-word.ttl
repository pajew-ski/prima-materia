pmc:NewThoughtShinnMasterWorkmanWithWords a pm:Conceptualizing ;
    rdfs:label "Words are the master workman's tools"@en, "Worte sind die Werkzeuge des Meisterhandwerkers"@de ;
    skos:definition "One builds with words and must build constructively in line with the Divine Plan."@en ;
    pm:attestedBy pm:textualAttestation ;
