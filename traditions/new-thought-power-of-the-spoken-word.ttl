pmp:NewThoughtShinnGladYouAreYourself a pm:Practicing ;
    rdfs:label "Begin with gladness at being oneself"@en, "Damit beginnen, froh zu sein, man selbst zu sein"@de ;
    skos:definition "As first step toward success, cultivate gladness at being oneself instead of wishing to be someone else."@en ;
    skos:note "Illustrated by a London street song she saw sold."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnPowerOfTheSpokenWord ;
