pmp:NewThoughtShinnDietOfTheRightWords a pm:Practicing ;
    rdfs:label "A diet of right words: continual affirmation"@en, "Eine Diät der rechten Worte: fortgesetzte Affirmation"@de ;
    skos:definition "As dieters discipline their food, deliberately and continually make a statement of Truth to build a constructive idea in consciousness, since one literally eats one's words."@en ;
    skos:note "The rationale given for affirmation as such."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnPowerOfTheSpokenWord ;
