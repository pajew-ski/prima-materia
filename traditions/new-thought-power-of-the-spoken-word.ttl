pmp:NewThoughtShinnWithDivineEnthusiasmIBless a pm:Practicing ;
    rdfs:label "Closing affirmation blessing one's possessions with divine enthusiasm"@en, "Schlussaffirmation: mit göttlicher Begeisterung segne ich, was ich habe"@de ;
    skos:definition "Bless one's present possessions and watch with wonder for their increase."@en ;
    skos:note "Affirmation closing the book."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
