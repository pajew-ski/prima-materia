    rdfs:label "Make all things new by words of Truth"@en, "Durch Wahrheitsworte alles neu machen"@de ;
    skos:definition "Use words of Truth to renew mind, body and affairs."@en ;
    skos:note "Interpreted Revelation 21:5."@en ;
