pmp:NewThoughtShinnProveGodByDirectingGodPower a pm:Practicing ;
    rdfs:label "Proving God: direct divine power, then trust it"@en, "Gott beweisen, indem man die Gotteskraft lenkt und ihr vertraut"@de ;
    skos:definition "Direct divine power toward a goal and trust it to do the work; each demonstration is a proof of God."@en ;
    skos:note "Interpreted Malachi 3:10."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnPowerOfTheSpokenWord ;
