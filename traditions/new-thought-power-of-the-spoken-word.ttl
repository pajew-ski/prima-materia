pmc:NewThoughtShinnUnderstandingFaith a pm:Conceptualizing ;
    rdfs:label "An age of understanding faith"@en, "Ein Zeitalter des verstehenden Glaubens"@de ;
    skos:definition "All things are put under our understanding; peasant faith gives way to understanding faith, i.e. grasp of spiritual law so that inner power is distributed constructively (after Solomon's call to get understanding)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
