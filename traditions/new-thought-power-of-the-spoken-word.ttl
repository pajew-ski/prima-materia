pmc:NewThoughtShinnPayingHerKarmicDebt a pm:Conceptualizing ;
    rdfs:label "Case: gossip paying her karmic debt"@en, "Fall: Klatschbase zahlt ihre karmische Schuld"@de ;
    skos:definition "A woman who loved other people's affairs and lived on hearsay met great unhappiness, her own affairs now known to all."@en ;
    skos:note "Author's term: \"Karmic debt\"."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that goes wrong or does not come, and its cause."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:NewThought ;
