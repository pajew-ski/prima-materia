pmp:NewThoughtShinnAskWithPraiseAndThanksgiving a pm:Practicing ;
    rdfs:label "Asking with praise and gratitude"@en, "Mit Lob und Dank bitten oder wünschen"@de ;
    skos:definition "Frame requests in praise and gratitude rather than resentment."@en ;
    pm:attestedBy pm:textualAttestation ;
