    rdfs:label "Affirmation of the healed blind man"@en, "Affirmation: ich war blind, nun sehe ich"@de ;
    skos:definition "Say to oneself the healed blind man's words, applying them to blindness toward one's good, opportunities and intuitive leads."@en ;
    skos:note "Affirmation from John 9."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
