pmp:NewThoughtShinnFeelingThatYouAreAlreadyThere a pm:Practicing ;
    rdfs:label "Spiritual realization: feel you are already there"@en, "Geistige Verwirklichung: fühlen, schon dort zu sein"@de ;
    skos:definition "Instead of picturing, realize the goal spiritually, feeling already in the place and being in its vibration."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnPowerOfTheSpokenWord ;
