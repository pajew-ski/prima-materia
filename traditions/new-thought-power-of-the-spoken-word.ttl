pmc:NewThoughtShinnPullingTheStringsHimself a pm:Conceptualizing ;
    rdfs:label "Man unknowingly pulls the strings of invisible forces"@en, "Der Mensch zieht unwissend die Faden unsichtbarer Kräfte"@de ;
