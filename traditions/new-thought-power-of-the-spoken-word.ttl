pmc:NewThoughtShinnGodIsLoveButGodIsLaw a pm:Conceptualizing ;
    rdfs:label "God is Love but also Law"@en, "Gott ist Liebe, aber auch Gesetz"@de ;
    skos:definition "Divine love is paired with lawfulness; commandments are read as laws."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnPowerOfTheSpokenWord ;
