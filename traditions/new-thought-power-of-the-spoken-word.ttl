pmc:NewThoughtShinnDissolveNegativeThoughtForms a pm:Conceptualizing ;
    rdfs:label "Negative thought-forms dissolved; outer pictures changed"@en, "Negative Gedankenformen aufgelöst; äußere Bilder verändert"@de ;
    skos:definition "Childhood beliefs that life is hard got impressed and fulfilled; with Truth these external pictures change as subconscious beliefs change."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnPowerOfTheSpokenWord ;
