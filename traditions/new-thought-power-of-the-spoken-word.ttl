pmc:NewThoughtShinnHeAndTheFatherWereOne a pm:Conceptualizing ;
    rdfs:label "Jesus knew He and the Father were one"@en, "Jesus wusste, dass Er und der Vater eins sind"@de ;
    skos:definition "Hence all things were possible to Him; his miracles roused the multitude's enthusiasm."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
