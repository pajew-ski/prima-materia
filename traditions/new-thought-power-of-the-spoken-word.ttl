pmp:NewThoughtShinnPrayWithPraiseAndThanksgiving a pm:Practicing ;
    rdfs:label "Pray with praise and thanksgiving, non-resistant and expectant"@en, "Mit Lob und Dank beten, widerstandslos und erwartungsvoll"@de ;
    skos:definition "Be poised, peaceful and non-resistant, expecting the good, letting God create His own channels."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnPowerOfTheSpokenWord ;
