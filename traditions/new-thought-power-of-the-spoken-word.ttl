pmp:NewThoughtShinnAskWithThanksgivingFreeFromWorry a pm:Practicing ;
    rdfs:label "Free of worry, ask with thanksgiving"@en, "Frei von Sorge mit Dank bitten"@de ;
    skos:definition "Following Philippians 4:6, make requests known to God with prayer and gratitude, without anxiety; the good is then given."@en ;
    skos:note "Second treatment of the verse (cf. ch. 7)."@en ;
    pm:attestedBy pm:textualAttestation ;
