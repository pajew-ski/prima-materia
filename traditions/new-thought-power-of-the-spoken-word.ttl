pmp:NewThoughtShinnStatementOfTruthWhenDiscouraged a pm:Practicing ;
    rdfs:label "Make a statement of Truth when discouraged, angry or resentful"@en, "Bei Entmutigung, Zorn oder Groll einen Wahrheitssatz sprechen"@de ;
    skos:definition "Precisely in such moods speak a Truth statement, for example asking that the way be revealed, to leave despair and limitation."@en ;
    skos:note "Affirmation: a short request for revelation of the way."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnPowerOfTheSpokenWord ;
