pmc:NewThoughtShinnFearAndWorryAreTwins a pm:Conceptualizing ;
    rdfs:label "Fear and worry are twins"@en, "Furcht und Sorge sind Zwillinge"@de ;
    skos:definition "Worry is fear by another name; fearlessness would dry up the worry cells."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnPowerOfTheSpokenWord ;
