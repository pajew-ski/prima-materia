    rdfs:label "Link with intuition at every moment"@en, "In jedem Augenblick mit der Intuition verbinden"@de ;
    skos:definition "Acknowledge God in all ways by turning to intuition moment by moment, instead of thinking situations out."@en ;
    skos:note "Interpreted Proverbs 3:6."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
