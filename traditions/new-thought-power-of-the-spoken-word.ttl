    rdfs:label "Harmonious conditions made visible"@en, "Sichtbar gewordene harmonische Verhältnisse"@de ;
    skos:definition "The held picture is said eventually to push itself into visible form."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
