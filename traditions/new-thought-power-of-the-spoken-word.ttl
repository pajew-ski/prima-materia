pmc:NewThoughtShinnTheWorldIsYours a pm:Conceptualizing ;
    rdfs:label "The world is yours: joyful entry into the kingdom"@en, "Die Welt gehört einem: freudiger Einzug ins Reich"@de ;
    skos:definition "Success and happiness depend on poise and balance."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnPowerOfTheSpokenWord ;
