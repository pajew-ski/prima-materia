    rdfs:label "Picture of peace yields visible harmony"@en, "Friedensbild bewirkt sichtbare Harmonie"@de ;
    skos:definition "Some day, the text says, the image becomes visible."@en ;
    pm:byPractice pmp:NewThoughtShinnPictureOfPeaceHarmonyAndBeauty ;
