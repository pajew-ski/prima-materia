    rdfs:label "Man gives direction to God-power through himself"@en, "Der Mensch gibt der Gotteskraft durch sich selbst die Richtung"@de ;
    skos:definition "Attuned to it, he holds everything in subjection."@en ;
    pm:attestedBy pm:textualAttestation ;
