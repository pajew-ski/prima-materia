pmc:ChaosMagicAnimalTelepathy a pm:Conceptualizing ;
    rdfs:label "Telepathic contact with animals"@en, "Telepathische Verbindung mit Tieren"@de ;
    skos:definition "Telepathic contact with beasts, by the subtle aethers that transfer thought and emotion."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
