pmp:ChaosMagicAnimalTelepathyPractice a pm:Practicing ;
    rdfs:label "Practising telepathic contact with beasts, dogs above all"@en, "Telepathische Verbindung mit Tieren üben, vor allem mit Hunden"@de ;
    skos:definition "The adept may practise telepathic contact with various beasts, dogs being particularly suitable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
