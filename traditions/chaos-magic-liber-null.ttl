pmp:ChaosMagicMoonbathing a pm:Practicing ;
    rdfs:label "Moonbathing"@en, "Mondbaden"@de ;
    skos:definition "Exposing oneself to strong moonlight, of which the work says there are few things more invigorating."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:LiberNullAndPsychonaut ;
    dcterms:source "Carroll, Liber Null and Psychonaut (York Beach: Samuel Weiser, 1987; fifth printing, 1997), Psychonaut, Magical Time, p. 143; read in a full-text layer whose running heads carry the page" .

pmc:ChaosMagicLunarEnergising a pm:Conceptualizing ;
    rdfs:label "The psychophysical energising of strong moonlight"@en, "Die psychophysische Belebung durch starkes Mondlicht"@de ;
    skos:definition "Strong moonlight is said to exert a general psychophysical energising effect on a variety of plant and animal life whose growth and behaviour it influences, and on the human moonbather."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:LiberNullAndPsychonaut ;
    dcterms:source "Carroll, Liber Null and Psychonaut (York Beach: Samuel Weiser, 1987; fifth printing, 1997), Psychonaut, Magical Time, p. 143; read in a full-text layer whose running heads carry the page" .

pmc:ChaosMagicMoonbathingYieldsLunarEnergising a pm:Yielding ;
    rdfs:label "Moonbathing is said to invigorate"@en, "Mondbaden soll beleben"@de ;
    skos:definition "There are said to be few things more invigorating than moonbathing."@en ;
    pm:byPractice pmp:ChaosMagicMoonbathing ;
    pm:yieldsCapacity pmc:ChaosMagicLunarEnergising ;
    pm:attestedBy pm:textualAttestation ;
