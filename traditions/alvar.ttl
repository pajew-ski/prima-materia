pmc:AlvarTvm0301Payan a pm:Yielding ;
    rdfs:label "Tiruvāymoḻi 3.1.11: the decad is said to yield freedom from rebirth"@en, "Tiruvāymoḻi 3.1.11: Frucht der Dekade: Nicht wiedergeboren werden"@de ;
    pm:byPractice pmp:AlvarIppattu ;
    pm:yieldsCapacity pmc:AlvarPiravaamai ;
    skos:note "Tamil: uyakkoṇṭu piṟappu aṟukkum. Bharati: will break the cords of rebirth and secure heaven. Satyamurthi Ayyangar: will from rebirth rid men of this world."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Alvar ;
    pm:fromWork pmw:AlvarTiruvaymoli ;
