pmc:AlvarTvm0303Payan a pm:Yielding ;
    rdfs:label "Tiruvāymoḻi 3.3.11: the decad is said to yield fame and standing among men"@en, "Tiruvāymoḻi 3.3.11: Frucht der Dekade: Ruhm und Stand unter den Menschen"@de ;
    pm:byPractice pmp:AlvarIppattu ;
    pm:yieldsCapacity pmc:AlvarPukal ;
    skos:note "Tamil: vallavar vāḻvar vāḻveyti ñālam pukaḻavē. Bharati: wins the life of praise for all. Satyamurthi Ayyangar: shall acquire world-wide fame and everlasting opulence."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Alvar ;
