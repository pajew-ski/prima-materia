    pm:fromWork pmw:AramaicIncantationTextsFromNippur ;
    rdfs:label "A third sister brought to the birth of her child"@en, "Eine dritte Schwester zur Geburt ihres Kindes gebracht"@de ;
    skos:definition "The third statement of effect on the same bowl: salvation for the third daughter, that she be saved by the love of heaven, to wit that she bring to the birth her child."@en ;
    pm:attestedBy pm:textualAttestation ;
