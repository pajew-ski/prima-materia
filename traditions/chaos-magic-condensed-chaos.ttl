pmc:ChaosMagicCondBDreamsConformExpectation a pm:Conceptualizing ;
    rdfs:label "Dreams conform to expectation"@en, "Träume folgen der Erwartung"@de ;
    skos:definition "Dream content is easily made to fit expectation: Freudian analysands have Freudian dreams, Jungian patients Jungian ones."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
