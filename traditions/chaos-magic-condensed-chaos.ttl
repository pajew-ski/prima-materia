pmp:ChaosMagicCondBScentDreamLink a pm:Practicing ;
    rdfs:label "Scent dream-link"@en, "Duft-Traumverbindung"@de ;
    skos:definition "Two people share one perfume until its smell calls up the other; before sleep one breathes it in while relaxed, pictures the other person and states the intent for the dream."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 75; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBTelepathicDreamLink a pm:Conceptualizing ;
    rdfs:label "Telepathic dream link"@en, "Telepathische Traumverbindung"@de ;
    skos:definition "The other person may smell the scent in their dream and become more receptive to telepathic experience; scent acting as a telepathic signal booster."@en ;
    skos:note "The text hedges this (\"possible\")."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
