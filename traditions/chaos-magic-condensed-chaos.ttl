pmc:ChaosMagicCondBSharedDreamsTheirValidation a pm:Conceptualizing ;
    rdfs:label "Shared dreams and their validation"@en, "Geteilte Träume und ihre Überprüfung"@de ;
    skos:definition "A shared dream is when two or more people dream the same or similar elements, or dream of each other; the only validation is to tell the people concerned."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
