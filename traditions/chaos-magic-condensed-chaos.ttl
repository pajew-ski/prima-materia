pmc:ChaosMagicCondBDreamingFuture a pm:Conceptualizing ;
    rdfs:label "Dreaming the future"@en, "Die Zukunft träumen"@de ;
    skos:definition "Precognitive dreaming of things later encountered."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 75; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBPrecognitiveDreams a pm:Conceptualizing ;
    rdfs:label "Precognitive dreams"@en, "Präkognitive Träume"@de ;
    skos:definition "That dreams foretell is an old belief that mattered greatly in ancient states; such dreams may be symbolic, distorted or clear, but which parts count is hard to tell in advance."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 75; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBDreamingOneselfUnvisitedPlace a pm:Practicing ;
    rdfs:label "Dreaming oneself to an unvisited place"@en, "Sich an einen unbekannten Ort träumen"@de ;
    skos:definition "Friends of Hine chose a town none of them knew, planned to go there, and tried in advance to dream their way to it."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 76; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBLongNeckedCatForeseenYield a pm:Yielding ;
    rdfs:label "Long-necked cat foreseen"@en, "Langhalsige Katze vorausgeträumt"@de ;
    skos:definition "One of them kept dreaming of a cat with a long neck; on getting out of the car in the town he almost at once saw a glazed model of such a cat in an antique shop window."@en ;
    pm:byPractice pmp:ChaosMagicCondBDreamingOneselfUnvisitedPlace ;
    pm:yieldsCapacity pmc:ChaosMagicCondBDreamingFuture ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
