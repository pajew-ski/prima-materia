pmp:ChaosMagicCondBOrchestratingGroupSharedDreams a pm:Practicing ;
    rdfs:label "Orchestrating group shared dreams"@en, "Gemeinsame Gruppenträume inszenieren"@de ;
    skos:definition "Use a semi-structured pathworking to set up a basic setting which the participants later try to dream themselves into."@en ;
    skos:note "Presented as building on semi-structured Pathworking (pmp:ChaosMagicCondBSemiStructuredPathworking)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
