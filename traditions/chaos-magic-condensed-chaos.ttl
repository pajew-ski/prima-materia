pmc:ChaosMagicCondBScentLinkYieldsTelepathicDreamingYield a pm:Yielding ;
    rdfs:label "Scent link yields telepathic dreaming (Hine's experiments)"@en, "Duftverbindung ergibt telepathisches Träumen (Hines Versuche)"@de ;
    skos:definition "Hine reports a run of experiments in which he and a partner could wake each other at an agreed hour of the night with scent serving as a telepathic amplifier."@en ;
    pm:byPractice pmp:ChaosMagicCondBScentDreamLink ;
    pm:yieldsCapacity pmc:ChaosMagicCondBTelepathicDreamLink ;
