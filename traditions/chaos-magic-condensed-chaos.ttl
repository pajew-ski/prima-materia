@prefix pm:      <https://pajew.ski/prima-materia/ontology#> .
@prefix pmt:     <https://pajew.ski/prima-materia/traditions/> .
@prefix pmc:     <https://pajew.ski/prima-materia/concepts/> .
@prefix pmp:     <https://pajew.ski/prima-materia/practices/> .
@prefix pmw:     <https://pajew.ski/prima-materia/works/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

#
# prima-materia — chaos magic: Hine, Condensed Chaos
#
# The harvest of one work of the corpus of pmt:ChaosMagic, kept apart from
# traditions/chaos-magic.ttl, which declares the tradition and the work
# (pmw:CondensedChaos) and carries its reading notes and harvest counts.
# Harvested complete under prima-materia#893 with two independent
# extraction passes per part, a comparison of the two by offset and word
# overlap, a check at the text of every item the second pass found and the
# first did not, and a reading of each part by its integrator. Part 1
# (infix CondA): front matter, the foreword by Peter J. Carroll, chapters
# 1-3; part 2 (infix CondB): chapters 4-6; part 3 (infix CondC): chapters
# 7-10, the list of further reading and the notice of the Illuminates of
# Thanateros. Edition: Phil Hine, Condensed Chaos: An Introduction to Chaos
# Magic (Tempe: New Falcon, 1995; first edition 1995, second printing 1996),
# from the copyright page. Cited by chapter and printed page, the page taken
# from the running heads. Signs of success and conditions of failure carry
# a note beginning "Counted as a sign of success:" or "Counted as a
# condition of failure:".
#

#
# Foreword by Peter J. Carroll
#

pmc:ChaosMagicCondASpareSleightOfMind a pm:Conceptualizing ;
    rdfs:label "Spare's sleight-of-mind techniques underlie all magic"@en, "Spares Kunstgriffe des Geistes liegen aller Magie zugrunde"@de ;
    skos:definition "Carroll holds that Austin Spare identified the basic mental sleight-of-mind techniques common to every form of magic, which makes the whole symbolic apparatus of magic optional."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), Foreword by Peter J. Carroll, p. 9; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAQuantumPhysicsSupport a pm:Conceptualizing ;
    rdfs:label "Quantum physics and chaos mathematics as support for chaoist theory"@en, "Quantenphysik und Chaosmathematik als Stütze der Chaostheorie der Magie"@de ;
    skos:definition "Carroll claims quantum physics lends strong support to metaphysical theory, and that chaos mathematics bore out the chaoist assumption that some mechanism must amplify indeterminacy at the subatomic level up to the scale of everyday experience."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), Foreword by Peter J. Carroll, p. 9; read in a full-text layer of the second printing" .


#
# Chapter 1, What Is Chaos Magic?
#

pmc:ChaosMagicCondAMagicIsAboutChange a pm:Conceptualizing ;
    rdfs:label "Magic is about change"@en, "Magie ist Veränderung"@de ;
    skos:definition "Hine defines magic as concerned with change: changing one's circumstances, living by developing personal responsibility, and the claim that one can effect change around oneself; every act of personal or collective liberation counts as magical."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 11; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondADisentanglingConditioning a pm:Conceptualizing ;
    rdfs:label "Disentangling oneself from conditioned attitudes and restrictions"@en, "Loslösung von anerzogenen Haltungen und Beschränkungen"@de ;
    skos:definition "Magic is said to offer a way to free oneself from the attitudes and restrictions of one's upbringing that set the limits of what one may become."@en ;
    skos:note "First item of Hine's list of what magic can offer."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 12; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAModifyingHinderingPatterns a pm:Conceptualizing ;
    rdfs:label "Examining and modifying hindering behaviour, emotion and thought patterns"@en, "Untersuchen und Verändern hinderlicher Verhaltens-, Gefühls- und Denkmuster"@de ;
    skos:definition "Magic is said to give methods to examine one's life and to find, understand and change behavioural, emotional and thought patterns that hinder learning and growth."@en ;
    skos:note "Second item of the same list."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 12; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAConfidenceAndCharisma a pm:Conceptualizing ;
    rdfs:label "Increased confidence and personal charisma"@en, "Gesteigertes Selbstvertrauen und persönliche Ausstrahlung"@de ;
    skos:definition "Magic is said to increase confidence and personal charisma."@en ;
    skos:note "Third item of the same list."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 12; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAWideningPerceptionOfPossible a pm:Conceptualizing ;
    rdfs:label "Widened perception of what is possible"@en, "Erweiterte Wahrnehmung des Möglichen"@de ;
    skos:definition "Magic is said to widen one's sense of what is achievable once one commits heart and mind to it."@en ;
    skos:note "Fourth item of the same list."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 12; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAPersonalAbilitiesSkillsPerceptions a pm:Conceptualizing ;
    rdfs:label "Development of personal abilities, skills and perceptions"@en, "Entwicklung persönlicher Fähigkeiten, Fertigkeiten und Wahrnehmungen"@de ;
    skos:definition "Magic is said to let one cultivate one's own abilities, skills and ways of perceiving; the more one perceives the world, the more one experiences it as alive."@en ;
    skos:note "Fifth item of the same list."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 12; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAMagicShouldBeEnjoyed a pm:Conceptualizing ;
    rdfs:label "Enjoyment through magic"@en, "Freude durch Magie"@de ;
    skos:definition "Having fun is listed as one of the things magic offers; Hine says magic should be enjoyed."@en ;
    skos:note "Sixth item of the same list."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 12; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAChangeInAccordanceWithWill a pm:Conceptualizing ;
    rdfs:label "Bringing about willed change"@en, "Veränderung gemäß dem Willen herbeiführen"@de ;
    skos:definition "Magic is said to bring about change in conformity with the practitioner's will."@en ;
    skos:note "Seventh item of the same list."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 12; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAConceptualWeaponsAndTechniques a pm:Conceptualizing ;
    rdfs:label "Magic as conceptual weapons and techniques for life aims"@en, "Magie als begriffliches Rüstzeug und Techniken für Lebensziele"@de ;
    skos:definition "Magic is presented as an approach to life starting from basic questions (what is needed to survive, how to live, who to be) and supplying conceptual tools and techniques to achieve those aims."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 12; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondACorePrinciples a pm:Systematizing ;
    rdfs:label "Core Principles of Chaos Magic (six)"@en, "Kernprinzipien der Chaosmagie (sechs)"@de ;
    skos:definition "Hine lists six core principles instead of a cosmological map: avoidance of dogmatism, primacy of personal experience, technical excellence, deconditioning, diverse approaches, gnosis. He states they are not universal axioms and may be swapped around."@en ;
    skos:note "The principles are said to be no universal axioms and may be swapped around."@en ;
    pm:compiledBy "Phil Hine, in Condensed Chaos" ;
    dcterms:date "1995"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, pp. 13-15; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAAvoidanceOfDogmatism a pm:Conceptualizing ;
    rdfs:label "Avoidance of dogmatism"@en, "Vermeidung von Dogmatismus"@de ;
    skos:definition "Chaos magicians try not to become dogmatic (except within a temporarily adopted belief system) and allow themselves to revise their views, be inconsistent, and argue both plausibly and implausibly; being wrong now and then is acceptable."@en ;
    skos:note "First of the core principles; Discordian 'catmas' are cited as an example."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 13; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAPersonalExperienceParamount a pm:Conceptualizing ;
    rdfs:label "Personal experience is paramount"@en, "Persönliche Erfahrung hat Vorrang"@de ;
    skos:definition "Readers are told not to accept the author's claims but to test them themselves; magic is said to have suffered from armchair theorists passing on myths and outdated information."@en ;
    skos:note "Second of the core principles."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 13; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondATechniquesSimplyDescribed a pm:Conceptualizing ;
    rdfs:label "Techniques are simple once dogma is stripped"@en, "Techniken sind einfach, sobald das Dogma entfernt ist"@de ;
    skos:definition "Chaos magicians are said to have found that any technique of practical magic, once freed of dogma, belief, attitude and anecdote, can be described quite simply."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, pp. 13-14; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondATechnicalExcellence a pm:Conceptualizing ;
    rdfs:label "Technical excellence: rigorous self-assessment and practice to results"@en, "Technische Exzellenz: strenge Selbstprüfung und Übung bis zum Ergebnis"@de ;
    skos:definition "The chaos approach is said to demand rigorous self-assessment and analysis and continued practice of a technique until the desired results are obtained; doing magic requires developing a set of skills."@en ;
    skos:note "Third of the core principles."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 14; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASloppinessMisconceptionCautela a pm:Cautioning ;
    rdfs:label "Misreading chaos magic as licence for sloppiness"@en, "Fehlverständnis der Chaosmagie als Freibrief zur Nachlässigkeit"@de ;
    skos:definition "Hine warns against the early misconception that chaos magic lets practitioners do whatever they like and grow sloppy in self-assessment and analysis."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondATechnicalExcellence ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 14; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondADeconditioning a pm:Conceptualizing ;
    rdfs:label "Detachment from beliefs and ego-fictions (deconditioning)"@en, "Ablösung von Überzeugungen und Ich-Fiktionen (Dekonditionierung)"@de ;
    skos:definition "Deconditioning exercises are said to widen cracks in consensual reality and hopefully make one less attached to beliefs and ego-fictions, so that one can discard or alter them when appropriate."@en ;
    skos:note "Fourth of the core principles. The deconditioning exercises are announced here and given later in the book, outside this part."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 14; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAEgoFictionOfSelfhood a pm:Conceptualizing ;
    rdfs:label "Ego as fiction of stable selfhood"@en, "Ich als Fiktion stabiler Selbstheit"@de ;
    skos:definition "The ego is described as a fiction maintained by distinctions of what one is and likes and by beliefs about politics, religion, gender, free will, race and subculture."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 14; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondADeconditioningPrimaryTask a pm:Presupposing ;
    rdfs:label "Deconditioning as primary task of the aspiring magician"@en, "Dekonditionierung als Hauptaufgabe des angehenden Magiers"@de ;
    skos:definition "The chaos paradigm names thorough deconditioning from the beliefs, attitudes and fictions held about self, society and world as one of the first tasks of anyone aspiring to be a magician."@en ;
    skos:note "No consequence of skipping is stated."@en ;
    pm:priorStep pmc:ChaosMagicCondADeconditioning ;
    pm:dependentStep pmc:ChaosMagicCondAMagicianScienceOfExtremes ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 14; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondADiverseApproaches a pm:Conceptualizing ;
    rdfs:label "Diverse approaches / eclecticism"@en, "Vielfalt der Ansätze / Eklektizismus"@de ;
    skos:definition "Unlike traditional single-system practice, chaos magicians may draw on any magical system, literature, television, religions, cults or parapsychology; consequently there is little consensus between practitioners."@en ;
    skos:note "Fifth of the core principles."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 14; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAGnosisAtWill a pm:Conceptualizing ;
    rdfs:label "Willed entry into altered states (gnosis)"@en, "Willentlicher Eintritt in veränderte Bewusstseinszustände (Gnosis)"@de ;
    skos:definition "Being able to shift into altered states of consciousness deliberately is called a key element of magical ability."@en ;
    skos:note "Sixth of the core principles."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 15; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAInhibitoryExcitatoryGnosis a pm:Conceptualizing ;
    rdfs:label "Inhibitory and excitatory gnosis"@en, "Zwei Pole physiologischer Gnosis: hemmend und erregend"@de ;
    skos:definition "Deliberately entering strong altered states falls, as physiological gnosis, between two poles: the inhibitory (meditation, yoga, scrying, contemplation, sensory deprivation) and excitatory ones (dance, drumming, chanting, sexual or emotional arousal). Everyday consciousness is said to move between states all the time anyway."@en ;
    skos:note "The techniques are only named here, without steps."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 15; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASpareAgainstGoldenDawn a pm:Conceptualizing ;
    rdfs:label "Spare against the Golden Dawn style"@en, "Spare gegen den Golden-Dawn-Stil"@de ;
    skos:definition "Hine reports that Spare had little liking for the Golden Dawn style of magic and made acid remarks about it in his Book of Pleasure of 1913."@en ;
    skos:note "Hine ascribes this to a work he names and does not cite by edition: Austin Osman Spare, The Book of Pleasure (1913), as cited by Hine without page. The node holds what Condensed Chaos reports; the named work is reachable in its own right and is not read here, so the node is entered as Hine's ascription and not as a mediated reading of that work."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 16; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASentientLetters a pm:Conceptualizing ;
    rdfs:label "Manifesting desires through sigils (Spare)"@en, "Wünsche durch Sigillen verwirklichen (Spare)"@de ;
    skos:definition "Spare is said to have used his own system of letters he regarded as sentient, i.e. sigils, to bring his desires about, and to have painted the spirits he communicated with."@en ;
    skos:note "The sigil method itself is not described in this part of the book."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 16; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondATechniquesSharedAcrossSystems a pm:Conceptualizing ;
    rdfs:label "Techniques are shared across systems; belief is means not end (Liber Null)"@en, "Techniken sind systemübergreifend; Glaube ist Mittel, nicht Zweck (Liber Null)"@de ;
    skos:definition "Hine reports that Carroll's Liber Null gave the bare techniques for changing one's circumstances and held that the working methods of magic are basically common to the different systems whatever their symbols and dogmas, that the choice of symbol system is free, and that the beliefs around it serve as means and not as ends."@en ;
    skos:note "Hine ascribes this to a work he names and does not cite by edition: Peter J. Carroll, Liber Null, as cited by Hine without edition or page. The node holds what Condensed Chaos reports; the named work is reachable in its own right and is not read here, so the node is entered as Hine's ascription and not as a mediated reading of that work."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 17; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAErisNaming a pm:Naming ;
    rdfs:label "Eris"@en, "Eris"@de ;
    skos:definition "Eris is named as the Greek goddess of chaos and confusion whom the Discordians revere: traditionally a daughter of Nox and wife of Chronus, mother of Sorrow, Hunger, Forgetfulness, Disease, Combat, Murder and Lies, and blamed by the Greeks for any upset; snubbed at a party of Zeus she threw a golden apple marked Kallisti among the guests, which led to the Trojan War. Modern Discordians are said to link her with intrusions of weirdness, synchronicity, mischief, creative flashes and wild parties."@en ;
    skos:note "Hine jokingly suspects her of having had a hand in the first bureaucracies."@en ;
    pm:nameForm "Eris" ;
    pm:nameRole "Greek goddess of chaos, discord and confusion; revered by the Discordian Society" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, pp. 17-19; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAErisMessageReceiving a pm:Receiving ;
    rdfs:label "Eris's message to the Discordian founders"@en, "Botschaft der Eris an die Gründer des Diskordianismus"@de ;
    skos:definition "Eris is said to have appeared to two young Californians in the late 1950s, to have appointed them guardians of the Sacred Chao, and to have charged them to tell humankind that there are no rules except those it chooses to invent."@en ;
    pm:receivedBy "Two young Californians later known as Omar Ravenhurst and Malaclypse the Younger, as Hine retells the Discordian account" ;
    pm:claimedSpeaker "Eris, Greek goddess of chaos" ;
    pm:receptionCircumstance "An appearance of the goddess in the late 1950s, in which she is said to have appointed the two Keepers of the Sacred Chao; no further circumstances are given." ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 18; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondANoxNaming a pm:Naming ;
    rdfs:label "Nox"@en, "Nox"@de ;
    skos:definition "Nox, night, is named as the mother of Eris in the traditional account."@en ;
    pm:nameForm "Nox" ;
    pm:nameRole "night; mother of Eris" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 18; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAZeusNaming a pm:Naming ;
    rdfs:label "Zeus"@en, "Zeus"@de ;
    skos:definition "Zeus is named as the god who gave a party without inviting Eris, then ordered the three goddesses quarrelling over her apple to accept a judgement by Paris and sent them to him."@en ;
    pm:nameForm "Zeus" ;
    pm:nameRole "Olympian god, host of the feast in the Eris myth" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, pp. 18-19; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAAthenaNaming a pm:Naming ;
    rdfs:label "Athena"@en, "Athena"@de ;
    skos:definition "Athena is named as one of the three goddesses who claimed the apple of Eris; she offered Paris victory in battle and afterwards meddled towards the Trojan War."@en ;
    pm:nameForm "Athena" ;
    pm:nameRole "Olympian goddess; claimant of the golden apple" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, pp. 18-19; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAHeraNaming a pm:Naming ;
    rdfs:label "Hera"@en, "Hera"@de ;
    skos:definition "Hera is named as one of the three goddesses who claimed the apple of Eris; she offered Paris great wealth and afterwards meddled towards the Trojan War."@en ;
    pm:nameForm "Hera" ;
    pm:nameRole "Olympian goddess; claimant of the golden apple" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, pp. 18-19; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAAphroditeNaming a pm:Naming ;
    rdfs:label "Aphrodite"@en, "Aphrodite"@de ;
    skos:definition "Aphrodite is named as one of the three goddesses who claimed the apple of Eris; she offered Paris the most beautiful mortal woman and was given the apple."@en ;
    pm:nameForm "Aphrodite" ;
    pm:nameRole "Olympian goddess; winner of the golden apple" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, pp. 18-19; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAHermesNaming a pm:Naming ;
    rdfs:label "Hermes"@en, "Hermes"@de ;
    skos:definition "Hermes is named as the messenger through whom Zeus sent the three goddesses to Paris."@en ;
    pm:nameForm "Hermes" ;
    pm:nameRole "Olympian messenger god" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 18; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondALaughterBanishing a pm:Practicing ;
    rdfs:label "Laughter as banishing"@en, "Lachen als Bannung"@de ;
    skos:definition "Some members of the IOT Pact are said to banish by laughing."@en ;
    skos:note "Only the use is named; no steps are given."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 19; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASillyRitualsEffective a pm:Conceptualizing ;
    rdfs:label "Silly rituals are no less effective"@en, "Alberne Rituale wirken nicht schlechter"@de ;
    skos:definition "Hine states that rituals performed in a silly spirit can work as well as solemn ones; humour belongs in magic."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 19; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondANotASystem a pm:Conceptualizing ;
    rdfs:label "Chaos magic uses systems, is not one; results over authenticity"@en, "Chaosmagie benutzt Systeme, ist keines; Ergebnisse vor Authentizität"@de ;
    skos:definition "Chaos magic borrows from SF, quantum physics and anything else as temporary belief or symbol systems; what counts is results, not whether the system is authentic; adherents are encouraged to make their own."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 19; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAExperimentalMagic a pm:Conceptualizing ;
    rdfs:label "Chaos magic as experimental magic"@en, "Chaosmagie als experimentelle Magie"@de ;
    skos:definition "From the start chaos magic is said to be experimental: testing techniques and questioning concepts that occultists accept as implicitly true; practitioners published technical findings to peers in journals like Chaos International."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 20; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAFractalConsciousness a pm:Conceptualizing ;
    rdfs:label "Fractal model of consciousness and learning"@en, "Fraktales Modell von Bewusstsein und Lernen"@de ;
    skos:definition "Consciousness is said to be modelable as fractal; learning and creative thinking grow like a fractal from isolated ideas to a perceived new shape; broad attention reveals similar ideas across disciplines and cultures; the fractal as icon of universal interconnection."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, pp. 21-22; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondANormalConsciousnessFacade a pm:Conceptualizing ;
    rdfs:label "'Normal consciousness' as facade; consciousness is analogue"@en, "'Normales Bewusstsein' als Fassade; Bewusstsein ist analog"@de ;
    skos:definition "Since awareness constantly shifts among attention, memory, fantasy, inner dialogue and daydream, the notion of a normal consciousness is called a facade; consciousness changes gradually, not in discrete states."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, pp. 22-23; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAMapAndTerritoryCautela a pm:Cautioning ;
    rdfs:label "Confusing the map with the territory"@en, "Verwechslung von Landkarte und Gebiet"@de ;
    skos:definition "Hine warns of the common tendency to treat the models used to interpret experience as the experience itself; no model describes anything with complete accuracy, only approximately."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondAMagicalModels ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 23; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondANothingIsTrue a pm:Conceptualizing ;
    rdfs:label "Nothing is true, everything is permitted"@en, "Nichts ist wahr, alles ist erlaubt"@de ;
    skos:definition "Watchword attributed to Hassan i Sabbah: if nothing is true, questions of proof lose relevance, responsibility returns to the individual, and beliefs may be chosen as art or play without needing validation."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 23; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASingleTruths a pm:Conceptualizing ;
    rdfs:label "Single truths survive by ignoring what does not fit"@en, "Einzelne Wahrheiten überleben durch Ausblenden des Unpassenden"@de ;
    skos:definition "Essential single truths are said to be maintained only by rigorously ignoring what does not fit, so beliefs survive despite missing evidence."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 23; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondABeliefAsTool a pm:Conceptualizing ;
    rdfs:label "Using belief as a magical tool"@en, "Glauben als magisches Werkzeug nutzen"@de ;
    skos:definition "Chaos magic is said to acknowledge how strong and how pliable belief is; because beliefs quickly become the base of one's interpretation of reality, that capacity can be manipulated for magical purposes."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 23; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAMagicalModels a pm:Systematizing ;
    rdfs:label "Historical models of magic (spirit, energy, psychological, ...)"@en, "Historische Modelle der Magie (Geist, Energie, Psychologie, ...)"@de ;
    skos:definition "Hine orders how magic has been understood into models that follow general shifts of paradigm: the spirit model, the energy model from animal magnetism on, the psychological model, and the cybernetic model now rising; many textbooks mix the first three."@en ;
    pm:compiledBy "Phil Hine, in Condensed Chaos" ;
    dcterms:date "1995"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, pp. 24-25; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASpiritModel a pm:Conceptualizing ;
    rdfs:label "Spirit model of magic"@en, "Geistermodell der Magie"@de ;
    skos:definition "Otherworlds are real and inhabited by discrete entities (elementals, demons, angels, gods); the magician or shaman maps the Otherworld, makes allies there and interacts with spirits to have them carry out one's will (prayer, entheogens to meet ancestors, demonologists threatening entities)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 24; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAEnergyModel a pm:Conceptualizing ;
    rdfs:label "Energy model of magic"@en, "Energiemodell der Magie"@de ;
    skos:definition "From animal magnetism onward: subtle energies exist and can be manipulated by techniques; examples Vril, the Astral Light, ectoplasm, prana, chakras, kundalini, orgone."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 24; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAPsychologicalModel a pm:Conceptualizing ;
    rdfs:label "Psychological model of magic"@en, "Psychologisches Modell der Magie"@de ;
    skos:definition "With popular psychology the Otherworlds became Innerworlds: demons relocated to the unconscious, Hidden Masters read as the Higher Self, tarot turned into a tool for personal transformation, gods seen as archetypes rather than real entities."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 24; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondACyberneticModel a pm:Conceptualizing ;
    rdfs:label "Cybernetic model of magic"@en, "Kybernetisches Modell der Magie"@de ;
    skos:definition "The rising information-age model: the universe is stochastic; magic consists of techniques for stirring up a storm of neural activity that causes microscopic fluctuations which eventually lead to macroscopic change according to intent (butterfly effect). Said to dovetail back into the spirit model."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, pp. 24-25; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAShiftingModels a pm:Conceptualizing ;
    rdfs:label "Choosing the model by audience and situation"@en, "Wahl des Modells nach Publikum und Lage"@de ;
    skos:definition "To explain magic to sceptics the psychological model is advised; to computer enthusiasts the cyberpunk one; scientists accept things only with a scientific rationale (acupuncture accepted once linked to endorphins). Shifting among models as situations require is called useful; the spirit model can explain almost anything, while the psychological one struggles with curses that strike unbelievers who never saw the shaman."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 25; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASingleModelCautela a pm:Cautioning ;
    rdfs:label "Single-model magic will meet what it cannot fit"@en, "Ein-Modell-Magie trifft auf Unpassendes"@de ;
    skos:definition "Using only one magical model is said to lead sooner or later to the universe presenting something that falls outside its parameters."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondAShiftingModels ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 25; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondADefendingModelsFailure a pm:Conceptualizing ;
    rdfs:label "Defending models instead of modifying them"@en, "Modelle verteidigen statt verändern"@de ;
    skos:definition "Sign that one's model-use has hardened: spending more time defending one's models than changing them; Hine says this means more deconditioning is due."@en ;
    skos:note "Counted as a condition of failure: of working with magical models (pmc:ChaosMagicCondAShiftingModels): one spends more time defending one's models than modifying them. No deadline or rate; the fault lies with the operator, and the remedy named is a further round of deconditioning."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 1 What Is Chaos Magic?, p. 25; read in a full-text layer of the second printing" .


#
# Chapter 2, Magic in the Material World
#

pmc:ChaosMagicCondAHighLowMagicDichotomy a pm:Conceptualizing ;
    rdfs:label "Against the High/Low magic dichotomy of the 19th-century revivalists"@en, "Gegen die Zweiteilung Hohe/Niedere Magie der Erneuerer des 19. Jh."@de ;
    skos:definition "Hine calls the dichotomy of spiritual High Magic versus material Low Magic (sorcery), inherited from the 19th-century occult revival and rooted in post-Enlightenment Christianity's split of spiritual and temporal, a false one; quantum physics and nonlinear dynamics are said to restore awareness that the world is magical. He grants that the older magics nonetheless worked."@en ;
    skos:note "Only Hine's side of the dispute is read; the revivalists are not quoted."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, pp. 26-27; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondATechnologistsOfTheSpiritCautela a pm:Cautioning ;
    rdfs:label "Reducing magic to techniques and instant results"@en, "Reduktion der Magie auf Techniken und schnelle Ergebnisse"@de ;
    skos:definition "Contemporary magic tends to become a profusion of techniques sought for quicker results and instant enlightenment; such technologists of the spirit risk narrowed vision and imbalance like their predecessors."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondANotASystem ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 27; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAMagicIsDangerousCautela a pm:Cautioning ;
    rdfs:label "Magic is powerful, dangerous and not for all"@en, "Magie ist mächtig, gefährlich und nicht für alle"@de ;
    skos:definition "Magic is dangerous like anything that provokes change and is definitely not for everyone, compared to handing out strong psychoactive drugs or letting children play with machinery; its short-term glamour hides different consequences, and what one imagines becoming differs from what years of practice produce."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondAMagicIsAboutChange ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 27; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAAdvancedActsOfMagic a pm:Conceptualizing ;
    rdfs:label "Performing advanced acts of magic"@en, "Fortgeschrittene magische Akte ausführen"@de ;
    skos:definition "Capacity for advanced magical acts, said to need years of learning, training, exercise, analysis and growing self-awareness; that time builds personal codes of ethics and honour that root one's power."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 27; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAYearsBeforeAdvancedMagic a pm:Presupposing ;
    rdfs:label "Years of training before advanced magic"@en, "Jahre der Übung vor fortgeschrittener Magie"@de ;
    skos:definition "Advanced magic is not possible without years of learning, training, exercise, analysis and self-awareness."@en ;
    skos:note "No consequence of skipping is stated."@en ;
    pm:priorStep pmp:ChaosMagicCondARegularPractice ;
    pm:dependentStep pmc:ChaosMagicCondAAdvancedActsOfMagic ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 27; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASacrificeForPowerCautela a pm:Cautioning ;
    rdfs:label "Alienation and sacrifice as the cost of power"@en, "Entfremdung und Opfer als Preis der Macht"@de ;
    skos:definition "The powerful magician stands apart, partly alien; many crave this to feed the ego with superiority, while the adept is likely to mourn lost innocence. Shaping the world means being reshaped oneself; each gain of power demands a sacrifice."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondAAdvancedActsOfMagic ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, pp. 27-28; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAInnerExperienceAloneFailure a pm:Conceptualizing ;
    rdfs:label "Inner experience without phenomenizing it into action"@en, "Innere Erfahrung ohne Umsetzung in Handlung"@de ;
    skos:definition "Sign of illusory power: believing oneself a great magician on inner experience alone, without the ability to turn it into action; such self-proclaimed potent magicians prove impotent in ordinary life."@en ;
    skos:note "Counted as a condition of failure: a self-declared magician who rests on inner experience alone and cannot turn it into action proves impotent in matters of ordinary life. No deadline or rate; the fault lies with the operator."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 28; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondAStatementOfIntent a pm:Practicing ;
    rdfs:label "Statement of Intent"@en, "Absichtserklärung"@de ;
    skos:definition "Every formalised act of magic is to carry a statement of intent, roughly of the form: I will to do X so that result Y follows. It lets the magician relate the technique used to what follows from it."@en ;
    skos:note "Its practicalities are promised for later in the book, outside this part."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 28; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAAssessingPerformance a pm:Conceptualizing ;
    rdfs:label "Assessing magical performance against outcomes"@en, "Magische Leistung an Ergebnissen bewerten"@de ;
    skos:definition "For magic to be effective one must be able to assess one's performance and relate the techniques used to what emerges, e.g. knowing how an invocation for a purpose resonates into one's life."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 28; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAStatementOfIntentRequired a pm:Presupposing ;
    rdfs:label "Statement of intent before any formal magical act"@en, "Absichtserklärung vor jedem formalen magischen Akt"@de ;
    skos:definition "Every formalised act of magic is said to require a statement of intent, so that the techniques used can be related to what follows from them."@en ;
    pm:priorStep pmp:ChaosMagicCondAStatementOfIntent ;
    pm:dependentStep pmc:ChaosMagicCondAAssessingPerformance ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 28; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAStatementOfIntentYieldsAssessment a pm:Yielding ;
    rdfs:label "Statement of intent yields assessable magic"@en, "Absichtserklärung ermöglicht überprüfbare Magie"@de ;
    skos:definition "The statement of intent is given as the way chaos magic meets the need to relate the techniques used to the results that emerge."@en ;
    pm:byPractice pmp:ChaosMagicCondAStatementOfIntent ;
    pm:yieldsCapacity pmc:ChaosMagicCondAAssessingPerformance ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 28; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondASelfAssessment a pm:Practicing ;
    rdfs:label "Self-assessment"@en, "Selbstprüfung"@de ;
    skos:definition "Examining one's behaviour, thoughts and feelings with dispassion and objectivity; advice may be sought from spirits, divination or friends, but responsibility for action rests with the individual, not a guru."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 29; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondADispassionateSelfExamination a pm:Conceptualizing ;
    rdfs:label "Dispassionate self-examination applicable to all of life"@en, "Leidenschaftslose Selbstbetrachtung, auf das ganze Leben anwendbar"@de ;
    skos:definition "The skill of examining one's own conduct, thought and feeling with some objectivity, said to transfer to any area of life once used."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 29; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASelfDelusionCautela a pm:Cautioning ;
    rdfs:label "Self-delusion does not end with proficiency"@en, "Selbsttäuschung endet nicht mit Können"@de ;
    skos:definition "Self-deception and blind spots are said not to stop at any level of magical proficiency; it is easy to dismiss what does not fit one's self-image."@en ;
    pm:cautionsAbout pmp:ChaosMagicCondASelfAssessment ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 29; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondACavalierMetaphysics a pm:Conceptualizing ;
    rdfs:label "Simple models for abstract experience; cavalier metaphysics"@en, "Einfache Modelle für Abstraktes; kavaliersmäßige Metaphysik"@de ;
    skos:definition "Occult theories describe the phenomenal world simply and the abstract complexly; chaos magic reverses this. Carroll calls the chaos attitude to metaphysics 'cavalier', since metaphysics depends on belief. Hine criticises occultists' attempts at grand unified systems merging tarot, runes and I Ching."@en ;
    skos:note "Hine ascribes this to a work he names and does not cite by edition: Peter J. Carroll, as cited by Hine without naming the work. The node holds what Condensed Chaos reports; the named work is reachable in its own right and is not read here, so the node is entered as Hine's ascription and not as a mediated reading of that work."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, pp. 29-30; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAModelsAndMetaphors a pm:Conceptualizing ;
    rdfs:label "Borrowing metaphors from any field; servitors from COBOL"@en, "Metaphern aus jedem Feld; Servitoren aus COBOL"@de ;
    skos:definition "Chaos magicians draw metaphors from many fields (chaos science, ecology, biology, psychology, SF, programming, management theory). Hine reports his servitor chapter grew from studying COBOL programming; by experiment he found properties of the model did transfer to magical action, though not as expected."@en ;
    skos:note "The servitor chapter it refers to lies outside this part of the book."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 30; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAModelsAsTrapsCautela a pm:Cautioning ;
    rdfs:label "Models become subtle traps"@en, "Modelle werden zu subtilen Fallen"@de ;
    skos:definition "Models can bind one within their limits once embraced; instead of stretching one model to cover everything, choose the model most suited to the situation. Treating metaphors and maps as true is a common tendency."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondAModelsAndMetaphors ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, pp. 30-31; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAProtectiveTalisman a pm:Conceptualizing ;
    rdfs:label "Protecting a home against malign intrusion"@en, "Schutz eines Hauses vor böswilligem Eindringen"@de ;
    skos:definition "Hine reports making home protection for an acquaintance; a simple 'shield' around the house was possible with few props, but he chose a formal Qabalistic angelic invocation so the client would feel mighty forces had been set to guard the home."@en ;
    skos:note "The ritual is not described."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 30; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAWorldItselfMagical a pm:Conceptualizing ;
    rdfs:label "The world itself is magical"@en, "Die Welt selbst ist magisch"@de ;
    skos:definition "Chaos shifts the search for the magical from beyond the known world to recognising the world itself as magical; living by 'nothing is true' means accepting a metaphor's fragility."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, pp. 30-31; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASelfAndOther a pm:Conceptualizing ;
    rdfs:label "Self and Other under the consensual model"@en, "Selbst und Anderes im Konsensmodell"@de ;
    skos:definition "The consensual model (mind/matter split, mechanism, subject/object) shapes self-other relations, stereotypes and attribution bias; in magic, invoked deities read as archetypes raise the question whether they have existence and intentions separate from one's own."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 31; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAOwnViewpointCautela a pm:Cautioning ;
    rdfs:label "Uncritical acceptance of the self-evident; own viewpoint as only one"@en, "Unkritische Hinnahme des Selbstverständlichen; eigene Sicht als einzige"@de ;
    skos:definition "The chaos perspective demands seeing past the surface of paramount reality, attention to detail and wariness of the seemingly obvious; in sorcery it is easy to treat one's own perspective of a situation as the only one that counts."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondASelfAndOther ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, pp. 31-32; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAEgoMagicPerspectiveShift a pm:Conceptualizing ;
    rdfs:label "Shifting perspective to another person's viewpoint"@en, "Perspektivwechsel in die Sicht eines anderen"@de ;
    skos:definition "Chaos magic's ego-magic methods are said to let one view a situation through someone else's eyes."@en ;
    skos:note "The ego magic techniques themselves lie outside this part of the book."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 32; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondABodyMind a pm:Conceptualizing ;
    rdfs:label "Mind arises from the body; BodyMind"@en, "Geist entsteht aus dem Körper; KörperGeist"@de ;
    skos:definition "Against the ghost-in-the-machine split, chaos holds that mind arises from body; many magicians speak of BodyMind as a unity, calling the subjective/objective divide into question; chaos science is said to support this and to conceive self-organising interdependent ecologies."@en ;
    skos:note "Hine notes that chaos magic has been criticised as reductionist on this point."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 32; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondAObservingNaturalSpace a pm:Practicing ;
    rdfs:label "Observing a natural place before imposing meaning"@en, "Einen natürlichen Ort beobachten, bevor man Bedeutung aufprägt"@de ;
    skos:definition "Go into woodland or a similar natural space, regard it as a dynamic ecosystem of flora, fauna, history, geology, myth, season and weather of which you become one element; before assigning any magical significance, observe it and attend to your own relation to it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, pp. 32-33; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAAttributingMeaningCautela a pm:Cautioning ;
    rdfs:label "Over-eager attribution of meaning"@en, "Vorschnelle Bedeutungszuschreibung"@de ;
    skos:definition "We are often too quick to impose meanings and interpretations on a situation and do not allow other meanings to reveal themselves."@en ;
    pm:cautionsAbout pmp:ChaosMagicCondAObservingNaturalSpace ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 33; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondANoGrandCosmicScheme a pm:Conceptualizing ;
    rdfs:label "No cosmic purpose beyond what is chosen"@en, "Kein kosmischer Zweck außer dem gewählten"@de ;
    skos:definition "If nothing is true, life has no purpose or grand scheme beyond what one imposes or believes; for the chaos magician this is dizzying freedom rather than cynicism."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 33; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAAchievableReality a pm:Conceptualizing ;
    rdfs:label "Extending the limits of Achievable Reality"@en, "Die Grenzen der Erreichbaren Wirklichkeit erweitern"@de ;
    skos:definition "Magic is described as techniques and approaches to explore and push back the believed limits on one's range of actions and successes, widening the sphere of possible action."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 33; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAMagicWorksDemonstration a pm:Conceptualizing ;
    rdfs:label "One demonstration that magic works outweighs theory"@en, "Ein Nachweis, dass Magie wirkt, wiegt Theorie auf"@de ;
    skos:definition "Doubt whether magic works is named as a first barrier; magic, like sex, must be experienced directly, and a single act that convinces oneself of its working outweighs a library of theory."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 33; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondATheoryInUse a pm:Conceptualizing ;
    rdfs:label "Theory-of-Action vs Theory-in-Use"@en, "Handlungstheorie vs. Gebrauchstheorie"@de ;
    skos:definition "Received occult theory (Theory-of-Action) is passed from book to book as if true independently of experience; Theory-in-Use is the guidelines a magician learns from personal practice, which cannot be taught. Belief adoption, not coherence, makes a theory viable; there are no correct ways, only those that work for you; changing ideas is to be expected."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, pp. 33-34; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAMagicalPower a pm:Conceptualizing ;
    rdfs:label "Magical power as achieving intended effect under constraints"@en, "Magische Macht als Fähigkeit, beabsichtigte Wirkung im Rahmen der Grenzen zu erzielen"@de ;
    skos:definition "Using Russell's definition, magical power is the capacity to bring about an intended effect, refined to within the limits a situation sets; absolute power is called a fiction; self-imposed limits can be a source of power. Power-from-within (felt sense of being able) is distinguished from power-over."@en ;
    skos:note "Hine rejects the critics' reading of 'nothing is true, everything is permitted' as a call to throw off all restraint."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, pp. 34-35; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondATelepathy a pm:Conceptualizing ;
    rdfs:label "Telepathy"@en, "Telepathie"@de ;
    skos:definition "Named among so-called magical powers; Hine treats such powers as siddhis, achievements resulting from practice, discipline and patience."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 35; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondALevitation a pm:Conceptualizing ;
    rdfs:label "Levitation"@en, "Levitation"@de ;
    skos:definition "Named among so-called magical powers (siddhis), framed as the fruit of long practice."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 35; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAInfluenceAtDistance a pm:Conceptualizing ;
    rdfs:label "Influencing people and events from afar"@en, "Fernbeeinflussung von Menschen und Ereignissen"@de ;
    skos:definition "Named among so-called magical powers (siddhis), framed as the fruit of long practice."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 35; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASensingAuras a pm:Conceptualizing ;
    rdfs:label "Sensing auras"@en, "Auren wahrnehmen"@de ;
    skos:definition "Named among so-called magical powers (siddhis), framed as the fruit of long practice."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 35; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAPrecognition a pm:Conceptualizing ;
    rdfs:label "Precognition"@en, "Präkognition"@de ;
    skos:definition "Named among so-called magical powers (siddhis), framed as the fruit of long practice."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 35; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASpoonBending a pm:Conceptualizing ;
    rdfs:label "Spoon bending"@en, "Löffelbiegen"@de ;
    skos:definition "Bending spoons is named, half in jest, among the so-called magical powers that are treated as siddhis."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 35; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASiddhis a pm:Conceptualizing ;
    rdfs:label "Siddhis are achievements of practice"@en, "Siddhis sind Errungenschaften der Übung"@de ;
    skos:definition "In Tantra such abilities are called siddhis, 'achievements'; an achievement results from practice, discipline and patience, so a magician who seems to do marvels effortlessly has likely practised very long."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 35; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAPowerAsExpressionOfBeing a pm:Conceptualizing ;
    rdfs:label "Being 'powerful': confident, relaxed manifestation of intent"@en, "'Mächtig' sein: sicheres, gelöstes Verwirklichen der Absicht"@de ;
    skos:definition "One becomes powerful when one has shown to oneself (and to group or fellow magicians) that one can manifest intention to the point of being confident and relaxed, so that magic becomes an expression of one's being rather than something done."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, pp. 35-36; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAMegalomaniacCautela a pm:Cautioning ;
    rdfs:label "Ignoring limits makes the megalomaniac"@en, "Grenzen missachten macht zum Größenwahnsinnigen"@de ;
    skos:definition "Grasping the limits and constraints that channel one's power is said to separate the effective magician from the megalomaniac; chaos magic does not throw out all rules but seeks the most effective disciplines."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondAPowerAsExpressionOfBeing ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 36; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondATwilightZone a pm:Conceptualizing ;
    rdfs:label "Magic is two-way; letting magic in"@en, "Magie wirkt in beide Richtungen; Magie hereinlassen"@de ;
    skos:definition "Magic changes the user in return. Entering a magical reality means allowing intrusions of the weird and inexplicable into everyday life, including spirits that summon you; there is no script for this, only experience and talking with fellows."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 36; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAShiverAndTearsSign a pm:Conceptualizing ;
    rdfs:label "Shiver and tears as mark of real strangeness"@en, "Schauder und Tränen als Zeichen echter Fremdheit"@de ;
    skos:definition "Hine reports that in the presence of strangeness he shivers and his eyes tear up, and he uses this response to tell real strangeness from overactive imagination."@en ;
    skos:note "Counted as a sign of success: Hine's own shiver and tears in the presence of strangeness, by which he tells real strangeness from an overactive imagination. Observable only by the operator; no base rate is given."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 36; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondABeckAndCallCautela a pm:Cautioning ;
    rdfs:label "Assuming entities exist only at one's beck and call"@en, "Annahme, Wesenheiten stünden nur zur eigenen Verfügung"@de ;
    skos:definition "Dealing with gods, demons and spirits, it is easy to think they exist and will only through oneself; this attitude breaks down when a spirit arrives unannounced, especially if others meet it too."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondATwilightZone ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, pp. 36-37; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondAQuestioningAnEntity a pm:Practicing ;
    rdfs:label "Questioning and dismissing an intruding entity"@en, "Befragen und Fortschicken einer eindringenden Wesenheit"@de ;
    skos:definition "Hine and a friend found a man-shaped moving shadow on a stairwell, questioned it, found it evasive though promising to give power, and told it to leave them alone; the uncanniness struck only afterwards. People are said to behave normally during such encounters and be shocked later."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 37; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAWorldCrackedApartCautela a pm:Cautioning ;
    rdfs:label "Is magic dangerous? A world cracked apart"@en, "Ist Magie gefährlich? Eine zerbrochene Welt"@de ;
    skos:definition "Asked whether magic is dangerous, Hine recalls a friend torn between goddess spirituality and Catholic guilt who read Crowley's Hymn to Pan, knocked down a tarot deck, saw the Devil land face up, and felt her whole world crack apart; nothing was the same again."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondATwilightZone ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 37; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAOpennessToIntrusions a pm:Conceptualizing ;
    rdfs:label "Sensitivity to intrusions of the uncanny"@en, "Empfänglichkeit für Einbrüche des Unheimlichen"@de ;
    skos:definition "Such encounters cannot be sought, they come; but some states help: physical exhaustion that leaves one alert seems beneficial, an attitude of letting whatever happens happen (cf. Spare's doctrine, roughly 'it does not matter, it need not be') and a sober, unexcited approach."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, pp. 37-38; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAMentalExhaustionFailure a pm:Conceptualizing ;
    rdfs:label "Mental exhaustion dulls sensitivity"@en, "Geistige Erschöpfung stumpft die Empfänglichkeit ab"@de ;
    skos:definition "Mental exhaustion appears to dull one's sensitivity to intrusions from outside."@en ;
    skos:note "Counted as a condition of failure: of openness to intrusions of the uncanny (pmc:ChaosMagicCondAOpennessToIntrusions): mental exhaustion appears to dull the sensitivity. No deadline or rate, and hedged; the cause is the operator's own state."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 38; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondABeliefNotRequired a pm:Conceptualizing ;
    rdfs:label "Belief in doctrines not needed for effective magic"@en, "Glaube an Lehren für wirksame Magie nicht nötig"@de ;
    skos:definition "Effective magic is said not to depend on believing in reincarnation, past lives, chakras, the astral plane or hidden adepts; experience matters and explanations do not, and something may come up to you whether or not you believe in it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 38; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondAPentagramProjection a pm:Practicing ;
    rdfs:label "Projecting a visualised pentagram against a presence"@en, "Projektion eines visualisierten Pentagramms gegen eine Präsenz"@de ;
    skos:definition "Hine woke to a heavy misty thing on his chest; after lying in fear he pictured a pentagram in his mind and sent it outward, and the thing faded away. He reports this convinced him that magic is real."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 38; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondADispellingAPresence a pm:Conceptualizing ;
    rdfs:label "Dispelling a hostile presence"@en, "Vertreiben einer feindlichen Präsenz"@de ;
    skos:definition "Making an oppressive entity depart, as in Hine's experience with a projected pentagram."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 38; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAPentagramYieldsDispelling a pm:Yielding ;
    rdfs:label "Projected pentagram dispels presence"@en, "Projiziertes Pentagramm vertreibt Präsenz"@de ;
    skos:definition "In Hine's account the projected pentagram made the presence fade."@en ;
    pm:byPractice pmp:ChaosMagicCondAPentagramProjection ;
    pm:yieldsCapacity pmc:ChaosMagicCondADispellingAPresence ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 38; read in a full-text layer of the second printing" .


#
# Chapter 3, Becoming a Magician
#

pmc:ChaosMagicCondAMagicNotForAll a pm:Conceptualizing ;
    rdfs:label "Against Crowley's 'magic is for all'"@en, "Gegen Crowleys 'Magie ist für alle'"@de ;
    skos:definition "Hine says Crowley probably overstated the case; the many associates who tried to become magicians and ended in madness or misery show magic is not for everyone."@en ;
    skos:note "Crowley's dictum is read only as Hine quotes it, so this is entered as Hine's claim and not as a dispute."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 39; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAMadnessOrMiseryCautela a pm:Cautioning ;
    rdfs:label "Madness or misery among would-be magicians"@en, "Wahnsinn oder Elend unter Möchtegern-Magiern"@de ;
    skos:definition "Lives of Crowley's associates who failed as magicians ending in madness or misery are cited as a warning that magic does not suit everyone; becoming a magician takes time, practice, experience, not a few books and exercises."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondAMagicianScienceOfExtremes ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 39; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAMagicianScienceOfExtremes a pm:Conceptualizing ;
    rdfs:label "The magician: awareness of complexity, science of extremes"@en, "Der Magier: Bewusstsein der Komplexität, Wissenschaft der Extreme"@de ;
    skos:definition "A magician recognises the world's hidden complexity, guards against what limits adaptation and survival, stays aware of inner structures and surroundings, strives to widen possibilities for action, and must sometimes overstep in every direction; magic is in a sense the science of extremes."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 39; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAInstantPowersCautela a pm:Cautioning ;
    rdfs:label "Occult as escape from responsibility; wanting instant powers"@en, "Okkultismus als Flucht vor Verantwortung; sofortige Kräfte wollen"@de ;
    skos:definition "Many come to the occult to escape the responsibility of being human or want powers immediately without sacrifice; powers are the result of discipline, practice and study, and the process changes the practitioner; with power comes responsibility."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondASiddhis ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 39; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondABeAMagicianElsewhereFailure a pm:Conceptualizing ;
    rdfs:label "Magician only in one's own head"@en, "Magier nur im eigenen Kopf"@de ;
    skos:definition "No one became a magician from books; one is a magician only once one twists what was learned and applies it successfully in life. Self-conviction, even with agreeing followers, is not the test; the test is to go elsewhere and be a magician there."@en ;
    skos:note "Counted as a condition of failure: of becoming a magician: one who is a magician only in his own head, or among agreeing friends, fails the test of going elsewhere and being a magician there. No deadline or rate; the fault lies with the operator."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 39-40; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAMagicalPoise a pm:Conceptualizing ;
    rdfs:label "Magical poise"@en, "Magische Haltung (Poise)"@de ;
    skos:definition "Among the most important powers a magician develops is poise, a self-assured manner kept regardless of place or company, recognisable and respected by other magicians."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 40; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondABasicTechniques a pm:Conceptualizing ;
    rdfs:label "'Basic' means simple, effective, lifelong"@en, "'Grundlegend' heißt einfach, wirksam, lebenslang"@de ;
    skos:definition "Against the view that basic techniques are practised for a period then dropped, chaos calls 'basic' any simple effective technique that remains useful however advanced one becomes."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 40; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAWeekendWorkshopCautela a pm:Cautioning ;
    rdfs:label "A weekend workshop makes no magician"@en, "Ein Wochenendworkshop macht keinen Magier"@de ;
    skos:definition "Learning magic requires practice, time, effort and self-discipline like learning to drive; instant courses mislead, and benefits may show only in the long term."@en ;
    pm:cautionsAbout pmp:ChaosMagicCondARegularPractice ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 40; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAStillnessBeforeAstralWork a pm:Presupposing ;
    rdfs:label "Basic skills of stillness and imagery before astral work"@en, "Grundfertigkeiten von Stille und Bildhaltung vor Astralarbeit"@de ;
    skos:definition "Working on the astral plane is said to be nearly pointless if one cannot keep still for five minutes or keep a mental image steady without drifting."@en ;
    skos:note "Hine speaks of working entirely on the 'astral plane'; the dependent step is the astral level of magic as entered from Liber Kaos."@en ;
    pm:priorStep pmc:ChaosMagicCondAStillnessAndImageHolding ;
    pm:dependentStep pmc:ChaosMagicAstralLevel ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Working wholly on the astral plane is pointless for someone who cannot keep still for five minutes or hold an inner image without drifting to other thoughts." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 41; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAStillnessAndImageHolding a pm:Conceptualizing ;
    rdfs:label "Sitting still and holding an image in the mind's eye"@en, "Stillsitzen und ein Bild im inneren Auge halten"@de ;
    skos:definition "Basic skills of physical stillness for at least five minutes and holding a mental image without wandering, built by practice as a basis for further work."@en ;
    skos:note "No exercise for it is given in this part of the book."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 41; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASelfDisciplineAlly a pm:Conceptualizing ;
    rdfs:label "Self-discipline and confidence through kept promises"@en, "Selbstdisziplin und Selbstvertrauen durch gehaltene Vorsätze"@de ;
    skos:definition "Self-discipline grown through practice is called a powerful magical ally; doing what one promised oneself increases confidence in one's ability, and confidence is said to be a key to successful magic."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 41; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondARegularPractice a pm:Practicing ;
    rdfs:label "Regular practice against one's own inertia"@en, "Regelmäßige Übung gegen die eigene Trägheit"@de ;
    skos:definition "Set yourself a routine of practice and actually carry it out; this is the only way to break a self-description of being lazy and unable to concentrate. Expect ingenious excuses (lie-ins, doubling tomorrow, no time) and keep going until the pattern changes."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 41; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAInertiaCautela a pm:Cautioning ;
    rdfs:label "Inertia: the most deadly magical adversary"@en, "Trägheit: der gefährlichste magische Gegner"@de ;
    skos:definition "Regular practice pits one against one's own inertia, called probably the deadliest magical adversary; self-imposed limitations seem almost alive and resist change."@en ;
    pm:cautionsAbout pmp:ChaosMagicCondARegularPractice ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 41; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAAttractiveExcusesSign a pm:Conceptualizing ;
    rdfs:label "Attractive excuses as a good sign"@en, "Verlockende Ausreden als gutes Zeichen"@de ;
    skos:definition "Limitations defend themselves only when something threatens established patterns, so finding attractive excuses to skip practice may be read as encouraging."@en ;
    skos:note "Counted as a sign of success: finding attractive excuses to skip practice may be taken as good, since limitations defend themselves only when established patterns are threatened. Observable only by the operator."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 41; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondATooEasyTaskFailure a pm:Conceptualizing ;
    rdfs:label "A task that feels easy may not be taken seriously"@en, "Eine leicht wirkende Aufgabe wird vielleicht nicht ernst genommen"@de ;
    skos:definition "If a new task does not feel hard and intrusive on daily life, one may not be taking it seriously enough."@en ;
    skos:note "Counted as a condition of failure: of regular practice: a new task that does not feel difficult and imposing may not be taken seriously enough. No deadline or rate, and hedged; the fault lies with the operator."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 41; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondABloodyMindedness a pm:Conceptualizing ;
    rdfs:label "Determination, tenacity, bloody-mindedness"@en, "Entschlossenheit, Zähigkeit, Sturheit"@de ;
    skos:definition "Changing a pattern by persisting builds determination, tenaciousness and sheer stubbornness, qualities called useful in themselves for a budding magician."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 41; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondAMagicalDiary a pm:Practicing ;
    rdfs:label "Keeping a magical diary"@en, "Führen eines magischen Tagebuchs"@de ;
    skos:definition "Record every attempt at exercises and techniques plus resulting ideas and anything significant, in any convenient medium (bound book, ring binder, computer). Each entry: what was done, duration, place, relevant weather, moon phase or astrological factors if felt significant, how it went, ideas arising, other comments. Keeping it as though someone will inspect it is a useful spur; some teachers demand diaries for scrutiny."@en ;
    skos:note "The astronomers' maxim that what was not written down did not happen is offered to magicians; ideas are said to loop back into earlier experiments years later."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 41-42; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASeeingOwnProgress a pm:Conceptualizing ;
    rdfs:label "Seeing one's own progress over time"@en, "Den eigenen Fortschritt über die Zeit sehen"@de ;
    skos:definition "With a kept record of practice one can see differences between the start of a practice and now even when one feels no progress, aiding self-assessment; the record also lets earlier ideas be resumed with fresh insight."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 42, 44-45; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondADiaryYieldsProgress a pm:Yielding ;
    rdfs:label "Diary yields visible progress"@en, "Tagebuch macht Fortschritt sichtbar"@de ;
    skos:definition "Keeping a record of practice is said to let one see differences between the start of a practice and now even when one feels no progress, and to let earlier ideas be taken up again."@en ;
    pm:byPractice pmp:ChaosMagicCondAMagicalDiary ;
    pm:yieldsCapacity pmc:ChaosMagicCondASeeingOwnProgress ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 42, 44-45; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondARealisticSchedule a pm:Practicing ;
    rdfs:label "Realistic practice scheduling; short and frequent, building up"@en, "Realistische Übungsplanung; kurz und häufig, langsam steigern"@de ;
    skos:definition "Instead of workbook advice to practise at the same hour daily, set a schedule you can realistically keep given your free time; if daily is impossible, choose a frequency you will keep. Hine finds short frequent practice better than long infrequent (five minutes of daily meditation beats thirty minutes once in three weeks); begin exercises with a few minutes and slowly lengthen rather than straining."@en ;
    skos:note "The comparison of short frequent and long rare practice is given as Hine's own finding."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 42-43; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAUnrealisticScheduleFailure a pm:Conceptualizing ;
    rdfs:label "Unrealistic schedule undermines confidence"@en, "Unrealistischer Plan untergräbt Selbstvertrauen"@de ;
    skos:definition "An unrealistic practice schedule will likely not be kept, which does not improve confidence; schedules are useful only if free time to keep them is really available."@en ;
    skos:note "Counted as a condition of failure: of practice scheduling: an unrealistic schedule will likely not be kept, which does not improve confidence. No deadline; a likelihood, not a rate; the fault lies with the operator."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 43; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondARunBeforeWalkCautela a pm:Cautioning ;
    rdfs:label "Running before you can walk"@en, "Laufen wollen, bevor man gehen kann"@de ;
    skos:definition "Straining at long durations early is discouraged; in magic one easily comes a cropper."@en ;
    pm:cautionsAbout pmp:ChaosMagicCondARealisticSchedule ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 43; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAOverloadCautela a pm:Cautioning ;
    rdfs:label "Overloading oneself with magical work"@en, "Überladung mit magischer Arbeit"@de ;
    skos:definition "Taking on too much magical work, or devouring occult books without time to digest them, is bad practice and raises the risk of bogging down in inertia."@en ;
    pm:cautionsAbout pmp:ChaosMagicCondARegularPractice ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 43; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondATakingABreak a pm:Practicing ;
    rdfs:label "Taking a holiday from magic"@en, "Urlaub von der Magie nehmen"@de ;
    skos:definition "When overloaded, set a period in which you read no magical texts and do no active practice except perhaps a simple daily meditation; this break can itself be a magical act, and may paradoxically be hard for those keen on becoming magicians."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 43; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondARenewedFreshness a pm:Conceptualizing ;
    rdfs:label "Renewed freshness in practice"@en, "Erneuerte Frische in der Übung"@de ;
    skos:definition "After a short breathing space one is said to return to practice with renewed freshness."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 43; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondABreakYieldsFreshness a pm:Yielding ;
    rdfs:label "Magical holiday yields renewed freshness"@en, "Magischer Urlaub ergibt erneuerte Frische"@de ;
    skos:definition "A short pause from active magical work is said to let one return to practice with renewed freshness."@en ;
    pm:byPractice pmp:ChaosMagicCondATakingABreak ;
    pm:yieldsCapacity pmc:ChaosMagicCondARenewedFreshness ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 43; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAStagesOfLearning a pm:Conceptualizing ;
    rdfs:label "Three stages of learning a skill"@en, "Drei Stufen des Erlernens einer Fertigkeit"@de ;
    skos:definition "Learning passes through initial enthusiasm with felt benefits, a dry boring phase (the 'hump') where excuses are strongest and earlier benefits vanish, and finally a phase where one can do it without effort; much of magic, from meditation to clairvoyance, is said to be learned this way."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 43-44; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondADryPhaseCautela a pm:Cautioning ;
    rdfs:label "Quitting in the dry phase"@en, "Aufgeben in der trockenen Phase"@de ;
    skos:definition "Many quit magical development in the dry phase when earlier benefits suddenly dry up; advice is to grit one's teeth and persist, since it does not last forever."@en ;
    skos:note "The vanishing of early benefits is presented as expected and not as a sign of failure."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondAStagesOfLearning ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 44; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAOverTheHumpSign a pm:Conceptualizing ;
    rdfs:label "Signs of getting over the hump"@en, "Zeichen, den Buckel überwunden zu haben"@de ;
    skos:definition "After the hump one gradually feels different about the practice, sees its benefit, may enjoy it, and eventually finds one can do it without effort."@en ;
    skos:note "Counted as a sign of success: past the dry phase one gradually feels differently about the practice, sees its use, may enjoy it, and at last does it without effort. Observable only by the operator."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 44; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAClairvoyance a pm:Conceptualizing ;
    rdfs:label "Clairvoyance"@en, "Hellsehen"@de ;
    skos:definition "Named with meditation as a magical skill learned through the three stages of learning."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 44; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAMeditationSkill a pm:Conceptualizing ;
    rdfs:label "Meditation as a learned skill"@en, "Meditation als erlernte Fertigkeit"@de ;
    skos:definition "Meditation is named as a magical skill acquired through the stages of learning."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 44; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondAStrengthsWeaknessesColumns a pm:Practicing ;
    rdfs:label "Two-column strengths and weaknesses page"@en, "Zweispaltige Seite für Stärken und Schwächen"@de ;
    skos:definition "Acknowledge in the diary where you are weak and the inner talk by which you convince yourself you can't do things; split a page in two columns listing the strengths and weaknesses you see in yourself, what you wish to change, and how magic might help."@en ;
    skos:note "'Know thyself' is cited as the charge given to initiates of the Eleusinian Mysteries (the text layer reads 'Eulesian')."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 44-45; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAGuruDependencyCautela a pm:Cautioning ;
    rdfs:label "Inflated enlightenment or denied progress; guru dependency"@en, "Überhöhte Erleuchtung oder geleugneter Fortschritt; Guru-Abhängigkeit"@de ;
    skos:definition "Magicians easily come to overrate their own enlightenment, or equally deny any progress; relying on gurus to say where one stands brings problems, especially when the guru is expected to take total responsibility and some self-styled teachers gladly do."@en ;
    pm:cautionsAbout pmp:ChaosMagicCondASelfAssessment ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 44-45; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAMagicalPitfalls a pm:Systematizing ;
    rdfs:label "Pitfalls of magic (six)"@en, "Fallstricke der Magie (sechs)"@de ;
    skos:definition "Hine lists pitfalls even advanced magicians fall into: isolation, Magus-itis, obsession, cosmic tragedy, paranoia, gnostic burn-out."@en ;
    pm:compiledBy "Phil Hine, in Condensed Chaos" ;
    dcterms:date "1995"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 45-47; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAIsolationCautela a pm:Cautioning ;
    rdfs:label "Isolation precedes madness"@en, "Isolation geht dem Wahnsinn voraus"@de ;
    skos:definition "Most how-to books address solo practitioners, yet isolation is said to precede madness; one should have someone with whom to talk over ideas, progress, problems and feelings. Inability to communicate inner events or hear others' views makes other pitfalls easy."@en ;
    pm:cautionsAbout pmp:ChaosMagicCondARegularPractice ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 45; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAMagusItisCautela a pm:Cautioning ;
    rdfs:label "Magus-itis"@en, "Magus-itis"@de ;
    skos:definition "Syndrome of believing oneself in an exalted state against peers' view, usually behaving obnoxiously, expecting automatic respect, wanting to be guru to gain a confirming captive audience, and lacking empathy and social skills needed to teach."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondAPowerAsExpressionOfBeing ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 46; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAMagusItisFailure a pm:Conceptualizing ;
    rdfs:label "Thinking oneself wonderful when no one agrees"@en, "Sich für großartig halten, ohne dass jemand zustimmt"@de ;
    skos:definition "Diagnostic sign of Magus-itis: you think you are wonderful but nobody else seems to agree; then close self-examination is due."@en ;
    skos:note "Counted as a condition of failure: the sign of Magus-itis is thinking oneself wonderful while nobody else shares that view, which calls for close self-examination. No deadline or rate; the fault lies with the operator."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 46; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAObsessionCautela a pm:Cautioning ;
    rdfs:label "Obsession with magic"@en, "Besessenheit von Magie"@de ;
    skos:definition "Sign: being unable to talk about anything else and uncomfortable when conversation leaves magic; Hine admits doing this. Cultivating a sinister outsider glamour and staring into eyes often covers poor social skills and inferiority."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondAMagicAsWayOfLiving ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 46; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondACosmicTragedyCautela a pm:Cautioning ;
    rdfs:label "Cosmic tragedy"@en, "Kosmische Tragödie"@de ;
    skos:definition "Newcomers feel urgency to fix the world and become illuminated fast; everything takes on magical significance, and personal problems are inflated into a unique cosmic initiation vital to humanity."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondATwilightZone ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 47; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAMagicalParanoiaCautela a pm:Cautioning ;
    rdfs:label "Magical paranoia"@en, "Magische Paranoia"@de ;
    skos:definition "Alone or in groups one quickly generates paranoia that makes odd events likely, then read as evidence of attack, leading to hunting enemies; magical attack does happen, but nine times in ten the source of bad vibes is oneself. Hine has met many occultists convinced of attacks by Satanists, Black Lodges or chaos magicians."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondADetectingMagicalAttack ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 47; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondADetectingMagicalAttack a pm:Conceptualizing ;
    rdfs:label "Detecting and countering magical attack"@en, "Magische Angriffe erkennen und abwehren"@de ;
    skos:definition "Hine reports detecting three magical attacks in about fifteen years, each corroborated by others, and being able to do something about them at the time."@en ;
    skos:note "The countermeasures are not described."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 47; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAGnosticBurnOutCautela a pm:Cautioning ;
    rdfs:label "Gnostic burn-out"@en, "Gnostisches Ausbrennen"@de ;
    skos:definition "Results from overdoing magic, often too many rituals in a short time or failing to ground thoroughly after a heavy session. Against those who say a good magician should not suffer it, Hine holds a good magician must expect it since practice drives one into weird states and bodily sensations."@en ;
    skos:note "Not grounding thoroughly after a heavy session is named as one cause; grounding itself is not described in this part of the book."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondAGnosisAtWill ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 47; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondABurnOutRecovery a pm:Practicing ;
    rdfs:label "Recovering from gnostic burn-out"@en, "Erholung vom gnostischen Ausbrennen"@de ;
    skos:definition "Hine's response is to go and lie down for a while; support from other people also helps."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 47; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAMagicAsWayOfLiving a pm:Conceptualizing ;
    rdfs:label "Magic as a way of living; occult beliefs optional"@en, "Magie als Lebensweise; okkulte Überzeugungen optional"@de ;
    skos:definition "Chaos magic prefers simple, everyday explanations of technique; belief in chakras, astral plane, karma, reincarnation, auras, energies is optional; magic is a manner of meeting the world, not something done occasionally behind closed doors."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 48; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAGoodMagician a pm:Conceptualizing ;
    rdfs:label "The good magician is effective and adaptive across life"@en, "Der gute Magier ist wirksam und anpassungsfähig im ganzen Leben"@de ;
    skos:definition "Against workbooks implying one becomes a magician through exercises, beliefs and jargon, a good magician from chaos's relativist view is effective and adaptable across as much of life as possible."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 48; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAQualitiesOfChaos a pm:Systematizing ;
    rdfs:label "The qualities of C.H.A.O.S."@en, "Die Eigenschaften von C.H.A.O.S."@de ;
    skos:definition "Hine's acronym for five key qualities of effective magicians, of global use in life: Confidence, Honour, Attentiveness, Organisation, Sensitivity."@en ;
    pm:compiledBy "Phil Hine, in Condensed Chaos" ;
    dcterms:date "1995"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 48; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAConfidence a pm:Conceptualizing ;
    rdfs:label "Confidence: ease in the present moment"@en, "Selbstvertrauen: gelöst sein im unmittelbaren Augenblick"@de ;
    skos:definition "Confidence is defined as a skill: being relaxed, i.e. attentive to the present without projecting futures or being bound by past conditioning and without rigidly patterning what unfolds. It is situation-dependent; a ritual rehearsed to perfection may still falter before three hundred onlookers. A core component is recognising the world as chaotic rather than linear."@en ;
    skos:note "First of the C.H.A.O.S. qualities."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 48-50; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAConfidenceMistakesFailure a pm:Conceptualizing ;
    rdfs:label "Lack of confidence and over-confidence cause mistakes"@en, "Mangelndes und übersteigertes Selbstvertrauen verursachen Fehler"@de ;
    skos:definition "The under-confident avoid anything beyond rehearsed behaviour; the over-confident may fail because gazing at an already-successful future blunts attention to the present; lacking confidence one is not relaxed and makes mistakes. Experts often become very nervous in magical situations."@en ;
    skos:note "Counted as a condition of failure: of confidence (pmc:ChaosMagicCondAConfidence): the under-confident do not try what lies outside their rehearsed repertoire, the over-confident may fail because gazing at an already won future blunts attention to the present, and whoever is not relaxed makes mistakes. No deadline or rate; the fault lies with the operator."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 49; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAMistakesAreBadCautela a pm:Cautioning ;
    rdfs:label "'Mistakes are bad' conditioning and authority-protected theorems"@en, "Konditionierung 'Fehler sind schlecht' und autoritätsgeschützte Theoreme"@de ;
    skos:definition "The need to look expert is a dangerous trap: muddled magical theorems survive analysis because delivered by authority figures and are hard to question; gurus and belief systems serve as safety nets for those who want to step beyond consensus reality but are deeply afraid."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondAConfidence ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 49; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAKarmaTidesExcusesFailure a pm:Conceptualizing ;
    rdfs:label "Excuses when magic 'goes wrong': karma, tides, psychic attack"@en, "Ausreden, wenn Magie 'schiefgeht': Karma, Gezeiten, psychischer Angriff"@de ;
    skos:definition "Some are confident in magic's viability only when it works, and when life goes wrong invoke karma, tides or psychic attack; Hine treats this as a confidence issue stemming from linear expectations."@en ;
    skos:note "Counted as a condition of failure: some trust magic only while it works and, when life goes wrong, blame karma, tides or psychic attack; Hine reads this as a question of confidence and of linear expectation. No deadline or rate; those described blame chance and outside forces, Hine blames the operator."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 49-50; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondANoveltyReframing a pm:Practicing ;
    rdfs:label "Reframing the difficult as novel"@en, "Das Schwierige als neuartig umdeuten"@de ;
    skos:definition "Approach new situations as 'novel' rather than 'difficult'; bodily arousal can then be reinterpreted as excitement, and engaged curiosity directs attention to the environment instead of the ego's fears."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 50; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASelfFulfillingDifficultyFailure a pm:Conceptualizing ;
    rdfs:label "Labelling the unfamiliar as frightening makes it so"@en, "Das Unvertraute als beängstigend etikettieren macht es dazu"@de ;
    skos:definition "Labelling a new situation difficult and frightening and retreating raises anxiety, so the difficulty ends up fulfilling its own prediction."@en ;
    skos:note "Counted as a condition of failure: labelling a new situation difficult and frightening and retreating from it raises anxiety, so the difficulty fulfils its own prophecy. No deadline or rate; the fault lies with the operator."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 50; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAConfidenceProjection a pm:Conceptualizing ;
    rdfs:label "Projecting confidence to others; anchoring a group"@en, "Selbstvertrauen auf andere übertragen; eine Gruppe verankern"@de ;
    skos:definition "Confidence is transferable: one skilled in it can project it so others become confident; in group magic such a magician can act as anchor so others relax into the present and read their arousal as excitement instead of fear."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 50-51; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondALustOfResultCautela a pm:Cautioning ;
    rdfs:label "Lust of Result"@en, "Gier nach Ergebnis (Lust of Result)"@de ;
    skos:definition "The habit of imagining fantasy outcomes, e.g. worrying about the outcome of a sigil, about group performance, the unfamiliar or forgetting one's lines; relaxation is said to short-circuit it."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondAConfidence ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 50-51; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAConfidenceBeforeEffectiveMagic a pm:Presupposing ;
    rdfs:label "Confidence as basic requirement for effective magic"@en, "Selbstvertrauen als Grundvoraussetzung wirksamer Magie"@de ;
    skos:definition "Understanding the dynamics of confidence and becoming skilled at it is called a basic condition of effective magic; confidence is also called key to magical success."@en ;
    pm:priorStep pmc:ChaosMagicCondAConfidence ;
    pm:dependentStep pmc:ChaosMagicCondAGoodMagician ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Without confidence one is tense in a situation and therefore prone to errors." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 49, 51; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAPreparationBeforeConfidence a pm:Presupposing ;
    rdfs:label "Preparation as condition of confidence"@en, "Vorbereitung als Bedingung des Selbstvertrauens"@de ;
    skos:definition "Besides relaxation, confidence is said to need preparation: knowing one's material and keeping several strategies open; organising oneself for a task is later said to make relaxing in it easier and so to raise confidence in the outcome."@en ;
    pm:priorStep pmc:ChaosMagicCondAOrganisation ;
    pm:dependentStep pmc:ChaosMagicCondAConfidence ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 51, 55; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondAMentalRehearsal a pm:Practicing ;
    rdfs:label "Calm mental rehearsal of responses"@en, "Ruhiges mentales Durchspielen von Reaktionen"@de ;
    skos:definition "Use anxiety-based projections to mentally rehearse one's range of responses to difficult scenarios calmly; US Department of Defense research is cited that such rehearsers are more relaxed in live situations."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 51; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASolitaryConfidenceFailure a pm:Conceptualizing ;
    rdfs:label "Confident only in solitary ritual"@en, "Selbstsicher nur im einsamen Ritual"@de ;
    skos:definition "Someone apparently confident performing rituals alone yet uneasy and nervous everywhere else is said to have misunderstood what chaos magic is about."@en ;
    skos:note "Counted as a condition of failure: someone apparently confident at solitary ritual but nervous and ill at ease everywhere else has not understood what chaos magic is for. No deadline or rate; the fault lies with the operator."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 51; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondANeophilia a pm:Conceptualizing ;
    rdfs:label "Neophilia"@en, "Neophilie"@de ;
    skos:definition "Openness to new ideas, said to be a byproduct of confidence; relaxed confident people need not defend their beliefs, while fanaticism and proselytising mark those lacking confidence outside the familiar."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 51; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAPersonalHonourCode a pm:Conceptualizing ;
    rdfs:label "Personal honour code enhances magical ability"@en, "Persönlicher Ehrenkodex steigert magisches Können"@de ;
    skos:definition "External holy-book ethics are almost always broken; better to develop personal rules. Hine believes a personal honour code enhances magical ability; he keeps rules about magic aimed at others, deviating only when specific criteria are met. Honour points form the foundation of one's personal psychocosm and build credibility."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 51-52; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAWordsBindCautela a pm:Cautioning ;
    rdfs:label "Your words bind you too"@en, "Deine Worte binden auch dich"@de ;
    skos:definition "If you believe your speech can release power and bind entities, then your own speech can bind you as well."@en ;
    pm:cautionsAbout pmp:ChaosMagicCondAPointsOfHonour ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 52; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondAPointsOfHonour a pm:Practicing ;
    rdfs:label "Points of honour: word as bond, resolve problems, admit errors"@en, "Ehrenpunkte: Wort als Bürgschaft, Probleme lösen, Fehler zugeben"@de ;
    skos:definition "Keep your word by a graded formula (saying 'so' means trying, 'shall' means doing, 'I promise' means being bound); what you say you will do you must do, and say plainly when you cannot, especially when doing magic for others. Deal with problems as soon as possible and contact the person even if unresolved. Admit mistakes freely rather than hiding them, and act to fix them."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 52-53; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondADependabilityPower a pm:Conceptualizing ;
    rdfs:label "Credibility and growing power through dependability"@en, "Glaubwürdigkeit und wachsende Macht durch Verlässlichkeit"@de ;
    skos:definition "Dependability makes people confident in you, and the more they trust you, the more powerful you are said to become as a magician; honourable conduct builds credibility as a reliable, effective magician."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 52; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAReputationCautela a pm:Cautioning ;
    rdfs:label "Reputation lost in a single evening"@en, "Ruf an einem einzigen Abend verspielt"@de ;
    skos:definition "Avoid situations that could put your integrity in doubt; other magicians watch your reputation, which takes years to build and can be destroyed in one evening."@en ;
    pm:cautionsAbout pmp:ChaosMagicCondAPointsOfHonour ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 52; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondADealingWithPeople a pm:Conceptualizing ;
    rdfs:label "Effective magician deals effectively with people"@en, "Wirksamer Magier geht wirksam mit Menschen um"@de ;
    skos:definition "From the chaos perspective the hallmark of an effective magician is handling other people well across many life situations; honour upheld toward others tends to be applied to oneself."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 53; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAAttentiveness a pm:Conceptualizing ;
    rdfs:label "Attentiveness"@en, "Aufmerksamkeit"@de ;
    skos:definition "Being attentive to what happens around one and distinguishing the world as it is from how one would like it to be; as a skill it means staying aware of the environment while detached, free of expectations and relaxed, and attending also to one's own emotions, motives, desires, habits and inner dialogues."@en ;
    skos:note "Third of the C.H.A.O.S. qualities."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 53-54; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAOverConfidenceTensionCautela a pm:Cautioning ;
    rdfs:label "Beware over-confidence, tension and dulled attention"@en, "Vorsicht vor Übermut, Anspannung und abgestumpfter Aufmerksamkeit"@de ;
    skos:definition "Guard against over-confidence and tension and against anything that dulls attentiveness to others."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondAAttentiveness ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 53; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondADeconditioningBeforeAttentiveness a pm:Presupposing ;
    rdfs:label "Deconditioning supports attentiveness"@en, "Dekonditionierung stützt Aufmerksamkeit"@de ;
    skos:definition "Deconditioning practice (discussed later) is called important for attentiveness, which requires telling the world as it is from the wished-for world."@en ;
    skos:note "The deconditioning practice is announced for later in the book; no consequence of omitting it is stated."@en ;
    pm:priorStep pmc:ChaosMagicCondADeconditioning ;
    pm:dependentStep pmc:ChaosMagicCondAAttentiveness ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 53; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondAConversationalFeedback a pm:Practicing ;
    rdfs:label "Reading conversational feedback"@en, "Gesprächsrückmeldung lesen"@de ;
    skos:definition "When talking with a purpose, attend to the listener's verbal (words, tone) and non-verbal (face, posture) feedback, interpret it correctly and change tactics accordingly."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 53; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAIgnoringFeedbackFailure a pm:Conceptualizing ;
    rdfs:label "Ignoring feedback: outcome decided or self-importance"@en, "Rückmeldung ignorieren: Ergebnis vorentschieden oder Selbstwichtigkeit"@de ;
    skos:definition "People miss feedback because attention is diverted by under- or over-confidence (they have already decided on success or failure) or because they have invested so much self-importance that the listener's response does not matter."@en ;
    skos:note "Counted as a condition of failure: of reading conversational feedback (pmp:ChaosMagicCondAConversationalFeedback): feedback is missed when the outcome has already been decided through lack of or excess confidence, or when the speaker's self-importance makes the response unimportant. No deadline or rate; the fault lies with the operator."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 53; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAIntuition a pm:Conceptualizing ;
    rdfs:label "Intuition as refined attentiveness"@en, "Intuition als verfeinerte Aufmerksamkeit"@de ;
    skos:definition "Intuition is explained not as a mysterious sixth sense but as reaching decisions without conscious deduction and recognising tiny sensory cues into a gestalt; it tends to arise unprompted when relaxed and is contextual. Hine reports snap psychiatric diagnoses right in at least eight of ten cases."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 54; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondATranceDiscernment a pm:Conceptualizing ;
    rdfs:label "Distinguishing genuine deep trance from faking"@en, "Echte tiefe Trance von Vortäuschung unterscheiden"@de ;
    skos:definition "Leading magical training seminars, Hine says he learned in time to tell fairly accurately who had entered deep trance in an exercise and who was faking, by rapid unconscious processing of cues."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 54; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondAAttentionTraining a pm:Practicing ;
    rdfs:label "Training attention: detached awareness, accepting impressions"@en, "Aufmerksamkeit schulen: losgelöstes Gewahrsein, Eindrücke annehmen"@de ;
    skos:definition "Train yourself to be highly aware of the environment at all times while detached, empty of expectations and relaxed; accept whatever impressions arise without dismissing them or clinging so hard that later impressions are shut out."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 54; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAOrganisationOfImagination a pm:Conceptualizing ;
    rdfs:label "Magic as organisation of the imagination"@en, "Magie als Organisation der Imagination"@de ;
    skos:definition "A contemporary definition calls magic an organisation of the imagination; rituals require a prepared framework of organised coherence."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 54-55; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAChaosNotDisorder a pm:Conceptualizing ;
    rdfs:label "Rebuttal of systems' charge that chaos means disorganised"@en, "Zurückweisung des Vorwurfs der Systeme, Chaos heiße unorganisiert"@de ;
    skos:definition "Some champions of systems such as Qabalah, Wicca, shamanism or Satanism criticise chaos magic as proposing disorganised magic; Hine calls this a misperception: chaos treats system use as personal preference, and being organised means prepared for action, not rigid."@en ;
    skos:note "Only Hine's side is read; the critics are not quoted."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 55; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAOrganisation a pm:Conceptualizing ;
    rdfs:label "Organisation as skill; key to practical sorcery"@en, "Organisation als Fertigkeit; Schlüssel zur praktischen Zauberei"@de ;
    skos:definition "Organisation improves with practice and depends on being relaxed and attentive; being organised for a task makes it easier to relax while doing it and so increases confidence in the outcome (feedback loop); structuring thoughts and identifying key areas of a situation is called a key to practical sorcery."@en ;
    skos:note "Fourth of the C.H.A.O.S. qualities."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 55; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAStriveForExcellence a pm:Conceptualizing ;
    rdfs:label "Strive for excellence: no state of having made it"@en, "Nach Exzellenz streben: kein Zustand des Angekommenseins"@de ;
    skos:definition "Being a magician is a dynamic engagement, not a state; there is no point of having made it; becoming an adept largely means getting very good at many things; more practice reveals more about self, others and world."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 55-56; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAErudition a pm:Conceptualizing ;
    rdfs:label "Erudition: knowledge of and confidence in one's field"@en, "Gelehrsamkeit: Kenntnis des eigenen Feldes und Zutrauen darin"@de ;
    skos:definition "Whoever would teach, lead or inspire is said to need both knowledge of and confidence in the chosen field; powerful magicians are said to range widely across fields without being bound by any, and care is needed in how knowledge is expressed."@en ;
    skos:note "Robert Anton Wilson is quoted: specialisation is for insects."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 56; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASensitivity a pm:Conceptualizing ;
    rdfs:label "Sensitivity"@en, "Sensibilität"@de ;
    skos:definition "Not fragility but a learnable set of skills: discernment, prudence, tact, care, empathy; awareness of others' needs and emotions and appropriate response; it can extend into perception associated with psychic powers and correct intuited thoughts. It applies to people, animals, ecosystems or spirits; Hine says the sensitive survive."@en ;
    skos:note "Fifth of the C.H.A.O.S. qualities; at its simplest level the art of listening."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 56-57; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondARelaxationBeforeSensitivity a pm:Presupposing ;
    rdfs:label "Relaxation before sensitivity"@en, "Entspannung vor Sensibilität"@de ;
    skos:definition "Sensitivity is said to require relaxation, and confidence and relaxation put one in a better position to sense another person's differences."@en ;
    pm:priorStep pmc:ChaosMagicCondAConfidence ;
    pm:dependentStep pmc:ChaosMagicCondASensitivity ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 56; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondASelfPreoccupationFailure a pm:Conceptualizing ;
    rdfs:label "Self-preoccupation blocks sensitivity"@en, "Selbstbezogenheit blockiert Sensibilität"@de ;
    skos:definition "Being caught up in one's self-image or in what others think of one prevents noticing their actual reactions and responding effectively; assuming people with shared interests are similar in other ways leads to unnoticed errors."@en ;
    skos:note "Counted as a condition of failure: of sensitivity (pmc:ChaosMagicCondASensitivity): preoccupation with one's self-image or with what others think of one prevents noticing their actual reactions, and assuming that people who share one's interests are alike in other ways leads to errors one does not notice. No deadline or rate; the fault lies with the operator."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 56-57; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondADangerSenseCultivation a pm:Practicing ;
    rdfs:label "Cultivating the danger-sense"@en, "Den Gefahrensinn kultivieren"@de ;
    skos:definition "Notice the inner warning of danger about places or newly met people and do not dismiss it for lack of rational grounds; attend to it and learn to trust it; do not try to explain or force it, just listen."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 57; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondADangerSense a pm:Conceptualizing ;
    rdfs:label "Danger-sense with prescience"@en, "Gefahrensinn mit Vorahnung"@de ;
    skos:definition "An inner sense of impending danger, often prescient (the danger not yet present), said to be an achievement arising as byproduct of discipline and awareness, possibly life-saving. A friend and his girlfriend, sensing something wrong, left a bus one stop later and so avoided a car crash at their usual stop."@en ;
    skos:note "Illustrated by a friend and his girlfriend who left a bus one stop late on a sudden feeling and so missed a crash at their usual stop."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 57; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondADangerSenseYield a pm:Yielding ;
    rdfs:label "Attending to danger-sense yields its growth"@en, "Beachtung des Gefahrensinns lässt ihn wachsen"@de ;
    skos:definition "Attending to the danger-sense and learning to trust it is said to develop it, sensitivity of this kind arising as a byproduct of discipline and awareness."@en ;
    pm:byPractice pmp:ChaosMagicCondADangerSenseCultivation ;
    pm:yieldsCapacity pmc:ChaosMagicCondADangerSense ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 57; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondADangerSenseExpandsSign a pm:Conceptualizing ;
    rdfs:label "Danger-sense expanding into foreshadowing"@en, "Gefahrensinn weitet sich zur Vorahnung"@de ;
    skos:definition "If heeded and trusted, the danger-sense is said at times to widen into a general expectancy, a premonition of an imminent event."@en ;
    skos:note "Counted as a sign of success: a heeded and trusted danger-sense at times expands into an aura of expectation, a sense in advance that something is coming. Observable only by the operator."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 57; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAIgnoringDangerSenseCautela a pm:Cautioning ;
    rdfs:label "Ignoring the danger-sense is a mistake"@en, "Den Gefahrensinn zu ignorieren ist ein Fehler"@de ;
    skos:definition "Hine reports that ignoring the prickings of his danger-sense about situations or newly met people has always proved a mistake, though acting without explanation is hard."@en ;
    pm:cautionsAbout pmp:ChaosMagicCondADangerSenseCultivation ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 57; read in a full-text layer of the second printing" .


#
# Chapter 2, Magic in the Material World, yieldings
#

pmc:ChaosMagicCondASelfAssessmentYield a pm:Yielding ;
    rdfs:label "Self-assessment yields dispassionate self-examination"@en, "Selbsteinschätzung ergibt nüchterne Selbstprüfung"@de ;
    skos:definition "Examining one's behaviour, thoughts and feelings with some dispassion is called a skill that, once one begins to use it, carries over to every area of life."@en ;
    pm:byPractice pmp:ChaosMagicCondASelfAssessment ;
    pm:yieldsCapacity pmc:ChaosMagicCondADispassionateSelfExamination ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 2 Magic in the Material World, p. 29; read in a full-text layer of the second printing" .


#
# Chapter 3, Becoming a Magician, yieldings
#

pmc:ChaosMagicCondARegularPracticeYield a pm:Yielding ;
    rdfs:label "Regular practice yields self-discipline and confidence"@en, "Regelmäßige Übung ergibt Selbstdisziplin und Selbstvertrauen"@de ;
    skos:definition "Diligently doing a practice one has promised oneself is said to grow self-discipline and to increase confidence in one's ability to do things."@en ;
    pm:byPractice pmp:ChaosMagicCondARegularPractice ;
    pm:yieldsCapacity pmc:ChaosMagicCondASelfDisciplineAlly ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 41; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAColumnsYieldSelfExamination a pm:Yielding ;
    rdfs:label "Strengths/weaknesses page supports self-assessment"@en, "Stärken-Schwächen-Seite stützt Selbstprüfung"@de ;
    skos:definition "Listing perceived strengths and weaknesses in two columns, with what one would change and how magic might help, is offered as a useful aid to assessing oneself."@en ;
    pm:byPractice pmp:ChaosMagicCondAStrengthsWeaknessesColumns ;
    pm:yieldsCapacity pmc:ChaosMagicCondADispassionateSelfExamination ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, pp. 44-45; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondANoveltyYieldsConfidence a pm:Yielding ;
    rdfs:label "Reframing as novelty yields confidence"@en, "Umdeutung als Neuheit ergibt Selbstvertrauen"@de ;
    skos:definition "Treating a new situation as novel instead of difficult is said to let bodily arousal be read as excitement and to turn attention to the surroundings, so that one stays relaxed, which is what confidence is defined as."@en ;
    pm:byPractice pmp:ChaosMagicCondANoveltyReframing ;
    pm:yieldsCapacity pmc:ChaosMagicCondAConfidence ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 50; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondARehearsalYieldsRelaxation a pm:Yielding ;
    rdfs:label "Calm rehearsal yields relaxation in live situations"@en, "Ruhiges Durchspielen ergibt Gelassenheit in Echtsituationen"@de ;
    skos:definition "People who calmly rehearse in the mind the responses they might give to hard situations are reported to be more relaxed when the situation is live."@en ;
    pm:byPractice pmp:ChaosMagicCondAMentalRehearsal ;
    pm:yieldsCapacity pmc:ChaosMagicCondAConfidence ;
    skos:note "Hine ascribes this to a work he names and does not cite by edition: Research of the American Department of Defense, as cited by Hine without author, title or date. The node holds what Condensed Chaos reports; the named work is reachable in its own right and is not read here, so the node is entered as Hine's ascription and not as a mediated reading of that work."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 51; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAHonourYieldsPower a pm:Yielding ;
    rdfs:label "Keeping points of honour yields credibility and power"@en, "Einhalten der Ehrenpunkte ergibt Glaubwürdigkeit und Macht"@de ;
    skos:definition "Being dependable is said to make people confident in one, and the more confidence they have, the more powerful a magician one becomes."@en ;
    pm:byPractice pmp:ChaosMagicCondAPointsOfHonour ;
    pm:yieldsCapacity pmc:ChaosMagicCondADependabilityPower ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 52; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAAttentionTrainingYield a pm:Yielding ;
    rdfs:label "Attention training yields attentiveness"@en, "Aufmerksamkeitsschulung ergibt Aufmerksamkeit"@de ;
    skos:definition "Attention is called a skill, one level of which is training oneself to stay highly aware of the surroundings while detached and relaxed, another accepting arising impressions without dismissing or clinging to them."@en ;
    pm:byPractice pmp:ChaosMagicCondAAttentionTraining ;
    pm:yieldsCapacity pmc:ChaosMagicCondAAttentiveness ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 54; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondAInnerAttentivenessForEffectiveness a pm:Presupposing ;
    rdfs:label "Inner attentiveness as condition of effectiveness"@en, "Innere Aufmerksamkeit als Bedingung der Wirksamkeit"@de ;
    skos:definition "To be effective, a magician is said to need attention not only to what surrounds him but also to his emotions, motives, desires, habits and inner dialogue."@en ;
    pm:priorStep pmc:ChaosMagicCondAAttentiveness ;
    pm:dependentStep pmc:ChaosMagicCondAGoodMagician ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 3 Becoming a Magician, p. 54; read in a full-text layer of the second printing" .

#
# Chapter Four, Another Crack in the Wall
#

pmc:ChaosMagicCondBBasicSkillsBeforeTechniques a pm:Conceptualizing ;
    rdfs:label "Basic skills before techniques"@en, "Grundfertigkeiten vor Techniken"@de ;
    skos:definition "Contemporary magic works through practical techniques aimed at changing perception and attitude and widening options for action; these presuppose certain basic abilities that form the foundation for further work."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 58; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBSittingStillBeforeSeatedTechniquesPrerequisite a pm:Presupposing ;
    rdfs:label "Sitting still before seated techniques"@en, "Stillsitzen vor sitzenden Techniken"@de ;
    skos:definition "The ability to sit still and silent must come before any technique that requires at least sitting still."@en ;
    pm:priorStep pmc:ChaosMagicCondBAbilitySitStillSilent ;
    pm:dependentStep pmc:ChaosMagicCondBBasicSkillsBeforeTechniques ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Without it one will have little success with such techniques." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 58; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBAbilitySitStillSilent a pm:Conceptualizing ;
    rdfs:label "Ability to sit still and silent"@en, "Fähigkeit, still und schweigend zu sitzen"@de ;
    skos:definition "Basic trained ability to remain still and silent, named as the most elementary foundation skill."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 58; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBBoredomTrainingExercisesTheirPoint a pm:Conceptualizing ;
    rdfs:label "Boredom of training exercises as their point"@en, "Langeweile der Übungen als ihr Zweck"@de ;
    skos:definition "Core training exercises are said to be meant to feel trivial, boring or hard; doing them tests the limits of one's Achievable Reality and challenges inner resistance to change, widening cracks in paramount reality."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 58; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBDRAT a pm:Systematizing ;
    rdfs:label "DRAT formula"@en, "DRAT-Formel"@de ;
    skos:definition "Hine's formula for action in four qualities, discipline, relaxation, attention and transformation, each needing the others; transformation is what the first three together result in."@en ;
    pm:compiledBy "Phil Hine, in Condensed Chaos" ;
    dcterms:date "1995"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 58; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBInertiaGreatestMagicalAdversary a pm:Conceptualizing ;
    rdfs:label "Inertia as greatest magical adversary"@en, "Trägheit als größter magischer Gegner"@de ;
    skos:definition "Discipline is needed to overcome inertia, which shows up as inner voices persuading one to postpone what could be done now."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 59; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBTooMuchDisciplineBreedsInertiaCaution a pm:Cautioning ;
    rdfs:label "Too much discipline breeds inertia"@en, "Zu viel Disziplin erzeugt Trägheit"@de ;
    skos:definition "Excess discipline, particularly with unrealistic goals, can lead back into inertia."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondBDRAT ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 59; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBDisciplineNeedsRelaxationPrerequisite a pm:Presupposing ;
    rdfs:label "Discipline needs relaxation"@en, "Disziplin braucht Entspannung"@de ;
    skos:definition "Discipline requires relaxation to be used well; one must be relaxed about and within it."@en ;
    pm:priorStep pmc:ChaosMagicCondBRelaxationSkill ;
    pm:dependentStep pmc:ChaosMagicCondBDRAT ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Discipline held without ease, toward it and inside it, does not work." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 59; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBAttentionRequiresDisciplineRelaxationPrerequisite a pm:Presupposing ;
    rdfs:label "Attention requires discipline and relaxation"@en, "Aufmerksamkeit setzt Disziplin und Entspannung voraus"@de ;
    skos:definition "Attention is said to need discipline and relaxation, and transformation in turn to need all three."@en ;
    pm:priorStep pmc:ChaosMagicCondBRelaxationSkill ;
    pm:dependentStep pmc:ChaosMagicCondBSelfTransformationDRATOutcome ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 59; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBSelfTransformationDRATOutcome a pm:Conceptualizing ;
    rdfs:label "Self-transformation (DRAT outcome)"@en, "Selbsttransformation (DRAT-Ergebnis)"@de ;
    skos:definition "Transformation of oneself, claimed to follow from being disciplined, relaxed and attentive."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 59; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBApplyingDRATSkillLearning a pm:Practicing ;
    rdfs:label "Applying DRAT to skill learning"@en, "DRAT beim Erlernen von Fertigkeiten anwenden"@de ;
    skos:definition "Use the four DRAT qualities when learning new skills that need practice and repetition; first within ritual space, then carry the skills into ever wider areas of life."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 59; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBCompetenceOnlyRitualSpaceLimitationCaution a pm:Cautioning ;
    rdfs:label "Competence only in ritual space is a limitation"@en, "Kompetenz nur im Ritualraum ist eine Begrenzung"@de ;
    skos:definition "Skill and confidence that hold only inside the ritual space are called a limitation; the skills are to be carried outward until magic becomes a way of handling the whole world."@en ;
    pm:cautionsAbout pmp:ChaosMagicCondBApplyingDRATSkillLearning ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 59; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBDRATApplicationYieldsEverydayMagicYield a pm:Yielding ;
    rdfs:label "DRAT application yields everyday magic"@en, "DRAT-Anwendung ergibt Alltagsmagie"@de ;
    skos:definition "Applying DRAT-trained skills in widening areas leads to magic becoming a general principle of living."@en ;
    pm:byPractice pmp:ChaosMagicCondBApplyingDRATSkillLearning ;
    pm:yieldsCapacity pmc:ChaosMagicCondBMagicEverydayPrinciple ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 59; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBMagicEverydayPrinciple a pm:Conceptualizing ;
    rdfs:label "Magic as everyday principle"@en, "Magie als Alltagsprinzip"@de ;
    skos:definition "A state in which magic is no longer something done now and then but a body of principles for meeting the world one lives in."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 59; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBRelaxationSkill a pm:Conceptualizing ;
    rdfs:label "Relaxation skill"@en, "Fähigkeit zur Entspannung"@de ;
    skos:definition "Ability to relax at will, uniting thought, breath and action; presented as a starting point of magical training and as the beginning of sorcery, a willed change in one's reality."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 59; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBWesternMagicTooCerebral a pm:Conceptualizing ;
    rdfs:label "Western magic too cerebral; relaxation as counter"@en, "Westliche Magie zu verkopft; Entspannung als Gegenmittel"@de ;
    skos:definition "Hine holds that Western magic has become cerebral and abstract, people living inside their thoughts; relaxation, which requires body awareness, counters this."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 59; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBPerformanceDissonance a pm:Conceptualizing ;
    rdfs:label "Stress, flight-fight and Performance Dissonance"@en, "Stress, Kampf-Flucht und Leistungsdissonanz"@de ;
    skos:definition "Stress is personal and accumulates, and overload sets off the fight-or-flight reaction; Performance Dissonance names the gap between what one still expects of oneself and what is possible below one's best."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 60; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBUnresolvedArousalUnrealisticExpectationsCaution a pm:Cautioning ;
    rdfs:label "Unresolved arousal and unrealistic expectations"@en, "Unaufgelöste Erregung und unrealistische Erwartungen"@de ;
    skos:definition "If flight-fight arousal finds no resolution, chronic problems such as tension headaches can develop; struggling to meet unrealistic expectations reinforces anxiety and low self-esteem and adds further stress."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondBPerformanceDissonance ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 60; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBPreparingEffectiveRelaxation a pm:Practicing ;
    rdfs:label "Preparing for effective relaxation"@en, "Vorbereitung wirksamer Entspannung"@de ;
    skos:definition "1) Learn to recognise the signs of stress in oneself. 2) Ask whether one's habits and attitudes lessen or worsen it. 3) Be willing to change surroundings, way of life and habits. 4) Accept that some causes lie outside one's control and call for other means."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 60; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBIdentifyingStressBeforeRelaxingPrerequisite a pm:Presupposing ;
    rdfs:label "Identifying stress before relaxing"@en, "Stress erkennen vor Entspannen"@de ;
    skos:definition "Relaxing well is said to depend first on recognising the signs of stress, and then on looking at one's habits."@en ;
    pm:priorStep pmp:ChaosMagicCondBPreparingEffectiveRelaxation ;
    pm:dependentStep pmc:ChaosMagicCondBRelaxationSkill ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 60; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBAnxietyLoop a pm:Conceptualizing ;
    rdfs:label "Anxiety loop"@en, "Angstschleife"@de ;
    skos:definition "Model of anxiety in three linked steps: stress produces physiological arousal, arousal is interpreted as anxiety, and that interpretation triggers negative self-statements that create further stress."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 60; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBThreePartRelaxationBreakAnxiety a pm:Practicing ;
    rdfs:label "Three-part relaxation to break the anxiety loop"@en, "Dreiteilige Entspannung gegen die Angstschleife"@de ;
    skos:definition "Physical: learn deep easy breathing (basic meditation breathing) and muscle-relaxation patterns. Cognitive: identify habituated thoughts arising from arousal and change them, using self-affirming thoughts. Behavioural: evaluate inadequate stress responses and change them, e.g. notice and drop unnecessary tensions; use relaxation across many situations."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 61; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBThreePartRelaxationYieldsRelaxationYield a pm:Yielding ;
    rdfs:label "Three-part relaxation yields relaxation skill"@en, "Dreiteilige Entspannung ergibt Entspannungsfähigkeit"@de ;
    skos:definition "The physical, cognitive and behavioural components together constitute effective relaxation and break the anxiety loop."@en ;
    pm:byPractice pmp:ChaosMagicCondBThreePartRelaxationBreakAnxiety, pmp:ChaosMagicCondBPreparingEffectiveRelaxation ;
    pm:yieldsCapacity pmc:ChaosMagicCondBRelaxationSkill ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 61; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBRehearsingDisasterWorryCaution a pm:Cautioning ;
    rdfs:label "Rehearsing disaster by worry"@en, "Katastrophenproben durch Sorgen"@de ;
    skos:definition "People commonly invoke anxiety on purpose by visualising a stressful situation and imagining everything going wrong, thus preparing by worrying."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondBAnxietyLoop ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 61; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBRealisticRehearsalVisualisation a pm:Practicing ;
    rdfs:label "Realistic rehearsal by visualisation"@en, "Realistische Probe durch Visualisierung"@de ;
    skos:definition "When anticipating a difficult situation, visualise yourself assessing it realistically, trying suitable approaches and considering alternatives; acting it out in imagination."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 61; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBReducedDreadAnticipatedSituations a pm:Conceptualizing ;
    rdfs:label "Reduced dread of anticipated situations"@en, "Verminderte Furcht vor erwarteten Situationen"@de ;
    skos:definition "The real situation becomes less awesome; self-affirming thoughts reduce stress."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 61; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBVisualRehearsalReducesDreadYield a pm:Yielding ;
    rdfs:label "Visual rehearsal reduces dread"@en, "Visualisierte Probe mindert Furcht"@de ;
    skos:definition "Rehearsing a coming situation in imagination is said to make the real one less daunting."@en ;
    skos:note "The text hedges this (\"tends to\")."@en ;
    pm:byPractice pmp:ChaosMagicCondBRealisticRehearsalVisualisation ;
    pm:yieldsCapacity pmc:ChaosMagicCondBReducedDreadAnticipatedSituations ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 61; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBRelaxationChangeAccordanceWill a pm:Conceptualizing ;
    rdfs:label "Relaxation as change in accordance with will"@en, "Entspannung als Veränderung gemäß dem Willen"@de ;
    skos:definition "Relaxation is framed as a core magical technique and a small instance of willed change with wider ramifications; it relates to confidence and to sorcery, and relaxation training shows how much bodily experience is blocked out of consciousness."@en ;
    skos:note "The link to confidence points back to Chapter Three, in the first part of the book."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 61; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBBodyAwarenessExercise a pm:Practicing ;
    rdfs:label "Body awareness exercise"@en, "Übung zur Körperwahrnehmung"@de ;
    skos:definition "Move attention into distinct body areas, easiest when fully relaxed (fingertips, toes); practise anywhere, e.g. when standing with aching feet shift awareness to an armpit or the backs of the knees; develop by casting awareness behind the back or over as much body surface as possible."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 61; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBBodyAwarenessExerciseWidensAwarenessYield a pm:Yielding ;
    rdfs:label "Body awareness exercise widens awareness"@en, "Körperübung erweitert Wahrnehmung"@de ;
    skos:definition "The focusing exercise is presented as a way of widening body awareness."@en ;
    pm:byPractice pmp:ChaosMagicCondBBodyAwarenessExercise ;
    pm:yieldsCapacity pmc:ChaosMagicCondBWidenedBodyAwareness ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 61; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBWidenedBodyAwareness a pm:Conceptualizing ;
    rdfs:label "Widened body awareness"@en, "Erweiterte Körperwahrnehmung"@de ;
    skos:definition "Ability to direct and spread awareness across the body at will."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 61; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBPosturalShifts a pm:Practicing ;
    rdfs:label "Postural shifts"@en, "Haltungswechsel"@de ;
    skos:definition "Examine how your posture makes you feel; try different walks (cocky, casual, manic, sexy); notice habitual seating patterns and your body language towards others; try other postures and see whether behaviour changes; adopt body language fitting qualities you want to develop; notice how others respond. Apply findings to magical practice."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 62; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBPosturalShiftsTowardDesiredQualitiesYield a pm:Yielding ;
    rdfs:label "Postural shifts toward desired qualities"@en, "Haltungswechsel zu gewünschten Eigenschaften"@de ;
    skos:definition "Experimenting with posture and body language may change behaviour and help develop chosen qualities."@en ;
    pm:byPractice pmp:ChaosMagicCondBPosturalShifts ;
    pm:yieldsCapacity pmc:ChaosMagicCondBCultivatingQualitiesThroughBodyLanguage ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 62; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBCultivatingQualitiesThroughBodyLanguage a pm:Conceptualizing ;
    rdfs:label "Cultivating qualities through body language"@en, "Eigenschaften durch Körpersprache entwickeln"@de ;
    skos:definition "Developing desired personal qualities by adopting fitting body language."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 62; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBLeadingBodyParts a pm:Practicing ;
    rdfs:label "Leading with body parts"@en, "Mit Körperteilen führen"@de ;
    skos:definition "Keep posture upright and relaxed (t'ai chi or Alexander Technique if this is hard), then walk imagining being gently pulled by one body part without sticking it out: groin, belly, chest, nose, forehead; examine your own feelings."@en ;
    skos:note "Presented as building on postural shifts (pmp:ChaosMagicCondBPosturalShifts)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 62; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBSetAsideChakraLiterature a pm:Conceptualizing ;
    rdfs:label "Set aside chakra literature"@en, "Chakra-Literatur beiseitelegen"@de ;
    skos:definition "Hine tells the reader to forget what they have read about chakras and examine their own feelings when leading with body parts."@en ;
    skos:note "Dispute with the chakra-correspondence literature as a tradition."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 62; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBDoEasy a pm:Practicing ;
    rdfs:label "Do Easy"@en, "Do Easy (Leicht tun)"@de ;
    skos:definition "Look at every movement, however small (dressing, lifting things, chores), and seek the least effortful way of making it; feel the contact of the fingertips with an object and move it with no more force than needed; regard objects calmly, picture what is to be done with them and find the simplest way."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 62; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBEnergyEconomyPresentAwarenessAction a pm:Conceptualizing ;
    rdfs:label "Energy economy and present awareness in action"@en, "Energiesparsamkeit und Gegenwärtigkeit im Handeln"@de ;
    skos:definition "Using far less effort, and staying aware of the act in hand instead of hurrying through it with the mind already ahead in the future."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 62; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBDoEasyYieldsEconomyAwarenessYield a pm:Yielding ;
    rdfs:label "Do Easy yields economy and awareness"@en, "Do Easy ergibt Sparsamkeit und Gewahrsein"@de ;
    skos:definition "Doing Do Easy is said to result in less energy expenditure and awareness of the task."@en ;
    pm:byPractice pmp:ChaosMagicCondBDoEasy ;
    pm:yieldsCapacity pmc:ChaosMagicCondBEnergyEconomyPresentAwarenessAction ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 62; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBEasyWayDoEverything a pm:Conceptualizing ;
    rdfs:label "Easy way to do everything"@en, "Für alles gibt es einen leichten Weg"@de ;
    skos:definition "The Do Easy exercises reveal how tasks get labelled dull and rushed through; every act has an effortless way, and simple acts are noticed only once something gets in their way."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 63; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBTimeByproductConsciousness a pm:Conceptualizing ;
    rdfs:label "Time as byproduct of consciousness"@en, "Zeit als Nebenprodukt des Bewusstseins"@de ;
    skos:definition "Time is held to be a byproduct of consciousness; we move between remembered pasts and fantasised futures; magic stresses staying in the present but can also use personal past and futures."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 63; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBEvokingEmotionThroughMemory a pm:Practicing ;
    rdfs:label "Evoking emotion through memory"@en, "Gefühlsevokation durch Erinnerung"@de ;
    skos:definition "Build up the remembered sensations of a significant moment (for instance a former lover): relive the meeting of eyes, a touch, a voice, the pounding heart; let the feelings grow and attend to what the body does."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 63; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBDialogueFigurePast a pm:Practicing ;
    rdfs:label "Dialogue with a figure from the past"@en, "Dialog mit einer Gestalt der Vergangenheit"@de ;
    skos:definition "For unfinished business with someone from your past, evoke them through memory and enter into dialogue."@en ;
    skos:note "Presented as building on evoking emotion through memory (pmp:ChaosMagicCondBEvokingEmotionThroughMemory)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 63; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBFreeingEmotionTrigger a pm:Practicing ;
    rdfs:label "Freeing an emotion from its trigger"@en, "Gefühl von seinem Auslöser lösen"@de ;
    skos:definition "Call up a strong feeling through memory, then let its source dim while the feeling itself is strengthened, until it is no longer tied to anything."@en ;
    skos:note "Presented as building on evoking emotion through memory (pmp:ChaosMagicCondBEvokingEmotionThroughMemory)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 63; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBTriggerFadingYieldsFreeEmotionYield a pm:Yielding ;
    rdfs:label "Trigger-fading yields free emotion"@en, "Auslöser-Ausblenden ergibt freies Gefühl"@de ;
    skos:definition "Intensifying emotion while fading its trigger yields a free emotion for magic."@en ;
    pm:byPractice pmp:ChaosMagicCondBFreeingEmotionTrigger ;
    pm:yieldsCapacity pmc:ChaosMagicCondBFreeEmotionMagicalFuel ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 63; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBFreeEmotionMagicalFuel a pm:Conceptualizing ;
    rdfs:label "Free emotion as magical fuel"@en, "Freies Gefühl als magischer Treibstoff"@de ;
    skos:definition "An intense emotion detached from its source, usable for further acts of magic."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 63; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBDepressiveFantasySelectiveFeedbackCaution a pm:Cautioning ;
    rdfs:label "Depressive fantasy as selective feedback"@en, "Depressive Fantasie als selektive Rückkopplung"@de ;
    skos:definition "When depressed one slides into imagined futures dominated by fears and worst cases; fantasy reinforces thoughts until we convince ourselves an intention is right."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondBTimeByproductConsciousness ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 63; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBAgainstAeonicFutureProjections a pm:Conceptualizing ;
    rdfs:label "Against aeonic future-projections"@en, "Gegen äonische Zukunftsprojektionen"@de ;
    skos:definition "Hine lists the Age of Aquarius, the New Age, the Aeon of Horus and even Chaos as forms the never-reached ideal future takes in occult belief."@en ;
    skos:note "Disputes New Age and Thelemic (Aeon of Horus) eschatology and chaos-magic's own; mocked with Bugs Bunny."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 64; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBIdealisedFutureStaysOutReachCaution a pm:Cautioning ;
    rdfs:label "Idealised future stays out of reach"@en, "Idealisierte Zukunft bleibt unerreichbar"@de ;
    skos:definition "An idealised future that one keeps working toward is said never to be reached."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondBAgainstAeonicFutureProjections ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 64; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBGreatWork a pm:Conceptualizing ;
    rdfs:label "Living now: the Great Work"@en, "Jetzt leben: das Große Werk"@de ;
    skos:definition "The Great Work is described as drawing the future into the present: the magician takes hold of reality and lives in the now, unbound by the past and knowing the future as the outcome of his Will."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 64; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBRelationshipTimeBasicRequisite a pm:Conceptualizing ;
    rdfs:label "Relationship with Time as basic requisite"@en, "Verhältnis zur Zeit als Grundvoraussetzung"@de ;
    skos:definition "Coming to know how one stands toward Time is called a basic condition of magical practice."@en ;
    skos:note "Stated as a requisite of magical practice as a whole; entered as a concept because the dependent step is magic in general, which has no node of its own."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 64; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBObservingCyclicalShiftsPerception a pm:Practicing ;
    rdfs:label "Observing cyclical shifts of perception"@en, "Zyklische Wahrnehmungsschwankungen beobachten"@de ;
    skos:definition "Observe shifts in awareness and perception with seasonal and daily cycles, understand them and make the best use of these fluctuations."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 64; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBLateralDiaries a pm:Practicing ;
    rdfs:label "Lateral diaries"@en, "Laterale Tagebücher"@de ;
    skos:definition "Widen the magical diary to four columns: 1) the outward events of a journey or situation; 2) the memories that surfaced; 3) scraps of reading from books, papers or adverts; 4) bits of conversation overheard."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 64; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBPerceivingNonLinearConnections a pm:Conceptualizing ;
    rdfs:label "Perceiving non-linear connections"@en, "Nichtlineare Zusammenhänge wahrnehmen"@de ;
    skos:definition "Awareness of non-linear links between events that are normally censored from awareness."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 64; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBLateralDiariesRevealNonLinearYield a pm:Yielding ;
    rdfs:label "Lateral diaries reveal non-linear links"@en, "Laterale Tagebücher zeigen nichtlineare Bezüge"@de ;
    skos:definition "Keeping the four-column diary will demonstrate censored non-linear connections."@en ;
    pm:byPractice pmp:ChaosMagicCondBLateralDiaries ;
    pm:yieldsCapacity pmc:ChaosMagicCondBPerceivingNonLinearConnections ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 64; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBPerceptionDynamic a pm:Conceptualizing ;
    rdfs:label "Perception as dynamic; narrowing and widening"@en, "Wahrnehmung als dynamisch; Verengen und Weiten"@de ;
    skos:definition "Perception is not passive but fluctuates with mood, environment and cognition; it can be explored by narrowing or by widening."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 64; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBSustainedFixedGaze a pm:Conceptualizing ;
    rdfs:label "Sustained fixed gaze"@en, "Anhaltend fixierter Blick"@de ;
    skos:definition "Ability to hold one's gaze on an object for long periods (object concentration)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 65; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBVisualisationProficiency a pm:Conceptualizing ;
    rdfs:label "Visualisation proficiency"@en, "Visualisierungsfähigkeit"@de ;
    skos:definition "A degree of skill at visualising, which magical practice is said to need from the start."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 65; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBVisualisationBasicMagicalPractice a pm:Conceptualizing ;
    rdfs:label "Visualisation basic to magical practice"@en, "Visualisierung grundlegend für magische Praxis"@de ;
    skos:definition "Some skill at visualisation is called something magical practice cannot do without; training goes from plain shapes to whole scenes."@en ;
    skos:note "Stated as a requisite of magical practice as a whole; entered as a concept because the dependent step is magic in general, which has no node of its own."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 65; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBVisualisationTraining a pm:Practicing ;
    rdfs:label "Visualisation training"@en, "Visualisierungstraining"@de ;
    skos:definition "Start by visualising plain shapes and build toward detailed scenes; investigate one's own relationship with colour."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 65; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBVisualisationTrainingYieldsVisualisationProficiencyYield a pm:Yielding ;
    rdfs:label "Visualisation training yields visualisation proficiency"@en, "Visualisierungstraining ergibt Visualisierungsfähigkeit"@de ;
    skos:definition "Working up from simple shapes to detailed scenes is the route given to the degree of visualisation that magical practice is said to need."@en ;
    pm:byPractice pmp:ChaosMagicCondBVisualisationTraining ;
    pm:yieldsCapacity pmc:ChaosMagicCondBVisualisationProficiency ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 65; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBSmellHotlineMemory a pm:Conceptualizing ;
    rdfs:label "Smell as hotline to memory"@en, "Geruch als direkter Draht zur Erinnerung"@de ;
    skos:definition "Smell is said to play a key role in magic as a direct line to memory and association."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 65; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBBuildingPersonalScentCorrespondences a pm:Practicing ;
    rdfs:label "Building personal scent correspondences"@en, "Eigene Duftentsprechungen bilden"@de ;
    skos:definition "Observe which memories scents call up, and assemble a private table linking perfumes, feelings and symbol systems to use in staging experiences."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 65; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBAuditoryTactileTasteExploration a pm:Practicing ;
    rdfs:label "Auditory, tactile and taste exploration"@en, "Erkundung von Hören, Tasten, Schmecken"@de ;
    skos:definition "Attend to separate aspects of sound, for example by listening for a week to the pitch of voices and comparing manner with content; touch fabrics and objects mindfully and feel surfaces blindfold; eat without reading or talking so taste fills awareness; eat lemon and some days later recall the act vividly."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 65; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBMakeOwnSensoryProgramme a pm:Conceptualizing ;
    rdfs:label "Make your own sensory programme"@en, "Eigenes Sinnesprogramm erstellen"@de ;
    skos:definition "Many fixed magical exercise programmes for the senses exist, but Hine says making up one's own is as easy and more fun: the methods are not fixed."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 65; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBPerceptualGestalt a pm:Practicing ;
    rdfs:label "Assembling a perceptual gestalt"@en, "Wahrnehmungsgestalt zusammensetzen"@de ;
    skos:definition "Imagine a scene using all modalities together, e.g. paddling in water: see yourself in the scene, feel feet in water and water moving against legs, add a smell, sun on your back and a soundtrack."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 65; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBPathworking a pm:Conceptualizing ;
    rdfs:label "Pathworking"@en, "Pfadarbeit"@de ;
    skos:definition "Combining such many-sensed scenes underlies Pathworking: the magician builds a story carrying a mythic or teaching layer, steps inside it and identifies with it until it means something personally; the images can be built deliberately or arise of themselves."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 66; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBThreeTypesPathworking a pm:Systematizing ;
    rdfs:label "Three types of Pathworking"@en, "Drei Arten von Pfadarbeit"@de ;
    skos:definition "Hine's typology: Structured, Semi-structured and Unstructured Pathworkings, differing in how much narrative detail is given."@en ;
    pm:compiledBy "Phil Hine, in Condensed Chaos" ;
    dcterms:date "1995"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 66; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBStructuredPathworking a pm:Practicing ;
    rdfs:label "Structured Pathworking"@en, "Strukturierte Pfadarbeit"@de ;
    skos:definition "A complete narrative giving perceptual, emotional and behavioural cues which the participant follows passively; best read onto audio tape or, more usually, read aloud by another person. Example given in Chapter Seven."@en ;
    skos:note "A worked example of the structured kind is printed in Chapter Seven."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 66; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBStructuredPathworkingTrainsEntryNewYield a pm:Yielding ;
    rdfs:label "Structured pathworking trains entry to new belief-systems"@en, "Strukturierte Pfadarbeit übt Einstieg in neue Systeme"@de ;
    skos:definition "Structured pathworkings are recommended above all for training, and especially for first contact with a belief system one does not yet know."@en ;
    pm:byPractice pmp:ChaosMagicCondBStructuredPathworking ;
    pm:yieldsCapacity pmc:ChaosMagicCondBFamiliarisationUnfamiliarBeliefSystem ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 66; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBFamiliarisationUnfamiliarBeliefSystem a pm:Conceptualizing ;
    rdfs:label "Familiarisation with an unfamiliar belief-system"@en, "Vertrautwerden mit einem fremden Glaubenssystem"@de ;
    skos:definition "Gaining a working familiarity with a belief system one has not worked with before."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 66; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBSemiStructuredPathworking a pm:Practicing ;
    rdfs:label "Semi-structured Pathworking"@en, "Halbstrukturierte Pfadarbeit"@de ;
    skos:definition "A narrator opens with an entry passage that sets the scene and the purpose (for instance leading to a strange castle with the task of finding whoever holds a key to one's magical power), and the rest is left to the participant."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 66; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBUnstructuredPathworkingThroughSymbolGate a pm:Practicing ;
    rdfs:label "Unstructured Pathworking through a symbol-gate"@en, "Unstrukturierte Pfadarbeit durch ein Symboltor"@de ;
    skos:definition "Take one image, a tarot card, rune or I Ching hexagram, see it in three dimensions, treat it as a gate and pass through into the mythic country behind it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 66; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBUsesPathworking a pm:Conceptualizing ;
    rdfs:label "Uses of pathworking"@en, "Verwendungen der Pfadarbeit"@de ;
    skos:definition "Apart from training and getting to know a belief system, pathworkings put one into scenes that provoke complete identification, and can leave open spaces for scrying, speaking with entities or casting enchantments."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 66; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBDeathDecompositionPathworking a pm:Practicing ;
    rdfs:label "Death-and-decomposition pathworking"@en, "Pfadarbeit von Tod und Verwesung"@de ;
    skos:definition "A pathworking in which one dies, is buried and goes through each stage of decay, identifying so fully that it provokes emotional and mental reactions."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 66; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBDeathPathworkingAddressesFearDeathYield a pm:Yielding ;
    rdfs:label "Death pathworking addresses fear of death"@en, "Todes-Pfadarbeit bearbeitet Todesangst"@de ;
    skos:definition "The death pathworking will at least remind of mortality and perhaps help with fear of death."@en ;
    skos:note "The text hedges this (\"perhaps\")."@en ;
    pm:byPractice pmp:ChaosMagicCondBDeathDecompositionPathworking ;
    pm:yieldsCapacity pmc:ChaosMagicCondBWorkingFearDeath ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 67; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBWorkingFearDeath a pm:Conceptualizing ;
    rdfs:label "Working on fear of death"@en, "Arbeit an der Todesangst"@de ;
    skos:definition "Being brought face to face with the certainty of dying, and perhaps helped with the fear of it."@en ;
    skos:note "The text hedges this (\"perhaps\")."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 67; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBKinestheticMemory a pm:Practicing ;
    rdfs:label "Kinesthetic memory: raising the double's arm"@en, "Kinästhetisches Gedächtnis: den Arm des Doppelgängers heben"@de ;
    skos:definition "Slowly raise the left arm noting muscles, air resistance, joints and bones; repeat a few times; then vividly evoke the same sensations while only imagining raising it; continue until the kinesthetic arm feels nearly as vivid as the real one; extend to a range of movements and orientations."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 67; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBKinestheticArmNearlyVividRealSign a pm:Conceptualizing ;
    rdfs:label "Kinesthetic arm nearly as vivid as real"@en, "Kinästhetischer Arm fast so lebhaft wie der echte"@de ;
    skos:definition "Sign of progress: experiencing raising the imagined arm almost as vividly as the physical one."@en ;
    skos:note "Counted as a sign of success: the imagined raising of the arm is felt almost as vividly as the real one, the point up to which the exercise is repeated. No deadline and no rate; the practitioner alone judges it."@en ;
    skos:note "It bears on pmp:ChaosMagicCondBKinestheticMemory."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 67; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBKinestheticPracticeYieldsDoubleYield a pm:Yielding ;
    rdfs:label "Kinesthetic practice yields the Double"@en, "Kinästhetische Übung ergibt den Doppelgänger"@de ;
    skos:definition "Continuing kinesthetic evocation with many movements is said eventually to allow free movement in the Double."@en ;
    pm:byPractice pmp:ChaosMagicCondBKinestheticMemory ;
    pm:yieldsCapacity pmc:ChaosMagicCondBDoubleBodyLight ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 67; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBDoubleBodyLight a pm:Conceptualizing ;
    rdfs:label "Free movement in the Body of Light"@en, "Freie Bewegung im Lichtkörper"@de ;
    skos:definition "Sharpened awareness of the Double, also called Body of Light or Astral Body, and in the end the ability to move about freely in it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 67; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBUsesDouble a pm:Conceptualizing ;
    rdfs:label "Uses of the Double"@en, "Anwendungen des Doppelgängers"@de ;
    skos:definition "The Double can be used to rehearse difficult situations or tasks, in shape-shifting and invocation, and in exploring dream and liminal trances."@en ;
    skos:note "Shape-shifting and invocation with the Double are treated in Chapter Eight."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 67; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBBuildingAstralTemple a pm:Practicing ;
    rdfs:label "Building an astral temple"@en, "Einen Astraltempel bauen"@de ;
    skos:definition "Combine perceptual gestalts and kinesthetic memory to build an imagined place you go to perform magic; use any symbolism that suits (cyberspace zone, space station, skyscraper) rather than traditional quasi-Masonic/hermetic decor; use it for all works otherwise done physically and as a start for inner exploration; with practice build in emotional associations."@en ;
    skos:note "Presented as building on assembling a perceptual gestalt (pmp:ChaosMagicCondBPerceptualGestalt), kinesthetic memory: raising the double's arm (pmp:ChaosMagicCondBKinestheticMemory)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 67; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBOwnSymbolismOverTraditionalTemple a pm:Conceptualizing ;
    rdfs:label "Own symbolism over traditional temple decor"@en, "Eigene Symbolik statt traditioneller Tempelausstattung"@de ;
    skos:definition "Astral temples are traditionally furnished with quasi-Masonic and Hermetic symbols, but Hine sees nothing against furnishing one's own; imagination is its only limit."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 67; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBAstralTempleConditioningYieldsCalmYield a pm:Yielding ;
    rdfs:label "Astral temple conditioning yields calm power"@en, "Tempel-Konditionierung ergibt ruhige Kraft"@de ;
    skos:definition "Building emotional associations into the temple with practice makes entry bring calm, relaxation and a sense of power."@en ;
    pm:byPractice pmp:ChaosMagicCondBBuildingAstralTemple ;
    pm:yieldsCapacity pmc:ChaosMagicCondBCalmPowerEnteringTemple ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 67; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBCalmPowerEnteringTemple a pm:Conceptualizing ;
    rdfs:label "Calm power on entering the temple"@en, "Ruhige Kraft beim Betreten des Tempels"@de ;
    skos:definition "On entering the astral temple, becoming calm, relaxed and feeling at one's most powerful."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 67; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBStarChamber a pm:Practicing ;
    rdfs:label "Entering and using the Star Chamber"@en, "Die Sternenkammer betreten und nutzen"@de ;
    skos:definition "See the eight-rayed chaos star spinning before you until it turns into a vortex that pulls you into a crystal sphere hanging in deep space, whose size can be changed; lay the hands on the crystal pillar at waist height in its middle (a short purple flash gives control); will yourself to any point of space and time; draw devices out of the walls for tasks."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 68; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBPurpleFlashTouchingPillarSign a pm:Conceptualizing ;
    rdfs:label "Purple flash on touching the pillar"@en, "Violetter Blitz beim Berühren der Säule"@de ;
    skos:definition "Laying the hands on the pillar makes the chamber glimmer with a short purple flash, which is taken to mean the operator now controls it."@en ;
    skos:note "Counted as a sign of success: a brief purple flash in the chamber when the hands touch the pillar, marking full control. Announced in advance and seen only inside the visualisation; no deadline or rate."@en ;
    skos:note "It bears on pmp:ChaosMagicCondBStarChamber."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 68; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBStarChamberYieldsTravelDevicesYield a pm:Yielding ;
    rdfs:label "Star Chamber yields travel and devices"@en, "Sternenkammer ergibt Reisen und Geräte"@de ;
    skos:definition "The Star Chamber serves as astral temple and vehicle for multiverse travel and device-based operations."@en ;
    pm:byPractice pmp:ChaosMagicCondBStarChamber ;
    pm:yieldsCapacity pmc:ChaosMagicCondBTravelThroughMultiverse, pmc:ChaosMagicCondBStarChamberDevices ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 68; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBTravelThroughMultiverse a pm:Conceptualizing ;
    rdfs:label "Travel through the multiverse"@en, "Reisen durch das Multiversum"@de ;
    skos:definition "Travelling to any place or time inside the Star Chamber by asserting one's will."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 68; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBStarChamberDevices a pm:Conceptualizing ;
    rdfs:label "Star Chamber devices"@en, "Geräte der Sternenkammer"@de ;
    skos:definition "Drawing devices out of the chamber walls: spheres for scrying and making servitors, projectors to send out desires, baffles and collectors to gather the radiation of black holes."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 68; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBTranceDeliberateAlterationPerception a pm:Conceptualizing ;
    rdfs:label "Trance as deliberate alteration of perception"@en, "Trance als absichtliche Wahrnehmungsänderung"@de ;
    skos:definition "We shift perception constantly; trance means intentionally altering perception to specific parameters, often a profound absorption filling awareness; Western ideas of the passive, limp trance subject are too narrow."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 68; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBEnteringProlongingTranceWill a pm:Conceptualizing ;
    rdfs:label "Entering and prolonging trance at will"@en, "Trance willentlich herbeiführen und halten"@de ;
    skos:definition "Ability to enter and prolong states of profound absorption at will."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 68; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBTranceAbilityPrimeRequisite a pm:Conceptualizing ;
    rdfs:label "Trance ability as prime requisite"@en, "Tranceeignung als Hauptvoraussetzung"@de ;
    skos:definition "Being able to go into trance and stay there is called another chief condition of living magically."@en ;
    skos:note "Stated as a requisite of magical practice as a whole; entered as a concept because the dependent step is magic in general, which has no node of its own."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 68; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBExcitatoryInhibitoryTranceRoutes a pm:Systematizing ;
    rdfs:label "Excitatory and inhibitory trance routes"@en, "Erregende und hemmende Tranceeingänge"@de ;
    skos:definition "Most routes into trance are classified as excitatory (strong prolonged stimulation) or inhibitory (sensory reduction, silence)."@en ;
    pm:compiledBy "Phil Hine, in Condensed Chaos" ;
    dcterms:date "1995"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 68; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBExcitatoryTranceTechniques a pm:Practicing ;
    rdfs:label "Excitatory trance techniques"@en, "Erregende Trancetechniken"@de ;
    skos:definition "Hyperventilating, dancing, chanting, drumming or other strong stimulation kept up long enough to change the body's state and lead to an ecstatic peak."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 68; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBExcitationYieldsEcstaticPeakYield a pm:Yielding ;
    rdfs:label "Excitation yields ecstatic peak"@en, "Erregung ergibt ekstatischen Gipfel"@de ;
    skos:definition "Prolonged excitatory techniques enable the magician to reach the ecstatic peak."@en ;
    pm:byPractice pmp:ChaosMagicCondBExcitatoryTranceTechniques ;
    pm:yieldsCapacity pmc:ChaosMagicCondBEcstaticPeakMomentOperation ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 68; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBEcstaticPeakMomentOperation a pm:Conceptualizing ;
    rdfs:label "Ecstatic peak as moment of operation"@en, "Ekstatischer Gipfel als Wirkmoment"@de ;
    skos:definition "A peak of ecstasy in which awareness narrows to the projected will alone; in such moments, it is said, spells can be cast, a god's persona can take form and speak, or beliefs can be planted in the Deep (unconscious) Mind."@en ;
    skos:note "The text hedges this (\"may\")."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 68; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBInhibitoryTranceTechniques a pm:Practicing ;
    rdfs:label "Inhibitory trance techniques"@en, "Hemmende Trancetechniken"@de ;
    skos:definition "Withdrawal of the senses, going without sleep or food, or breathing slowly and rhythmically."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 69; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBInhibitionYieldsSilenceEgoLooseningYield a pm:Yielding ;
    rdfs:label "Inhibition yields silence and ego-loosening"@en, "Hemmung ergibt Stille und Ich-Lockerung"@de ;
    skos:definition "Inhibitory techniques serve to silence inner dialogue, confuse time sense and disturb the ego-sense."@en ;
    pm:byPractice pmp:ChaosMagicCondBInhibitoryTranceTechniques ;
    pm:yieldsCapacity pmc:ChaosMagicCondBSilencingInnerDialogueLooseningTime ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 69; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBSilencingInnerDialogueLooseningTime a pm:Conceptualizing ;
    rdfs:label "Silencing inner dialogue, loosening time and ego"@en, "Inneren Dialog stillen, Zeit und Ich lockern"@de ;
    skos:definition "Silencing the internal dialogue, confusing linear time-sense and disturbing ego boundaries."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 69; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBPhysicalAwarenessPrimeNecessity a pm:Conceptualizing ;
    rdfs:label "Physical awareness as prime necessity"@en, "Körpergewahrsein als Hauptnotwendigkeit"@de ;
    skos:definition "Because all trance techniques have distinct physiological effects, physical awareness is held to be a prime necessity for magic."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 69; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBHeadOrientedCultureCaution a pm:Cautioning ;
    rdfs:label "Head-oriented culture"@en, "Kopflastige Kultur"@de ;
    skos:definition "Our culture makes us head-oriented, caught in inner commentary and hyper-real images; this is named a problem for trance work."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondBPhysicalAwarenessPrimeNecessity ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 69; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBIsolationLoosenSelf a pm:Practicing ;
    rdfs:label "Isolation to loosen the self"@en, "Abgeschiedenheit zur Lockerung des Selbst"@de ;
    skos:definition "Move somewhere isolated so the self, normally sustained by transactions with others, becomes more malleable; a classical gambit for trance."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 69; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBFeatsBeyondNormalRepertoire a pm:Conceptualizing ;
    rdfs:label "Feats beyond normal repertoire"@en, "Leistungen jenseits des gewohnten Repertoires"@de ;
    skos:definition "In trance, intentional or not, one can perform feats outside one's normal repertoire, as when the body takes over in danger once self-awareness is frozen by shock."@en ;
    skos:note "The text hedges this (\"often\")."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 69; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBDifficultyLettingGoCaution a pm:Cautioning ;
    rdfs:label "Difficulty of letting go"@en, "Schwierigkeit des Loslassens"@de ;
    skos:definition "The wish to keep the body under control is itself an obstacle: giving way and losing inhibition, above all in company, is very hard for many Westerners and is socially disapproved."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondBEnteringProlongingTranceWill ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 69; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBPossessionTranceDelphicPriestess a pm:Conceptualizing ;
    rdfs:label "Possession trance of the Delphic priestess"@en, "Besessenheitstrance der delphischen Priesterin"@de ;
    skos:definition "Lucian's account (quoted) shows the Pythia raving around the shrine, foaming and shrieking until the god forced her into intelligible speech; offered as a culture where disinhibition marks a successful event."@en ;
    skos:note "Hine names Lucian; the wording matches the description of the Delphic priestess in Lucan's Pharsalia, book 5, which a later reader should check against that work."@en ;
    skos:note "Hine ascribes this to a work he names and does not cite by edition: Lucian, a description of a priestess of Delphi entering trance, quoted by Hine without naming the work. The node holds what Condensed Chaos reports; the named work is reachable in its own right and is not read here, so the node is entered as Hine's ascription and not as a mediated reading of that work."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 69; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBApolloNaming a pm:Naming ;
    rdfs:label "Apollo (possessing the Pythia)"@en, "Apollon (die Pythia besetzend)"@de ;
    skos:definition "In the quoted Lucian passage Apollo mounts the priestess and finally compels her to speak intelligibly."@en ;
    pm:nameForm "Apollo" ;
    pm:nameRole "god possessing an oracle priestess" ;
    skos:note "Hine ascribes this to a work he names and does not cite by edition: Lucian, a description of a priestess of Delphi entering trance, quoted by Hine without naming the work. The node holds what Condensed Chaos reports; the named work is reachable in its own right and is not read here, so the node is entered as Hine's ascription and not as a mediated reading of that work."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 69; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBPossessionCanUnpleasantResistedCaution a pm:Cautioning ;
    rdfs:label "Possession can be unpleasant and resisted"@en, "Besessenheit kann unangenehm sein und wird abgewehrt"@de ;
    skos:definition "Trance is not always pleasant, especially possession: feeling something else using one's limbs and voice is odd; Westerners tend to resist even a beneficent spirit; the possessed often remember nothing."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondBEnhancementAbilitiesPossession ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 69; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBBlottingOutPersonalityEasePossession a pm:Practicing ;
    rdfs:label "Blotting out personality to ease possession"@en, "Persönlichkeit ausblenden zur Erleichterung der Besessenheit"@de ;
    skos:definition "Magicians are said to have used drugs, exhaustion or long ritual to switch off the personality for a while and so make possession easier."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 70; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBFiveReasonsEnterTrance a pm:Systematizing ;
    rdfs:label "Five reasons to enter trance"@en, "Fünf Gründe für Trance"@de ;
    skos:definition "Hine's list: 1) Knowledge, 2) Enhancement of Abilities, 3) Communal Ecstasy, 4) Connectivity, 5) Demonstration of Ability."@en ;
    pm:compiledBy "Phil Hine, in Condensed Chaos" ;
    dcterms:date "1995"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 70; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBKnowledgeSpiritsTrance a pm:Conceptualizing ;
    rdfs:label "Knowledge from spirits in trance"@en, "Wissen von Geistern in Trance"@de ;
    skos:definition "Getting knowledge that cannot be had otherwise, from asking a dead aunt what lies beyond death to asking a healing spirit about herbs, at times by travelling to some region of the innerworlds to consult a given entity."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 70; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBEnhancementAbilitiesPossession a pm:Conceptualizing ;
    rdfs:label "Enhancement of abilities by possession"@en, "Steigerung von Fähigkeiten durch Besessenheit"@de ;
    skos:definition "Being possessed by a war-god is said to raise fighting skill or give temporary command over other spirits."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 70; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBTranceDiagnosisToadPossessionHealing a pm:Practicing ;
    rdfs:label "Trance diagnosis and toad-possession healing"@en, "Trancediagnose und Krötenbesessenheits-Heilung"@de ;
    skos:definition "Hine looked at a client with a recurring throat complaint in a light trance of vision and saw a bloated toad-like being stuck there; his allies, asked in trance, said it would heed only a larger toad; in a healing ceremony Hine was then possessed by a toad-spirit to deal with it."@en ;
    skos:note "Outcome of the healing is not stated."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 70; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBToadLikeCreatureNaming a pm:Naming ;
    rdfs:label "Toad-like throat spirit"@en, "Krötenartiger Halsgeist"@de ;
    skos:definition "A toad-like creature seen in vision trance, swollen and lodged in a client's throat as cause of a recurring problem, unwilling to leave and heeding only a bigger toad."@en ;
    pm:nameForm "toad-like creature" ;
    pm:nameRole "illness-causing spirit" ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 70; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBAlliesNaming a pm:Naming ;
    rdfs:label "Hine's allies"@en, "Hines Verbündete"@de ;
    skos:definition "Spirit allies consulted in trance who give practical advice on how to deal with another spirit."@en ;
    pm:nameForm "allies" ;
    pm:nameRole "advising helper spirits" ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 70; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBToadSpiritNaming a pm:Naming ;
    rdfs:label "Toad-spirit"@en, "Krötengeist"@de ;
    skos:definition "A larger toad-spirit by whom Hine was possessed in a healing ceremony, the only entity the throat spirit would take notice of."@en ;
    pm:nameForm "toad-spirit" ;
    pm:nameRole "possessing healing ally" ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 70; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBCommunalEcstasyMediatingMyth a pm:Conceptualizing ;
    rdfs:label "Communal ecstasy: mediating myth"@en, "Gemeinschaftliche Ekstase: Mythos vermitteln"@de ;
    skos:definition "The magician mediates between everyday life and the community's mythic world, guiding others into sacred mythic participation along the secret paths of its cosmology."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 70; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBWesternMythicOverloadStumblingBlockCaution a pm:Cautioning ;
    rdfs:label "Western mythic overload as stumbling block"@en, "Westliche mythische Überfülle als Stolperstein"@de ;
    skos:definition "A major hindrance to taking on magical roles here: the West draws on an enormous, mixed stock of myth (unlike, for example, a Tamang shaman's shared one), and myth has been handed to professionals, leaving people outside it; some routes are forgotten or garbled."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondBCommunalEcstasyMediatingMyth ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 70; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBUniversalMythicProcesses a pm:Conceptualizing ;
    rdfs:label "Universal mythic processes; oral transmission"@en, "Universelle mythische Prozesse; mündliche Weitergabe"@de ;
    skos:definition "Some mythic processes, the Underworld Journey among them, are close to universal; because so much is learned second-hand from reading, oral teaching is rare; first-hand bodily experience with a trustworthy guide beats reading."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 71; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBImpartingFeelMagicOutdoors a pm:Practicing ;
    rdfs:label "Imparting the feel of magic outdoors"@en, "Das Gefühl der Magie im Freien vermitteln"@de ;
    skos:definition "In the first coven Hine belonged to, the priestess took the group outside, to a park, a street under the moon or the shore, whenever she wanted them to sense what magic feels like."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 71; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBConnectivityCreativeLeaps a pm:Conceptualizing ;
    rdfs:label "Connectivity: creative leaps"@en, "Konnektivität: kreative Sprünge"@de ;
    skos:definition "Seeing links between ideas and fields; a creative jump that releases a rush of fresh ideas and eagerness."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 71; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBTranceAgainstWritersBlock a pm:Practicing ;
    rdfs:label "Trance against writer's block"@en, "Trance gegen Schreibblockade"@de ;
    skos:definition "Go into trance and let scraps of talk, verse or pictures pass before the inner eye until something rises and ideas join up."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 71; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBTranceYieldsConnectionsYield a pm:Yielding ;
    rdfs:label "Trance yields connections"@en, "Trance ergibt Verbindungen"@de ;
    skos:definition "Hine reports that in trance ideas and links spring up as filings jump to a magnet."@en ;
    pm:byPractice pmp:ChaosMagicCondBTranceAgainstWritersBlock ;
    pm:yieldsCapacity pmc:ChaosMagicCondBConnectivityCreativeLeaps ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 71; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBDemonstrationTranceProwess a pm:Conceptualizing ;
    rdfs:label "Demonstration of trance prowess"@en, "Nachweis von Trancekönnen"@de ;
    skos:definition "Apprentices are at times asked to go into trance to prove what they can do."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 71; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBSpiritsTestExtremePsychicPressureCaution a pm:Cautioning ;
    rdfs:label "Spirits test by extreme psychic pressure"@en, "Geister prüfen durch extremen psychischen Druck"@de ;
    skos:definition "Spirits often put the magician under severe psychic strain, a shortened form of the underworld initiation; certain spirits, demons and gods try to drive one mad and hand over their wisdom only once one has proved equal to them, the spirits of psychotropic substances above all."@en ;
    pm:cautionsAbout pmc:ChaosMagicCondBDemonstrationTranceProwess ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 72; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBSpiritsPsychotropicsNaming a pm:Naming ;
    rdfs:label "Spirits of psychotropics"@en, "Geister der Psychotropika"@de ;
    skos:definition "Spirits associated with psychotropic substances, said to be particularly prone to testing the magician to the edge of madness before yielding wisdom."@en ;
    pm:nameForm "spirits of psychotropics" ;
    pm:nameRole "testing spirits" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 72; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBNoMagicianIsolation a pm:Conceptualizing ;
    rdfs:label "No magician in isolation; learn from everything"@en, "Kein Magier in Isolation; von allem lernen"@de ;
    skos:definition "Nobody becomes a magician cut off from others, though times of chosen solitude are needed; since teachers are scarce, one has to learn from all people and all things."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 72; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBRecognisingOnsetAlteredAwareness a pm:Practicing ;
    rdfs:label "Recognising onset of altered awareness"@en, "Einsetzen veränderter Wahrnehmung erkennen"@de ;
    skos:definition "Learn to notice when awareness begins to shift, try every route into trance, and rely on one's own senses and intuition rather than on inner chatter or on what one believes one should do."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 72; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBMirrorGazingIntoLiminality a pm:Practicing ;
    rdfs:label "Mirror gazing into liminality"@en, "Spiegelschauen in die Liminalität"@de ;
    skos:definition "Gaze at one's reflection in a mirror until the glass goes dark and one feels drawn into it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 72; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBMirrorDarkensSlidingSign a pm:Conceptualizing ;
    rdfs:label "Mirror darkens, sliding in"@en, "Spiegel verdunkelt sich, Hineingleiten"@de ;
    skos:definition "The mirror darkening and the feeling of sliding into it mark the end-point of the gazing exercise."@en ;
    skos:note "Counted as a sign of success: the mirror darkens and one feels oneself slide into it, the end point of the gazing. No deadline; the text warns that reaching it may at first be very hard."@en ;
    skos:note "It bears on pmp:ChaosMagicCondBMirrorGazingIntoLiminality."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 72; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBEgosNeedTrackTime a pm:Conceptualizing ;
    rdfs:label "Ego's need to track time"@en, "Bedürfnis des Ichs, Zeit zu messen"@de ;
    skos:definition "At first mirror gazing may seem agonisingly difficult because the ego needs to know how much time has passed to keep itself fixed."@en ;
    skos:note "The text hedges this (\"may\")."@en ;
    skos:note "Read at the text as a stated difficulty at the start of the exercise, not as a condition of failure: no outcome is named that would show the gazing did not work."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 72; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBLiminalPerception a pm:Conceptualizing ;
    rdfs:label "Liminal perception"@en, "Liminale Wahrnehmung"@de ;
    skos:definition "Any technique that disturbs linear awareness and inner dialogue moves the magician into liminal perception, a borderline state, e.g. the half-awake, half-dreaming state after exhaustion, where images and sounds arise as if from elsewhere."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 72; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBProficiencyLiminalPerception a pm:Conceptualizing ;
    rdfs:label "Proficiency in liminal perception"@en, "Fertigkeit in liminaler Wahrnehmung"@de ;
    skos:definition "Becoming proficient at entering the borderline state of liminal perception."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 72; read in a full-text layer of the second printing" .

pmp:ChaosMagicCondBScrying a pm:Practicing ;
    rdfs:label "Scrying"@en, "Kristallschauen (Scrying)"@de ;
    skos:definition "Use a reflective medium (mirror, ideally shiny black, or bowl of dark fluid) in a dimly lit room with lights (candles) placed so they do not reflect in it; optionally burn relaxant incense and do a meditation or relaxation first; relax and gaze steadily without staring hard or straining, letting images arise like daydreams; first let random images come, later ask specific questions; practise regularly."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 72; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBLightTranceBeforeScryingRandomPrerequisite a pm:Presupposing ;
    rdfs:label "Light trance before scrying; random images before questions"@en, "Leichte Trance vor dem Schauen; Zufallsbilder vor Fragen"@de ;
    skos:definition "Scrying requires the ability to enter a light trance in which images arise; first let random images well up, only later try specific questions."@en ;
    pm:priorStep pmc:ChaosMagicCondBEnteringProlongingTranceWill ;
    pm:dependentStep pmp:ChaosMagicCondBScrying ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 72; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBDoNotStareOrStrainCaution a pm:Cautioning ;
    rdfs:label "Do not stare or strain in scrying"@en, "Beim Schauen nicht starren oder sich anstrengen"@de ;
    skos:definition "Gaze steadily without staring too hard or concentrating intensely; the knack only comes with practice."@en ;
    pm:cautionsAbout pmp:ChaosMagicCondBScrying ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 73; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBIntuitivePsychicFaculties a pm:Conceptualizing ;
    rdfs:label "Intuitive and psychic faculties"@en, "Intuitive und psychische Fähigkeiten"@de ;
    skos:definition "Growth of intuition and of psychic faculties; the knack of relaxing and allowing pictures to rise is also said to open psychometry and aura reading."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
