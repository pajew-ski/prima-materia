pmc:ChaosMagicCondBDoNotImposeWillDreamsCaution a pm:Cautioning ;
    rdfs:label "Do not impose will on dreams"@en, "Den Willen nicht in Träume zwingen"@de ;
    skos:definition "Whatever the method, dreams are not to be forced by will; one stays relaxed while forming the intention."@en ;
    pm:cautionsAbout pmp:ChaosMagicCondBBasicDreamControl ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
