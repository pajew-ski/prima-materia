pmc:ChaosMagicCondBDreamMagicBreaksLinearConsciousness a pm:Conceptualizing ;
    rdfs:label "Dream magic breaks linear consciousness"@en, "Traummagie bricht lineares Bewusstsein"@de ;
    skos:definition "Dream magic is called a powerful way of breaking from linear consciousness; prospective magicians may be identified by dream content and people often meet guides in dreams; in dreams historical time and distance are abolished."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
    dcterms:source "Hine, Condensed Chaos: An Introduction to Chaos Magic (Tempe: New Falcon, 1995, first edition, second printing 1996), ch. 4 Another Crack in the Wall, p. 73; read in a full-text layer of the second printing" .

pmc:ChaosMagicCondBGuidesNaming a pm:Naming ;
    rdfs:label "Guides met in dreams"@en, "In Träumen begegnende Führer"@de ;
    skos:definition "Guides that people commonly first meet in dreams."@en ;
    pm:nameForm "guides" ;
    pm:nameRole "spirit guides" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
