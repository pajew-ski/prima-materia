pmc:ChaosMagicCondBDreamTelepathyVerification a pm:Conceptualizing ;
    rdfs:label "Dream telepathy and its verification"@en, "Traumtelepathie und ihre Überprüfung"@de ;
    skos:definition "Telepathic transmission into dreams has been researched parapsychologically; one may dream of someone in a situation they really experience; the only way to know is to check with the persons concerned."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:CondensedChaos ;
