pmc:ChaosMagicChaoSpareNaming a pm:Naming ;
    rdfs:label "Spare, a saint of the Church of Chaos"@en, "Spare, ein Heiliger der Kirche des Chaos"@de ;
    skos:definition "Austin Osman Spare is counted by the author among the holy figures of his Church of Chaos, for identifying the manoeuvres of enchantment and divination."@en ;
    pm:nameForm "Spare" ;
    pm:nameRole "saint of the Church of Chaos" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:ChaoismAndChaosMagic ;
