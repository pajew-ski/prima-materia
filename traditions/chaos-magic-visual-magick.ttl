pmp:ChaosMagicVmBInvokingMartialGodToDevelopAggression a pm:Practicing ;
    rdfs:label "Invoking a martial god to develop aggression"@en, "Anrufung eines Kriegsgottes zur Entwicklung der Aggression"@de ;
    skos:definition "To build up one’s aggressive side, invoke a war deity, for instance Mars, Horus, Tiu, Ares, Nergal or Tezcatlipoca, doing it with force, passion and wildness rather than humility."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
    dcterms:source "Fries, Visual Magick: A Practical Guide to Trance, Sigils and Visualization Techniques (Oxford: Mandrake of Oxford, copyright 1992; a later printing with ISBN 978-1-869928-57-5), chapter 6 Access to Imagination, p. 75; read in the full-text layer of the open scan archive item JanFries-visual-magick-1992" .

pmc:ChaosMagicVmBMartialGodsNaming a pm:Naming ;
    rdfs:label "Martial gods"@en, "Kriegsgötter"@de ;
    skos:definition "Horus, Mars, Ares, Tiu and Nergal are named as war deities suited to developing one’s aggressive side; they answer force, passion and wildness."@en ;
    pm:nameForm "Horus", "Mars", "Ares", "Tiu", "Nergal" ;
    pm:nameRole "martial gods" ;
    pm:attestedBy pm:textualAttestation ;
