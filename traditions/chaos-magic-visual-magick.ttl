    rdfs:label "Callawaya Mesa healing ritual yields Cure of disease, weakness, poverty and ill-luck"@en, "Callawaya-Mesa-Heilritual ergibt Heilung von Krankheit, Schwäche, Armut und Unglück"@de ;
    skos:definition "The practice “Callawaya Mesa healing ritual” is stated to produce “Cure of disease, weakness, poverty and ill-luck”."@en ;
    pm:byPractice pmp:ChaosMagicVmBCallawayaMesaHealingRitual ;
    pm:yieldsCapacity pmc:ChaosMagicVmBCureOfDiseaseWeaknessPovertyAnd ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
    dcterms:source "Fries, Visual Magick: A Practical Guide to Trance, Sigils and Visualization Techniques (Oxford: Mandrake of Oxford, copyright 1992; a later printing with ISBN 978-1-869928-57-5), chapter 8 Mandala Building, p. 106; read in the full-text layer of the open scan archive item JanFries-visual-magick-1992" .

pmc:ChaosMagicVmBCallawayasKeepTheirVillageTradition a pm:Conceptualizing ;
    rdfs:label "Callawayas keep their village tradition"@en, "Callawayas halten an ihrer Dorftradition fest"@de ;
    skos:definition "Though they travel widely, most Callawayas keep the layout of their home village and insist that only it works."@en ;
    skos:note "A statement on how fixed a method is held to be: each healer keeps the village form as the only one that works."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
    dcterms:source "Fries, Visual Magick: A Practical Guide to Trance, Sigils and Visualization Techniques (Oxford: Mandrake of Oxford, copyright 1992; a later printing with ISBN 978-1-869928-57-5), chapter 8 Mandala Building, p. 107; read in the full-text layer of the open scan archive item JanFries-visual-magick-1992" .

pmc:ChaosMagicVmBAnkariNaming a pm:Naming ;
    rdfs:label "Ankari"@en, "Ankari"@de ;
    skos:definition "Messenger spirit who carries the Mesa’s message to the otherworld; its traditional offering is an egg greased with llama fat."@en ;
    pm:nameForm "Ankari" ;
    pm:nameRole "messenger spirit" ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
    dcterms:source "Fries, Visual Magick: A Practical Guide to Trance, Sigils and Visualization Techniques (Oxford: Mandrake of Oxford, copyright 1992; a later printing with ISBN 978-1-869928-57-5), chapter 8 Mandala Building, p. 107; read in the full-text layer of the open scan archive item JanFries-visual-magick-1992" .

pmc:ChaosMagicVmBSacredMountainsOfAndesNaming a pm:Naming ;
    rdfs:label "Guardian sacred mountains"@en, "Schützende heilige Berge"@de ;
    skos:definition "The holy Andean mountains, old places of power, receive nests in the Mesa; a patient generally knows which mountain guards them, however distant."@en ;
    pm:nameForm "sacred mountains of the Andes" ;
    pm:nameRole "guardian powers of places" ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
