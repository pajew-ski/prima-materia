    rdfs:label "Holy Guardian Angel (Abra-Melin)"@en, "Heiliger Schutzengel (Abramelin)"@de ;
    skos:definition "The chief coordinator of the mind in the Abra-Melin system, appearing idealised and often human-like; its appearance symbolises the adept's true will."@en ;
    pm:nameForm "Holy Guardian Angel (HGA)" ;
    pm:nameRole "metapart, embodiment of true will" ;
    pm:attestedBy pm:textualAttestation ;
