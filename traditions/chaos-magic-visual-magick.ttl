pmc:ChaosMagicVmAPracticeNeededFluentImprovisedSpeechPrerequisite a pm:Presupposing ;
    rdfs:label "Practice needed for fluent improvised speech"@en, "Übung für flüssiges Sprechen"@de ;
    skos:definition "Anyone unpractised at improvised speech, prayer or hypnotic verse needs practice to become fluent; halting, forgetting words and repeating are normal."@en ;
    pm:priorStep pmp:ChaosMagicVmAExerciseOneSpeakingSensesAloud ;
    pm:dependentStep pmp:ChaosMagicVmAExerciseTwoPerceivingTree ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
