pmc:ChaosMagicVmBHeightenedAttentionOfListener a pm:Conceptualizing ;
    rdfs:label "Heightened attention of the listener"@en, "Gesteigerte Aufmerksamkeit des Zuhörers"@de ;
    skos:definition "Whispered suggestions make the client listen more closely, attention perhaps rising because whispering signals secret and important content."@en ;
    pm:attestedBy pm:textualAttestation ;
