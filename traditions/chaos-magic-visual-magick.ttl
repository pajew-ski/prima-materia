pmc:ChaosMagicVmCSilentDogNaming a pm:Naming ;
    rdfs:label "Silent dog"@en, "Stiller Hund"@de ;
    skos:definition "Spirit whose function resembles Anubis or Wotan's wolves: travelling between worlds; in silent-dog consciousness the shaman travels through dream and imagination into realms closed to human consciousness."@en ;
    pm:nameForm "silent dog" ;
    pm:nameRole "psychopomp, traveller between worlds" ;
