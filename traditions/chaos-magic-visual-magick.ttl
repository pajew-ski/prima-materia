pmp:ChaosMagicVmBVaryingInnerVoiceToRecolourAlternatives a pm:Practicing ;
    rdfs:label "Varying inner voice to recolour alternatives"@en, "Innere Stimme variieren, um Alternativen umzufärben"@de ;
    skos:definition "Notice how you picture a proposed experiment and how your inner voice sounds when naming options; try announcing something dull in a fascinating tone and something wonderful in a boring one."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
