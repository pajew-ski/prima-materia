pmc:ChaosMagicVmAMultisensoryImaginingYieldsIntenseGodContactYield a pm:Yielding ;
    rdfs:label "Multisensory imagining yields intense god contact"@en, "Alle Sinne ergeben Kontakt"@de ;
    skos:definition "Combining all senses in imagining a god-form produces really intense contact."@en ;
    pm:byPractice pmp:ChaosMagicVmAMultisensoryGodFormImagining ;
