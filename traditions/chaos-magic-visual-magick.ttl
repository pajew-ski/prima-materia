pmp:ChaosMagicVmCShamanicPossessionWorking a pm:Practicing ;
    rdfs:label "Shamanic possession working"@en, "Schamanische Besessenheitsarbeit"@de ;
    skos:definition "The shaman lets guardian spirits arise and take over; in possession they act through the body, revealing the unknown, working magick and healing; the conscious mind steps back and gives control to deep-mind aspects."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
