pmc:ChaosMagicVmBTezcatlipocaNaming a pm:Naming ;
    rdfs:label "Tezcatlipoca"@en, "Tezcatlipoca"@de ;
    skos:definition "Aztec warrior god, described as the killer of Quetzalcoatl, listed among the martial deities to invoke."@en ;
    skos:note "The text layer reads Tezcadipoca, an OCR confusion of the printed name."@en ;
    pm:nameForm "Tezcatlipoca" ;
    pm:nameRole "Aztec warrior deity" ;
