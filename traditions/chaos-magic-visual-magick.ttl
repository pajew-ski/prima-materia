pmc:ChaosMagicVmAEarthingManifestingWillFleshEarth a pm:Conceptualizing ;
    rdfs:label "Earthing: manifesting will in flesh on earth"@en, "Erdung des Willens"@de ;
    skos:definition "Linking the sigil with ground and feet acts as a strong suggestion that the will should manifest bodily on earth."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
