    rdfs:label "Changing one’s mind toward a desired self"@en, "Den Geist auf ein gewünschtes Selbst hin verändern"@de ;
    skos:definition "Shifting one’s state and self-image in a chosen direction."@en ;
    pm:attestedBy pm:textualAttestation ;
