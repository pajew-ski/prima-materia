pmp:ChaosMagicVmBCallingSpiritOfLove a pm:Practicing ;
    rdfs:label "Calling the spirit of love"@en, "Anrufung des Geistes der Liebe"@de ;
    skos:definition "Satisfy consciousness with ceremonial prayer to a fitting love deity (e.g. Ishtar, Venus, Inanna, Fria, Babalon, Erzulie or Vanadis) and research its symbols and myths, but above all call with power and passion, with a loving attitude and loving voice."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
    dcterms:source "Fries, Visual Magick: A Practical Guide to Trance, Sigils and Visualization Techniques (Oxford: Mandrake of Oxford, copyright 1992; a later printing with ISBN 978-1-869928-57-5), chapter 7 Imagination and Prayer, p. 94; read in the full-text layer of the open scan archive item JanFries-visual-magick-1992" .

pmc:ChaosMagicVmBLoveDeitiesNaming a pm:Naming ;
    rdfs:label "Love deities"@en, "Liebesgottheiten"@de ;
    skos:definition "Ishtar, Venus, Inanna, Fria, Babalon, Vanadis and Erzulie (a Voodoo love goddess) are listed as deities to pray to when seeking the spirit of love."@en ;
    pm:nameForm "Babalon", "Erzulie", "Fria", "Inanna", "Ishtar", "Vanadis", "Venus" ;
    pm:nameRole "deities of love" ;
