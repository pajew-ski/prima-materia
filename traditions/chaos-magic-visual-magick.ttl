pmp:ChaosMagicVmBAssociatingPleasantMemory a pm:Practicing ;
    rdfs:label "Associating a pleasant memory"@en, "Assoziieren einer angenehmen Erinnerung"@de ;
    skos:definition "Select a happy event, view it first dissociated, seeing yourself in it, then repeat it in full association, feeling, seeing, hearing, tasting and smelling as you did then, and compare."@en ;
    pm:attestedBy pm:textualAttestation ;
