pmc:ChaosMagicVmBWordlessPrimalContactWithElements a pm:Conceptualizing ;
    rdfs:label "Wordless primal contact with the elements"@en, "Wortloser urtümlicher Kontakt mit den Elementen"@de ;
    skos:definition "Chaotic sounds may reach a deep, primal level of each element without needing words."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
