pmc:ChaosMagicVmAStrivingPerfectWordingFailure a pm:Conceptualizing ;
    rdfs:label "Striving for perfect wording"@en, "Perfektionismus"@de ;
    skos:definition "Beginners who try to make the description precise or poetic start worrying about words when they run out or tangle, which takes them far from the tree experience."@en ;
    skos:note "Counted as a condition of failure: it concerns pmp:ChaosMagicVmAExerciseTwoPerceivingTree."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
