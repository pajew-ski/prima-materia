pmc:ChaosMagicVmCBeastConsciousnessGifts a pm:Conceptualizing ;
    rdfs:label "Beast consciousness and its gifts"@en, "Tierbewusstsein und seine Gaben"@de ;
    skos:definition "Animal consciousness used for fighting reflexes but also divination, ritual, exorcism, dance, exercise, breathing and sexual practice; impossible beasts (dragon, Qi-Lin, phoenix, drunken monkey sage) can do impossible things."@en ;
    pm:attestedBy pm:textualAttestation ;
