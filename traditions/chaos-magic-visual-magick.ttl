pmc:ChaosMagicVmBDispellingNegativeInfluences a pm:Conceptualizing ;
    rdfs:label "Dispelling negative influences"@en, "Vertreiben negativer Einflüsse"@de ;
    skos:definition "Driving off or holding at a distance whatever negative influences surround the practitioner."@en ;
    pm:attestedBy pm:textualAttestation ;
