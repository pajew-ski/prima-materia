pmc:ChaosMagicVmCSylphsNaming a pm:Naming ;
    rdfs:label "Sylphs (air/wind spirits)"@en, "Sylphen (Luftgeister)"@de ;
    skos:definition "Wind spirits with little form who perceive everything and sing it in endless songs; called sylphs (glossed as forest spirits) in the 15th-century magical revival; shy, rarely speaking in human words, seen as moving shadows between trees; other wind spirits shape clouds or race with Wode on the storm."@en ;
    skos:note "Fries names Paracelsus among his sources for the shyness of the sylphs."@en ;
    pm:nameForm "sylph" ;
    pm:nameRole "elemental of air" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
    dcterms:source "Fries, Visual Magick: A Practical Guide to Trance, Sigils and Visualization Techniques (Oxford: Mandrake of Oxford, copyright 1992; a later printing with ISBN 978-1-869928-57-5), chapter 9 Spirits of Nature, pp. 125-126; read in the full-text layer of the open scan archive item JanFries-visual-magick-1992" .

pmc:ChaosMagicVmCWodeNaming a pm:Naming ;
    rdfs:label "Wode (wild hunter)"@en, "Wode (Wilder Jäger)"@de ;
    skos:definition "Wode (regional variant of Wodan), with whom wind spirits are seen racing and howling on the storm wind."@en ;
    pm:nameForm "Wode" ;
    pm:nameRole "storm god leading wind spirits" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
