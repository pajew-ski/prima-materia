pmc:ChaosMagicVmCTameCallersGetTameBeastsCaution a pm:Cautioning ;
    rdfs:label "Tame callers get tame beasts"@en, "Zahme Rufer bekommen zahme Tiere"@de ;
    skos:definition "The subconscious is no supermarket of pets; wild beasts come to wild people; one not wild enough ends up with an ox, pig, sheep or poodle."@en ;
    pm:cautionsAbout pmp:ChaosMagicVmCExerciseSixWakingTheBeasts ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
