pmc:ChaosMagicVmAIntenseContactGodForm a pm:Conceptualizing ;
    rdfs:label "Intense contact with a god-form"@en, "Intensiver Gotteskontakt"@de ;
    skos:definition "A representation of the deity that feels fully real."@en ;
    pm:attestedBy pm:textualAttestation ;
