    rdfs:label "Letter yields hearing by deep mind"@en, "Brief ergibt Gehör"@de ;
    skos:definition "Writing to the gods in a hard-to-read script gets the deep mind to listen."@en ;
    pm:byPractice pmp:ChaosMagicVmALetterGodsDeepSelf ;
