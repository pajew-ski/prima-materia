    rdfs:label "Self-induced restful trance through slow speech"@en, "Trance durch langsames Sprechen"@de ;
    skos:definition "Slow gentle speech with pauses calms the mind, enriches awareness and lets one float into a pleasant half-sleeping trance."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
