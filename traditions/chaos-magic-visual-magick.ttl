pmc:ChaosMagicVmAMagicalTime a pm:Conceptualizing ;
    rdfs:label "The Magical Time"@en, "Die Magische Zeit"@de ;
    skos:definition "A spontaneous non-rational state, an open-eyed waking dream in which time appears to halt and awareness grasps the surroundings with intense lucidity; Maat devotees call it the vortex; it suspends ego and suits sigil work."@en ;
    skos:note "Psychologists said to attribute it to normally unaware brain areas."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
    dcterms:source "Fries, Visual Magick: A Practical Guide to Trance, Sigils and Visualization Techniques (Oxford: Mandrake of Oxford, copyright 1992; a later printing with ISBN 978-1-869928-57-5), chapter 2 The Ritual, p. 22; read in the full-text layer of the open scan archive item JanFries-visual-magick-1992" .

pmc:ChaosMagicVmAMagicalTimeCannotProducedEffort a pm:Conceptualizing ;
    rdfs:label "Magical Time cannot be produced by effort"@en, "Magische Zeit nicht erzwingbar"@de ;
    skos:definition "The Magical Time arises of itself in an individual mode and cannot be induced by effort."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
    dcterms:source "Fries, Visual Magick: A Practical Guide to Trance, Sigils and Visualization Techniques (Oxford: Mandrake of Oxford, copyright 1992; a later printing with ISBN 978-1-869928-57-5), chapter 2 The Ritual, p. 22; read in the full-text layer of the open scan archive item JanFries-visual-magick-1992" .

pmc:ChaosMagicVmAVacuityBeforeTransmissionPrerequisite a pm:Presupposing ;
    rdfs:label "Vacuity before transmission"@en, "Leere vor Übertragung"@de ;
    skos:definition "The sigil is transmitted only once some degree of vacuity has been reached."@en ;
    pm:priorStep pmc:ChaosMagicVmAVacuitySuspensionConsciousIdentity ;
    pm:dependentStep pmp:ChaosMagicVmABasicTransmissionFormula ;
    pm:prerequisiteStrength pm:prescribedOrder ;
