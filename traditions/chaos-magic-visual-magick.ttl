pmc:ChaosMagicVmBElementalVoicesYieldsIdentityWithInvoked a pm:Yielding ;
    rdfs:label "Elemental voices yields Identity with the invoked force"@en, "Elementstimmen ergibt Identität mit der angerufenen Kraft"@de ;
    skos:definition "The practice “Elemental voices” is stated to produce “Identity with the invoked force”."@en ;
    pm:byPractice pmp:ChaosMagicVmBElementalVoices ;
