pmc:ChaosMagicVmCSerpentSpiritNaming a pm:Naming ;
    rdfs:label "Serpent spirit"@en, "Schlangengeist"@de ;
    skos:definition "A spirit at home in the body's tunnels and waterways; the possessed shaman hisses and sways and can regulate fluids and energies, clear obstructions and suck out hidden poisons."@en ;
    pm:nameForm "serpent" ;
    pm:nameRole "shamanic spirit helper, healer of flows" ;
