pmc:ChaosMagicVmBPauseForMandalaToSinkInPrerequisite a pm:Presupposing ;
    rdfs:label "Pause for the mandala to sink in"@en, "Pause, damit das Mandala einsinkt"@de ;
    skos:definition "After consecration the mandala is left alone during a pause before prayer resumes and it is burned, following the Callawaya method."@en ;
    skos:note "No consequence of skipping is stated."@en ;
    pm:priorStep pmp:ChaosMagicVmBCallawayaMesaHealingRitual ;
