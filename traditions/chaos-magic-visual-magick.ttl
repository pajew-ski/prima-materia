pmp:ChaosMagicVmCPsychometry a pm:Practicing ;
    rdfs:label "Psychometry"@en, "Psychometrie"@de ;
    skos:definition "Hold the object a while, then place it on the brow or solar plexus; with closed eyes look into it with an open mind, ready for any sensation; variants: see it as transparent, imagine it veiled and open the veil when ready, or imagine it opened and enter it and the worlds behind it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
