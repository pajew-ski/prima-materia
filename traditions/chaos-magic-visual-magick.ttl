pmc:ChaosMagicVmCUndinesNaming a pm:Naming ;
    rdfs:label "Undines (water spirits)"@en, "Undinen (Wassergeister)"@de ;
    skos:definition "Water spirits, thought larger and more graceful than earth spirits, of beautiful body and lascivious mind, always in motion; in folk tales they lure humans to watery graves and marriages with them usually fail."@en ;
    pm:nameForm "undine" ;
    pm:nameRole "elemental of water" ;
