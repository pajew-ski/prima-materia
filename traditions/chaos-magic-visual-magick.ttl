pmp:ChaosMagicVmAGroundSigilDancedAwayNema a pm:Practicing ;
    rdfs:label "Ground sigil danced away (Nema)"@en, "Bodensigille nach Nema"@de ;
    skos:definition "Draw the sigil upon the ground in the manner of a Voodoo vever, in flour, grain, ash, chalk or earth colours; circle it for a while doing one’s usual invocation or prayer, then dance on it until the shape is gone."@en ;
    skos:note "Fries reports this from Nema; it is entered as his ascription, and the named source is not read through him."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
