pmp:ChaosMagicVmBBanishingWithRadiatingFieldOfLight a pm:Practicing ;
    rdfs:label "Banishing with a radiating field of light"@en, "Bannen mit ausstrahlendem Lichtfeld"@de ;
    skos:definition "Classical banishing: visualise a field of light and send it out in every direction until every negative influence has fled or withdrawn to a safe distance."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
