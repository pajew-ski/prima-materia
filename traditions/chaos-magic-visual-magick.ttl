pmc:ChaosMagicVmASaltSymptomsFailure a pm:Conceptualizing ;
    rdfs:label "Salt symptoms"@en, "Salz-Symptome"@de ;
    skos:definition "Slow coarse lines, sluggish hand, tense wrist and rigid, laboured symmetry show a salt-type blockage."@en ;
    skos:note "Counted as a condition of failure: it concerns pmp:ChaosMagicVmACirclesSpiralsExercise."@en ;
    skos:note "Remedy: work on power and fluid motion."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
