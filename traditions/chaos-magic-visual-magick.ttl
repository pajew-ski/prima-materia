pmp:ChaosMagicVmATransmissionHalfSleepLightHypnosis a pm:Practicing ;
    rdfs:label "Transmission in half-sleep or light hypnosis"@en, "Übertragung im Halbschlaf"@de ;
    skos:definition "Use the open alpha states of hypnagogic half-sleep or light hypnosis with sigils that are easy to imagine."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
