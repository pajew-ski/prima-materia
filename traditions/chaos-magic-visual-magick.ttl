pmc:ChaosMagicVmBInvocation a pm:Conceptualizing ;
    rdfs:label "Invocation"@en, "Anrufung"@de ;
    skos:definition "Practice for contacting the material one wants: forces and sentiences in ritual, the chosen dream world in astral travel, the divine sentience that indwells and heals identity in god-form work."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
