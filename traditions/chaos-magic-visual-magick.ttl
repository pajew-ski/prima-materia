pmc:ChaosMagicVmBGoodMageWorksPassionately a pm:Conceptualizing ;
    rdfs:label "A good mage works passionately"@en, "Ein guter Magier arbeitet leidenschaftlich"@de ;
    skos:definition "A good invocation is not a well-phrased intellectual game; it must seize the whole being."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
