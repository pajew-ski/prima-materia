pmp:ChaosMagicVmCGreetingSpiritsPlace a pm:Practicing ;
    rdfs:label "Greeting the spirits of a place"@en, "Begrüßung der Ortsgeister"@de ;
    skos:definition "When working at a power place (even a few trees or a brook), address the local spirits kindly before and after the magick, with a short prayer and a modest offering."@en ;
    skos:note "Belongs to stage 2 of Exercise six, where the advice is given, and is meant for any working at a place of power."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
