pmc:ChaosMagicVmBMisappliedAssociationPattern a pm:Conceptualizing ;
    rdfs:label "Misapplied association pattern"@en, "Fehlangewandtes Assoziationsmuster"@de ;
    skos:definition "Some people dissociate their good memories, leaving them vague, while fully associating with painful ones, so that only the bad counts as real. Others apply the pattern automatically: with Fries’s first drastic past-life memories his deep mind shifted image and viewpoint whenever things grew too hard."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
