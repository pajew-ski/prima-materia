pmc:ChaosMagicVmBRealChangesOfAwarenessByActivating a pm:Conceptualizing ;
    rdfs:label "Real changes of awareness by activating many mind parts"@en, "Echte Bewusstseinsänderung durch Aktivierung vieler Geistesteile"@de ;
    skos:definition "Such ritual engages many parts of the mind that stay latent and bored in a dignified ceremony pleasing only consciousness."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
