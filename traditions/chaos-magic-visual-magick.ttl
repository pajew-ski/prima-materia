pmc:ChaosMagicVmBTwoWeeksProbablyInsufficientFailure a pm:Conceptualizing ;
    rdfs:label "Two weeks probably insufficient"@en, "Zwei Wochen vermutlich unzureichend"@de ;
    skos:definition "Fries expects that two weeks of daily practice will most likely not be enough for proficiency."@en ;
    skos:note "Counted as a condition of failure: of Cup meditation (two-cup prayer); it names a minimum of two weeks of daily practice and says that this will probably not suffice; no deadline after which the practice counts as failed."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
