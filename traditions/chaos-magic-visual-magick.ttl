pmc:ChaosMagicVmBConsecratingRoomsAtmosphere a pm:Conceptualizing ;
    rdfs:label "Consecrating the room’s atmosphere"@en, "Weihen der Raumatmosphäre"@de ;
    skos:definition "Sprinkled drops of the charged fluid consecrate the atmosphere wherever they land."@en ;
    pm:attestedBy pm:textualAttestation ;
