pmc:ChaosMagicVmCLivingWorkingBeastSpirits a pm:Conceptualizing ;
    rdfs:label "Living and working with beast spirits"@en, "Mit Tiergeistern leben und arbeiten"@de ;
    skos:definition "A solid contact and pact with one or several power beasts that help discover and do true will, teach new attitudes and methods, raise new self-aspects and widen freedom of choice."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
