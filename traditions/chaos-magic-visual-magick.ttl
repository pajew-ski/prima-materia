pmp:ChaosMagicVmBMixedInvocationProgramme a pm:Practicing ;
    rdfs:label "Mixed invocation programme"@en, "Gemischtes Anrufungsprogramm"@de ;
    skos:definition "Start with a meaningful invocation, switch into chaos language and let strange words form themselves, drift into chant and dance to raise power, then return to meaningful prose for the next unit, and so on; the same applies to hypnosis, trance induction, storytelling and poetry."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
