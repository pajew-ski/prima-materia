pmc:ChaosMagicVmCSalamandersNaming a pm:Naming ;
    rdfs:label "Salamanders (fire spirits)"@en, "Salamander (Feuergeister)"@de ;
    skos:definition "Fire spirits dwelling in quakes, lightning, volcanoes, sparks and flames; wild and unpredictable, humanoid but changing shape too fast to be seen."@en ;
    pm:nameForm "salamander" ;
