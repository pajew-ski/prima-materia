pmc:ChaosMagicVmAHalfSleepLightHypnosisYieldOpennessYield a pm:Yielding ;
    rdfs:label "Half-sleep and light hypnosis yield openness"@en, "Halbschlaf ergibt Offenheit"@de ;
    skos:definition "The alpha states of hypnagogic half-sleep or light hypnosis provide the open state suited to transmission."@en ;
    pm:byPractice pmp:ChaosMagicVmATransmissionHalfSleepLightHypnosis ;
