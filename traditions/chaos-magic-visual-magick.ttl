pmc:ChaosMagicVmBDoNotAnalyseNewStateCautela a pm:Cautioning ;
    rdfs:label "Do not analyse the new state"@en, "Den neuen Zustand nicht analysieren"@de ;
    skos:definition "Avoid analysing the shift, since analysis is a form of dissociation; enjoy it a while before deciding whether another leap is needed."@en ;
    pm:cautionsAbout pmp:ChaosMagicVmBMutationalLeapFromPointToPoint ;
