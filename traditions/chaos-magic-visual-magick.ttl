    rdfs:label "Effects beyond everyday speech in invocation"@en, "Wirkungen über die Alltagsrede hinaus bei der Anrufung"@de ;
    skos:definition "The dramatic voice produces many effects missing from small-talk delivery."@en ;
    pm:attestedBy pm:textualAttestation ;
