pmc:ChaosMagicVmCGnomesDwarvesNaming a pm:Naming ;
    rdfs:label "Gnomes / dwarves (earth spirits)"@en, "Gnome / Zwerge (Erdgeister)"@de ;
    skos:definition "Earth spirits (dwarves, gnomes, earth people, sometimes giants), said to be the sentience of heavy, formed, fertile matter; some held quartz crystals to be dwarves (quartz from querch/zwerg); pictured as tiny underground workers making crystals and guiding seeds."@en ;
    pm:nameForm "gnome / dwarf / Zwerg" ;
