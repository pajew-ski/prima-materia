pmc:ChaosMagicVmAShameLinkedSigilFailure a pm:Conceptualizing ;
    rdfs:label "Shame linked to the sigil"@en, "Scham an der Sigille"@de ;
    skos:definition "If conditioning makes sex feel shameful but nice, that association attaches to the sigil and it will not get far."@en ;
