    pm:byPractice pmp:ChaosMagicVmBLughnasadHoopMandala ;
    pm:yieldsCapacity pmc:ChaosMagicVmBCarryingPromiseOfFreshLifeThrough ;
    pm:attestedBy pm:firstPersonReport ;
