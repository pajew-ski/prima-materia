    rdfs:label "Ground sigil dance yields earthing"@en, "Bodentanz ergibt Erdung"@de ;
    skos:definition "Dancing away a ground-drawn sigil eases its earthing."@en ;
    pm:byPractice pmp:ChaosMagicVmAGroundSigilDancedAwayNema ;
