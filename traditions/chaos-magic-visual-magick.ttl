pmp:ChaosMagicVmCReadingAggressionSignal a pm:Practicing ;
    rdfs:label "Reading aggression as a signal"@en, "Aggression als Signal lesen"@de ;
    skos:definition "When feeling aggressive, ask what message the feeling carries; treat it as a measure of how much more you can take and as possibly protective; accept the signal (e.g. stop work for the day) rather than striking out or pretending it is absent."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:VisualMagick ;
