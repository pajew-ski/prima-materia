    rdfs:label "Access to a new state of mind"@en, "Zugang zu einem neuen Bewusstseinszustand"@de ;
    skos:definition "Becoming the improved image gives ready access to the changed state of mind, a mutational leap that may be repeated if needed."@en ;
    pm:attestedBy pm:textualAttestation ;
