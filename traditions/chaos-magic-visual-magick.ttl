pmc:ChaosMagicVmBPinkSoberingCell a pm:Conceptualizing ;
    rdfs:label "Pink sobering cell"@en, "Rosa Ausnüchterungszelle"@de ;
    skos:definition "A report of an awful pink cell trialled in American jails, said to sober up or stun violent drunks in a few minutes."@en ;
    skos:note "Strength in the source: was said to."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
