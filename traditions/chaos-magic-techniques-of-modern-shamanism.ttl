pmc:ChaosMagicTmsTwiOdinnNaming a pm:Naming ;
    rdfs:label "Odinn"@en, "Odin"@de ;
    skos:definition "Odinn is named as a deity linked with the crossroads as a traditional power spot (Norse)."@en ;
    pm:nameForm "Odinn" ;
    pm:nameRole "Norse deity associated with crossroads" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
