pmc:ChaosMagicTmsTwiPathworkingsCanTriggerPowerfulTransformationsCautela a pm:Cautioning ;
    rdfs:label "Pathworkings can trigger powerful transformations"@en, "Pfadarbeiten können starke Wandlungen auslösen"@de ;
    skos:definition "Innerworld journeys may set off strong transformative experiences and so call for care."@en ;
    pm:cautionsAbout pmp:ChaosMagicTmsTwiInnerworldJourneyingPathworking ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
