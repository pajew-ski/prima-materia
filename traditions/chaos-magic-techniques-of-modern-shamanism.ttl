pmc:ChaosMagicTmsTbfIndividualEffectiveness a pm:Conceptualizing ;
    rdfs:label "Sense of individual effectiveness"@en, "Gefühl individueller Wirksamkeit"@de ;
    skos:definition "A feeling of empowerment, of being individually able to contribute to large issues, gained through mass workings."@en ;
    pm:attestedBy pm:textualAttestation ;
