pmp:ChaosMagicTmsTbfHealTheEarthLeaflet a pm:Practicing ;
    rdfs:label "HtE step 4: leaflet with linking image"@en, "HtE Schritt 4: Flugblatt mit verbindendem Bild"@de ;
    skos:definition "Design a concise leaflet carrying a central image through which participants link their efforts, a description of its qualities and a fitting quotation."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TouchedByFire ;
    dcterms:source "Hine, Touched by Fire: Techniques of Modern Shamanism Volume 3 (Pagan News Publication, 1989; Acrobat conversion of March 1998), Staking out the Territory, Healer, Heal the Earth, p. 23; read in the full-text layer of the archive.org item techniques-of-modern-shamanism-vol-1-2-and-3-by-phil-hine-collection, file Hine, Phil - Techniques of Modern Shamanism vol 3_djvu.txt" .

pmp:ChaosMagicTmsTbfHealTheEarthDistribution a pm:Practicing ;
    rdfs:label "HtE step 5: distribution"@en, "HtE Schritt 5: Verteilung"@de ;
    skos:definition "Use network contacts to spread leaflets as widely as possible: abroad via friends, as posters in shops, at Glastonbury festival and at gigs."@en ;
    skos:note "Text layer gives Leeds group over 7000 but total over 2000, an evident misreading (likely 20000)."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TouchedByFire ;
