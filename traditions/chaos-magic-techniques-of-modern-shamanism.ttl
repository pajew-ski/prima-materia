    rdfs:label "Raising collective awareness"@en, "Kollektives Bewusstsein wecken"@de ;
    skos:definition "Broadly heightened awareness, spreading like a ripple through humanity's planetary mind, here about the ecological crisis."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TouchedByFire ;
