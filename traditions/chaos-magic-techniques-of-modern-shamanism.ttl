pmc:ChaosMagicTmsTwiGaneshaNaming a pm:Naming ;
    rdfs:label "Ganesha"@en, "Ganesha"@de ;
    skos:definition "Ganesha is named as a deity linked with the crossroads as a traditional power spot (Hindu)."@en ;
    skos:note "Differs from pmc:ChaosMagicCondBGaneshaNaming (Condensed Chaos, 1995): the 1995 node has Ganesha bring wealth without attachment; here Ganesha is one of the deities tied to the crossroads as a traditional power spot."@en ;
    pm:nameForm "Ganesha" ;
    pm:nameRole "Hindu deity associated with crossroads" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TwoWorldsAndInbetween ;
