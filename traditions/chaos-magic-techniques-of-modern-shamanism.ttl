pmc:ChaosMagicTmsTwiCenteringBeforeAfterPathworkingPrerequisite a pm:Presupposing ;
    rdfs:label "Centering before and after pathworking"@en, "Zentrierung vor und nach der Pfadarbeit"@de ;
    skos:definition "A Centering exercise is useful as prelude and follow-on to pathworking."@en ;
    pm:priorStep pmp:ChaosMagicTmsTwiCenteringExerciseGeneralForm ;
    pm:dependentStep pmp:ChaosMagicTmsTwiInnerworldJourneyingPathworking ;
