pmp:ChaosMagicTmsWbwColourMeditation a pm:Practicing ;
    rdfs:label "Colour Meditation"@en, "Farbmeditation"@de ;
    skos:definition "Picture sounds, odours, flavours and even tactile sensations as colours, and let these colours fill the field of the inner eye."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:WalkingBetweenTheWorlds ;
    dcterms:source "Hine, Walking Between the Worlds: Techniques of Modern Shamanism Volume One (Pagan News Publications, 1986; on-line version of December 1998), Sight Exercises, Colour Meditation, p. 13; read in the full-text layer of the archive.org item techniques-of-modern-shamanism-vol-1-2-and-3-by-phil-hine-collection, file Hine, Phil - Techniques of Modern Shamanism vol 1_djvu.txt" .

pmc:ChaosMagicTmsWbwColourMeditationYieldsVisualisation a pm:Yielding ;
    rdfs:label "Colour Meditation stimulates visualisation"@en, "Farbmeditation regt die Visualisierung an"@de ;
    skos:definition "Turning sounds, smells, tastes and touch into colours on the inner eye is said to train the power of visualising."@en ;
    skos:note "The capacity is the one already entered from Condensed Chaos; no separate capacity node is written here."@en ;
    pm:byPractice pmp:ChaosMagicTmsWbwColourMeditation ;
    pm:yieldsCapacity pmc:ChaosMagicCondBVisualisationProficiency ;
