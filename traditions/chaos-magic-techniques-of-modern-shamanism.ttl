    rdfs:label "Colour Census yields attention to visual detail"@en, "Farbzählung schult den Blick fürs Detail"@de ;
    skos:definition "The colour census is counted with the sight exercises that train notice of detail."@en ;
    pm:byPractice pmp:ChaosMagicTmsWbwColourCensus ;
