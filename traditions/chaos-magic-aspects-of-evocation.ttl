    skos:definition "The retirement is said to bring forth and bind the demons of the practitioner's own psyche."@en ;
    pm:byPractice pmp:ChaosMagicAoeBabblogueRetirement ;
    pm:yieldsCapacity pmc:ChaosMagicAoeBindingInnerDemons ;
    pm:attestedBy pm:textualAttestation ;
