@prefix pm:      <https://pajew.ski/prima-materia/ontology#> .
@prefix pmt:     <https://pajew.ski/prima-materia/traditions/> .
@prefix pmw:     <https://pajew.ski/prima-materia/works/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

pmt:ZzProbe a pm:Tradition ;
    rdfs:label "Probe"@en, "Probe"@de ;
    skos:definition "A probe."@en ;
    skos:note "Route of contact: documented and dense — the corpus is cited by name in the Pistis Sophia, twice and with Enoch as its scribe, and stands in the same Coptic-Egyptian transmission as the ophite and hermetic material this graph already holds. Edition: Schmidt 1892, read page by page in the Munich digitisation; the manuscript pagination Schmidt prints in the margin is given with every source so that the place is findable in MacDermot's English and in Crégheur's French as well."@en ;
    pm:principalCorpus "Carl Schmidt, Gnostische Schriften in koptischer Sprache aus dem Codex Brucianus, Texte und Untersuchungen VIII 1-2, Leipzig 1892" ;
    pm:corpusWork pmw:ZzProbeWork ;
    pm:coverageState pm:placesEntered ;
    pm:contactRoute pm:contactRouteDocumented ;
    pm:fromWork pmw:ZzProbeWork ;
    dcterms:source "The First Book of Jeu, chapters 1-10 (trans. V. MacDermot), in the excerpt published by the Gnostic Society Library" .
