pmc:TranserfingSecurityAboutTheFuture a pm:Conceptualizing ;
    rdfs:label "Security about the future, immune to balancing forces"@en, "Zukunftssicherheit, unberührt von Ausgleichskräften"@de ;
    skos:definition "A person who feels secure about the future is said to be unaffected by the action of balancing forces."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    skos:note "Bears on the system term pmc:TranserfingUravnoveshivayushchieSily."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
