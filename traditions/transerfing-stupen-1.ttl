@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

#
# prima-materia — Transerfing: Vadim Zeland, Transerfing real'nosti, Stupen' I:
# Prostranstvo variantov (2004)
#
# The harvest of the first Stupen', kept apart from traditions/transerfing.ttl,
# which declares the tradition and its works. The whole Stupen' was read,
# foreword and chapters I to VI, in the English translation of the combined
# edition (Ves, 2012); the nodes follow the chapters. The text layer has no
# page numbers; every source names chapter and section heading.
#
# Two independent passes over three parts with reconciliation, then one
# integrator per part reading the whole part (prima-materia#924). Parts:
# foreword and chapters I-II; chapters III-IV; chapters V-VI. Shared system
# terms are typed once, by the part that introduces them, and linked from the
# others.
#

#
# prima-materia — Transerfing: Vadim Zeland, Transerfing real'nosti, Stupen' I
# (2004), part 1: foreword, chapter I The Alternatives Model, chapter II
# Pendulums.
#
# The work and the tradition are declared in traditions/transerfing.ttl. This
# part defines the shared system terms pmc:TranserfingProstranstvoVariantov,
# pmc:TranserfingLiniyaZhizni and pmc:TranserfingMayatnik; later parts link to
# them. Two independent extraction passes ran over the text (A 139 records,
# B 136; 14 records of B without counterpart in A: 0 added, 12 covered, 2 not
# owed); a reader of the whole part added 2 records both passes missed.
# The author's own dream and experience are first-person reports; what he tells
# of others is third-party ascription. His polemics against other views of fate
# are entered as concepts, since only his side is read.
#

#
# foreword
#

pmc:TranserfingTestInsteadOfBelief a pm:Conceptualizing ;
    rdfs:label "Self-testing instead of belief"@en, "Selbstprüfung statt Glauben"@de ;
    skos:definition "The methods are presented as requiring no belief: the reader is invited to verify everything personally, after which the prior worldview is said to collapse."@en ;
    skos:note "Statement on how the method is to be tested."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), foreword; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingControlOfDestiny a pm:Conceptualizing ;
    rdfs:label "Control over one's own destiny"@en, "Lenkung des eigenen Schicksals"@de ;
    skos:definition "Transurfing is claimed to give the practitioner the power to shape parts of life in ways ordinarily thought impossible and to steer destiny as one wishes."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), foreword; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAgainstSelfImprovement a pm:Conceptualizing ;
    rdfs:label "Against self-help that demands self-change"@en, "Gegen Selbsthilfeliteratur, die Selbstveränderung fordert"@de ;
    skos:definition "The author rejects success literature that requires exercises, soul searching, meditation and the premise that one is imperfect and must change; the solution is said to lie elsewhere."@en ;
    skos:note "Polemic of the author against a view he describes himself; only his side is read, so it is entered as a concept and not as pm:Disputing."@en ;
    skos:note "Opponent is a genre (self-help books), not a named author."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), foreword; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDistrustCallsOfImperfection a pm:Cautioning ;
    rdfs:label "Beware those who call you imperfect"@en, "Vorsicht vor denen, die dich unvollkommen nennen"@de ;
    skos:definition "The reader is warned to distrust anyone claiming one is less than perfect, since no one else can know how one is meant to be."@en ;
    pm:cautionsAbout pmc:TranserfingAgainstSelfImprovement ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), foreword; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingThoughtMaterialisesSector a pm:Conceptualizing ;
    rdfs:label "Thought energy materialises a sector of alternatives"@en, "Gedankenenergie verwirklicht einen Sektor des Variantenraums"@de ;
    skos:definition "Under certain conditions human thought energy is said to materialise a chosen sector within the alternatives space, the space holding every possible event."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), foreword; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingMirrorOfAlternatives a pm:Conceptualizing ;
    rdfs:label "Mirror of alternatives"@en, "Spiegel der Varianten"@de ;
    skos:definition "Physical reality is likened to a reflection of a potential alternative; the mind vainly tries to alter the reflection, whereas one should change the image being reflected. One can shape reality if certain rules are followed."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), foreword; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGettingWithoutStruggle a pm:Conceptualizing ;
    rdfs:label "Getting what one wants without struggle"@en, "Das Gewünschte erhalten, ohne darum zu kämpfen"@de ;
    skos:definition "The author claims the method lets one obtain what one desires from life instead of fighting for it, by returning to oneself rather than altering oneself."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    skos:note "Framed as a different way of thinking and acting, not self-improvement."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), foreword; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingCorrectingPastMistakes a pm:Conceptualizing ;
    rdfs:label "Correcting past mistakes"@en, "Fehler der Vergangenheit berichtigen"@de ;
    skos:definition "Mistakes are claimed to be correctable, in a way compared to going back, or stepping forward into the past; explained later in the book."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), foreword; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. I The Alternatives Model, section 'The Rustle of the Morning Stars'
#

pmc:TranserfingOrderingASunnyDay a pm:Conceptualizing ;
    rdfs:label "Ordering a sunny day"@en, "Einen sonnigen Tag bestellen"@de ;
    skos:definition "The author reports having ordered sunny weather before a walk, and a life since then filled with joyful meaning."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    skos:note "Anecdotal frame; no procedure given here."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Rustle of the Morning Stars'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGuardianOfTheReserve a pm:Naming ;
    rdfs:label "Guardian of the Reserve"@en, "Hüter des Naturreservats"@de ;
    skos:definition "A stern grey-bearded old man met in the author's dream of a nature reserve; he claims a mission, says he was sent by unnamed others, and poses the riddle of how to acquire the freedom of choice."@en ;
    skos:note "The author himself questions whether the figure is only part of his own dream."@en ;
    pm:nameForm "the Guardian (of the Reserve)" ;
    pm:nameRole "dream figure and messenger who transmits the knowledge of Transurfing" ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Rustle of the Morning Stars'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFreedomOfChoice a pm:Conceptualizing ;
    rdfs:label "Freedom of choice as the only true freedom"@en, "Wahlfreiheit als einzige echte Freiheit"@de ;
    skos:definition "Everyone is said to be free to choose any destiny; this freedom of choice is the only real freedom, but people possess it without using it and do not grasp what choosing means."@en ;
    skos:note "Put in the mouth of the Guardian; the riddle asks how this freedom is acquired."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Rustle of the Morning Stars'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingApplesFallToTheSky a pm:Conceptualizing ;
    rdfs:label "Apples falling to the sky"@en, "Äpfel, die zum Himmel fallen"@de ;
    skos:definition "The Guardian announces that once the dreamer solves the riddle of how freedom of choice is won, his apples will fall upward; the image stands as the promised mark of the answer and is not explained in this part."@en ;
    skos:note "Sign of success announced in advance: announced by the Guardian for the solving of his riddle, the acquiring of freedom of choice (pmc:TranserfingFreedomOfChoice)."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Rustle of the Morning Stars'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingBattlingWorldAndSelf a pm:Conceptualizing ;
    rdfs:label "Battling the world, then oneself, ends in exhaustion"@en, "Kampf mit der Welt, dann mit sich selbst, endet in Erschöpfung"@de ;
    skos:definition "The author reports that, counselled to fight for what he wanted, he struggled with the world without result and was worn out; told then that he himself was at fault and must change first, he struggled with himself, which proved harder still."@en ;
    skos:note "Condition of failure: the struggle the author was advised to wage, against the world and then against himself, brought him nothing but exhaustion; it is the first-person ground of the polemic in pmc:TranserfingAgainstFightingForLuck."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Rustle of the Morning Stars'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGuardianReceiving a pm:Receiving ;
    rdfs:label "Transurfing received from the Guardian in a dream"@en, "Transurfing vom Hüter im Traum empfangen"@de ;
    skos:definition "The author claims the Guardian imparted information he could not consciously express, of which only the word Transurfing came through; the answer to the riddle then arrived of its own accord, day by day, and he insists he could not have invented it; he says Transurfing was given to him to discover."@en ;
    pm:receivedBy "Vadim Zeland, the author, by his own account in the opening of chapter I" ;
    pm:claimedSpeaker "The Guardian of the Reserve, a stern grey-bearded old man met in a dream, who says unnamed others (they) sent him on a mission; afterwards knowledge said to come of its own accord, as if from nowhere" ;
    pm:receptionCircumstance "A dream of a nature reserve in which the author becomes aware that he is dreaming; on waking he cannot recall its end and keeps only the one word Transurfing and a sense of having been given information; soon after, clear recollections of what choosing means arrive day by day, which he says he could not have invented. No record other than the printed account is mentioned." ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Rustle of the Morning Stars'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingChoosingDestiny a pm:Conceptualizing ;
    rdfs:label "Choosing one's destiny like goods on a shelf"@en, "Das Schicksal wählen wie im Laden"@de ;
    skos:definition "Transurfing is said to free one to select one's destiny literally, as one picks an item in a supermarket, without having to furnish the world oneself or fight for a place in it."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Rustle of the Morning Stars'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. I The Alternatives Model, section 'The Guardian's Riddle'
#

pmc:TranserfingAgainstKarmaTeaching a pm:Conceptualizing ;
    rdfs:label "Against karma and retribution teachings"@en, "Gegen Lehren von Karma und Vergeltung"@de ;
    skos:definition "The author ridicules teachings that explain inequality through karma and punishment for sins of former lives, asking what purpose punishment for unremembered deeds could serve."@en ;
    skos:note "Polemic of the author against a view he describes himself; only his side is read, so it is entered as a concept and not as pm:Disputing."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAgainstLaterCompensation a pm:Conceptualizing ;
    rdfs:label "Against posthumous compensation"@en, "Gegen Ausgleich im Jenseits"@de ;
    skos:definition "The idea that those who suffer will later be repaid in heaven or a future life is called a false hope that can never satisfy; only the present life is known to us."@en ;
    skos:note "Polemic of the author against a view he describes himself; only his side is read, so it is entered as a concept and not as pm:Disputing."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAgainstFateAsLot a pm:Conceptualizing ;
    rdfs:label "Against fate as fixed lot and acceptance"@en, "Gegen Schicksal als festes Los und Ergebung"@de ;
    skos:definition "The author rejects the view of fate as a predetermined lot to be accepted, and the counsel to simply be happy and content, as forcing happiness is held to be as futile as forcing love."@en ;
    skos:note "Polemic of the author against a view he describes himself; only his side is read, so it is entered as a concept and not as pm:Disputing."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAgainstForcedForgiveness a pm:Conceptualizing ;
    rdfs:label "Against preachers of universal love and forgiveness"@en, "Gegen Prediger universeller Liebe und Vergebung"@de ;
    skos:definition "The worldview of self-styled enlightened people preaching universal love and forgiveness is described as a protective blanket of illusion yielding faked happiness."@en ;
    skos:note "Polemic of the author against a view he describes himself; only his side is read, so it is entered as a concept and not as pm:Disputing."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAgainstFightingForLuck a pm:Conceptualizing ;
    rdfs:label "Against the struggle view of luck"@en, "Gegen die Kampfauffassung vom Glück"@de ;
    skos:definition "The view that good luck must be fought for through hard labour is called illogical, since millions struggle and only a few succeed."@en ;
    skos:note "Polemic of the author against a view he describes himself; only his side is read, so it is entered as a concept and not as pm:Disputing."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingModelsRestOnPostulates a pm:Conceptualizing ;
    rdfs:label "Every model of fate rests on unproven postulates"@en, "Jedes Schicksalsmodell ruht auf unbewiesenen Postulaten"@de ;
    skos:definition "Materialism, idealism and all theories of fate are said to rest on unprovable principles; each grasps one facet of a multifaceted reality, as in the parable of the blind men and the elephant, so the criterion is relevance and applicability rather than sole truth."@en ;
    skos:note "Statement on the epistemic status of Transurfing itself."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingChosenWorldviewManifests a pm:Conceptualizing ;
    rdfs:label "What you choose to believe is manifested"@en, "Was man zu glauben wählt, verwirklicht sich"@de ;
    skos:definition "Whichever worldview one adopts is said to be borne out: believing fate fixed makes it so, believing one creates it brings responsibility and struggle; scientists likewise get the atom model they choose."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingVariability a pm:Conceptualizing ;
    rdfs:label "Variability as the founding postulate"@en, "Veränderlichkeit als Grundpostulat"@de ;
    skos:definition "Variability is called the most fundamental quality of the world, the reference point like zero on a grid; Transurfing takes as postulate that reality appears in infinitely many forms."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingProstranstvoVariantov a pm:Conceptualizing ;
    rdfs:label "Alternatives space"@en, "Variantenraum"@de ;
    skos:definition "An infinite material information field holding all possible scenarios of every event, past, present and future; it serves as the template or coordinate grid for matter moving in time and space. Each variant has a script (the path of matter) and scenery (outer form); distant sectors differ more."@en ;
    skos:note "Russian term: prostranstvo variantov (пространство вариантов)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLiniyaZhizni a pm:Conceptualizing ;
    rdfs:label "Life line"@en, "Lebenslinie"@de ;
    skos:definition "Because effects lie close to causes in the alternatives space, the sectors of a destiny form a life line with fairly uniform script and scenery; an event that changes them turns destiny onto another line, nearer or farther away, illustrated by seeing the same play with new scenery, a changed script or in another theatre."@en ;
    skos:note "Russian term: liniya zhizni (линия жизни)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDestinyAsChoice a pm:Conceptualizing ;
    rdfs:label "Managing destiny reduces to choosing"@en, "Schicksalslenkung ist Wahl"@de ;
    skos:definition "Since infinitely many alternatives already exist, one has the right to choose, nothing prevents choosing a comfortable destiny, and managing destiny comes down to making the choice, which Transurfing teaches."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingMovingPotential a pm:Conceptualizing ;
    rdfs:label "Manifestation as moving potential"@en, "Verwirklichung als wandernde Potenz"@de ;
    skos:definition "Material realisation is compared to a cooling ring moving along a water pipe or a wave crossing the sea: it is not matter that travels but the potential for forming physical reality; why the information structure turns into matter cannot be said."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingStaticTime a pm:Conceptualizing ;
    rdfs:label "Static time and the film reel"@en, "Statische Zeit und Filmrolle"@de ;
    skos:definition "Time is said to be as static as space; life lines are compared to a film reel in which past and future frames are all present at once, and the present is the material manifestation of the current section of one's life line."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingThoughtRadiation a pm:Conceptualizing ;
    rdfs:label "Thought radiation lights up a sector"@en, "Gedankenstrahlung erleuchtet einen Sektor"@de ;
    skos:definition "Like a torch lighting part of a dark forest, thought energy is said to light up the matching sector of the space of alternatives, by quality; energy passing through the body takes on the parameters (frequency) of the thoughts, radiates out like a radio signal and materialises the corresponding sector, so changes accumulate in one's life. The precise mechanism is declared unimportant."@en ;
    skos:note "Also cites worst expectations tending to come true as evidence; mentions quantum experiments."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingContemplationAloneInsufficient a pm:Cautioning ;
    rdfs:label "Contemplation alone does not create reality"@en, "Bloßes Betrachten erschafft keine Wirklichkeit"@de ;
    skos:definition "The reader is warned that thought radiation is only one route of manifestation; one generally cannot produce the desired reality merely by sitting and contemplating it, though thoughts weigh as much as deeds."@en ;
    pm:cautionsAbout pmc:TranserfingThoughtRadiation ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingMaterialisingObjects a pm:Conceptualizing ;
    rdfs:label "Materialising objects out of thin air"@en, "Gegenstände aus dem Nichts materialisieren"@de ;
    skos:definition "The author asserts that a few people can literally materialise objects from the air but usually keep quiet about it."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    skos:note "Mentioned as rare, not as a goal of the method."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLayerOfOnesWorld a pm:Conceptualizing ;
    rdfs:label "Collective co-creation and the layer of one's world"@en, "Gemeinsame Erschaffung und die eigene Weltschicht"@de ;
    skos:definition "All living beings, perhaps even inert objects, contribute thought energy to reality; each individual moves on an own life line, and two people in the same place (tourist and homeless man) live on different lines that intersect."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingOneSpirit a pm:Naming ;
    rdfs:label "God as the One Spirit"@en, "Gott als der Eine Geist"@de ;
    skos:definition "God is described as the One Spirit pervading all things; each being holds a fragment of God and has consciousness forming its own layer of the world, and this is said to be how God governs the world."@en ;
    pm:nameForm "God, the One Spirit" ;
    pm:nameRole "all-pervading spirit governing the world through the particle present in every being" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingWorldMirrorsAttitude a pm:Conceptualizing ;
    rdfs:label "The world answers one's attitude"@en, "Die Welt antwortet auf die Haltung"@de ;
    skos:definition "Hostility toward the world is returned in kind, constant dissatisfaction finds ever more reasons for dissatisfaction, and a negative outlook shows the worst side of the world; a positive outlook is named the most natural means of improving life."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingPositiveAttitude a pm:Practicing ;
    rdfs:label "Holding a positive attitude to life"@en, "Positive Grundhaltung zum Leben"@de ;
    skos:definition "Keep one's attitude toward the world predominantly positive instead of hostile or dissatisfied, so the radiated thought energy tunes to better sectors."@en ;
    skos:note "Stated briefly here; developed later in the book."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingPositiveAttitudeYieldsBetterLifeCircumstances a pm:Yielding ;
    rdfs:label "Positive attitude yields better life circumstances"@en, "Positive Haltung bewirkt bessere Lebensumstände"@de ;
    skos:definition "A positive attitude is said to bring a change of life for the better."@en ;
    pm:byPractice pmp:TranserfingPositiveAttitude ;
    pm:yieldsCapacity pmc:TranserfingBetterLifeCircumstances ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingBetterLifeCircumstances a pm:Conceptualizing ;
    rdfs:label "Improving one's life circumstances"@en, "Lebensumstände verbessern"@de ;
    skos:definition "Changing life for the better by shifting the quality of one's thoughts, so material realisation moves to a more favourable life line."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLineShift a pm:Conceptualizing ;
    rdfs:label "Shift of life line by changed thought parameters"@en, "Linienwechsel durch veränderte Gedankenparameter"@de ;
    skos:definition "As long as thinking stays uniform one stays on one's present line; once one's relation to reality shifts, the thought parameters alter and the layer of one's world shifts to another line with a different script."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingSlideToWorseLines a pm:Conceptualizing ;
    rdfs:label "Negative reaction to obstacles slides to worse lines"@en, "Negative Reaktion auf Hindernisse führt auf schlechtere Linien"@de ;
    skos:definition "Reacting to obstacles with dissatisfaction or despair refocuses thought energy to lines with still more obstacles, producing a downward slide."@en ;
    skos:note "Condition of failure: Reacting to obstacles with dissatisfaction or despair refocuses thought energy to lines with still more obstacles, producing a downward slide."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFightingObstacles a pm:Conceptualizing ;
    rdfs:label "Fighting obstacles multiplies obstacles"@en, "Kampf gegen Hindernisse vermehrt sie"@de ;
    skos:definition "One experiences one's dominant thoughts: battling obstacles brings an abundance of them, preoccupation with problems keeps problems present, and trying to fix disliked parts of the script keeps attention on what is disliked, so one receives what one does not want."@en ;
    skos:note "Condition of failure: One experiences one's dominant thoughts: battling obstacles brings an abundance of them, preoccupation with problems keeps problems present, and trying to fix disliked parts of the script keeps attention on what is disliked, so one receives what one does not want."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingScriptUnchangeable a pm:Conceptualizing ;
    rdfs:label "The script of the current line cannot be changed"@en, "Das Drehbuch der aktuellen Linie ist unveränderlich"@de ;
    skos:definition "Material action on the current life line cannot alter its script in the alternatives space, just as a visitor cannot rearrange a gallery he does not own; one can only walk into another room, i.e. choose another script."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingWishIsNotChoice a pm:Conceptualizing ;
    rdfs:label "Wishes and dreams are not choices"@en, "Wünsche und Träume sind keine Wahl"@de ;
    skos:definition "Not all thoughts are realised: what matters is the quality of the thought, not its content; a dream or wish does not count as a choice, so dreams do not come true. Choice is granted unconditionally, wishing is not. Certain conditions must be met, to be given later."@en ;
    skos:note "Condition of failure: Not all thoughts are realised: what matters is the quality of the thought, not its content; a dream or wish does not count as a choice, so dreams do not come true. Choice is granted unconditionally, wishing is not. Certain conditions must be met, to be given later."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAgainstSingleFate a pm:Conceptualizing ;
    rdfs:label "Against the single preordained fate of religion"@en, "Gegen das eine vorherbestimmte Schicksal der Religion"@de ;
    skos:definition "The Islamic teaching that destiny is inscribed in the Book, and similar religious statements, are granted partially (the script of an alternative cannot be changed) but faulted for teaching only one version of fate instead of endless alternatives."@en ;
    skos:note "Polemic of the author against a view he describes himself; only his side is read, so it is entered as a concept and not as pm:Disputing."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingModelJudgedByResults a pm:Conceptualizing ;
    rdfs:label "Model judged by results; author convinced by practice"@en, "Modell nach Ergebnis beurteilt; Autor durch Praxis überzeugt"@de ;
    skos:definition "The author says he did not believe the alternatives model until convinced it works without fail; a model matters for what it helps achieve, not for absolute truth, and its practical benefit counts even without understanding, as with relativity."@en ;
    skos:note "Statement on how tested and fixed the method is; applying its principles is said to give stunning results."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDoNotAskWhyAndHow a pm:Cautioning ;
    rdfs:label "Do not torment yourself with why and how"@en, "Sich nicht mit Warum und Wie quälen"@de ;
    skos:definition "The reader is advised to decide from the start not to agonise over exactly why and how the method works, since we are not meant to know all; simply enjoy the results."@en ;
    pm:cautionsAbout pmc:TranserfingModelJudgedByResults ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingChoosingHappiness a pm:Conceptualizing ;
    rdfs:label "Choosing happiness instead of fighting for it"@en, "Glück wählen statt erkämpfen"@de ;
    skos:definition "The model of alternatives is said to imply that one creates one's destiny and can choose happiness without fighting; the reader is asked to weigh what battling the world has achieved, and life is said merely to realise one's personal choice."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. I The Alternatives Model, section 'The Guardian's Riddle'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. II Pendulums, section 'Destructive pendulums'
#

pmc:TranserfingMayatnik a pm:Conceptualizing ;
    rdfs:label "Pendulum (energy-information structure)"@en, "Pendel (energetisch-informationelle Struktur)"@de ;
    skos:definition "When a group thinks alike, their identical thought energy merges into one current and forms an independent energy-information structure that lives its own life and subjects its creators to its laws; the more adherents feed it, the harder it swings at its resonance frequency, and it stops and ceases to exist when it loses all adherents."@en ;
    skos:note "Russian term: mayatnik (маятник)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Destructive pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingKindsOfPendulum a pm:Systematizing ;
    rdfs:label "Elementary, group and defunct pendulums"@en, "Elementare, Gruppen- und erloschene Pendel"@de ;
    skos:definition "Every organism is an elementary pendulum; elementary pendulums swinging in unison form a group pendulum above them; natural pendulums include colonies, herds, schools of fish, forests; pendulums that lost all adherents (pagan religions, stone tools, vinyl records) are defunct."@en ;
    pm:compiledBy "Vadim Zeland" ;
    dcterms:date "2004"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Destructive pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingPendulumDestructiveByNature a pm:Conceptualizing ;
    rdfs:label "Every pendulum is destructive"@en, "Jedes Pendel ist destruktiv"@de ;
    skos:definition "A pendulum by nature consumes adherents' energy, rules them and is indifferent to each one's fate; the adherent gives energy and receives an environment; one who rebels falls out of resonance and is expelled or destroyed."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Destructive pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRuinUnderPendulum a pm:Cautioning ;
    rdfs:label "Ruin under a destructive pendulum"@en, "Ruin unter einem destruktiven Pendel"@de ;
    skos:definition "Once under a destructive pendulum one may ruin one's whole life, and breaking free is usually not possible without losses; one far from a favourable life line lives as in hard labour, loses freedom and becomes a cog."@en ;
    pm:cautionsAbout pmc:TranserfingMayatnik ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Destructive pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingPendulumFavourites a pm:Conceptualizing ;
    rdfs:label "Favourites of destructive pendulums"@en, "Günstlinge destruktiver Pendel"@de ;
    skos:definition "Under a pendulum's protection individuals may attain great success (the text names Napoleon, Hitler and Stalin as such favourites), yet they are exploited, not cared for; the pendulum promotes adherents whose qualities fit its structure into leadership and eliminates them when they cease to fit."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Destructive pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLuredFromHappiness a pm:Cautioning ;
    rdfs:label "Pendulums lure away from one's own happiness"@en, "Pendel locken vom eigenen Glück weg"@de ;
    skos:definition "The greatest danger is that pendulums lead their victims away from the lines on which happiness would await them, using advertising tricks and well-meaning masks: the army, an unsuitable profession, prestigious but alien work, a marriage to a stranger."@en ;
    pm:cautionsAbout pmc:TranserfingMayatnik ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Destructive pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingMarksOfDestructivePendulum a pm:Systematizing ;
    rdfs:label "Marks of a destructive pendulum"@en, "Merkmale eines destruktiven Pendels"@de ;
    skos:definition "Five marks: it feeds on adherents' energy to swing harder; it seeks as many followers as possible; it opposes its group to all others (we good, they bad); it acts aggressively toward refusers, trying to win, neutralise or remove them; it conceals itself behind masks and noble ideals, playing on feelings."@en ;
    pm:compiledBy "Vadim Zeland" ;
    dcterms:date "2004"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Destructive pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingCrowdEnergyAbsorbed a pm:Conceptualizing ;
    rdfs:label "Pendulum absorbs crowd energy"@en, "Pendel nimmt die Energie der Menge auf"@de ;
    skos:definition "A crowd's anger at a football player who lost the match does not kill him because the negative energy is absorbed by the pendulum; otherwise any target of mass hatred would die."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Destructive pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingPendulumAsEntity a pm:Naming ;
    rdfs:label "Pendulum as independent entity"@en, "Pendel als eigenständige Wesenheit"@de ;
    skos:definition "Pendulums are treated as independent entities that set rules, attract and reject adherents, feed on energy, compete and manipulate; the author leaves open whether a pendulum is animate or only an energy form, holding that the method works either way. Equated with an egregore, which is said to cover only part of the interactions."@en ;
    skos:note "The author leaves open whether a pendulum is alive or only a form of energy; the naming records what the text calls it, not a decision on that question."@en ;
    pm:nameForm "pendulum (маятник); compared with egregore" ;
    pm:nameRole "collective energy-information structure living off its adherents' energy" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Destructive pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingStayingOutOfTheGame a pm:Conceptualizing ;
    rdfs:label "Staying out of a pendulum's game"@en, "Sich aus dem Spiel eines Pendels heraushalten"@de ;
    skos:definition "The ability to identify a pendulum and avoid being pulled into its game unless one gains from the interaction, called the most important thing."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Destructive pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingRecognisingDestructivePendulum a pm:Practicing ;
    rdfs:label "Recognising a destructive pendulum"@en, "Ein destruktives Pendel erkennen"@de ;
    skos:definition "Check whether the structure competes with similar ones for adherents; this always identifies a destructive pendulum, and the more aggressively it fights for devotees the more dangerous it is; then keep out of its game unless taking part benefits you."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Destructive pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRecognisingDestructivePendulumYieldsStayingOutOfTheGame a pm:Yielding ;
    rdfs:label "Recognition enables staying out of the game"@en, "Erkennen ermöglicht das Heraushalten"@de ;
    skos:definition "Identifying a destructive pendulum by its competition for adherents lets one keep out of its game."@en ;
    pm:byPractice pmp:TranserfingRecognisingDestructivePendulum ;
    pm:yieldsCapacity pmc:TranserfingStayingOutOfTheGame ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Destructive pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingMaskOfTheBenefactor a pm:Cautioning ;
    rdfs:label "Charity and the mask of the benefactor"@en, "Wohltätigkeit und die Maske des Wohltäters"@de ;
    skos:definition "Charitable organisations are also called destructive to the individual, since they feed on energy while indifferent to followers; one should honestly ask whether one gives sincerely or wears the mask of the benefactor to feel better or look good. If one is truly happy there, it may be one's vocation."@en ;
    pm:cautionsAbout pmc:TranserfingMayatnik ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Destructive pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingTrainedOutOfChoosing a pm:Conceptualizing ;
    rdfs:label "Pendulums trained people out of choosing"@en, "Pendel haben das Wählen aberzogen"@de ;
    skos:definition "Destructive pendulums are said to have trained people not to choose their destiny, since independent choosers are harder to recruit; hence the belief that fate is a fixed lot."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Destructive pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingMethodAsPendulum a pm:Cautioning ;
    rdfs:label "Transurfing itself could become a pendulum"@en, "Transurfing selbst könnte zum Pendel werden"@de ;
    skos:definition "The author warns that Transurfing would become a pendulum if someone made it a quasi-religion, a movement or a school, though at worst only minimally destructive because it serves individual well-being, not a shared goal. The reader is asked which pendulums might be constructive."@en ;
    skos:note "Self-warning against its own method."@en ;
    pm:cautionsAbout pmc:TranserfingMayatnik ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Destructive pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. II Pendulums, section 'The Battle of the Pendulums'
#

pmc:TranserfingBattleOfPendulums a pm:Conceptualizing ;
    rdfs:label "Battle of pendulums"@en, "Kampf der Pendel"@de ;
    skos:definition "A destructive pendulum seeks to destroy rivals to win adherents, setting followers against others; war is its extreme form (illustrated by a pendulum stirring up a wild beehive), followed by market competition, party rivalry, advertising and propaganda; established pendulums suppress the new (oil corporations said to buy up and shelve clean engine patents)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'The Battle of the Pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFightingOtherFollowers a pm:Cautioning ;
    rdfs:label "Fighting other pendulums' followers is futile"@en, "Kampf gegen Anhänger anderer Pendel ist sinnlos"@de ;
    skos:definition "Joining the fight against followers of other pendulums makes people chase spurious goals they take for their own and can destroy their lives and those of others."@en ;
    pm:cautionsAbout pmc:TranserfingBattleOfPendulums ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'The Battle of the Pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLockOn a pm:Conceptualizing ;
    rdfs:label "Lock-on and feedback loop"@en, "Einrasten und Rückkopplungsschleife"@de ;
    skos:definition "When a person tunes to a pendulum's frequency, his thought frequency is stabilised by the pendulum; a lock-on occurs: the adherent radiates at the resonance frequency and receives a little energy back (righteousness, satisfaction, importance), believing he chose when he was chosen; doubt about the idol makes his frequency drop out of the loop."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'The Battle of the Pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingCostOfLeaving a pm:Cautioning ;
    rdfs:label "Leaving a pendulum can cost freedom or life"@en, "Austritt aus einem Pendel kann Freiheit oder Leben kosten"@de ;
    skos:definition "How tightly a pendulum holds depends on its power: some let the doubter go, others make the heretic pay with freedom or life."@en ;
    pm:cautionsAbout pmc:TranserfingLockOn ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'The Battle of the Pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFrequencyDomination a pm:Conceptualizing ;
    rdfs:label "Domination of the thought frequency"@en, "Beherrschung der Gedankenfrequenz"@de ;
    skos:definition "A pendulum grips an adherent's thought frequency by dominating it, as loud nearby music drowns out a tune one hums. The author explicitly works with simplified models and metaphors, the exact energetic interaction being unimportant for Transurfing."@en ;
    skos:note "Includes a statement on the provisional status of the model."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'The Battle of the Pendulums'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. II Pendulums, section 'Puppet Strings'
#

pmc:TranserfingOpponentsFeedPendulum a pm:Conceptualizing ;
    rdfs:label "Pendulums feed on opponents as well"@en, "Pendel nähren sich auch von Gegnern"@de ;
    skos:definition "Energy is given whenever thought radiates at the pendulum's resonance frequency, consciously or not; critics who hate the government (old ladies on a bench) feed it as much as supporters, since it uses positive and negative energy alike."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Puppet Strings'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingThrownOffBalance a pm:Conceptualizing ;
    rdfs:label "Media and throwing off balance"@en, "Medien und das Aus-dem-Gleichgewicht-Bringen"@de ;
    skos:definition "The main aim of a pendulum is to occupy people's thoughts; mass media, themselves pendulums serving greater ones, favour bad news to attune thought; knocking a person off balance (e.g. resentment over price rises, shared with friends) makes him wobble at the pendulum's frequency and worsens the situation."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Puppet Strings'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingPuppetStrings a pm:Systematizing ;
    rdfs:label "Puppet strings of the pendulum"@en, "Fäden, an denen das Pendel zieht"@de ;
    skos:definition "Classification of the channels by which pendulums draw energy: fear (strongest and oldest), anxiety and worry (weaker), guilt with duty as a special form (the manipulator's favourite), personal complexes (inferiority, guilt, warrior, truth-lover) as individual keys, further feelings and needs (among them justice, pride, ambition, love, hatred, greed, curiosity and hunger), and habitual uniform reactions to negative stimuli."@en ;
    pm:compiledBy "Vadim Zeland" ;
    dcterms:date "2004"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Puppet Strings'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingHabitualReaction a pm:Conceptualizing ;
    rdfs:label "Habit as the illusion of comfort"@en, "Gewohnheit als Illusion von Behaglichkeit"@de ;
    skos:definition "Habits such as getting irritated over nothing trigger the clamping mechanism; people repeat known mistakes because old habits feel comfortable, familiar and tested, and a new habit needs time to become old."@en ;
    skos:note "Condition of failure: Habits such as getting irritated over nothing trigger the clamping mechanism; people repeat known mistakes because old habits feel comfortable, familiar and tested, and a new habit needs time to become old."@en ;
    skos:note "Entered as a condition of failure rather than a bare concept: knowing that negative reactions do harm does not stop habit from setting off the capture, so the habit is what makes the advice against responding fail."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Puppet Strings'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingOpenRevolt a pm:Cautioning ;
    rdfs:label "Open revolt against a pendulum fails"@en, "Offene Auflehnung gegen ein Pendel scheitert"@de ;
    skos:definition "An individual who openly opposes a controlling pendulum is always defeated, being isolated: he wastes energy, is at best expelled, at worst crushed, and may find himself outside the law, punished not for protest but for no longer yielding energy."@en ;
    pm:cautionsAbout pmc:TranserfingMayatnik ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Puppet Strings'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingConfessionAsSubmission a pm:Conceptualizing ;
    rdfs:label "Confession as resubmission"@en, "Geständnis als erneute Unterwerfung"@de ;
    skos:definition "Admitting guilt is said to signal willingness to submit; the pendulum seeks only restored control, not remorse, and turns kinder once allowed to manipulate. True morals can be told apart from system interests by keeping in mind what pendulums are and want."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Puppet Strings'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. II Pendulums, section 'You get what you do not want'
#

pmc:TranserfingCapturedEnergyShiftsLine a pm:Conceptualizing ;
    rdfs:label "Captured energy shifts one to the unwanted line"@en, "Eingefangene Energie verschiebt auf die unerwünschte Linie"@de ;
    skos:definition "Provocations (bad news, unfortunate events) either pass or, if they touch a chord, capture one's energy in the loop; part of the radiated negative energy goes not to the pendulum but to matching sectors, shifting one onto a life line on which the unwanted is present in excess, because the pendulum holds the thought energy at one frequency."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'You get what you do not want'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDisasterNews a pm:Cautioning ;
    rdfs:label "Absorbing disaster news invites the victim line"@en, "Katastrophennachrichten aufnehmen lädt die Opferlinie ein"@de ;
    skos:definition "Hearing of a disaster one is normally on a witness line; taking such news to heart and discussing it with friends may soon shift one to a line where one plays the victim."@en ;
    pm:cautionsAbout pmc:TranserfingCapturedEnergyShiftsLine ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'You get what you do not want'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAvoidanceAttracts a pm:Conceptualizing ;
    rdfs:label "Desire to avoid attracts the avoided"@en, "Vermeidenwollen zieht das Vermiedene an"@de ;
    skos:definition "The stronger the wish to avoid something, the likelier one meets it; actively fighting the unwanted ensures its presence. No action is needed: negative thoughts fed with emotion suffice (dislike of rain, hated neighbours, a detested job), while equally unwanted things not charged with emotion stay away."@en ;
    skos:note "Condition of failure: The stronger the wish to avoid something, the likelier one meets it; actively fighting the unwanted ensures its presence. No action is needed: negative thoughts fed with emotion suffice (dislike of rain, hated neighbours, a detested job), while equally unwanted things not charged with emotion stay away."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'You get what you do not want'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFreedomFromPendulum a pm:Conceptualizing ;
    rdfs:label "Freedom from a pendulum's influence"@en, "Freiheit vom Einfluss eines Pendels"@de ;
    skos:definition "Escaping the pendulum that has captured one's thought energy and afterwards not answering its provocations, reached in one of two ways: defeating it or bringing its swing to rest; named the only way to remove the unwanted from one's life."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'You get what you do not want'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRemovingTheUnwanted a pm:Conceptualizing ;
    rdfs:label "Removing unwanted things from one's life"@en, "Unerwünschtes aus dem Leben entfernen"@de ;
    skos:definition "Making an unwanted thing, person or event disappear from one's life."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'You get what you do not want'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFreedomBeforeRemoval a pm:Presupposing ;
    rdfs:label "Freedom from the pendulum before removing the unwanted"@en, "Pendelfreiheit vor Entfernung des Unerwünschten"@de ;
    skos:definition "Removing the unwanted from life is said to be possible only by first breaking free of the pendulum holding one's thought energy."@en ;
    pm:dependentStep pmc:TranserfingRemovingTheUnwanted ;
    pm:priorStep pmc:TranserfingFreedomFromPendulum ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Otherwise the pendulum keeps one tuned to it and the unwanted stays or increases." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'You get what you do not want'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. II Pendulums, section 'Defeating the Pendulum'
#

pmp:TranserfingNonResistance a pm:Practicing ;
    rdfs:label "Defeating a pendulum by non-resistance"@en, "Ein Pendel durch Nichtwiderstand besiegen"@de ;
    skos:definition "Do not enter conflict with the pendulum; do not tell it to go away; claim no right to judge or change; accept everything like paintings in an exhibition, granting its right to exist, and then leave it; do not fight, judge, get angry or lose self-control; take it calmly as a necessary evil."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNoConflictFirst a pm:Presupposing ;
    rdfs:label "Refusing conflict is the first condition of defeating"@en, "Konfliktverweigerung als erste Bedingung des Besiegens"@de ;
    skos:definition "Refusing any conflict with the pendulum is named the first and chief condition for defeating it."@en ;
    skos:note "The prior step is the refusal of conflict that pmp:TranserfingNonResistance prescribes; the dependent is defeating the pendulum, one of the two routes to pmc:TranserfingFreedomFromPendulum."@en ;
    pm:dependentStep pmc:TranserfingFreedomFromPendulum ;
    pm:priorStep pmp:TranserfingNonResistance ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Fighting only supplies the pendulum with energy, so it presses harder and clings more." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNonResistanceYieldsFreedomFromPendulum a pm:Yielding ;
    rdfs:label "Non-resistance yields freedom from the pendulum"@en, "Nichtwiderstand bewirkt Pendelfreiheit"@de ;
    skos:definition "Granting that the pendulum may exist gives the right to leave it and remain free of its influence."@en ;
    pm:byPractice pmp:TranserfingNonResistance ;
    pm:yieldsCapacity pmc:TranserfingFreedomFromPendulum ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDeclining a pm:Conceptualizing ;
    rdfs:label "Being able to decline"@en, "Ablehnen können"@de ;
    skos:definition "Declining what one does not want effectively, without the attachment and opposition that pull it closer."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDecliningBeforeChoosing a pm:Presupposing ;
    rdfs:label "Knowing how to decline before choosing"@en, "Ablehnen können vor dem Wählen"@de ;
    skos:definition "One must know how to decline before one can fully understand what choosing means."@en ;
    pm:dependentStep pmc:TranserfingChoosingDestiny ;
    pm:priorStep pmc:TranserfingDeclining ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingAcceptAndLetGo a pm:Practicing ;
    rdfs:label "Accepting and letting go (declining)"@en, "Annehmen und Ziehenlassen (Ablehnen)"@de ;
    skos:definition "To decline something, first accept its existence: not by letting it into one's personal space but by recognising its right to exist, considering it, and letting it pass with indifference, as if waving it goodbye."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAcceptAndLetGoYieldsDeclining a pm:Yielding ;
    rdfs:label "Accept-and-let-go yields the ability to decline"@en, "Annehmen und Ziehenlassen bewirkt Ablehnenkönnen"@de ;
    skos:definition "Accepting the existence of something and letting it pass is presented as the effective way to decline it."@en ;
    pm:byPractice pmp:TranserfingAcceptAndLetGo ;
    pm:yieldsCapacity pmc:TranserfingDeclining ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFixation a pm:Conceptualizing ;
    rdfs:label "Fixation through love or hate"@en, "Fixierung durch Liebe oder Hass"@de ;
    skos:definition "Whether one loves or hates, thoughts latched onto an object tune one to a frequency where a pendulum catches one and moves one to a line full of that object; the man who detests apples energetically gorges on them."@en ;
    skos:note "Condition of failure: Whether one loves or hates, thoughts latched onto an object tune one to a frequency where a pendulum catches one and moves one to a line full of that object; the man who detests apples energetically gorges on them."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingIgnoring a pm:Practicing ;
    rdfs:label "Ignoring rather than avoiding"@en, "Ignorieren statt Vermeiden"@de ;
    skos:definition "Stop thinking about the unwanted thing and pass it by with indifference; do not avoid it (avoiding means it is already in one's space and being pushed out) but do not react to it at all; like a radio, simply tune to another frequency."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingIgnoringYieldsRemovingTheUnwanted a pm:Yielding ;
    rdfs:label "Ignoring makes the unwanted disappear"@en, "Ignorieren lässt Unerwünschtes verschwinden"@de ;
    skos:definition "Ignoring an unwanted thing is said to make it disappear from one's life."@en ;
    pm:byPractice pmp:TranserfingIgnoring ;
    pm:yieldsCapacity pmc:TranserfingRemovingTheUnwanted ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingProtectiveArmour a pm:Cautioning ;
    rdfs:label "Armour and isolation do not protect"@en, "Panzer und Abschottung schützen nicht"@de ;
    skos:definition "Building iron walls against the world is an illusion: the protective field costs much energy, keeps one in constant tension and vibrates at the very frequency of the pendulum it is aimed at, which is what the pendulum wants."@en ;
    pm:cautionsAbout pmc:TranserfingProtectionFromPendulums ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingEmptiness a pm:Practicing ;
    rdfs:label "Emptiness toward the pendulum"@en, "Leere gegenüber dem Pendel"@de ;
    skos:definition "Be empty in relation to the pendulum so there is nothing for it to hook onto; ignore it, and its energy passes by and dissipates harmlessly while it moves on to people it can still engage."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingEmptinessYieldsProtectionFromPendulums a pm:Yielding ;
    rdfs:label "Emptiness yields protection"@en, "Leere bewirkt Schutz"@de ;
    skos:definition "Emptiness toward a pendulum is called true protection from it."@en ;
    pm:byPractice pmp:TranserfingEmptiness ;
    pm:yieldsCapacity pmc:TranserfingProtectionFromPendulums ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingProtectionFromPendulums a pm:Conceptualizing ;
    rdfs:label "Protection from pendulums"@en, "Schutz vor Pendeln"@de ;
    skos:definition "Being untouchable by a pendulum: it cannot push one's buttons or upset one, and leaves one alone."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingIgnoringAProvoker a pm:Practicing ;
    rdfs:label "Ignoring a provoking person"@en, "Eine provozierende Person ignorieren"@de ;
    skos:definition "When someone is getting to you, check whether they match the destructive-pendulum model; refuse to react to provocation; neither quarrel nor hate them silently; stop thinking of them and erase them from mind until one can sincerely say they are not worth it. Illustrated by the barking dog that moves on if ignored from the start."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingProvokerDisappears a pm:Conceptualizing ;
    rdfs:label "The ignored person disappears from one's life"@en, "Die ignorierte Person verschwindet aus dem Leben"@de ;
    skos:definition "Announced sign: when one can honestly tell oneself the person is not worth it, that person will vanish from one's life."@en ;
    skos:note "Sign of success announced in advance: announced for pmp:TranserfingIgnoringAProvoker."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingGentleDodge a pm:Practicing ;
    rdfs:label "The gentle dodge"@en, "Das sanfte Ausweichen"@de ;
    skos:definition "When a pendulum (e.g. a stressed boss) cannot be ignored: neither refuse nor defend; accept the first blow by listening carefully and agreeing to everything so its initial surge discharges; then discuss details; do not claim to know better or argue; ask its advice on how the job is best done or whether a colleague could do it better; swing along consciously as an observer, knowing one only pretends to play. Compared to stepping aside from a sledgehammer and to aikido."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingEnergyRedirected a pm:Conceptualizing ;
    rdfs:label "Energy turns to someone else"@en, "Die Energie wendet sich jemand anderem zu"@de ;
    skos:definition "Announced sign of the gentle dodge: the energy that was aimed at you turns toward a colleague or another solution, and the pendulum is defeated for you personally."@en ;
    skos:note "Sign of success announced in advance: announced for pmp:TranserfingGentleDodge."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGentleDodgeYieldsFreedomFromPendulum a pm:Yielding ;
    rdfs:label "Gentle dodge yields freedom from the pendulum"@en, "Sanftes Ausweichen bewirkt Pendelfreiheit"@de ;
    skos:definition "The gentle dodge is said to defeat the pendulum for the practitioner."@en ;
    pm:byPractice pmp:TranserfingGentleDodge ;
    pm:yieldsCapacity pmc:TranserfingFreedomFromPendulum ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Defeating the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. II Pendulums, section 'Stopping a Pendulum'
#

pmc:TranserfingTramBullies a pm:Conceptualizing ;
    rdfs:label "Bullies dispersed by an unexpected blow"@en, "Schläger durch unerwarteten Schlag zerstreut"@de ;
    skos:definition "The author reports witnessing a strong, gentle friend in a tram who, after failing to defeat a gang by silence, struck the boldest one, whereupon the group's energy dispersed and they left."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    skos:note "Anecdote; the friend first tried ignoring (defeating) without success because the group cornered him."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingStoppingThePendulum a pm:Conceptualizing ;
    rdfs:label "Stopping a pendulum's swing"@en, "Den Schwung eines Pendels anhalten"@de ;
    skos:definition "Bringing a pendulum to rest where ignoring or escaping it is impossible, so its energy disperses and the provocation ends."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGangLeadersEar a pm:Conceptualizing ;
    rdfs:label "Gang stopped by a madman's act"@en, "Bande durch scheinbar Wahnsinnigen gestoppt"@de ;
    skos:definition "Reported story of a man cornered by a gang who escaped a beating by staring insanely, asking the leader which bone to break first and seizing his ear, so the familiar script collapsed."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingBreakingTheScript a pm:Practicing ;
    rdfs:label "Breaking the expected script"@en, "Das erwartete Drehbuch durchbrechen"@de ;
    skos:definition "When a situation is going to unfold by a set script and there is no retreat, do something surprising that does not fit the script; what exactly does not matter. Diverging sharply from the pendulum's frequency creates dissonance that stops its swing."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingBreakingTheScriptYieldsStoppingThePendulum a pm:Yielding ;
    rdfs:label "Breaking the script stops the pendulum"@en, "Drehbuchbruch hält das Pendel an"@de ;
    skos:definition "Unexpected behaviour is said to halt the swing through dissonance."@en ;
    pm:byPractice pmp:TranserfingBreakingTheScript ;
    pm:yieldsCapacity pmc:TranserfingStoppingThePendulum ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNothingToLose a pm:Cautioning ;
    rdfs:label "Do not provoke a pendulum with nothing to lose"@en, "Kein Pendel reizen, das nichts zu verlieren hat"@de ;
    skos:definition "With a desperate robber, drug addict or mentally ill attacker one should hand over the wallet at once (some carry spare money for this) and avoid such people like a rabid dog; even a martial artist could die an absurd death."@en ;
    pm:cautionsAbout pmp:TranserfingBreakingTheScript ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingPenguinGame a pm:Practicing ;
    rdfs:label "Humour and imagination: the penguin game"@en, "Humor und Vorstellung: das Pinguinspiel"@de ;
    skos:definition "Turn irritation into play: in a jostling crowd imagine being in Antarctica among waddling penguins and being a penguin oneself; the people then seem pleasant and even interesting."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingPenguinGameYieldsStoppingThePendulum a pm:Yielding ;
    rdfs:label "Humour stops the swing"@en, "Humor hält den Schwung an"@de ;
    skos:definition "Humour and imagination are said to help stop a pendulum by converting irritation into a game."@en ;
    pm:byPractice pmp:TranserfingPenguinGame ;
    pm:yieldsCapacity pmc:TranserfingStoppingThePendulum ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingRememberingThePendulum a pm:Practicing ;
    rdfs:label "Remembering not to respond to provocation"@en, "Erinnern, nicht auf Provokation zu reagieren"@de ;
    skos:definition "At moments of wanting to vent anger, recall that a pendulum lies behind the urge and wants your energy, and do not respond; make it a goal to keep recalling this until it is habitual."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRememberingThePendulumYieldsImmunityToProvocation a pm:Yielding ;
    rdfs:label "Habitual remembering yields immunity"@en, "Gewohnheitsmäßiges Erinnern bewirkt Immunität"@de ;
    skos:definition "Practising remembrance until it becomes habit is said to build immunity to provocation."@en ;
    pm:byPractice pmp:TranserfingRememberingThePendulum ;
    pm:yieldsCapacity pmc:TranserfingImmunityToProvocation ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingImmunityToProvocation a pm:Conceptualizing ;
    rdfs:label "Immunity to provocation"@en, "Immunität gegen Provokation"@de ;
    skos:definition "Becoming gradually immune to the provocations of pendulums."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingEscalation a pm:Conceptualizing ;
    rdfs:label "Negative reaction escalates the situation"@en, "Negative Reaktion eskaliert die Lage"@de ;
    skos:definition "Meeting a disappointing turn of events with irritation or displeasure makes it escalate or other things go wrong: one pushes the pendulum higher oneself."@en ;
    skos:note "Condition of failure: Meeting a disappointing turn of events with irritation or displeasure makes it escalate or other things go wrong: one pushes the pendulum higher oneself."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingInappropriateReaction a pm:Practicing ;
    rdfs:label "Inappropriate reaction: substituting emotions"@en, "Unangemessene Reaktion: Gefühle vertauschen"@de ;
    skos:definition "Do not react, or react abnormally: answer unpleasant situations with feigned enthusiasm or wacky delight; play your own game of deliberately replacing fear with confidence, gloom with enthusiasm, resentment with indifference, irritation with joy, starting with small nuisances. Radiating off the resonance frequency creates dissonance."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingInappropriateReactionYieldsStoppingThePendulum a pm:Yielding ;
    rdfs:label "Emotion substitution stops the swing and breaks the habit"@en, "Gefühlstausch hält das Pendel an und löst die Gewohnheit"@de ;
    skos:definition "Substituting positive for negative emotion is said to still the pendulum and make the habit of negative reaction fade."@en ;
    pm:byPractice pmp:TranserfingInappropriateReaction ;
    pm:yieldsCapacity pmc:TranserfingStoppingThePendulum ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingProvocationStops a pm:Conceptualizing ;
    rdfs:label "Provocation stops; the pendulum lets you be"@en, "Provokation endet; das Pendel lässt einen in Ruhe"@de ;
    skos:definition "Announced signs of the inappropriate reaction: the swing comes to rest and the provocation stops with it, the pendulum leaves one in peace, and one will be surprised how powerful the technique is."@en ;
    skos:note "Sign of success announced in advance: announced for pmp:TranserfingInappropriateReaction."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingVisualisingFulfilment a pm:Practicing ;
    rdfs:label "Visualising the other's fulfilment"@en, "Die Erfüllung des anderen visualisieren"@de ;
    skos:definition "When a person troubles you, at once distract yourself from the problem so as not to lock in its frequency; work out what they lack (usually health, self-confidence or calm); imagine them receiving it and content, e.g. the shouting boss relaxing by a fire, skiing confidently or swimming happily; their specific pastimes help but simply imagining them happy suffices. Applies even to a mugger (what does he need?)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAggressionTurnsToGoodwill a pm:Conceptualizing ;
    rdfs:label "Aggression turns to goodwill"@en, "Aggression wird zu Wohlwollen"@de ;
    skos:definition "Announced signs of visualising fulfilment: if successful the problem counts as solved, the pendulum replaces aggression with goodwill, and the person grows friendlier toward you without knowing why; an ill-disposed official becomes amenable. The reader is told to test it."@en ;
    skos:note "Sign of success announced in advance: announced for pmp:TranserfingVisualisingFulfilment."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingWinningCooperation a pm:Conceptualizing ;
    rdfs:label "Winning cooperation from the unwilling"@en, "Mitarbeit Unwilliger gewinnen"@de ;
    skos:definition "Obtaining what one needs from someone absorbed in his own problems, such as an official's signature, by the same visualisation."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingVisualisingFulfilmentYieldsWinningCooperation a pm:Yielding ;
    rdfs:label "Visualising fulfilment yields cooperation and stops the pendulum"@en, "Erfüllungsvisualisierung bewirkt Mitarbeit und hält das Pendel an"@de ;
    skos:definition "The visualisation is said to stop the pendulum gently and make unwilling people amenable."@en ;
    pm:byPractice pmp:TranserfingVisualisingFulfilment ;
    pm:yieldsCapacity pmc:TranserfingWinningCooperation, pmc:TranserfingStoppingThePendulum ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingEnergyOfStilledPendulum a pm:Conceptualizing ;
    rdfs:label "Growing stronger through stilled pendulums"@en, "Stärker werden durch angehaltene Pendel"@de ;
    skos:definition "The energy of a pendulum brought to rest is said to pass to the practitioner; each problem coped with this way makes one stronger and the next attempt easier."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingVisualisingFulfilmentYieldsEnergyOfStilledPendulum a pm:Yielding ;
    rdfs:label "Stopping pendulums yields growing strength"@en, "Pendelanhalten bewirkt wachsende Stärke"@de ;
    skos:definition "Bringing a pendulum to rest by visualising fulfilment returns the energy to the practitioner."@en ;
    pm:byPractice pmp:TranserfingVisualisingFulfilment ;
    pm:yieldsCapacity pmc:TranserfingEnergyOfStilledPendulum ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingPsychotherapyParallel a pm:Conceptualizing ;
    rdfs:label "Psychotherapy already knows these techniques"@en, "Die Psychotherapie kennt diese Techniken bereits"@de ;
    skos:definition "The author concedes that psychologists and psychotherapists know equivalent ways of defeating or halting a pendulum; the novelty claimed is an explanation of why psychological protection works."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Stopping a Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. II Pendulums, section 'Simple Solutions to Complex Problems'
#

pmc:TranserfingSimpleSolutions a pm:Conceptualizing ;
    rdfs:label "Simple solutions to complex problems"@en, "Einfache Lösungen für komplexe Probleme"@de ;
    skos:definition "The techniques of defeating and stopping pendulums are said to confer skill in solving every sort of problem: personal entanglements, conflicts, adverse circumstances or set tasks; a simple key always lies on the surface."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Simple Solutions to Complex Problems'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNarrowCorridor a pm:Conceptualizing ;
    rdfs:label "Pendulum narrows thinking; genius as freedom from pendulums"@en, "Pendel verengt das Denken; Genie als Pendelfreiheit"@de ;
    skos:definition "A problem-making pendulum holds thought at the problem's frequency, aided by the habit of fearing problems as complex, and confines thinking to a narrow corridor of the information field; focusing on the problem hinders the solution. Intuitive solutions come once free; the secret of genius is said to be remaining free of pendulums."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Simple Solutions to Complex Problems'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGenius a pm:Conceptualizing ;
    rdfs:label "Genius: thought free to roam the information field"@en, "Genie: frei im Informationsfeld schweifendes Denken"@de ;
    skos:definition "A genius's thought energy is said to be free to attune to various frequencies and reach uncharted regions of the information field, yielding unusual and intuitive solutions."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Simple Solutions to Complex Problems'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRentYourselfOutYieldsSimpleSolutions a pm:Yielding ;
    rdfs:label "Detachment yields simple solutions"@en, "Losgelöstheit bewirkt einfache Lösungen"@de ;
    skos:definition "Remaining detached is said to avoid the pendulum's snare, freeing thought to find the simple key."@en ;
    pm:byPractice pmp:TranserfingRentYourselfOut ;
    pm:yieldsCapacity pmc:TranserfingSimpleSolutions, pmc:TranserfingGenius ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Simple Solutions to Complex Problems'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingRentYourselfOut a pm:Practicing ;
    rdfs:label "Rent yourself out: detached observation"@en, "Sich vermieten: distanziertes Beobachten"@de ;
    skos:definition "Keep the problem in perspective and stay aware that the pendulum wants to lure you into its labyrinth; be detached, look at the situation as if without emotional attachment, act as normal but observantly without playing; do not let the problem scare, worry or confuse you; remember every problem has a straightforward solution and reject the complicated interpretation."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Simple Solutions to Complex Problems'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingReversingTheAttitude a pm:Practicing ;
    rdfs:label "Reversing one's initial attitude to a problem"@en, "Die anfängliche Haltung zum Problem umkehren"@de ;
    skos:definition "Notice your attitude to a problem and, despite confusion, fear, resentment or despair, turn it into its exact opposite; treat problems as ordinary parts of the road rather than obstacles to overcome; do not let the problem occupy your inner space, be empty toward it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Simple Solutions to Complex Problems'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingProblemVanishes a pm:Conceptualizing ;
    rdfs:label "Problem vanishes or a simple solution appears"@en, "Problem verschwindet oder einfache Lösung erscheint"@de ;
    skos:definition "Announced sign of reversing the attitude: the problem either disappears by itself or a simple solution is quickly found."@en ;
    skos:note "Sign of success announced in advance: announced for pmp:TranserfingReversingTheAttitude."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Simple Solutions to Complex Problems'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingReversingTheAttitudeYieldsSimpleSolutions a pm:Yielding ;
    rdfs:label "Attitude reversal yields simple solutions"@en, "Haltungsumkehr bewirkt einfache Lösungen"@de ;
    skos:definition "Reversing the initial attitude toward a problem is said to dissolve it or reveal a simple solution."@en ;
    pm:byPractice pmp:TranserfingReversingTheAttitude ;
    pm:yieldsCapacity pmc:TranserfingSimpleSolutions ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Simple Solutions to Complex Problems'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingSubconsciousAndInformationField a pm:Conceptualizing ;
    rdfs:label "Subconscious linked to the information field"@en, "Unterbewusstsein mit dem Informationsfeld verbunden"@de ;
    skos:definition "The subconscious is said to be directly connected with the information field, in which every possible problem already has its answer, so logic need not be the only resource."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Simple Solutions to Complex Problems'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingEmptinessBeforeAProblem a pm:Practicing ;
    rdfs:label "Receiving a solution through emptiness"@en, "Lösung durch Leere empfangen"@de ;
    skos:definition "Facing a hard problem: relax, release fear and anxiety about it, trusting that an answer is already there; release, quiet the mind's chatter and contemplate emptiness. If nothing comes, do not give up and go straight back to rational thinking; repeat the exercise, which often works the second time; make it a habit."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Simple Solutions to Complex Problems'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingInstantSolution a pm:Conceptualizing ;
    rdfs:label "Instant, simple solution"@en, "Sofortige, einfache Lösung"@de ;
    skos:definition "Announced sign: the solution is likely to arrive instantly and to be very simple; a second attempt will probably succeed if the first did not."@en ;
    skos:note "Sign of success announced in advance: announced for pmp:TranserfingEmptinessBeforeAProblem."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Simple Solutions to Complex Problems'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingIntuitiveKnowing a pm:Conceptualizing ;
    rdfs:label "Intuitive knowing"@en, "Intuitives Erkennen"@de ;
    skos:definition "The faculty of gaining knowledge by intuition from the information field."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Simple Solutions to Complex Problems'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingEmptinessBeforeAProblemYieldsIntuitiveKnowing a pm:Yielding ;
    rdfs:label "Emptiness exercise develops intuitive knowing"@en, "Leerübung entwickelt intuitives Erkennen"@de ;
    skos:definition "The exercise is said to develop the ability to gain knowledge intuitively and to deliver solutions to problems."@en ;
    pm:byPractice pmp:TranserfingEmptinessBeforeAProblem ;
    pm:yieldsCapacity pmc:TranserfingIntuitiveKnowing, pmc:TranserfingSimpleSolutions ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Simple Solutions to Complex Problems'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDetachmentForIntuition a pm:Presupposing ;
    rdfs:label "Detachment and freedom from the pendulum for the emptiness method"@en, "Losgelöstheit und Pendelfreiheit für die Leermethode"@de ;
    skos:definition "The method is said to work if one can stay detached and free oneself of the pendulum, which is not always easy."@en ;
    skos:note "Stated as a condition; no explicit consequence of skipping beyond its implication."@en ;
    skos:note "The text names no consequence beyond the condition itself, so the order is entered as prescribed, not as a stated necessity."@en ;
    pm:dependentStep pmp:TranserfingEmptinessBeforeAProblem ;
    pm:priorStep pmc:TranserfingFreedomFromPendulum, pmp:TranserfingRentYourselfOut ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Simple Solutions to Complex Problems'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFreeEvenOfPreachersOfFreedom a pm:Cautioning ;
    rdfs:label "Stay free even of preachers of freedom"@en, "Frei bleiben, auch von Freiheitspredigern"@de ;
    skos:definition "The author asks whether the reader feels led into a labyrinth by him and warns the reader to remain free even of anyone preaching freedom."@en ;
    skos:note "Self-warning that includes the author and his method."@en ;
    pm:cautionsAbout pmc:TranserfingMayatnik ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Simple Solutions to Complex Problems'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. II Pendulums, section 'The Suspended State'
#

pmc:TranserfingSuspendedState a pm:Conceptualizing ;
    rdfs:label "The suspended state"@en, "Der Schwebezustand"@de ;
    skos:definition "Freed from pendulums but without a goal (e.g. after neglecting goals for pendulum fighting), one hangs in a vacuum: events go on without you, others pay less attention, worries lessen but no new desires or achievements appear; living in a pendulum-built world one ends in a desert, not much better than dependence."@en ;
    skos:note "Condition of failure: Freed from pendulums but without a goal (e.g. after neglecting goals for pendulum fighting), one hangs in a vacuum: events go on without you, others pay less attention, worries lessen but no new desires or achievements appear; living in a pendulum-built world one ends in a desert, not much better than dependence."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'The Suspended State'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingConflictsFade a pm:Conceptualizing ;
    rdfs:label "Signs of disentanglement from pendulums"@en, "Zeichen der Lösung von Pendeln"@de ;
    skos:definition "Announced signs of having freed oneself from destructive pendulums: old conflicts and concerns fade, arguments become rarer, anxiety and worry gradually disappear, unnoticed, like a passing storm."@en ;
    skos:note "Sign of success announced in advance: announced for pmp:TranserfingNonResistance, pmp:TranserfingIgnoring, pmp:TranserfingEmptiness, pmp:TranserfingGentleDodge, pmp:TranserfingBreakingTheScript, pmp:TranserfingInappropriateReaction, pmp:TranserfingVisualisingFulfilment."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'The Suspended State'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFindingOwnPendulumsYieldsUsingPendulums a pm:Yielding ;
    rdfs:label "Own pendulums prevent the suspended state"@en, "Eigene Pendel verhindern den Schwebezustand"@de ;
    skos:definition "Finding one's own pendulums is said to keep one out of the suspended state and lets one use pendulums for one's purpose."@en ;
    skos:note "The chapter summary restates this as a rule against the suspended state."@en ;
    pm:byPractice pmp:TranserfingFindingOwnPendulums ;
    pm:yieldsCapacity pmc:TranserfingUsingPendulums ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'The Suspended State'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingFindingOwnPendulums a pm:Practicing ;
    rdfs:label "Finding one's own pendulums and goals"@en, "Die eigenen Pendel und Ziele finden"@de ;
    skos:definition "Recognise the goals one has been conditioned to chase that lead away from one's life line of happiness; stay free of others' pendulums; seek personal pendulums useful to oneself; choose the life lines where true success and happiness lie."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'The Suspended State'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingSelfAwarenessForOwnPendulums a pm:Presupposing ;
    rdfs:label "Self-awareness for harmless pendulums"@en, "Selbstgewahrsein für unschädliche Pendel"@de ;
    skos:definition "Pendulums need not be detrimental provided the person is self-aware."@en ;
    skos:note "Prior is a state (self-awareness) without own rid."@en ;
    skos:note "Self-awareness is carried by pmp:TranserfingFindingOwnPendulums, which asks the reader to see through the goals he has been conditioned to chase."@en ;
    pm:dependentStep pmc:TranserfingUsingPendulums ;
    pm:priorStep pmp:TranserfingFindingOwnPendulums ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'The Suspended State'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingUsingPendulums a pm:Conceptualizing ;
    rdfs:label "Using pendulums for one's own purpose"@en, "Pendel für eigene Ziele nutzen"@de ;
    skos:definition "Avoiding oppression by pendulums while consciously working them for one's own aims; pendulums are said ultimately to be what turns dreams into reality. Complete freedom from pendulums is called impossible and unnecessary."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'The Suspended State'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. II Pendulums, section 'Summary'
#

pmc:TranserfingRememberingWhatOneKnows a pm:Conceptualizing ;
    rdfs:label "Habit of remembering what one knows"@en, "Gewohnheit, sich an das Gewusste zu erinnern"@de ;
    skos:definition "The chapter summary adds as a general rule that one must make a habit of recalling what one already knows, generalising the body's advice to remember the pendulum behind provocations (A1-104)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. II Pendulums, section 'Summary'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# prima-materia — Transerfing: Vadim Zeland, Transerfing real'nosti, Stupen' I
# (2004), part 2: chapter III The Wave of Fortune, chapter IV Balance.
#
# This part defines the shared system terms pmc:TranserfingVolnaUdachi,
# pmc:TranserfingUravnoveshivayushchieSily, pmc:TranserfingIzbytochnyPotentsial
# and pmc:TranserfingVazhnost; it links to the terms of part 1 (pendulum,
# freedom of choice, freedom from and protection from pendulums, better life
# circumstances, renting oneself out) without typing them. Two independent
# extraction passes ran over the text (A 323 records, B 240; 6 records of B
# without counterpart in A: 0 added, 6 covered, 0 not owed); the integrator's
# reading of the whole part added none. The author's polemic against Chekhov's
# method is entered as a concept, since only his side is read.
#

#
# ch. III The Wave of Fortune, section 'Antipode to the Pendulum'
#

pmc:TranserfingPendulumNeverConstructive a pm:Conceptualizing ;
    rdfs:label "No pendulum is constructive for its adherents"@en, "Kein Pendel ist für seine Anhänger konstruktiv"@de ;
    skos:definition "Every pendulum pursues the single aim of drawing energy from its followers; it can be called constructive only with respect to itself, never with respect to the adherent, though pendulums differ in how destructive and aggressive they are."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Antipode to the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRuleFollowingFeedsPendulum a pm:Conceptualizing ;
    rdfs:label "Rule-following as energy supply to a pendulum"@en, "Regelbefolgung als Energiezufuhr an das Pendel"@de ;
    skos:definition "Even when one is focused on oneself (e.g. training at a gym), being obliged to act by the shared rules of the structure makes one's energy available to its pendulum; if all members leave, the pendulum stops swinging."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Antipode to the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingVolnaUdachi a pm:Conceptualizing ;
    rdfs:label "Wave of fortune"@en, "Welle des Glücks"@de ;
    skos:definition "An energetic structure that needs none of your energy: the bundle of lines within the alternatives space that are favourable to a given person; everyone has their own. It brings happiness without taking energy, is indifferent to one's fate, does not feed on other beings and is said to be a temporary formation that fades."@en ;
    skos:note "Russian term: volna udachi (волна удачи)."@en ;
    skos:note "Summary restates it as a cluster of favourable lines."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Antipode to the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingJoyBeforeCascade a pm:Presupposing ;
    rdfs:label "Joy at the first stroke of luck before a cascade"@en, "Freude am ersten Glücksfall vor der Kaskade"@de ;
    skos:definition "A cascade of further pleasant events follows only if the first sign of fortune delighted you and raised your mood; otherwise the cascade need not follow."@en ;
    skos:note "Summary sharpens the body into an explicit \"only if\"."@en ;
    pm:dependentStep pmc:TranserfingRidingTheWave ;
    pm:priorStep pmp:TranserfingAcceptingTheWave ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Without being imbued with the joy of the first luck, no cascade of good luck is guaranteed." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Antipode to the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGoldenVeins a pm:Conceptualizing ;
    rdfs:label "Golden veins in the alternatives space"@en, "Goldene Adern im Variantenraum"@de ;
    skos:definition "The alternatives space is said to contain runs of auspicious lines like veins of gold through the information field; whoever finds the outer edge of such a vein and seizes a piece of luck can slide on by inertia to neighbouring lines where similar events accumulate."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Antipode to the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingBadStreakAfterLuck a pm:Conceptualizing ;
    rdfs:label "Bad streak after first luck: a pendulum has hooked you"@en, "Pechsträhne nach dem ersten Glück: ein Pendel hat angehakt"@de ;
    skos:definition "If a first stroke of luck is followed by a run of bad luck, this is said to show that a destructive pendulum has caught you and drawn you off the golden vein."@en ;
    skos:note "Condition of failure: If a first stroke of luck is followed by a run of bad luck, this is said to show that a destructive pendulum has caught you and drawn you off the golden vein; it defeats pmc:TranserfingRidingTheWave."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Antipode to the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRidingTheWave a pm:Conceptualizing ;
    rdfs:label "Riding the wave of fortune"@en, "Auf der Welle des Glücks reiten"@de ;
    skos:definition "Being carried, without struggle or great effort, along a cascade of fortunate events onto life lines that are happy for oneself; the bird of happiness is said to stay with whoever accepts it."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Antipode to the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGoodNewsFromOtherLines a pm:Conceptualizing ;
    rdfs:label "Good news as information from other life lines"@en, "Gute Nachricht als Information anderer Lebenslinien"@de ;
    skos:definition "The wave of fortune touches one's life as good news: information carried in from other life lines, perceived as good by comparison with the current line. The task is to pull oneself along this rope onto the line it came from, where favourable circumstances also wait."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Antipode to the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingStationaryWave a pm:Conceptualizing ;
    rdfs:label "The wave is stationary; motion is an impression"@en, "Die Welle steht still; Bewegung ist ein Eindruck"@de ;
    skos:definition "The wave does not actually move, grow or weaken; \"wave\" is a metaphor. It exists fixed in the alternatives space as more rewarding lines, and the impression of its coming and going arises from the discontinuity of one's own movement between lines."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Antipode to the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingAcceptingTheWave a pm:Practicing ;
    rdfs:label "Accepting the wave of fortune"@en, "Die Welle des Glücks annehmen"@de ;
    skos:definition "Treat luck as a matter of choice: when a stroke of luck comes, embrace it and invite it into your life instead of letting yourself be drawn away by other pendulums; do not chase the bird of happiness, but do not drive it off either; let the joy of the first lucky event fill you."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Antipode to the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAcceptingTheWaveYieldsRidingTheWave a pm:Yielding ;
    rdfs:label "Accepting the wave yields riding it"@en, "Annahme der Welle ergibt das Reiten auf ihr"@de ;
    skos:definition "Accepting the wave into one's life is said to keep it with you."@en ;
    pm:byPractice pmp:TranserfingAcceptingTheWave ;
    pm:yieldsCapacity pmc:TranserfingRidingTheWave ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Antipode to the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingIndependenceBeforeChoice a pm:Presupposing ;
    rdfs:label "Independence before freedom of choice"@en, "Unabhängigkeit vor Wahlfreiheit"@de ;
    skos:definition "To claim freedom of choice one must first be independent of pendulums."@en ;
    pm:dependentStep pmc:TranserfingFreedomOfChoice ;
    pm:priorStep pmc:TranserfingIndependenceFromPendulums ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "One stays restricted by pendulums that pull one off the wave." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Antipode to the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingIndependenceFromPendulums a pm:Conceptualizing ;
    rdfs:label "Independence from other people's pendulums"@en, "Unabhängigkeit von fremden Pendeln"@de ;
    skos:definition "Being independent of the sway of pendulums belonging to others; the author calls this a right the reader can claim, and the summary says overcoming dependence on pendulums wins one freedom."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Antipode to the Pendulum'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. III The Wave of Fortune, section 'The Boomerang'
#

pmc:TranserfingFearConditionedPsyche a pm:Conceptualizing ;
    rdfs:label "Psyche conditioned by destructive pendulums"@en, "Durch destruktive Pendel geprägte Psyche"@de ;
    skos:definition "The human psyche is said to have formed over millennia under destructive pendulums that kept people in fear to manipulate them; hence people know clearly what they reject and only vaguely what they wish for, and uncontrolled inner chatter tends toward negative thoughts."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'The Boomerang'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNegativeThoughtMachine a pm:Cautioning ;
    rdfs:label "Negative thought machine feeds destructive pendulums"@en, "Negative Gedankenmaschine nährt destruktive Pendel"@de ;
    skos:definition "Letting one's will follow the negative chatter of the mind means playing a destructive pendulum's game and radiating at its resonance frequency; the author calls this a very harmful habit."@en ;
    pm:cautionsAbout pmc:TranserfingMayatnik ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'The Boomerang'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingProgrammingPositiveThoughts a pm:Practicing ;
    rdfs:label "Programming positive thoughts in idle moments"@en, "Positive Gedanken in leeren Momenten programmieren"@de ;
    skos:definition "Replace negative chatter with conscious control of thought: whenever the mind is free (travelling, walking, routine work) deliberately set it on positive thoughts; dwell on what you want to achieve, not on what you failed to achieve."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'The Boomerang'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAchievingWhatOneWants a pm:Conceptualizing ;
    rdfs:label "Achieving what one wants"@en, "Erreichen, was man will"@de ;
    skos:definition "Getting the things and situations one desires, e.g. the house of one's dreams or improved circumstances."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'The Boomerang'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingProgrammingPositiveThoughtsYieldsAchievingWhatOneWants a pm:Yielding ;
    rdfs:label "Positive thought programming yields achieving what one wants"@en, "Positive Gedankensteuerung ergibt das Gewollte"@de ;
    skos:definition "The author asserts that dwelling on one's aims leads to attaining them."@en ;
    pm:byPractice pmp:TranserfingProgrammingPositiveThoughts ;
    pm:yieldsCapacity pmc:TranserfingAchievingWhatOneWants ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'The Boomerang'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingEnmityFollowsYou a pm:Conceptualizing ;
    rdfs:label "Enmity toward the present situation follows you to the new one"@en, "Feindschaft gegen die jetzige Lage folgt in die neue"@de ;
    skos:definition "Thinking with irritation and hatred about one's current home makes it impossible to get what one wants; even after moving to a far better house, one meets disappointments (leaks, peeling paint, bad neighbours) that keep the parameters of the old negativity. The greater the enmity, the more unpleasant surprises."@en ;
    skos:note "Condition of failure: Thinking with irritation and hatred about one's current home makes it impossible to get what one wants; even after moving to a far better house, one meets disappointments (leaks, peeling paint, bad neighbours) that keep the parameters of the old negativity. The greater the enmity, the more unpleasant surprises; it defeats pmc:TranserfingAchievingWhatOneWants."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'The Boomerang'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLineMatchesVibration a pm:Conceptualizing ;
    rdfs:label "One stays on the line matching one's energy"@en, "Man bleibt auf der Linie, die der eigenen Energie entspricht"@de ;
    skos:definition "Thinking about what one dislikes radiates negative energy matching the present life line; until the vibration of one's energy changes, one must keep enduring the same line. The section's conclusion: one is always on a life line representing the quality of one's energetic vibration."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'The Boomerang'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingVibrationBeforeDesiredLine a pm:Presupposing ;
    rdfs:label "Changing vibration before reaching the desired line"@en, "Schwingung ändern, bevor man die gewünschte Linie erreicht"@de ;
    skos:definition "A better line (e.g. finding the house one wants) is reached only after one's energetic vibration has changed."@en ;
    pm:dependentStep pmc:TranserfingAchievingWhatOneWants ;
    pm:priorStep pmc:TranserfingBetterLifeCircumstances ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "One keeps putting up with the same life line." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'The Boomerang'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingGratitudeThenImagining a pm:Practicing ;
    rdfs:label "Two-step procedure for a disliked situation (the house)"@en, "Zweischritt-Verfahren bei einer ungeliebten Lage (das Haus)"@de ;
    skos:definition "First, accept the current situation and drop dissatisfaction and resentment; find small reasons for joy; be grateful (e.g. to the house for shelter and warmth); feel love for what helps you survive; when you finally leave, thank everything around you, even what you will throw away. Second, start picturing the home you desire: browse estate agency photographs, window-shop for furniture and decorations, and live mentally with the things you wish to own."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'The Boomerang'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGratitudeThenImaginingYieldsBetterLifeCircumstances a pm:Yielding ;
    rdfs:label "Gratitude and wish-imagining yield a better line"@en, "Dankbarkeit und Wunschvorstellung ergeben eine bessere Linie"@de ;
    skos:definition "Gratitude radiates positive energy that returns later, and then an improvement of circumstances can realistically be expected."@en ;
    pm:byPractice pmp:TranserfingGratitudeThenImagining ;
    pm:yieldsCapacity pmc:TranserfingBetterLifeCircumstances ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'The Boomerang'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAcceptanceBeforeImagining a pm:Presupposing ;
    rdfs:label "Acceptance before imagining the desired"@en, "Annahme vor dem Vorstellen des Gewünschten"@de ;
    skos:definition "The procedure names acceptance and gratitude as the first step and thinking about the desired house as the second."@en ;
    pm:dependentStep pmc:TranserfingAchievingWhatOneWants ;
    pm:priorStep pmp:TranserfingGratitudeThenImagining ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'The Boomerang'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingBoomerang a pm:Conceptualizing ;
    rdfs:label "Thoughts return like a boomerang"@en, "Gedanken kehren wie ein Bumerang zurück"@de ;
    skos:definition "One always ends up receiving the things and situations to which one's thoughts are most strongly attached; negative energy taken in brings disappointments, negative energy given out returns as disappointment."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'The Boomerang'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingNeutralStance a pm:Practicing ;
    rdfs:label "Neutral stance toward an unpleasant circumstance"@en, "Neutrale Haltung gegenüber einem unangenehmen Umstand"@de ;
    skos:definition "Facing something unpleasant one cannot enjoy (e.g. cold rain before a holiday), at least take a neutral position, ignore the associated pendulum and do not openly express displeasure or curse the present place."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'The Boomerang'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingContemptSpoilsTheGoal a pm:Conceptualizing ;
    rdfs:label "Contempt for the present spoils the future goal"@en, "Verachtung für das Jetzt verdirbt das Ziel"@de ;
    skos:definition "Expressing displeasure accepts the pendulum and swings it higher; scorning the present place while looking forward to the sunny south does not attune you to the desired line and you may arrive to bad weather or another problem; a bought ticket gives no security."@en ;
    skos:note "Condition of failure: Expressing displeasure accepts the pendulum and swings it higher; scorning the present place while looking forward to the sunny south does not attune you to the desired line and you may arrive to bad weather or another problem; a bought ticket gives no security; it defeats pmc:TranserfingAchievingWhatOneWants; it bears on pmp:TranserfingNeutralStance."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'The Boomerang'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingIrritationFollowedByMishap a pm:Conceptualizing ;
    rdfs:label "Transmitted irritation is followed by mishap"@en, "Ausgesandte Gereiztheit wird von Missgeschick gefolgt"@de ;
    skos:definition "After shouting at someone out of irritation, something is said to go wrong soon after, because the transmitted negative energy corresponds to lines dense with irritation and misfortune."@en ;
    skos:note "Condition of failure: After shouting at someone out of irritation, something is said to go wrong soon after, because the transmitted negative energy corresponds to lines dense with irritation and misfortune."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'The Boomerang'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNoExcuseForIrritation a pm:Cautioning ;
    rdfs:label "Do not excuse one's irritation as unavoidable"@en, "Gereiztheit nicht als unvermeidlich entschuldigen"@de ;
    skos:definition "The reader is warned against excusing oneself with the claim that the particular irritation was unavoidable."@en ;
    pm:cautionsAbout pmc:TranserfingIrritationFollowedByMishap ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'The Boomerang'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingVerifyByObservation a pm:Conceptualizing ;
    rdfs:label "Verification by own observation, not proof"@en, "Prüfung durch eigene Beobachtung, nicht Beweis"@de ;
    skos:definition "The author says he has nothing to prove and refers the reader to their own observation as the test of the claim that negativity draws misfortune."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'The Boomerang'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingObservingReactions a pm:Practicing ;
    rdfs:label "Self-observation of reactions and their sequels"@en, "Selbstbeobachtung von Reaktionen und ihren Folgen"@de ;
    skos:definition "Watch for yourself how each negative reaction is followed by some further regrettable event, and stop putting out negative energy as well as taking it in."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'The Boomerang'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. III The Wave of Fortune, section 'Transmission'
#

pmp:TranserfingAttendingToThePositive a pm:Practicing ;
    rdfs:label "Transmission: attending to the positive"@en, "Übertragung: dem Positiven Aufmerksamkeit geben"@de ;
    skos:definition "Instead of playing destructive pendulums' games, seek pendulums whose game benefits you; habitually give attention to what is good; whenever something pleasing or encouraging reaches you through eyes or ears, keep dwelling on it and allow it to raise your mood (pick the jasmine, not the elderberry)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAttendingToThePositiveYieldsRidingTheWave a pm:Yielding ;
    rdfs:label "Attending to the positive yields more good news and opportunity"@en, "Aufmerksamkeit aufs Positive ergibt mehr gute Nachrichten"@de ;
    skos:definition "Letting in what is positive is said to bring a growing stream of good news and favourable chances along one's path."@en ;
    pm:byPractice pmp:TranserfingAttendingToThePositive ;
    pm:yieldsCapacity pmc:TranserfingRidingTheWave ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingKeepingTheFestiveFeeling a pm:Practicing ;
    rdfs:label "Keeping the festive feeling alive"@en, "Das Festgefühl lebendig halten"@de ;
    skos:definition "After a moment of inspiration or joy, deliberately remember it so the daily routine does not swallow it; nourish the small flame of enthusiasm; observe how life is improving, seize every straw of happiness, seek favourable omens everywhere; recall that each minute of practice consciously moves you toward your dream."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRoutineErasesJoy a pm:Conceptualizing ;
    rdfs:label "Routine and negative pendulums erase the good feeling"@en, "Routine und negative Pendel löschen das gute Gefühl"@de ;
    skos:definition "Habit pulls one back into monotony and negative pendulums make one forget the good event and the pleasure it gave; then the feeling of elation is lost."@en ;
    skos:note "Condition of failure: Habit pulls one back into monotony and negative pendulums make one forget the good event and the pleasure it gave; then the feeling of elation is lost."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingKeepingTheFestiveFeelingYieldsRidingTheWave a pm:Yielding ;
    rdfs:label "Habitual festive feeling yields constant riding of the wave"@en, "Gewohntes Festgefühl ergibt dauerndes Reiten der Welle"@de ;
    skos:definition "Once the resulting calm, assurance and happiness become habitual, one is said to ride the top of the wave constantly."@en ;
    pm:byPractice pmp:TranserfingKeepingTheFestiveFeeling ;
    pm:yieldsCapacity pmc:TranserfingRidingTheWave ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDissatisfactionBlocksShift a pm:Conceptualizing ;
    rdfs:label "Dissatisfaction blocks the shift to inspiring lines"@en, "Unzufriedenheit blockiert den Wechsel auf inspirierende Linien"@de ;
    skos:definition "Expressing dissatisfaction is called highly disadvantageous: one cannot shift to inspiring life lines while one's energy field carries the vibration of dissatisfaction."@en ;
    skos:note "Condition of failure: Expressing dissatisfaction is called highly disadvantageous: one cannot shift to inspiring life lines while one's energy field carries the vibration of dissatisfaction; it defeats pmc:TranserfingBetterLifeCircumstances."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingFilteringNews a pm:Practicing ;
    rdfs:label "Filtering news: closed to bad, open to good"@en, "Nachrichten filtern: zu für schlechte, offen für gute"@de ;
    skos:definition "Keep bad news out of your heart; stay open to good news. When even slightly encouraging news arrives, do not forget it: savour it, discuss it, follow it up, consider it from every side, enjoy it, make forecasts and expect further improvement; carefully nourish any positive change."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingMessengersOfTheWave a pm:Conceptualizing ;
    rdfs:label "Good news and positive changes as messengers of the wave"@en, "Gute Nachrichten und positive Veränderungen als Boten der Welle"@de ;
    skos:definition "Any good news or positive change, however slight, is announced as a messenger of the wave of fortune, a sign that one is in contact with it."@en ;
    skos:note "Sign of success announced in advance: Any good news or positive change, however slight, is announced as a messenger of the wave of fortune, a sign that one is in contact with it; announced for pmc:TranserfingRidingTheWave."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFilteringNewsYieldsRidingTheWave a pm:Yielding ;
    rdfs:label "Filtering news yields attunement to the wave"@en, "Nachrichtenfilter ergibt Einstimmung auf die Welle"@de ;
    skos:definition "Thought vibration stays tuned to the wave's frequency; good news is said to increase and life to improve."@en ;
    pm:byPractice pmp:TranserfingFilteringNews ;
    pm:yieldsCapacity pmc:TranserfingRidingTheWave ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGoodNewsIncreases a pm:Conceptualizing ;
    rdfs:label "Increase of good news and improving life"@en, "Zunahme guter Nachrichten und Besserung des Lebens"@de ;
    skos:definition "Announced sign for the practitioner of news filtering: more good news arrives and life gets better."@en ;
    skos:note "Sign of success announced in advance: Announced sign for the practitioner of news filtering: more good news arrives and life gets better; announced for pmp:TranserfingFilteringNews."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFilteringAsNatureOfReality a pm:Conceptualizing ;
    rdfs:label "Filtering information is the nature of reality"@en, "Informationsfilterung ist die Natur der Wirklichkeit"@de ;
    skos:definition "The author claims that such filtering is neither mysticism nor a peculiarity of the psyche but how reality works: pessimist and optimist alike shift to life lines matching the quality of their thoughts."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFieldOfHarmony a pm:Conceptualizing ;
    rdfs:label "Field of harmonious vibration around oneself"@en, "Feld harmonischer Schwingung um sich"@de ;
    skos:definition "When in right relation with oneself and the surroundings, one transmits harmonious energy and creates around oneself a zone in which everything unfolds successfully."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingProblemSeekingAttitude a pm:Cautioning ;
    rdfs:label "Problem-seeking attitude attracts problems"@en, "Problemsuche zieht Probleme an"@de ;
    skos:definition "Some people habitually seek problems rather than solutions; focusing on problems brings them in abundance and criticism of the negative side yields corresponding fruit. Such people are described as firmly hooked by a destructive pendulum, not as good or bad."@en ;
    pm:cautionsAbout pmc:TranserfingBoomerang ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingOriginalScriptJudges a pm:Conceptualizing ;
    rdfs:label "Original script decides what counts as undesirable"@en, "Das ursprüngliche Drehbuch entscheidet, was unerwünscht heißt"@de ;
    skos:definition "Any event that departs from one's original script tends to be judged undesirable, and success is perceivable only in forms matching the script; so one may grieve missing a plane that then crashes, or let a unique chance pass because it did not fit one's plans."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingWorryBreedsFailure a pm:Conceptualizing ;
    rdfs:label "Worrying about failure breeds failure"@en, "Sorge um Misserfolg erzeugt Misserfolg"@de ;
    skos:definition "The more negative one's thoughts about life, the worse it gets; the more one fears failing, the more readily fresh failures appear. This is called the opposite of Transurfing, sliding toward a personal hell."@en ;
    skos:note "Condition of failure: The more negative one's thoughts about life, the worse it gets; the more one fears failing, the more readily fresh failures appear. This is called the opposite of Transurfing, sliding toward a personal hell."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingJoyInFailure a pm:Practicing ;
    rdfs:label "Joy in the face of failure"@en, "Freude angesichts des Misserfolgs"@de ;
    skos:definition "Take the opposite stance to worry: meet failure with joy, deliberately look for even the smallest blessing in it, keep the glass half full, adopt \"everything happens for a reason\" as a tenet, hold course toward the good, drop the habit of being upset by small obstacles, and treat each failure as a useful lesson."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingJoyInFailureYieldsOwnGenie a pm:Yielding ;
    rdfs:label "Joy in failure yields a world turned paradise"@en, "Freude im Misserfolg ergibt die Welt als Paradies"@de ;
    skos:definition "Finding joy in every part of one's world is said to transform it into paradise; unusual goals call for unusual methods."@en ;
    pm:byPractice pmp:TranserfingJoyInFailure ;
    pm:yieldsCapacity pmc:TranserfingOwnGenie ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingOwnGenie a pm:Conceptualizing ;
    rdfs:label "Turning one's world into paradise; becoming one's own genie"@en, "Die eigene Welt zum Paradies machen; zum eigenen Dschinn werden"@de ;
    skos:definition "Transforming one's world into paradise by finding joy in all its parts, toward the stated unusual goal of becoming one's own genie who fulfils all one's wishes."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingRememberingAtSetback a pm:Practicing ;
    rdfs:label "Remembering: recognising the pendulum at the moment of setback"@en, "Erinnern: das Pendel im Moment des Rückschlags erkennen"@de ;
    skos:definition "When a setback occurs, remember that a pendulum is trying to hook you, and choose consciously whether to vent negative emotion (feeding it) or leave it without any emotional energy; when you catch yourself having reacted out of habit, note it; once you remember in time, laugh inwardly and address it (\"so it is you again\"), then accept or reject it consciously. Practise consistently until the new habit replaces the old."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingSetbackAsHook a pm:Conceptualizing ;
    rdfs:label "Setbacks as pendulum hooks; habit as trigger"@en, "Rückschläge als Pendelhaken; Gewohnheit als Auslöser"@de ;
    skos:definition "A setback is said to be created by a pendulum trying to hook you; pendulums pull on emotional strings, and one's habits trigger the mechanism that captures one's thoughts."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingOldHabitPersists a pm:Cautioning ;
    rdfs:label "Old habit persists at first"@en, "Die alte Gewohnheit hält anfangs an"@de ;
    skos:definition "Even after reading the chapter and resolving not to react, one may still fall back into a negative reaction; at first one only becomes aware afterwards that one forgot."@en ;
    pm:cautionsAbout pmp:TranserfingRememberingAtSetback ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingCatchingTheHabit a pm:Conceptualizing ;
    rdfs:label "Becoming aware of having reacted from habit"@en, "Bewusstwerden der Reaktion aus Gewohnheit"@de ;
    skos:definition "Announced early sign of progress: you notice that you forgot and reacted out of habit, and later you remember in time and inwardly laugh at the pendulum."@en ;
    skos:note "Sign of success announced in advance: Announced early sign of progress: you notice that you forgot and reacted out of habit, and later you remember in time and inwardly laugh at the pendulum; announced for pmp:TranserfingRememberingAtSetback."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRememberingAtSetbackYieldsFreedomFromPendulum a pm:Yielding ;
    rdfs:label "Remembering yields defeat of the pendulum"@en, "Erinnern ergibt den Sieg über das Pendel"@de ;
    skos:definition "Once one recalls this at the right moment, the situation is said to be under one's control and one is no longer the puppet."@en ;
    pm:byPractice pmp:TranserfingRememberingAtSetback ;
    pm:yieldsCapacity pmc:TranserfingFreedomFromPendulum ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingBombardmentWhenChanging a pm:Cautioning ;
    rdfs:label "Pendulums bombard you when you change"@en, "Pendel bombardieren dich, wenn du dich änderst"@de ;
    skos:definition "As soon as one begins to behave differently, pendulums are said to provoke with unpleasant news and events as though someone were deliberately thwarting you; mostly small frustrations. Do not give up."@en ;
    pm:cautionsAbout pmp:TranserfingRememberingAtSetback ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingImpressiveVictory a pm:Conceptualizing ;
    rdfs:label "An impressive victory for those who persist"@en, "Ein beeindruckender Sieg für die Ausdauernden"@de ;
    skos:definition "If one does not give up and learns to remember, the author promises a quite striking victory."@en ;
    skos:note "Sign of success announced in advance: If one does not give up and learns to remember, the author promises a quite striking victory; announced for pmp:TranserfingRememberingAtSetback."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingStayingOnTheWave a pm:Conceptualizing ;
    rdfs:label "Staying on the wave despite pendulums"@en, "Trotz Pendeln auf der Welle bleiben"@de ;
    skos:definition "When next meeting the wave of fortune, pendulums no longer manage to distract you and happiness stays in your hand."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingTransmitterBeforeEmbracingBird a pm:Presupposing ;
    rdfs:label "Positive energy around oneself before fully embracing the bird"@en, "Positive Energie um sich, bevor man den Vogel ganz umfängt"@de ;
    skos:definition "To fully embrace the bird of happiness one has to surround oneself with positive energy."@en ;
    pm:dependentStep pmc:TranserfingStayingOnTheWave ;
    pm:priorStep pmp:TranserfingPositiveTransmitter ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingPositiveTransmitter a pm:Practicing ;
    rdfs:label "Becoming transmitter and receiver of positive energy only"@en, "Sender und ausschließlich Empfänger positiver Energie werden"@de ;
    skos:definition "Surround yourself with positive energy: radiate positive energy and take in exclusively positive energy."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingWorldChangesQuickly a pm:Conceptualizing ;
    rdfs:label "The surrounding world changes quickly for the better"@en, "Die Umwelt ändert sich rasch zum Besseren"@de ;
    skos:definition "Announced sign: the world around you changes very quickly for the better."@en ;
    skos:note "Sign of success announced in advance: Announced sign: the world around you changes very quickly for the better; announced for pmp:TranserfingPositiveTransmitter."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingPositiveTransmitterYieldsRidingTheWave a pm:Yielding ;
    rdfs:label "Positive transmission yields sliding onto successful lines"@en, "Positive Aussendung ergibt Gleiten auf erfolgreiche Linien"@de ;
    skos:definition "If one manages to transmit and receive only positive energy, the world is said to change quickly for the better, one slides easily onto more successful lines and the wave carries one forward to success."@en ;
    pm:byPractice pmp:TranserfingPositiveTransmitter ;
    pm:yieldsCapacity pmc:TranserfingRidingTheWave ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingWaveAsFirstStep a pm:Systematizing ;
    rdfs:label "Riding the wave as the first step of Transurfing"@en, "Wellenreiten als erste Stufe des Transurfings"@de ;
    skos:definition "The author places learning to ride the wave as only the first step of Transurfing, with further discoveries to follow in later chapters."@en ;
    pm:compiledBy "Vadim Zeland" ;
    dcterms:date "2004"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Transmission'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. III The Wave of Fortune, section 'Magic Rituals'
#

pmp:TranserfingAttunementRituals a pm:Practicing ;
    rdfs:label "Attunement rituals (\"magic rituals\")"@en, "Einstimmungsrituale („magische Rituale“)"@de ;
    skos:definition "Use an action or ritual one believes in to attune oneself to the line of success: e.g. a trader gives the first buyer of the day a large discount to ensure good trading that day, or brushes banknotes across the wares; professions invent their own such rituals."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Magic Rituals'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAttunementRitualsYieldsAttunementToSuccessfulLine a pm:Yielding ;
    rdfs:label "Ritual yields attunement via belief"@en, "Ritual ergibt Einstimmung über Glauben"@de ;
    skos:definition "The first sale instils real hope and faith in the trader, and attunement then happens by itself; a believed-in ritual helps attune subconsciously to the line of successful trading."@en ;
    pm:byPractice pmp:TranserfingAttunementRituals ;
    pm:yieldsCapacity pmc:TranserfingAttunementToSuccessfulLine ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Magic Rituals'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAttunementToSuccessfulLine a pm:Conceptualizing ;
    rdfs:label "Attunement to a successful life line (e.g. successful trading)"@en, "Einstimmung auf eine Erfolgslinie (z. B. erfolgreicher Handel)"@de ;
    skos:definition "Mounting the wave of success in a specific activity by radiating thought energy whose parameters match it; for traders, buyers are said to be gripped by this vibration and buy readily."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Magic Rituals'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingBeliefBeforeRitualWorks a pm:Presupposing ;
    rdfs:label "Belief in the ritual before it works"@en, "Glaube an das Ritual, bevor es wirkt"@de ;
    skos:definition "A ritual helps attune only if the performer believes in its power."@en ;
    skos:note "Stated as a condition; no consequence of disbelief given beyond the ritual having no impact of itself."@en ;
    pm:dependentStep pmc:TranserfingAttunementToSuccessfulLine ;
    pm:priorStep pmp:TranserfingAttunementRituals ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Magic Rituals'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRitualAsProp a pm:Conceptualizing ;
    rdfs:label "Ritual as theatrical prop; thought energy as the power"@en, "Ritual als Theaterrequisit; Gedankenenergie als Kraft"@de ;
    skos:definition "The ritual itself has no magic or impact; it works as a stage prop, and the operative power is the performer's own thought energy. The attunement is subconscious, the performer seeing only its visible side; what matters is not the ritual's form but its result."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Magic Rituals'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. III The Wave of Fortune, section 'Summary'
#

pmc:TranserfingHabitBeforeStayingOnWave a pm:Presupposing ;
    rdfs:label "Habit of remembering before pendulums lose their grip"@en, "Gewohnheit des Erinnerns, bevor Pendel den Griff verlieren"@de ;
    skos:definition "Pendulums cannot throw one off the wave once remembering is habitual, and that habit is formed only by consistent practice; until then they keep provoking."@en ;
    skos:note "Summary states the habit condition explicitly; body gives the consequence."@en ;
    pm:dependentStep pmc:TranserfingStayingOnTheWave ;
    pm:priorStep pmp:TranserfingRememberingAtSetback ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Until the new habit replaces the old, pendulums keep provoking and can distract one from the wave." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. III The Wave of Fortune, section 'Summary'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. IV Balance, section 'Excess Potential'
#

pmc:TranserfingLawOfBalance a pm:Conceptualizing ;
    rdfs:label "Law of balance as primary law"@en, "Gesetz des Gleichgewichts als primäres Gesetz"@de ;
    skos:definition "Everything in nature strives toward balance; laws merely state facts and explain nothing; all laws of nature are said to derive from the law of balance, which appears primary and whose origin cannot be explained; it must be accepted as fact."@en ;
    skos:note "Author qualifies primacy as apparent."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingUniversalOscillation a pm:Conceptualizing ;
    rdfs:label "Oscillation everywhere; success also destroys balance"@en, "Überall Schwingung; auch Erfolg stört das Gleichgewicht"@de ;
    skos:definition "Good and bad spells alternate as an expression of the balance law; success no less than misfortune disturbs balance; complete balance would be that nothing happens, and absolute balance has not been observed."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingWorldOfPendulums a pm:Conceptualizing ;
    rdfs:label "The world as interacting pendulums; the person as pendulum"@en, "Die Welt als wechselwirkende Pendel; der Mensch als Pendel"@de ;
    skos:definition "The whole world can be seen as pendulums that oscillate, fade and jolt one another, governed chiefly by the law of balance; a person too is a kind of pendulum, and swinging sharply in one direction knocks neighbouring pendulums, whose commotion turns back against one."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingThoughtsDisturbBalance a pm:Conceptualizing ;
    rdfs:label "Thoughts disturb balance energetically"@en, "Gedanken stören das Gleichgewicht energetisch"@de ;
    skos:definition "Balance can be broken by thoughts and not only via the actions that follow them, because thoughts radiate energy; whatever happens unseen is mirrored in the visible material world."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingIzbytochnyPotentsial a pm:Conceptualizing ;
    rdfs:label "Simplified model: excess potential summons balancing forces"@en, "Vereinfachtes Modell: Überschusspotential ruft Ausgleichskräfte"@de ;
    skos:definition "To avoid tangles of conjecture about energetic processes, the author adopts a deliberately simplified model: wherever excess potential appears, balancing forces arise to remove it."@en ;
    skos:note "Russian term: izbytochny potentsial (избыточный потенциал)."@en ;
    skos:note "Methodological statement: the model is avowedly simplified. Balancing forces: уравновешивающие силы."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingPotentialFromImportance a pm:Conceptualizing ;
    rdfs:label "Excess potential from excessive importance"@en, "Überschusspotential durch übermäßige Wichtigkeit"@de ;
    skos:definition "Mental energy is said to generate excess potential when an object is given too much importance. Standing on the floor and at the edge of a cliff are energetically equal; it is the fear at the cliff that makes the field inhomogeneous, so that balancing forces arise which one can feel as a pull downward and a pull back from the edge."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingUravnoveshivayushchieSily a pm:Conceptualizing ;
    rdfs:label "Balancing forces"@en, "Ausgleichskräfte"@de ;
    skos:definition "Forces that arise wherever there is excess potential in order to eliminate it; their action can be felt and, in eliminating potential, they can produce many problems, often the opposite of what was intended."@en ;
    skos:note "Russian term: uravnoveshivayushchie sily (уравновешивающие силы)."@en ;
    skos:note "Name form in the cited edition: balanced forces, also balancing forces; impersonal corrective forces of the law of balance."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAssessmentAloneNeutral a pm:Conceptualizing ;
    rdfs:label "Assessment alone creates no potential"@en, "Bewertung allein erzeugt kein Potential"@de ;
    skos:definition "All objects are energetically equal; we ascribe qualities to them. An assessment as such does not disturb the field; excess potential appears only where the importance attached to the assessment is excessive."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDistortionAmplifiesPotential a pm:Conceptualizing ;
    rdfs:label "Distorting assessment amplifies the potential"@en, "Verzerrende Bewertung verstärkt das Potential"@de ;
    skos:definition "The potential grows if a highly valued assessment also strongly distorts reality (objects of worship, hatred, fear are over-endowed with qualities); thought energy tries to produce a quality where it is absent. The error by itself plays no role; only personal importance lets one's energy flow into it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingTwoDirectionsOfBias a pm:Systematizing ;
    rdfs:label "Two directions of assessment bias"@en, "Zwei Richtungen der Bewertungsverzerrung"@de ;
    skos:definition "The author classifies distorted assessment into over-attribution of positive qualities and over-attribution of negative qualities."@en ;
    pm:compiledBy "Vadim Zeland" ;
    dcterms:date "2004"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingResultTurnsToOpposite a pm:Conceptualizing ;
    rdfs:label "Balancing forces turn the result into its opposite"@en, "Ausgleichskräfte kehren das Ergebnis ins Gegenteil"@de ;
    skos:definition "When balancing forces remove excess potential, the outcome often reverses the original intention, which feels like an inexplicable dark force or \"sod's law\"; this is one reason people receive what they wished to avoid."@en ;
    skos:note "Condition of failure: When balancing forces remove excess potential, the outcome often reverses the original intention, which feels like an inexplicable dark force or \"sod's law\"; this is one reason people receive what they wished to avoid."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingTotalDevotionToWork a pm:Conceptualizing ;
    rdfs:label "Total devotion to work produces the opposite result"@en, "Völlige Hingabe an die Arbeit ergibt das Gegenteil"@de ;
    skos:definition "Putting work on one pan of the scales and everything else on the other destroys balance; balancing forces may bring illness, depression or chronic fatigue, plans to be more productive collapse, and someone else achieves more with less effort; the more disproportionately important work becomes, the more problems arise."@en ;
    skos:note "Condition of failure: Putting work on one pan of the scales and everything else on the other destroys balance; balancing forces may bring illness, depression or chronic fatigue, plans to be more productive collapse, and someone else achieves more with less effort; the more disproportionately important work becomes, the more problems arise."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingEffortBeyondMeasure a pm:Cautioning ;
    rdfs:label "Effort beyond measure"@en, "Anstrengung über das Maß"@de ;
    skos:definition "A little extra effort does no harm, but any effort beyond good measure is said to lead inevitably to negative consequences; if constantly exhausted, slow down or even change jobs."@en ;
    pm:cautionsAbout pmc:TranserfingTotalDevotionToWork ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFewerProblems a pm:Conceptualizing ;
    rdfs:label "Far fewer problems"@en, "Deutlich weniger Probleme"@de ;
    skos:definition "A significantly reduced number of problems in one's affairs."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLoweringExpectationsYieldsFewerProblems a pm:Yielding ;
    rdfs:label "Lowered expectations yield fewer problems"@en, "Gesenkte Erwartungen ergeben weniger Probleme"@de ;
    skos:definition "The number of problems drops significantly when expectations are lowered and attachment relaxed."@en ;
    pm:byPractice pmp:TranserfingLoweringExpectations ;
    pm:yieldsCapacity pmc:TranserfingFewerProblems ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingLoweringExpectations a pm:Practicing ;
    rdfs:label "Lowering expectations and relaxing attachment"@en, "Erwartungen senken, Bindung lockern"@de ;
    skos:definition "Consciously lower your expectations and loosen your attachment to what you consider important (e.g. one's job)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingDetachedWork a pm:Practicing ;
    rdfs:label "Re-evaluating one's relation to work: give head and hands, not heart"@en, "Verhältnis zur Arbeit neu bewerten: Kopf und Hände geben, nicht das Herz"@de ;
    skos:definition "Consciously reassess your relation to work; keep free time for what you enjoy; on arriving at work, detach; give your head and hands but not your heart, since one was not born merely to labour for a pendulum."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingWorkEfficiency a pm:Conceptualizing ;
    rdfs:label "Increased efficiency at work"@en, "Gesteigerte Wirksamkeit bei der Arbeit"@de ;
    skos:definition "Noticeably higher efficiency at work once one stops creating excess potential and is free of destructive pendulums."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingEfficiencyRises a pm:Conceptualizing ;
    rdfs:label "Noticeable rise in work efficiency"@en, "Spürbarer Anstieg der Arbeitswirksamkeit"@de ;
    skos:definition "Announced sign that detachment works: efficiency at work rises noticeably."@en ;
    skos:note "Sign of success announced in advance: Announced sign that detachment works: efficiency at work rises noticeably; announced for pmp:TranserfingDetachedWork."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDetachedWorkYieldsWorkEfficiency a pm:Yielding ;
    rdfs:label "Detached work yields increased efficiency"@en, "Losgelöstes Arbeiten ergibt höhere Wirksamkeit"@de ;
    skos:definition "Efficiency is said to rise noticeably once excess potential is no longer created around work."@en ;
    pm:byPractice pmp:TranserfingDetachedWork ;
    pm:yieldsCapacity pmc:TranserfingWorkEfficiency ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingDetachmentWithIntegrity a pm:Practicing ;
    rdfs:label "Detachment matched with integrity"@en, "Losgelöstheit verbunden mit Gewissenhaftigkeit"@de ;
    skos:definition "While detaching, fulfil every responsibility attentively and impeccably, avoid even small slips, act with a cold mind and without creating excess potential, so no one can reproach you; this applies at home and among friends too."@en ;
    skos:note "The chapter summary calls detached work for others renting oneself out, with the inner Guardian keeping one impeccable; that practice is pmp:TranserfingRentYourselfOut (part 1)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDetachmentNotCarelessness a pm:Cautioning ;
    rdfs:label "Detachment is not carelessness; zealous colleagues watch for slips"@en, "Losgelöstheit ist keine Nachlässigkeit; eifrige Kollegen lauern auf Fehler"@de ;
    skos:definition "Detachment must not become sloppiness. Those still immersed in their work subconsciously sense your detachment and instinctively try to trip you up; any trivial slip (lateness, forgetting something) then becomes an accusation of slacking that would otherwise go unnoticed."@en ;
    pm:cautionsAbout pmp:TranserfingDetachedWork ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingProtectionFromEntanglement a pm:Conceptualizing ;
    rdfs:label "Protection from getting caught up in unpleasant situations"@en, "Schutz davor, in unangenehme Lagen gezogen zu werden"@de ;
    skos:definition "Being shielded from unpleasant situations while emotionally detached."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDetachmentWithIntegrityYieldsProtectionFromEntanglement a pm:Yielding ;
    rdfs:label "Detachment with integrity yields protection"@en, "Losgelöstheit mit Gewissenhaftigkeit ergibt Schutz"@de ;
    skos:definition "Acting coolly and impeccably is said to shield one from getting caught up in unpleasant situations."@en ;
    pm:byPractice pmp:TranserfingDetachmentWithIntegrity ;
    pm:yieldsCapacity pmc:TranserfingProtectionFromEntanglement ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingInnerGuardian a pm:Naming ;
    rdfs:label "The Guardian (inner witness)"@en, "Der Wächter (innerer Zeuge)"@de ;
    skos:definition "The part of oneself that remains in the background watching what one does and how; it enables one to act with integrity while not throwing oneself headlong into the race. The author says it is not a split personality and promises to return to it."@en ;
    pm:nameForm "Guardian; inner witness" ;
    pm:nameRole "observing part of the self, not a separate being" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGuardianBeforeIntegrity a pm:Presupposing ;
    rdfs:label "Guardian before detachment with integrity"@en, "Wächter vor Losgelöstheit mit Gewissenhaftigkeit"@de ;
    skos:definition "The inner Guardian is what makes acting with integrity while detached possible."@en ;
    pm:dependentStep pmp:TranserfingDetachmentWithIntegrity ;
    pm:priorStep pmc:TranserfingInnerGuardian ;
    pm:prerequisiteStrength pm:presentationOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingImmersionOnlyForOwnGoal a pm:Cautioning ;
    rdfs:label "Total immersion justified only for the personal goal"@en, "Völliges Aufgehen nur beim eigenen Ziel gerechtfertigt"@de ;
    skos:definition "Full immersion in work is justified from the standpoint of balance only if the work is connected with one's personal goal; then it nourishes energy and can be the tunnel to success. The same is said of study."@en ;
    pm:cautionsAbout pmp:TranserfingDetachedWork ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGoalAsTunnel a pm:Conceptualizing ;
    rdfs:label "Personal goal as tunnel to success"@en, "Persönliches Ziel als Tunnel zum Erfolg"@de ;
    skos:definition "Work that coincides with one's personal goal nourishes energy with joy, inspiration and fulfilment and can serve as the tunnel leading to success; the personal goal is announced as a later theme."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Excess Potential'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. IV Balance, section 'Resentment and Judgement'
#

pmc:TranserfingFightingOwnWeaknesses a pm:Conceptualizing ;
    rdfs:label "Fighting or hiding one's weaknesses backfires"@en, "Kampf gegen oder Verbergen von Schwächen schlägt zurück"@de ;
    skos:definition "Intense focus on one's own shortcomings creates excess potential; most people then battle their weak points and the position turns against them; trying to hide a weakness produces the opposite effect (a shy person appears stiff or overly cheeky)."@en ;
    skos:note "Condition of failure: Intense focus on one's own shortcomings creates excess potential; most people then battle their weak points and the position turns against them; trying to hide a weakness produces the opposite effect (a shy person appears stiff or overly cheeky)."@en ;
    skos:note "Pass B and the text add that the balancing forces against self-resentment can act along either of two routes, developing new qualities or battling the original weakness, people leaning to one or the other by nature; most choose the battle."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingHeartAgainstMind a pm:Conceptualizing ;
    rdfs:label "Self-dissatisfaction as motivation vs. self-punishment"@en, "Selbstunzufriedenheit als Antrieb vs. Selbstbestrafung"@de ;
    skos:definition "Dissatisfaction that merely motivates self-improvement does not disturb balance, since the inner shift happens through positive action. Upsetting, beating up or punishing oneself sets heart and mind against each other destructively; the heart (soul) is said to be self-sufficient and perfect, and acquired shortcomings belong to the mind, not the soul."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingHeartMindConflict a pm:Cautioning ;
    rdfs:label "Conflict between heart and mind undermines"@en, "Konflikt zwischen Herz und Verstand untergräbt"@de ;
    skos:definition "Strife between heart and mind is called deeply undermining: where reason rules and the soul withdraws, life may turn chaotic, and one may end up needing a psychotherapist."@en ;
    pm:cautionsAbout pmc:TranserfingHeartAgainstMind ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingEndingWarWithSelf a pm:Practicing ;
    rdfs:label "Ending the war with oneself"@en, "Den Krieg mit sich selbst beenden"@de ;
    skos:definition "Let go and forgive yourself your perceived imperfections; even without yet loving yourself, stop feeding the internal war of self-reproach and take yourself as you are. Keep striving toward the qualities you admire, but drop the fight against your flaws; lay down the burden and be yourself."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingHeartAsAlly a pm:Conceptualizing ;
    rdfs:label "Heart as the mind's ally"@en, "Das Herz als Verbündeter des Verstandes"@de ;
    skos:definition "A state in which heart and mind no longer fight, so that the heart becomes a powerful ally of the mind."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingSelfAcceptanceBeforeAlliance a pm:Presupposing ;
    rdfs:label "Self-acceptance before alliance of heart and mind"@en, "Selbstannahme vor dem Bündnis von Herz und Verstand"@de ;
    skos:definition "Only after one stops the inner battle and accepts oneself can the heart become the mind's ally."@en ;
    pm:dependentStep pmc:TranserfingHeartAsAlly ;
    pm:priorStep pmp:TranserfingEndingWarWithSelf ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "The heart-mind conflict persists, undermining one and possibly making life chaotic." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingEndingWarWithSelfYieldsFreedEnergy a pm:Yielding ;
    rdfs:label "Ending self-war yields freed energy"@en, "Ende des Selbstkriegs ergibt freie Energie"@de ;
    skos:definition "When one stops battling oneself, energy is said to be freed for self-development and life to become easier and simpler."@en ;
    pm:byPractice pmp:TranserfingEndingWarWithSelf ;
    pm:yieldsCapacity pmc:TranserfingFreedEnergy ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFreedEnergy a pm:Conceptualizing ;
    rdfs:label "Freed energy for self-development"@en, "Freigewordene Energie für Selbstentwicklung"@de ;
    skos:definition "Energy formerly spent fighting oneself or sustaining excess potential becomes available for developing worthier qualities; life becomes noticeably easier, and the new energy corresponds to lines where positive traits outweigh weaknesses."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDwellingOnFlaws a pm:Conceptualizing ;
    rdfs:label "Dwelling on physical shortcomings blocks the line with a fit body"@en, "Grübeln über körperliche Mängel blockiert die Linie mit gutem Körper"@de ;
    skos:definition "If one's thoughts all circle around one's physical flaws, one cannot pass onto a line where the body is fit; one gets what one decisively does not want."@en ;
    skos:note "Condition of failure: If one's thoughts all circle around one's physical flaws, one cannot pass onto a line where the body is fit; one gets what one decisively does not want; it defeats pmc:TranserfingBetterLifeCircumstances."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingViciousCircleOfDissatisfaction a pm:Conceptualizing ;
    rdfs:label "Dissatisfaction as a vibration and vicious circle"@en, "Unzufriedenheit als Schwingung und Teufelskreis"@de ;
    skos:definition "Dissatisfaction with oneself sets one against one's soul, with the world against many pendulums. Its vibration matches lines where the disliked thing is ever more present, which deepens dissatisfaction until one reaches a line of old age, illness and shared grumbling about the good old days."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingWallowingGeneration a pm:Conceptualizing ;
    rdfs:label "Life worsens only for those who wallow"@en, "Das Leben wird nur für die schlechter, die sich suhlen"@de ;
    skos:definition "Each generation believes life used to be better, but the author claims it has worsened only for those within a generation who wallow in discontent; otherwise humanity would end in hell."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingBesiegedComplainer a pm:Conceptualizing ;
    rdfs:label "Non-acceptance draws balancing forces that cut one's influence"@en, "Nichtannahme ruft Ausgleichskräfte, die den Einfluss beschneiden"@de ;
    skos:definition "Non-acceptance produces excess potential whether or not the complaint is justified. Rather than improving matters, balancing forces besiege the complainer so that their complaints weigh as little as possible, shrinking the person's impact on the world through status, work, income, home, family or health (as with leaders who voiced displeasure at everything and were removed or killed)."@en ;
    skos:note "Condition of failure: Non-acceptance produces excess potential whether or not the complaint is justified. Rather than improving matters, balancing forces besiege the complainer so that their complaints weigh as little as possible, shrinking the person's impact on the world through status, work, income, home, family or health (as with leaders who voiced displeasure at everything and were removed or killed)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFoolishRapture a pm:Cautioning ;
    rdfs:label "Joy turned into foolish rapture"@en, "Freude, die in törichte Verzückung kippt"@de ;
    skos:definition "The protection of joy fails if joyfulness degenerates into silly rapture or naive exaltation, which balancing forces would then counter."@en ;
    pm:cautionsAbout pmp:TranserfingHabitOfPleasure ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingJoyProvokesNoForces a pm:Conceptualizing ;
    rdfs:label "Joy does not provoke balancing forces"@en, "Freude ruft keine Ausgleichskräfte hervor"@de ;
    skos:definition "A joyful person radiates creative energy that shifts them onto positive lines and creates no destructive potential. Since various philosophies and religions call love the creator of the world, and balancing forces derive from that creative force, they are said to be unable to turn against it; they merely keep order."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingHabitOfPleasure a pm:Practicing ;
    rdfs:label "Substituting the habit of displeasure with the habit of pleasure"@en, "Gewohnheit des Missfallens durch Gewohnheit der Freude ersetzen"@de ;
    skos:definition "Set yourself the task of finding the positive side of every negative situation; treat it as a game and play it consistently until taking pleasure in small details replaces the habit of displeasure at small things. When you lapse, do not be disappointed; keep recalling the intention you started with."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingSolomonsRing a pm:Practicing ;
    rdfs:label "Solomon's ring: \"this too shall pass\""@en, "Salomos Ring: „Auch dies geht vorüber“"@de ;
    skos:definition "When something terrible happens that cannot naturally be seen positively, do as King Solomon is said to have done: he wore a ring with a hidden inscription saying that this too would pass, and turned it to read it whenever misfortune or a hard problem came."@en ;
    skos:note "Legend reported as an example; the practice is recommended to the reader."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingHabitOfPleasureYieldsPositiveFlow a pm:Yielding ;
    rdfs:label "Habit of seeing the positive yields the positive flow"@en, "Gewohnheit des Positivsehens ergibt den positiven Strom"@de ;
    skos:definition "Once looking for the positive has become habitual, one is said to generate positive energy that builds into a strong current carrying one to positive lines."@en ;
    pm:byPractice pmp:TranserfingHabitOfPleasure ;
    pm:yieldsCapacity pmc:TranserfingPositiveFlow ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingPositiveFlow a pm:Conceptualizing ;
    rdfs:label "Powerful flow of positive energy toward positive lines"@en, "Starker Strom positiver Energie zu positiven Linien"@de ;
    skos:definition "Generating positive energy that builds into a strong current carrying one onto positive life lines."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingHabitTakesRoot a pm:Conceptualizing ;
    rdfs:label "Less effort needed, the old habit forgotten"@en, "Weniger Mühe, die alte Gewohnheit vergessen"@de ;
    skos:definition "Announced sign of progress: from time to time one notices that the substitution takes less conscious effort, and eventually one forgets ever having had the old habit."@en ;
    skos:note "Sign of success announced in advance: Announced sign of progress: from time to time one notices that the substitution takes less conscious effort, and eventually one forgets ever having had the old habit; announced for pmp:TranserfingHabitOfPleasure."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRelapseOnWeakening a pm:Cautioning ;
    rdfs:label "Relapse when one weakens"@en, "Rückfall bei Schwäche"@de ;
    skos:definition "As soon as one weakens, a pendulum finds a reason to upset one and one notices having given it energy again; the reader is told not to be disappointed."@en ;
    pm:cautionsAbout pmp:TranserfingHabitOfPleasure ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingHabitOfPleasureYieldsProtectionFromPendulums a pm:Yielding ;
    rdfs:label "Persistent substitution yields release from pendulums"@en, "Beharrliche Ersetzung ergibt Freiheit von Pendeln"@de ;
    skos:definition "If one's intention is strong and one keeps recalling it while practising the substitution, destructive pendulums are said to leave one alone eventually."@en ;
    skos:note "Condition: strong intention, kept in mind by reminding oneself."@en ;
    pm:byPractice pmp:TranserfingHabitOfPleasure ;
    pm:yieldsCapacity pmc:TranserfingProtectionFromPendulums ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGuestNotJudge a pm:Cautioning ;
    rdfs:label "Do not judge or fight pendulums: be a guest"@en, "Pendel nicht richten oder bekämpfen: Gast sein"@de ;
    skos:definition "Everyone is only a guest here, with no right to judge what they did not create; fighting a destructive pendulum that causes resentment only harms oneself. One need not be an obedient sheep, but should not openly confront the surrounding world either."@en ;
    pm:cautionsAbout pmc:TranserfingMayatnik ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingRefusingPendulumFights a pm:Practicing ;
    rdfs:label "Self-aware refusal of pendulum fights"@en, "Bewusste Verweigerung von Pendelkämpfen"@de ;
    skos:definition "When a pendulum clashes with you directly, use the means of defeating it or stopping its swing; when a pendulum tries to drag you into battle against another, stay self-aware and ask whether this would benefit you; rather than voicing discontent, quietly walk away to another \"exhibition\"."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNoAlternativeBelief a pm:Conceptualizing ;
    rdfs:label "\"There is no alternative\" as a pendulum-instilled belief"@en, "„Es gibt keine Alternative“ als von Pendeln eingepflanzter Glaube"@de ;
    skos:definition "The idea that no other option exists is said to be a misconception instilled by pendulums; the author states that the whole book is dedicated to freeing the reader from this limiting belief."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Resentment and Judgement'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. IV Balance, section 'Dependent Relationships'
#

pmc:TranserfingIdealisation a pm:Conceptualizing ;
    rdfs:label "Idealization as the reverse of dissatisfaction"@en, "Idealisierung als Kehrseite der Unzufriedenheit"@de ;
    skos:definition "Idealizing means overestimating, putting on a pedestal, worshipping, making an idol; seeing what is not there creates excess potential, just as dissatisfaction does from the other side."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Dependent Relationships'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingUnconditionalLove a pm:Conceptualizing ;
    rdfs:label "Unconditional love: dispassionate admiration without possession"@en, "Bedingungslose Liebe: leidenschaftslose Bewunderung ohne Besitz"@de ;
    skos:definition "The love that is said to create and rule the world is at bottom without passion or emotion: admiration without worship or wish to possess, creating no dependency between lover and beloved (enjoying a flowering valley). Picking the flowers, making perfume of them or worshipping them turns love into idealization and dependency."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Dependent Relationships'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDebunkingMyths a pm:Conceptualizing ;
    rdfs:label "Balancing forces \"debunk myths\""@en, "Ausgleichskräfte „entzaubern Mythen“"@de ;
    skos:definition "Love yields positive energy carrying one to corresponding lines; idealization creates excess potential which balancing forces always remove, in effect debunking the myth more or less strongly depending on object and degree."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Dependent Relationships'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingConditionalRelationships a pm:Conceptualizing ;
    rdfs:label "Dependent relationships as conditional statements"@en, "Abhängige Beziehungen als Bedingungssätze"@de ;
    skos:definition "When love turns into dependency, excess potential is inevitable because the wish to possess creates an energetic pressure drop. Dependent relationships are defined by conditions of the form \"if you do this, I will do that\"."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Dependent Relationships'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingComparisonDestroysBalance a pm:Conceptualizing ;
    rdfs:label "Comparison and contrast destroy balance"@en, "Vergleich und Gegenüberstellung zerstören das Gleichgewicht"@de ;
    skos:definition "Whenever one thing is set against or measured against another (e.g. national pride), balance is broken. Balancing forces act first against whoever created the potential, either pulling the parties apart or uniting them, which leads to clash or agreement."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Dependent Relationships'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingConflictFromContrast a pm:Conceptualizing ;
    rdfs:label "Conflict grows from contrast; pendulums push to confrontation"@en, "Konflikt wächst aus Gegensatz; Pendel treiben zur Konfrontation"@de ;
    skos:definition "All conflicts rest on contrast: from \"they are different\" follow demands to take, give, change or fight, beginning as one person's discomfort and ending in war and revolution. Balancing forces could resolve contradictions by acceptance too, but because pendulums feed on aggression they mostly nudge toward confrontation."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Dependent Relationships'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. IV Balance, section 'Idealization and Overvaluation'
#

pmc:TranserfingOvervaluation a pm:Conceptualizing ;
    rdfs:label "Overvaluation as projection of absent qualities"@en, "Überbewertung als Projektion fehlender Eigenschaften"@de ;
    skos:definition "Overvaluation imagines in a person qualities they do not have; harmless as mental illusion, it is said to create excess potential energetically because potential arises wherever there is a difference in quantity or quality."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingTwoTypesOfIdealisation a pm:Systematizing ;
    rdfs:label "Two types of idealization"@en, "Zwei Arten der Idealisierung"@de ;
    skos:definition "The author distinguishes (1) ascribing to a person qualities wholly uncharacteristic of them, and (2) focusing not on a person but on rosy fantasies and airy castles as an escape from reality."@en ;
    pm:compiledBy "Vadim Zeland" ;
    dcterms:date "2004"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingIdolDebunked a pm:Conceptualizing ;
    rdfs:label "The idol on a pedestal is sooner or later debunked"@en, "Das Idol auf dem Sockel wird früher oder später entzaubert"@de ;
    skos:definition "Whoever makes an idol of another and puts them on a pedestal will sooner or later face the myth being exploded and disillusionment (the romantic youth whose angelic beloved turns out down-to-earth)."@en ;
    skos:note "Condition of failure: Whoever makes an idol of another and puts them on a pedestal will sooner or later face the myth being exploded and disillusionment (the romantic youth whose angelic beloved turns out down-to-earth)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingKarlMay a pm:Conceptualizing ;
    rdfs:label "Karl May: fans' idol debunked"@en, "Karl May: das Idol der Fans entzaubert"@de ;
    skos:definition "Reported case: readers identified the novelist Karl May with his first-person hero Old Shatterhand; when it emerged that he had never been to America and wrote some books in prison, admirers turned into detractors. The author places the blame on the readers' own idol-making and the condition they attached."@en ;
    skos:note "Condition of failure: Reported case: readers identified the novelist Karl May with his first-person hero Old Shatterhand; when it emerged that he had never been to America and wrote some books in prison, admirers turned into detractors. The author places the blame on the readers' own idol-making and the condition they attached."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingCastlesInTheAir a pm:Conceptualizing ;
    rdfs:label "Castles in the air are torn down"@en, "Luftschlösser werden eingerissen"@de ;
    skos:definition "The dreamer escaping into fantasies creates excess potential; balancing forces make them face harsh reality. Even a utopia that gathers hundreds and becomes a pendulum is flawed by its biased potential and will sooner or later be stopped."@en ;
    skos:note "Condition of failure: The dreamer escaping into fantasies creates excess potential; balancing forces make them face harsh reality. Even a utopia that gathers hundreds and becomes a pendulum is flawed by its biased potential and will sooner or later be stopped."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingIdealPartnerImage a pm:Conceptualizing ;
    rdfs:label "The ideal partner image attracts its opposite"@en, "Das Bild des idealen Partners zieht das Gegenteil an"@de ;
    skos:definition "The more a woman insists that her future spouse must match a particular type, the stronger the potential, which only someone with the opposite qualities can neutralize. Likewise fixating on hating drunkenness or rudeness may lead into partnership with a drinker or an abusive man, since thought energy vibrates in tune with non-acceptance."@en ;
    skos:note "Condition of failure: The more a woman insists that her future spouse must match a particular type, the stronger the potential, which only someone with the opposite qualities can neutralize. Likewise fixating on hating drunkenness or rudeness may lead into partnership with a drinker or an abusive man, since thought energy vibrates in tune with non-acceptance."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingOppositesUnited a pm:Conceptualizing ;
    rdfs:label "Balancing forces unite opposites"@en, "Ausgleichskräfte vereinen Gegensätze"@de ;
    skos:definition "Life often brings together seemingly incompatible people because balancing forces pair those with opposite potentials to neutralize the imbalance."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingOvershapingChildren a pm:Conceptualizing ;
    rdfs:label "Overshaping children produces the opposite"@en, "Überformung von Kindern bewirkt das Gegenteil"@de ;
    skos:definition "Children, being more energy-sensitive and natural, show balancing forces clearly: over-praised children turn naughty; indulgent adults are despised; the forced goody-goody joins a gang; the would-be prodigy loses interest in study; the over-scheduled child grows dull."@en ;
    skos:note "Condition of failure: Children, being more energy-sensitive and natural, show balancing forces clearly: over-praised children turn naughty; indulgent adults are despised; the forced goody-goody joins a gang; the would-be prodigy loses interest in study; the over-scheduled child grows dull."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingTreatingAsGuests a pm:Practicing ;
    rdfs:label "Treating children (and others) as guests"@en, "Kinder (und andere) wie Gäste behandeln"@de ;
    skos:definition "Give the child attention, respect and free choice while avoiding excess potential, yet do not let them rule or torment you; base the relation on the recognition that you yourself are merely a guest here; accept how the world plays without going to extremes."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingTreatingAsGuestsYieldsFreeChoiceFromAll a pm:Yielding ;
    rdfs:label "Guest stance yields free choice"@en, "Gasthaltung ergibt freie Wahl"@de ;
    skos:definition "Accepting how the world plays, without extremes, is said to leave one free to pick from everything there is."@en ;
    pm:byPractice pmp:TranserfingTreatingAsGuests ;
    pm:yieldsCapacity pmc:TranserfingFreeChoiceFromAll ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFreeChoiceFromAll a pm:Conceptualizing ;
    rdfs:label "Free choice from all that exists"@en, "Freie Wahl aus allem, was existiert"@de ;
    skos:definition "Being free to choose from everything the world contains."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingScaleOfDistortion a pm:Conceptualizing ;
    rdfs:label "Scale of distortion with unconditional love at zero"@en, "Verzerrungsskala mit bedingungsloser Liebe als Null"@de ;
    skos:definition "A healthy, balanced relationship produces no excess potential; potential arises when an assessment noticeably deviates from the nominal value. On the scale of distortion, unconditional love is zero; it is extremely rare, since love is usually mixed with possession, dependence and overvaluation."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingExtremesOfPossession a pm:Systematizing ;
    rdfs:label "Two extremes of possessiveness in love"@en, "Zwei Extreme der Besitzgier in der Liebe"@de ;
    skos:definition "Some wish to possess the beloved is natural; the author classes two extremes: (1) desire to possess someone only loosely connected to one (unrequited love), (2) claimed right of ownership, i.e. jealousy."@en ;
    pm:compiledBy "Vadim Zeland" ;
    dcterms:date "2004"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingUnrequitedLove a pm:Conceptualizing ;
    rdfs:label "Unrequited love: forces may push the beloved away"@en, "Unerwiderte Liebe: Kräfte können den Geliebten entfernen"@de ;
    skos:definition "The potential of longing does not pull the beloved closer like air flowing to low pressure; balancing forces are indifferent to method and may move the beloved further away, breaking one's heart. Dramatising each disappointment pulls one to lines where requited love is rare; the stronger the desire, the stronger the forces' action."@en ;
    skos:note "Condition of failure: The potential of longing does not pull the beloved closer like air flowing to low pressure; balancing forces are indifferent to method and may move the beloved further away, breaking one's heart. Dramatising each disappointment pulls one to lines where requited love is rare; the stronger the desire, the stronger the forces' action."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingObsessionWithReciprocity a pm:Conceptualizing ;
    rdfs:label "Obsession with reciprocity while nothing goes right"@en, "Fixierung auf Erwiderung, während nichts gelingt"@de ;
    skos:definition "Diagnostic sign: if one is fixated on one's feelings being returned and nothing goes right, the forces are working against one and the tactic must change; the direction of the forces is said to be discernible at the very outset."@en ;
    skos:note "Condition of failure: Diagnostic sign: if one is fixated on one's feelings being returned and nothing goes right, the forces are working against one and the tactic must change; the direction of the forces is said to be discernible at the very outset; it defeats pmc:TranserfingRequitedLove."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingLovingWithoutExpectation a pm:Practicing ;
    rdfs:label "Loving without expectation of return"@en, "Lieben ohne Erwartung der Erwiderung"@de ;
    skos:definition "To have love returned, love simply, without thinking about whether you are loved and without thought of possession or reward."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingSnowballing a pm:Conceptualizing ;
    rdfs:label "Snowballing beyond change"@en, "Lawine bis zur Unabänderlichkeit"@de ;
    skos:definition "If one does not change tactics, the situation may snowball until hardly anything can be altered."@en ;
    skos:note "Condition of failure: If one does not change tactics, the situation may snowball until hardly anything can be altered; it defeats pmc:TranserfingRequitedLove."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLovingWithoutExpectationYieldsRequitedLove a pm:Yielding ;
    rdfs:label "Loving without expectation yields requited love"@en, "Lieben ohne Erwartung ergibt erwiderte Liebe"@de ;
    skos:definition "Loving without expectation avoids excess potential (and so the even chance that forces work against one), frees one from dramatic thoughts pulling to lines of unrequited love, and makes one's energy match lines where love is returned; the forces can then be made to work for one."@en ;
    pm:byPractice pmp:TranserfingLovingWithoutExpectation ;
    pm:yieldsCapacity pmc:TranserfingRequitedLove ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRequitedLove a pm:Conceptualizing ;
    rdfs:label "Requited love and attracting people"@en, "Erwiderte Liebe und Anziehung von Menschen"@de ;
    skos:definition "Greatly increased chances of closeness with the beloved, and automatically drawing people to oneself through the rare quality of unconditional love."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingJealousy a pm:Conceptualizing ;
    rdfs:label "Jealousy digs the grave of love"@en, "Eifersucht gräbt der Liebe das Grab"@de ;
    skos:definition "With jealousy balancing forces either bring the couple closer or destroy what gave rise to the jealousy, the love itself; the fiercer it is, the deeper the pit it digs for that love."@en ;
    skos:note "Condition of failure: With jealousy balancing forces either bring the couple closer or destroy what gave rise to the jealousy, the love itself; the fiercer it is, the deeper the pit it digs for that love."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLoversIgnoreAdvice a pm:Cautioning ;
    rdfs:label "Lovers will likely ignore this advice"@en, "Verliebte werden diesen Rat wohl übergehen"@de ;
    skos:definition "The author warns about his own recommendations: a person in love loses the ability to reason, so the advice will probably fall by the wayside; he says he will not upset himself over it, as he resists needing the reader's recognition."@en ;
    pm:cautionsAbout pmp:TranserfingLovingWithoutExpectation ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Idealization and Overvaluation'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. IV Balance, section 'Contempt and Vanity'
#

pmc:TranserfingNoGoodOrBadPeople a pm:Conceptualizing ;
    rdfs:label "No good or bad people energetically"@en, "Energetisch keine guten oder schlechten Menschen"@de ;
    skos:definition "Judging others, especially with contempt, strongly breaks balance. Energetically there are only those who keep nature's laws and those who disturb its status quo; such disturbers are said always to yield in the end to balancing forces."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Contempt and Vanity'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingJudgementAfterInjury a pm:Conceptualizing ;
    rdfs:label "Judgement after personal injury as a tool of balance"@en, "Urteil nach persönlicher Verletzung als Werkzeug des Ausgleichs"@de ;
    skos:definition "If someone has harmed you personally, they have likely broken balance, so your judgement is more a tool of balancing forces than unhealthy potential; speak your mind and take reasonable measures. If they did nothing to you, it is not your place to accuse."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Contempt and Vanity'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingSlapForJudging a pm:Conceptualizing ;
    rdfs:label "Judgement earns a slap"@en, "Urteilen bringt eine Ohrfeige ein"@de ;
    skos:definition "Judging others creates excess potential because one implicitly casts oneself as good to the degree the other is bad; balancing forces respond with a \"slap\" ranging from barely noticeable to being thrown onto one of the worst imaginable life lines."@en ;
    skos:note "Condition of failure: Judging others creates excess potential because one implicitly casts oneself as good to the degree the other is bad; balancing forces respond with a \"slap\" ranging from barely noticeable to being thrown onto one of the worst imaginable life lines."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Contempt and Vanity'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNeverScorn a pm:Cautioning ;
    rdfs:label "Never scorn anyone"@en, "Niemals jemanden verachten"@de ;
    skos:definition "Contempt is called the most perilous kind of judging because balancing forces most simply restore harmony by putting you in the scorned person's shoes: contempt for tramps may cost you money and home, for the disabled an accident, for addicts the same fate; judging someone's dress may drop you a rung below them."@en ;
    pm:cautionsAbout pmc:TranserfingSlapForJudging ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Contempt and Vanity'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNeverJudgeColleagues a pm:Cautioning ;
    rdfs:label "Never judge colleagues"@en, "Niemals Kollegen verurteilen"@de ;
    skos:definition "Judging work colleagues leads at best to making the same mistake oneself and at worst to a conflict ending in losing one's job even when blameless."@en ;
    pm:cautionsAbout pmc:TranserfingSlapForJudging ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Contempt and Vanity'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingSelfLoveAndVanity a pm:Conceptualizing ;
    rdfs:label "Healthy self-love vs. vanity"@en, "Gesunde Selbstliebe vs. Eitelkeit"@de ;
    skos:definition "Pride in achievement and general self-love are healthy; balance breaks only when inflated self-worth is set against a superior attitude to others' weaknesses, turning self-esteem into arrogance and vanity, which again earns a slap."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Contempt and Vanity'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingVicesOfMan a pm:Conceptualizing ;
    rdfs:label "Contempt and vanity as human vices; animals free of them"@en, "Verachtung und Eitelkeit als menschliche Laster; Tiere frei davon"@de ;
    skos:definition "Animals fulfil nature's will without contempt or vanity (the predator does not hate its prey) and do not know their own grandeur; human consciousness brings advantages but also guilt, inferiority, vanity and contempt, on which they build relationships full of excess potential."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Contempt and Vanity'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. IV Balance, section 'Superiority and Inferiority'
#

pmc:TranserfingSuperiorityAsDependence a pm:Conceptualizing ;
    rdfs:label "Superiority and inferiority as dependent relationships"@en, "Überlegenheit und Unterlegenheit als abhängige Beziehungen"@de ;
    skos:definition "Feelings of superiority or inferiority indicate dependent relationships; comparing one's qualities with others' inevitably creates excess potential, whether superiority is displayed or only secretly enjoyed."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingComparisonVersusDevelopment a pm:Conceptualizing ;
    rdfs:label "Self-assertion by comparison vs. self-development"@en, "Selbstbehauptung durch Vergleich vs. Selbstentwicklung"@de ;
    skos:definition "Proving one's importance to the world is as futile as a fly beating against glass beside an open window and wastes energy on potential; developing oneself creates real virtues without potential. The direction of intention decides: aiming to develop qualities propels one, aiming to display one's regalia spins wheels in a rut."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDisplayedRegalia a pm:Conceptualizing ;
    rdfs:label "Displayed regalia brings a humbling incident"@en, "Zur Schau gestellte Insignien bringen einen demütigenden Vorfall"@de ;
    skos:definition "Balancing forces faced with a self-displaying \"star\" take the easier option of dimming the star, e.g. by arranging some unpleasant incident that humbles them."@en ;
    skos:note "Condition of failure: Balancing forces faced with a self-displaying \"star\" take the easier option of dimming the star, e.g. by arranging some unpleasant incident that humbles them."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingMisfortuneIsAnomaly a pm:Conceptualizing ;
    rdfs:label "Misfortune is an anomaly"@en, "Unglück ist eine Anomalie"@de ;
    skos:definition "Problems and misfortune are not a normal part of the world but an anomaly; most unpleasant moments are said to be generated by balancing forces eliminating excess potential created by oneself or one's immediate surroundings, which people unaware of the mechanism take for an unavoidable dark force."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFreedomFromMostProblems a pm:Conceptualizing ;
    rdfs:label "Elimination of most problems; freedom from balancing forces"@en, "Beseitigung der meisten Probleme; Freiheit von Ausgleichskräften"@de ;
    skos:definition "Being rid of most of the problems one usually faces and free of the action of balancing forces."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRedirectingIntentionYieldsFreedomFromMostProblems a pm:Yielding ;
    rdfs:label "Dropping excess potential yields freedom from most problems"@en, "Ablegen des Überschusspotentials ergibt Freiheit von den meisten Problemen"@de ;
    skos:definition "Relieving oneself of the effort of supporting excess potential is said to eliminate most problems."@en ;
    pm:byPractice pmp:TranserfingRedirectingIntention ;
    pm:yieldsCapacity pmc:TranserfingFreedomFromMostProblems ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingStopTheFlyBeforeFreedom a pm:Presupposing ;
    rdfs:label "Stop the fly-at-the-glass before freedom from balancing forces"@en, "Erst das Fliegen gegen die Scheibe beenden, dann Freiheit von Ausgleichskräften"@de ;
    skos:definition "To be free from the action of balancing forces one has to stop striving for self-importance."@en ;
    pm:dependentStep pmc:TranserfingFreedomFromMostProblems ;
    pm:priorStep pmp:TranserfingRedirectingIntention ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Energy goes into maintaining excess potential, which often yields the opposite of one's intention." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingRedirectingIntention a pm:Practicing ;
    rdfs:label "Redirecting intention from self-importance to development"@en, "Absicht von Selbstwichtigkeit auf Entwicklung umlenken"@de ;
    skos:definition "Stop sustaining excess potential: give up the fly's futile beating at the glass, and switch your intention from raising your own importance to cultivating the traits you admire."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNoControllingTheWorld a pm:Cautioning ;
    rdfs:label "Release the notion of controlling the world"@en, "Die Idee der Weltkontrolle loslassen"@de ;
    skos:definition "Whatever one's social position, believing one can manipulate the surrounding world guarantees that things go wrong, since attempts to change the world break balance and harm the interests of the majority."@en ;
    pm:cautionsAbout pmc:TranserfingChoosingWithoutHarm ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingChoosingWithoutHarm a pm:Conceptualizing ;
    rdfs:label "Choosing one's destiny without harming others"@en, "Das eigene Schicksal wählen, ohne anderen zu schaden"@de ;
    skos:definition "Transurfing is said to let one choose one's destiny without harming the interests of others, more effectively than forcing through obstacles; fate is in one's hands in the sense of choosing it, not changing it."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLiteralOwnDestiny a pm:Conceptualizing ;
    rdfs:label "Taking \"create your own destiny\" literally"@en, "„Schmiede dein Schicksal“ wörtlich nehmen"@de ;
    skos:definition "Many are said to have failed because they took the idea of creating one's own destiny literally, as battle; Transurfing has no place for battle."@en ;
    skos:note "Condition of failure: Many are said to have failed because they took the idea of creating one's own destiny literally, as battle; Transurfing has no place for battle."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingComplexesAsDeviation a pm:Conceptualizing ;
    rdfs:label "Potential proportional to deviation from reality; complexes"@en, "Potential proportional zur Abweichung von der Wirklichkeit; Komplexe"@de ;
    skos:definition "Self-deprecation is the other side of superiority and energetically equivalent. The size of the potential is directly proportional to how far one's evaluation differs from reality: balancing forces knock self-importance off its pedestal and force a falsely lowered self-worth up, acting crudely so that the person behaves less naturally and exposes what they want to hide."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingBattlingAComplex a pm:Cautioning ;
    rdfs:label "Battling a complex can be worse than the complex"@en, "Kampf gegen einen Komplex kann schlimmer sein als der Komplex"@de ;
    skos:definition "Hiding or fighting a complex is futile and can bring worse consequences than the complex (defiant teenagers, overly forward shy people, tense people with low self-esteem); the only remedy is to eliminate the complex, which is not easy."@en ;
    pm:cautionsAbout pmc:TranserfingComplexesAsDeviation ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAffirmationsFail a pm:Cautioning ;
    rdfs:label "Affirming that all is wonderful does not work"@en, "Bejahen, dass alles wunderbar sei, wirkt nicht"@de ;
    skos:definition "Repeatedly telling oneself everything is fine is pointless because one cannot fool oneself; the slide technique, announced for later, can help."@en ;
    pm:cautionsAbout pmc:TranserfingComplexesAsDeviation ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingDroppingImaginedScrutiny a pm:Practicing ;
    rdfs:label "Dropping the burden of imagined scrutiny"@en, "Die Last eingebildeter Beobachtung ablegen"@de ;
    skos:definition "Recognise that others do not give your shortcomings the meaning you do, since everyone is mostly occupied with themselves, and so release the burden of preoccupation with your flaws compared with others."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDroppingImaginedScrutinyYieldsFreedEnergy a pm:Yielding ;
    rdfs:label "Dropping imagined scrutiny yields freed energy"@en, "Ablegen eingebildeter Beobachtung ergibt freie Energie"@de ;
    skos:definition "The potential dissipates, balancing forces stop sharpening the situation, and the released energy can go to self-development."@en ;
    pm:byPractice pmp:TranserfingDroppingImaginedScrutiny ;
    pm:yieldsCapacity pmc:TranserfingFreedEnergy ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingCompensatingFlaws a pm:Practicing ;
    rdfs:label "Compensating flaws with other qualities"@en, "Mängel durch andere Eigenschaften ausgleichen"@de ;
    skos:definition "Instead of fighting or hiding a flaw, offset it with another quality: charm or eloquence for lack of beauty, self-confidence for physical flaws, being a good listener for poor conversational skill; the genuinely shy should guard their shyness as a jewel and stop fighting it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingCompensatingFlawsYieldsAttractiveDespiteFlaws a pm:Yielding ;
    rdfs:label "Accepting shyness yields attractiveness"@en, "Annahme der Schüchternheit ergibt Anziehung"@de ;
    skos:definition "When one stops fighting shyness it is said to stop looking like clumsiness, and people begin to find one more attractive."@en ;
    pm:byPractice pmp:TranserfingCompensatingFlaws ;
    pm:yieldsCapacity pmc:TranserfingAttractiveDespiteFlaws ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFoundMoreAttractive a pm:Conceptualizing ;
    rdfs:label "Noticing people find you more attractive"@en, "Bemerken, dass andere einen anziehender finden"@de ;
    skos:definition "Announced sign: you will notice people beginning to find you more attractive."@en ;
    skos:note "Sign of success announced in advance: Announced sign: you will notice people beginning to find you more attractive; announced for pmp:TranserfingCompensatingFlaws."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAttractiveDespiteFlaws a pm:Conceptualizing ;
    rdfs:label "Being found attractive despite flaws"@en, "Trotz Mängeln anziehend wirken"@de ;
    skos:definition "Others come to find one more attractive; shyness no longer appears clumsy but carries a hidden charm."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingImitatingTheCool a pm:Cautioning ;
    rdfs:label "Imitating the \"cool\" yields only parody"@en, "Nachahmung der „Coolen“ ergibt nur Parodie"@de ;
    skos:definition "Copying the script of those who already have \"cool\" status produces a mere parody and is another case of the fly beating against the pane; everyone has their own script."@en ;
    pm:cautionsAbout pmp:TranserfingLivingByOwnCredo ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingLivingByOwnCredo a pm:Practicing ;
    rdfs:label "Living by one's own credo"@en, "Nach dem eigenen Credo leben"@de ;
    skos:definition "Pick a personal credo and follow it, without imitating anyone, seeking favour or proving anything."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLivingByOwnCredoYieldsNaturalLeadership a pm:Yielding ;
    rdfs:label "Own credo yields leadership"@en, "Eigenes Credo ergibt Führerschaft"@de ;
    skos:definition "In every group, the author says, the leader is whoever follows their own beliefs and so is free of excess potential."@en ;
    pm:byPractice pmp:TranserfingLivingByOwnCredo ;
    pm:yieldsCapacity pmc:TranserfingNaturalLeadership ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNaturalLeadership a pm:Conceptualizing ;
    rdfs:label "Natural leadership through freedom from excess potential"@en, "Natürliche Führerschaft durch Freiheit von Überschusspotential"@de ;
    skos:definition "Having nothing to prove: inner freedom, self-sufficiency and more energy than those around, which give the advantage of becoming leader of a group."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNoOneExempt a pm:Cautioning ;
    rdfs:label "Do not assume you are exempt"@en, "Nicht annehmen, man sei ausgenommen"@de ;
    skos:definition "The reader is warned not to deceive themselves that these dynamics do not apply to them: everyone tends to some degree to create excess potential."@en ;
    pm:cautionsAbout pmc:TranserfingIzbytochnyPotentsial ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRedirectingIntentionYieldsComplexesVanish a pm:Yielding ;
    rdfs:label "Following Transurfing principles yields loss of complexes"@en, "Befolgen der Transurfing-Prinzipien ergibt Verlust der Komplexe"@de ;
    skos:definition "If one follows the principles of Transurfing (here: redirecting intention from self-importance to development), complexes are said to vanish."@en ;
    skos:note "The text names Transurfing principles generally; linked to the nearest stated practice."@en ;
    pm:byPractice pmp:TranserfingRedirectingIntention ;
    pm:yieldsCapacity pmc:TranserfingComplexesVanish ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingComplexesVanish a pm:Conceptualizing ;
    rdfs:label "Disappearance of inferiority and superiority complexes"@en, "Verschwinden von Minderwertigkeits- und Überlegenheitskomplexen"@de ;
    skos:definition "Complexes of inferiority or superiority simply vanish from one's life."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Superiority and Inferiority'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. IV Balance, section 'Love to Have, Love to Hate'
#

pmc:TranserfingWantingPreventsGetting a pm:Conceptualizing ;
    rdfs:label "The stronger the wanting, the less the getting"@en, "Je stärker das Wollen, desto weniger das Bekommen"@de ;
    skos:definition "Wanting something so much that one stakes everything on it creates huge excess potential; balancing forces may then throw one onto a life line without any trace of the desired object (the wild boar scaring off the bird it covets)."@en ;
    skos:note "Condition of failure: Wanting something so much that one stakes everything on it creates huge excess potential; balancing forces may then throw one onto a life line without any trace of the desired object (the wild boar scaring off the bird it covets)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingThreeTypesOfDesire a pm:Systematizing ;
    rdfs:label "Three types of desire"@en, "Drei Arten des Wunsches"@de ;
    skos:definition "(1) Strong desire turning into determined intention to have and to do what is needed: fulfilled, its potential spent in action. (2) Inactive, tormenting desire: pure excess potential lingering in the field, at best wasting energy, at worst attracting unrelated problems. (3) Desire dependent on its object: the most insidious, with strong potential and equally strong balancing forces."@en ;
    pm:compiledBy "Vadim Zeland" ;
    dcterms:date "2004"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDependentDesireWhirlpool a pm:Conceptualizing ;
    rdfs:label "Dependent desire ends in an exhausting whirlpool"@en, "Abhängiger Wunsch endet in erschöpfendem Strudel"@de ;
    skos:definition "Dependent desire (\"if I get this, all will be well; if not, life is meaningless\") pulls one into a whirlpool of struggle until one is exhausted and gives the desire up, balancing forces having restored equilibrium regardless of one's suffering."@en ;
    skos:note "Condition of failure: Dependent desire (\"if I get this, all will be well; if not, life is meaningless\") pulls one into a whirlpool of struggle until one is exhausted and gives the desire up, balancing forces having restored equilibrium regardless of one's suffering."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNewspaperAttitudeYieldsTransferToDesiredLine a pm:Yielding ;
    rdfs:label "Lowered significance yields transfer to the desired line"@en, "Gesenkte Bedeutung ergibt Übergang auf die gewünschte Linie"@de ;
    skos:definition "Desire and action without importance (pure intention) are said to be all that is needed to reach the line where the object is real."@en ;
    pm:byPractice pmp:TranserfingNewspaperAttitude ;
    pm:yieldsCapacity pmc:TranserfingTransferToDesiredLine ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingTransferToDesiredLine a pm:Conceptualizing ;
    rdfs:label "Transfer to the line where the desired object is real"@en, "Übergang auf die Linie, auf der das Gewünschte wirklich ist"@de ;
    skos:definition "Moving to a life line on which the object of desire becomes part of one's reality, for which pure intention's energy is said to suffice."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingPureIntention a pm:Conceptualizing ;
    rdfs:label "Pure intention; nothing costs anything in the alternatives space"@en, "Reine Absicht; im Variantenraum ist alles umsonst"@de ;
    skos:definition "Of the three types only the first is fulfilled, because it turns into pure intention without excess potential: desire plus action without attributing importance, like going to buy a newspaper. The only price we pay is for the potential we ourselves produce; absence of importance and of dependency is the \"payment\" for fulfilment."@en ;
    skos:note "Russian term: namerenie (намерение)."@en ;
    skos:note "Intention announced as a later subject."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingValuedThingsFallThrough a pm:Conceptualizing ;
    rdfs:label "Highly valued things fall through or are taken"@en, "Hochbewertetes scheitert oder wird genommen"@de ;
    skos:definition "The higher an event is valued, the greater the chance it fails somehow; attaching huge value to what one has means balancing forces will sooner or later take it."@en ;
    skos:note "Condition of failure: The higher an event is valued, the greater the chance it fails somehow; attaching huge value to what one has means balancing forces will sooner or later take it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLowStakesBeforeGetting a pm:Presupposing ;
    rdfs:label "Lowering the stakes before getting what matters greatly"@en, "Einsatz senken, bevor man Hochbedeutsames bekommt"@de ;
    skos:definition "What is hugely important to one is very unlikely to be obtained unless the stakes are lowered first."@en ;
    pm:dependentStep pmc:TranserfingTransferToDesiredLine ;
    pm:priorStep pmp:TranserfingNewspaperAttitude ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Very little chance of actually getting it." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingWorshippedCar a pm:Conceptualizing ;
    rdfs:label "The worshipped car gets damaged"@en, "Das vergötterte Auto wird beschädigt"@de ;
    skos:definition "Cherishing and fearing for a new car creates excess potential, since its true meaning in the information field is close to nil; balancing forces soon arrange for some inept driver to damage it, or one bumps it through excess caution."@en ;
    skos:note "Condition of failure: Cherishing and fearing for a new car creates excess potential, since its true meaning in the information field is close to nil; balancing forces soon arrange for some inept driver to damage it, or one bumps it through excess caution."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingLevellingAttitude a pm:Practicing ;
    rdfs:label "Levelling one's attitude to a valued possession"@en, "Die Haltung zu einem geschätzten Besitz einebnen"@de ;
    skos:definition "Treat the prized object as the fairly ordinary thing it is; look after it properly but without idolizing it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLevellingAttitudeYieldsProtectedPossessions a pm:Yielding ;
    rdfs:label "Ordinary attitude yields protection of possessions"@en, "Gewöhnliche Haltung ergibt Schutz des Besitzes"@de ;
    skos:definition "Treating the car as ordinary is said to reduce sharply the chance of its being damaged."@en ;
    pm:byPractice pmp:TranserfingLevellingAttitude ;
    pm:yieldsCapacity pmc:TranserfingProtectedPossessions ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingProtectedPossessions a pm:Conceptualizing ;
    rdfs:label "Protection of possessions from loss or damage"@en, "Schutz des Besitzes vor Verlust oder Schaden"@de ;
    skos:definition "A sharply reduced chance that one's possessions are damaged or taken."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingOrdinaryNotCareless a pm:Cautioning ;
    rdfs:label "Ordinary does not mean careless"@en, "Gewöhnlich heißt nicht nachlässig"@de ;
    skos:definition "Treating an object as ordinary must not slide into carelessness; good care without idolization is meant."@en ;
    pm:cautionsAbout pmp:TranserfingLevellingAttitude ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingHystericalDesire a pm:Conceptualizing ;
    rdfs:label "Hysterical desire betrays hidden disbelief"@en, "Hysterisches Begehren verrät verborgenen Unglauben"@de ;
    skos:definition "The common belief that wanting badly enough brings fulfilment is rejected: dependent, psychosis-like craving means one does not deep down believe one can succeed, which causes strong interference in the transmitted thought energy; trying to convince oneself raises the potential further, and the life's work may then take a whole life."@en ;
    skos:note "Condition of failure: The common belief that wanting badly enough brings fulfilment is rejected: dependent, psychosis-like craving means one does not deep down believe one can succeed, which causes strong interference in the transmitted thought energy; trying to convince oneself raises the potential further, and the life's work may then take a whole life."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingNewspaperAttitude a pm:Practicing ;
    rdfs:label "Pursuing the aim like buying a newspaper"@en, "Das Ziel verfolgen wie den Kauf einer Zeitung"@de ;
    skos:definition "Reduce the personal significance of the aim (lower the stakes) and set about getting what you want in the matter-of-fact way you would go to the shop for a newspaper."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAvoidanceBringsIt a pm:Conceptualizing ;
    rdfs:label "What one strongly wants to avoid tends to happen"@en, "Was man unbedingt vermeiden will, tritt eher ein"@de ;
    skos:definition "Strong desire to avoid something continues dissatisfaction; stronger negative attachment means stronger potential, and since balancing forces may either keep one away or bring one into contact, the probability of meeting it rises. Thinking of the negated thing also radiates at the frequency of lines where it exists: one always gets what one loves to hate (the guest screaming he would hate to be thrown out of the embassy)."@en ;
    skos:note "Condition of failure: Strong desire to avoid something continues dissatisfaction; stronger negative attachment means stronger potential, and since balancing forces may either keep one away or bring one into contact, the probability of meeting it rises. Thinking of the negated thing also radiates at the frequency of lines where it exists: one always gets what one loves to hate (the guest screaming he would hate to be thrown out of the embassy)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingCeasingToNegate a pm:Practicing ;
    rdfs:label "Consciously ceasing to negate"@en, "Bewusst aufhören zu verneinen"@de ;
    skos:definition "Deliberately stop negating things in your surroundings so that no excess potential arises at all."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingParodyOrIgnoring a pm:Practicing ;
    rdfs:label "Stilling the pendulum by parody, defeating it by ignoring"@en, "Pendel durch Parodie anhalten, durch Ignorieren besiegen"@de ;
    skos:definition "In an irritating situation (noisy neighbours at night), halt the swing of the pendulum by deciding to view it all as a parody, or defeat it by ignoring it and showing no interest or emotion; take comfort in knowing you are free to choose and how to use that freedom."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingParodyOrIgnoringYieldsFreedomFromPendulum a pm:Yielding ;
    rdfs:label "Parody or ignoring yields defeat of the pendulum"@en, "Parodie oder Ignorieren ergibt Sieg über das Pendel"@de ;
    skos:definition "By either method the pendulum is said to be stopped or defeated without excess potential arising."@en ;
    pm:byPractice pmp:TranserfingParodyOrIgnoring ;
    pm:yieldsCapacity pmc:TranserfingFreedomFromPendulum ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDisturbanceSubsides a pm:Conceptualizing ;
    rdfs:label "The disturbance subsides soon"@en, "Die Störung legt sich bald"@de ;
    skos:definition "Announced sign: soon the neighbours will calm down; the author invites the reader to test it personally."@en ;
    skos:note "Sign of success announced in advance: Announced sign: soon the neighbours will calm down; the author invites the reader to test it personally; announced for pmp:TranserfingParodyOrIgnoring."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingDroppingImportanceInMisfortune a pm:Practicing ;
    rdfs:label "Dropping importance in a dire situation"@en, "Wichtigkeit in einer schlimmen Lage fallen lassen"@de ;
    skos:definition "Review what you have given excessive importance and the problems that followed; where things are truly bad, let go of their importance completely, shake off dependence on the situation and begin transmitting positive energy at once."@en ;
    skos:note "The author says the worse the situation, the better one can judge whether the technique works."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingCompensationOfLoss a pm:Conceptualizing ;
    rdfs:label "Compensation of loss by proportionate good"@en, "Ausgleich des Verlusts durch entsprechendes Gutes"@de ;
    skos:definition "Having balancing forces on one's side, compensating bad with good in proportion to the loss (the robbed man handed a bag of money larger the worse he was hurt)."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNothingLastsForever a pm:Conceptualizing ;
    rdfs:label "Nothing stays bad or good forever"@en, "Nichts bleibt immer schlecht oder gut"@de ;
    skos:definition "Bad times cannot last forever any more than good times can; no one rides the wave of success for life."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDroppingImportanceInMisfortuneYieldsCompensationOfLoss a pm:Yielding ;
    rdfs:label "Dropping importance in misfortune yields compensation"@en, "Wichtigkeit im Unglück abwerfen ergibt Ausgleich"@de ;
    skos:definition "Re-attuning one's energy in this way after great loss is said to let balancing forces compensate it with good."@en ;
    pm:byPractice pmp:TranserfingDroppingImportanceInMisfortune ;
    pm:yieldsCapacity pmc:TranserfingCompensationOfLoss ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Love to Have, Love to Hate'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. IV Balance, section 'Guilt'
#

pmc:TranserfingGuilt a pm:Conceptualizing ;
    rdfs:label "Guilt as pure excess potential; guilt and pride alike"@en, "Schuld als reines Überschusspotential; Schuld und Stolz gleich"@de ;
    skos:definition "Nature knows no good or bad; for balancing forces good and bad acts weigh the same. Feeling guilty (\"I should be punished\") and feeling proud (\"I should be rewarded\") both create potential; the forces only remove inhomogeneity."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGuiltPaidWithPunishment a pm:Conceptualizing ;
    rdfs:label "Guilt is paid with punishment; pride too"@en, "Schuld wird mit Strafe bezahlt; Stolz ebenso"@de ;
    skos:definition "The price of guilt is always punishment of some kind, whereas without guilt punishment may not come; pride after a good deed also brings punishment rather than reward, because reward would only enlarge the potential."@en ;
    skos:note "Condition of failure: The price of guilt is always punishment of some kind, whereas without guilt punishment may not come; pride after a good deed also brings punishment rather than reward, because reward would only enlarge the potential."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGradesOfGuilt a pm:Systematizing ;
    rdfs:label "Grades of guilt potential"@en, "Stufen des Schuldpotentials"@de ;
    skos:definition "The author grades guilt: own guilt; induced guilt (expected by \"proper\" people), called excess potential squared since one also bears the anger of the righteous; and unwarranted guilt from an innate habit of always taking the blame, which generates the greatest potential."@en ;
    pm:compiledBy "Vadim Zeland" ;
    dcterms:date "2004"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGuiltComplex a pm:Conceptualizing ;
    rdfs:label "A guilt complex ruins life"@en, "Ein Schuldkomplex ruiniert das Leben"@de ;
    skos:definition "Having a guilt complex keeps one permanently subject to balancing forces correcting the distortion of guilt over offences that never happened."@en ;
    skos:note "Condition of failure: Having a guilt complex keeps one permanently subject to balancing forces correcting the distortion of guilt over offences that never happened."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNoJusticeInNature a pm:Conceptualizing ;
    rdfs:label "No justice in nature: the shameless go unpunished"@en, "Keine Gerechtigkeit in der Natur: die Schamlosen bleiben unbestraft"@de ;
    skos:definition "People without a troubled conscience are not affected by balancing forces even after wrongdoing; decent people with inherent guilt meet constant misfortune while the cynical often prosper."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingPunishmentScript a pm:Conceptualizing ;
    rdfs:label "Guilt writes a punishment script"@en, "Schuld schreibt ein Strafdrehbuch"@de ;
    skos:definition "Guilt always produces a script containing punishment, which the subconscious follows whether one is aware or not: at best cuts, bruises or a problem, at worst a serious accident."@en ;
    skos:note "Condition of failure: Guilt always produces a script containing punishment, which the subconscious follows whether one is aware or not: at best cuts, bruises or a problem, at worst a serious accident."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingAvoidingGuilt a pm:Practicing ;
    rdfs:label "Avoiding guilt-producing acts and ending pointless self-torment"@en, "Schuldstiftende Taten meiden und sinnlose Selbstquälerei beenden"@de ;
    skos:definition "Rather avoid doing what would later make you feel guilty than torment yourself with conscience; once you can tell yourself you have done nothing wrong, stop the guilt complex, since it benefits no one."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingTenCommandments a pm:Conceptualizing ;
    rdfs:label "The Ten Commandments as balance recommendations"@en, "Die Zehn Gebote als Gleichgewichtsempfehlungen"@de ;
    skos:definition "The author reads the Commandments not as ethical morals with punishment attached but as warnings on how to keep balance; the punitive reading is ascribed to a childlike outlook, since people bring their troubles on themselves by breaking balance."@en ;
    skos:note "Reinterpretation rather than explicit dispute with the tradition; contrasts with a common punitive reading."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingManipulators a pm:Conceptualizing ;
    rdfs:label "Manipulators use guilt as a lead"@en, "Manipulatoren benutzen Schuld als Leine"@de ;
    skos:definition "Guilt is a thread by which pendulums and especially manipulators control people (\"do as I say because you are guilty\"). Manipulators look proper; their urge to lecture stems from hidden doubt and lack of inner strength, and they assert themselves by belittling their ward, forming dependent relationships. They are not corrected by balancing forces because the ward's energy flows to them, so no potential builds up."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingRefusingGuilt a pm:Practicing ;
    rdfs:label "Refusing to accept guilt"@en, "Schuld nicht annehmen"@de ;
    skos:definition "Refuse to accept feelings of guilt: you need not justify yourself to anyone and owe nobody anything, not even those close to you, whom you care for out of love, not coercion; if truly at fault, accept the punishment but do not stay in the role of the guilty; drop the habit of self-justification."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRefusingGuiltYieldsFreeOfManipulators a pm:Yielding ;
    rdfs:label "Refusing guilt yields release from manipulators"@en, "Schuldverweigerung ergibt Freiheit von Manipulatoren"@de ;
    skos:definition "Once manipulators find no way to hook into one's energy they are said to leave one alone."@en ;
    pm:byPractice pmp:TranserfingRefusingGuilt ;
    pm:yieldsCapacity pmc:TranserfingFreeOfManipulators ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFreeOfManipulators a pm:Conceptualizing ;
    rdfs:label "Being left alone by manipulators"@en, "Von Manipulatoren in Ruhe gelassen werden"@de ;
    skos:definition "Manipulative people stop clinging to and feeding on one's energy."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingSelfAccusationInvitesJudges a pm:Conceptualizing ;
    rdfs:label "Self-accusation invites others to judge"@en, "Selbstanklage lädt andere zum Richten ein"@de ;
    skos:definition "Guilt goes with an inferiority complex: comparing oneself with others puts them in authority; taking the role of the accused, one judges oneself in their name and effectively invites them to judge."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingLeavingTheDock a pm:Practicing ;
    rdfs:label "Leaving the dock: reclaiming the right to be oneself"@en, "Die Anklagebank verlassen: das Recht zurückfordern, man selbst zu sein"@de ;
    skos:definition "Get up from the bench of the accused and claim back your right to be who you are; do not consider yourself guilty, since only you can grant others the privilege of judging you."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLeavingTheDockYieldsNoOneAssertsOverYou a pm:Yielding ;
    rdfs:label "Leaving the dock yields freedom from others' judgement"@en, "Verlassen der Anklagebank ergibt Freiheit vom Urteil anderer"@de ;
    skos:definition "No one is said to dare judge one who does not consider themselves guilty."@en ;
    pm:byPractice pmp:TranserfingLeavingTheDock ;
    pm:yieldsCapacity pmc:TranserfingNoOneAssertsOverYou ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingMomentOfInferiority a pm:Conceptualizing ;
    rdfs:label "A moment's self-judged inferiority will be used against you"@en, "Ein Moment selbstbeurteilter Unterlegenheit wird gegen dich verwendet"@de ;
    skos:definition "Others point out a real flaw only if they sense one is disposed to accept blame; if one deems oneself inferior even briefly, this will certainly be exploited."@en ;
    skos:note "Condition of failure: Others point out a real flaw only if they sense one is disposed to accept blame; if one deems oneself inferior even briefly, this will certainly be exploited; it defeats pmc:TranserfingNoOneAssertsOverYou."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNoOneAssertsOverYou a pm:Conceptualizing ;
    rdfs:label "No one asserts themselves over you"@en, "Niemand setzt sich über einen"@de ;
    skos:definition "Being free of attempts by others to judge or dominate one; it occurs to no one to assert themselves over a person free of guilt."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingUnprovableInWords a pm:Conceptualizing ;
    rdfs:label "Unprovable in words: test it"@en, "In Worten unbeweisbar: ausprobieren"@de ;
    skos:definition "The author concedes these ideas are hard to accept and that the technique cannot be proved in words, and tells the reader not to take his word but to try it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGuiltAndPower a pm:Conceptualizing ;
    rdfs:label "Guilt, power and courage"@en, "Schuld, Macht und Mut"@de ;
    skos:definition "Those prone to guilt subordinate themselves only to those immune to it; those free of guilt but needing self-assertion easily become manipulators; rulers have little or no sense of guilt, so the unscrupulous often rise to power. The author says he is pointing to a pattern, not dividing the world into manipulators and puppets; power itself is not bad, and one's happiness may even lie in being favoured by a pendulum."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingBoldness a pm:Conceptualizing ;
    rdfs:label "Boldness as absence of guilt; fear as expected punishment"@en, "Kühnheit als Abwesenheit von Schuld; Angst als erwartete Strafe"@de ;
    skos:definition "Subconscious fear arises from the unknown and from dread of punishment; the guilty in principle consent to punishment and so are afraid, even admitting robbers a right to attack them; the brave feel no guilt because their inner judge has acquitted them."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingAskingForgivenessOnce a pm:Practicing ;
    rdfs:label "Asking for forgiveness once"@en, "Einmal um Vergebung bitten"@de ;
    skos:definition "Dissolve the potential of guilt by asking forgiveness, admitting the mistake, praying for forgiveness or confessing, and so release the held negative energy; allow yourself to be forgiven. Ask once only; do not indulge in remorse, and do not react when manipulators later remind you of the mistake."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAskingForgivenessOnceYieldsReleaseOfGuilt a pm:Yielding ;
    rdfs:label "Asking forgiveness yields release of guilt"@en, "Um Vergebung bitten ergibt Auflösung der Schuld"@de ;
    skos:definition "People are said to have learned that asking forgiveness dissolves the potential of guilt, and the author affirms it works."@en ;
    pm:byPractice pmp:TranserfingAskingForgivenessOnce ;
    pm:yieldsCapacity pmc:TranserfingReleaseOfGuilt ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingReleaseOfGuilt a pm:Conceptualizing ;
    rdfs:label "Release of the potential of guilt"@en, "Auflösung des Schuldpotentials"@de ;
    skos:definition "Letting go of the accusation one created and feeling better for it, the held energy dissipating."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingIndulgingInRemorse a pm:Cautioning ;
    rdfs:label "Indulging in remorse breeds dependence on manipulators"@en, "Schwelgen in Reue erzeugt Abhängigkeit von Manipulatoren"@de ;
    skos:definition "Going too far in remorse risks dependence on manipulators waiting for the next victim."@en ;
    pm:cautionsAbout pmp:TranserfingAskingForgivenessOnce ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingRemovingPunishmentExpectation a pm:Practicing ;
    rdfs:label "Removing the expectation of punishment from the subconscious"@en, "Die Straferwartung aus dem Unterbewusstsein entfernen"@de ;
    skos:definition "In aggressive surroundings (prison, gang, army, street) release guilt and eliminate the idea of possible punishment from your subconscious, rather than relying only on displays of strength; the underworld rule of trusting nobody, fearing nothing and asking nothing is read as a warning against excess potential."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDignityWithoutGuilt a pm:Conceptualizing ;
    rdfs:label "Personal dignity and power through absence of guilt"@en, "Persönliche Würde und Kraft durch Schuldlosigkeit"@de ;
    skos:definition "Reported case: political prisoners in the former Soviet Union, jailed among common criminals to break them, often not only escaped abuse but became respected authorities, showing that independence and dignity count for more than physical strength. The author draws the rule that true personal power rests on freedom from guilt."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAgainstSqueezingOutTheSlave a pm:Conceptualizing ;
    rdfs:label "Against \"squeezing out the slave\" (Chekhov)"@en, "Gegen das „Herauspressen des Sklaven“ (Tschechow)"@de ;
    skos:definition "The author cites Anton Chekhov's line about squeezing the slave out of himself drop by drop as dedication to freeing conscience of guilt, then sets Transurfing against its method: getting rid of something usually means fighting it, but here no battle or forcing is needed; one need not squeeze guilt out but renounce it by choice."@en ;
    skos:note "Polemic of the author against a view he cites; only his side is read, so it is entered as a concept and not as pm:Disputing."@en ;
    skos:note "Dispute of method, not of aim."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingRenouncingGuilt a pm:Practicing ;
    rdfs:label "Renouncing guilt by choice, living by one's own credo"@en, "Schuld durch Wahl ablegen, nach eigenem Credo leben"@de ;
    skos:definition "Do not fight guilt or squeeze it out; renounce it, i.e. choose: live by your own credo, recall that nobody is entitled to sit in judgement on you and that being yourself is your right; allowing yourself to be yourself lets self-justification drop and fear of punishment fade."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRenouncingGuiltYieldsSafetyFromViolence a pm:Yielding ;
    rdfs:label "Renouncing guilt yields safety and immunity from insult"@en, "Schuldentsagung ergibt Sicherheit und Schutz vor Beleidigung"@de ;
    skos:definition "When one lets oneself be oneself, it is said that something remarkable happens: no one dares insult one and threats of violence cease."@en ;
    pm:byPractice pmp:TranserfingRenouncingGuilt ;
    pm:yieldsCapacity pmc:TranserfingSafetyFromViolence ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNoOneDaresInsult a pm:Conceptualizing ;
    rdfs:label "No one dares insult you"@en, "Niemand wagt, dich zu beleidigen"@de ;
    skos:definition "Announced sign that guilt has been renounced: no one will dare to insult you."@en ;
    skos:note "Sign of success announced in advance: Announced sign that guilt has been renounced: no one will dare to insult you; announced for pmp:TranserfingRenouncingGuilt."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingSafetyFromViolence a pm:Conceptualizing ;
    rdfs:label "Safety from violence; living on lines without punishment scripts"@en, "Schutz vor Gewalt; Leben auf Linien ohne Strafdrehbücher"@de ;
    skos:definition "Never again being in a situation where someone threatens one with violence, wherever one is, because one resides on lines where scripts of punishment do not exist; no one dares to insult one."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRemovingPunishmentExpectationYieldsSafetyFromViolence a pm:Yielding ;
    rdfs:label "Removing guilt yields safety from violence"@en, "Abwerfen der Schuld ergibt Schutz vor Gewalt"@de ;
    skos:definition "Having renounced guilt and driven it from the subconscious, one is said to live on lines free of punishment scripts."@en ;
    pm:byPractice pmp:TranserfingRemovingPunishmentExpectation ;
    pm:yieldsCapacity pmc:TranserfingSafetyFromViolence ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Guilt'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. IV Balance, section 'Money'
#

pmc:TranserfingMoneyDependence a pm:Conceptualizing ;
    rdfs:label "Dependence on money and its minimisation"@en, "Abhängigkeit vom Geld und ihre Minimierung"@de ;
    skos:definition "Dependency on money is said to be almost unavoidable, since loving money hardly goes without wanting more; one can only keep the dependency minimal: be glad when money comes but never agonise over lacking or spending it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Money'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFearShrinksMoney a pm:Conceptualizing ;
    rdfs:label "Complaining and fear about money shrink it"@en, "Klagen und Angst ums Geld lassen es schrumpfen"@de ;
    skos:definition "Agonising about lack or spending brings less and less money; complaining of never having enough matches lines without wealth. Fear, the most energetically intense emotion, of losing income or not earning enough is the most effective way to shift to lines with ever less money."@en ;
    skos:note "Condition of failure: Agonising about lack or spending brings less and less money; complaining of never having enough matches lines without wealth. Fear, the most energetically intense emotion, of losing income or not earning enough is the most effective way to shift to lines with ever less money."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Money'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFreedomFromMoneyTrap a pm:Conceptualizing ;
    rdfs:label "Freedom from the money trap"@en, "Freiheit aus der Geldfalle"@de ;
    skos:definition "Escaping the money trap; said to be difficult but possible."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Money'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingCauseBeforeMoneyFreedom a pm:Presupposing ;
    rdfs:label "Remove the cause of the potential first"@en, "Erst die Ursache des Potentials beseitigen"@de ;
    skos:definition "What causes the excess potential, either strong dependency on money or very intense desire for it, must be removed first."@en ;
    pm:dependentStep pmc:TranserfingFreedomFromMoneyTrap ;
    pm:priorStep pmp:TranserfingGamblersContentment ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Money'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingGamblersContentment a pm:Practicing ;
    rdfs:label "Contentment with what one has; the gambler's stance"@en, "Zufriedenheit mit dem Vorhandenen; Haltung des Spielers"@de ;
    skos:definition "Begin by accepting and taking pleasure in what you own now; remember it could be worse; keep wanting money if you like, but relax about it not gushing in; take the stance of a gambler who may hit the jackpot or lose all at any moment."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Money'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGamblersContentmentYieldsFreedomFromMoneyTrap a pm:Yielding ;
    rdfs:label "Contentment yields release from the money trap"@en, "Zufriedenheit ergibt Befreiung aus der Geldfalle"@de ;
    skos:definition "Accepting what one has and relaxing about money removes the dependency that keeps one in the money trap."@en ;
    pm:byPractice pmp:TranserfingGamblersContentment ;
    pm:yieldsCapacity pmc:TranserfingFreedomFromMoneyTrap ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Money'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingMoneyAsBait a pm:Cautioning ;
    rdfs:label "Money as pendulums' bait"@en, "Geld als Köder der Pendel"@de ;
    skos:definition "Money is the pendulums' universal reward for adherents, and their activity is said to have produced the idolization of money; taking this glittering bait easily moves one to a line far from one's true happiness."@en ;
    pm:cautionsAbout pmc:TranserfingMoneyPendulum ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Money'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingMoneyFirstMyth a pm:Conceptualizing ;
    rdfs:label "The myth that goals require money first"@en, "Der Mythos, Ziele bräuchten zuerst Geld"@de ;
    skos:definition "Pendulums are said to have created the myth that money is needed to reach goals, so people swap their goal for money, fall under alien pendulums and lose sight of what they want. No one gets rich working for a pendulum outside their true purpose; hence the myth that wealth belongs to a minority."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Money'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingWealthThroughOwnGoal a pm:Conceptualizing ;
    rdfs:label "Becoming wealthy by serving one's own goal"@en, "Reich werden durch Dienst am eigenen Ziel"@de ;
    skos:definition "Anyone is said to be able to grow wealthy by pursuing goals that are truly their own; there are no limits to wealth, and whatever is truly one's own will be received."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Money'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingMoneyAsAttribute a pm:Conceptualizing ;
    rdfs:label "Money as accompanying attribute of the goal"@en, "Geld als Begleitattribut des Ziels"@de ;
    skos:definition "Money is neither the goal nor really the means but an attribute that accompanies the path to the goal (a house with roses, travel, trout fishing in Alaska, a farm, an island, stardom). Those who become millionaires are said to think of their goal, not of wealth; pendulums have inverted the relation."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Money'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingDroppingGetRichFirst a pm:Practicing ;
    rdfs:label "Dropping the condition \"first get rich\""@en, "Die Bedingung „erst reich werden“ fallen lassen"@de ;
    skos:definition "If you have made achieving your goal conditional on first getting rich, drop the condition at once; leave the money out of your thoughts and hold them on the goal itself, shrink the weight you give to capital as far as possible, and think only of what you wish to achieve."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Money'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDroppingGetRichFirstYieldsWealthThroughOwnGoal a pm:Yielding ;
    rdfs:label "Goal focus yields money"@en, "Zielausrichtung ergibt Geld"@de ;
    skos:definition "Money is said to arrive by itself, as an attribute accompanying the goal, while one builds the path to it; the author adds that the reader will soon see this for themselves."@en ;
    pm:byPractice pmp:TranserfingDroppingGetRichFirst ;
    pm:yieldsCapacity pmc:TranserfingWealthThroughOwnGoal ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Money'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingImposedGoal a pm:Conceptualizing ;
    rdfs:label "A pendulum-imposed goal gets nowhere"@en, "Ein vom Pendel aufgezwungenes Ziel führt nirgendwohin"@de ;
    skos:definition "If the goal was imposed by a pendulum, one will not get anywhere; chasing money in place of the goal loses both the money and the goal, since thought energy is aimed at a substitute."@en ;
    skos:note "Condition of failure: If the goal was imposed by a pendulum, one will not get anywhere; chasing money in place of the goal loses both the money and the goal, since thought energy is aimed at a substitute; it defeats pmc:TranserfingWealthThroughOwnGoal."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Money'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingRespectfulMoneyFlow a pm:Practicing ;
    rdfs:label "Respectful, flowing handling of money"@en, "Achtsamer, fließender Umgang mit Geld"@de ;
    skos:definition "Treat money with attention and care (pick up a small coin rather than ignore it); spend without regret once you have decided to; spend wisely so that money keeps flowing; donating to charity reduces the potential of accumulated wealth."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Money'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingMoneyPendulum a pm:Naming ;
    rdfs:label "The money pendulum"@en, "Das Geldpendel"@de ;
    skos:definition "A pendulum attached to money, said to be ill-disposed toward someone who treats its attributes carelessly."@en ;
    pm:nameForm "money pendulum" ;
    pm:nameRole "pendulum (energy-informational structure) with a disposition toward people" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Money'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingHoarding a pm:Conceptualizing ;
    rdfs:label "Hoarding risks losing everything"@en, "Horten riskiert den Verlust von allem"@de ;
    skos:definition "Trying to save a large sum while spending as little as possible concentrates energy in one place and creates strong excess potential, making it likely one loses everything; potential arises where energy does not flow."@en ;
    skos:note "Condition of failure: Trying to save a large sum while spending as little as possible concentrates energy in one place and creates strong excess potential, making it likely one loses everything; potential arises where energy does not flow."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Money'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingPotentialWhereNoFlow a pm:Conceptualizing ;
    rdfs:label "Potential arises where energy does not flow"@en, "Potential entsteht, wo Energie nicht fließt"@de ;
    skos:definition "Excess potential appears where energy accumulates without a flow; where energy flows (as from a manipulated ward to the manipulator) no potential builds up."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Money'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. IV Balance, section 'Perfection'
#

pmc:TranserfingInstilledPerfectionism a pm:Conceptualizing ;
    rdfs:label "Perfectionism as instilled distortion"@en, "Perfektionismus als anerzogene Verzerrung"@de ;
    skos:definition "Upbringing rightly teaches care and responsibility, but in some adherents of the pendulum the striving for perfection becomes part of the personality; perfectionists' assessments are inevitably distorted, and their life becomes a battle with balancing forces."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Perfection'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingPerfectionRuins a pm:Conceptualizing ;
    rdfs:label "Over-valued perfection ruins everything"@en, "Überbewertete Perfektion verdirbt alles"@de ;
    skos:definition "Doing one's best is fine, but attaching too much importance to perfection brings balancing forces that ruin everything, and a vicious circle: wanting perfection yields its opposite, frantic correction worsens matters, until the striving becomes habit or mania; high demands on others breed intolerance and escalating conflicts."@en ;
    skos:note "Condition of failure: Doing one's best is fine, but attaching too much importance to perfection brings balancing forces that ruin everything, and a vicious circle: wanting perfection yields its opposite, frantic correction worsens matters, until the striving becomes habit or mania; high demands on others breed intolerance and escalating conflicts."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Perfection'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNoRightToJudge a pm:Cautioning ;
    rdfs:label "No right to judge or label others"@en, "Kein Recht, andere zu richten oder abzustempeln"@de ;
    skos:definition "Everyone is a guest, free to pick their own way, yet nobody is entitled to judge, sentence or label others (criminal law excepted)."@en ;
    pm:cautionsAbout pmc:TranserfingPerfectionistAsJudge ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Perfection'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingPerfectionistAsJudge a pm:Conceptualizing ;
    rdfs:label "The perfectionist as judge of others is eventually thrown out"@en, "Der Perfektionist als Richter anderer wird schließlich hinausgeworfen"@de ;
    skos:definition "The perfectionist, sure of being right, is tempted to make themselves arbiter of others' lives, judging and labelling, which creates powerful potential; the resistance of balancing forces grows from minor problems; a protecting pendulum may delay payment, but a guest who claims the master's role risks being thrown out altogether."@en ;
    skos:note "Condition of failure: The perfectionist, sure of being right, is tempted to make themselves arbiter of others' lives, judging and labelling, which creates powerful potential; the resistance of balancing forces grows from minor problems; a protecting pendulum may delay payment, but a guest who claims the master's role risks being thrown out altogether."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Perfection'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. IV Balance, section 'Importance'
#

pmc:TranserfingVazhnost a pm:Conceptualizing ;
    rdfs:label "Importance as excess potential in pure form"@en, "Wichtigkeit als Überschusspotential in reiner Form"@de ;
    skos:definition "Importance arises when excess meaning is attributed to something; it is called the commonest cause and the pure form of excess potential, and in removing it balancing forces create problems for whoever produced it."@en ;
    skos:note "Russian term: vazhnost (важность)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingInnerAndOuterImportance a pm:Systematizing ;
    rdfs:label "Inner and outer importance"@en, "Innere und äußere Wichtigkeit"@de ;
    skos:definition "Two forms: inner (personal) importance, overestimating one's own virtues or shortcomings (\"I am important\", \"I do important work\"), whose reverse side is exaggerated humility and self-belittling with equal potential of opposite sign; and outer importance, attributing huge meaning to an external object or event (\"this means a great deal to me\")."@en ;
    pm:compiledBy "Vadim Zeland" ;
    dcterms:date "2004"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingSelfImportanceSlap a pm:Conceptualizing ;
    rdfs:label "Inflated self-importance earns a disappointing slap"@en, "Aufgeblähte Selbstwichtigkeit bringt eine enttäuschende Ohrfeige"@de ;
    skos:definition "When perceived personal importance goes off the scale, balancing forces intervene and the person discovers their work is either superfluous or poorly done."@en ;
    skos:note "Condition of failure: When perceived personal importance goes off the scale, balancing forces intervene and the person discovers their work is either superfluous or poorly done."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingOuterImportanceStays a pm:Conceptualizing ;
    rdfs:label "Outer importance cannot be talked away"@en, "Äußere Wichtigkeit lässt sich nicht wegreden"@de ;
    skos:definition "Inner importance can be controlled, outer importance much less: walking a plank on the ground is trivial, the same plank between two rooftops becomes important and no self-persuasion helps."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingSafetyNet a pm:Practicing ;
    rdfs:label "Safety net against outer importance"@en, "Sicherheitsnetz gegen äußere Wichtigkeit"@de ;
    skos:definition "Provide a safety net appropriate to the situation: a counterweight, protection or alternative plan (plan B); never put everything on one pan of the scales or all eggs in one basket, however safe it looks; ask yourself what could serve as the net in this case."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingChapterAsImportance a pm:Systematizing ;
    rdfs:label "The chapter's cases as variants of importance"@en, "Die Fälle des Kapitels als Varianten der Wichtigkeit"@de ;
    skos:definition "The author subsumes all sources of excess potential treated in the chapter (work, resentment, judgement, dependency, idealization, contempt, superiority, desire, guilt, money, perfection) under one theme, inner and outer importance."@en ;
    pm:compiledBy "Vadim Zeland" ;
    dcterms:date "2004"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFeelingsAsImportance a pm:Conceptualizing ;
    rdfs:label "All unbalanced feelings as manifestations of importance"@en, "Alle unausgewogenen Gefühle als Erscheinungen der Wichtigkeit"@de ;
    skos:definition "Indignation, irritation, anxiety, despair, fear, remorse, attachment, worship, delight, pride, contempt, resentment and the like are all forms of importance; excess potential is created only when excess importance is attached to an object or event inside or outside oneself."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingImportanceAsCarrot a pm:Conceptualizing ;
    rdfs:label "Importance as the pendulum's carrot"@en, "Wichtigkeit als Karotte des Pendels"@de ;
    skos:definition "Pendulums hook into feelings (fear, hatred, love, worship, duty, guilt) which all stem from projected importance: one wraps a neutral object in importance and becomes attached to it, ready to give the pendulum energy; importance is the carrot by which the pendulum locks onto one's frequency, drains it and leads one where it wants."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDiminishingBeforeFreedom a pm:Presupposing ;
    rdfs:label "Ability to diminish importance before freedom from pendulums"@en, "Fähigkeit, Wichtigkeit zu senken, vor der Freiheit von Pendeln"@de ;
    skos:definition "To return to harmony with the world and free oneself from the pendulum one must be capable of lowering importance."@en ;
    pm:dependentStep pmc:TranserfingProtectionFromPendulums ;
    pm:priorStep pmc:TranserfingStateOfBalance ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "The pendulum keeps its carrot, locks onto one's energy, drains it and leads one where it wants." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingWatchingImportance a pm:Practicing ;
    rdfs:label "Diminishing importance with the Guardian awake"@en, "Wichtigkeit senken bei wachem Wächter"@de ;
    skos:definition "Keep the inner Guardian awake so it can watch how much importance you place on yourself and the world, and lower that importance."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingWatchingImportanceYieldsStateOfBalance a pm:Yielding ;
    rdfs:label "Watching importance yields immediate balance"@en, "Wichtigkeit beobachten ergibt sofortiges Gleichgewicht"@de ;
    skos:definition "Lowering the importance one places on things, as observed by the Guardian, is said to restore balance immediately."@en ;
    pm:byPractice pmp:TranserfingWatchingImportance ;
    pm:yieldsCapacity pmc:TranserfingStateOfBalance ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingStateOfBalance a pm:Conceptualizing ;
    rdfs:label "State of balance through lowered importance"@en, "Gleichgewichtszustand durch gesenkte Wichtigkeit"@de ;
    skos:definition "The state reached when projected importance is reduced: balance is restored at once, no excess potential remains, balancing forces do not interfere."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingChangeAttitudeNotEmotion a pm:Cautioning ;
    rdfs:label "Do not suppress emotions; change the attitude"@en, "Gefühle nicht unterdrücken; die Haltung ändern"@de ;
    skos:definition "Lowering importance does not mean becoming a lifeless statue or rejecting emotion; fighting emotions is futile, and holding calm outwardly while boiling inside creates more potential. Change the underlying attitude instead."@en ;
    pm:cautionsAbout pmp:TranserfingWatchingImportance ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingEmotionsFollowAttitude a pm:Conceptualizing ;
    rdfs:label "Emotions follow attitude, attitude follows importance"@en, "Gefühle folgen der Haltung, die Haltung der Wichtigkeit"@de ;
    skos:definition "Feelings and emotions are a consequence of one's relation to something, and that relation has a single cause: importance."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNeitherAttachedNorIndifferent a pm:Conceptualizing ;
    rdfs:label "Being neither attached nor indifferent"@en, "Weder gebunden noch gleichgültig sein"@de ;
    skos:definition "A stance toward major events (a birth, a death, a wedding in the family) that is neither importance nor indifference, without making a problem of them or burdening others with one's emotional reaction."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingImportanceInCompassion a pm:Cautioning ;
    rdfs:label "Watch importance even in compassion"@en, "Auch beim Mitgefühl auf Wichtigkeit achten"@de ;
    skos:definition "Compassion and real help do no harm, but one should still observe the importance one gives to compassion: some people want to suffer and use one's compassion for self-validation (the fake cripple who turns out a professional beggar)."@en ;
    pm:cautionsAbout pmc:TranserfingVazhnost ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingImportanceHumanInvention a pm:Conceptualizing ;
    rdfs:label "Importance as a human invention; fanatic and despot"@en, "Wichtigkeit als menschliche Erfindung; Fanatiker und Despot"@de ;
    skos:definition "Importance is absent among animals and plants (except pets adopting human ways); wild behaviour fulfils purpose within the laws of balance. Importance is a purely human invention that pendulums enjoy; extreme outer importance makes a fanatic, extreme inner importance a despot."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingForcesBiteOnAttachment a pm:Conceptualizing ;
    rdfs:label "Balancing forces bite only on strong attachment"@en, "Ausgleichskräfte greifen erst bei starker Bindung"@de ;
    skos:definition "Reassurance: balancing forces affect one's life noticeably only if one clings very strongly to one's notions of how matters ought to go, is obsessive, or has gone too far; with pendulums the key is awareness of how they hook in and how far one lets them go."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingReducingImportanceYieldsFreedomOfChoice a pm:Yielding ;
    rdfs:label "Releasing inner and outer importance yields freedom of choice"@en, "Loslassen innerer und äußerer Wichtigkeit ergibt Wahlfreiheit"@de ;
    skos:definition "Once inner and outer importance are released, one is said to gain the treasure of freedom of choice, besides eliminating many problems."@en ;
    pm:byPractice pmp:TranserfingReducingImportance ;
    pm:yieldsCapacity pmc:TranserfingFreedomOfChoice ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingBlockedFreedomOfChoice a pm:Conceptualizing ;
    rdfs:label "Freedom of choice is given but blocked"@en, "Wahlfreiheit ist gegeben, aber blockiert"@de ;
    skos:definition "By the primary principle of Transurfing one has freedom of choice, but often cannot use it: projecting importance spends life fighting balancing forces, leaving no energy to choose consciously or know what one wants, while pendulums enforce their ideas."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingImportanceAsProjection a pm:Conceptualizing ;
    rdfs:label "All importance is projection; harmony of the child"@en, "Alle Wichtigkeit ist Projektion; Harmonie des Kindes"@de ;
    skos:definition "No one is truly important, yet life's riches are available. Children playing in the waves do not judge good or bad and are in harmony with nature, as everyone was at birth; whoever keeps that harmony has the best of life available, and problems start with projecting importance."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingSoleObstacle a pm:Conceptualizing ;
    rdfs:label "Projected importance as the sole obstacle to desires"@en, "Projizierte Wichtigkeit als einziges Hindernis der Wünsche"@de ;
    skos:definition "People fail to see the link between their projections and their problems and conclude the world is hostile; in fact the only obstacle to fulfilling desires is said to be artificial importance. The author admits he may not yet have convinced the reader but promises more arguments."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Importance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. IV Balance, section 'From Battle to Balance'
#

pmc:TranserfingResistingForcesFutile a pm:Cautioning ;
    rdfs:label "Resisting balancing forces is futile"@en, "Widerstand gegen Ausgleichskräfte ist zwecklos"@de ;
    skos:definition "Balancing forces have their way regardless; efforts to avoid their consequences only make things worse; the sole remedy is reducing the excess potential of importance behind the problem."@en ;
    pm:cautionsAbout pmc:TranserfingUravnoveshivayushchieSily ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNoUniversalRecipe a pm:Conceptualizing ;
    rdfs:label "No universal recipe, only general recommendations"@en, "Kein Universalrezept, nur allgemeine Empfehlungen"@de ;
    skos:definition "The author states that life situations are too diverse for a universal recipe against balancing forces; he offers only general recommendations to ease the way."@en ;
    skos:note "Statement on the status of the methods: not fixed procedures."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingReducingImportance a pm:Practicing ;
    rdfs:label "Reducing importance"@en, "Wichtigkeit verringern"@de ;
    skos:definition "In a problem situation, identify where you put too much intensity, went too far or became obsessive; determine what the matter means to you and let that meaning go. Become conscious that projecting importance brings only trouble, and on that basis intentionally reduce it; do not fight obstacles, remove the bricks of importance from their foundation; do not suppress feelings, deal with the cause, your relation to the event."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingReducingImportanceYieldsFreedomFromMostProblems a pm:Yielding ;
    rdfs:label "Reducing importance yields the dissolution of problems"@en, "Wichtigkeit senken ergibt Auflösung der Probleme"@de ;
    skos:definition "When the meaning is let go, the wall is said to crumble, obstacles disappear and problems resolve by themselves."@en ;
    pm:byPractice pmp:TranserfingReducingImportance ;
    pm:yieldsCapacity pmc:TranserfingFreedomFromMostProblems ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNotNeglect a pm:Cautioning ;
    rdfs:label "Reducing outer importance is not neglect"@en, "Äußere Wichtigkeit senken ist keine Vernachlässigung"@de ;
    skos:definition "Lowering outer importance must not become neglecting responsibilities or underestimating events; neglect is the other side of importance. Live simply with common sense, without carelessness or exaggeration, and accept the limits of life."@en ;
    pm:cautionsAbout pmp:TranserfingReducingImportance ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNotSelfAbasement a pm:Cautioning ;
    rdfs:label "Reducing inner importance is not self-abasement"@en, "Innere Wichtigkeit senken ist keine Selbsterniedrigung"@de ;
    skos:definition "Lowering inner importance is unrelated to resignation or self-deprecation; indulgent repentance equals showing off virtues with the opposite sign, and remorse serves only pendulums wanting control."@en ;
    pm:cautionsAbout pmp:TranserfingReducingImportance ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingBeingOneself a pm:Practicing ;
    rdfs:label "Allowing oneself to be oneself"@en, "Sich erlauben, man selbst zu sein"@de ;
    skos:definition "Accept yourself as you are; grant yourself the luxury of simply being who you are; do not inflate or diminish your merits and faults; aim at an inner peace in which you know you are neither important nor wholly insignificant."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingSafetyNetBeforeRelease a pm:Presupposing ;
    rdfs:label "Safety net before outer importance can drop"@en, "Sicherheitsnetz, bevor äußere Wichtigkeit sinken kann"@de ;
    skos:definition "Projected outer importance can be reduced only if there is a safety net or plan B."@en ;
    pm:dependentStep pmc:TranserfingStateOfBalance ;
    pm:priorStep pmp:TranserfingSafetyNet ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Importance stays high; nothing can persuade one otherwise, and one cannot stay calm on the plank." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingHumour a pm:Practicing ;
    rdfs:label "Humour"@en, "Humor"@de ;
    skos:definition "Cultivate humour: being able to laugh at oneself and at others without hurting them, the only thing said to create no excess potential."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingHumourYieldsStateOfBalance a pm:Yielding ;
    rdfs:label "Humour yields deflated importance"@en, "Humor ergibt entleerte Wichtigkeit"@de ;
    skos:definition "Humour is said to deflate the intensity of importance and keep one from becoming a walking mannequin."@en ;
    pm:byPractice pmp:TranserfingHumour ;
    pm:yieldsCapacity pmc:TranserfingStateOfBalance ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingGoldenRule a pm:Practicing ;
    rdfs:label "Golden rule: lower importance before solving"@en, "Goldene Regel: erst Wichtigkeit senken, dann lösen"@de ;
    skos:definition "Before even considering where the solution of a problem lies, first reduce the importance you associate with it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGoldenRuleYieldsEasySolutions a pm:Yielding ;
    rdfs:label "Golden rule yields quick and easy solutions"@en, "Goldene Regel ergibt schnelle, leichte Lösungen"@de ;
    skos:definition "With importance lowered first, balancing forces do not interfere and the problem is said to be solved quickly and easily."@en ;
    pm:byPractice pmp:TranserfingGoldenRule ;
    pm:yieldsCapacity pmc:TranserfingEasySolutions ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingThreeStepRelease a pm:Practicing ;
    rdfs:label "Three steps to reduce importance in the moment"@en, "Drei Schritte, um Wichtigkeit im Augenblick zu senken"@de ;
    skos:definition "First recall and realise that the problem stems from projected excess importance; halt, throw off the illusion and remind yourself where projected importance leads; then deliberately alter how you relate to the situation. Enlist the Guardian, the inner witness tracking your inner values, to remember quickly enough."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRecognitionBeforeRelease a pm:Presupposing ;
    rdfs:label "Recognising importance as the cause before release"@en, "Wichtigkeit als Ursache erkennen, bevor man loslässt"@de ;
    skos:definition "Until one can explain to oneself that every problem is created by excess importance, one cannot reduce it."@en ;
    pm:dependentStep pmc:TranserfingStateOfBalance ;
    pm:priorStep pmp:TranserfingThreeStepRelease ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "One stays sunk in its intensity as if dreaming, wholly in the pendulum's power." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGuardianForRemembering a pm:Presupposing ;
    rdfs:label "Guardian for remembering in time"@en, "Wächter, um rechtzeitig zu erinnern"@de ;
    skos:definition "The main difficulty is remembering soon enough that one is acting out projections of importance, for which the Guardian's help is needed."@en ;
    pm:dependentStep pmp:TranserfingThreeStepRelease ;
    pm:priorStep pmc:TranserfingInnerGuardian ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingCatchingImportanceEarly a pm:Practicing ;
    rdfs:label "Catching importance early while preparing for an event"@en, "Wichtigkeit früh ertappen bei der Vorbereitung"@de ;
    skos:definition "Like noticing muscle tension before it becomes spasm, catch yourself as you begin to inflate an upcoming event; if it truly matters, do not blow it up; rely on spontaneity, improvisation and common sense; let preparation consist only in providing a fallback, without grave seriousness or excessive caution."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingEasySolutions a pm:Conceptualizing ;
    rdfs:label "Quick, easy solution and success in events"@en, "Schnelle, leichte Lösung und Erfolg bei Ereignissen"@de ;
    skos:definition "Problems solved quickly and easily and events going well; spontaneity, improvisation and common sense are called the best recipe for success."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingCatchingImportanceEarlyYieldsEasySolutions a pm:Yielding ;
    rdfs:label "Early catching of importance yields success"@en, "Frühes Ertappen der Wichtigkeit ergibt Erfolg"@de ;
    skos:definition "Keeping an important event in proportion and preparing only a safety net is presented as the best recipe for its success."@en ;
    pm:byPractice pmp:TranserfingCatchingImportanceEarly ;
    pm:yieldsCapacity pmc:TranserfingEasySolutions ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingIdleWorry a pm:Conceptualizing ;
    rdfs:label "Worry without action magnifies importance"@en, "Sorge ohne Handeln vergrößert die Wichtigkeit"@de ;
    skos:definition "Worrying about something while doing nothing about it increases its importance, as does intensely serious, over-careful preparation."@en ;
    skos:note "Condition of failure: Worrying about something while doing nothing about it increases its importance, as does intensely serious, over-careful preparation."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingActDontThink a pm:Practicing ;
    rdfs:label "Act rather than think"@en, "Handeln statt denken"@de ;
    skos:definition "Since action dissipates the potential of importance, act instead of brooding; if you cannot act, better not think about it at all: turn your attention elsewhere and let the situation go as far as possible."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingHighestEfficiency a pm:Conceptualizing ;
    rdfs:label "Highest efficiency in action"@en, "Höchste Wirksamkeit im Handeln"@de ;
    skos:definition "The peak efficiency of any action, with excess potential eliminated and no interference from balancing forces."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingProcessFocus a pm:Practicing ;
    rdfs:label "Shifting attention to the process of action"@en, "Aufmerksamkeit auf den Vollzug der Handlung verlagern"@de ;
    skos:definition "Move the focus of attention away from yourself and the final aim onto carrying out the action itself, so that neither the doer nor the work is \"important\"; act dispassionately yet in no way carelessly."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingProcessFocusYieldsHighestEfficiency a pm:Yielding ;
    rdfs:label "Process focus yields highest efficiency"@en, "Prozessfokus ergibt höchste Wirksamkeit"@de ;
    skos:definition "Highest efficiency is said to be reached when attention moves from self and goal to the action's process; why the goal should be let go of is deferred to later chapters."@en ;
    pm:byPractice pmp:TranserfingProcessFocus ;
    pm:yieldsCapacity pmc:TranserfingHighestEfficiency ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFearedEventsGoWell a pm:Conceptualizing ;
    rdfs:label "Feared events go well, carefree ones go badly"@en, "Gefürchtetes gelingt, Unbekümmertes misslingt"@de ;
    skos:definition "Events one dreaded often go better than expected, whereas unworried ones bring unforeseen complications; the outcome is attributed to balancing forces offsetting a strongly negative or strongly positive personal assessment."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingPicturingTheWorst a pm:Conceptualizing ;
    rdfs:label "Deliberate worst-case picturing does not work"@en, "Absichtliches Schwarzmalen wirkt nicht"@de ;
    skos:definition "A student who intentionally imagines the worst before an exam gains nothing, because an intention arising from the mind rather than the soul lacks sincerity; self-deception carries no energy. For the same reason creating a result by visualization alone is said not to work (topic deferred)."@en ;
    skos:note "Condition of failure: A student who intentionally imagines the worst before an exam gains nothing, because an intention arising from the mind rather than the soul lacks sincerity; self-deception carries no energy. For the same reason creating a result by visualization alone is said not to work (topic deferred)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingIntentionFromTheSoul a pm:Conceptualizing ;
    rdfs:label "Only intention from the soul has power"@en, "Nur eine Absicht aus der Seele hat Kraft"@de ;
    skos:definition "Intention that springs from the soul carries energy; false, mind-made sincerity has none."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNeverBoast a pm:Cautioning ;
    rdfs:label "Never boast"@en, "Niemals prahlen"@de ;
    skos:definition "Never boast of what you have, even if fairly earned, let alone of what is still unachieved, because balancing forces will act against you."@en ;
    pm:cautionsAbout pmc:TranserfingUravnoveshivayushchieSily ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingSwayingInUnison a pm:Practicing ;
    rdfs:label "Swaying in unison with surrounding pendulums"@en, "Im Gleichtakt mit den umgebenden Pendeln schwingen"@de ;
    skos:definition "Make yourself at home but remember you are a guest: stay in balance with the pendulums around you and sway in unison with them, vibrating in resonant harmony with the world."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingSwayingInUnisonYieldsEffortlessGoals a pm:Yielding ;
    rdfs:label "Resonance with pendulums yields effortless goals"@en, "Resonanz mit Pendeln ergibt mühelose Ziele"@de ;
    skos:definition "Vibrating in resonant harmony with the world around one is said to energize one and let goals be achieved without special effort."@en ;
    pm:byPractice pmp:TranserfingSwayingInUnison ;
    pm:yieldsCapacity pmc:TranserfingEffortlessGoals ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingEffortlessGoals a pm:Conceptualizing ;
    rdfs:label "Achieving goals without particular effort"@en, "Ziele ohne besondere Anstrengung erreichen"@de ;
    skos:definition "An easy, pleasurable life in which resonance with the world energizes one and goals are reached without particular effort."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingLeavingCarefully a pm:Practicing ;
    rdfs:label "Leaving an unlivable situation carefully"@en, "Eine unerträgliche Lage besonnen verlassen"@de ;
    skos:definition "Where balance with one's surroundings has become practically impossible (e.g. a husband who beats one), consider carefully how to make the decisive change of surroundings; distrust the feeling of having nowhere to go as pendulum-instilled; avoid sudden ill-considered moves; reduce the importance projected onto the problem and free yourself from the destructive pendulum by defeating it or stopping its swing."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingBestSolution a pm:Conceptualizing ;
    rdfs:label "The best solution to any problem arriving"@en, "Die beste Lösung jedes Problems stellt sich ein"@de ;
    skos:definition "The best possible solution to a problem comes to one by itself."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLeavingCarefullyYieldsBestSolution a pm:Yielding ;
    rdfs:label "Lowered importance and freedom from the pendulum yield the best solution"@en, "Gesenkte Wichtigkeit und Freiheit vom Pendel ergeben die beste Lösung"@de ;
    skos:definition "The best solution is said to come as soon as projected importance is reduced and one is freed from the destructive pendulum."@en ;
    pm:byPractice pmp:TranserfingLeavingCarefully ;
    pm:yieldsCapacity pmc:TranserfingBestSolution ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDiagnosingFailures a pm:Conceptualizing ;
    rdfs:label "Diagnosing the cause of failures"@en, "Die Ursache von Misserfolgen erkennen"@de ;
    skos:definition "With the mechanism of balancing forces understood, one is said to be able easily to determine the reason for any given failure."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNoFanaticBalance a pm:Cautioning ;
    rdfs:label "Do not apply the principle of balance fanatically"@en, "Das Gleichgewichtsprinzip nicht fanatisch anwenden"@de ;
    skos:definition "The author warns against his own principle: applying it too ardently, becoming fixated or fanatical about it negates it (the centipede told how to walk cannot move); everything in moderation; one may disturb balance a little now and then, provided the needle is not forced off the scale."@en ;
    pm:cautionsAbout pmc:TranserfingLawOfBalance ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'From Battle to Balance'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. IV Balance, section 'Summary'
#

pmc:TranserfingTakeCareWithoutWorry a pm:Conceptualizing ;
    rdfs:label "Chapter maxim: take care without worrying"@en, "Kapitelmaxime: sorgen, ohne sich zu sorgen"@de ;
    skos:definition "The chapter is headed and closed by the maxim to take care of things without worrying, i.e. responsibility without importance."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. IV Balance, section 'Summary'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# prima-materia — Transerfing: Vadim Zeland, Transerfing real'nosti, Stupen' I
# (2004), part 3: chapter V The Induced Transition, chapter VI The
# Alternatives Flow.
#
# This part defines the shared system terms pmc:TranserfingIndutsirovannyPerekhod
# and pmc:TranserfingTechenieVariantov. It links to the terms of part 1
# (alternatives space, life line, pendulum, and its nodes for stopping the
# pendulum and for the pendulum as entity) and of part 2 (wave of fortune, excess potential,
# importance, balancing forces, the inner Guardian, reducing importance)
# without typing them. Two independent extraction
# passes ran over the text (A 231 records, B 148; 9 records of B without
# counterpart in A: 1 added, 8 covered); a reader of the whole part added the
# two series the source orders itself and three nodes that complete
# prerequisite pairs.
#

#
# ch. V The Induced Transition, section 'The Generation Shift'
#

pmc:TranserfingDriftOntoNegativeLines a pm:Conceptualizing ;
    rdfs:label "Drift onto negative life lines"@en, "Abgleiten auf negative Lebenslinien"@de ;
    skos:definition "The world itself does not get worse with age; a person who voices dissatisfaction tunes into parallel life lines on which things really are worse, while the earlier, brighter lines continue unchanged."@en ;
    skos:note "Bears on the system term pmc:TranserfingLiniyaZhizni."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Generation Shift'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingEverythingForEverybody a pm:Conceptualizing ;
    rdfs:label "Alternatives space holds every variant for everyone"@en, "Variantenraum enthält alles für alle"@de ;
    skos:definition "Per Transurfing, the alternatives space contains every variant for every person; someone emitting negative thought energy is carried into a sector with greyer scenery while the world stays as it was for others. Most people slide regularly onto lines with duller scenery over a lifetime."@en ;
    skos:note "Bears on the system term pmc:TranserfingProstranstvoVariantov."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Generation Shift'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDiscontentAsMovingForce a pm:Conceptualizing ;
    rdfs:label "Discontent as a moving force onto unsuccessful lines"@en, "Unzufriedenheit als Triebkraft auf erfolglose Linien"@de ;
    skos:definition "Accumulated complaint and whining are said to drive someone onto failing life lines that match the negative parameters of their thought energy; life is held to be as unsatisfactory as one thinks it is."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Generation Shift'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingComplainingAggravates a pm:Conceptualizing ;
    rdfs:label "Complaining worsens the situation"@en, "Klagen verschlimmert die Lage"@de ;
    skos:definition "Reacting to disappointment with dissatisfaction aggravates the circumstances further; the more one complains, the worse things get, and the more readily discontent is voiced the more firmly declining life quality is consolidated."@en ;
    skos:note "Condition of failure: complaining worsens the situation, bearing on pmc:TranserfingDiscontentAsMovingForce."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Generation Shift'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingTripleBoomerang a pm:Conceptualizing ;
    rdfs:label "Triple boomerang of discontent"@en, "Dreifacher Bumerang der Unzufriedenheit"@de ;
    skos:definition "Expressed discontent returns threefold: (1) its excess potential turns balancing forces against the person, (2) it opens a conduit for a pendulum to feed on their energy, (3) the negative radiation shifts them onto life lines of matching vibration."@en ;
    skos:note "Bears on the system term pmc:TranserfingIzbytochnyPotentsial."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Generation Shift'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingConsciousRegulationOfRelation a pm:Conceptualizing ;
    rdfs:label "Conscious regulation of one's relation to the world"@en, "Bewusste Regelung des Weltverhältnisses"@de ;
    skos:definition "Unlike lower creatures, a human is said to be able to govern, knowingly and deliberately, how they relate to the outer world instead of reacting negatively to irritants; most people leave this advantage unused."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Generation Shift'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAggressionIsNotStrength a pm:Cautioning ;
    rdfs:label "Aggression is not strength"@en, "Aggression ist keine Stärke"@de ;
    skos:definition "Aggression is wrongly taken for strength; a person who answers aggressively is, figuratively, trapped helpless in a pendulum's web. The habit of negative reaction is said to erode humanity's edge in awareness."@en ;
    pm:cautionsAbout pmc:TranserfingMayatnik ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Generation Shift'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLayersOfPersonalWorlds a pm:Conceptualizing ;
    rdfs:label "Personal world as a layer"@en, "Persönliche Welt als Schicht"@de ;
    skos:definition "Each individual is tuned to their own sector of the alternatives space and so lives in a personal world; these worlds are layered one over another, inseparable, and each person's reality intersects with the common world. Script, role and scenery differ between manifestations."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Generation Shift'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingBirthAndDeathOfALayer a pm:Conceptualizing ;
    rdfs:label "Birth and death of a world layer"@en, "Entstehen und Vergehen einer Weltschicht"@de ;
    skos:definition "The thought energy of a newly born observer is said to stimulate the material manifestation of a sector of the alternatives space, forming a new layer of the world; at death the layer vanishes or is transformed. The author marks this as speculation."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Generation Shift'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingOneModelAmongMany a pm:Conceptualizing ;
    rdfs:label "Transurfing is one model among many"@en, "Transurfing ist ein Modell unter vielen"@de ;
    skos:definition "The author states that Transurfing is only one model, that all theories of the world are models, that truth is abstract, and that the aim is solely maximum practical benefit from the preferred model."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Generation Shift'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNoOuterImportanceOnTheModel a pm:Cautioning ;
    rdfs:label "Do not attach outer importance to the Transurfing model"@en, "Keine äußere Bedeutsamkeit auf das Modell legen"@de ;
    skos:definition "Loading the Transurfing world-model with outer importance risks turning one into a defender of futile ideas who tries to prove a subjective worldview to everyone."@en ;
    skos:note "Bears on the system term pmc:TranserfingVazhnost."@en ;
    pm:cautionsAbout pmc:TranserfingVazhnost ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Generation Shift'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGenerationalLayerShift a pm:Conceptualizing ;
    rdfs:label "Shift of generational layers"@en, "Verschiebung der Generationenschichten"@de ;
    skos:definition "The older generation's layer shifts gradually to poorer life lines and the younger follows; each shift starts from optimism, so the world overall never becomes hell. Each person chooses their own layer, possibly to their own detriment."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Generation Shift'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingReturningToABrighterLine a pm:Conceptualizing ;
    rdfs:label "Returning to an earlier, brighter life line"@en, "Rückkehr auf eine frühere, farbige Lebenslinie"@de ;
    skos:definition "The text raises the possibility of retrieving an earlier section of one's world, returning to a life line full of colour and hope as in childhood, and says the Transurfing technique can help; explanation deferred."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Generation Shift'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. V The Induced Transition, section 'The Pendulum Vortex'
#

pmc:TranserfingNegativityBias a pm:Conceptualizing ;
    rdfs:label "Negativity bias of the psyche"@en, "Negativitätsvorrang der Psyche"@de ;
    skos:definition "The psyche reacts most strongly to negative stimuli (unwanted news, hostility, danger) because fear and rage were vital to survival in ancient times; hence people yield easily to gloom while joy passes quickly."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Pendulum Vortex'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingMediaSpiral a pm:Conceptualizing ;
    rdfs:label "Spiral of build-up and release in media"@en, "Spirale aus Aufbau und Entladung in Medien"@de ;
    skos:definition "News and serials follow a spiral: catchy headline, unfolding details, peaking tension, release of emotional energy into space. One gets hooked after a few episodes because one's thought frequency is captured by the series' pendulum and attention fixed on that sector."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Pendulum Vortex'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingPendulumSpiralMechanism a pm:Conceptualizing ;
    rdfs:label "Mechanism of the pendulum spiral"@en, "Mechanismus der Pendelspirale"@de ;
    skos:definition "A negative fact is the pendulum's first prod; a person touched by it radiates at the same frequency, resonates, feeds the pendulum as coverage continues, absorbs negative energy and becomes an observer in the game. Radiating at the event's frequency moves them to lines closer to such events; through discussion the pendulum grows and the observer becomes a direct participant."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Pendulum Vortex'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFirstProd a pm:Conceptualizing ;
    rdfs:label "The pendulum's first push"@en, "Der erste Stoß des Pendels"@de ;
    skos:definition "A piece of negative news, upsetting or not as the case may be, reaches a person; this is the destructive pendulum's opening push, the start of the spiral."@en ;
    skos:note "First member of pmc:TranserfingStagesOfInducedTransition."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Pendulum Vortex'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingObserverStage a pm:Conceptualizing ;
    rdfs:label "Drawn in as an observer"@en, "Als Beobachter hineingezogen"@de ;
    skos:definition "Whoever is touched by the news answers with thoughts and feelings at the push's frequency, follows the coverage with interest, resonates with and nourishes the pendulum and, aware of it or not, now takes part in the game as an onlooker."@en ;
    skos:note "Second member of pmc:TranserfingStagesOfInducedTransition."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Pendulum Vortex'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingDrawnIntoTheVortex a pm:Conceptualizing ;
    rdfs:label "Pulled toward the vortex"@en, "Zum Strudel hingezogen"@de ;
    skos:definition "Radiating at the frequency of the negative event moves the person onto a line nearer to lines where such events happen; caught in a spiral that turns ever faster, they take the event to be inevitable in their own life and their attention becomes selective."@en ;
    skos:note "Third member of pmc:TranserfingStagesOfInducedTransition."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Pendulum Vortex'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingParticipantStage a pm:Conceptualizing ;
    rdfs:label "From observer to direct participant"@en, "Vom Beobachter zum unmittelbaren Teilnehmer"@de ;
    skos:definition "Talking it over with friends and family feeds the pendulum further, until the person, drawn to the line of the original event, is no longer watching but directly involved, and a negative event takes place in the layer of their life."@en ;
    skos:note "Last member of pmc:TranserfingStagesOfInducedTransition."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Pendulum Vortex'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingSelectiveAttention a pm:Conceptualizing ;
    rdfs:label "Selective attention as sign of being drawn in"@en, "Selektive Aufmerksamkeit als Zeichen des Hineingezogenwerdens"@de ;
    skos:definition "Once someone takes the event to be an inevitable feature of their life, attention turns selective and similar facts seem to appear everywhere; this marks the tightening of the vortex."@en ;
    skos:note "Condition of failure: selective attention as sign of being drawn in, bearing on pmc:TranserfingIndutsirovannyPerekhod."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Pendulum Vortex'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingIndutsirovannyPerekhod a pm:Conceptualizing ;
    rdfs:label "Induced transition"@en, "Induzierter Übergang"@de ;
    skos:definition "Being drawn into the vortex is defined as an induced transition: the response to the pendulum's first prod and the ensuing energy exchange induce a move onto a line whose vibration matches the pendulum's swing, so a negative event occurs in that person's layer, where they become its victim."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Pendulum Vortex'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingStagesOfInducedTransition a pm:Sequencing ;
    rdfs:label "Stages of the induced transition"@en, "Stufen des induzierten Übergangs"@de ;
    skos:definition "The source's own order of how the vortex takes hold: the first push, the observer who answers it, the pull toward the vortex with selective attention, and the direct participant in whose layer the negative event occurs."@en ;
    skos:note "The section on disaster restates the same order as spectator, fan, player and victim (pmc:TranserfingObserverBecomesVictim); the sections on unemployment, epidemic and poverty apply it. No consequence of skipping a stage is named, since each stage is only reached through the one before, so no pm:Presupposing pairs are entered."@en ;
    rdf:_1 pmc:TranserfingFirstProd ;
    rdf:_2 pmc:TranserfingObserverStage ;
    rdf:_3 pmc:TranserfingDrawnIntoTheVortex ;
    rdf:_4 pmc:TranserfingParticipantStage ;
    pm:seriesStatement "Each stage arises only from the response to the stage before: answering the push makes one an observer, the observer's resonance pulls one toward the vortex, and the pull ends on the line of the event itself; this is why the text says the situation can be changed only at the first push." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'The Pendulum Vortex'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. V The Induced Transition, section 'Disaster'
#

pmc:TranserfingIndifferentLiveElsewhere a pm:Conceptualizing ;
    rdfs:label "Indifferent people live in another layer"@en, "Gleichgültige leben in einer anderen Schicht"@de ;
    skos:definition "People who skip serials and news and are unmoved by distant events live in a different layer from those events and follow other pendulums."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Disaster'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingProneToInducedShift a pm:Conceptualizing ;
    rdfs:label "Profile most prone to induced shift"@en, "Profil mit höchster Anfälligkeit für den Übergang"@de ;
    skos:definition "The most susceptible candidate for an induced shift takes an active interest in disasters befalling others elsewhere and is deeply disturbed by them; often someone with few problems of their own who fills the gap with other layers' events."@en ;
    skos:note "Condition of failure: profile most prone to induced shift, bearing on pmc:TranserfingIndutsirovannyPerekhod."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Disaster'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingInterestInCatastrophes a pm:Cautioning ;
    rdfs:label "Interest in catastrophes is a real threat"@en, "Interesse an Katastrophen ist eine reale Gefahr"@de ;
    skos:definition "Tabloids and soap operas are small, harmless pendulums that merely compensate a lack of information, emotion and experience; keen interest in disasters and catastrophes, however, is a genuine threat because these belong to stronger, more aggressive pendulums."@en ;
    pm:cautionsAbout pmc:TranserfingIndutsirovannyPerekhod ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Disaster'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingObserverBecomesVictim a pm:Conceptualizing ;
    rdfs:label "From observer to victim"@en, "Vom Beobachter zum Opfer"@de ;
    skos:definition "Like a spectator who becomes a fan and then a player, a person who lets disaster information into their life unwittingly accepts the victim's fate; once one has agreed to join, the pendulum assigns the role, and the misfortune is the logical end of behaviour that raised the probability of being in the wrong place."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Disaster'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNearZeroExposure a pm:Conceptualizing ;
    rdfs:label "Near-zero exposure to catastrophe"@en, "Nahezu kein Katastrophenrisiko"@de ;
    skos:definition "By ignoring the destructive pendulum's prod one is said never to become involved in a catastrophe, or at least the probability falls close to zero."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Disaster'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingCommonFieldHerdInstinct a pm:Conceptualizing ;
    rdfs:label "Common field and herd instinct"@en, "Gemeinsames Feld und Herdeninstinkt"@de ;
    skos:definition "Total isolation from destructive frequencies is impossible: surrounding people work for destructive pendulums, the common field envelops one and one starts radiating at its frequencies without awareness, rooted in an ancient herd instinct; thus the field of an induced shift snowballs."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Disaster'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingLettingInformationPass a pm:Practicing ;
    rdfs:label "Letting negative information pass you by"@en, "Negative Information an sich vorbeiziehen lassen"@de ;
    skos:definition "Stay far from the vortex: do not absorb news of catastrophes and disasters, show no interest, do not worry about or discuss them, let them pass without reacting; do not actively try to avoid them; switch attention to harmless programmes and books."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Disaster'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLettingInformationPassYieldsNearZeroExposure a pm:Yielding ;
    rdfs:label "Letting information pass yields near-zero exposure"@en, "Vorbeiziehenlassen bewirkt Schutz vor Katastrophen"@de ;
    skos:definition "Not absorbing or reacting to catastrophe news keeps one outside the pendulum's vortex."@en ;
    pm:byPractice pmp:TranserfingLettingInformationPass ;
    pm:yieldsCapacity pmc:TranserfingNearZeroExposure ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Disaster'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLettingInformationPassYieldsStoppingThePendulum a pm:Yielding ;
    rdfs:label "Letting information pass keeps pendulums from swinging"@en, "Vorbeiziehenlassen hält Pendel in Ruhe"@de ;
    skos:definition "Withholding interest from a destructive pendulum's news deprives it of energy, so it comes to rest."@en ;
    pm:byPractice pmp:TranserfingLettingInformationPass ;
    pm:yieldsCapacity pmc:TranserfingStoppingThePendulum ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Disaster'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAvoidingIsSeeking a pm:Cautioning ;
    rdfs:label "Avoiding a pendulum means seeking it"@en, "Vermeiden eines Pendels heißt es suchen"@de ;
    skos:definition "Trying to avoid a pendulum is equivalent to seeking it out: resisting, wanting specifically to avoid, or showing enmity towards something makes one radiate at that object's frequency."@en ;
    pm:cautionsAbout pmp:TranserfingLettingInformationPass ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Disaster'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingTurningToTheGuardianAngel a pm:Practicing ;
    rdfs:label "Turning to one's Guardian Angel"@en, "Sich an den Schutzengel wenden"@de ;
    skos:definition "When one cannot keep a positive outlook in the face of negativity, one can turn to one's Guardian Angel (procedure given in earlier chapters)."@en ;
    skos:note "Procedure referred back to earlier chapters; not detailed here."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Disaster'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGuardianAngel a pm:Naming ;
    rdfs:label "Guardian Angel"@en, "Schutzengel"@de ;
    skos:definition "A protective being one can turn to when unable to stay positive amid negativity; introduced in earlier chapters and only referenced here."@en ;
    pm:nameForm "Guardian Angel" ;
    pm:nameRole "protective helper the practitioner can appeal to" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Disaster'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingSkippingTheFlight a pm:Practicing ;
    rdfs:label "Skip the flight when unusually anxious"@en, "Bei ungewöhnlicher Angst den Flug auslassen"@de ;
    skos:definition "Someone afraid of flying should keep off aircraft; when anxiety before boarding is unusually high, skip the flight. Someone who does not think about the dangers of flying has nothing to fear."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Disaster'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingSkippingTheFlightYieldsNearZeroExposure a pm:Yielding ;
    rdfs:label "Skipping the flight lowers exposure"@en, "Flugverzicht senkt das Risiko"@de ;
    skos:definition "Staying off a plane when fear signals a resonant frequency keeps one away from the line with the crash."@en ;
    pm:byPractice pmp:TranserfingSkippingTheFlight ;
    pm:yieldsCapacity pmc:TranserfingNearZeroExposure ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Disaster'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFearAsResonance a pm:Cautioning ;
    rdfs:label "Fear signals a resonant frequency"@en, "Angst zeigt eine Resonanzfrequenz an"@de ;
    skos:definition "Fear (e.g. of flying) means that one's energy spectrum contains a frequency resonating with a line where the feared event happens; this does not make the transition immediate but makes it possible."@en ;
    pm:cautionsAbout pmc:TranserfingIndutsirovannyPerekhod ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Disaster'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingHearingTheMorningStars a pm:Conceptualizing ;
    rdfs:label "Hearing the morning-stars rustle"@en, "Das Rauschen der Morgensterne hören"@de ;
    skos:definition "Announced as a faculty to learn when skipping a feared flight is impossible; what it is and how to hear it is deferred to later in the book."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    skos:note "Forward reference; content given later in the work."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Disaster'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. V The Induced Transition, section 'War'
#

pmc:TranserfingWarOfPendulums a pm:Conceptualizing ;
    rdfs:label "War as two pendulums knocking"@en, "Krieg als zwei aneinanderschlagende Pendel"@de ;
    skos:definition "Wars arise like fist fights: an opinion acts as a destructive pendulum's prod, the other side answers with double amplitude, and both swing higher. A pendulum primes people that they live badly, blames others for it, stirs resentment and provokes until a snowball shifts everyone onto a line of mounting tension."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'War'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingOnlyAtTheOutset a pm:Presupposing ;
    rdfs:label "Intervene only at the outset"@en, "Eingreifen nur am Anfang"@de ;
    skos:definition "The situation can be changed only at the outset, before escalation; once the prod is taken up, one's energy fits the line of the spiral's following coil."@en ;
    skos:note "The prior step is the peaceful answer of pmp:TranserfingAnsweringTheFirstProdPeacefully at the first push; the dependent is bringing the pendulum to rest (pmc:TranserfingStoppingThePendulum, part 1)."@en ;
    pm:dependentStep pmc:TranserfingStoppingThePendulum ;
    pm:priorStep pmp:TranserfingAnsweringTheFirstProdPeacefully ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "If the prod is accepted, one's energy fits the spiral's following coil and escaping a powerful whirlpool becomes nearly impossible." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'War'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingAnsweringTheFirstProdPeacefully a pm:Practicing ;
    rdfs:label "Answer the first prod peacefully or walk away"@en, "Auf den ersten Anstoß friedlich reagieren oder weggehen"@de ;
    skos:definition "At the moment the spiral starts with the pendulum's opening move, respond peacefully or leave; do not accept the prod."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'War'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingAnsweringTheFirstProdPeacefullyYieldsStoppingThePendulum a pm:Yielding ;
    rdfs:label "Peaceful response stops the pendulum"@en, "Friedliche Antwort stoppt das Pendel"@de ;
    skos:definition "Responding peacefully or walking away at the outset brings the pendulum to rest."@en ;
    pm:byPractice pmp:TranserfingAnsweringTheFirstProdPeacefully ;
    pm:yieldsCapacity pmc:TranserfingStoppingThePendulum ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'War'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingNonResponseNoGuarantee a pm:Cautioning ;
    rdfs:label "Non-response is no guarantee"@en, "Nichtreagieren ist keine Garantie"@de ;
    skos:definition "Even someone who manages not to respond may still be pulled into war or revolution; once inside a powerful whirlpool it is almost impossible to escape the pull to its centre."@en ;
    pm:cautionsAbout pmp:TranserfingAnsweringTheFirstProdPeacefully ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'War'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingSurvivingWithMinimalLoss a pm:Conceptualizing ;
    rdfs:label "Surviving with minimal loss"@en, "Mit minimalem Verlust überstehen"@de ;
    skos:definition "A participant who declines the pendulum's game is said to have greater chances of surviving war or revolution with minimal loss."@en ;
    skos:note "Counted as a capacity: a state or ability the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'War'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingRefusingTheWarGameYieldsSurvivingWithMinimalLoss a pm:Yielding ;
    rdfs:label "Refusing the game yields survival chances"@en, "Spielverweigerung bringt Überlebenschancen"@de ;
    skos:definition "Ignoring the pendulum's game raises the chance of coming through with minimal loss."@en ;
    pm:byPractice pmp:TranserfingRefusingTheWarGame ;
    pm:yieldsCapacity pmc:TranserfingSurvivingWithMinimalLoss ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'War'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingFightingWarFeedsIt a pm:Cautioning ;
    rdfs:label "Fighting war feeds the pendulum"@en, "Kampf gegen den Krieg nährt das Pendel"@de ;
    skos:definition "Hating or campaigning against war is all the same to the pendulum; it takes energy from both sides. Ardent anti-war protesters are as desirable adherents as supporters; emitting at war's frequency shifts one onto a corresponding line."@en ;
    pm:cautionsAbout pmc:TranserfingWarOfPendulums ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'War'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingRefusingTheWarGame a pm:Practicing ;
    rdfs:label "Ignoring the pendulum's game; supporting peace and exposing motives"@en, "Das Spiel des Pendels ignorieren; Frieden stützen, Motive aufdecken"@de ;
    skos:definition "Not accepting the pendulum's game means ignoring it, taking neither defender nor opponent position; war is truly prevented by backing peaceful action and, when feasible, unmasking the pendulum's true motives (cf. the wild bees and their honey)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'War'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

#
# ch. V The Induced Transition, section 'Unemployment'
#

pmc:TranserfingNegatingIsMostPerilous a pm:Cautioning ;
    rdfs:label "Negating a pendulum is the most perilous way"@en, "Negieren eines Pendels ist der gefährlichste Weg"@de ;
    skos:definition "Of the two ways of playing a destructive pendulum's game, supporting and negating, negation is probably the more dangerous: the wish to actively avoid it creates excess potential that drags one into an induced transition's vortex."@en ;
    skos:note "Bears on the system term pmc:TranserfingIzbytochnyPotentsial."@en ;
    pm:cautionsAbout pmc:TranserfingIndutsirovannyPerekhod, pmc:TranserfingIzbytochnyPotentsial ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Unemployment'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingInducedUnemployment a pm:Conceptualizing ;
    rdfs:label "Induced transition into unemployment"@en, "Induzierter Übergang in die Arbeitslosigkeit"@de ;
    skos:definition "Starting from a faint signal (company trouble, a dismissed acquaintance, rumours), further signals accumulate (inflation, market drop); talk feeds the unemployment pendulum, concern turns to anxiety and fear, and one generates energy at the vibration of a jobless line."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Unemployment'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingVisibleFear a pm:Conceptualizing ;
    rdfs:label "Visible fear and falling efficiency"@en, "Sichtbare Angst und sinkende Leistung"@de ;
    skos:definition "Fear of redundancy is perceptible to others through body language and voice; lost confidence lowers efficiency, tasks grow harder, tension enters communication, family criticises instead of supporting, stress rises: one effectively signals readiness to be dismissed."@en ;
    skos:note "Condition of failure: visible fear and falling efficiency, bearing on pmc:TranserfingIndutsirovannyPerekhod."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Unemployment'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGuiltBeneathFear a pm:Conceptualizing ;
    rdfs:label "Guilt beneath the fear of dismissal"@en, "Schuld unter der Kündigungsangst"@de ;
    skos:definition "Fear of being sacked rests on guilt smouldering in the subconscious; since the weakest are fired first, allowing oneself to think one is weaker than colleagues puts one's name on the blacklist."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Unemployment'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingLettingGoOfGuilt a pm:Practicing ;
    rdfs:label "Let go of guilt and allow yourself to be yourself"@en, "Schuld loslassen, sich erlauben man selbst zu sein"@de ;
    skos:definition "Drop the feeling of guilt and grant yourself the luxury of being who you are."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Unemployment'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingLettingGoOfGuiltYieldsSecurityAboutTheFuture a pm:Yielding ;
    rdfs:label "Releasing guilt yields security"@en, "Schuld loslassen bewirkt Sicherheit"@de ;
    skos:definition "Letting go of guilt removes the fear that writes one onto the blacklist."@en ;
    pm:byPractice pmp:TranserfingLettingGoOfGuilt ;
    pm:yieldsCapacity pmc:TranserfingSecurityAboutTheFuture ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Unemployment'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmp:TranserfingSafetyNetJobSearch a pm:Practicing ;
    rdfs:label "Look for another job as a safety net"@en, "Als Sicherheitsnetz eine andere Stelle suchen"@de ;
    skos:definition "If letting go of guilt does not work, begin looking for another job: action dissipates the excess potential of emotional worry. Some do this right after taking a new post, not to leave but to feel secure through an alternative."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
    dcterms:source "Vadim Zeland, Transerfing real'nosti, Stupen' I: Prostranstvo variantov (2004), ch. V The Induced Transition, section 'Unemployment'; read in the English translation of the combined edition, Reality Transurfing: steps 1-5 (OJSC Ves Publishing Group, 2012), translator not named, which carries no page numbers" .

pmc:TranserfingGuiltReleaseBeforeSearch a pm:Presupposing ;
    rdfs:label "Guilt release before job search"@en, "Erst Schuld loslassen, dann Stellensuche"@de ;
    skos:definition "The job search is offered as the fallback when releasing guilt fails."@en ;
    pm:dependentStep pmp:TranserfingSafetyNetJobSearch ;
    pm:priorStep pmp:TranserfingLettingGoOfGuilt ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen1 ;
