pmc:TranserfingSafetyNetJobSearchYieldsSecurityAboutTheFuture a pm:Yielding ;
    rdfs:label "Safety net yields security"@en, "Sicherheitsnetz bewirkt Sicherheit"@de ;
    skos:definition "Having an alternative avenue makes one confident and so shielded from balancing forces."@en ;
    pm:byPractice pmp:TranserfingSafetyNetJobSearch ;
    pm:yieldsCapacity pmc:TranserfingSecurityAboutTheFuture ;
    pm:attestedBy pm:textualAttestation ;
