pmc:HarbaDeMoshe022 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For pains in the stomach and bowels"@en, "Gegen Magen- und Darmschmerz"@de ;
    skos:definition "Said over water, which is drunk."@en ;
