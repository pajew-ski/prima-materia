    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For haemorrhoids, with tow and salt"@en, "Gegen Hämorrhoiden, mit Werg und Salz"@de ;
    skos:definition "Said over tow salted and mixed with oil, on which the patient sits."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 33 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe034 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For swelling and venereal disease"@en, "Gegen Schwellung und Geschlechtskrankheit"@de ;
    skos:definition "Said over water in which radishes are soaked, which is drunk."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 34 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe035 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For sprains"@en, "Gegen Verstauchungen"@de ;
    skos:definition "Either written on a plate laid on the place, whereupon all around it heals, or said over a ball of wool dipped in oil and laid on the sprain."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 35 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe036 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For a wound from iron, that it should not fester"@en, "Gegen eine Eisenwunde, dass sie nicht eitere"@de ;
    skos:definition "Said over white naphtha, which is rubbed over the place of the blow."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 36 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe037 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For cramps and pains of the heart"@en, "Gegen Krämpfe und Herzschmerz"@de ;
    skos:definition "Said over spinach and oil, which is drunk."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 37 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe038 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For the gall and the bowels"@en, "Gegen Galle und Gedärm"@de ;
    skos:definition "Said over water in which raisins have been soaked, which is drunk."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 38 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe039 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For a spoiled liver"@en, "Gegen eine verdorbene Leber"@de ;
    skos:definition "Said over a sixth measure of water-lentils, swallowed slowly."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 39 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe040 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For the milt"@en, "Gegen die Milz"@de ;
    skos:definition "Said over wine-lees and drunk, repeated for three days."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 40 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe041 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For the spirit that rests on the womb"@en, "Gegen den Geist, der auf dem Mutterleib ruht"@de ;
    skos:definition "Said over camphor oil, applied with a ball of wool."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 41 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe042 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For a woman who miscarries"@en, "Für eine Frau, die Fehlgeburten hat"@de ;
    skos:definition "Said over a cup of wine, strong drink or water, drunk for seven days; and if she does see blood and repeats it over a cup of wine, the child is said to live."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 42 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe043 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For baldness"@en, "Gegen die Kahlheit"@de ;
    skos:definition "Said over nut oil, with which the head is anointed."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 43 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe044 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To conjure a spirit that it reveal what is asked"@en, "Einen Geist beschwören, dass er offenbare, was gefragt wird"@de ;
    skos:definition "Written on a laurel leaf with an adjuration of the prince named Abraksas that he come and reveal all that is asked and not tarry; the one bound is then said to come down and reveal himself."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 44 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe045 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To strip a rich man of his riches"@en, "Einen Reichen seines Reichtums berauben"@de ;
    skos:definition "Said over the dust of an ant-hill, which is thrown into his face."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 45 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe046 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To heal leprosy"@en, "Den Aussatz heilen"@de ;
    skos:definition "The patient is taken to the riverside and the leprosy adjured to depart from him; he dips seven times in the river, and on coming out an amulet of the adjuration is hung round his neck."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 46 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe047 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For diarrhoea"@en, "Gegen den Durchfall"@de ;
    skos:definition "Written on a red copper plate and hung round the neck."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 47 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe048 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "That the rain should not fall on thy garden"@en, "Dass der Regen nicht auf deinen Garten falle"@de ;
    skos:definition "Written out."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 48 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe049 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To see the sun and have it answer thee"@en, "Die Sonne sehen und von ihr Antwort erhalten"@de ;
    skos:definition "Taken from a male tree, said standing before the sun; he will appear in the form of a man dressed in white, answer everything asked, and even bring a woman after the operator. The text is defective at this place and Gaster marks it so."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 49 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe050 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To enter a furnace"@en, "In einen Ofen treten"@de ;
    skos:definition "Written on a silver plate and hung upon the haunch."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 50 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe051 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "That a king or ruler follow thee"@en, "Dass ein König oder Herrscher dir folge"@de ;
    skos:definition "Said over a basin of water holding the roots of genipa, purslane and birthwort, set on fiery coals in a white earthen vessel with olive leaves thrown on them; whatever is decreed, he is said to bring, and a woman may be commanded as well."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 51 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe052 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To overawe them"@en, "Sie einschüchtern"@de ;
    skos:definition "Said over water from the fountain, which is thrown into their faces."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 52 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe053 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To loosen any charm, and to free a man from prison"@en, "Jeden Zauber lösen und einen Gefangenen befreien"@de ;
    skos:definition "Said over water thrown over him and written as an amulet hung round his neck."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 53 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe054 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To catch fish"@en, "Fische fangen"@de ;
    skos:definition "Said over olive leaves in a white potsherd at the riverside."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 54 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe055 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "That a woman follow thee"@en, "Dass eine Frau dir folge"@de ;
    skos:definition "Her name written with the operator's own blood on a newly laid egg, and the words said towards her."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 55 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe056 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "That a man follow thee"@en, "Dass ein Mann dir folge"@de ;
    skos:definition "A new potsherd dipped in black myrrh, the words pronounced over his name, and the operator walks on without looking back."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 56 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe057 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For a tree that bears no fruit"@en, "Für einen Baum, der keine Frucht trägt"@de ;
    skos:definition "Written on a new potsherd buried under the root of the barren tree; all the trees are then watered, and those that bear nothing with them."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 57 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe058 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For blight in the fruit"@en, "Gegen Befall in der Frucht"@de ;
    skos:definition "Written on a new potsherd buried in the watering place; the words are also said over water, ashes and salt, and the ground watered with it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 58 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe059 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For a suckling babe"@en, "Für einen Säugling"@de ;
    skos:definition "Written on an onyx slab and whispered into its ears three times with spitting after each whisper; then said seventy times over a cupful of water given the child to drink."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 59 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe060 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For one bitten by a rabid dog"@en, "Für den von einem tollen Hund Gebissenen"@de ;
    skos:definition "Written on the halter of an ass which is then let go; the words are repeated over sesame oil for the patient to anoint himself, he puts on new clothes, and the halter is hung round him."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 60 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe061 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For fever and small fever"@en, "Gegen Fieber und kleines Fieber"@de ;
    skos:definition "Written on the skin of the brains of a ram or a goat and hung round the neck."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 61 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe062 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "If anyone loses his way"@en, "Wenn einer seinen Weg verliert"@de ;
    skos:definition "Said over the four corners of his belt."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 62 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe063 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To ask anything of thy neighbour"@en, "Etwas von deinem Nächsten erbitten"@de ;
    skos:definition "Said over oil of sesame or over one of two further substances the text leaves illegible."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 63 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe064 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "That a woman follow thee, written in blood on the doors"@en, "Dass eine Frau dir folge, mit Blut auf die Türen geschrieben"@de ;
    skos:definition "The operator's name and hers written with his blood on her door and on his own, and the words repeated."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 64 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe065 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To know whether thy journey will be lucky"@en, "Wissen, ob die Reise glücklich sein wird"@de ;
    skos:definition "A field lettuce with open leaves is held before the sun and the words said; if the leaves close and shut, he is not to go, and if they stay as they are he proceeds and is said to prosper."@en ;
    skos:note "One of two entries in the whole list with two outcomes. The leaves close and he is not to go; they stay open and he proceeds. It is a question put to the world and not a test of the operation: on either outcome the operation is held to have worked, and there is no result that would tell against it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 65 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe066 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To deliver a man from prison"@en, "Einen Mann aus dem Gefängnis holen"@de ;
    skos:definition "Said once to him, once to the sun, once to the prison house."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 66 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe067 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To conquer"@en, "Siegen"@de ;
    skos:definition "Said seven times over dust from the operator's house in the road of the town; then dust is taken from the road, the same done, and thrown into his house."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 67 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe068 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To kill a man"@en, "Einen Menschen töten"@de ;
    skos:definition "Mud from the two sides of the river is formed into a figure and the person's name written on it; seven branches are taken from seven strong palm trees, a bow made of reed with a string of horse sinew, the image placed in a hollow, and the words said at each shot."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 68 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe069 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To send plagues"@en, "Plagen senden"@de ;
    skos:definition "Parings from seven men are put into a new potsherd, the words said at the cemetery, the potsherd buried where no horse treads; afterwards the dust from it is blown into his face or on his lintel."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 69 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe070 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To send dreams to thy neighbours"@en, "Deinen Nächsten Träume senden"@de ;
    skos:definition "Written on a silver plate put into the mouth of a cock, which is killed when it has gone down; the plate is taken out, put between the bird's legs and buried at the end of a wall, and the operator sets his foot on the spot and says that a swift messenger go and torment the named man in his dreams until he fulfils the operator's wish."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 70 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe071 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "If a snake follows thee"@en, "Wenn eine Schlange dir folgt"@de ;
    skos:definition "Said, and it is claimed to dry up."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 71 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe072 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To stop a boat in the sea"@en, "Ein Boot auf dem Meer anhalten"@de ;
    skos:definition "Said over a potsherd or a rounded flintstone thrown against it into the sea."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 72 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe073 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To loosen the boat from the charm"@en, "Das Boot vom Zauber lösen"@de ;
    skos:definition "Said over dust or a clod thrown into the water; as it dissolves the boat is free to go."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 73 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe074 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To keep an oven, furnace or pot from being spoiled"@en, "Ofen, Esse oder Topf vor dem Verderben bewahren"@de ;
    skos:definition "Said over dust thrown over them."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 74 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe075 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To make them hot"@en, "Sie heiß machen"@de ;
    skos:definition "The operator spits in front of them and says the words, and they are said to boil."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 75 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe076 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To pass dryshod through the sea"@en, "Trockenen Fußes durch das Meer gehen"@de ;
    skos:definition "Said upon the four corners of the head-dress; one corner is taken in the hand and the other goes before him."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 76 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe077 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To curse anyone"@en, "Jemanden verfluchen"@de ;
    skos:definition "Said inside the Eighteen Benedictions."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 77 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe078 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To speak with the dead"@en, "Mit den Toten sprechen"@de ;
    skos:definition "Whispered into the left ear of the dead and thrown into their holes."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 78 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe079 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To kill a lion, a bear or an adder"@en, "Einen Löwen, einen Bären oder eine Natter töten"@de ;
    skos:definition "Said over dust taken from under the right foot and thrown into their faces."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 79 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe080 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To catch them"@en, "Sie fangen"@de ;
    skos:definition "Said over dust taken from under the left foot and thrown into their faces."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 80 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe081 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To open a door"@en, "Eine Tür öffnen"@de ;
    skos:definition "The root of lotos reed placed under the tongue and the words said against the door."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 81 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe082 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To kill an ox or another beast"@en, "Einen Ochsen oder ein anderes Tier töten"@de ;
    skos:definition "Said into its ear."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 82 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe083 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To inflame a man's heart"@en, "Das Herz eines Menschen entflammen"@de ;
    skos:definition "Said over a piece of raw meat given him to eat."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 83 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe084 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To make a fool of a man"@en, "Einen zum Narren machen"@de ;
    skos:definition "Said over an egg placed in his hands."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 84 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe085 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To destroy thy neighbour's house"@en, "Das Haus deines Nächsten zerstören"@de ;
    skos:definition "Said over a new potsherd thrown into his house."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 85 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe086 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To expose thy neighbour"@en, "Deinen Nächsten bloßstellen"@de ;
    skos:definition "Said over an oil the text leaves illegible and smeared at the bottom of his jug."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 86 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe087 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To make thy neighbour disliked"@en, "Deinen Nächsten verhasst machen"@de ;
    skos:definition "Said over blood from phlebotomy thrown upon his lintel."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 87 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe088 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To make a woman miscarry"@en, "Eine Frau eine Fehlgeburt erleiden lassen"@de ;
    skos:definition "Said over a cup of water thrown over her lintel."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 88 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe089 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To make a man ill"@en, "Einen Menschen krank machen"@de ;
    skos:definition "Said over olive oil with which he is made to anoint himself."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 89 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe090 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "To know whether a sick man will live or die"@en, "Wissen, ob ein Kranker leben oder sterben wird"@de ;
    skos:definition "Said before him: if he turns his face towards the operator he will live, if away, he will die."@en ;
    skos:note "The second of the two entries with two outcomes, and it has the same shape as the lettuce at number 65. He turns his face towards the operator and lives, or away and dies. Nothing here would show the reading to have been wrong, because the reading is whatever happens next."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 90 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .
