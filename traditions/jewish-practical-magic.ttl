pmc:HarbaDeMoshe018 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For deafness"@en, "Gegen Taubheit"@de ;
    skos:definition "Said over hemp water while it is mixed with oil, and put into the ear once it has dissolved or warmed."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 18 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe019 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For scabs, ulcers, itches and mange"@en, "Gegen Schorf, Geschwüre, Krätze und Räude"@de ;
    skos:definition "Said over olive oil; the anointing is done with the left hand."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 19 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe020 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For jaundice"@en, "Gegen die Gelbsucht"@de ;
    skos:definition "Said over water in which radish has been soaked, which is then drunk."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 20 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe021 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For pains in the nose and the spirit in the nose"@en, "Gegen Nasenschmerz und den Geist in der Nase"@de ;
    skos:definition "Said over oil and put into the nostrils."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
