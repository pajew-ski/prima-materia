pmc:HarbaDeMoshe018 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For deafness"@en, "Gegen Taubheit"@de ;
    skos:definition "Said over hemp water while it is mixed with oil, and put into the ear once it has dissolved or warmed."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 18 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe019 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For scabs, ulcers, itches and mange"@en, "Gegen Schorf, Geschwüre, Krätze und Räude"@de ;
    skos:definition "Said over olive oil; the anointing is done with the left hand."@en ;
