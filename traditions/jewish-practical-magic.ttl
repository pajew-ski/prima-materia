pmc:HarbaDeMoshe023 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For hot fever"@en, "Gegen hitziges Fieber"@de ;
    skos:definition "Said over water in which rose-laurels are soaked; the patient bathes in it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 23 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe024 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For tumours"@en, "Gegen Geschwülste"@de ;
    skos:definition "Said once over them and once over olive oil; they are anointed for three days and no water may come near them."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 24 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe025 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For an evil occurrence"@en, "Gegen einen bösen Vorfall"@de ;
    skos:definition "Said over seven white cups of water drawn from the river, which are thrown over the head."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 25 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe026 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For ulcer of the throat"@en, "Gegen Halsgeschwür"@de ;
    skos:definition "The operator spits before him and says the words over the patient's mouth and over a cup of strong drink, which the patient drinks; then he watches what comes out of the mouth."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 26 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe027 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For snakebite and the bite of poisonous vermin"@en, "Gegen Schlangenbiss und den Biss giftigen Gewürms"@de ;
    skos:definition "Said over the place of the bite and drunk; the same for any hurt by a creeping thing."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 27 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe028 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For a woman who has seen blood before her time"@en, "Für eine Frau, die vor der Zeit Blut gesehen hat"@de ;
    skos:definition "Said over an ostrich egg, which is burnt; she is fumigated with it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 28 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe029 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For pains in the mouth"@en, "Gegen Mundschmerz"@de ;
    skos:definition "Said over risen flour, which is laid on the mouth."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 29 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe030 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For croup and pains in the shoulder"@en, "Gegen Krupp und Schulterschmerz"@de ;
    skos:definition "Said over wine, which is drunk."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 30 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe031 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For a painful nerve"@en, "Gegen einen schmerzenden Nerv"@de ;
    skos:definition "Written on a scroll; the words are also said over olive oil, some of it is rubbed on the scroll, the scroll smeared over the painful spot, and the amulet hung round the neck."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 31 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

pmc:HarbaDeMoshe032 a pm:Conceptualizing ;
    pm:fromWork pmw:HarbaDeMoshe ;
    rdfs:label "For the stone"@en, "Gegen den Stein"@de ;
    skos:definition "Said over a cup of wine, which is drunk."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:JewishPracticalMagic ;
    dcterms:source "Ḥarba de-Moshe, part III, no. 32 (trans. Moses Gaster, The Sword of Moses: An Ancient Book of Magic, London: David Nutt, 1896; the numbering of part III is the editor's)" .

