pmc:NewThoughtShinnUnforeseenGoodArrived a pm:Conceptualizing ;
    rdfs:label "Unforeseen funds for the desired goal"@en, "Unvorhergesehene Mittel für das ersehnte Ziel"@de ;
    skos:definition "A penniless mother kept preparing her daughters for college; a rich relative suddenly sent a large sum, attributed to her active faith."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnSecretDoorToSuccess ;
