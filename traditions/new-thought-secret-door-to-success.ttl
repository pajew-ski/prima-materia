pmp:NewThoughtShinnHabitOfHunching a pm:Practicing ;
    rdfs:label "Getting the habit of hunching"@en, "Sich das Ahnen zur Gewohnheit machen"@de ;
    skos:definition "Make following hunches habitual so as always to be on the magic path."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnSecretDoorToSuccess ;
