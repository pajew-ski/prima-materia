    rdfs:label "Learning to relax; rest in action"@en, "Entspannen lernen; Ruhe im Tun"@de ;
    skos:definition "Following the runner Lovelock's advice, relax most while acting hardest, so that effort is free of strain."@en ;
    skos:note "Author's term: \"rest in action\"."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
