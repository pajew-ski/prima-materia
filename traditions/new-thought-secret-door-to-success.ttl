pmc:NewThoughtShinnInnerEyeSeesThrough a pm:Conceptualizing ;
    rdfs:label "Trained inner eye that sees through appearances"@en, "Geschultes inneres Auge, das durch den Schein sieht"@de ;
    skos:definition "A faculty of seeing past failure, sickness and limitation into their opposites; linked to the promise of the land one sees."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnSecretDoorToSuccess ;
