pmp:NewThoughtShinnUnforeseenGood a pm:Practicing ;
    rdfs:label "Preparing for one's unforeseen good"@en, "Sich auf das unvorhergesehene Gute vorbereiten"@de ;
    skos:definition "Declare that some unforeseen good will come and keep preparing for it regardless of mockery, letting every thought and act express unwavering faith."@en ;
    skos:note "Author's term: \"some unforeseen good\"."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:NewThought ;
