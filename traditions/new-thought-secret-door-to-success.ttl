pmc:NewThoughtShinnElementOfMystery a pm:Conceptualizing ;
    rdfs:label "A good statement contains the element of mystery"@en, "Eine gute Aussage enthält das Element des Geheimnisses"@de ;
    skos:definition "Since God works in mysterious or surprising ways, statements leaving room for surprise are preferred."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnSecretDoorToSuccess ;
