pmp:NewThoughtShinnINowCatchUpWithMyGood a pm:Practicing ;
    rdfs:label "Closing affirmation of catching up with one's good"@en, "Schlussaffirmation: Ich hole mein Gutes nun ein, bevor ich rief, wurde ich erhört"@de ;
    skos:definition "State that one now catches up with one's good because one was answered before calling."@en ;
    skos:note "Author's term: \"I now catch up with my good\"."@en ;
    pm:attestedBy pm:textualAttestation ;
