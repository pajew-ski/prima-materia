pmc:NewThoughtShinnStepsLeadingUpToItSecured a pm:Conceptualizing ;
    rdfs:label "The steps leading to the good secured"@en, "Die zum Guten führenden Schritte gesichert"@de ;
    skos:definition "Giving thanks for invisible receipt is said to secure the steps leading to it."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
