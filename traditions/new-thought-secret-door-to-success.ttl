pmc:NewThoughtShinnPreparingForSomethingDestructive a pm:Cautioning ;
    rdfs:label "Do not prepare for something destructive"@en, "Sich nicht auf Zerstörerisches vorbereiten"@de ;
    skos:definition "Watch and pray to avoid the temptation of preparing for harm; the author told a woman keeping a crepe veil for funerals that she endangered her relatives, and she destroyed it."@en ;
    pm:cautionsAbout pmc:NewThoughtShinnLawOfPreparation ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnSecretDoorToSuccess ;
