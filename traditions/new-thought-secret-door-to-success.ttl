pmp:NewThoughtShinnAttachThyselfToGod a pm:Practicing ;
    rdfs:label "Attaching oneself to God to have peace"@en, "Sich an Gott binden, um Frieden zu haben"@de ;
    skos:definition "Attach oneself to God (French reading of Job 22:21) and take him as one's gold, silver and riches."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
