pmc:NewThoughtShinnRightnessAndJusticeAtTheExactTime a pm:Conceptualizing ;
    rdfs:label "Rightness and justice in a dealing, at the moment of speaking"@en, "Richtigkeit und Gerechtigkeit in einer Verhandlung, im Moment des Sprechens"@de ;
    skos:definition "The author spoke the long-arm statement for a man meeting a seemingly unscrupulous person; rightness and justice came out exactly while she was speaking."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnSecretDoorToSuccess ;
