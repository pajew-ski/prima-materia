pmc:NewThoughtShinnGodTheGiverAndTheGift a pm:Naming ;
    rdfs:label "God the Giver and the Gift"@en, "Gott der Geber und die Gabe"@de ;
    skos:definition "God is at once giver and gift and makes his own surprising channels; every gift is God acting. God cannot fail."@en ;
    pm:nameForm "God the Giver; God the Gift" ;
    pm:nameRole "source and substance of all supply" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnSecretDoorToSuccess ;
