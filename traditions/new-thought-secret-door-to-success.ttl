pmp:NewThoughtShinnRightnessAndJustice a pm:Practicing ;
    rdfs:label "Speaking the word for a right and just outcome"@en, "Das Wort für Richtigkeit und Gerechtigkeit sprechen"@de ;
    skos:definition "The practitioner declares the word for a right and just outcome on a client's behalf before a legal hearing."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnSecretDoorToSuccess ;
