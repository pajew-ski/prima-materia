pmc:NewThoughtShinnMagnifyTheLord a pm:Cautioning ;
    rdfs:label "Magnify God, not obstacles"@en, "Hindernisse nicht vergrößern; den Herrn groß machen"@de ;
    skos:definition "Dwelling on obstacles and giving them undivided attention makes them grow worse, since one combines with what one notices."@en ;
    pm:cautionsAbout pmp:NewThoughtShinnGiveGodYourUndividedAttention ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
