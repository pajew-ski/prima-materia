pmp:NewThoughtShinnHarvestGround a pm:Practicing ;
    rdfs:label "Harvest-ground statement"@en, "Aussage: Der Boden, auf dem du stehst, ist Erntegrund"@de ;
    skos:definition "Given by the author to a woman leaving a meeting; the phrase kept ringing in her ears."@en ;
    skos:note "Author's term: \"harvest ground\"."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:NewThought ;
