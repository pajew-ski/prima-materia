    rdfs:label "The third eye"@en, "Das dritte Auge"@de ;
    skos:definition "Identified with the single eye of the Gospel and the watchman, the inner eye seated between the eyes."@en ;
    pm:nameForm "third eye; single eye; inner eye" ;
    pm:nameRole "inner seeing faculty of the superconscious" ;
