    rdfs:label "Teachers vanish once seen"@en, "Wenn deine Augen deine Lehrer gesehen haben, verschwinden sie"@de ;
    skos:definition "A saying used to explain that troubles serve as teachers and vanish once their lesson is learned."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
