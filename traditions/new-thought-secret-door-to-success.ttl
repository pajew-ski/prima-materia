pmc:NewThoughtShinnSupremeIntelligence a pm:Naming ;
    rdfs:label "God as Supreme Intelligence dedicated to man's supply"@en, "Gott als Höchste Intelligenz, die dem Bedarf des Menschen dient"@de ;
    skos:definition "God is the supreme intelligence dedicated to man's supply, explained by man being God in action; in Ch. 13 its irresistible power rescues man in trouble."@en ;
    pm:nameForm "Supreme Intelligence" ;
    pm:nameRole "God as supplier of all need" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnSecretDoorToSuccess ;
