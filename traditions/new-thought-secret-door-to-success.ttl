pmc:NewThoughtShinnBackInTheWorldOfTheWondrous a pm:Conceptualizing ;
    rdfs:label "Living in the wondrous world"@en, "Leben in der Welt des Wunderbaren"@de ;
    skos:definition "A childlike state of joy and wonder in which anything can happen overnight and all conditions are perfect."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
