pmc:NewThoughtShinnAllLifeIsVibration a pm:Conceptualizing ;
    rdfs:label "All life is vibration; symbols of one's states attach to one"@en, "Alles Leben ist Schwingung; Symbole der eigenen Zustände haften an"@de ;
    skos:definition "Since all life is vibration, vibrating to success, happiness and abundance makes the things symbolizing these states attach themselves automatically."@en ;
    skos:note "Author's term: \"vibrate to success\"."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnSecretDoorToSuccess ;
