pmc:NewThoughtShinnSuccessIsASystem a pm:Conceptualizing ;
    rdfs:label "Success is a System, not a secret"@en, "Erfolg ist ein System, kein Geheimnis"@de ;
    skos:definition "The author states that success follows a system, of which courage and endurance are parts, as seen in the lives of successful people."@en ;
    skos:note "Author's term: \"Success is not a secret, it is a System\"."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnSecretDoorToSuccess ;
