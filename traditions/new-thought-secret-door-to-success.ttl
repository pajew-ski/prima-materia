pmc:NewThoughtShinnFoodAndGiftsArrived a pm:Conceptualizing ;
    rdfs:label "Supply arriving after renouncing reliance on visible means"@en, "Versorgung, nachdem man auf sichtbare Mittel verzichtet hat"@de ;
    skos:definition "Shortly after, friends came bringing ample food and money."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:NewThought ;
