pmp:NewThoughtShinnNeverGivesUp a pm:Practicing ;
    rdfs:label "Refusing to be discouraged; never giving up"@en, "Sich nicht entmutigen lassen; nie aufgeben"@de ;
    skos:definition "Hold to courage and endurance and do not give up; the boy Eddie, given The Game of Life, refused discouragement."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:NewThought ;
