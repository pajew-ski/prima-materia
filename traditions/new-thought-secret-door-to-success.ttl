pmc:NewThoughtShinnAbundanceOfTheSpheresPresupposesSeekingTheLord a pm:Presupposing ;
    rdfs:label "Man takes the first step"@en, "Der Mensch muss den ersten Schritt tun"@de ;
    skos:definition "Draw near and God draws near: seeking precedes not wanting any good thing."@en ;
    pm:dependentStep pmc:NewThoughtShinnAbundanceOfTheSpheres ;
    pm:priorStep pmp:NewThoughtShinnSeekingTheLord ;
    pm:prerequisiteStrength pm:prescribedOrder ;
