pmp:NewThoughtShinnAskForGuidance a pm:Practicing ;
    rdfs:label "Asking for guidance in whatever one does"@en, "Bei allem, was man tut, um Führung bitten"@de ;
    skos:definition "Whatever the activity, ask for guidance; e.g. to avoid choosing wrong gifts."@en ;
    pm:attestedBy pm:textualAttestation ;
