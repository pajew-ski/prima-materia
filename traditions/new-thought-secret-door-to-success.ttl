    rdfs:label "Attending to each thought and word"@en, "Jedem Gedanken und Wort Aufmerksamkeit schenken"@de ;
    skos:definition "Realizing their importance, form the habit of attending to each thought and word (the trumpet that calls attention)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
