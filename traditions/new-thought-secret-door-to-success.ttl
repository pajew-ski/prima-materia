pmc:NewThoughtShinnFruitsOfOurFaith a pm:Conceptualizing ;
    rdfs:label "Reaping the fruits of faith when least expected"@en, "Die Früchte des Glaubens ernten, wenn man es am wenigsten erwartet"@de ;
    skos:definition "By being wise and bringing oil, one is said to reap the fruits of faith at an unexpected moment."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
