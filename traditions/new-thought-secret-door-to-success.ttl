pmp:NewThoughtShinnSilenceIsGolden a pm:Practicing ;
    rdfs:label "Keeping silent about one's business"@en, "Schweigen über die eigenen Geschäfte"@de ;
    skos:definition "Refuse to discuss one's business, hopes and fears with family or others; the author advised a failing man to stop reporting his day at dinner."@en ;
    skos:note "Author's term: \"Silence is golden\"."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnSecretDoorToSuccess ;
