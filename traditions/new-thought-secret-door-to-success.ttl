pmc:NewThoughtShinnCrystallizedIdea a pm:Conceptualizing ;
    rdfs:label "Every event is a crystallized idea invited by fear or faith"@en, "Jedes Ereignis ist eine kristallisierte Idee, eingeladen durch Furcht oder Glauben"@de ;
    skos:definition "Whatever occurs in life is something one invited and prepared for, through either fear or faith."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnSecretDoorToSuccess ;
