pmc:NewThoughtShinnDivineDesigner a pm:Naming ;
    rdfs:label "The Divine Designer"@en, "Der Göttliche Gestalter"@de ;
    skos:definition "God as the designer of the plan of one's life, to whom the plan should be left (as the philosopher leaves his coat's cut to the tailor)."@en ;
    pm:nameForm "Divine Designer" ;
    pm:nameRole "author of the divine plan of each life" ;
    pm:attestedBy pm:textualAttestation ;
