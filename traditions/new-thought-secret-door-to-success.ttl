pmc:NewThoughtShinnExpandedIntoANewJob a pm:Conceptualizing ;
    rdfs:label "Expansion into a liked new job"@en, "Wechsel in eine neue, geliebte Stelle"@de ;
    skos:definition "Eddie, the program seller, soon moved on into a new job he liked; his wall is said to have crumbled."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
