pmc:NewThoughtShinnWordDissolvesObstacles a pm:Conceptualizing ;
    rdfs:label "Power of the word to dissolve obstacles"@en, "Macht des Wortes, Hindernisse aufzulösen"@de ;
    skos:definition "One's own spoken word is held to dissolve obstacles and remove barriers; this is the inner meaning of the Jericho story."@en ;
    skos:note "Author's term: \"the power of the word\"."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnSecretDoorToSuccess ;
