    rdfs:label "Appointing the third eye as gatekeeper"@en, "Das dritte Auge zum Wächter machen"@de ;
    skos:definition "Keep the single or third eye as guard at the gate of thought, judging not by appearances."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnSecretDoorToSuccess ;
