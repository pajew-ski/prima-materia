pmc:NewThoughtShinnLampAndOil a pm:Naming ;
    rdfs:label "Lamp = consciousness; oil = understanding"@en, "Lampe = Bewusstsein; Öl = Verständnis"@de ;
    skos:definition "In the parable the lamp is man's consciousness and the oil what brings light or understanding; the foolish virgins lacked this wisdom and could not meet a crisis."@en ;
    pm:nameForm "lamp; oil" ;
    pm:nameRole "consciousness; understanding/wisdom" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnSecretDoorToSuccess ;
