pmc:NewThoughtShinnPromotionAndSalary a pm:Conceptualizing ;
    rdfs:label "Rise in position and salary"@en, "Aufstieg in Stellung und Gehalt"@de ;
    skos:definition "After keeping silent the man was soon given a post at a hundred dollars a week and within a few years three hundred."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnSecretDoorToSuccess ;
