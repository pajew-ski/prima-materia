    rdfs:label "The great law of attraction"@en, "Das große Gesetz der Anziehung"@de ;
    skos:definition "A law that draws rightly desired things when one stops anxious striving; big opportunities slip in when least expected."@en ;
    skos:note "Author's term: \"law of attraction\"."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
