pmc:NewThoughtShinnFearPictures a pm:Conceptualizing ;
    rdfs:label "Cutting out fear-pictures"@en, "Angstbilder ausschneiden"@de ;
    skos:definition "Many people use imagination to cut out fear-pictures and see what is not divinely planned."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that goes wrong or does not come, and its cause. It names how pmc:NewThoughtShinnSingleEye fails."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnSecretDoorToSuccess ;
