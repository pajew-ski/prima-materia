@prefix pm:      <https://pajew.ski/prima-materia/ontology#> .
@prefix pmt:     <https://pajew.ski/prima-materia/traditions/> .
@prefix pmc:     <https://pajew.ski/prima-materia/concepts/> .
@prefix pmp:     <https://pajew.ski/prima-materia/practices/> .
@prefix pmw:     <https://pajew.ski/prima-materia/works/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

#
# prima-materia — chaos magic: Carroll, The Octavo
#
# The harvest of one work of the corpus of pmt:ChaosMagic, kept apart from
# traditions/chaos-magic.ttl, which declares the tradition and the work
# (pmw:TheOctavo), carries its reading notes and harvest counts, and holds
# the two nodes entered from the centring and chapter 4 on 2026-10-22
# (pmc:ChaosMagicCohaerentiaNeurologica, pmc:ChaosMagicSilentiumInternum),
# which are not repeated here. Harvested complete under prima-materia#893
# with two independent extraction passes per part, a comparison of the two
# by offset and word overlap, and a check at the text of every item the
# second pass found and the first did not. Part 1 (infix Octa): front
# matter, chapters 0-4 with Magical Ritual parts 1-4 and the first paragraph
# of chapter 5; part 2 (infix Octav): chapter 5 from p. 86 to the end,
# appendices 1-4 and the glossary. Edition: Mandrake of Oxford, 2011, first
# edition (copyright page). Cited by chapter or section and printed page,
# the page taken from the bare number line at the foot of each page. Signs
# of success and conditions of failure carry a note beginning "Counted as a
# sign of success:" or "Counted as a condition of failure:".
#

#
# Chapter 0, Introduction
#

pmc:ChaosMagicOctaImaginaryGodsReal a pm:Conceptualizing ;
    rdfs:label "Imagined gods act like supposedly real ones"@en, "Imaginierte Götter wirken wie angeblich reale"@de ;
    skos:definition "Chaos magic is credited with freeing magic from religious symbolism and theology by showing that gods and spirits taken as imaginary produce the same effects as those held to be real; from this it began recasting magic in the symbols of science, psychology and parapsychology."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 0 Introduction, p. 7; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaRealityThroughImagination a pm:Conceptualizing ;
    rdfs:label "Reality made chiefly through imagination"@en, "Wirklichkeit vor allem durch Imagination gemacht"@de ;
    skos:definition "Reality is said to follow art, because art explores imagination and people produce their reality mainly by imagining, or by failing to."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 0 Introduction, p. 7; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaOctarineEfficacy a pm:Conceptualizing ;
    rdfs:label "Pratchett's Octarine as magically effective"@en, "Pratchetts Oktarin als magisch wirksam"@de ;
    skos:definition "Chaoists are said to have taken over Terry Pratchett's notion of Octarine, to have found it unusually potent in magic, and since then to search his Discworld novels for further material."@en ;
    skos:note "The colour itself as the magician's perception of magic is entered from Liber Kaos as pmc:ChaosMagicOctarine; here only the claim of its efficacy and the use of the novels as a source."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 0 Introduction, p. 8; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaRoundworldApproximation a pm:Conceptualizing ;
    rdfs:label "Roundworld: mostly causal, with a small share of magic"@en, "Rundwelt: überwiegend kausal, mit kleinem Anteil Magie"@de ;
    skos:definition "The teaching device of the Science of Discworld books, magic alone there and science alone here, is called a rough approximation: some science operates on Discworld, and this world also has some share of chance, caprice and wishes granted at once, only a smaller share."@en ;
    skos:note "A statement of how fixed the work holds its own framing device to be."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 0 Introduction, p. 8; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaStricterCausality a pm:Conceptualizing ;
    rdfs:label "Stricter causality demands more sorcery here"@en, "Strengere Kausalität verlangt hier mehr Zauberei"@de ;
    skos:definition "Because lightspeed is far higher and Planck's constant far lower here than on Discworld, causality is stricter in this world and sorcery needs considerably more effort to overcome it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 0 Introduction, p. 9; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaPeopleHostGods a pm:Conceptualizing ;
    rdfs:label "People as hosts of imaginary gods"@en, "Menschen als Wirte imaginärer Götter"@de ;
    skos:definition "Both worlds are said to swarm with imaginary deities that have real effects, since both contain people, who make excellent hosts for such gods."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 0 Introduction, p. 9; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaQuantumStuffMagic a pm:Conceptualizing ;
    rdfs:label "Ill-understood quantum effects behind magic"@en, "Unverstandene Quanteneffekte hinter der Magie"@de ;
    skos:definition "As Discworld wizards blame their unexplained science on quantum matters, so in this world poorly understood quantum phenomena probably account for much of its poorly understood magic."@en ;
    skos:note "Hedged in the text as probable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 0 Introduction, p. 9; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaApopheniaNaming a pm:Naming ;
    rdfs:label "Apophenia"@en, "Apophenia"@de ;
    skos:definition "A goddess named after the quirk of perceiving meanings and links between phenomena that others miss; the patroness of ideas no one expected and their muse, she is invoked as a beautiful muse for inspiration and is credited with hints for the book. Her invocation is referred to The Apophenion."@en ;
    skos:note "The goddess as entered from The Apophenion is pmc:ChaosMagicApophApopheniaGoddessNaming; the faculty she is named from is pmc:ChaosMagicOctaApophenicFaculty."@en ;
    pm:nameForm "Apophenia" ;
    pm:nameRole "goddess and muse of unforeseen ideas; invoked for inspiration" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 0 Introduction; ch. 3 The Spells of Illusion, pp. 9, 69; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaRoundworldOctavoReply a pm:Receiving ;
    rdfs:label "Apophenia's reply on a Roundworld Octavo"@en, "Apophenias Antwort zu einem Rundwelt-Oktavo"@de ;
    skos:definition "Asked during an invocation whether this world hides its own version of the Discworld creation manual, the goddess is reported to have cackled and said yes, warning against confusing it with a Necronomicon that fell in from elsewhere and partly broke apart, and saying that a stranger and more frightening edition holds for this world."@en ;
    pm:receivedBy "Peter J. Carroll, who signs the introduction as Stokastikos; the sentence does not say who put the question" ;
    pm:claimedSpeaker "Apophenia, goddess and muse of unforeseen ideas" ;
    pm:receptionCircumstance "During an invocation; no date, state of the invoker or record of the wording is given beyond the reply set in quotation marks." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 0 Introduction, p. 9; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaGrimoireByApophenia a pm:Receiving ;
    rdfs:label "The grimoire as given by Apophenia and Ouranos"@en, "Das Grimoire als Gabe von Apophenia und Ouranos"@de ;
    skos:definition "The Roundworld Octavo is said to be pieced together from fragments found in chaoist classics, from what Arcanorium College keeps in its vaults and in its members' heads, and from hints slyly dropped by Apophenia; later the book is credited in large part to the favour of Apophenia and Ouranos."@en ;
    pm:receivedBy "Peter J. Carroll, the author" ;
    pm:claimedSpeaker "Apophenia, giving hints; Ouranos named beside her as a source of grace" ;
    pm:receptionCircumstance "No occasion, state or wording of the hints is given; they stand beside written fragments and the collective work of Arcanorium College as one of three sources." ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 0 Introduction; ch. 3 The Spells of Illusion, pp. 10, 69; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaEightSpells a pm:Systematizing ;
    rdfs:label "Eight spells that structure reality"@en, "Acht Zauber, die die Wirklichkeit strukturieren"@de ;
    skos:definition "The grimoire has eight chapters, each headed by one of the great spells said to structure this reality, put tersely in mathematical form and then explained with practical examples: 1 Binding; 2 Spinning (vorticitation, frequency); 3 Illusion (redshift, hyperspherical lensing); 4 Subtle Magic (energy, entropy and information indeterminacy); 5 Linking (three-dimensional time, entanglement, superposition); 6 Impractical Magic (spell and antispell); 7 Practical Magic; 8 Narration."@en ;
    skos:note "The terse mathematical form is said to be chosen to put off the merely curious, and jokingly for safety. The equations are garbled in the text layer and only their names are entered."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 0 Introduction; The Grimoire: The Spells in Algebraic Form, pp. 10, 13-14; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaRitualDevelopment a pm:Systematizing ;
    rdfs:label "How the Magical Ritual is built up through the book"@en, "Aufbau des Magischen Rituals im Verlauf des Buches"@de ;
    skos:definition "The Magical Ritual grows chapter by chapter: first centring, then encircling, then the gods are added; next come chaometry, the bending of probability and the magical link, leading to parapsychological action; last come the consequences of magical action."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 0 Introduction, p. 10; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaCollateralDamageCautela a pm:Cautioning ;
    rdfs:label "Read the whole book first and avoid collateral damage"@en, "Erst das ganze Buch lesen und Kollateralschäden vermeiden"@de ;
    skos:definition "Since the consequences of magical action are treated only at the end, which the author admits should perhaps have come first, the reader is told to finish the entire grimoire before attempting any of it and to avoid collateral damage on a rather small planet."@en ;
    pm:cautionsAbout pmp:ChaosMagicOctaMagicalRitual ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 0 Introduction, p. 10; read in a full-text layer of the first edition" .


#
# Dedications
#

pmc:ChaosMagicOctaQuantityElucidatesQuality a pm:Conceptualizing ;
    rdfs:label "Quantitative analysis illuminates qualitative analysis"@en, "Quantitative Analyse erhellt die qualitative"@de ;
    skos:definition "Glossing a saying of Leibniz, the work holds that without some theory of how much one cannot understand philosophy, and without some theory of how one understands nothing; mathematics is at root only a matter of how much, and the reader is warned of algebra ahead."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Dedications, pp. 11-12; read in a full-text layer of the first edition" .


#
# Chapter 1, The Spells of the Binding
#

pmc:ChaosMagicOctaFiveAeons a pm:Systematizing ;
    rdfs:label "Five aeons of the Map of reality"@en, "Fünf Äonen der Landkarte der Wirklichkeit"@de ;
    skos:definition "The growth of the Map of reality is set out in aeons: first shamanic, second pagan, third monotheist, fourth atheist and scientific, and fifth the pandaemon-aeon, which opens with the Death of Certainty. The aeons mark progressions of ideas and cultural paradigms, not exact historical periods, and remnants of earlier aeons persist beside later ones."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, pp. 15-20; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaShamanicMagicRange a pm:Conceptualizing ;
    rdfs:label "Shamanic magic works within its range"@en, "Schamanische Magie wirkt in ihrer Reichweite"@de ;
    skos:definition "Shamanic magic, built on maps reaching no further than one could walk, see or intuit, is said still to work fairly well, above all for work within sight, inside the village or the hunting range, and now and then just past the horizon of perception, as with the next day's weather or a battle."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, p. 15; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaAgainstKabbalisticTree a pm:Conceptualizing ;
    rdfs:label "Monotheist grimoires and the Tree of Life judged meagre"@en, "Monotheistische Grimoires und der Lebensbaum als dürftig beurteilt"@de ;
    skos:definition "Grimoires of the monotheist period are judged mostly dull, conjuring spirits by invoking God or the Devil for mundane ends with secret wisdom lost; the Kabbalistic Tree of Life is judged primitive, holding little beyond the planets the ancients knew and some pagan psychology under a monotheist gloss."@en ;
    skos:note "A dispute of the work with monotheist-era grimoires and Kabbalah; the other side is not read."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, pp. 16-17; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaHermeticismMistranslation a pm:Conceptualizing ;
    rdfs:label "Hermeticism as translated Egyptian magic, its symmetry upheld"@en, "Hermetik als übersetzte ägyptische Magie, ihre Symmetrie bestätigt"@de ;
    skos:definition "Hermeticism is held to have been an attempt to render Egyptian magical texts in Greek, with the errors that brings, its Thrice-Great Hermes probably a whole school of esotericists of the first and second centuries; yet the as-above-so-below symmetry it proclaimed is later said to have been intuited correctly, since cosmos and particles share one geometry."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, pp. 18, 23; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaThreeCosms a pm:Systematizing ;
    rdfs:label "Macrocosm, Midicosm, Microcosm"@en, "Makrokosmos, Midikosmos, Mikrokosmos"@de ;
    skos:definition "The Map is divided into three ranges of size: the Macrocosm, reaching from planets to the edge of the universe; the Midicosm, from the least things visible unaided up to planets; and the Microcosm, from bacteria to quantum dimensions."@en ;
    skos:note "The powers of ten given for the ranges are garbled in the text layer and are not entered."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, p. 19; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaDeathOfCertainty a pm:Conceptualizing ;
    rdfs:label "The Death of Certainty"@en, "Der Tod der Gewissheit"@de ;
    skos:definition "The fifth aeon begins where atheism ends in nihilism: cultural relativism made all values situational, neurophysiology replaced the unitary self with a neo-pagan multimind, and quantum physics replaced causality with chance; the God hypothesis of the third aeon and the Causality hypothesis of the fourth now look like wishful thinking."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, pp. 19-20; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaAgainstFlatUniverse a pm:Conceptualizing ;
    rdfs:label "Against flat-universe big bang cosmology"@en, "Gegen die Urknallkosmologie des flachen Universums"@de ;
    skos:definition "Flat-universe theory, with its singularity, its changing rates of expansion and its undetected dark matter and energy, is called an ever more grotesque mess akin to old maps with phlogiston and sea monsters; hypersphere theory is offered as its overdue replacement."@en ;
    skos:note "A dispute of the work with mainstream cosmology; the other side is not read."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, pp. 20-21; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaSpellOfBinding a pm:Conceptualizing ;
    rdfs:label "The Spell of the Binding"@en, "Der Zauber der Bindung"@de ;
    skos:definition "The first spell sets the universe's mass over its length to the antipode equal to lightspeed squared over the gravitational constant; it is said to hold everything together literally, to hold also for every fundamental particle with its wavelength as length, so uniting microcosm and macrocosm, and any three of its terms are said to fix the fourth. A corollary gives an acceleration that measures the size of the universe."@en ;
    skos:note "The text gives only the equation and its reading, no act for the magician to perform; it is entered as a concept."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, pp. 21-22; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaThreeDimensionalTimeMedium a pm:Conceptualizing ;
    rdfs:label "Three-dimensional time as the medium of magic"@en, "Dreidimensionale Zeit als Medium der Magie"@de ;
    skos:definition "The following chapters are announced as arguing for a time of three dimensions that provides the medium of magic, for which older grimoires used vague names such as higher dimensions or astral planes."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, p. 22; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaHypersphericalUniverse a pm:Conceptualizing ;
    rdfs:label "Universe and particles as hyperspheres"@en, "Universum und Teilchen als Hypersphären"@de ;
    skos:definition "Universe and fundamental particles are modelled alike as hyperspheres (3-spheres), finite yet unbounded in space and time and closed by an escape velocity of about root two times lightspeed; one can return to where or to when one started but not to both, so no grandfather paradox arises. Particles have a minimum size tied to Planck's constant and no room for anything to fall in."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, pp. 22-24; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaNonlocalityRandomnessRoots a pm:Conceptualizing ;
    rdfs:label "Non-locality and randomness as the roots of magic"@en, "Nichtlokalität und Zufall als Wurzeln der Magie"@de ;
    skos:definition "The structure of the macrocosm produces the non-local, and that of the microcosm the random, aspects of reality at human scale; these aspects produce odd, newly recognised scientific effects and are said to be the source of what has for millennia gone by the name of magic."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, pp. 23-24; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctaHypercubeVisualisation a pm:Practicing ;
    rdfs:label "Picturing closed space with hypercube and square tori"@en, "Geschlossenen Raum mit Hyperwürfel und Vierkanttori vorstellen"@de ;
    skos:definition "Draw a cube as two squares joined at their corners; model a hypercube the same way as two cubes joined at their corners (cocktail sticks and glue); follow a straight path from one outer cube round a ring of four and so back to the start; then imagine three tori of square section, folded from paper, joining opposite outer faces, to show how the figure connects with itself."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, pp. 24-27; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaVisualisingClosedSpace a pm:Conceptualizing ;
    rdfs:label "Ability to picture finite unbounded space"@en, "Fähigkeit, endlichen unbegrenzten Raum vorzustellen"@de ;
    skos:definition "A hypersphere has no edges for the imagination to hold, so it cannot easily be pictured; a hypercube closed by its own curvature can, and this image is said to serve again for picturing its rotation in chapter 2."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, pp. 24, 27; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaHypercubeYieldsVisualisation a pm:Yielding ;
    rdfs:label "The hypercube model yields an image of closed space"@en, "Das Hyperwürfelmodell ergibt ein Bild des geschlossenen Raums"@de ;
    skos:definition "The hypercube with three square-section tori is said to show how the true topology connects with itself."@en ;
    pm:byPractice pmp:ChaosMagicOctaHypercubeVisualisation ;
    pm:yieldsCapacity pmc:ChaosMagicOctaVisualisingClosedSpace ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, p. 27; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaAndersonDeceleration a pm:Conceptualizing ;
    rdfs:label "The binding corollary as a cosmic deceleration"@en, "Das Bindungskorollar als kosmische Verzögerung"@de ;
    skos:definition "The corollary of the Binding gives a negative acceleration from the universe's curvature, identified with the slight anomalous slowing of deep-space probes; restored to the formula for orbital speed it is said to account for the fast rotation of galaxies without dark matter."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, p. 28; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaBindingIntuited a pm:Conceptualizing ;
    rdfs:label "The binding relation is intuited, not proven"@en, "Die Bindungsrelation ist erahnt, nicht bewiesen"@de ;
    skos:definition "The author grants that the binding relation cannot be proven amid the uncertainty of cosmological data, but intuits that it holds exactly: it gives reasonable mass and length from the measured acceleration, makes cosmic and quantum hyperspheres work alike, is simple and elegant, and in the end yields a realistic model for magic. A universe of constant mass that had expanded could not keep the ratio constant."@en ;
    skos:note "A statement of how tested the work holds its own foundation to be."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, p. 29; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaUbiquityConstant a pm:Conceptualizing ;
    rdfs:label "The Ubiquity constant U"@en, "Die Ubiquitätskonstante U"@de ;
    skos:definition "U, about six times ten to the sixtieth, is the common ratio of the universe's mass, length and time to the corresponding Planck quantities; called Ubiquity since it holds in every place and at every time, it is said also to fix the amounts of information and chaos in the universe and the two basic magical units, Thaum and Prime."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, pp. 29-30; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaContrivingCoincidences a pm:Conceptualizing ;
    rdfs:label "Magic as the contriving of coincidences"@en, "Magie als das Herbeiführen von Zufällen"@de ;
    skos:definition "Remarking that U stands opposite h in an alphabet arranged in a circle, as largest against smallest, the work states in passing that the art of magic consists in contriving coincidences."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, p. 30; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaDynamicMap a pm:Conceptualizing ;
    rdfs:label "An advanced map shows dynamics: as above, so below, and in between"@en, "Eine fortgeschrittene Karte zeigt Dynamik: wie oben, so unten, und dazwischen"@de ;
    skos:definition "A useful map of anything that moves must give its laws of motion, as the solar system can be mapped usefully only by the equations of its planets; an advanced map of the mind would show where it could go next. The Hermetic maxim is extended to the in-between, the midicosm, since the hidden microcosm was unknown to the Hermeticists."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 1 The Spells of the Binding, pp. 30-31; read in a full-text layer of the first edition" .


#
# Magical Ritual 1
#

pmc:ChaosMagicOctaFivePartsOfRitual a pm:Systematizing ;
    rdfs:label "Five parts of the Magical Ritual"@en, "Fünf Teile des Magischen Rituals"@de ;
    skos:definition "The Magical Ritual has five conceptual parts: Centring, in which the magician powers up; Encircling, the link to the macrocosm; Invocation, calling on sources of knowledge and power; Conjuration, the working itself, such as enchanting, divining, evoking or seeking illumination; Banishing, which removes nothing but releases the magic to do what was specified. Chapters 1-3 belong to the first three parts, chapters 4-7 to conjuration, chapter 7 also to banishing, and chapter 8 to what magic implies transcendentally and cosmically."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 1, pp. 32-33; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctaMagicalRitual a pm:Practicing ;
    rdfs:label "The Magical Ritual in full"@en, "Das Magische Ritual in voller Form"@de ;
    skos:definition "Centre oneself, encircle to connect with the macrocosm, invoke the chosen sources of power or knowledge, conjure (enchant, divine, evoke or seek illumination), and banish to set the magic free; built up through the book, it serves for daily practice or for elaborate works of any kind."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 1, pp. 32-33; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaConsistentResults a pm:Conceptualizing ;
    rdfs:label "Consistently useful practical magic"@en, "Beständig brauchbare praktische Magie"@de ;
    skos:definition "Getting useful magical results reliably rather than now and then by luck."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 1, p. 33; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaRitualYieldsConsistentResults a pm:Yielding ;
    rdfs:label "The full ritual yields consistent results"@en, "Das volle Ritual ergibt beständige Ergebnisse"@de ;
    skos:definition "Decades of careful research are said to show that practical magic works best when all five parts of the ritual are used."@en ;
    skos:note "A statement of testedness; no research is cited."@en ;
    pm:byPractice pmp:ChaosMagicOctaMagicalRitual ;
    pm:yieldsCapacity pmc:ChaosMagicOctaConsistentResults ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 1, p. 33; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaSymbolsAsAlgebra a pm:Conceptualizing ;
    rdfs:label "Magical symbols work like algebraic letters"@en, "Magische Symbole wirken wie algebraische Buchstaben"@de ;
    skos:definition "The ritual rests on no ancient or sacred symbolism: symbol systems function like the letters of algebra, where it does not matter which letters or alphabets stand for the concepts, only what the concepts mean and how they relate; magicians adapt the symbols to taste and personal meaning."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 1, p. 32; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaRitualShortenable a pm:Conceptualizing ;
    rdfs:label "The ritual may be shortened; no part is indispensable"@en, "Das Ritual ist kürzbar; kein Teil ist unentbehrlich"@de ;
    skos:definition "Where needed the magician can shorten the ritual for rapid action, and none of its parts is held indispensable."@en ;
    skos:note "A statement of how fixed the method is; it stands beside the claim that only the full form gives consistent results."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 1, p. 32; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaShortcutsFailure a pm:Conceptualizing ;
    rdfs:label "Shortcuts give only occasional results"@en, "Abkürzungen bringen nur gelegentliche Ergebnisse"@de ;
    skos:definition "Where parts of the ritual are left out through laziness, ignorance or emergency, impressive or lucky results occur only now and then."@en ;
    skos:note "Counted as a condition of failure: an incomplete ritual gives results only occasionally, not consistently. No deadline; the failure is put on the operator who skipped parts, though emergency is named as a cause beside laziness and ignorance."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 1, p. 33; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaFullTechniqueRequired a pm:Presupposing ;
    rdfs:label "Consistent results require the full technique"@en, "Beständige Ergebnisse verlangen die volle Technik"@de ;
    skos:definition "For results that are useful consistently, aspiring magicians should learn the whole five-part technique."@en ;
    pm:priorStep pmp:ChaosMagicOctaMagicalRitual ;
    pm:dependentStep pmc:ChaosMagicOctaConsistentResults ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Without the full technique, useful results come only occasionally or by luck." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 1, p. 33; read in a full-text layer of the first edition" .


#
# Magical Ritual part 1, Centring
#

pmc:ChaosMagicOctaChatteringMindFailure a pm:Conceptualizing ;
    rdfs:label "The chattering, dualistic mind defeats intent"@en, "Der plappernde, dualistische Geist vereitelt die Absicht"@de ;
    skos:definition "The chattering mind is named the major obstacle to magical intent: ordinary thinking runs dualistically, so each thought or desire at once calls up its own negation, as doubt, fear, questioning or another thought, which alters it or pulls away from it."@en ;
    skos:note "Counted as a condition of failure: intent broken by the internal dialogue. No deadline; the failure is put on the operator's own mind, not on the target. The prerequisite drawn from the same passage is pmc:ChaosMagicSilentiumInternum, already in the record and not repeated here."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring, p. 34; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaStoppedThoughtCautela a pm:Cautioning ;
    rdfs:label "A stilled mind can also make terrible mistakes"@en, "Ein stiller Geist kann auch schreckliche Fehler machen"@de ;
    skos:definition "Whoever can stop thinking can do almost anything, the text adds in a parenthesis, terrible mistakes included."@en ;
    pm:cautionsAbout pmc:ChaosMagicSilentiumInternum ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring, p. 34; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaGnosis a pm:Conceptualizing ;
    rdfs:label "Gnosis, single-pointed awareness"@en, "Gnosis, einspitzige Bewusstheit"@de ;
    skos:definition "The aim of centring: a word taken over from western esotericism of the first century for the strangely withdrawn state of one-pointed awareness in which almost all else in the universe drops away; eastern esotericism knows it as dhyana in raja yoga and by names such as samadhi in Buddhist schools."@en ;
    skos:note "The reading of this state as neurological quantum coherence is entered as pmc:ChaosMagicCohaerentiaNeurologica and is not repeated here."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring, p. 34; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctaQuickCentring a pm:Practicing ;
    rdfs:label "Quick centring"@en, "Schnelle Zentrierung"@de ;
    skos:definition "Close the eyes and centre within seconds, either by fierce concentration on one simple visualisation or by concentrating on reaching a still point beneath the creative chaos within."@en ;
    skos:note "Said to work for some magicians, sometimes, with practice; the ritual centring is offered as the reliable way."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring, pp. 34-35; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaQuickCentringYieldsGnosis a pm:Yielding ;
    rdfs:label "Quick centring sometimes yields the centred state"@en, "Schnelle Zentrierung ergibt manchmal den zentrierten Zustand"@de ;
    skos:definition "Some magicians are said, with practice and not every time, to centre themselves within seconds this way."@en ;
    pm:byPractice pmp:ChaosMagicOctaQuickCentring ;
    pm:yieldsCapacity pmc:ChaosMagicOctaGnosis ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring, pp. 34-35; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctaRitualCentring a pm:Practicing ;
    rdfs:label "Ritual centring with five images and vowels"@en, "Rituelle Zentrierung mit fünf Bildern und Vokalen"@de ;
    skos:definition "Fiercely visualise five images in turn from the top while vibrating the vowel belonging to each for one whole long out-breath: the Chaos Star or Octaris (I, brow), the Tellus glyph (E, throat), the upright pentagram (A, heart), the pentagram with two points up (O, solar plexus), and the circled cross (U, genital-peritoneal area); repeat the lowest, work back up, and finish with a final visualisation. The meanings attributed to images and sounds are to be known but kept subconscious while performing."@en ;
    skos:note "The chart of images (Fig. 4, GCR diagrams, p. 37) is not legible in the text layer; the images, places and vowels are put together from the prose of pp. 36 and 38-40."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring, pp. 35-36, 38-40; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaCentredModeAtWill a pm:Conceptualizing ;
    rdfs:label "Entering the centred mode at will"@en, "Willentlicher Eintritt in den zentrierten Modus"@de ;
    skos:definition "Reliable access to the centred state whenever wished, the internal dialogue being paralysed for a time and the mind readied to deal with microcosm and macrocosm."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring, p. 35; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaRitualCentringYieldsCentredMode a pm:Yielding ;
    rdfs:label "Ritual centring yields the centred mode"@en, "Rituelle Zentrierung ergibt den zentrierten Modus"@de ;
    skos:definition "Relying chiefly on visualising, controlling the breath and vibrating sounds, the ritual centring is said to give reliable entry, whenever wished, into the centred state, a move towards gnosis."@en ;
    pm:byPractice pmp:ChaosMagicOctaRitualCentring ;
    pm:yieldsCapacity pmc:ChaosMagicOctaCentredModeAtWill, pmc:ChaosMagicOctaGnosis ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring, p. 35; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaCentringToAutomaticity a pm:Presupposing ;
    rdfs:label "Centring must be practised until automatic"@en, "Zentrierung muss bis zur Automatik geübt werden"@de ;
    skos:definition "The ritual centring gives good results only once learnt and practised until it runs perfectly, without thought, automatically and free of stray thoughts; the magician should be familiar with what the symbols mean yet let these meanings stay subconscious during the performance."@en ;
    pm:priorStep pmp:ChaosMagicOctaRitualCentring ;
    pm:dependentStep pmc:ChaosMagicOctaCentredModeAtWill ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Until the centring runs automatically and free of stray thoughts it does not give good results." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring, pp. 35, 38; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaWanderingThoughtsFailure a pm:Conceptualizing ;
    rdfs:label "Wandering thoughts and conscious attributions spoil the centring"@en, "Abschweifende Gedanken und bewusste Zuordnungen verderben die Zentrierung"@de ;
    skos:definition "The centring fails to give good results while it is not yet automatic, while stray thoughts intrude, or while the symbolic attributions are held in conscious mind."@en ;
    skos:note "Counted as a condition of failure: a centring not yet automatic, tainted by wandering thoughts or performed with the attributions held consciously. No deadline; the failure is put on the operator's training."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring, p. 35; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaVowelResonanceSuccess a pm:Conceptualizing ;
    rdfs:label "The vowels resonate in the body"@en, "Die Vokale schwingen im Körper mit"@de ;
    skos:definition "The vibrated sounds tend to set up a sympathetic vibration in matching parts of the body: I at the brow or third eye, E at the throat, A at the heart, O at the solar plexus, and a low U in the genital and peritoneal region."@en ;
    skos:note "Counted as a sign of success: a felt vibration in the matching body region while the vowel is intoned. No deadline; the text gives it as a tendency of the sounds, not as a test of whether the centring worked."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring, p. 36; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaSubtleAnatomySymbolic a pm:Conceptualizing ;
    rdfs:label "Subtle anatomy as a useful symbol"@en, "Feinstoffliche Anatomie als nützliches Symbol"@de ;
    skos:definition "The subtle anatomy of the many oriental systems of chakras, meridians and chi, which contradict one another, has no objective reality and cannot be found with scalpel or microscope; yet as a symbolic representation it gives a means of acting on objective reality by magic, and those attempting harder manoeuvres use more elaborate models of it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring, p. 35; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaFiveSpheres a pm:Systematizing ;
    rdfs:label "Five spheres of the centring"@en, "Fünf Sphären der Zentrierung"@de ;
    skos:definition "The centring symbols are given meanings and places: Chaos Star or Octaris, the Panpsychosphere, at the brow, I; Tellus, the Noosphere or Memesphere, at the throat, E; upright pentagram, the Anthrosphere or Opusphere (humanity, the human form as basic tool), at the heart, A; pentagram with two points up, a simplified Baphomet, the Biosphere, at the solar plexus, O; circled cross, the Geosphere (rock, water, air and energy of the planet), at the genital-peritoneal area, U."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring, pp. 36, 38-40; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaPanpsychicHypothesis a pm:Conceptualizing ;
    rdfs:label "The Panpsychic Hypothesis"@en, "Die panpsychische Hypothese"@de ;
    skos:definition "The intuition used by magicians, sorcerers and shamans that every phenomenon behaves to some degree as if animate, in the modern view depending on its quantum characteristics; this or something close to it is called the fundamental inductive step, taken from what is observed and experienced, on which the magical paradigm rests."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring, p. 38; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaPanpsychosphere a pm:Conceptualizing ;
    rdfs:label "The Panpsychosphere"@en, "Die Panpsychosphäre"@de ;
    skos:definition "The sphere of all possibilities, apparent impossibilities included: the aethers or astral planes, read as quantum waves, in which material reality splits into many-dimensional Apophusis and in which, as Apophasis, unreal events subtend real effects in the lower worlds; a cosmic imagination out of which emergent phenomena spring unbidden in every lower sphere, and which kindles personal creativity. Its symbolic place is the brow."@en ;
    skos:note "The author grants that words hardly convey it and that the mathematics is worse."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring, pp. 38-39; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaNoosphere a pm:Conceptualizing ;
    rdfs:label "The Noosphere or Memesphere"@en, "Die Noosphäre oder Memsphäre"@de ;
    skos:definition "Everything that exists as idea, belief, religion, philosophy, emotion, hope or terror, produced by whatever can produce it, chiefly complex organisms but perhaps other creatures too; all information held in mental form, hence placed at the throat, where speech makes thought shareable. Its Tellus symbol comes from a little-known astronomical sign for the earth and also suggests ideas meeting, parting and overlapping."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring, p. 39; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaBaphometNaming a pm:Naming ;
    rdfs:label "Baphomet"@en, "Baphomet"@de ;
    skos:definition "The androgynous goat-human image taken with its name and part of its mythos from Eliphas Levi, who drew on the Templar legends. Its pentagram form with two points up stands in the centring for the Biosphere, since the image sums up plant, animal and human symbolism; as a god-form the author invokes it as embodying animal vitality, sexuality and the wisdom accumulated by biological evolution, by personification or full possession, and keeps a dedicated servitor for it."@en ;
    skos:note "Its invocation is referred to the Mass of Chaos (B) in Liber Null & Psychonaut."@en ;
    pm:nameForm "Baphomet" ;
    pm:nameRole "symbol of the Biosphere in the centring; god-form of animal vitality, sexuality and evolutionary wisdom" ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring; ch. 3 The Spells of Illusion, pp. 40, 68-69; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaSecondCentringCautela a pm:Cautioning ;
    rdfs:label "A second centring after encircling may be counterproductive"@en, "Eine zweite Zentrierung nach dem Umkreisen kann schaden"@de ;
    skos:definition "Several published rituals repeat the centring after the encircling; exhaustive research is said to show this unnecessary and possibly counterproductive when further conjuration is to follow, the custom coming from traditions where participants went on to meditation rather than magic."@en ;
    pm:cautionsAbout pmp:ChaosMagicOctaRitualCentring ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring, p. 38; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaCentringThenEncircling a pm:Presupposing ;
    rdfs:label "Centring, then encircling, then straight to conjuration"@en, "Zentrieren, dann Umkreisen, dann direkt zur Konjuration"@de ;
    skos:definition "For direct follow-through to magical action, technical opinion is said to favour centring, encircling and then going straight on to conjuration, keeping any second centring for a closing banishing where one is wanted."@en ;
    pm:priorStep pmp:ChaosMagicOctaRitualCentring ;
    pm:dependentStep pmp:ChaosMagicOctaEncircling ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 1, Centring, p. 38; read in a full-text layer of the first edition" .


#
# Chapter 2, The Spells of the Spinning
#

pmc:ChaosMagicOctaSpellOfSpinning a pm:Conceptualizing ;
    rdfs:label "The Spell of the Spinning (vorticitation)"@en, "Der Zauber des Wirbelns (Vortizitation)"@de ;
    skos:definition "Where the Binding holds universe and particles together, the Spinning keeps them from imploding, so everything exists in a dynamic balance of the two. Hyperspheres spin about several axes at once, a spin called vorticitation that periodically swaps all opposite points, flipping things into their mirror form and back again; it gives particles their wavelength and frequency, swings the universe between matter and antimatter over about eleven billion years, supplies just enough centrifugal effect to offset its small positive curvature, and is said to create time."@en ;
    skos:note "Adapted, the text says, from an equation of Godel for a spinning universe. Only the equation and its reading are given, no act for the magician; it is entered as a concept."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 2 The Spells of the Spinning, pp. 41-43; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaUniversalClock a pm:Conceptualizing ;
    rdfs:label "Vorticitation as the Universal Clock"@en, "Vortizitation als Universaluhr"@de ;
    skos:definition "Like the Universal Clock of Discworld, which tells time what it is rather than what time it is, vorticitation makes time; its dial is unmarked in a finite and unbounded spacetime and markers are set to suit ourselves. Its chief effect at human scale is to give time three dimensions."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 2 The Spells of the Spinning, pp. 42-43; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaNoStaticBeing a pm:Conceptualizing ;
    rdfs:label "No static being, no soul"@en, "Kein statisches Sein, keine Seele"@de ;
    skos:definition "Since everything exists only because it or its parts spin, nothing has static being; it follows that we have no underlying being now, still less before or after death, and no soul or fixed inner self, as watching an infant gain consciousness or an old person lose it to dementia is said to show. The realisation is called liberating and perhaps horrifying."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 2 The Spells of the Spinning, p. 44; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctaRotatingHypercube a pm:Practicing ;
    rdfs:label "Picturing the rotating hypercube"@en, "Den rotierenden Hyperwürfel vorstellen"@de ;
    skos:definition "Since spinning hyperspheres show no edges, picture instead a hypercube turning, first through one of its three orthogonal planes as in the figure, then through all three at once, watching edges and faces pass."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 2 The Spells of the Spinning, pp. 44-45; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaRotatingHypercubeYields a pm:Yielding ;
    rdfs:label "The rotating hypercube yields an impression of vorticitation"@en, "Der rotierende Hyperwürfel ergibt einen Eindruck der Vortizitation"@de ;
    skos:definition "A spinning hypercube is said to give some impression of how vorticitation of a hypersphere would appear."@en ;
    pm:byPractice pmp:ChaosMagicOctaRotatingHypercube ;
    pm:yieldsCapacity pmc:ChaosMagicOctaVisualisingClosedSpace ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 2 The Spells of the Spinning, pp. 44-45; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaAgainstBosonExchange a pm:Conceptualizing ;
    rdfs:label "Against boson exchange as the cause of attraction"@en, "Gegen Bosonenaustausch als Ursache der Anziehung"@de ;
    skos:definition "The particle-physics model of forces as exchanges of force-carrying bosons between matter particles may explain repulsion by recoil but cannot explain how emitting a particle could draw a third one closer; general relativity explains attraction geometrically instead, and HD8 is said to extend that to all forces."@en ;
    skos:note "A dispute of the work with the standard model of forces; the other side is not read."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 2 The Spells of the Spinning, p. 46; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaHD8SpinTorsion a pm:Conceptualizing ;
    rdfs:label "HD8: forces as spin and torsion of spacetime"@en, "HD8: Kräfte als Spin und Torsion der Raumzeit"@de ;
    skos:definition "The HD8 hypothesis holds that all force fields arise from kinds of spin in fundamental particles twisting spacetime: any twist weakly attracts any other (gravity); opposite twists attract and may cancel, exactly opposite particles annihilating; like twists make a bigger twist that spacetime resists, so they repel. Spacetime itself is the medium, needing no virtual force carriers, but the map must have eight dimensions, which is said also to explain superposition, entanglement and magical links."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 2 The Spells of the Spinning, pp. 46-49; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctaElasticBandTwist a pm:Practicing ;
    rdfs:label "Twisting an elastic band to model gravity"@en, "Ein Gummiband verdrehen, um Gravitation darzustellen"@de ;
    skos:definition "Grip two points of a rubber sheet or trampoline, or put a couple of twists into an elastic band, turning them in the same or opposite directions, and note that the tension between the points rises either way; this models gravity as torsion."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 2 The Spells of the Spinning, p. 47; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaEightDimensionalGeometry a pm:Conceptualizing ;
    rdfs:label "Eight-dimensional spin mechanics as the way to unify forces"@en, "Achtdimensionale Spinmechanik als Weg zur Vereinheitlichung"@de ;
    skos:definition "A geometrodynamics in eight dimensions is held a better hope than quantum gravity for unifying the forces and healing the rift between relativity and quantum physics, leading on to starships, teleportation and magic. The idea that reality runs on geometry is traced to Pythagorean mystery schools, the Illuminati and higher Freemasons, and Discworld witches who grant that magic depends on Jommetry."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 2 The Spells of the Spinning, p. 49; read in a full-text layer of the first edition" .


#
# Magical Ritual 2, Encircling
#

pmp:ChaosMagicOctaEncircling a pm:Practicing ;
    rdfs:label "Encircling with chaos stars"@en, "Umkreisen mit Chaossternen"@de ;
    skos:definition "Having centred, turn anticlockwise and draw big chaos stars in the imagination towards each quarter, perhaps also overhead and underfoot, best with eyes closed, pointing with a finger or a designated instrument; reinforce with the IEAOU vibration, one vowel for each of the four crossing lines of the star and the final U sent to its centre."@en ;
    skos:note "The section is subtitled Apophenia's spacetime-dance."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 2, Encircling, pp. 51-53; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaMapAttunement a pm:Conceptualizing ;
    rdfs:label "Attuning to the universe by activating the Map"@en, "Einstimmung auf das Universum durch Aktivierung der Landkarte"@de ;
    skos:definition "Attuning the centred magician to the rest of the universe, above and below the midicosm, by switching on the Map of reality held in the subconscious, which forms the link to the world outside."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 2, Encircling, p. 51; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaEncirclingYieldsMap a pm:Yielding ;
    rdfs:label "Encircling yields access to the Map"@en, "Umkreisen ergibt Zugang zur Landkarte"@de ;
    skos:definition "Calls to the quarters, magic circles, circle dances and spinning on the spot, widely misunderstood, are said mainly to switch on the subconscious Map; the encircling is an attempt to reach it."@en ;
    pm:byPractice pmp:ChaosMagicOctaEncircling ;
    pm:yieldsCapacity pmc:ChaosMagicOctaMapAttunement ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 2, Encircling, p. 51; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaOnlyWhatIsMapped a pm:Conceptualizing ;
    rdfs:label "Magic reaches only what is in the Map"@en, "Magie erreicht nur, was in der Landkarte steht"@de ;
    skos:definition "A magician can act magically only on what appears, if only as a symbol, in his or her own Map of Reality; a working magical link to anything needs a reasonably faithful picture of it in one's head."@en ;
    skos:note "Recorded by the first pass as a prerequisite; the text names no step that comes first, so it is entered as a concept."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 2, Encircling, p. 51; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaTotalConnectionImpossible a pm:Conceptualizing ;
    rdfs:label "Connecting with the whole universe is impossible"@en, "Verbindung mit dem ganzen Universum ist unmöglich"@de ;
    skos:definition "Connecting with the entire universe is called improbable in theory and impossible in practice, and few magicians need events in distant galaxies or below the molecular scale; the encircling must therefore stay compact and use something that sums up the whole Map."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 2, Encircling, p. 51; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaCirclesDoNotProtectCautela a pm:Cautioning ;
    rdfs:label "Magic circles give little defence; only counter-spells work"@en, "Magische Kreise schützen kaum; nur Gegenzauber wirken"@de ;
    skos:definition "In the author's experience magic circles have little defensive value; only counter-spells really work."@en ;
    pm:cautionsAbout pmp:ChaosMagicOctaEncircling ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 2, Encircling, p. 51; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctaPentagramEncircling a pm:Practicing ;
    rdfs:label "Encircling with pentagrams to the quarters"@en, "Umkreisen mit Pentagrammen in die vier Richtungen"@de ;
    skos:definition "Draw pentagrams to the four quarters; said possibly to suffice for those who can refer everything to the five classical elements, or in their modern reading to space, time, mass, energy plus information. Merely acknowledging north, south, east and west is called inadequate."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 2, Encircling, pp. 51-52; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaGodsAfterEncircling a pm:Presupposing ;
    rdfs:label "Call the gods in the Empowering, after the encircling"@en, "Die Götter in der Ermächtigung rufen, nach dem Umkreisen"@de ;
    skos:definition "Calling surrounding gods and spirits may belong to a traditional encircling but is now better kept for more precise work in the Empowering that follows it."@en ;
    pm:priorStep pmp:ChaosMagicOctaEncircling ;
    pm:dependentStep pmp:ChaosMagicOctaEmpowerment ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 2, Encircling, p. 52; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaGlyphApophenia a pm:Conceptualizing ;
    rdfs:label "A glyph recalls the whole Map by subconscious apophenia"@en, "Ein Glyph ruft die ganze Landkarte durch unbewusste Apophänie auf"@de ;
    skos:definition "Chaos magicians favour the Octaris or Chaos-Star, standing for all major god-forms, the elements, every dimension of the universe together with its indeterminacy, yet simple to visualise; such glyphs work by subconscious apophenia, calling up the stored Map much as a familiar book jacket brings back the book, or a letter of algebra a whole concept."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 2, Encircling, p. 52; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaAnticlockwiseTurning a pm:Conceptualizing ;
    rdfs:label "Anticlockwise turning matches the present spin"@en, "Linksdrehung entspricht dem gegenwärtigen Spin"@de ;
    skos:definition "The magician may turn anticlockwise because anticlockwise spins are said to predominate at all levels in the current phase of the vorticitation cycle."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 2, Encircling, p. 52; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaClosedEyesCautela a pm:Cautioning ;
    rdfs:label "Visualise with closed eyes or be distracted"@en, "Mit geschlossenen Augen visualisieren, sonst Ablenkung"@de ;
    skos:definition "The stars are best drawn with eyes closed, unless one has the rare gift of seeing figures in the air without being distracted by the real scenery; some manage it by looking at a plain wall or at the sky."@en ;
    pm:cautionsAbout pmp:ChaosMagicOctaEncircling ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual 2, Encircling, p. 52; read in a full-text layer of the first edition" .


#
# Chapter 3, The Spells of Illusion
#

pmc:ChaosMagicOctaMysteriesAsChallenges a pm:Conceptualizing ;
    rdfs:label "Mysteries as challenges, not grounds for belief"@en, "Mysterien als Herausforderung, nicht als Glaubensgrund"@de ;
    skos:definition "Arguments from illusion have often been turned into arguments for gods, higher realms and an afterlife, keeping their inconsistencies only by calling them mysteries; yet only by probing the anomalies of our illusory maps can more accurate ones be won, and mysteries should challenge, not invite dumb belief."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 54; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaNoCreatorNoSoul a pm:Conceptualizing ;
    rdfs:label "No creator and no soul required"@en, "Kein Schöpfer und keine Seele nötig"@de ;
    skos:definition "A universe finite and unbounded in space and time needs no almighty creator, and a mind made of modules monitoring one another needs no immortal soul."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 55; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaMakingOwnGods a pm:Conceptualizing ;
    rdfs:label "Putting theory-of-mind circuits to use by making gods"@en, "Theory-of-Mind-Schaltkreise durch Götterschaffen nutzen"@de ;
    skos:definition "The brain's theory-of-mind circuits have their uses and can be employed more modestly and effectively by making one's own magical gods, rather than spent on the megalomaniac idea of a creator who deals with each of us personally."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 55; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaSpellsOfIllusion a pm:Conceptualizing ;
    rdfs:label "The Spells of Illusion: redshift and hyperspherical lensing"@en, "Die Zauber der Illusion: Rotverschiebung und hypersphärische Linsenwirkung"@de ;
    skos:definition "The third spells expose illusions that the build of the universe itself creates: cosmological redshift is read as the overall gravity of the cosmos acting on light crossing it, not as expansion; the faintness of very distant objects is read as lensing by hyperspherical curvature, which brightens galaxies a quarter of the distance across by some twenty per cent, leaves those halfway across unchanged and makes those beyond much fainter. Corrected like a spear-fisher's aim at a fish under water, they remove the need for a big bang, a creator or dark energy."@en ;
    skos:note "The equations are garbled in the text layer and only their reading is entered. No act for the magician is given; it is entered as a concept."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, pp. 56-59; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaAgainstDarkEnergy a pm:Conceptualizing ;
    rdfs:label "Against expansion and dark energy"@en, "Gegen Expansion und dunkle Energie"@de ;
    skos:definition "Orthodox cosmologists are faulted for reading redshift as stretching of spacetime and the faintness of remote objects as an accelerating expansion driven by an undetectable dark energy, instead of correcting for hyperspherical curvature."@en ;
    skos:note "A dispute of the work with mainstream cosmology; the other side is not read."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, pp. 56-57, 59; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaIlluminismAsImposedBelief a pm:Conceptualizing ;
    rdfs:label "Illuminism as belief imposed on ignorance"@en, "Illuminismus als der Unwissenheit aufgezwungener Glaube"@de ;
    skos:definition "Good scientists and magicians practise occultism in the sense of investigating the hidden in search of illumination, yet shun the name for its taint of mystery-mongering and cults; much so-called Illuminism seeks not to solve real mysteries but only imposes belief on ignorance, and every religion is said to have ignorance posing as mystery at its core."@en ;
    skos:note "A dispute of the work with Illuminism and with religion; the other side is not read."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, pp. 59-60; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaShunIlluminatiCautela a pm:Cautioning ;
    rdfs:label "Seek seekers of Illumination, shun its claimants"@en, "Sucher der Erleuchtung suchen, ihre Beansprucher meiden"@de ;
    skos:definition "One should keep to those seeking illumination and avoid anyone who claims to possess it, since too many mysteries remain unsolved or buried under further invented ones."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctaIlluminismAsImposedBelief ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 59; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaWhyHowWhat a pm:Systematizing ;
    rdfs:label "Why, How and What: religion, science and magic"@en, "Warum, Wie und Was: Religion, Wissenschaft und Magie"@de ;
    skos:definition "Religion asks Why and answers with stories ending in a god's will; science asks How and answers with mechanisms that end in quantum indeterminacy or unexplained initial conditions; magic asks What, a phenomenological enquiry which forks into the Essentialist mode, asking what a thing resembles (the apophenic mode of the Doctrine of Signatures), and the Existentialist mode, asking what it actually does."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, pp. 60-61; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaGodsResembleMindStuff a pm:Conceptualizing ;
    rdfs:label "Gods resemble the contents of our heads; their power rests on belief"@en, "Götter gleichen Kopfinhalten; ihre Macht ruht auf Glauben"@de ;
    skos:definition "Asked in the Essentialist mode, gods look suspiciously like things in our own heads; asked in the Existentialist mode, their power depends wholly on our readiness to believe in them, a point Pratchett makes repeatedly about the gods of Discworld."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 61; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaMagicAccommodatesRandomness a pm:Conceptualizing ;
    rdfs:label "Only the magical paradigm accommodates randomness"@en, "Nur das magische Paradigma fasst den Zufall"@de ;
    skos:definition "Randomness means there is neither mechanism nor meaning, so neither How nor Why can explain it in principle; only the magical question What can take it in, and chaos magicians are said to be at ease with it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, pp. 61-62; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaAgainstMonotheism a pm:Conceptualizing ;
    rdfs:label "Against monotheism and against militant atheism"@en, "Gegen den Monotheismus und gegen militanten Atheismus"@de ;
    skos:definition "Most magicians are said to have dropped the monotheist idea of a moody super-god who mostly voices what tribal elders want; monotheist gods are held incoherent unless evil is called a mystery or a Devil is added, which then blinds believers to the difference between harmless fun or curiosity and atrocity. The author distrusts monotheists as lacking humanistic breadth, and faults militant atheists for offering only a near-closed materialism that ignores the weirdness and magic of a vast universe."@en ;
    skos:note "A dispute of the work with monotheism and militant atheism; neither side is read."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, pp. 62, 66-67; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaConstructedGodsPower a pm:Conceptualizing ;
    rdfs:label "Constructed gods as sources of inspiration and power"@en, "Konstruierte Götter als Quellen von Inspiration und Kraft"@de ;
    skos:definition "Well-built gods are said to give inspiration and power to whoever believes in them."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 62; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctaConstructingGods a pm:Practicing ;
    rdfs:label "Constructing gods"@en, "Götter konstruieren"@de ;
    skos:definition "Build a god from programs found in one's own head and from pieces of whatever mythologies lie to hand, and invest belief in it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 62; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaConstructedGodsYield a pm:Yielding ;
    rdfs:label "Constructed gods yield inspiration and power"@en, "Konstruierte Götter ergeben Inspiration und Kraft"@de ;
    skos:definition "Gods made from one's own mental programs and fragments of myth, once believed in, are said to give inspiration and power."@en ;
    pm:byPractice pmp:ChaosMagicOctaConstructingGods ;
    pm:yieldsCapacity pmc:ChaosMagicOctaConstructedGodsPower, pmc:ChaosMagicOctaMakingOwnGods ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, pp. 55, 62; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaTheoryOfMind a pm:Conceptualizing ;
    rdfs:label "Theory of mind behind gods and selves"@en, "Theory of Mind hinter Göttern und Selbsten"@de ;
    skos:definition "Gods persist because the brain evolved a theory-of-mind function that ascribes intentions to people, animals and perhaps other phenomena in order to anticipate them. People apply it to others before themselves, so self-images are modelled on the minds attributed to peers; since self-awareness is only one region of the brain observing another, turning it on oneself makes one more construct, either the monotheist's single self-image or the magician's more realistic plural one."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, pp. 62-63; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaInvocationInsights a pm:Conceptualizing ;
    rdfs:label "Rare insights and unusual abilities through invocation"@en, "Seltene Einsichten und ungewöhnliche Fähigkeiten durch Invokation"@de ;
    skos:definition "Successful invocation of god-forms is said to give the magician rare insights and at times the use of unusual capacities evolved in the subconscious."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 63; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaGodsFromChaos a pm:Conceptualizing ;
    rdfs:label "Gods arise from Chaos"@en, "Götter entstehen aus dem Chaos"@de ;
    skos:definition "As the ancient Greeks are said to have understood, gods and Titans spring from Chaos: they appear in the mind as counterparts of the random creative processes beneath quantum events, nature, the evolution of life and psyche, and in the end of culture. Pagan pantheons sum up most of human psychology and the strange powers of animals."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 63; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaDualityAtRoot a pm:Conceptualizing ;
    rdfs:label "Duality at the root of existence"@en, "Dualität an der Wurzel des Daseins"@de ;
    skos:definition "The universe is said to exist because of the duality of binding and spinning rather than through a single origin, and everything manifest to hang between opposing forces; complex organisms are defined by sex and death, which drive our complexity, motivation, desires, fears, internal dialogue and entertainment."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, pp. 63-64; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaSelfAsIdentifications a pm:Conceptualizing ;
    rdfs:label "The personal self as a suite of shifting identifications"@en, "Das persönliche Selbst als Folge wechselnder Identifikationen"@de ;
    skos:definition "The sense of a personal self comes from a range of emotional identifications; being highly suggestible, people stay open to persuasion, act inconsistently, and slip into temporary self-identification with whatever they find themselves doing. They model others simply but themselves in more detail, and the word selves is used in the plural on purpose."@en ;
    skos:note "Added at reconciliation from the second pass; it leads into the argument of pmc:ChaosMagicOctaStokastikosLaw."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 65; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaStokastikosLaw a pm:Conceptualizing ;
    rdfs:label "Stokastikos' Law: an even number of selves"@en, "Gesetz des Stokastikos: eine gerade Zahl von Selbsten"@de ;
    skos:definition "All humans, and probably every sentient structure, are said to have an even count of selves. There is no master self that decides; theory of mind supplies each self-model with models of the rest, so the mind is a parliament with a built-in opposition rather than a dictatorship. Offered in support: any responsive system needs two partly independent subsystems with feedback between them, as in a thermostat; nobody is known until their positive and negative preferences are known; and even the monotheist god needs a Devil to make sense."@en ;
    skos:note "Stokastikos is the name under which the author signs the introduction."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, pp. 65-66; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaTheoryOfMindProjection a pm:Conceptualizing ;
    rdfs:label "Theory-of-mind projection as a way of relating"@en, "Theory-of-Mind-Projektion als Weise der Beziehung"@de ;
    skos:definition "People build theory-of-mind illusions about others, themselves, animals, natural phenomena held inanimate, and perhaps everything, which fully developed would be panpsychism; such projections let their users enter a more understandable, user-friendly relation with the phenomenon instead of staying detached from it."@en ;
    skos:note "Added at reconciliation from the second pass; these are the powers that pmc:ChaosMagicOctaPsychotheologyFirst says magicians must work to reach."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 67; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaPsychotheologyFirst a pm:Presupposing ;
    rdfs:label "Explore one's psychotheology, then serve as priest and avatar"@en, "Erst die eigene Psychotheologie erkunden, dann als Priester und Avatar dienen"@de ;
    skos:definition "To reach the powers of theory-of-mind projection, magicians are told first to look into their personal psychotheology and then to serve the gods they have chosen as priests and avatars."@en ;
    skos:note "The text sets the order but states no consequence of skipping it. The exploration of psychotheology is not entered as a node of its own; it is part of choosing resonant Chaomeras in pmp:ChaosMagicOctaPriestAvatar."@en ;
    pm:priorStep pmp:ChaosMagicOctaPriestAvatar ;
    pm:dependentStep pmc:ChaosMagicOctaInvocationInsights ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 67; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaDivineRevelationExcitement a pm:Conceptualizing ;
    rdfs:label "Divine revelation as excitement while making gods"@en, "Göttliche Offenbarung als Erregung beim Götterschaffen"@de ;
    skos:definition "Humans have always made gods out of their impulses and scraps of myth; divine revelation is said to mean only getting very excited while doing so, which can be arranged technically by gnosis (chapter 7)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 67; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaErisNaming a pm:Naming ;
    rdfs:label "Eris"@en, "Eris"@de ;
    skos:definition "A minor Greek goddess, sister of Ares, a kind of female Loki given to mischief, upheaval and renewal, recently promoted to a major goddess in the Principia Discordia by chaoist psychotheologians; the author invokes her only by supplication."@en ;
    skos:note "Her invocation is referred to the Mass of Chaos (E) in the appendix."@en ;
    pm:nameForm "Eris" ;
    pm:nameRole "goddess of mischief, upheaval and renewal" ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, pp. 68-69; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaOuranosNaming a pm:Naming ;
    rdfs:label "Ouranos"@en, "Ouranos"@de ;
    skos:definition "Personifies the magician identity against the friendly solar self of everyday life; he takes Uranus's planetary sign and, like the planet, stands outside the seven classical ones with his spin at right angles to theirs; a shadowy hooded figure orbiting in outer darkness and researching forbidden, hidden and antinomian knowledge. Invoked by personification or full possession; he has a dedicated servitor."@en ;
    skos:note "The same figure entered from The Apophenion is pmc:ChaosMagicApophOuranosNaming. His invocation is referred to an Ouranos audio CD."@en ;
    pm:nameForm "Ouranos" ;
    pm:nameRole "personified magician identity; researcher of forbidden knowledge" ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, pp. 68-69; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaAzathothNaming a pm:Naming ;
    rdfs:label "Azathoth"@en, "Azathoth"@de ;
    skos:definition "The blind and insane god at Chaos's core, taken from the Cthulhu Mythos, standing for the madly random and often destructive manifestation of chaos."@en ;
    skos:note "Its invocation is referred to Liber Kaos."@en ;
    pm:nameForm "Azathoth" ;
    pm:nameRole "random and destructive chaos; a god-form for dire emergency" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 69; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaAzathothCautela a pm:Cautioning ;
    rdfs:label "Invoke Azathoth only in dire emergency"@en, "Azathoth nur im äußersten Notfall anrufen"@de ;
    skos:definition "Azathoth is to be invoked only when everything else has failed and nothing but an unpredictable extreme event can save the day; the author hopes to stay out of situations that would call for further Azathoth conjurations."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctaAzathothNaming ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 69; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaApophenicFaculty a pm:Conceptualizing ;
    rdfs:label "Apophenia, perceiving hidden connections"@en, "Apophänie, verborgene Zusammenhänge wahrnehmen"@de ;
    skos:definition "A quirk of the psyche that many magicians possess or train: perceiving meanings and connections between phenomena where others see none."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 69; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaApopheniaPsychosisCautela a pm:Cautioning ;
    rdfs:label "Apophenia underlies psychosis as well as genius"@en, "Apophänie liegt Psychose wie Genie zugrunde"@de ;
    skos:definition "The faculty of perceiving unseen connections is said to underlie psychosis as well as genius."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctaApophenicFaculty ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 69; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaApopheniaResponses a pm:Receiving ;
    rdfs:label "Apophenia's answers in numbers, symbols and names"@en, "Apophenias Antworten in Zahlen, Symbolen und Namen"@de ;
    skos:definition "Invoked as a beautiful muse, Apophenia is said to have answered with numbers, with symbols, and with more names under which to call her for inspiration."@en ;
    pm:receivedBy "Peter J. Carroll and those who invoke with him (the text says we)" ;
    pm:claimedSpeaker "Apophenia, as muse" ;
    pm:receptionCircumstance "In invocation of her as a beautiful muse; neither the numbers, symbols and names nor any occasion is given." ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 69; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaHigherChaosNaming a pm:Naming ;
    rdfs:label "OBDAXAZONGAGA, Higher Chaos"@en, "OBDAXAZONGAGA, Höheres Chaos"@de ;
    skos:definition "Higher Chaos, bearing an Ouranian-barbaric name, OBDAX for short, stands for chaos as stochastic, creative and complexity-building, the counterpart of Azathoth; a work in progress, referred to Appendix 1."@en ;
    pm:nameForm "OBDAXAZONGAGA (short form OBDAX)" ;
    pm:nameRole "creative, complexifying stochastic chaos" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 69; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaInvocationModes a pm:Systematizing ;
    rdfs:label "Degrees of invocation: supplication, personification, possession"@en, "Grade der Invokation: Bitte, Personifikation, Besessenheit"@de ;
    skos:definition "God-forms are approached by supplication, by personification or by full possession, as the author does with Eris (supplication only) and the others (personification or possession); the empowerment may range from gently summoning a power source to full invocation with outright possession."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion; Magical Ritual part 3, pp. 69, 71; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctaServitorGroundsleve a pm:Practicing ;
    rdfs:label "Servitors housed in groundsleves"@en, "Servitoren in Groundsleves"@de ;
    skos:definition "Give a god-form dedicated servitors and give each a physical representation, usually a smallish figurine called a groundsleve, through which the enchantments and divinations relevant to that god are carried out."@en ;
    skos:note "The author reports doing this for Baphomet and for Ouranos."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, pp. 69-70; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaServitorWork a pm:Conceptualizing ;
    rdfs:label "Enchantment and divination carried out by servitors"@en, "Durch Servitoren ausgeführte Verzauberung und Divination"@de ;
    skos:definition "Dedicated servitors are said to execute the enchantments and divinations that fit the god-form they belong to."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 69; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaServitorYields a pm:Yielding ;
    rdfs:label "Servitors with groundsleves yield enchantment and divination"@en, "Servitoren mit Groundsleves ergeben Verzauberung und Divination"@de ;
    skos:definition "The servitors of Baphomet and Ouranos, housed in groundsleves, are said to serve for the execution of the relevant enchantments and divinations."@en ;
    pm:byPractice pmp:ChaosMagicOctaServitorGroundsleve ;
    pm:yieldsCapacity pmc:ChaosMagicOctaServitorWork ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, pp. 69-70; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctaPriestAvatar a pm:Practicing ;
    rdfs:label "Serving as priest or avatar of a Chaomera"@en, "Als Priester oder Avatar einer Chaomera dienen"@de ;
    skos:definition "Choose Chaomeras, syncretic, refurbished or discovered god-forms, that resonate with parts of one's inner pantheon and with one's aims in life; learn or devise invocations to them; and make images of them in sculpture, painting or other media as a deliberate idolatry through which to deal with them."@en ;
    skos:note "It is said to take much work, imagination and devotion and to repay the effort if done skilfully."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 70; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaSubconsciousPowersImaged a pm:Conceptualizing ;
    rdfs:label "Hidden subconscious powers linked to god-images"@en, "Verborgene unbewusste Kräfte an Götterbilder gebunden"@de ;
    skos:definition "Images of god-forms are said to tie the curious powers and abilities lurking in the subconscious to human-shaped representations that let the magician deal with them more readily."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 70; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaPriestAvatarYields a pm:Yielding ;
    rdfs:label "Priesthood of Chaomeras yields access to subconscious powers"@en, "Priesterschaft der Chaomeras ergibt Zugang zu unbewussten Kräften"@de ;
    skos:definition "Serving Chaomeras with invocations and images is said to link hidden subconscious abilities to forms the magician can work with."@en ;
    pm:byPractice pmp:ChaosMagicOctaPriestAvatar ;
    pm:yieldsCapacity pmc:ChaosMagicOctaSubconsciousPowersImaged, pmc:ChaosMagicOctaInvocationInsights ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 70; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaGodsAsFaithMiracles a pm:Conceptualizing ;
    rdfs:label "Gods work as miracles of the magician's faith"@en, "Götter wirken als Wunder des Glaubens des Magiers"@de ;
    skos:definition "Whether gods are real or illusory is held not to matter, only what they resemble and do and what they bring; as to how they do it, opinion is said to have moved away from the spirit model of religion and largely from astral resonance or collective unconscious toward a wholly personal psychology with a little parapsychology, so that most magicians explain their gods' doings as miracles of their own faith in them."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion, p. 70; read in a full-text layer of the first edition" .


#
# Magical Ritual part 3
#

pmp:ChaosMagicOctaConjurationFreeRitual a pm:Practicing ;
    rdfs:label "Conjuration-free daily ritual"@en, "Tägliches Ritual ohne Konjuration"@de ;
    skos:definition "With nothing specific to do, after centring and encircling face in turn the segments of a circle or sphere imagined around oneself and call one god-form to each; three to five usually suffice and few keep up relations with more than eight."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 3, p. 71; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaMagicalWorkout a pm:Conceptualizing ;
    rdfs:label "Magical exercise and empowered gods"@en, "Magische Übung und gestärkte Götter"@de ;
    skos:definition "Keeping in magical training and empowering one's gods through regular attention to them, a kind of worship."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 3, p. 71; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaConjurationFreeYields a pm:Yielding ;
    rdfs:label "The conjuration-free ritual yields a workout and empowered gods"@en, "Das Ritual ohne Konjuration ergibt Übung und gestärkte Götter"@de ;
    skos:definition "Performed as daily practice, the conjuration-free ritual is said to exercise the magician and at once to empower the gods called."@en ;
    pm:byPractice pmp:ChaosMagicOctaConjurationFreeRitual ;
    pm:yieldsCapacity pmc:ChaosMagicOctaMagicalWorkout ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 3, p. 71; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctaEmpowerment a pm:Practicing ;
    rdfs:label "The Empowerment"@en, "Die Ermächtigung"@de ;
    skos:definition "Having centred and encircled, call the god-forms by their names, signs and numbers and as visualised figures, while speaking or silently reciting a litany or invocatory preamble. The empowerment is chosen to suit the intended conjuration; where there is one, normally a single god-form is called whose powers and knowledge fit its purpose as closely as possible."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 3, p. 71; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaEmpowermentStages a pm:Systematizing ;
    rdfs:label "Stages of empowerment: Mythogenesis, Summoning, Invocation"@en, "Stufen der Ermächtigung: Mythogenese, Herbeirufung, Invokation"@de ;
    skos:definition "The empowerment opens with Mythogenesis, moves on to Summoning, and may close with Invocation; it may stop at any degree between a mild summoning and full invocation with possession."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 3, pp. 71-72; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctaMythogenesis a pm:Practicing ;
    rdfs:label "Mythogenesis"@en, "Mythogenese"@de ;
    skos:definition "Explore and develop the tale of the god-form, thought-form or Chaomera, filling out its mythos and considering its symbols, powers and attributes, from classical myth, modern fiction or fresh invention; in every case find something that resonates with something within oneself that one wishes to amplify."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 3, p. 72; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctaSummoning a pm:Practicing ;
    rdfs:label "Summoning"@en, "Herbeirufung"@de ;
    skos:definition "Call the god-form by visualisation, imagination and incantation, supplemented if wished by drawing, showing or visualising symbols and instruments and by particular incenses or perfumes."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 3, p. 72; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctaFullInvocation a pm:Practicing ;
    rdfs:label "Full invocation"@en, "Volle Invokation"@de ;
    skos:definition "Embody, incarnate or act out the god-form as fully as one can: set aside disbelief and everyday identity for a time, act the part with the utmost method-acting effort, and try to be possessed by the invoked form, pretending until it becomes real."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 3, p. 72; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaPossession a pm:Conceptualizing ;
    rdfs:label "Possession by the invoked god-form"@en, "Besessenheit durch die angerufene Gottesform"@de ;
    skos:definition "Outright possession, during which the magician is for a time aware of nothing else, and which may reveal surprising inner resources."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 3, pp. 71-72; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaFullInvocationYields a pm:Yielding ;
    rdfs:label "Full invocation yields possession and inner resources"@en, "Volle Invokation ergibt Besessenheit und innere Ressourcen"@de ;
    skos:definition "Full invocation is said to be able to reach outright possession, and the magician may be surprised by the inner resources it brings out."@en ;
    pm:byPractice pmp:ChaosMagicOctaFullInvocation ;
    pm:yieldsCapacity pmc:ChaosMagicOctaPossession ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 3, pp. 71-72; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaInvocationCrazinessCautela a pm:Cautioning ;
    rdfs:label "Invocation involves a certain craziness"@en, "Invokation bringt eine gewisse Verrücktheit mit sich"@de ;
    skos:definition "Full invocation unavoidably brings some craziness, with disbelief and everyday identity laid aside for a time; making gods may look quite deranged to outsiders."@en ;
    pm:cautionsAbout pmp:ChaosMagicOctaFullInvocation ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 3 The Spells of Illusion; Magical Ritual part 3, pp. 67, 72; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaChaometry a pm:Conceptualizing ;
    rdfs:label "Chaometry"@en, "Chaometrie"@de ;
    skos:definition "The art and science of getting conjurations to work well, treated in the ritual sections of the remaining chapters; the preparatory parts so far (centring, encircling, empowerment) are said to be unable really to go wrong."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 3, pp. 72-73; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaConjurationFailure a pm:Conceptualizing ;
    rdfs:label "Conjuration may give nothing or disaster"@en, "Konjuration kann nichts oder Unheil bringen"@de ;
    skos:definition "Conjuration sometimes gives no result at all and sometimes disastrous ones."@en ;
    skos:note "Counted as a condition of failure: no result, or a disastrous one, from the conjuration. No deadline; no cause is assigned here, the chaometry sections being announced as the remedy that improves the operator's ability; it doubles as a warning that conjuration, unlike the preparatory parts, can go wrong."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 3, p. 72; read in a full-text layer of the first edition" .


#
# Chapter 4, The Spells of Subtle Magic
#

pmc:ChaosMagicOctaCausalityAndChaosConstants a pm:Conceptualizing ;
    rdfs:label "Lightspeed as the measure of causality, Planck's constant of chaos"@en, "Lichtgeschwindigkeit als Maß der Kausalität, Plancksche Konstante des Chaos"@de ;
    skos:definition "Lightspeed roughly sets how much causality a universe has and Planck's constant how much chaos, so that if one falls the other rises; Discworld, with light at about 200 miles per hour, has easy magic and shaky causality, while here causality works well and magic is a struggle. Planck's constant marks the grain at which causality gives way to chance and magic."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 4 The Spells of Subtle Magic, p. 74; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaAgainstNegligibleBrainQuantum a pm:Conceptualizing ;
    rdfs:label "Against neglecting quantum effects in the brain"@en, "Gegen die Vernachlässigung von Quanteneffekten im Gehirn"@de ;
    skos:definition "Scientists are faulted for arguing that Planck's constant is so small here that quantum effects can be ignored in the brain and at human scale, and the long-held view that true indeterminacy is confined to the Planck scale is said to fit neither life as experienced nor particles nor minds: it sets in about twenty orders of magnitude higher, more chaotically than Heisenberg thought."@en ;
    skos:note "A dispute of the work with mainstream physics; the other side is not read."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 4 The Spells of Subtle Magic, pp. 75, 77-78; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaInformationDeficit a pm:Conceptualizing ;
    rdfs:label "The universe's information deficit and grain size"@en, "Das Informationsdefizit und die Körnung des Universums"@de ;
    skos:definition "Equating information with entropy over Boltzmann's constant and applying the holographic conjecture to a hypersphere, the universe holds about U squared bits for U cubed Planck volumes, too little to specify events causally below a grain of about the cube root of U Planck lengths; this grain is the pixel size of the universe, where any real event fills a whole pixel or does not happen and below which processes are indeterminate."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 4 The Spells of Subtle Magic, pp. 75-77; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaEnhancedPlanckConstant a pm:Conceptualizing ;
    rdfs:label "The Spells of Subtle Magic: Planck's constant enhanced by root U"@en, "Die Zauber der subtilen Magie: um Wurzel U erhöhte Plancksche Konstante"@de ;
    skos:definition "For practical purposes the uncertainty relations for energy and time, entropy and time, and information and time are used with Planck's constant multiplied by the square root of U, about twenty orders of magnitude; with the temperature taken as 300 kelvin, they give a small but usable amount of indeterminate energy each second and an indeterminacy of entropy that may run either way."@en ;
    skos:note "The equations and their powers of ten are garbled in the text layer; only their reading in the prose is entered, without magnitudes. What the energy relation implies for the brain is entered as pmc:ChaosMagicCohaerentiaNeurologica and is not repeated here."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 4 The Spells of Subtle Magic, pp. 78-79; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaEntropyReversal a pm:Conceptualizing ;
    rdfs:label "Entropy reversal on finely balanced systems"@en, "Entropieumkehr an fein ausbalancierten Systemen"@de ;
    skos:definition "The second subtle spell lets entropy fall as well as rise; how much reversal it yields is hard to put in bits, as it depends on how far the small energy can alter a system's microstates: much within the brain, outside only finely balanced events."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 4 The Spells of Subtle Magic, p. 79; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaPsychicInformationInterference a pm:Conceptualizing ;
    rdfs:label "Information open to psychic interference"@en, "Der psychischen Einwirkung offene Information"@de ;
    skos:definition "The third subtle spell gives a very large maximum indeterminacy of information per second, but only for systems with tiny grain and transition energies; in practice the magician must reckon with how many usable states a system has and the energies between them to find how much of its information lies open to psychic interference."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 4 The Spells of Subtle Magic, pp. 79-80; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaPrimeAndThaum a pm:Conceptualizing ;
    rdfs:label "The Prime and the Thaum, units of magic"@en, "Prime und Thaum, Einheiten der Magie"@de ;
    skos:definition "The indeterminate energy per second given by the first subtle spell is taken as the basic unit of magical energy, the Prime (Greek capital Pi), and the matching information rate as the basic unit for passing magical information, the Thaum (Greek capital Theta). Recalculated for Discworld's Planck constant and Ubiquity, both come out about fifty times larger there, enough to swat a mosquito or upset a brain."@en ;
    skos:note "The units are borrowed from Discworld, whose magicians measure magic by them. Their magnitudes are not entered, the exponents being unreadable in the text layer."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 4 The Spells of Subtle Magic; ch. 4 The Spells of Subtle Magic, Addendum, pp. 79-80, 83-85; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaNoGrossMiraclesFailure a pm:Conceptualizing ;
    rdfs:label "No gross miracles in a hurry"@en, "Keine groben Wunder in Eile"@de ;
    skos:definition "The universe is said to hold enough chaos to allow magic but not enough for gross miracles in a hurry; targets that depend on large changes of energy or entropy are out of reach."@en ;
    skos:note "Counted as a condition of failure: aiming at gross or rapid miracles that need large energy or entropy changes. No deadline is set, though hurry itself is named as what the budget cannot meet; the failure is put on the choice of target against the limits of the universe, not on the operator's skill."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 4 The Spells of Subtle Magic, p. 80; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaImprobableDriftSuccess a pm:Conceptualizing ;
    rdfs:label "Success shows as an improbable drift of events"@en, "Erfolg zeigt sich als unwahrscheinliches Abdriften der Ereignisse"@de ;
    skos:definition "The results of magic will seldom resemble showy parapsychology; they will appear rather as a sequence of events moving, a little against the odds, the way that was wished."@en ;
    skos:note "Counted as a sign of success: a series of events tending, somewhat against the odds, toward the aim. No deadline and no rate; the sign is a drift, so no single event separates success from chance."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 4 The Spells of Subtle Magic, p. 80; read in a full-text layer of the first edition" .


#
# Magical Ritual part 4, Chaometry (1), and Addendum
#

pmp:ChaosMagicOctaLowCostTargets a pm:Practicing ;
    rdfs:label "Choosing low-cost targets for conjuration"@en, "Kostengünstige Ziele für die Konjuration wählen"@de ;
    skos:definition "For the conjuration, enchant or divine for events or knowledge that need only small effects of energy, information or entropy; seek systems whose microstates have a useful grain but small energy differences between them, such as a die while it tumbles; and as a rule of thumb throw information rather than energy at the target, since information may exist at a grain far coarser than molecules."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 4, Chaometry (1), pp. 82-83; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaEnchantingThroughMinds a pm:Conceptualizing ;
    rdfs:label "Enchanting outcomes by changing attitudes and minds"@en, "Ergebnisse durch Änderung von Haltungen und Gedanken verzaubern"@de ;
    skos:definition "A business worth a fortune can be conjured out of almost nothing, not by materialising gold, but by changing one's own attitude and the thoughts of prospective suppliers and customers."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 4, Chaometry (1), p. 82; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaLowCostTargetsYield a pm:Yielding ;
    rdfs:label "Low-cost targeting yields enchantment through minds"@en, "Kostengünstige Zielwahl ergibt Verzauberung über die Gedanken"@de ;
    skos:definition "Aiming at small energy and information changes in people's thinking is offered as the workable way to large worldly results."@en ;
    pm:byPractice pmp:ChaosMagicOctaLowCostTargets ;
    pm:yieldsCapacity pmc:ChaosMagicOctaEnchantingThroughMinds ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 4, Chaometry (1), p. 82; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaMaterialisationFailure a pm:Conceptualizing ;
    rdfs:label "Materialisation and apport cost too much"@en, "Materialisation und Apport kosten zu viel"@de ;
    skos:definition "Spontaneous materialisation of gold needs prohibitive energy, and even an apport of it usually needs a sizeable rearrangement of the universe's information."@en ;
    skos:note "Counted as a condition of failure: targets such as materialising or apporting gold, beyond the energy and information budget. No deadline; the failure is put on the choice of target, not on the operator's skill."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 4, Chaometry (1), p. 82; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaStationaryDieFailure a pm:Conceptualizing ;
    rdfs:label "A die at rest resists telekinesis"@en, "Ein ruhender Würfel widersteht der Telekinese"@de ;
    skos:definition "A die at rest shows one of its six microstates and the energies needed to change it are fairly high, so it cannot easily be flipped by telekinesis; only while it tumbles are those energies tiny."@en ;
    skos:note "Counted as a condition of failure: acting on a system at rest whose transition energies are high. No deadline; the failure is put on the state of the target and the timing of the act."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 4, Chaometry (1), p. 82; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctaDivinationPreparation a pm:Practicing ;
    rdfs:label "Narrowing the unknown before divining"@en, "Vor der Divination das Unbekannte eingrenzen"@de ;
    skos:definition "Before divining, reduce uncertainty to manageable levels, chiefly by first learning all one can of the situation, since divination works against the available indeterminacy."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 4, Chaometry (1), p. 82; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaEnchantLongDivineShort a pm:Conceptualizing ;
    rdfs:label "Enchant long, divine short"@en, "Lang verzaubern, kurz divinieren"@de ;
    skos:definition "A maxim called tried and tested: in enchantment the indeterminate energy is something to play with, in divination something to play against, hence enchant for distant and divine for near outcomes."@en ;
    skos:note "A statement of testedness; no tests are cited."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Magical Ritual part 4, Chaometry (1), p. 82; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaRetroactiveEnchantment a pm:Conceptualizing ;
    rdfs:label "Retroactive enchantment (apport)"@en, "Retroaktive Verzauberung (Apport)"@de ;
    skos:definition "Magic measured in Thaums apports objects, which means rearranging the information that formerly fixed their positions; magicians of this world call it retroactive enchantment."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 4 The Spells of Subtle Magic, Addendum, p. 83; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctaTelekinesis a pm:Conceptualizing ;
    rdfs:label "Telekinesis"@en, "Telekinese"@de ;
    skos:definition "Magic measured in Primes shifts a weight over a distance; it is called telekinesis and the Prime is treated as a measure of energy, though the Discworld definition gives neither timescale nor friction."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 4 The Spells of Subtle Magic, Addendum, p. 83; read in a full-text layer of the first edition" .


#
# Chapter 5, The Spells of the Linking (opening page)
#

pmc:ChaosMagicOctaLeviAstralLight a pm:Conceptualizing ;
    rdfs:label "Levi's Astral Light as the first non-religious medium of magic"@en, "Levis Astrallicht als erstes nichtreligiöses Medium der Magie"@de ;
    skos:definition "Magic looks dubious to many scientific minds because it implies links between events with no possible causal connection; the first attempt at a mechanism or medium for magical effects free of religious concepts is credited to the nineteenth-century magician Eliphas Levi, who posited an Astral Light through which magic travels and which provides the magical link."@en ;
    skos:note "Added at reconciliation from the second pass; the first pass of part 1 stopped short of the chapter and that of part 2 begins just after this paragraph."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, p. 86; read in a full-text layer of the first edition" .


#
# Chapter 5, The Spells of the Linking (from p. 86)
#

pmc:ChaosMagicOctavNeglectedLinkFailure a pm:Conceptualizing ;
    rdfs:label "Neglect of the magical link as the chief cause of failure"@en, "Vernachlässigung der magischen Verbindung als Hauptursache des Scheiterns"@de ;
    skos:definition "The chapter opens by quoting Crowley's Magick with approval: more magical failures come from neglecting the magical link than from every other cause taken together."@en ;
    skos:note "Counted as a condition of failure: a neglected magical link, ranked above all other causes combined. No deadline and no rate beyond that ranking; the failure is put on the operator who neglects the link. The sentence is Crowley's, quoted and adopted; the work's answer is the specification of the Astral and the typology of links that follow."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, p. 86; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavAstralSpecification a pm:Conceptualizing ;
    rdfs:label "Specifying the Astral to lower the failure rate"@en, "Bestimmung des Astralen zur Senkung der Fehlerquote"@de ;
    skos:definition "Most magicians sense that some astral or etheric link between events plays a part in magic, yet the assumption stays vague, an unexamined elephant in the room. An exact account of the Astral's make-up and workings should give a systematic grasp of how links work and, by working accordingly, fewer failures."@en ;
    skos:note "Crowley's lament that nobody had set down the properties and laws of the Astral Light is quoted on pp. 86-87; on p. 90 the work claims to approach his wish for a systematic account."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, pp. 86-87, 90; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavAstralAsWaveFunctions a pm:Conceptualizing ;
    rdfs:label "The Astral as reality's wave and field functions"@en, "Das Astrale als Wellen- und Feldfunktionen der Wirklichkeit"@de ;
    skos:definition "Combining wave and field physics, Sheldrake's morphic fields and some magical theory, the Astral is specified as reality's wave and field functions. We perceive only its particle function, the doings of particles at interaction, not the wavelike states between them nor the fields between them, though these largely decide what particles end up doing; the particle world is said to be remade at each instant from a far larger wave reality that cannot be observed directly."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, pp. 87, 90; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavImaginationAtInterface a pm:Conceptualizing ;
    rdfs:label "Creative imagination as the interface of the Astral and the brain"@en, "Schöpferische Imagination als Schnittstelle von Astralem und Gehirn"@de ;
    skos:definition "Magicians' sense that reality has a larger astral part comes partly from imagining more than we perceive; but imagination is not itself the astral plane. Creative imagination is said to arise where reality's astral wave function meets the sensitive particle structure of the brain, and consciousness feels immaterial because it partakes of both."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, p. 88; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavAgainstAstralEther a pm:Conceptualizing ;
    rdfs:label "Against the astral as luminiferous ether"@en, "Gegen das Astrale als Lichtäther"@de ;
    skos:definition "Early occultists, excited by the breadth of the electromagnetic spectrum, likened the astral to the luminiferous ether. The author rejects the parallel: the ether proved superfluous, and plain radiation cannot account for magic, since most of it neither bends round corners nor crosses solid matter well and it does not persist, vanishing once it reaches a receiver."@en ;
    skos:note "A dispute of the work with the early occultists who equated the astral with the luminiferous ether; the other side is not read."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, p. 89; read in a full-text layer of the first edition" .


#
# Chapter 5, Chaometry: Part 2
#

pmc:ChaosMagicOctavFirstSpellOfLinking a pm:Conceptualizing ;
    rdfs:label "First Spell of the Linking: three dimensions of time"@en, "Erster Spruch der Verbindung: drei Zeitdimensionen"@de ;
    skos:definition "Entanglement, a coherence that persists between events once in contact, is best explained by effects running backwards in time, and superposition, a particle emerging as if from contradictory past states, by a sideways component of time; imaginary numbers serve to model such unobservable quantities, how the wave reality acts on the particle one. The first Spell of the Linking accordingly gives spacetime separation with three spatial and three temporal dimensions, the two sideways time dimensions treated as doubly unobservable, a plane of pseudo-space; in abbreviated form, separation equals spatial distance minus time plus imaginary time."@en ;
    skos:note "The equations are garbled in the text layer; entered from the surrounding prose."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking and ch. 5 The Spells of the Linking, Chaometry: Part 2, pp. 88-89, 92-94; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavZeroSeparationLink a pm:Conceptualizing ;
    rdfs:label "Zero spacetime separation as magical linkage"@en, "Raumzeitlicher Nullabstand als magische Verbindung"@de ;
    skos:definition "Solutions of the first spell in which spacetime separation equals zero describe events entangled together, a condition of magical linkage. Entanglement (a light path across space) and superposition (separation in imaginary time only) are two extremes of one continuum; as no single separation is ever exactly zero, every link carries some superposition and is a connection of probability rather than of cause."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, pp. 94-95; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavImaginaryTimeHiddenVariable a pm:Conceptualizing ;
    rdfs:label "Imaginary time as a chaotic hidden variable"@en, "Imaginäre Zeit als chaotische verborgene Variable"@de ;
    skos:definition "The imaginary time plane, at right angles to ordinary time, acts as the hidden variable that makes the universe seem governed by probability, not determinism; it probably acts randomly, since only randomness can give effects unpredictable one by one yet regular in bulk, and events may pick their direction on the plane at random."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, pp. 95-96; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavAgainstEinsteinDeterminism a pm:Conceptualizing ;
    rdfs:label "Against Einstein's strictly causal universe"@en, "Gegen Einsteins streng kausales Universum"@de ;
    skos:definition "Philosophers may argue, as Einstein did, that a hidden variable means a causal universe whose mechanism is merely unobservable, and that quantum physics is incomplete. The author answers that the universe does throw dice, but out of sight, in the plane of imaginary time."@en ;
    skos:note "A dispute of the work with Einstein's determinism, which is summarised, not quoted at length; the other side is not read."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, pp. 95-96; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavBrainImaginaryTimeWaves a pm:Conceptualizing ;
    rdfs:label "The brain makes its own waves in imaginary time"@en, "Das Gehirn erzeugt eigene Wellen in imaginärer Zeit"@de ;
    skos:definition "Information-processing machines, the human brain the most powerful of them, can create waves of their own in imaginary time; an event that is visualised or imagined, being itself a wave-particle event, can act on the imaginary time plane much as the probability wave of a material event does."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, pp. 96-97; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavImaginaryTimeSparinglyCautela a pm:Cautioning ;
    rdfs:label "Use imaginary time sparingly"@en, "Imaginäre Zeit sparsam nutzen"@de ;
    skos:definition "The real time axis meanders through the imaginary plane like someone stumbling in the dark, making real what it passes; the further a region lies from that thread, the less likely it becomes real. Its near reaches hold what can probably happen, its far reaches the much larger field of what probably will not, so the magician should interact with imaginary time sparingly."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctavBrainImaginaryTimeWaves ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 96; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavHighQualityLink a pm:Conceptualizing ;
    rdfs:label "High-quality magical link"@en, "Hochwertige magische Verbindung"@de ;
    skos:definition "The ability to hold a link to a target good enough for enchantment or divination to act through it. Touch or line of sight gives the best; in practice line of sight reduces to real-time simultaneity, and in its absence the best link comes from visualising the target as it actually is at the moment of linking."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 97; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavSimultaneityLink a pm:Conceptualizing ;
    rdfs:label "Line of sight reduces to simultaneity (second link equation)"@en, "Sichtlinie läuft auf Gleichzeitigkeit hinaus (zweite Verbindungsgleichung)"@de ;
    skos:definition "Line of sight here means any light-like path whatever lies in between, since probability waves pass through solid matter much as neutrinos do; seeing the target matters only as an aid to visualising it. The best links therefore join simultaneous events, where imaginary time separation is very small and the magician reaches the target's near pasts and futures."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 97; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavVisualiseTargetNow a pm:Practicing ;
    rdfs:label "Visualising the target in its present state"@en, "Das Ziel in seinem gegenwärtigen Zustand visualisieren"@de ;
    skos:definition "Lacking physical contact or sight of the target, visualise it as it actually is at the very moment of the intended link, so as to connect with the high-probability wave states lying close to it in imaginary time."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 97; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavVisualiseTargetNowYieldsLink a pm:Yielding ;
    rdfs:label "Present-state visualisation yields the best absent link"@en, "Visualisierung des Gegenwartszustands ergibt die beste Fernverbindung"@de ;
    skos:definition "Visualising the target as it is at the moment of linking is said to give the highest quality of link available without contact or sight."@en ;
    pm:byPractice pmp:ChaosMagicOctavVisualiseTargetNow ;
    pm:yieldsCapacity pmc:ChaosMagicOctavHighQualityLink ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 97; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavRememberedImagesCautela a pm:Cautioning ;
    rdfs:label "Remembered and delayed images make poor links"@en, "Erinnerte und verzögerte Bilder sind schwache Verbindungen"@de ;
    skos:definition "Remembered images are a poor substitute for visualising the target as it is now, and most video and television feeds have passed through a time delay."@en ;
    pm:cautionsAbout pmp:ChaosMagicOctavVisualiseTargetNow ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 97; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavLivePhoneLink a pm:Practicing ;
    rdfs:label "Covert magic during a live telephone call"@en, "Verdeckte Magie während eines Live-Telefonats"@de ;
    skos:definition "Hold a live telephone conversation with the target while keeping a covert magical intent, to secure a real-time link."@en ;
    skos:note "The text hedges: such a call frequently, not always, links better."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 97; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavLivePhoneLinkYields a pm:Yielding ;
    rdfs:label "A live call yields a better link"@en, "Ein Live-Gespräch ergibt eine bessere Verbindung"@de ;
    skos:definition "A live telephone conversation held with covert intent is said often to give a better link than remembered or delayed images."@en ;
    pm:byPractice pmp:ChaosMagicOctavLivePhoneLink ;
    pm:yieldsCapacity pmc:ChaosMagicOctavHighQualityLink ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 97; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavRealTimeIntervalCautela a pm:Cautioning ;
    rdfs:label "Magic across real time intervals"@en, "Magie über reale Zeitabstände"@de ;
    skos:definition "Working magic across an interval of real time necessarily brings in a roughly equal amount of imaginary time (third link equation), since nothing but imaginary time can offset a separation in real time; the larger that separation, the more its probabilities multiply."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctavHighQualityLink ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, pp. 97-98; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavMorphicFields a pm:Conceptualizing ;
    rdfs:label "Morphic fields convey configuration, not signals"@en, "Morphische Felder übertragen Konfiguration, keine Signale"@de ;
    skos:definition "If every component of an object projects fields, the fields carry its whole morphology in virtual, probabilistic form. Borrowing Sheldrake's term, such morphic fields cannot send a modulated stream of information, only the configuration of the sender, and only receivers of very similar configuration resonate with them, probabilistically. This weak effect is said to account for physical laws and constants, acting as the agents of conservation in Noether's sense, while leaving slack for life and magic."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, pp. 100-101; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavAstralEqualsFields a pm:Conceptualizing ;
    rdfs:label "Astral, Ether, wavefunctions and fields as one"@en, "Astrales, Äther, Wellenfunktionen und Felder als eines"@de ;
    skos:definition "Fields are held almost surely to be made of particles' wave functions, so Astral, Ether, wavefunctions and fields are identified, and this part of reality does the work ascribed to morphic fields. Recap: reality shows a particle-wave duality; wave functions spread to form fields that carry form rather than information and uphold physical laws; fields propagate at lightspeed, in either direction along all three time dimensions."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 101; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavAgainstPersistenceOfPast a pm:Conceptualizing ;
    rdfs:label "Against Sheldrake's persistence of the past"@en, "Gegen Sheldrakes Fortdauer der Vergangenheit"@de ;
    skos:definition "As one exception to Sheldrake's theory, morphic fields do not outlast the break-up of the particle forms they belong to: reality forgets, as it must, or it would clog up with the minutiae of everything it has done."@en ;
    skos:note "A dispute of the work with Rupert Sheldrake's theory of morphic fields (A New Science of Life, listed in the references); the other side is not read."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 101; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavFieldsCorrelateByAffinity a pm:Conceptualizing ;
    rdfs:label "Fields correlate by affinity"@en, "Felder korrelieren nach Affinität"@de ;
    skos:definition "Fields from an event act only on other events of very similar form or with shared characteristics."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 102; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavNoPresenceOfPastFailure a pm:Conceptualizing ;
    rdfs:label "Spells cease when their projector stops"@en, "Zauber enden, wenn ihr Projizierender aufhört"@de ;
    skos:definition "Since the past has no presence, spells and telepathy end as soon as whoever projects them leaves off; gods left without followers lose all effect, and the morphic field of the dinosaurs is gone."@en ;
    skos:note "Counted as a condition of failure: a spell or a telepathic projection ends when its projector ceases, and a god ends when its followers do. No deadline is set; the failure is put on the lapse of the one who projects or follows. Ch. 6 (p. 114) holds that servitors work better once the magician has forgotten them, which the work does not reconcile with this."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 102; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavMaximalistHypothesis a pm:Conceptualizing ;
    rdfs:label "The Maximalist Hypothesis of quantum interpretation"@en, "Die Maximalisthypothese der Quanteninterpretation"@de ;
    skos:definition "For want of evidence on six questions (indeterminacy, real wave functions, multiple histories, hidden variables, collapsing wave functions, a role for the observer) the exposition answers yes to all of them, choosing one of 64 possible interpretations; the wavefunctions stay unobservable but have real effects, and imaginary time is the chaotic hidden variable."@en ;
    skos:note "The table on p. 102 is garbled in the text layer; the six questions are read from its headings and the footnotes below it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, pp. 102-103; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavLinkTheoryOpenToExperiment a pm:Conceptualizing ;
    rdfs:label "Link theory left open to magical experiment"@en, "Verbindungstheorie offen für magisches Experiment"@de ;
    skos:definition "Each of the 64 interpretations might lead to its own metaphysic and its own theory of the magical link; chaoists may experiment with the consequences, and perhaps only magical experiment, not conventional science, can rule some out. The quantum model in general still allows educated guesses backed by empirical experience."@en ;
    skos:note "The work's own statement of how provisional and how testable its theory of the link is."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 103; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavAffinityForLink a pm:Presupposing ;
    rdfs:label "Affinity: a close model of the target is needed for a link"@en, "Affinität: Für eine Verbindung braucht es ein genaues Modell des Ziels"@de ;
    skos:definition "The first of two needs for an effective link: a mental model in the magician corresponding as closely as possible to the target; it need not be conscious, but a good subconscious representation has to exist."@en ;
    skos:note "The prior step is read as the practice of acquiring an accurate, current mental model of the target, which ch. 7 prescribes (p. 117)."@en ;
    pm:priorStep pmp:ChaosMagicOctavTargetModel ;
    pm:dependentStep pmc:ChaosMagicOctavHighQualityLink ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Without a close subconscious representation of the target the link is not effective." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 103; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavConsciousTargetImageCautela a pm:Cautioning ;
    rdfs:label "Too much conscious attention to the target image"@en, "Zu viel bewusste Aufmerksamkeit für das Zielbild"@de ;
    skos:definition "The model of the target should live in the subconscious; the magician should avoid giving its conscious representation too much attention (cross-reference to the chapter on practical magic)."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctavAffinityForLink ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 103; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavSimultaneityForLink a pm:Presupposing ;
    rdfs:label "Simultaneity: links across real time need imaginary time"@en, "Gleichzeitigkeit: Verbindungen über reale Zeit brauchen imaginäre Zeit"@de ;
    skos:definition "The second need for an effective link: wavefunctions and fields travel at lightspeed, so on a planet only some one-twentieth of a light-second wide distance can be discounted; but a link to events at a significant remove in real time can run only through imaginary time."@en ;
    skos:note "The text says the magician needs simultaneity but names imaginary time as a costlier way round it, so the strength is read as an order, not a necessity."@en ;
    pm:priorStep pmc:ChaosMagicOctavSimultaneityLink ;
    pm:dependentStep pmc:ChaosMagicOctavHighQualityLink ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, pp. 103-104; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavDivination a pm:Conceptualizing ;
    rdfs:label "Divination by magical link"@en, "Divination durch magische Verbindung"@de ;
    skos:definition "Finding out by magical perception what is unknown or uncertain, through a link to the matter or to one's own future self; in this chapter its reach is bounded by time, surest for events near the diviner."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 104; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavDivineShortFailure a pm:Conceptualizing ;
    rdfs:label "Divination degrades with distance in time (Divine Short)"@en, "Divination verfällt mit zeitlichem Abstand (Divine Short)"@de ;
    skos:definition "The heavier a link's reliance on imaginary time, the larger the uncertainty, since we lack any dependable sense of direction or amplitude within that plane; divination grows steadily more precarious the further its object lies from the diviner in time, whence the old dictum Divine Short."@en ;
    skos:note "Counted as a condition of failure: divination of events far removed in time. No deadline or rate is set; the failure is put on the limits of human perception in imaginary time, not on the diviner's skill."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 104; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavWilledImagination a pm:Conceptualizing ;
    rdfs:label "Willed imagination: structuring the imaginary future and past"@en, "Gewollte Imagination: imaginäre Zukunft und Vergangenheit gestalten"@de ;
    skos:definition "The faculty by which some structuring of the imaginary future, and some restructuring of the imaginary past, is said to be possible."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 104; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavEnchantment a pm:Conceptualizing ;
    rdfs:label "Enchantment: raising the chances of less probable events"@en, "Verzauberung: die Chancen unwahrscheinlicherer Ereignisse erhöhen"@de ;
    skos:definition "Increasing the chance of a lower-probability event by reinforcing it with artificially generated affinity; the spreading and multiplying of wave functions over time works in the enchanter's favour, so enchantment does best over longer spans."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 104; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavEnchantLong a pm:Practicing ;
    rdfs:label "Enchant Long: reinforcing the outcome by visualising it"@en, "Enchant Long: das Ergebnis durch Visualisieren verstärken"@de ;
    skos:definition "Give an enchantment time to spread and reinforce the desired, less probable outcome with affinity generated on purpose, say by visualising it as it happens; summed up in the old dictum Enchant Long."@en ;
    skos:note "Uses the faculty entered as pmc:ChaosMagicOctavWilledImagination."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 104; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavEnchantLongYields a pm:Yielding ;
    rdfs:label "Enchanting long yields a raised probability"@en, "Langes Verzaubern ergibt erhöhte Wahrscheinlichkeit"@de ;
    skos:definition "Reinforcing a desired event by visualisation and giving it time is said to raise its chance of occurring."@en ;
    pm:byPractice pmp:ChaosMagicOctavEnchantLong ;
    pm:yieldsCapacity pmc:ChaosMagicOctavEnchantment ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 104; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavWishfulThinkingCautela a pm:Cautioning ;
    rdfs:label "The limits of wishful thinking"@en, "Die Grenzen des Wunschdenkens"@de ;
    skos:definition "Most magicians would rather divine far into the future and enchant for quick effect, the reverse of what the link equations allow; wishful thinking has limits that have to be recognised."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctavDivination, pmc:ChaosMagicOctavEnchantment ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Chaometry: Part 2, p. 104; read in a full-text layer of the first edition" .


#
# Chapter 5, Magical Ritual Part 5: The choice and use of Magical Links
#

pmc:ChaosMagicOctavSevenLinkCategories a pm:Systematizing ;
    rdfs:label "Seven categories of magical link"@en, "Sieben Kategorien magischer Verbindung"@de ;
    skos:definition "A typology of links in order of effectiveness, some overlapping: (1) touch and line of sight; (2) future-self links; (3) visualised links; (4) links by telesmata; (5) live links where space is occluded; (6) links in shared space where time is occluded; (7) links occluded in both space and time."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Magical Ritual Part 5: The choice and use of Magical Links, p. 105; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavContactSightBestLink a pm:Conceptualizing ;
    rdfs:label "Contact or sight as the best link"@en, "Berührung oder Sicht als beste Verbindung"@de ;
    skos:definition "Touching or seeing the target gives the best possible link, since it minimises the separation in imaginary time and lets the magician picture the target as it is now; some magicians are said to refuse to work any other way."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Magical Ritual Part 5: The choice and use of Magical Links, p. 105; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavFutureSelfLink a pm:Practicing ;
    rdfs:label "Linking to one's future self for divination"@en, "Verbindung zum künftigen Selbst für die Divination"@de ;
    skos:definition "Frame the question as the future experience one will have, as a dowser in effect asks what he will experience if he digs here, and visualise oneself at a future point by which the answer will probably be known."@en ;
    skos:note "The visualising of one's future self is reported of some magicians; the reading of dowsing is the author's own."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Magical Ritual Part 5: The choice and use of Magical Links, pp. 105-106; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavFutureSelfLinkYields a pm:Yielding ;
    rdfs:label "The future-self link yields divination"@en, "Die Verbindung zum künftigen Selbst ergibt Divination"@de ;
    skos:definition "Of everything in the future that could supply an answer, the magician's own future self that already has it is said to offer the best possibilities; links to future selves are called an undervalued resource, above all in divination."@en ;
    pm:byPractice pmp:ChaosMagicOctavFutureSelfLink ;
    pm:yieldsCapacity pmc:ChaosMagicOctavDivination ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Magical Ritual Part 5: The choice and use of Magical Links, p. 105; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavDowsingAsFutureSelf a pm:Conceptualizing ;
    rdfs:label "Dowsing and premonition as future-self divination"@en, "Wünschelrute und Vorahnung als Divination durch das künftige Selbst"@de ;
    skos:definition "Dowsing is most easily explained as the dowser asking about his own future experience rather than as sensing mysterious emanations from what lies buried; almost every accurate premonition is said to concern events that move the diviner deeply."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Magical Ritual Part 5: The choice and use of Magical Links, pp. 105-106; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavFeedbackPromise a pm:Practicing ;
    rdfs:label "Divining for others only against a promise of feedback"@en, "Für andere nur gegen Rückmeldungsversprechen divinieren"@de ;
    skos:definition "Agree to divine for another person only if that person solemnly undertakes to report what eventually happens, which secures a link to the diviner's own future self."@en ;
    skos:note "Reported of some magicians."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Magical Ritual Part 5: The choice and use of Magical Links, p. 106; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavRecordedImagesCautela a pm:Cautioning ;
    rdfs:label "Recordings are poorer links than remembered contact"@en, "Aufzeichnungen sind schwächere Verbindungen als erinnerter Kontakt"@de ;
    skos:definition "Visualised links often have to suffice; memories of real contact serve far better than recordings or audio-visual transmissions, which hold only part of what contact itself conveys."@en ;
    pm:cautionsAbout pmp:ChaosMagicOctavVisualiseTargetNow ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Magical Ritual Part 5: The choice and use of Magical Links, p. 106; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavTelesmata a pm:Practicing ;
    rdfs:label "Using telesmata as link objects"@en, "Telesmata als Verbindungsobjekte nutzen"@de ;
    skos:definition "Use flakes of skin, hair or nail clippings from the target, which bear the target's unique genetic signature and so a morphic link to their origin, or a prized possession of singular nature that still occupies a place in its owner's mind."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Magical Ritual Part 5: The choice and use of Magical Links, p. 106; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavTelesmataWeakCautela a pm:Cautioning ;
    rdfs:label "Telesmatic links are weak"@en, "Telesmatische Verbindungen sind schwach"@de ;
    skos:definition "Telesmatic links rank only a poor fourth: possessions seldom stay entangled with their owners for long, and a unique prized possession gives only a tenuous link through the owner's mind."@en ;
    pm:cautionsAbout pmp:ChaosMagicOctavTelesmata ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Magical Ritual Part 5: The choice and use of Magical Links, p. 106; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavTelesmataDeadFailure a pm:Conceptualizing ;
    rdfs:label "Telesmata are useless for the dead"@en, "Telesmata sind bei Toten nutzlos"@de ;
    skos:definition "Telesmata serve as links only to the living; the dead can no longer send or receive anything."@en ;
    skos:note "Counted as a condition of failure: a link by telesmata to a dead target. No deadline; the failure lies in the target, not in the operator."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Magical Ritual Part 5: The choice and use of Magical Links, p. 106; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavAgainstNecromancy a pm:Conceptualizing ;
    rdfs:label "Against necromancy"@en, "Gegen die Nekromantie"@de ;
    skos:definition "Necromancers are said to create their spirits inside their own heads and to deceive themselves that it is otherwise."@en ;
    skos:note "A dispute of the work with necromancers; the other side is not read."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Magical Ritual Part 5: The choice and use of Magical Links, p. 106; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavOccludedSpaceLink a pm:Practicing ;
    rdfs:label "Linking across occluded space"@en, "Verbindung über verdeckten Raum"@de ;
    skos:definition "For a real-time link to a target out of sight, use visualisation or telesmata; an additional live connection through an electronic network often helps."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Magical Ritual Part 5: The choice and use of Magical Links, p. 106; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavOccludedTimeCautela a pm:Cautioning ;
    rdfs:label "Occluded time corrodes links"@en, "Verdeckte Zeit zersetzt Verbindungen"@de ;
    skos:definition "Links across occluded time are corroded by probabilities that proliferate in imaginary time when used for divination, and in retroactive enchantment, which tries to alter the past, links grow more tenuous as time passes."@en ;
    skos:note "Retroactive enchantment as a capacity is entered in part 1 of this harvest (Magical Ritual Part 4, p. 83) and is not repeated here."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctavHighQualityLink ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Magical Ritual Part 5: The choice and use of Magical Links, pp. 106-107; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavPresentTargetForFutureEffect a pm:Practicing ;
    rdfs:label "Aiming a future-effect enchantment at the present target"@en, "Verzauberung mit künftiger Wirkung auf das gegenwärtige Ziel richten"@de ;
    skos:definition "When enchanting for an effect that should show itself later, aim the spell at the target as it is in the present."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Magical Ritual Part 5: The choice and use of Magical Links, pp. 106-107; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavDoublyOccludedCautela a pm:Cautioning ;
    rdfs:label "Links occluded in space and time are nearly impossible"@en, "In Raum und Zeit verdeckte Verbindungen sind nahezu unmöglich"@de ;
    skos:definition "Where both space and time are occluded, linking is all but impossible, and few serious magicians attempt divination or enchantment of events remote from them in both respects."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctavHighQualityLink ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 5 The Spells of the Linking, Magical Ritual Part 5: The choice and use of Magical Links, p. 107; read in a full-text layer of the first edition" .


#
# Chapter 6, The Spells of Impractical Magic
#

pmc:ChaosMagicOctavMagicAsProbability a pm:Conceptualizing ;
    rdfs:label "Magic works by influencing probability"@en, "Magie wirkt durch Beeinflussung der Wahrscheinlichkeit"@de ;
    skos:definition "For the chaoist, magic operates by shifting the probability of events, which lies between one for certainty and nought for impossibility; magicians treat odds as potentially improvable and regard nothing as wholly certain or wholly impossible."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, p. 108; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavStepwiseAttack a pm:Practicing ;
    rdfs:label "Attacking a daunting goal step by step"@en, "Ein entmutigendes Ziel Schritt für Schritt angehen"@de ;
    skos:definition "Break a goal of daunting odds, such as victory in war, business or romance from a weak start, into individual steps of moderate probability and work magic on each, rather than against the improbable whole; a dozen heads in a row is near hopeless, each single toss is even."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, p. 108; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavSecondEquation a pm:Conceptualizing ;
    rdfs:label "Second equation of magic (Spell of Impractical Magic)"@en, "Zweite Gleichung der Magie (Spruch der unpraktischen Magie)"@de ;
    skos:definition "Probability with magic equals natural probability plus the remainder (one minus natural probability) times the amount of magic, Psi, where Psi is raised to the inverse of the natural probability: magic acts only on what remains, and low-probability events are harder to move. Said to estimate very accurately how far any act of magic can distort probability, and so to show which enchantments and divinations are impractical."@en ;
    skos:note "The equations are garbled in the text layer and read from their prose statement. The chapter calls this the second equation and the one of ch. 7 the first; ch. 7 calls its own the Seventh Spell and refers back to a sixth equation."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, pp. 108-109; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavPracticalityAssessment a pm:Practicing ;
    rdfs:label "Judging practicality by the second equation"@en, "Praktikabilität anhand der zweiten Gleichung beurteilen"@de ;
    skos:definition "Before enchanting or divining, estimate the natural probability and the amount of magic one can raise, and read from the second equation whether the operation stands a chance or is impractical and a waste of effort."@en ;
    skos:note "Read from the use the text assigns to the equation; the text gives no step-by-step procedure."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, p. 109; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavTripodOfStokastikos a pm:Conceptualizing ;
    rdfs:label "Tripod of Stokastikos"@en, "Dreifuß des Stokastikos"@de ;
    skos:definition "A three-dimensional net plotting the second equation: with no magic, probability stays natural; no magic improves a certainty; sufficient magic could in principle lift any probability to one; an impossible event stays impossible until magic of grade one turns it at once into certainty. The central area holds the best opportunities: a natural 0.5 rises to about 0.625 with magic of 0.5 and to about 0.82 with 0.8, and the same figures hold for divination."@en ;
    skos:note "The figure itself is not in the text layer; its features are read from the prose."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, pp. 110-111; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavLikelyEventsCautela a pm:Cautioning ;
    rdfs:label "Little point in reinforcing already likely events"@en, "Wenig Sinn, ohnehin wahrscheinliche Ereignisse zu verstärken"@de ;
    skos:definition "There is little point in spending much magical effort on desired events whose natural probability is already high."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctavEnchantment ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, p. 111; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavExtremeMagicFailure a pm:Conceptualizing ;
    rdfs:label "Extreme acts of magic seldom succeed"@en, "Extreme magische Akte gelingen selten"@de ;
    skos:definition "Turning an impossibility into a certainty proves extraordinarily difficult in practice, above all for large-scale events, where belief and the magical link become problems."@en ;
    skos:note "Counted as a condition of failure: an attempt to turn the impossible into the certain. No deadline or rate; the failure is put on the belief and link the operator can attain against the size of the target."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, p. 111; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavPreferEnchantmentCautela a pm:Cautioning ;
    rdfs:label "Prefer enchantment to divination"@en, "Verzauberung der Divination vorziehen"@de ;
    skos:definition "In a universe of probability enchantment seems preferable to divination: since neither usually reaches certainty, a failed enchantment only invites a revised attempt, whereas a wrong divination acted upon can lead to disaster."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctavDivination ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, pp. 111-112; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavPrevention a pm:Conceptualizing ;
    rdfs:label "Preventing an event by magic (antispell)"@en, "Ein Ereignis durch Magie verhindern (Antispruch)"@de ;
    skos:definition "Lowering the probability that an event occurs; the second spell of impractical magic, the inverse of the first, gives the probability of prevention, magic of grade one turning a certainty into nought."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, p. 112; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavCertaintiesCautela a pm:Cautioning ;
    rdfs:label "Avoid certainties and impossibilities"@en, "Gewissheiten und Unmöglichkeiten meiden"@de ;
    skos:definition "Magicians mostly steer clear of certainties and impossibilities, which they cannot modify but only reverse completely, and that only in exceptional circumstances."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctavEnchantment, pmc:ChaosMagicOctavPrevention ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, p. 112; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavPsiPrimeThaum a pm:Conceptualizing ;
    rdfs:label "Psi, the Prime and the Thaum"@en, "Psi, das Prime und das Thaum"@de ;
    skos:definition "Psi is the amount of magic a magician can bring to bear; a conjuration reaching a Psi of one brings a whole Prime (energy per second) or Thaum (bits per second) into play, so the three are numerically equivalent. The appendix of constants lists the Roundworld Prime and Thaum, the Discworld values being about fifty times higher."@en ;
    skos:note "The units are introduced in ch. 4, which part 1 of this harvest covers. The exponents in Appendix 4 are garbled in the text layer."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, p. 112, and Appendix 4, Symbols and Constants, p. 175; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavGroupNotCumulative a pm:Conceptualizing ;
    rdfs:label "Group conjuration is not cumulative"@en, "Gruppenbeschwörung wirkt nicht kumulativ"@de ;
    skos:definition "A group conjuration is said not to add up: its effect does not exceed that of its most effective participant, though a group may provoke some members to exceptional effort; who achieved it is by etiquette left unasked, as with firing squads."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, p. 112; read in a full-text layer of the first edition" .


#
# Chapter 6, Magical Ritual Part 6: chaometry (iv)
#

pmc:ChaosMagicOctavDirectIndirectRoutes a pm:Systematizing ;
    rdfs:label "Direct and indirect routes of conjuration"@en, "Direkte und indirekte Wege der Beschwörung"@de ;
    skos:definition "Enchantment and divination are the direct routes to exercising magical will or perception; invocation, evocation and illumination are indirect methods, used especially for more complicated objectives."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 113; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavThreeChaometricConsiderations a pm:Systematizing ;
    rdfs:label "Three chaometric considerations: subtlety, linkage, practicality"@en, "Drei chaometrische Erwägungen: Subtilität, Verbindung, Praktikabilität"@de ;
    skos:definition "For every conjuration weigh: (i) subtlety, whether the change lies within the energy, entropy and information indeterminacies of the system; (ii) linkage, whether a reliable link exists; (iii) practicality, whether a useful distortion of probability is likely, which depends on the amount of magic needed."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 113; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavFantasisedAimsFailure a pm:Conceptualizing ;
    rdfs:label "Most fantasised aims are impractical by direct magic"@en, "Die meisten erträumten Ziele sind mit direkter Magie unpraktikabel"@de ;
    skos:definition "The chaometric considerations generally exclude most of what people dream of doing by magic, as impractical by enchantment or divination used directly."@en ;
    skos:note "Counted as a condition of failure: an aim of the kind people fantasise about, pursued by direct enchantment or divination. No deadline; the failure is put on the choice of aim, and the work's answer is the indirect routes of invocation, evocation and illumination."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 113; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavGnosis a pm:Conceptualizing ;
    rdfs:label "Gnosis fixed on an abstract sign of desire"@en, "Gnosis, gerichtet auf eine abstrakte Darstellung des Begehrens"@de ;
    skos:definition "A state of extreme mental focus, reached either by withdrawing attention from everything but one thing (quiescence) or by hyperactively heightening awareness of one thing (excitation), the same condition resulting either way; in conjuration its single object is a sigil or other abstract representation of the desire, not the desire itself, and it launches the conjuration. The glossary adds that in chaoist usage the word means the heightened or ecstatic state of awareness itself, not any piece of knowledge."@en ;
    skos:note "Part 1 of this harvest enters gnosis as introduced at the centring (Magical Ritual part 1, p. 34); its neurological reading is pmc:ChaosMagicCohaerentiaNeurologica. Entered here as factor G of the Seventh Spell, as chs. 6 and 7 and the glossary give it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 114; ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 124; References etc. (glossary), p. 178; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavOvercomingDisbelief a pm:Conceptualizing ;
    rdfs:label "Overcoming disbelief in the desired outcome"@en, "Unglauben an das gewünschte Ergebnis überwinden"@de ;
    skos:definition "Access to previously established structures of belief that help the magician overcome disbelief that the desired outcome is possible."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 114; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavSilencedChatter a pm:Conceptualizing ;
    rdfs:label "Silencing contrary mind chatter so intent reaches the subconscious"@en, "Gegenläufiges Gedankengeplapper zum Schweigen bringen, damit die Absicht das Unterbewusste erreicht"@de ;
    skos:definition "Deleting much contrary conscious mind chatter, so that the intention reaches the more powerful subconscious."@en ;
    skos:note "The centring of the work makes the stilled internal dialogue the condition of all magic; that claim is pmc:ChaosMagicSilentiumInternum."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 114; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavInvocationIndirect a pm:Practicing ;
    rdfs:label "Invocation of a Chaomera or god-form as an indirect route"@en, "Invokation einer Chaomera oder Gottform als indirekter Weg"@de ;
    skos:definition "Invoke a Chaomera or god-form as a sleight of mind against the consensus mindset of the culture that denies magic, entering through it an exalted state established earlier."@en ;
    skos:note "The rite of invocation itself is set out in ch. 3 and Magical Ritual part 3, which part 1 of this harvest enters."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), pp. 113-114; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavInvocationYields a pm:Yielding ;
    rdfs:label "Invocation yields gnosis, belief and silenced chatter"@en, "Invokation ergibt Gnosis, Glauben und gestilltes Geplapper"@de ;
    skos:definition "Invocation is said, first, to ease entry into gnosis by an emotional route back into an exalted state set up earlier, whether of hyper-focussed excitation or of quiescence; second, to open established belief structures against disbelief; third, to delete contrary mind chatter."@en ;
    pm:byPractice pmp:ChaosMagicOctavInvocationIndirect ;
    pm:yieldsCapacity pmc:ChaosMagicOctavGnosis, pmc:ChaosMagicOctavOvercomingDisbelief, pmc:ChaosMagicOctavSilencedChatter ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 114; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavServitorAutonomy a pm:Conceptualizing ;
    rdfs:label "Autonomous task performance by a servitor"@en, "Selbständige Aufgabenerfüllung durch einen Servitor"@de ;
    skos:definition "An evoked entity, a semi-separate intelligence budded off within the subconscious, carries out delegated tasks on its own."@en ;
    skos:note "Part 1 of this harvest enters servitors with groundsleves from ch. 3 (p. 69)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 114; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavEvocationIndirect a pm:Practicing ;
    rdfs:label "Evocation of a servitor as an indirect route"@en, "Evokation eines Servitors als indirekter Weg"@de ;
    skos:definition "Conceive the evoked entity as a semi-separate intelligence or servitor, split off and compartmentalised within the subconscious, and delegate tasks to it, rather than entering into identification with it or possession by it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 114; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavEvocationYields a pm:Yielding ;
    rdfs:label "Evocation yields a servitor's autonomous work"@en, "Evokation ergibt die selbständige Arbeit eines Servitors"@de ;
    skos:definition "The evoked entity is said to perform its delegated tasks autonomously."@en ;
    pm:byPractice pmp:ChaosMagicOctavEvocationIndirect ;
    pm:yieldsCapacity pmc:ChaosMagicOctavServitorAutonomy ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 114; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavGodFormCommunion a pm:Conceptualizing ;
    rdfs:label "Communion with a god-form"@en, "Kommunion mit einer Gottform"@de ;
    skos:definition "Reaching communion with an invoked god-form, the first half of the pairing magicians often use."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 114; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavInvokeThenEvoke a pm:Practicing ;
    rdfs:label "Invoking a god-form, then evoking an entity for a related task"@en, "Eine Gottform invozieren, dann eine Wesenheit für eine verwandte Aufgabe evozieren"@de ;
    skos:definition "First invoke a god-form to achieve communion with it, then evoke an entity of some kind to work automatically on a task of related nature."@en ;
    skos:note "Reported as what magicians frequently do. Combines the two indirect routes; see pmc:ChaosMagicOctavGodFormCommunion and pmc:ChaosMagicOctavServitorAutonomy."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 114; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavGodLegionNaming a pm:Naming ;
    rdfs:label "A god at the head of a legion of lesser spirits and demons"@en, "Ein Gott, der eine Legion niederer Geister und Dämonen befehligt"@de ;
    skos:definition "Old-fashioned terminology recalled for the pairing of invocation and evocation: a god may lead a legion of lesser spirits and demons, read here as an invoked god-form directing evoked servitors in the subconscious."@en ;
    pm:nameForm "god; minor spirits; demons" ;
    pm:nameRole "in old terminology, a god commanding a legion of lesser spirits" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 114; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavFireAndForget a pm:Conceptualizing ;
    rdfs:label "Fire and Forget"@en, "Fire and Forget"@de ;
    skos:definition "Magical missiles of this kind, such as servitors, are said to work all the better once the magician has forgotten them."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 114; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavSigilsEntitiesGods a pm:Systematizing ;
    rdfs:label "Sigils, evoked entities and gods"@en, "Sigillen, evozierte Wesenheiten und Götter"@de ;
    skos:definition "Three somewhat arbitrary, overlapping delineations: simple sigils for simple, well-defined aims; evoked entities for work that need some autonomous intelligent action; gods for complicated objectives such as life-changing inspiration or additions to and deletions from the personal pantheon of selves."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 114; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavInvokeEvokeCautela a pm:Cautioning ;
    rdfs:label "Never invoke what should merely be evoked"@en, "Nie invozieren, was nur evoziert werden sollte"@de ;
    skos:definition "By the old axiom, never invoke what should only have been evoked: minor desires must not grow obsessive and get in the way of High Magic."@en ;
    pm:cautionsAbout pmp:ChaosMagicOctavInvocationIndirect ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 115; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavIllumination a pm:Conceptualizing ;
    rdfs:label "Illumination as real advancement"@en, "Erleuchtung als wirklicher Fortschritt"@de ;
    skos:definition "Advancement in whatever mix of achievement, power, knowledge or wisdom is chosen, on a personal, species or cosmic level; its techniques may use every kind of conjuration, simple spells, evocation and invocation alike."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 115; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavInvokingDeath a pm:Practicing ;
    rdfs:label "Formally invoking Death"@en, "Den Tod förmlich invozieren"@de ;
    skos:definition "As an illumination exercise, formally invoke Death and ask what funeral you want, what your species should remember you for, and what your several selves would wish to recall of one another."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 115; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavInvokingDeathYields a pm:Yielding ;
    rdfs:label "Invoking Death serves illumination"@en, "Die Invokation des Todes dient der Erleuchtung"@de ;
    skos:definition "The invocation of Death is offered as a way of finding out what counts as real advancement for the magician."@en ;
    pm:byPractice pmp:ChaosMagicOctavInvokingDeath ;
    pm:yieldsCapacity pmc:ChaosMagicOctavIllumination ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 6 The Spells of Impractical Magic, Magical Ritual Part 6: chaometry (iv), p. 115; read in a full-text layer of the first edition" .


#
# Chapter 7, The Spell of Practical Magic
#

pmc:ChaosMagicOctavPowersOfSphinx a pm:Systematizing ;
    rdfs:label "The Powers of the Sphinx read technically"@en, "Die Kräfte der Sphinx, technisch gelesen"@de ;
    skos:definition "The initiatory charge of knowing, willing, daring and keeping silent (the Powers of the Sphinx or Witches' Pyramid) is given a technical reading beyond its trivial senses: knowing is the magical link to the target, willing is entering gnosis, daring is belief, and keeping silent is stopping the inner dialogue."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, pp. 116-118; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavLinkIndispensable a pm:Presupposing ;
    rdfs:label "Without a serviceable link nothing can be done"@en, "Ohne brauchbare Verbindung ist nichts zu erreichen"@de ;
    skos:definition "Of all a magician must know, the target matters most: lacking a usable link, no magic accomplishes anything."@en ;
    pm:priorStep pmc:ChaosMagicOctavHighQualityLink ;
    pm:dependentStep pmc:ChaosMagicOctavEnchantment, pmc:ChaosMagicOctavDivination ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Lacking a usable link, the magician achieves nothing whatever." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, p. 116; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavAgainstCorrespondencesAsLinks a pm:Conceptualizing ;
    rdfs:label "Against symbolic correspondences as links"@en, "Gegen symbolische Entsprechungen als Verbindungen"@de ;
    skos:definition "Much historical lore confuses the magical link with the target's supposed astrological, elemental and alchemical attributes; these are no substitute for a link, their real use belonging to Silence, as symbols that occupy the conscious mind while the subconscious, which must hold a serviceable link, does the magic."@en ;
    skos:note "A dispute of the work with historical magical lore; the other side is not read."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, pp. 116-117; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavTargetModel a pm:Practicing ;
    rdfs:label "Building an accurate, current mental model of the target"@en, "Ein genaues, aktuelles Denkmodell des Ziels aufbauen"@de ;
    skos:definition "Before any magical action, get a mental model of the target that is as accurate and current as possible."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, p. 117; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavShootingBlindFailure a pm:Conceptualizing ;
    rdfs:label "Shooting blind"@en, "Blind schießen"@de ;
    skos:definition "Magic's basic techniques are simple, yet they achieve nothing when aimed blindly or at a target that is mostly imagined."@en ;
    skos:note "Counted as a condition of failure: magic aimed without knowledge of its target. No deadline; the failure is put on the operator who did not learn the target."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, p. 117; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavLustOfResultFailure a pm:Conceptualizing ;
    rdfs:label "Lust of result inhibits magic"@en, "Ergebnisgier hemmt die Magie"@de ;
    skos:definition "Desire held consciously seldom has parapsychological effect, however fervently amplified, and a conscious lust of result frequently hampers magic; using will merely to swell conscious desire or craving for results has very little magical effect. Were it otherwise, wishes would come true with alarming immediacy."@en ;
    skos:note "Counted as a condition of failure: conscious craving for the result, however intense. No deadline; the failure is put on the operator's conscious desire."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, pp. 117-118; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavForgottenDesires a pm:Conceptualizing ;
    rdfs:label "Desires come true once forgotten"@en, "Wünsche erfüllen sich, wenn sie vergessen sind"@de ;
    skos:definition "Conscious desires tend to be fulfilled only after the conscious mind lets go of them, which is called the key to how will works in magic; plenty of people obtain their wishes in the end but too late, and the magician hurries the process by sleight of mind."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, p. 117; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavWillIntoGnosis a pm:Practicing ;
    rdfs:label "Using will to enter gnosis on an abstract representation"@en, "Den Willen nutzen, um in Gnosis auf eine abstrakte Darstellung einzutreten"@de ;
    skos:definition "When conjuring, use will to reach a state of intense focus that leaves out conscious desire and concentrates instead, by deep meditation or by ecstatic emotional arousal, on an abstract representation of the desire, so that the subconscious is provoked into setting the real desire and its stored link to work."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, pp. 117-118; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavWillIntoGnosisYields a pm:Yielding ;
    rdfs:label "Willed focus yields gnosis"@en, "Gewollte Fokussierung ergibt Gnosis"@de ;
    skos:definition "Will used to reach the mental condition of gnosis, rather than to inflate desire, is said to set the subconscious to work on desire and link."@en ;
    pm:byPractice pmp:ChaosMagicOctavWillIntoGnosis ;
    pm:yieldsCapacity pmc:ChaosMagicOctavGnosis ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, p. 118; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavDaring a pm:Conceptualizing ;
    rdfs:label "Daring as belief or suspended disbelief"@en, "Wagen als Glaube oder ausgesetzter Unglaube"@de ;
    skos:definition "Daring implies some belief in the possibility of what is attempted, or at least suspended disbelief, since nobody attempts what he thinks truly impossible; the wands, robes and books of magic mainly serve to reinforce the intuition that magic might prove possible, in cultural climates usually hostile to it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, p. 118; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavRomanceOrQuantum a pm:Conceptualizing ;
    rdfs:label "Romance of Sorcery or quantum physics as ground of belief"@en, "Romantik der Zauberei oder eine Quantenbasis des Glaubens"@de ;
    skos:definition "Some religions keep magical powers for their deities alone, grudgingly allowing miracles of faith, and classical non-quantum science dismisses magic as a delusion that causality forbids; so magicians who abandon theological explanations mostly ground their belief either in a deliberately irrational Romance of Sorcery or in quantum physics, or in an odd blend."@en ;
    skos:note "A dispute of the work with religions that reserve magical powers to their deities and with classical science; the other sides are characterised, not read; the other side is not read."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, p. 118; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavKeepingSilent a pm:Conceptualizing ;
    rdfs:label "Keeping Silent as stopping the inner dialogue"@en, "Schweigen als Anhalten des inneren Dialogs"@de ;
    skos:definition "The inner esoteric meaning of keeping silent is halting the inner conscious dialogue by a sleight of mind so that the more powerful subconscious can go to work."@en ;
    skos:note "The work's centring states the same as a condition of all magic: pmc:ChaosMagicSilentiumInternum."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, p. 118; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavSpellsByAnalogy a pm:Conceptualizing ;
    rdfs:label "All spells work by analogy"@en, "Alle Zauber wirken durch Analogie"@de ;
    skos:definition "The spells in books all work by analogy: they are symbolic representations of what the magician wants, not the thing itself."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, p. 119; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavFocusOnSymbol a pm:Practicing ;
    rdfs:label "Focusing gnostically on the symbol and forgetting its meaning"@en, "Gnostisch auf das Symbol fokussieren und seine Bedeutung vergessen"@de ;
    skos:definition "Concentrate with the utmost gnostic intensity on the symbol or analogue while wholly forgetting, consciously, what it stands for."@en ;
    skos:note "The author says most books fail to make this clear."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, p. 119; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavConsciousDesireDoubtFailure a pm:Conceptualizing ;
    rdfs:label "Conscious desire is fatal through doubt"@en, "Bewusstes Begehren ist tödlich durch Zweifel"@de ;
    skos:definition "Conscious wanting often kills magical intent, since it always gathers doubt about itself within the inner dialogue; only desires that stay subliminal yet intense usually bear fruit."@en ;
    skos:note "Counted as a condition of failure: a desire held consciously during the work, which breeds doubt. No deadline; the failure is put on the operator's inner dialogue."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, p. 119; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavForgettingAfterConjuring a pm:Practicing ;
    rdfs:label "Turning awareness away after conjuring"@en, "Nach der Beschwörung die Aufmerksamkeit abwenden"@de ;
    skos:definition "After conjuring, avoid thinking about the desire by forcefully turning awareness to other matters: a banishing ritual, any distraction, or a deliberate burst of laughter followed by a change of subject in thought."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, p. 119; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavCorrespondenceTables a pm:Conceptualizing ;
    rdfs:label "Tables of correspondences: limited value"@en, "Entsprechungstabellen: begrenzter Wert"@de ;
    skos:definition "Tables of the supposed occult qualities of things are not high-grade magical knowledge; they help in ensigilising desire with symbolic substitutes and in deciphering divinations that answer in symbols, but only meanings the magician already accepts have any value, which is why many magicians today invent their own."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, p. 119; read in a full-text layer of the first edition" .


#
# Chapter 7, Chaometry Part 4
#

pmc:ChaosMagicOctavSeventhSpell a pm:Conceptualizing ;
    rdfs:label "Seventh Spell (Equation of Practical Magic)"@en, "Siebter Spruch: die Gleichung der praktischen Magie"@de ;
    skos:definition "The magic available to any conjuration, Psi, is the product of the achievable values of four mental manoeuvres, Gnosis, Link, Subliminalisation and Belief, each on a scale from nought to one; falling short in any one cuts the whole drastically, as a pyramid rises no higher than its shortest face."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Chaometry Part 4, p. 120; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavFourFactorsNeeded a pm:Presupposing ;
    rdfs:label "All four factors are needed"@en, "Alle vier Faktoren sind nötig"@de ;
    skos:definition "Gnosis, link, subliminalisation and belief must each be present for magic to be available at all."@en ;
    pm:priorStep pmc:ChaosMagicOctavGnosis, pmc:ChaosMagicOctavHighQualityLink, pmc:ChaosMagicOctavSubliminalisedDesire, pmc:ChaosMagicOctavMagicCapableSelf ;
    pm:dependentStep pmc:ChaosMagicOctavSeventhSpell ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "A value of nought for any one factor makes the whole product, the available magic, nought." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Chaometry Part 4, p. 120; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavHalfMeasuresFailure a pm:Conceptualizing ;
    rdfs:label "Half measures accomplish nothing"@en, "Halbe Sachen bewirken nichts"@de ;
    skos:definition "Reaching 0.5 on each of the four factors yields only 0.0625, a sixteenth of the optimum; half measures probably bring not half a result but nothing."@en ;
    skos:note "Counted as a condition of failure: half effort on each factor. A rate is set (a sixteenth of full magic, probably no result) but no deadline; the failure is put on the operator's incomplete effort."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Chaometry Part 4, p. 120; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavUsefulMagicThreshold a pm:Conceptualizing ;
    rdfs:label "Threshold for useful magic"@en, "Schwelle für nützliche Magie"@de ;
    skos:definition "If all four factors reach about 0.85, magic of about 0.5 is available, enough to shift medium probabilities usefully."@en ;
    skos:note "Entered as a concept, not a sign of success: it states what magic is available, not how a result is recognised. The text says the sixth equation shows this; in ch. 6 the probability equation is called the second."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Chaometry Part 4, p. 120; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavExhaustingWorkCautela a pm:Cautioning ;
    rdfs:label "Conjuration is hard and exhausting work"@en, "Beschwörung ist harte, erschöpfende Arbeit"@de ;
    skos:definition "Because the factors multiply, magicians must give their conjurations everything they have, which is often very hard, exhausting work."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctavSeventhSpell ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Chaometry Part 4, p. 120; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavCrisisPersistent a pm:Systematizing ;
    rdfs:label "Crisis magicians and persistent magicians"@en, "Krisenmagier und beharrliche Magier"@de ;
    skos:definition "Successful magicians come in two kinds: crisis magicians, whose results seem to come only in desperation, and persistent magicians, who give much of their free time to practising gnosis, visualisation, belief and sleight of mind; the techniques that follow are addressed mainly to the latter."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Chaometry Part 4, p. 121; read in a full-text layer of the first edition" .


#
# Chapter 7, Magical Ritual Part 7
#

pmc:ChaosMagicOctavPyramidOrder a pm:Presupposing ;
    rdfs:label "Building the Pyramid in order"@en, "Die Pyramide der Reihe nach aufbauen"@de ;
    skos:definition "Working towards a conjuration, the magician first builds reserves of belief, then establishes a link particular to the objective, then subliminalises or ensigilises the desire, and finally launches the conjuration with gnosis."@en ;
    pm:priorStep pmc:ChaosMagicOctavMagicCapableSelf, pmc:ChaosMagicOctavHighQualityLink, pmc:ChaosMagicOctavSubliminalisedDesire ;
    pm:dependentStep pmc:ChaosMagicOctavGnosis ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 122; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavBeliefsAsTools a pm:Conceptualizing ;
    rdfs:label "Beliefs as tools"@en, "Glaubenssätze als Werkzeuge"@de ;
    skos:definition "In the chaoist paradigm beliefs are tools, not ends: one should own one's beliefs rather than be owned by them. Mutually inconsistent beliefs held in separate compartments make a more useful toolbox than one consistent set, defend against paranoia and allow the unwanted beliefs of a system to be ignored; nothing has absolute truth and anything may prove possible."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 122; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavMagicCapableSelf a pm:Conceptualizing ;
    rdfs:label "Belief in a magic-capable self"@en, "Glaube an ein magiefähiges Selbst"@de ;
    skos:definition "A subconscious belief that one can do magic, built up as a reserve before conjuration; factor B of the Seventh Spell."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 122; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavPersonalTools a pm:Practicing ;
    rdfs:label "Acquiring and using personal magical tools"@en, "Persönliche magische Werkzeuge beschaffen und gebrauchen"@de ;
    skos:definition "Acquire wands, robes, rings, amulets, crystals, groundsleves and similar apparatus, taking pains to get items that truly matter to oneself, preferably handmade or self-designed, and practise with them regularly."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, pp. 122-123; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavPersonalToolsYields a pm:Yielding ;
    rdfs:label "Ritual and tools implant belief"@en, "Ritual und Werkzeuge pflanzen Glauben ein"@de ;
    skos:definition "We believe what we do rather than do what we believe: consciously handling physical tools links one to subconscious powers and beliefs as they develop, and ritual implants belief, an effect religions are said to exploit cynically."@en ;
    pm:byPractice pmp:ChaosMagicOctavPersonalTools ;
    pm:yieldsCapacity pmc:ChaosMagicOctavMagicCapableSelf ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 122; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavPurchasedItemsCautela a pm:Cautioning ;
    rdfs:label "Purchased items work worse"@en, "Gekaufte Gegenstände wirken schlechter"@de ;
    skos:definition "Tools help belief only if belief is invested in them first; purchased items work far worse than handmade or self-designed ones unless their origin is highly unusual or significant."@en ;
    pm:cautionsAbout pmp:ChaosMagicOctavPersonalTools ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 123; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavConcealmentCautela a pm:Cautioning ;
    rdfs:label "Conceal magic from hostile civilians"@en, "Magie vor feindseligen Zivilisten verbergen"@de ;
    skos:definition "As magic is a minority belief in most cultures, magicians should hide their ideas from hostile outsiders, appear humorously dismissive of the whole notion, forestalling criticism by supplying it themselves, or pass off their interest as merely scholarly."@en ;
    skos:note "The text gives the reason as a minority position; the protection of the magician's belief from unproductive criticism is the integrator's reading of the object."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctavMagicCapableSelf ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 123; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavHallucinatoryVisualisation a pm:Conceptualizing ;
    rdfs:label "Visualisation to the point of hallucination"@en, "Visualisierung bis an die Halluzination"@de ;
    skos:definition "The ability to visualise so vividly that it approaches hallucination."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 123; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavLinkWork a pm:Practicing ;
    rdfs:label "Link work: assume little, hunt information, visualise"@en, "Verbindungsarbeit: wenig annehmen, Information jagen, visualisieren"@de ;
    skos:definition "Assume as little as possible, hunt for information about the target like a hawk, and learn to visualise until it nears hallucination; build a serviceable link into the subconscious before the conjuration, but pay it no conscious attention during it."@en ;
    skos:note "Uses the ability entered as pmc:ChaosMagicOctavHallucinatoryVisualisation."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 123; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavLinkWorkYields a pm:Yielding ;
    rdfs:label "Link work yields a subconscious link"@en, "Verbindungsarbeit ergibt eine unterbewusste Verbindung"@de ;
    skos:definition "This preparation is said to install a usable link in the subconscious ahead of conjuring."@en ;
    pm:byPractice pmp:ChaosMagicOctavLinkWork ;
    pm:yieldsCapacity pmc:ChaosMagicOctavHighQualityLink ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 123; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavSubliminalisedDesire a pm:Conceptualizing ;
    rdfs:label "Subliminalised desire (factor S)"@en, "Subliminalisiertes Begehren (Faktor S)"@de ;
    skos:definition "Making a symbolic representation, sigil, spell or other trigger that sets the subconscious acting on what the conjuration intends; the formal recipes of the libraries are not needed, since anything serves if the magician makes it or understands its making. The resulting form becomes the focus of gnosis during the conjuration."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, pp. 123-124; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavPhysicalSigil a pm:Practicing ;
    rdfs:label "Making a physical sigil"@en, "Ein physisches Sigill herstellen"@de ;
    skos:definition "Shape a roughly abstract image of the desire in clay, or as an unusual arrangement of mundane objects."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 123; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavVerbalSpell a pm:Practicing ;
    rdfs:label "Making a verbal spell"@en, "Einen verbalen Zauberspruch herstellen"@de ;
    skos:definition "Garble the plain-language wording of the desire inventively, or transliterate it into a language one does not understand."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, pp. 123-124; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavVisualSpell a pm:Practicing ;
    rdfs:label "Making a visual spell"@en, "Einen visuellen Zauber herstellen"@de ;
    skos:definition "Draw a stylised picture of the outcome wanted and go on altering it until it turns into a wholly abstract design."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 124; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavVisualisableSpell a pm:Practicing ;
    rdfs:label "Making a spell to visualise"@en, "Einen visualisierbaren Zauber herstellen"@de ;
    skos:definition "Take a drawing or a written statement of the desire and keep changing and simplifying it until it is abstract and simple enough to hold in visualisation."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 124; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavSpellFormsYield a pm:Yielding ;
    rdfs:label "The four spell forms yield a subliminalised desire"@en, "Die vier Zauberformen ergeben ein subliminalisiertes Begehren"@de ;
    skos:definition "Each of the four ways of making a sigil or spell gives the subliminalised form of the desire that becomes the focus of gnosis in the conjuration."@en ;
    pm:byPractice pmp:ChaosMagicOctavPhysicalSigil, pmp:ChaosMagicOctavVerbalSpell, pmp:ChaosMagicOctavVisualSpell, pmp:ChaosMagicOctavVisualisableSpell ;
    pm:yieldsCapacity pmc:ChaosMagicOctavSubliminalisedDesire ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, pp. 123-124; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavQuiescentGnosis a pm:Practicing ;
    rdfs:label "Quiescent (yogic) gnosis"@en, "Ruhende (yogische) Gnosis"@de ;
    skos:definition "Approach gnosis by yogic-type methods of mental quiescence and focus, withdrawing attention from all but the single object, the sigil or spell."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 124; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavEcstaticGnosis a pm:Practicing ;
    rdfs:label "Ecstatic (tantrik) gnosis"@en, "Ekstatische (tantrische) Gnosis"@de ;
    skos:definition "Approach gnosis by tantrik-type methods, ecstatic arousal through eroticism, anger or another strong emotion, while focusing on the single object."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 124; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavGnosisMethodsYield a pm:Yielding ;
    rdfs:label "Quiescent and ecstatic methods yield gnosis"@en, "Ruhende und ekstatische Methoden ergeben Gnosis"@de ;
    skos:definition "Whether approached by quiescent or by ecstatic methods, the same condition of gnosis is said to result."@en ;
    pm:byPractice pmp:ChaosMagicOctavQuiescentGnosis, pmp:ChaosMagicOctavEcstaticGnosis ;
    pm:yieldsCapacity pmc:ChaosMagicOctavGnosis ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 124; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavMasterBothGnosisTypes a pm:Presupposing ;
    rdfs:label "Master one technique of each type of gnosis"@en, "Je eine Technik beider Gnosisarten beherrschen"@de ;
    skos:definition "A magician ought to command at least one quiescent and one ecstatic technique of gnosis."@en ;
    pm:priorStep pmp:ChaosMagicOctavQuiescentGnosis, pmp:ChaosMagicOctavEcstaticGnosis ;
    pm:dependentStep pmc:ChaosMagicOctavGnosis ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 124; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavTantrikPrivateCautela a pm:Cautioning ;
    rdfs:label "Keep tantrik gnosis to temple or private work"@en, "Tantrische Gnosis auf Tempel- oder Privatarbeit beschränken"@de ;
    skos:definition "The tantrik style of gnosis is better kept to work in the temple, or at least in private."@en ;
    pm:cautionsAbout pmp:ChaosMagicOctavEcstaticGnosis ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 124; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavBusStopSuccess a pm:Conceptualizing ;
    rdfs:label "The bus-stop test of competent gnosis"@en, "Der Bushaltestellentest kompetenter Gnosis"@de ;
    skos:definition "A competent magician should manage, standing motionless with closed eyes at a bus stop, to let the whole universe vanish except one sigil visualised in blazing clarity or one spell murmured."@en ;
    skos:note "Counted as a sign of success: the ability to make everything vanish but a single sigil or spell while standing at a bus stop. No deadline; a test the magician applies to himself in public, observable only from within."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 124; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavDrugsCautela a pm:Cautioning ;
    rdfs:label "Drugs usually confuse modern practitioners"@en, "Drogen verwirren heutige Praktizierende meist"@de ;
    skos:definition "Drugs have a long history in ecstatic communal rites and vision quests, but most people in developed countries already live in perpetual mental hyperactivity, so adding drugs mostly just confuses and scatters focus further."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctavGnosis ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 125; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavDrugDoorOpens a pm:Conceptualizing ;
    rdfs:label "A door opened by a drug opens at will thereafter"@en, "Eine durch Droge geöffnete Tür öffnet sich danach willentlich"@de ;
    skos:definition "As the real shamans are said to hold, once a drug has really opened a door, it opens at will from then on, and most such substances yield everything they can at the first try."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 125; read in a full-text layer of the first edition" .


#
# Chapter 8, The Spell of the Narration, The Map part 4
#

pmc:ChaosMagicOctavAuthorshipOfStory a pm:Conceptualizing ;
    rdfs:label "Indeterminacy confers authorship of one's chapters"@en, "Unbestimmtheit verleiht Urheberschaft der eigenen Kapitel"@de ;
    skos:definition "We live within a never-ending story with no cosmic genesis and no cosmic apocalypse, though small and medium ones abound; quantum indeterminacy gives us the choice of what chapters to write for ourselves, which raises the question of what to use freedom and magic for, that is, of High Magic."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, The Map part 4, pp. 128-129; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavEthicsFromPhysicsCautela a pm:Cautioning ;
    rdfs:label "Deriving ethics from physics is dangerous"@en, "Ethik aus Physik abzuleiten ist gefährlich"@de ;
    skos:definition "Distilling metaphysics from the sciences and ethics from that metaphysics is a hard and hazardous exercise that has sometimes ended horribly: Newtonian dynamics fed an atomised individualism, Enlightenment ideas pushed too far fed revolutionary horrors, Darwinian theories fed eugenics, Lysenkoist biology fed communist ideology; the new holistic paradigms by themselves yield no values."@en ;
    skos:note "A warning the author gives before taking the same step himself."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctavValueAsIntegratedInformation ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, The Map part 4, p. 129; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavValueAsIntegratedInformation a pm:Conceptualizing ;
    rdfs:label "Value lies in integrated information"@en, "Wert liegt in integrierter Information"@de ;
    skos:definition "Aligning values with what the universe seems to strive for: wherever energy flows, complexity flowers, so ascribing value to existence tacitly ascribes it to complexity; the intrinsic worth of a structure lies in how much coherent or integrated information it holds."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, The Map part 4, pp. 129-130; read in a full-text layer of the first edition" .


#
# Chapter 8, Chaometry part 5: 'Spiritual' Matters
#

pmc:ChaosMagicOctavEighthSpell a pm:Conceptualizing ;
    rdfs:label "Eighth Spell: the Spell of the Narration"@en, "Achter Spruch: der Spruch der Erzählung"@de ;
    skos:definition "An equation setting the boundary of a system (Ubiquity squared) equal to its information, which equals integrated information plus entropy in information units; it sets the scope and bounds of whatever story a system can make, scales from the universe down to ecological, socio-political and personal size by shrinking the boundary term, and so models the growth and collapse of societies, empires, religions, ecosystems and single lives. It is called a Roundworld analogue of Discworld's Narrativium."@en ;
    skos:note "The equation is garbled in the text layer and read from its prose statement."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Chaometry part 5: 'Spiritual' Matters, pp. 131-132; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavStoryPlanning a pm:Conceptualizing ;
    rdfs:label "Making sense of and planning stories"@en, "Geschichten verstehen und planen"@de ;
    skos:definition "The ability, which the Eighth equation is said to give, to make general sense of stories great and small and to plan them despite the large element of randomness, without any guarantee of a happy ending."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Chaometry part 5: 'Spiritual' Matters, pp. 131-132; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavApplyEighthEquation a pm:Practicing ;
    rdfs:label "Applying the Eighth equation to one's own life"@en, "Die Achte Gleichung auf das eigene Leben anwenden"@de ;
    skos:definition "Scale the boundary term down to personal size, one's boundaries in society, geography, money and mind, and consider one's information intake, integrated information and entropy in order to model and plan one's own story."@en ;
    skos:note "Read from the text's statement that the equation can be cut down to personal size and from its account of a person's boundaries; no stepwise procedure is given."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Chaometry part 5: 'Spiritual' Matters, pp. 131-132; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavApplyEighthEquationYields a pm:Yielding ;
    rdfs:label "Applying the Eighth equation yields story planning"@en, "Die Anwendung der Achten Gleichung ergibt Geschichtsplanung"@de ;
    skos:definition "Applying the equation is said to allow general sense and plans to be made of stories."@en ;
    pm:byPractice pmp:ChaosMagicOctavApplyEighthEquation ;
    pm:yieldsCapacity pmc:ChaosMagicOctavStoryPlanning ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Chaometry part 5: 'Spiritual' Matters, p. 131; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavDeathNaming a pm:Naming ;
    rdfs:label "Death"@en, "Der Tod"@de ;
    skos:definition "On Discworld Death is an anthropomorphic character who speaks in portentous capitals before using his scythe; on Roundworld death is only a privative concept, the mere absence of life."@en ;
    pm:nameForm "Death" ;
    pm:nameRole "on Roundworld a privative concept, the absence of life, not a being" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Chaometry part 5: 'Spiritual' Matters, p. 131; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavEighthTerms a pm:Conceptualizing ;
    rdfs:label "The terms of the Eighth equation"@en, "Die Terme der Achten Gleichung"@de ;
    skos:definition "Ubiquity squared is the effective surface area of a system in information units, for a person the limits of their social, geographic, financial and mental reach; H the information available; S over k the entropy, useless unstructured information, in information units; Phi the integrated information after Tononi, roughly negentropy, the structured exchange a system's elements can carry on and how sophisticated they are. If structure rises entropy falls, and shifts between the two cause the rise and fall of mice, men and star systems."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Chaometry part 5: 'Spiritual' Matters, pp. 132-133; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavEntropyConserved a pm:Conceptualizing ;
    rdfs:label "Entropy brought under Noether's principle"@en, "Entropie unter Noethers Prinzip gebracht"@de ;
    skos:definition "The Eighth equation is said to place entropy, alone among physical quantities seemingly exempt, under a conservation law: a system's boundary conserves the information within it, total entropy plus integrated information remaining constant."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Chaometry part 5: 'Spiritual' Matters, p. 133; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavQuantityVsQuality a pm:Conceptualizing ;
    rdfs:label "Rise and fall through quantity rather than quality of integrated information"@en, "Aufstieg und Fall durch Quantität statt Qualität integrierter Information"@de ;
    skos:definition "Rome, bounded by photosynthesis within its frontiers, spent its input on ever more complex structures but for centuries made them bigger, not smarter; past the point of diminishing returns it grew fragile and collapsed into radical simplification, Christianity being a symptom of that collapse, not its cause. The author applies the model to the present civilisation built on fossil fuels, which must innovate toward other inputs or collapse, and to individuals, who face the same choices."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Chaometry part 5: 'Spiritual' Matters, pp. 133-136; read in a full-text layer of the first edition" .


#
# Chapter 8, Magical Ritual part 5 [sic]: The Choice of What To Use Magic For
#

pmc:ChaosMagicOctavFourMetaChoices a pm:Systematizing ;
    rdfs:label "Four meta-choices for a life story"@en, "Vier Meta-Entscheidungen für eine Lebensgeschichte"@de ;
    skos:definition "Four meta-choices govern the composing of a life story, magical or not, read off the Eighth equation: (1) change horizon size; (2) increase the quality of integrated information; (3) increase its quantity; (4) increase entropy."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Magical Ritual part 5 [sic, for part 8]: The Choice of What To Use Magic For, p. 137; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavRecklessHorizonsCautela a pm:Cautioning ;
    rdfs:label "Reckless or narrowing pursuits limit horizons"@en, "Rücksichtslose oder verengende Bestrebungen begrenzen Horizonte"@de ;
    skos:definition "Wealth, travel, socialising, reproduction, new experience and learning usually widen horizons, but each can become a limit when pursued recklessly, when it narrows into specialisation, gives diminishing returns or excludes all else."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctavExpandedHorizons ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Magical Ritual part 5 [sic, for part 8]: The Choice of What To Use Magic For, p. 137; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavDeityInnerSource a pm:Naming ;
    rdfs:label "Deity as an internal power source"@en, "Gottheit als innere Kraftquelle"@de ;
    skos:definition "Within the chaos magic paradigm a deity invoked in support of any activity of life is held to be an internal power source, real or imaginary."@en ;
    pm:nameForm "deity" ;
    pm:nameRole "an internal power source, real or imaginary" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Magical Ritual part 5 [sic, for part 8]: The Choice of What To Use Magic For, p. 138; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavExpandedHorizons a pm:Conceptualizing ;
    rdfs:label "Expanded horizons"@en, "Erweiterte Horizonte"@de ;
    skos:definition "A larger horizon, all that one knows, has experienced and can do, which sets one's energy and information input: greater opportunities, abilities, experiences or knowledge."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Magical Ritual part 5 [sic, for part 8]: The Choice of What To Use Magic For, pp. 137-138; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavHorizonConjuring a pm:Practicing ;
    rdfs:label "Conjuring only for wider horizons"@en, "Nur für weitere Horizonte beschwören"@de ;
    skos:definition "Do, or conjure for, only what is likely to bring greater opportunities, abilities, experiences or knowledge."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Magical Ritual part 5 [sic, for part 8]: The Choice of What To Use Magic For, p. 138; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavHorizonConjuringYields a pm:Yielding ;
    rdfs:label "Horizon-directed conjuring yields expansion"@en, "Horizontgerichtetes Beschwören ergibt Erweiterung"@de ;
    skos:definition "In general only conjurations likely to expand horizon size are said to be worth performing."@en ;
    pm:byPractice pmp:ChaosMagicOctavHorizonConjuring ;
    pm:yieldsCapacity pmc:ChaosMagicOctavExpandedHorizons ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Magical Ritual part 5 [sic, for part 8]: The Choice of What To Use Magic For, p. 138; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavPrometheanQuest a pm:Conceptualizing ;
    rdfs:label "The wisdom and power of the gods (Promethean quest)"@en, "Weisheit und Macht der Götter (prometheische Suche)"@de ;
    skos:definition "Magic at its best is hubristic: it seeks the wisdom and power of whatever gods can be imagined, though the seeker will probably die trying."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Magical Ritual part 5 [sic, for part 8]: The Choice of What To Use Magic For, p. 138; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavQualityNoCostlier a pm:Conceptualizing ;
    rdfs:label "Quality is no dearer than quantity"@en, "Qualität kostet nicht mehr als Quantität"@de ;
    skos:definition "Integrated information costs the same effort whether of high or low quality, much as fitness costs no more than fatness; more of the same is not better unless one has too little, while different is better, especially if it may lead somewhere."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Magical Ritual part 5 [sic, for part 8]: The Choice of What To Use Magic For, p. 138; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavWealthSideEffect a pm:Conceptualizing ;
    rdfs:label "Needed wealth arriving as a side effect"@en, "Benötigter Wohlstand als Nebenwirkung"@de ;
    skos:definition "Whatever wealth is actually needed is said to appear as a side effect when one conjures for the experiences it would buy."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Magical Ritual part 5 [sic, for part 8]: The Choice of What To Use Magic For, p. 139; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavConjureForExperience a pm:Practicing ;
    rdfs:label "Conjuring for experience, not wealth or more of the same"@en, "Für Erfahrung beschwören, nicht für Reichtum oder mehr vom Gleichen"@de ;
    skos:definition "Conjure for needs if one must, but better for opportunity and richer experience, never just for more of what one has; rather than wealth, conjure for whatever experiences one would buy with it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Magical Ritual part 5 [sic, for part 8]: The Choice of What To Use Magic For, p. 139; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavConjureForExperienceYields a pm:Yielding ;
    rdfs:label "Conjuring for experience yields needed wealth"@en, "Beschwören für Erfahrung ergibt benötigten Wohlstand"@de ;
    skos:definition "Any wealth required for those experiences is said then to materialise as a side effect."@en ;
    pm:byPractice pmp:ChaosMagicOctavConjureForExperience ;
    pm:yieldsCapacity pmc:ChaosMagicOctavWealthSideEffect ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Magical Ritual part 5 [sic, for part 8]: The Choice of What To Use Magic For, p. 139; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavCreationOverAcquisition a pm:Conceptualizing ;
    rdfs:label "Creation over acquisition"@en, "Erschaffen statt Erwerben"@de ;
    skos:definition "Where consumer choices now define identity for many, the magician gets more satisfaction from creating than in acquiring: a fresh item of mental furniture, a work of art, a mastered ability or a new friendship satisfies more lastingly than a purchase."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Magical Ritual part 5 [sic, for part 8]: The Choice of What To Use Magic For, p. 139; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavVirtueOverPleasure a pm:Conceptualizing ;
    rdfs:label "Virtue accrues, pleasure does not"@en, "Tugend sammelt sich an, Lust nicht"@de ;
    skos:definition "Virtue accrues by increasing the quality integrated information within one's horizon by improving oneself and serving others, and cannot be lost, though anti-virtue can be piled up by selfish or self-destructive conduct; pleasure, in homeostatic organisms, does not accrue and soon evaporates, so one should seek virtues that bring pleasure as a side effect."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Magical Ritual part 5 [sic, for part 8]: The Choice of What To Use Magic For, pp. 139-140; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavGreatWork a pm:Conceptualizing ;
    rdfs:label "The Great Work of Magic"@en, "Das Große Werk der Magie"@de ;
    skos:definition "Like the great works of science and art, producing more integrated information of high quality than entropy: ideas that endure or open to new ways of thinking; the quest of High Magic for greater knowledge and ability."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Magical Ritual part 5 [sic, for part 8]: The Choice of What To Use Magic For, pp. 140-141; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavNaturalPhilosophy a pm:Conceptualizing ;
    rdfs:label "Magic as natural philosophy"@en, "Magie als Naturphilosophie"@de ;
    skos:definition "The particular skill of the magician caste is a readiness to look into what others think impossible, insane, inviolate or unthinkable; magicians carry on natural philosophy, holding that even seemingly miraculous events are open to understanding, and attend to the anomalies a too tightly bounded science misses. Magical thinking is credited with helping create metallurgy, chemistry, astronomy and medicine, religions and art forms."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Magical Ritual part 5 [sic, for part 8]: The Choice of What To Use Magic For, pp. 140-141; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavResultsMagicCautela a pm:Cautioning ;
    rdfs:label "Results magic only in service of the Great Work"@en, "Ergebnismagie nur im Dienst des Großen Werks"@de ;
    skos:definition "Some results magic for life's needs is acceptable only while it serves High Magic's Great Work, the pursuit of more knowledge and ability, the word power being avoided for its worrying connotations; conjure responsibly."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctavGreatWork ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 8 The Spell of the Narration, Magical Ritual part 5 [sic, for part 8]: The Choice of What To Use Magic For, pp. 141-142; read in a full-text layer of the first edition" .


#
# Appendix 1 (Chapter ?), The Knights of Chaos
#

pmc:ChaosMagicOctavConceptsNeedBelief a pm:Conceptualizing ;
    rdfs:label "On Roundworld concepts need carrying with belief"@en, "Auf der Rundwelt müssen Begriffe mit Glauben getragen werden"@de ;
    skos:definition "Discworld's higher Planck value makes panpsychism plainly visible there, and concepts walk about as personified agents; on Roundworld such concepts must be carried by us and give them some extra belief and help."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), The Knights of Chaos, pp. 143-144; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavChaosGodform a pm:Practicing ;
    rdfs:label "Giving Chaos a godform"@en, "Dem Chaos eine Gottform geben"@de ;
    skos:definition "Invest the extra effort needed to give the concept of Chaos an actual godform on Roundworld, the better to invoke its powers, modelled on the Discworld avatar: a full-face helmet whose visor bears something between butterfly and Rorschach blot, and a weapon so cold it has negative heat."@en ;
    skos:note "Offered as an option chaos magicians might weigh."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), The Knights of Chaos, pp. 144-145; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavReverseEntropyBendProbability a pm:Conceptualizing ;
    rdfs:label "Reversing entropy and bending probability"@en, "Entropie umkehren und Wahrscheinlichkeit beugen"@de ;
    skos:definition "The powers the weapon of Chaos symbolises, named as just the general abilities a magician needs to focus on."@en ;
    skos:note "Part 1 of this harvest enters entropy reversal on finely balanced systems from ch. 4 (p. 79)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), The Knights of Chaos, p. 145; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavChaosGodformYields a pm:Yielding ;
    rdfs:label "The Chaos godform yields its powers"@en, "Die Chaos-Gottform ergibt ihre Kräfte"@de ;
    skos:definition "Investing effort in the godform of Chaos is suggested as a way of invoking the power to reverse entropy and bend probability."@en ;
    pm:byPractice pmp:ChaosMagicOctavChaosGodform ;
    pm:yieldsCapacity pmc:ChaosMagicOctavReverseEntropyBendProbability ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), The Knights of Chaos, p. 145; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavKhaosNaming a pm:Naming ;
    rdfs:label "Khaos, Chaos"@en, "Khaos, Chaos"@de ;
    skos:definition "In Greek thought an unpredictable, unlawful primordial mess from which came the world, the Titans, the gods and humanity, later a mere synonym for disorder; on Discworld the former Fifth Horseman who left the apocalypse, took a more symbiotic relation with order, changed his name and averted the apocalypse while still subverting the Law. The new Chaos is said to feed on the chaos born of complexity itself, creative as well as destructive."@en ;
    pm:nameForm "Khaos; Chaos; Kaos" ;
    pm:nameRole "primordial creative-destructive principle; godform to be invoked" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), The Knights of Chaos, pp. 144-146; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavOrderChaosDisorder a pm:Systematizing ;
    rdfs:label "The triality Order-Chaos-Disorder"@en, "Die Trialität Ordnung-Chaos-Unordnung"@de ;
    skos:definition "In place of the duality of Order against Chaos, a symbiotic triality of Order, Chaos and Disorder, in which Chaos both undoes things and creatively ferments new order and fresh complexity; order tries to master disorder yet opens new possibilities for chaos, which spawns both."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), The Knights of Chaos, pp. 144-145, and Appendix 1 (Chapter ?), Averting Apocalypse, pp. 149-151; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavNothingIsTrueMotto a pm:Conceptualizing ;
    rdfs:label "The chaos magicians' motto, later amended"@en, "Das Motto der Chaosmagier, später geändert"@de ;
    skos:definition "Late twentieth-century chaos magicians pushed the rules of reality until they broke under the banner that nothing is true and everything permitted, taking nothing for granted from magic, science, theology, psychology or parapsychology; the motto was later amended to say that nothing has absolute truth and anything can happen, since every use of is or being counts as wishful thinking."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), The Knights of Chaos, p. 146; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavAgainstDeterministicChaos a pm:Conceptualizing ;
    rdfs:label "Against deterministic chaos"@en, "Gegen deterministisches Chaos"@de ;
    skos:definition "Chaos science is faulted for its term deterministic chaos, which reassured causal sensibilities, and for missing the quantum perspective: sensitivity to starting conditions has no lower limit, so it reaches down to quantum indeterminacy and acts as a ladder up which quantum randomness climbs into macroscopic events; massively improbable things therefore happen all the time."@en ;
    skos:note "A dispute of the work with chaos science; the other side is not read."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), The Knights of Chaos, pp. 146-147; read in a full-text layer of the first edition" .


#
# Appendix 1 (Chapter ?), Averting Apocalypse
#

pmc:ChaosMagicOctavElderEldestGods a pm:Naming ;
    rdfs:label "Elder and Eldest Gods"@en, "Ältere und Älteste Götter"@de ;
    skos:definition "The gods come from Chaos, and the further in one goes, the older, stronger and less predictable the deities: Elder Gods ruling sex and death, love and hate, fear and desire, lurk under the veneer of civilisation, and below them the Eldest Gods, the universe's own raw forces of creation and destruction."@en ;
    pm:nameForm "Elder Gods; Eldest Gods" ;
    pm:nameRole "primordial drives beneath civilisation; the raw creative and destructive forces of the universe" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), Averting Apocalypse, p. 149; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavPanpsychicUniverse a pm:Conceptualizing ;
    rdfs:label "The panpsychic sentience of the universe"@en, "Die panpsychische Empfindungsfähigkeit des Universums"@de ;
    skos:definition "The universe lives: its components show random quantum autonomy and communicate non-locally, producing a range of consciousnesses from the subatomic to the galactic, most so alien that we barely recognise them."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), Averting Apocalypse, p. 149; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavFaustianPactCautela a pm:Cautioning ;
    rdfs:label "Invoking Chaos as a Faustian pact"@en, "Die Invokation des Chaos als faustischer Pakt"@de ;
    skos:definition "Magicians who would invoke Chaos must weigh cost against benefit, since Chaos may show itself anywhere between random destruction and random creation, and making anything always breaks something else."@en ;
    pm:cautionsAbout pmp:ChaosMagicOctavChaosGodform ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), Averting Apocalypse, pp. 149-150; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavAbstractForces a pm:Conceptualizing ;
    rdfs:label "Interacting with forces grasped only as abstractions"@en, "Umgang mit nur abstrakt fassbaren Kräften"@de ;
    skos:definition "The ability to deal with events that rational thought can at best grasp only as abstract concepts."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), Averting Apocalypse, p. 150; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavADP a pm:Practicing ;
    rdfs:label "Anthropomorphic Deity Personification (ADP)"@en, "Anthropomorphe Gottheitspersonifikation (ADP)"@de ;
    skos:definition "Personify an abstract force or process as an anthropomorphic deity and deal with it in that form."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), Averting Apocalypse, p. 150; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavADPYields a pm:Yielding ;
    rdfs:label "ADP yields dealings with abstract forces"@en, "ADP ergibt Umgang mit abstrakten Kräften"@de ;
    skos:definition "ADP is called the magician's most effective way of interacting with events conceivable only as abstractions."@en ;
    pm:byPractice pmp:ChaosMagicOctavADP ;
    pm:yieldsCapacity pmc:ChaosMagicOctavAbstractForces ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), Averting Apocalypse, p. 150; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavPureRandomness a pm:Conceptualizing ;
    rdfs:label "Channelling pure randomness to the macroscopic level"@en, "Reinen Zufall auf die makroskopische Ebene leiten"@de ;
    skos:definition "Through a personification at the deepest, nuclear level, such as Azathoth, the magician may channel pure randomness up to macroscopic levels."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), Averting Apocalypse, p. 150; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavAzathothNaming a pm:Naming ;
    rdfs:label "Azathoth"@en, "Azathoth"@de ;
    skos:definition "H. P. Lovecraft's blind, mad god at chaos's centre, used as an anthropomorphic personification of pure randomness at the nuclear level."@en ;
    pm:nameForm "Azathoth" ;
    pm:nameRole "personification of pure randomness" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), Averting Apocalypse, p. 150; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavPureRandomnessCautela a pm:Cautioning ;
    rdfs:label "Pure randomness endangers health and sanity"@en, "Reiner Zufall gefährdet Gesundheit und Verstand"@de ;
    skos:definition "Unadulterated randomness will most probably harm the health, way of life and sanity of highly structured organisms like us, and few run the risk except in extremis; conjuring for pure chance implies deep faith in the universe or in one's own deep subconscious."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctavPureRandomness ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), Averting Apocalypse, p. 150; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavRandomInspirationFailure a pm:Conceptualizing ;
    rdfs:label "Random inspiration mostly leads nowhere"@en, "Zufällige Inspiration führt meist ins Leere"@de ;
    skos:definition "Conjuring for chance sometimes works and sometimes not: for every successful artist, hero or mystic, hundreds are dead and forgotten whose random inspirations came to nothing."@en ;
    skos:note "Counted as a condition of failure: a conjuration for a purely random result. A ratio is implied (hundreds failing for each success) but no deadline; the failure is put on chance itself, not on the operator."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), Averting Apocalypse, p. 150; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavOverOrderCatastrophe a pm:Conceptualizing ;
    rdfs:label "Over-ordered structures fail catastrophically"@en, "Überordnete Strukturen versagen katastrophal"@de ;
    skos:definition "The more ordered a structure grows, the greater its chance of catastrophic failure, unless it keeps enough chaos to restructure itself; the author reads modern cities and civilisation as standing at such a brink."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), Averting Apocalypse, p. 151; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavAgreeableEschaton a pm:Conceptualizing ;
    rdfs:label "Immanentising an agreeable Eschaton"@en, "Ein angenehmes Eschaton immanentisieren"@de ;
    skos:definition "Facing a global change of ecology, climate and civilisation, a slim chance is said to exist of immanentising an agreeable Eschaton instead of a huge reversal of history; Chaos, as the Fifth Horseperson, might show how to distort probability and halt the slide into entropy so that the apocalypse becomes a myth that was averted."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), Averting Apocalypse, p. 152; read in a full-text layer of the first edition" .


#
# Appendix 1 (Chapter ?), An Invocation of The Knight of Chaos
#

pmc:ChaosMagicOctavKnightOfChaosNaming a pm:Naming ;
    rdfs:label "The Knight of Chaos"@en, "Der Ritter des Chaos"@de ;
    skos:definition "A chaos godform of no particular gender, so open to magicians of any persuasion, representing not the whole of Chaos but its questing aspect, OBDAXAZONGAGA, the higher chaos of evolving complexity; in mythic terms the offspring of Ouranos and Apophenia, that is, high magic joined to inspiration, as distinct from the ancient chaos creatures (Typhon, Tiamat, Leviathan, dragons) and the female or indeterminate Greek Kaos."@en ;
    pm:nameForm "The Knight of Chaos; OBDAXAZONGAGA" ;
    pm:nameRole "invoked godform of the questing aspect of Chaos" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), An Invocation of The Knight of Chaos, p. 153; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavLongImprobableConjuring a pm:Conceptualizing ;
    rdfs:label "Conjuring for the highly improbable over long spans"@en, "Beschwören des höchst Unwahrscheinlichen über lange Zeiträume"@de ;
    skos:definition "Conjuring for something highly improbable by enchanting long, a spell aimed at events far ahead, in the role of a Knight of Chaos questing to avert apocalypse."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), An Invocation of The Knight of Chaos, p. 153; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavKnightPreparation a pm:Practicing ;
    rdfs:label "Preparing the Knight of Chaos invocation"@en, "Die Invokation des Ritters des Chaos vorbereiten"@de ;
    skos:definition "Learn by heart the vernacular invocation, plus the charge and incantation in Ouranian Barbaric; make a mask or a helmet covering the face bearing a butterfly-like Rorschach blot; prepare a large instrument suggestive of sword or wand and a small concealable sidearm; prepare an Octaris (eight-rayed chaos star) and a Knight's Star, physical or visualised; choose incense if wanted, bitumen or asphalt for dark works of attack, valerian root and oakmoss for most others; and ready the materials of the intended conjuration."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), An Invocation of The Knight of Chaos, pp. 153-154; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavKnightPreparationFirst a pm:Presupposing ;
    rdfs:label "Preparations before the Knight of Chaos invocation"@en, "Vorbereitungen vor der Invokation des Ritters des Chaos"@de ;
    skos:definition "The rite numbers its preparations as step nought, to be completed before the statement of intent opens the invocation."@en ;
    pm:priorStep pmp:ChaosMagicOctavKnightPreparation ;
    pm:dependentStep pmp:ChaosMagicOctavKnightInvocation ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), An Invocation of The Knight of Chaos, pp. 153-154; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavKnightInvocation a pm:Practicing ;
    rdfs:label "The Knight of Chaos invocation"@en, "Die Invokation des Ritters des Chaos"@de ;
    skos:definition "(1) State the will to invoke the Knight and launch the conjuration, and intone the Ouranian Barbaric charge; (2) centre and encircle by any preferred method; (3) negative gnosis: gaze on the Octaris through eight very long slow breaths, or a multiple of eight, then seek some moments of total mental emptiness; (4) with mask and weapon in hand, draw the Knight's Star on the air and deliver the vernacular invocation; (5) positive gnosis by hyperventilation, whirling or another excitatory method while with the Knight's Star held in gaze or mind; (6) deliver the Ouranian Barbaric incantation, with glossolalia if moved; (7) conjure for the desired effect; (8) banish with laughter."@en ;
    skos:note "The texts of the charge, of the vernacular invocation and of the Ouranian Barbaric invocation (pp. 154-157) are not quoted. Centring and encircling are the rites of Magical Ritual parts 1 and 2, entered in part 1 of this harvest."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), An Invocation of The Knight of Chaos, pp. 154-155; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavKnightInvocationYields a pm:Yielding ;
    rdfs:label "The Knight invocation yields long-range conjuring for the improbable"@en, "Die Ritter-Invokation ergibt weitreichendes Beschwören des Unwahrscheinlichen"@de ;
    skos:definition "The Knight godform is said to serve especially when the aim is something highly improbable, enchanted for over a long span."@en ;
    pm:byPractice pmp:ChaosMagicOctavKnightInvocation ;
    pm:yieldsCapacity pmc:ChaosMagicOctavLongImprobableConjuring ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), An Invocation of The Knight of Chaos, p. 153; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavKhaOsVernacularNaming a pm:Naming ;
    rdfs:label "Kha-os, speaker of the Vernacular Invocation"@en, "Kha-os, Sprecher der Volkssprachlichen Invokation"@de ;
    skos:definition "In the vernacular invocation Chaos speaks of itself as the primordial void that births desire, the world and the Titans; as the one called Typhon, Dragon, Leviathan, Tiamat and Devil in the chaos wars; as outlasting all system and order, slipping mathematical capture by a quantum fix, making probability at the roots of reality, and phenomenising desire."@en ;
    skos:note "Written in the godform's first person but given as the author's composition for the rite; the work claims no other speaker, so it is entered as a naming, not a receiving."@en ;
    pm:nameForm "Kha-os" ;
    pm:nameRole "self-description of the invoked godform" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), An Invocation of The Knight of Chaos, pp. 155-156; read in a full-text layer of the first edition" .


#
# Appendix 1 (Chapter ?), The Knights of Chaos (the order)
#

pmc:ChaosMagicOctavKnightsMandate a pm:Conceptualizing ;
    rdfs:label "The mandate of the Knights of Chaos"@en, "Der Auftrag der Ritter des Chaos"@de ;
    skos:definition "Because civilisation's survival of the century looks ever less likely and science lacks fixes for what its technology spawned, the Illuminati are said to summon the Knights of Chaos: occasionally to conjure by arrangement for minor apocalypses to frighten humanity away from global collapse, to conjure for and against memes and their hosts, and to debate conjuring for what looks impossible today."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), The Knights of Chaos (the order), p. 158; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavAbsurdImprobability a pm:Conceptualizing ;
    rdfs:label "Phenomenising events of absurd improbability"@en, "Ereignisse absurder Unwahrscheinlichkeit phänomenisieren"@de ;
    skos:definition "The capability, which defines a Knight, of making absurdly improbable events and ideas manifest; some have this erratic ability by nature, others can learn to show it now and then."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), The Knights of Chaos (the order), p. 159; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavKnightsStar a pm:Conceptualizing ;
    rdfs:label "The Knight's Star"@en, "Der Stern des Ritters"@de ;
    skos:definition "An eight-pointed star drawn with five lines, used by the Knights for mutual recognition, symbolising their magical and chaoist affinities and their quest of averting apocalypse."@en ;
    skos:note "The figure itself is not in the text layer."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), The Knights of Chaos (the order), pp. 158-159; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavCamouflageCautela a pm:Cautioning ;
    rdfs:label "The absurd title as cultural camouflage"@en, "Der absurde Titel als kulturelle Tarnung"@de ;
    skos:definition "Since gaming and role-playing societies use similar honorifics, the absurdist title of the order offers camouflage should authorities take an interest in its strange paraphernalia and dangerous-looking instruments."@en ;
    pm:cautionsAbout pmp:ChaosMagicOctavKnightInvocation ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), The Knights of Chaos (the order), pp. 159-160; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavKnightRecognition a pm:Presupposing ;
    rdfs:label "Conditions for being recognised a Knight of Chaos"@en, "Bedingungen für die Anerkennung als Ritter des Chaos"@de ;
    skos:definition "Recognition may follow the fulfilment of certain stated and other unspecified conditions: learn the invocation ritual; equip oneself with black robe, mask or helmet, a big ceremonial instrument, ideally of pole-arm size, plus a small concealable sidearm; show evidence of a few miracles of probability distortion with a humble, humorous attitude toward them; and agree to stay available at short notice."@en ;
    skos:note "The dependent step is read as membership of the order whose mandate is pmc:ChaosMagicOctavKnightsMandate; the text calls the conditions conditions but says recognition only may follow them."@en ;
    pm:priorStep pmp:ChaosMagicOctavKnightInvocation, pmc:ChaosMagicOctavAbsurdImprobability ;
    pm:dependentStep pmc:ChaosMagicOctavKnightsMandate ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), The Knights of Chaos (the order), pp. 160-161; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavEgoCautela a pm:Cautioning ;
    rdfs:label "Do not grow egocentric over parapsychological feats"@en, "Sich auf parapsychologische Leistungen nichts einbilden"@de ;
    skos:definition "Since personal existence is itself so vastly improbable, occasional parapsychological feats are no reason for egocentric pride."@en ;
    pm:cautionsAbout pmc:ChaosMagicOctavAbsurdImprobability ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 1 (Chapter ?), The Knights of Chaos (the order), p. 160; read in a full-text layer of the first edition" .


#
# Appendix 2, The Mass of Chaos E, to Eris
#

pmc:ChaosMagicOctavErisNaming a pm:Naming ;
    rdfs:label "Eris"@en, "Eris"@de ;
    skos:definition "Goddess of chaos, confusion and discord whose modern conception began with the Principia Discordia, built on the Greek troublemaking sister of Ares, with echoes of Eve; to the Greeks born of Chaos and Darkness. She is an archetypal muse of inspiration and creative confusion wherever opposites collide, said to resume Ishtar, Kali, Babalon and Lilith, and is invoked with flaming red hair, in a riot of colour, bearing an apple with the letter K (Kallisti, Kaos); her sigil, the five-fingered hand, stands for waxing and waning moon, shamanic horns and two arrows colliding head-on."@en ;
    pm:nameForm "Eris; Kallisti" ;
    pm:nameRole "goddess of chaos; muse of inspiration" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 2, The Mass of Chaos E, to Eris, pp. 162-164; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavMassInUse a pm:Conceptualizing ;
    rdfs:label "The Mass of Chaos E in long use"@en, "Die Messe des Chaos E in langem Gebrauch"@de ;
    skos:definition "The rite grew out of work started in 1990 and is said to have stayed in constant use since, in many variants; its incantation is ensigilised in Enochian because it predates Ouranian Barbaric, and lapses in the vernacular have been corrected in this version."@en ;
    skos:note "The work's statement on how long and how widely the rite has been tried."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 2, The Mass of Chaos E, to Eris, p. 162; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavInspiration a pm:Conceptualizing ;
    rdfs:label "Magical inspiration"@en, "Magische Inspiration"@de ;
    skos:definition "Inspiration and the creative confusion that comes from the clash of opposites, sought in the Mass by invoking Eris to consecrate a sacrament to Chaos."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 2, The Mass of Chaos E, to Eris, pp. 163, 166; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavMassPreparation a pm:Practicing ;
    rdfs:label "Preparing the Mass of Chaos E"@en, "Die Messe des Chaos E vorbereiten"@de ;
    skos:definition "The priestess, or a priest who dares, memorises the Enochian incantation, the vernacular proclamation and the format of the rite instead of reading from papers; an apple carved with a K is readied, another fruit serving in emergency; crumpled newspaper may mark the circle."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 2, The Mass of Chaos E, to Eris, pp. 164-165; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavMassPreparationFirst a pm:Presupposing ;
    rdfs:label "The rite is memorised beforehand"@en, "Der Ritus wird vorher auswendig gelernt"@de ;
    skos:definition "The incantation, proclamation and format are to be learned before the Mass rather than read during it."@en ;
    pm:priorStep pmp:ChaosMagicOctavMassPreparation ;
    pm:dependentStep pmp:ChaosMagicOctavMassOfChaosE ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 2, The Mass of Chaos E, to Eris, p. 165; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavMassOfChaosE a pm:Practicing ;
    rdfs:label "The Mass of Chaos E, an invocation of Eris"@en, "Die Messe des Chaos E, eine Invokation der Eris"@de ;
    skos:definition "(1) Participants on the circle declare their will to invoke Eris and consecrate the sacrament to Chaos for inspiration; (2) above the circle the priestess traces the Sigil of Chaos while all visualise; (3) she shouts Kallisti to begin; (4) cacophony: all circle widdershins, loudly arguing and proclaiming beliefs real, imaginary or nonsensical; (5) she spirals to the centre and ends it with Kallisti; (6) a quieter chant of Eris interspersed with Ishtar, Babalon, Lilith and Kali, all pointing the left hand at her and visualising the Sigil of Eris entering her, while she delivers the Enochian incantation; (7) she makes the vernacular proclamation, chanting stops, visualisation goes on; (8) she consecrates the fruit and the sacrament is served; erotic gnosis may follow by prior agreement; (9) laughter banishing."@en ;
    skos:note "The texts of the Enochian incantation and of the vernacular proclamation (pp. 167-168) are not quoted."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 2, The Mass of Chaos E, to Eris, pp. 164-167; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavMassOfChaosEYields a pm:Yielding ;
    rdfs:label "The Mass yields inspiration"@en, "Die Messe ergibt Inspiration"@de ;
    skos:definition "The rite's stated intent is to consecrate a sacrament to Chaos for the participants' magical inspiration, or another related intent."@en ;
    pm:byPractice pmp:ChaosMagicOctavMassOfChaosE ;
    pm:yieldsCapacity pmc:ChaosMagicOctavInspiration ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 2, The Mass of Chaos E, to Eris, p. 166; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavConsecratedApple a pm:Practicing ;
    rdfs:label "Using the consecrated apple"@en, "Den geweihten Apfel gebrauchen"@de ;
    skos:definition "Consecrate the apple with a kiss or a bite; put it in a chalice of fruit drink as sacrament or, in solo work, crush it onto a sigil or pentacle for a magical purpose; afterwards count its seeds for divination, plant them, or keep them as talismans."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 2, The Mass of Chaos E, to Eris, p. 165; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavEroticGnosisCautela a pm:Cautioning ;
    rdfs:label "Erotic gnosis only by prior agreement"@en, "Erotische Gnosis nur nach vorheriger Absprache"@de ;
    skos:definition "Erotic gnosis may follow in the Mass only if desired and agreed beforehand, and is usually kept to workings with few participants."@en ;
    pm:cautionsAbout pmp:ChaosMagicOctavMassOfChaosE ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 2, The Mass of Chaos E, to Eris, p. 167; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavErisProclamationNaming a pm:Naming ;
    rdfs:label "Eris, speaker of the Proclamation"@en, "Eris, Sprecherin der Proklamation"@de ;
    skos:definition "In the vernacular proclamation Eris says she offered the apple aeons ago and was answered with religions, laws and mental prisons, that she brings inspiration, the anarchic laughter of the young at any age, chaos and life, and that in the new aeon she urges seizing freedom."@en ;
    skos:note "Written in the goddess's first person but presented as part of the author's rite; no other speaker is claimed, so no receiving is entered."@en ;
    pm:nameForm "Eris" ;
    pm:nameRole "speaking goddess of the rite" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 2, The Mass of Chaos E, to Eris, p. 168; read in a full-text layer of the first edition" .


#
# Appendix 3, Sorcerer's Chess
#

pmc:ChaosMagicOctavSorcerersChess a pm:Systematizing ;
    rdfs:label "Sorcerer's Chess"@en, "Zaubererschach"@de ;
    skos:definition "A chess variant by the author, akin to Discworld's Stealth Chess but with consistent rules: each side's two Assassin pawns carry a dial and may step one square in a real move, a virtual move that raises the dial, or a revealing move that jumps within the dial's range and captures; real moves and spaces model the particle mode of quantum physics, virtual ones the wave mode."@en ;
    skos:note "The rules are entered only in outline: a game, not a magical practice."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 3, Sorcerer's Chess, pp. 169-172; read in a full-text layer of the first edition" .

pmp:ChaosMagicOctavEnochianChess a pm:Practicing ;
    rdfs:label "Enochian Chess as divination"@en, "Henochisches Schach als Divination"@de ;
    skos:definition "The Golden Dawn's adaptation of Shaturanga, played with Egyptian god figurines on boards from Dee's Enochian tablets, is said sometimes to have served as a tool of divination."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 3, Sorcerer's Chess, p. 172; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavChessAlchemy a pm:Systematizing ;
    rdfs:label "Alchemical attribution of the chess pieces"@en, "Alchemische Zuordnung der Schachfiguren"@de ;
    skos:definition "A simple alchemical symbolism traced from Shaturanga into modern chess: rook earth, knight fire, bishop water, queen air, king spirit, and perhaps, in Sorcerer's Chess, the assassin astral."@en ;
    pm:compiledBy "Peter J. Carroll, in The Octavo" ;
    dcterms:date "2011"^^xsd:gYear ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), Appendix 3, Sorcerer's Chess, p. 172; read in a full-text layer of the first edition" .


#
# References etc. (glossary)
#

pmc:ChaosMagicOctavAeon a pm:Conceptualizing ;
    rdfs:label "Aeon"@en, "Äon"@de ;
    skos:definition "A stage in the evolution of metaphysical thinking and paradigms; for the psycho-historic workings of the aeons the reader is sent to Liber Kaos, ch. 2."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), References etc. (glossary), p. 176; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavGroundsleves a pm:Conceptualizing ;
    rdfs:label "Groundsleves"@en, "Groundsleves"@de ;
    skos:definition "Chaos magic's word for the physical base of an evoked entity, typically portable figurines and fetish objects; listed among the tools that support magical belief."@en ;
    skos:note "Part 1 of this harvest enters servitors with groundsleves from ch. 3 (p. 69)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), ch. 7 The Spell of Practical Magic, Magical Ritual Part 7, p. 122, and References etc. (glossary), p. 178; read in a full-text layer of the first edition" .

pmc:ChaosMagicOctavPhenomenise a pm:Conceptualizing ;
    rdfs:label "Phenomenise"@en, "Phänomenisieren"@de ;
    skos:definition "A neologism, apologised for, meant to evade or at least expose the grammatical implication that events have a being apart from their manifestation."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
    pm:fromWork pmw:TheOctavo ;
    dcterms:source "Carroll, The Octavo: A Sorcerer-Scientist's Grimoire, Roundworld Edition (Mandrake of Oxford, 2011, first edition), References etc. (glossary), p. 179; read in a full-text layer of the first edition" .
