pmc:NewThoughtShinnDirectInspirationYieldsRightDecisions a pm:Yielding ;
    rdfs:label "Inspiration affirmation ends indecision"@en, "Inspirationsaffirmation beendet Zögern"@de ;
    skos:definition "The statement is claimed soon to make one alert and decisive."@en ;
