#
# The Law of Prosperity
#

pmc:NewThoughtShinnGodIsSupply a pm:Conceptualizing ;
    rdfs:label "God as man's supply"@en, "Gott als Versorgung des Menschen"@de ;
    skos:definition "The scriptures are said to teach that God is the source of supply and that by the spoken word a person can release everything that is his by divine right; there is a supply for each demand."@en ;
    skos:note "Author's term: \"supply\"; \"divine right\"."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
    dcterms:source "Florence Scovel Shinn, The Game of Life and How to Play It (Marina del Rey, CA: DeVorss & Company, n.d.; copyright 1925, ISBN 0-87516-257-6), The Law of Prosperity, p. 15; read in the proofread transcription Project Gutenberg eBook #74878 (2024), made from the archive.org scan gameoflifehowtop00shin of this printing" .

pmc:NewThoughtShinnSpokenWordPresupposesPerfectFaith a pm:Presupposing ;
    rdfs:label "Perfect faith in one's spoken word"@en, "Vollkommener Glaube an das eigene Wort"@de ;
    skos:definition "Releasing supply by word requires complete faith in that word."@en ;
    pm:dependentStep pmp:NewThoughtShinnSpeakingTheWord ;
    pm:priorStep pmc:NewThoughtShinnFaith ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
