pmc:NewThoughtShinnBrotherInHisRightPlace a pm:Yielding ;
    rdfs:label "Statements of truth protect the brother"@en, "Wahrheitsaussagen schützen den Bruder"@de ;
    skos:definition "Case: a woman who woke sensing her brother in danger affirmed his right place and protection instead of fearing; next day she learned he had narrowly escaped a mine explosion."@en ;
    pm:byPractice pmp:NewThoughtShinnChildInGodsHands ;
