pmc:NewThoughtShinnImpressingPresupposesActiveFaith a pm:Presupposing ;
    rdfs:label "Active faith to impress the subconscious"@en, "Tätiger Glaube zur Prägung des Unterbewussten"@de ;
    skos:definition "Active faith is essential to impress the subconscious; faith without works is dead, and active faith is the bridge to the Promised Land (Jesus seating the crowd before giving thanks)."@en ;
    pm:dependentStep pmc:NewThoughtShinnSilentListener ;
    pm:priorStep pmp:NewThoughtShinnDiggingDitches ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Faith that does not act is dead and leaves the subconscious unimpressed." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
