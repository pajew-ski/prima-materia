pmc:NewThoughtShinnGoldenLinksOrDisappear a pm:Yielding ;
    rdfs:label "Meeting feared people cheerfully"@en, "Gefürchteten Menschen heiter begegnen"@de ;
    skos:definition "Those one fears, if met willingly and cheerfully, are said to become links in one's good or leave harmoniously."@en ;
    pm:byPractice pmp:NewThoughtShinnWalkingUpToTheLion ;
    pm:yieldsCapacity pmc:NewThoughtShinnFallsAwayOfItsOwnWeight ;
    pm:attestedBy pm:textualAttestation ;
