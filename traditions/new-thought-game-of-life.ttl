pmp:NewThoughtShinnDivineOrder a pm:Practicing ;
    rdfs:label "Thanks for divine order in mind, body and affairs"@en, "Dank für göttliche Ordnung in Geist, Körper, Angelegenheiten"@de ;
    skos:definition "Giving thanks that divine order is established in the person's mind, body and affairs, together with acting on the lead (taking the furniture out of storage)."@en ;
    skos:note "Author's term: \"Divine order\"."@en ;
    pm:attestedBy pm:firstPersonReport ;
