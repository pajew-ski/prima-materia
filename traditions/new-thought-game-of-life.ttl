pmc:NewThoughtShinnIntuitionDoesNotExplain a pm:Conceptualizing ;
    rdfs:label "Intuition points without explaining"@en, "Intuition zeigt, ohne zu erklären"@de ;
    skos:definition "Intuition is a spiritual faculty that does not explain but points the way; leads often come during a treatment and may seem irrelevant, God's leadings being mysterious."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
