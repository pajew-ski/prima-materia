pmp:NewThoughtShinnActingRich a pm:Practicing ;
    rdfs:label "Acting rich, acting as if already received"@en, "Reich handeln, als sei es schon empfangen"@de ;
    skos:definition "Showing faith by behaving as though the money had already arrived (here, ordering an expensive lunch instead of economizing)."@en ;
    skos:note "Author's term: \"act your perfect faith\"."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
