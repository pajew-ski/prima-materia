    rdfs:label "Knowledge increases responsibility"@en, "Wissen erhöht Verantwortung"@de ;
    skos:definition "Whoever knows spiritual law and does not practise it is said to suffer greatly in consequence."@en ;
    pm:cautionsAbout pmc:NewThoughtShinnLawOfKarma ;
