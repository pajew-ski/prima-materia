pmc:NewThoughtShinnNeverViolateAHunch a pm:Cautioning ;
    rdfs:label "Never go against a hunch"@en, "Nie gegen eine Eingebung handeln"@de ;
    skos:definition "Rule given to the client: one must not act against an intuitive lead, even when the reasoning mind proposes the sensible course."@en ;
    pm:cautionsAbout pmp:NewThoughtShinnFollowingAHunch ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
