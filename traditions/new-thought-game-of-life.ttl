pmp:NewThoughtShinnOnlyCompletion a pm:Practicing ;
    rdfs:label "Affirmation of completion"@en, "Affirmation der Vollendung"@de ;
    skos:definition "Stating that since only completion exists in Divine Mind one's demonstration (work, home, health) is complete; giving thanks for receipt on the invisible and actively preparing for the visible. Also finishing a long-unfinished task as a symbol."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
    dcterms:source "Florence Scovel Shinn, The Game of Life and How to Play It (Marina del Rey, CA: DeVorss & Company, n.d.; copyright 1925, ISBN 0-87516-257-6), Perfect Self-Expression or the Divine Design, p. 81; read in the proofread transcription Project Gutenberg eBook #74878 (2024), made from the archive.org scan gameoflifehowtop00shin of this printing" .

pmc:NewThoughtShinnSalaryTwice a pm:Yielding ;
    rdfs:label "Finishing a task completes the demonstration"@en, "Eine Aufgabe beenden vollendet die Demonstration"@de ;
    skos:definition "Case: a student finished a sewing job begun weeks earlier; shortly after, her husband was paid twice in one month and allowed to keep it."@en ;
    pm:byPractice pmp:NewThoughtShinnOnlyCompletion ;
    pm:yieldsCapacity pmc:NewThoughtShinnPlenty ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
