pmc:NewThoughtShinnKindnessInThePresentYieldsRubOut a pm:Yielding ;
    rdfs:label "Present kindness neutralizes past wrong"@en, "Heutige Güte neutralisiert früheres Unrecht"@de ;
    skos:definition "The effect of an irreparable wrong is said to be neutralized by a present kindness."@en ;
    pm:byPractice pmp:NewThoughtShinnKindnessInThePresent ;
    pm:yieldsCapacity pmc:NewThoughtShinnRubOutMistakes ;
    pm:attestedBy pm:textualAttestation ;
