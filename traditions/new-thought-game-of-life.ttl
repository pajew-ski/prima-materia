pmp:NewThoughtShinnBodyAPerfectIdea a pm:Practicing ;
    rdfs:label "Realizing the body as a perfect idea"@en, "Den Körper als vollkommene Idee erkennen"@de ;
    skos:definition "Realizing that one's body is a flawless idea held in the divine mind and hence whole."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
