#
# The Law of Karma and the Law of Forgiveness
#

pmc:NewThoughtShinnLawOfKarma a pm:Conceptualizing ;
    rdfs:label "Law of karma"@en, "Gesetz des Karma"@de ;
    skos:definition "A person receives only what he gives; life is played with boomerangs, thoughts, deeds and words returning precisely. Karma is glossed as Sanskrit for 'comeback'."@en ;
    skos:note "Author's term: \"law of Karma\"."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
    dcterms:source "Florence Scovel Shinn, The Game of Life and How to Play It (Marina del Rey, CA: DeVorss & Company, n.d.; copyright 1925, ISBN 0-87516-257-6), The Law of Karma and the Law of Forgiveness, p. 39; read in the proofread transcription Project Gutenberg eBook #74878 (2024), made from the archive.org scan gameoflifehowtop00shin of this printing" .

pmc:NewThoughtShinnKarmaReturnsQuickly a pm:Conceptualizing ;
    rdfs:label "Karma returns faster to the advanced"@en, "Karma kehrt bei Fortgeschrittenen schneller zurück"@de ;
    skos:definition "Case of a friend whose rude words to her aunt were said to her the next day; the author says karma returns faster to one high in consciousness than to someone at the mental level."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
