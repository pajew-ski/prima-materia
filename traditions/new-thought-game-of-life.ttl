pmp:NewThoughtShinnFalseProphecy a pm:Practicing ;
    rdfs:label "Denial of a false prophecy"@en, "Verneinung einer falschen Prophezeiung"@de ;
    skos:definition "Declaring that every false prediction comes to nothing, that every plan the heavenly Father has not planned is dissolved, and that the divine idea is now realized; only a very strong mind is said to cancel a foretold evil, and the same statement closes the book as an affirmation for right conditions."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
