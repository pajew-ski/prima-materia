pmc:NewThoughtShinnBurdenOfResentment a pm:Yielding ;
    rdfs:label "Casting resentment transforms a life"@en, "Groll abwerfen verwandelt ein Leben"@de ;
    skos:definition "Case: the superconscious is said to have flooded a woman's subconscious with love, changing her whole life after years of torment."@en ;
    pm:byPractice pmp:NewThoughtShinnCastingTheBurden ;
    pm:yieldsCapacity pmc:NewThoughtShinnLovingHarmoniousHappy ;
