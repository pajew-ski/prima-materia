pmp:NewThoughtShinnStopCondemning a pm:Practicing ;
    rdfs:label "Stop condemning, bless and be done"@en, "Aufhören zu verurteilen, segnen, abschließen"@de ;
    skos:definition "Ceasing to condemn the offender, blessing her and closing the matter inwardly."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
    dcterms:source "Florence Scovel Shinn, The Game of Life and How to Play It (Marina del Rey, CA: DeVorss & Company, n.d.; copyright 1925, ISBN 0-87516-257-6), Intuition or Guidance, p. 70; read in the proofread transcription Project Gutenberg eBook #74878 (2024), made from the archive.org scan gameoflifehowtop00shin of this printing" .

pmp:NewThoughtShinnDirectInspiration a pm:Practicing ;
    rdfs:label "Affirmation against indecision"@en, "Affirmation gegen Unentschlossenheit"@de ;
    skos:definition "Repeating that one is always directly inspired and makes right decisions quickly, to overcome indecision."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
