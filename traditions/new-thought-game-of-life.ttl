pmc:NewThoughtShinnProveGod a pm:Conceptualizing ;
    rdfs:label "Proving God"@en, "Gott beweisen"@de ;
    skos:definition "Man exists to prove God and witness to truth, which he can do only by turning lack into plenty and injustice into justice (Mal. 3:10)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
