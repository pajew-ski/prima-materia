pmc:NewThoughtShinnPlaceAtTheTable a pm:Yielding ;
    rdfs:label "Denial of separation brings the husband back"@en, "Verneinung der Trennung bringt den Mann zurück"@de ;
    skos:definition "Case: after more than a year of unwavering practice the estranged husband walked in."@en ;
    pm:byPractice pmp:NewThoughtShinnNoSeparationInDivineMind ;
    pm:yieldsCapacity pmc:NewThoughtShinnRightMan ;
