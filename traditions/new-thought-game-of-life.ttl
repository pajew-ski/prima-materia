pmc:NewThoughtShinnRecoveringTheLoss a pm:Conceptualizing ;
    rdfs:label "Recovering what was lost"@en, "Verlorenes zurückerhalten"@de ;
    skos:definition "Recovering a lost sum or its equivalent."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
