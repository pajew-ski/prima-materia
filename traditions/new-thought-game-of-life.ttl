pmc:NewThoughtShinnFurnitureOutOfStorage a pm:Yielding ;
    rdfs:label "Lead and divine-order treatment for health"@en, "Hinweis und Ordnungsbehandlung für Gesundheit"@de ;
    skos:definition "The author predicts health will improve once the student sets up her own home as her lead indicated."@en ;
    pm:byPractice pmp:NewThoughtShinnClassTreatmentForLeads, pmp:NewThoughtShinnDivineOrder ;
    pm:yieldsCapacity pmc:NewThoughtShinnBodyRenewed ;
