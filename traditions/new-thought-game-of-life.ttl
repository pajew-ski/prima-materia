    rdfs:label "Living fully in the now"@en, "Ganz im Jetzt leben"@de ;
    skos:definition "Blessing and forgetting the past if it binds, blessing the future as holding endless joy, and living fully in the present, spiritually alert for leads and opportunities."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
