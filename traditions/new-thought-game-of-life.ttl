pmc:NewThoughtShinnObedienceBeforeAuthority a pm:Conceptualizing ;
    rdfs:label "Obedience precedes authority"@en, "Gehorsam geht der Macht voraus"@de ;
    skos:definition "The law serves man when he obeys it, as electricity has to be obeyed to serve and becomes deadly when misused; the same holds for mental laws. Freedom comes through knowledge of spiritual law (John 8:32)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
