pmp:NewThoughtShinnClassTreatmentForLeads a pm:Practicing ;
    rdfs:label "Class treatment for leads"@en, "Gruppenbehandlung für Hinweise"@de ;
    skos:definition "Treating a class so that each person receives a definite lead."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:NewThought ;
