pmc:NewThoughtShinnNoLossInDivineMind a pm:Conceptualizing ;
    rdfs:label "No loss in Divine Mind"@en, "Kein Verlust im göttlichen Geist"@de ;
    skos:definition "Nothing that belongs to one can be lost; what is lost returns or its equivalent comes. Taking his spiritual stand, a person gathers everything owed him from the 'great Reservoir of Good'."@en ;
    skos:note "Author's term: \"Bank of the Universal\"; \"Reservoir of Good\"."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
    dcterms:source "Florence Scovel Shinn, The Game of Life and How to Play It (Marina del Rey, CA: DeVorss & Company, n.d.; copyright 1925, ISBN 0-87516-257-6), Intuition or Guidance, p. 72; read in the proofread transcription Project Gutenberg eBook #74878 (2024), made from the archive.org scan gameoflifehowtop00shin of this printing" .

pmc:NewThoughtShinnRecoveryPresupposesForgiveness a pm:Presupposing ;
    rdfs:label "Forgiveness before collecting from the Universal Bank"@en, "Vergebung vor dem Einzug von der Universalbank"@de ;
    skos:definition "To recover a loss one must first forgive, because resentment and unforgiveness shut the universal bank's doors."@en ;
    pm:dependentStep pmp:NewThoughtShinnDenyingLoss ;
    pm:priorStep pmp:NewThoughtShinnLawOfForgiveness ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Resentment and unforgiveness keep the doors of that bank shut." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
