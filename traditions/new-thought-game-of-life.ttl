pmc:NewThoughtShinnPerfectIdeaOfMan a pm:Conceptualizing ;
    rdfs:label "Perfect idea of man"@en, "Vollkommene Idee des Menschen"@de ;
    skos:definition "The perfect idea of each person waits in Divine Mind for recognition; a person can only be and attain what he sees himself being and attaining, and sees failure or success in imagination before it becomes visible."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
