pmc:NewThoughtShinnDynamite a pm:Conceptualizing ;
    rdfs:label "A big situation as dynamite"@en, "Eine große Lage als Dynamit"@de ;
    skos:definition "Long-standing ideas of separation and lack may need a big crisis to be dislodged from the subconscious."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
