pmc:NewThoughtShinnControlPresupposesSelfControl a pm:Presupposing ;
    rdfs:label "Self-control before controlling a situation"@en, "Selbstbeherrschung vor Beherrschung der Lage"@de ;
    skos:definition "Mastery of a situation is said to follow mastery of oneself."@en ;
    pm:dependentStep pmc:NewThoughtShinnSuccessInBusiness ;
    pm:priorStep pmc:NewThoughtShinnPoise ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
