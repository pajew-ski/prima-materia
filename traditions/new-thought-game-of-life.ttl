pmp:NewThoughtShinnTreatmentForTheRightPosition a pm:Practicing ;
    rdfs:label "Treatment for the right position"@en, "Behandlung für die richtige Stelle"@de ;
    skos:definition "Asking Infinite Spirit to open the way for the person's right position, giving thanks it is already received and will manifest quickly, then asking for a definite lead to choose."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
