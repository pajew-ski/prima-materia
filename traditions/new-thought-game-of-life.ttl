pmc:NewThoughtShinnVibratoryForce a pm:Conceptualizing ;
    rdfs:label "Words and thoughts as vibratory force"@en, "Worte und Gedanken als Schwingungskraft"@de ;
    skos:definition "Words and thoughts are held to be a powerful vibration that constantly shapes body and circumstances; hence whatever one voices one begins to attract."@en ;
    skos:note "Supported by Isa. 55:11 as interpreted."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
