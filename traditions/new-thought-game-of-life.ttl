pmp:NewThoughtShinnAgreeWithThineAdversary a pm:Practicing ;
    rdfs:label "Agreeing with the adversary"@en, "Dem Widersacher zustimmen"@de ;
    skos:definition "Agreeing that the hostile situation is good and remaining undisturbed by it, e.g. with the affirmation that none of these things move one (Matt. 5:25)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
