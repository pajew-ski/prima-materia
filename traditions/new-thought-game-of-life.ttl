pmc:NewThoughtShinnOnlyOnePowerYieldsHappySurprise a pm:Yielding ;
    rdfs:label "One-power denial ends disappointments"@en, "Ein-Macht-Verneinung beendet Enttäuschungen"@de ;
    skos:definition "The author reports immediate change; happy surprises began arriving instead of disappointments."@en ;
    pm:byPractice pmp:NewThoughtShinnOnlyOnePower ;
    pm:yieldsCapacity pmc:NewThoughtShinnHappySurprise ;
