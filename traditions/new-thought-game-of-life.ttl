pmp:NewThoughtShinnReceivedOnTheInvisiblePlane a pm:Practicing ;
    rdfs:label "Thanks for receipt on the invisible plane"@en, "Dank für den Empfang auf der unsichtbaren Ebene"@de ;
    skos:definition "Continuing the treatment by giving thanks that the money is already received on the invisible plane and will appear on time, affirming that Spirit is never late."@en ;
    skos:note "Author's term: \"invisible plane\"."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
    dcterms:source "Florence Scovel Shinn, The Game of Life and How to Play It (Marina del Rey, CA: DeVorss & Company, n.d.; copyright 1925, ISBN 0-87516-257-6), The Law of Prosperity, p. 17; read in the proofread transcription Project Gutenberg eBook #74878 (2024), made from the archive.org scan gameoflifehowtop00shin of this printing" .

pmc:NewThoughtShinnThreeThousandDollars a pm:Yielding ;
    rdfs:label "Treatment and acting rich bring three thousand dollars"@en, "Behandlung und Reich-Handeln bringen dreitausend Dollar"@de ;
    skos:definition "Case: a woman to be sued for three thousand dollars received the sum from a cousin who called unexpectedly and then paid it early."@en ;
    pm:byPractice pmp:NewThoughtShinnSpeakingTheWord, pmp:NewThoughtShinnActingRich, pmp:NewThoughtShinnReceivedOnTheInvisiblePlane ;
    pm:yieldsCapacity pmc:NewThoughtShinnSumAtTheRightTime ;
    pm:attestedBy pm:thirdPartyAscription ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
