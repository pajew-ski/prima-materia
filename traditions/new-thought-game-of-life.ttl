pmp:NewThoughtShinnKindnessInThePresent a pm:Practicing ;
    rdfs:label "Neutralizing an old wrong by a present kindness"@en, "Altes Unrecht durch heutige Güte neutralisieren"@de ;
    skos:definition "When a past unkindness cannot be righted, doing someone a kindness now and forgetting what lies behind (Phil. 3:13)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
