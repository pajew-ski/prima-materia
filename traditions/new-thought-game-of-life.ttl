pmc:NewThoughtShinnSumAtTheRightTime a pm:Conceptualizing ;
    rdfs:label "Receiving a needed sum on time"@en, "Eine benötigte Summe rechtzeitig erhalten"@de ;
    skos:definition "Obtaining a specific amount of money needed by a deadline."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
    dcterms:source "Florence Scovel Shinn, The Game of Life and How to Play It (Marina del Rey, CA: DeVorss & Company, n.d.; copyright 1925, ISBN 0-87516-257-6), The Law of Prosperity, p. 15; read in the proofread transcription Project Gutenberg eBook #74878 (2024), made from the archive.org scan gameoflifehowtop00shin of this printing" .

pmp:NewThoughtShinnSpeakingTheWord a pm:Practicing ;
    rdfs:label "Speaking the word with thanksgiving for a needed sum"@en, "Das Wort mit Dank für eine benötigte Summe sprechen"@de ;
    skos:definition "Giving thanks in advance that the person will receive the exact sum needed, at the right time and in the right way."@en ;
    skos:note "Author's term: \"speak the word\"."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
