pmc:NewThoughtShinnDivinePattern a pm:Conceptualizing ;
    rdfs:label "Divine pattern as only safe pattern"@en, "Göttliches Muster als einzig sicheres"@de ;
    skos:definition "The divine selection satisfies fully and benefits all; desire is a great force that must be channelled rightly or chaos follows."@en ;
    skos:note "Author's term: \"divine pattern\"."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
