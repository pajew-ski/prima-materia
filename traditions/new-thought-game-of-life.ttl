pmc:NewThoughtShinnLawOfExpectancy a pm:Conceptualizing ;
    rdfs:label "Law of expectancy"@en, "Gesetz der Erwartung"@de ;
    skos:definition "A good message once received about coming happiness or wealth should be harboured and expected; by the law of expectancy it will eventually appear."@en ;
    skos:note "Author's term: \"law of expectancy\"."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
