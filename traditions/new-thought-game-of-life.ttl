pmc:NewThoughtShinnPlentyPresupposesTheSpokenWord a pm:Presupposing ;
    rdfs:label "Desire, faith or word before manifestation"@en, "Wunsch, Glaube oder Wort vor der Manifestation"@de ;
    skos:definition "Plenty always lies on one's path but appears only through wishing, believing or speaking the word; the human being has to take the initiative (Matt. 7:7)."@en ;
    pm:dependentStep pmc:NewThoughtShinnPlenty ;
    pm:priorStep pmp:NewThoughtShinnSpeakingTheWord ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Without one's desire, one's faith or a word spoken, the plenty that lies on one's path is not brought into manifestation." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
    dcterms:source "Florence Scovel Shinn, The Game of Life and How to Play It (Marina del Rey, CA: DeVorss & Company, n.d.; copyright 1925, ISBN 0-87516-257-6), The Game, p. 12; read in the proofread transcription Project Gutenberg eBook #74878 (2024), made from the archive.org scan gameoflifehowtop00shin of this printing" .

pmc:NewThoughtShinnInfiniteIntelligence a pm:Naming ;
    rdfs:label "Infinite Intelligence, God"@en, "Unendliche Intelligenz, Gott"@de ;
    skos:definition "Held to stand always ready to fulfil the least and the largest of man's demands; every desire, voiced or not, counts as a demand."@en ;
    pm:nameForm "Infinite Intelligence; God" ;
    pm:nameRole "executor of man's demands" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
    dcterms:source "Florence Scovel Shinn, The Game of Life and How to Play It (Marina del Rey, CA: DeVorss & Company, n.d.; copyright 1925, ISBN 0-87516-257-6), The Game, p. 12; read in the proofread transcription Project Gutenberg eBook #74878 (2024), made from the archive.org scan gameoflifehowtop00shin of this printing" .

pmc:NewThoughtShinnEveryDesireADemand a pm:Conceptualizing ;
    rdfs:label "Every desire is a demand"@en, "Jeder Wunsch ist eine Forderung"@de ;
    skos:definition "Any wish, spoken or silent, is said to set the law in motion, so that wishes are sometimes fulfilled unexpectedly."@en ;
    skos:note "Author's term: \"demand\"."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnGameOfLife ;
