pmc:NewThoughtShinnEternalYouth a pm:Conceptualizing ;
    rdfs:label "Eternal youth and life"@en, "Ewige Jugend und ewiges Leben"@de ;
    skos:definition "Overcoming death, the body transformed rather than cast off."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
