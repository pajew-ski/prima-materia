pmc:NewThoughtShinnRightPosition a pm:Cautioning ;
    rdfs:label "Ask for the right position, not just any"@en, "Um die richtige Stelle bitten, nicht irgendeine"@de ;
    skos:definition "One should never demand merely a job but the right one already planned in Divine Mind, the only one that satisfies."@en ;
    pm:cautionsAbout pmp:NewThoughtShinnTreatmentForTheRightPosition ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
