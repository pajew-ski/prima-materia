pmt:StoicPhysics pm:coverageState pm:placesEntered ; pm:contactRoute pm:contactRouteDocumented .

pmt:GraecoRoman pm:coverageState pm:placesEntered ;
    pm:contactRoute pm:contactRouteDisputed ;
    skos:note "The file records that a route to Indian material has been proposed for the older Greek transmission and not shown. Disputed is therefore the state of the question, not a hedge."@en .

pmt:NeoplatonicTheurgy pm:coverageState pm:placesEntered ;
    pm:contactRoute pm:contactRouteDocumented ;
    skos:note "The file records that this layer underlies the later Jewish and Islamic dream theory, so agreement among those three may not be counted as independent."@en .

