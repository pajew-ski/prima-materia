@prefix pm:      <https://pajew.ski/prima-materia/ontology#> .
@prefix pmt:     <https://pajew.ski/prima-materia/traditions/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

#
# prima-materia — registered transmissions: West Asia and Iran
#
# Every node in this file stands at pm:corpusNamed. Nothing here has been
# read. The file is a survey of what the graph does not yet hold, entered so
# that the gap is countable instead of invisible.
#

# pmt:MesopotamianExorcism has left this file. The exorcist's manual KAR 44
# has been read in full and three tablets of the canonical evil-demon series at
# the places entered, both in open-access critical editions, and the instance
# now stands in traditions/mesopotamian-asiputu.ttl at pm:placesEntered. The
# contact route stays disputed and the reading did not move it: the age of the
# corpus settles the direction of any derivation without settling whether there
# was one, and the position that would settle it was reached in the landscape
# stage of that run and not read at the wording.

# The pharaonic Egyptian ritual was registered here and was worked off
# pm:corpusNamed on 2026-09-19. Its instance and its nodes now stand in
# traditions/egyptian-ritual.ttl at pm:placesEntered, with the contact route
# unchanged at disputed.
#
# The registration's remark, that the transformation spells are a capacity
# list in the strict sense, was borne out for the three that were read at the
# wording and has moved there with them. What the reading found beside them
# was not in the registration: this corpus attaches its attainments to knowing
# a text rather than to performing an act, and it states the failure condition
# in the same terms, as a doorkeeper who will not let the dead man pass unless
# he tells his name.
#
# Of the five items the registration named as the principal corpus, one was
# opened. The Pyramid Texts, the Coffin Texts and Papyrus Westcar stand in the
# new file as unopened works. The fifth, the demotic magical papyrus of London
# and Leiden, is held in this graph as a transmission of its own at
# traditions/demotic-magical-papyri.ttl and was harvested before this run; the
# new file records the overlap at the instance rather than claiming the work
# twice.

pmt:HittiteRitual a pm:Tradition ;
    rdfs:label "Hittite and Anatolian ritual"@en, "Hethitisch-anatolisches Ritual"@de ;
    skos:definition "Anatolian purification and substitution rituals transmitted under the names of the practitioners who dictated them, most of them women."@en ;
    pm:principalCorpus "The CTH ritual corpus, including the rituals of Tunnawiya, Maštigga and Ambazzi" ;
    pm:coverageState pm:corpusNamed ;
    pm:contactRoute pm:contactRouteDisputed .

pmt:UgariticRitual a pm:Tradition ;
    rdfs:label "Ugaritic and Levantine ritual"@en, "Ugaritisch-levantinisches Ritual"@de ;
    skos:definition "Late Bronze Age Levantine ritual and incantation, including the address to the deified dead."@en ;
    pm:principalCorpus "The KTU corpus, including the Rapiuma texts and the serpent incantations" ;
    pm:coverageState pm:corpusNamed ;
    pm:contactRoute pm:contactRouteDisputed .

# pmt:Zoroastrian has left this file: passages have been read and the instance
# now stands in traditions/zoroastrian.ttl at pm:placesEntered. The contact
# route stays at disputed and the registration's judgement about the Arda Wiraz
# Namag held: it is closer to a protocol than most of what the graph holds, and
# the reading confirmed the preparation, the three cups, the seven days' watch
# and the report on return.
#
# What the reading added is the other half. The registration named xvarenah as
# a conferred radiance; Yasht 19 was not opened and no node stands for it. And
# the sharpest finding of the run is not in the journey at all but in Vendidad
# 9: a purification carried out by someone who does not know the rites is said
# to make the sickness and death of the world stronger than they were before,
# which is a claim in the opposite direction from mere failure and therefore
# decidable. See prima-materia#489.

pmt:Manichaean a pm:Tradition ;
    rdfs:label "Manichaean transmission"@en, "Manichäische Überlieferung"@de ;
    skos:definition "The transmission founded on Mani's own account of a companion who appeared to him and disclosed what he taught."@en ;
    skos:note "The Cologne Mani Codex carries a first-person account of the syzygos, which is rare for late antiquity and rarer still with a name attached."@en ;
    pm:principalCorpus "Kephalaia; Cologne Mani Codex; the Coptic psalms and the Turfan fragments" ;
    pm:coverageState pm:corpusNamed ;
    pm:contactRoute pm:contactRouteDocumented .

# pmt:Mandaean has left this file: three works have been read at the wording
# and the instance now stands in traditions/mandaean.ttl at
# pm:placesEntered, with its contact route unchanged at disputed. What the
# run did change is the account of the dispute. It is usually put as a
# question of geography, a Palestinian origin against a Mesopotamian one;
# what divides the scholarship is a question of evidence, since no manuscript
# of this corpus is older than the sixteenth century and everything claimed
# for an earlier state rests on the copyist chains named in the colophons.
# The value stays where it was and the reason for it is now written down.

pmt:Yazidi a pm:Tradition ;
    rdfs:label "Yazidi transmission"@en, "Jesidische Überlieferung"@de ;
    skos:definition "A Kurdish transmission carried chiefly in hymn and recitation, teaching successive returns of the soul."@en ;
    skos:note "The two books circulated as its scripture are held by most scholarship to be forgeries of the early twentieth century, which makes the corpus question itself the first thing to decide."@en ;
    pm:principalCorpus "The Qewls (hymns) in the published collections; the disputed Mišefa Reš and Kitêba Cilwe" ;
    pm:coverageState pm:corpusNamed ;
    pm:contactRoute pm:contactRouteUndecided .

pmt:Druze a pm:Tradition ;
    rdfs:label "Druze transmission"@en, "Drusische Überlieferung"@de ;
    skos:definition "A closed transmission teaching the transfer of the soul into a new body at death, with an internal literature restricted to the initiated."@en ;
    skos:note "A case where the gate the project exists to remove is still shut and still enforced. Registration says so rather than pretending the corpus is available."@en ;
    pm:principalCorpus "Rasāʾil al-Ḥikma" ;
    pm:coverageState pm:corpusNamed ;
    pm:contactRoute pm:contactRouteUndecided .

pmt:Yarsan a pm:Tradition ;
    rdfs:label "Yarsan transmission"@en, "Yarsanische Überlieferung"@de ;
    skos:definition "An Iranian transmission teaching successive bodily lives as a purification, carried in Gorani verse."@en ;
    pm:principalCorpus "Kalām-e Saranjām" ;
    pm:coverageState pm:corpusNamed ;
    pm:contactRoute pm:contactRouteUndecided .

# pmt:Hekhalot has left this file: passages have been read and the instance now
# stands in traditions/hekhalot.ttl at pm:placesEntered. The registration's
# judgement held and was the reason to open the corpus: the Sar Torah material
# states a learning capacity plainly enough to be tested. The reading sharpened
# it in one respect that matters for the examination layer - what the passage
# promises is not an inner state but a public performance, expounding what is
# forbidden and permitted before an academy competent to judge it.
#
# One part of the registration is corrected. It said the capacity is claimed
# "in a stated time"; the chapters read state no term at all. The forty days and
# the counted immersions stand in paragraphs that were not opened, and no node
# in the new file carries them. See prima-materia#492.

pmt:JewishPracticalMagic a pm:Tradition ;
    rdfs:label "Jewish practical magic"@en, "Jüdische Praxismagie"@de ;
    skos:definition "The operative Jewish transmission of adjurations, amulets and bowls, distinct from the speculative literature and older than it in its written witnesses."@en ;
    pm:principalCorpus "Sefer ha-Razim; Ḥarba de-Moshe; the Cairo Genizah magical fragments; the Aramaic incantation bowls" ;
    pm:coverageState pm:corpusNamed ;
    pm:contactRoute pm:contactRouteDocumented .

pmt:Kabbalah a pm:Tradition ;
    rdfs:label "Kabbalah"@en, "Kabbala"@de ;
    skos:definition "The medieval and early modern Jewish transmission of the sefirot as the structure of emanation, and of the human act as bearing on it."@en ;
    pm:principalCorpus "Sefer ha-Bahir; Zohar; Cordovero, Pardes Rimmonim; Vital, Ez Ḥayyim and Šaʿar ha-Gilgulim" ;
    pm:coverageState pm:corpusNamed ;
    pm:contactRoute pm:contactRouteDocumented .

pmt:PropheticKabbalah a pm:Tradition ;
    rdfs:label "Prophetic Kabbalah"@en, "Prophetische Kabbala"@de ;
    skos:definition "Abulafia's transmission of letter permutation, breath and head movement as a technique for reaching a state he calls prophecy."@en ;
    skos:note "Registered apart from Kabbalah because it is a manual and not a doctrine. On the level of stated procedure it is the closest western counterpart to the Yogasūtra that exists, including its warnings about what befalls the unprepared."@en ;
    pm:principalCorpus "Abulafia, Or ha-Sekhel; Abulafia, Ḥayyei ha-Olam ha-Ba" ;
    pm:coverageState pm:corpusNamed ;
    pm:contactRoute pm:contactRouteDocumented .

pmt:Hasidism a pm:Tradition ;
    rdfs:label "Hasidism"@en, "Chassidismus"@de ;
    skos:definition "The eastern European transmission of devekut as a continuous attachment attainable within ordinary life, and of contemplation as its means."@en ;
    pm:principalCorpus "Toledot Yaakov Yosef; Keter Shem Tov; Shneur Zalman, Tanya" ;
    pm:coverageState pm:corpusNamed ;
    pm:contactRoute pm:contactRouteDocumented .

pmt:IsmailiCosmology a pm:Tradition ;
    rdfs:label "Ismaili cosmology"@en, "Ismailitische Kosmologie"@de ;
    skos:definition "The Shia transmission of a graded emanation and of an inner meaning disclosed by initiation, together with the encyclopaedic Neoplatonism of the Brethren of Purity."@en ;
    pm:principalCorpus "Sijistānī, Kashf al-Maḥjūb; Nāṣir-i Khusraw, Jāmiʿ al-Ḥikmatayn; Rasāʾil Ikhwān al-Ṣafāʾ" ;
    pm:coverageState pm:corpusNamed ;
    pm:contactRoute pm:contactRouteDocumented .

pmt:Illuminationism a pm:Tradition ;
    rdfs:label "Illuminationism"@en, "Illuminationismus"@de ;
    skos:definition "Suhrawardī's transmission of knowledge by presence and of an intermediate world of images held to be neither material nor mental but a place with its own standing."@en ;
    skos:note "The claim that the imaginal world is a place and not a faculty is an ontological commitment the graph will have to sort against every tradition that treats vision as internal."@en ;
    pm:principalCorpus "Suhrawardī, Ḥikmat al-Ishrāq; Mullā Ṣadrā, al-Asfār al-Arbaʿa" ;
    pm:coverageState pm:corpusNamed ;
    pm:contactRoute pm:contactRouteDocumented .

pmt:IslamicLetterMagic a pm:Tradition ;
    rdfs:label "Islamic letter and name magic"@en, "Islamische Buchstaben- und Namensmagie"@de ;
    skos:definition "The operative transmission of the science of letters and of the divine names, with squares, talismans and hours of working."@en ;
    skos:note "The ascription of the best known handbook to al-Būnī is contested, and the corpus grew after him under his name. The dispute is the first node this tradition should carry."@en ;
    pm:principalCorpus "The Šams al-maʿārif corpus ascribed to al-Būnī; Ghāyat al-Ḥakīm" ;
    pm:coverageState pm:corpusNamed ;
    pm:contactRoute pm:contactRouteDocumented .
