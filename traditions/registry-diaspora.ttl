@prefix pm:      <https://pajew.ski/prima-materia/ontology#> .
@prefix pmt:     <https://pajew.ski/prima-materia/traditions/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

#
# prima-materia — registered transmissions: the African diaspora and its
# neighbours
#
# These transmissions were assembled under conditions that make the contact
# question unusually clear: the routes are documented, dated and forced. They
# add no independent witness. What they add is the only body of material the
# project can hold in which a tradition was rebuilt from remembered fragments
# under prohibition, which is a different kind of evidence about what is
# transmissible at all.
#

pmt:HaitianVodou a pm:Tradition ;
    rdfs:label "Haitian Vodou"@en, "Haitianisches Vodou"@de ;
    skos:definition "The Haitian transmission of spirits who arrive in a named person and speak, with a liturgy that assigns each an appearance, a rhythm and a manner."@en ;
    skos:note "Deren's account is a first-person report of being mounted by a spirit written by the observer herself, which is a rare form: participant testimony with the observation intact."@en ;
    pm:principalCorpus "Métraux, Le vaudou haïtien; Deren, Divine Horsemen" ;
    pm:coverageState pm:corpusNamed ;
    pm:contactRoute pm:contactRouteDocumented .

pmt:LucumiSanteria a pm:Tradition ;
    rdfs:label "Lucumí"@en, "Lucumí"@de ;
    skos:definition "The Cuban transmission of the orichas, carrying the Yoruba divinatory corpus in a shortened form alongside Catholic imagery."@en ;
    skos:note "Its relation to Ifá is a documented case of a corpus surviving a forced transfer with measurable loss, which is examinable rather than merely regrettable."@en ;
    pm:principalCorpus "Cabrera, El Monte; the published libretas" ;
    pm:coverageState pm:corpusNamed ;
    pm:contactRoute pm:contactRouteDocumented .

pmt:Candomble a pm:Tradition ;
    rdfs:label "Candomblé"@en, "Candomblé"@de ;
    skos:definition "The Brazilian transmission of the orixás, with an initiation that seats a spirit in the head of the initiate."@en ;
    pm:principalCorpus "Bastide, Le candomblé de Bahia; Verger, Notes sur le culte des Orisa et Vodun" ;
    pm:coverageState pm:corpusNamed ;
    pm:contactRoute pm:contactRouteDocumented .

pmt:PaloMonte a pm:Tradition ;
    rdfs:label "Palo Monte"@en, "Palo Monte"@de ;
    skos:definition "The Cuban transmission of Kongo derivation, working through a charged vessel and a pact with a named spirit of the dead."@en ;
    pm:principalCorpus "Cabrera, Reglas de Congo" ;
    pm:coverageState pm:corpusNamed ;
    pm:contactRoute pm:contactRouteDocumented .

pmt:Hoodoo a pm:Tradition ;
    rdfs:label "Hoodoo"@en, "Hoodoo"@de ;
    skos:definition "The African American transmission of workings for protection, luck, love and revenge, carried by practitioners without a priesthood or a central corpus."@en ;
    skos:note "The Hyatt collection is thousands of practitioner statements taken down verbatim with the speakers identified only by place. As a body of first-person practice testimony it has no equal in the project's reach."@en ;
    pm:principalCorpus "Hyatt, Hoodoo, Conjuration, Witchcraft, Rootwork, five volumes" ;
    pm:coverageState pm:corpusNamed ;
    pm:contactRoute pm:contactRouteDocumented .

# pmt:Spiritism has left this file: passages have been read and the instance now
# stands in traditions/spiritism.ttl at pm:placesEntered, with the contact route
# unchanged at documented.
#
# The registration said this transmission submits itself to examination in its
# own founding text and is therefore the natural first object of the project's
# examination layer. The reading confirmed the first half and found its
# counterpart. The rule of verification is there and is better stated than the
# registration promised - concordance of spontaneous teaching from many mediums
# unknown to one another in different places, with a single medium and a single
# centre expressly excluded, and with the written admission that the doctrine
# would modify itself if shown to be in error. And in another work by the same
# author the question put in order to test is forbidden, with both outcomes
# settled in advance. A criterion that agreement can satisfy and that no
# question may strain is what remains.
#
# The registration also named the nineteenth-century body of investigation
# attached to this transmission. None of it was read; it is evidence and not
# source, and it enters only at pm:evidenceFrom on a protocol. See
# prima-materia#497.
