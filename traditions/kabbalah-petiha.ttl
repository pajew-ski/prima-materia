@prefix pm:      <https://pajew.ski/prima-materia/ontology#> .
@prefix pmt:     <https://pajew.ski/prima-materia/traditions/> .
@prefix pmc:     <https://pajew.ski/prima-materia/concepts/> .
@prefix pmp:     <https://pajew.ski/prima-materia/practices/> .
@prefix pmw:     <https://pajew.ski/prima-materia/works/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

#
# prima-materia — Kabbalah: Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala
#
# The harvest of one work of the corpus of pmt:Kabbalah, kept apart from
# traditions/kabbalah.ttl, which declares the tradition and the work
# (pmw:PetihaLeHokhmatHaQabbala); the edition read, the translations and the
# counts of the harvest stand as notes on the work there. Nodes follow the
# sections of the work, 1 to 188, each at the section that carries it.
#
# Harvested under prima-materia#924 with two independent extraction passes
# over the Hebrew, reconciled by offset and word overlap, then integrated by a
# reader of the whole text. Identifiers are pmc:KabbalahAshlag or
# pmp:KabbalahAshlag plus the Hebrew term in ASCII transliteration. Signs of
# success, conditions of failure and capacities carry a note beginning
# "Counted as".
#

#
# §1
#

pmc:KabbalahAshlagZekhutHizdakkekhut a pm:Conceptualizing ;
    rdfs:label "Zekhut read as purification"@en, "Zekhut als Läuterung"@de ;
    skos:definition "The text takes the rabbinic term zekhut (merit) to derive from hizdakkekhut, refinement; Torah and commandments are said to have been given in order to refine Israel."@en ;
    skos:note "Hebrew term in the text: זכות / הזדככות (zekhut / hizdakkekhut)."@en ;
    skos:note "Frames the whole preface: what is the coarseness in us that must be refined."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §1, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagMahshevetHaBeria a pm:Conceptualizing ;
    rdfs:label "Thought of Creation: to delight the creatures"@en, "Schöpfungsgedanke: die Geschöpfe zu erfreuen"@de ;
    skos:definition "The purpose of creation is stated to be the giving of delight to created beings according to the generosity of the Creator; from this souls were imprinted with a great craving for His abundance."@en ;
    skos:note "Hebrew term in the text: מחשבת הבריאה (maḥshevet ha-beriʾa)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §1, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagRatzonLeQabbel a pm:Conceptualizing ;
    rdfs:label "Receptive will as vessel proportioned to pleasure"@en, "Wille zu empfangen als Gefäß im Maß der Lust"@de ;
    skos:definition "The receptive will is the vessel for the pleasure in the abundance; the pleasure felt equals exactly the size and intensity of the desire, the two being distinguishable only by attribution (pleasure to the abundance, desire to the receiver)."@en ;
    skos:note "Hebrew term in the text: רצון לקבל (ratzon le-qabbel)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §1, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagYeshMeAyin a pm:Conceptualizing ;
    rdfs:label "Abundance existence-from-existence; will existence-from-nothing"@en, "Fülle aus Sein, Wille aus Nichts"@de ;
    skos:definition "The abundance extends out of the Creator's own essence (yesh mi-yesh), while the receptive will is the one truly new thing, brought forth from absence (yesh me-ayin); in the Creator there is no receptive will at all."@en ;
    skos:note "Hebrew term in the text: יש מיש / יש מאין (yesh mi-yesh / yesh me-ayin)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §1, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagRatzonLeQabbelHomerHaBeria a pm:Conceptualizing ;
    rdfs:label "Receptive will as the entire matter of creation"@en, "Wille zu empfangen als ganzer Stoff der Schöpfung"@de ;
    skos:definition "All creatures and all their events and modes of governance are said to be nothing but quantities and differing values of the receptive will; whatever is received in them is not new but drawn from His eternity."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §1, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §2
#

pmc:KabbalahAshlagOrVeKheli a pm:Conceptualizing ;
    rdfs:label "Light and vessel come bound together"@en, "Licht und Gefäß treten verbunden auf"@de ;
    skos:definition "Light and vessel in the upper worlds necessarily come together and descend together from degree to degree; the farther the degrees descend from the Creator, the more the receptive will contained in the abundance becomes materialised (and conversely)."@en ;
    skos:note "Hebrew term in the text: אור וכלי (or ve-kheli)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §2, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagOlamHaAsiya a pm:Naming ;
    rdfs:label "World of Assiya as place of fully materialised will"@en, "Welt Assija als Ort des voll verdichteten Willens"@de ;
    skos:definition "The lowest place, where the receptive will is materialised in its full due measure, is designated the world of Assiya; there the will is regarded as the human body and the abundance it receives as the life within that body."@en ;
    pm:nameForm "ʿOlam ha-ʿAsiyya" ;
    pm:nameRole "lowest of the four worlds; locus of the fully materialised receptive will" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §2, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagOlamotElyonimVeOlamHaZe a pm:Conceptualizing ;
    rdfs:label "Upper worlds versus this world: final form of the will"@en, "Obere Welten und diese Welt: Endform des Willens"@de ;
    skos:definition "Upper worlds differ from this world solely in whether the receptive will has already been materialised in its final form; until then it is said to be in the spiritual worlds."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §2, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §3
#

pmc:KabbalahAshlagArbaOtiyotHavaya a pm:Systematizing ;
    rdfs:label "Four phases ordered by the four letters of HaVaYaH"@en, "Vier Stufen nach den vier Buchstaben von HWYH"@de ;
    skos:definition "The descent that brings the receptive will to its final form follows four phases matching the Tetragrammaton's four letters, which are said to include all of reality without exception."@en ;
    pm:compiledBy "Yehuda Leib Ashlag, in the Petiḥa le-Ḥokhmat ha-Qabbala" ;
    dcterms:date "1945"^^xsd:gYear ;
    skos:note "Hebrew term in the text: ארבע בחינות (arbaʿ beḥinot)."@en ;
    skos:note "The ordering is the author's: he arranges the Lurianic material he expounds; the date is that of the printing read."@en ;
    skos:note "Entered as an ordering and not as a series: it sets the four phases against the four letters of the Name, a correspondence between two orders; the phases themselves stand as the series pmc:KabbalahAshlagArbaBehinotDeOrYashar."@en ;
    pm:attestedBy pm:compilerInference ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §3, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagEserSefirot a pm:Systematizing ;
    rdfs:label "Ten sefirot as four phases plus root"@en, "Zehn Sefirot als vier Stufen und Wurzel"@de ;
    skos:definition "In general terms the four phases are the sefirot Hokhma, Bina, Tiferet, Malkhut together with their root; Tiferet contains six sefirot (Hesed through Yesod), the root being named Keter, totalling ten; the reader is told to remember that their essence is the four."@en ;
    pm:compiledBy "Yehuda Leib Ashlag, in the Petiḥa le-Ḥokhmat ha-Qabbala" ;
    dcterms:date "1945"^^xsd:gYear ;
    skos:note "Hebrew term in the text: עשר ספירות (ʿeser sefirot)."@en ;
    skos:note "The ordering is the author's: he arranges the Lurianic material he expounds; the date is that of the printing read."@en ;
    pm:attestedBy pm:compilerInference ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §3, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagArbaOlamotABYA a pm:Naming ;
    rdfs:label "The four worlds (ABYA)"@en, "Vier Welten Azilut, Beria, Jezira, Assija"@de ;
    skos:definition "The four phases are also the four worlds; the world of Assiya is held to include this world as well."@en ;
    pm:nameForm "Atzilut, Beriʾa, Yetzira, ʿAsiyya" ;
    pm:nameRole "four worlds through which the receptive will descends" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §3, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagGmarHaRatzonPresupposesYeridaBaOlamot a pm:Presupposing ;
    rdfs:label "Descent through four worlds before final form"@en, "Abstieg durch vier Welten vor der Endform"@de ;
    skos:definition "For the receptive will to reach its final quality it is obliged to descend together with its abundance through Atzilut, Beria, Yetzira and Assiya; only then is the creature completed as body with its life-light."@en ;
    pm:dependentStep pmc:KabbalahAshlagOlamotElyonimVeOlamHaZe ;
    pm:priorStep pmc:KabbalahAshlagArbaOlamotABYA ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "The receptive will would not reach its final quality as a vessel (body)." ;
    skos:note "The dependent step is the will in its final form (this world against the upper worlds, §2); the prior step is the descent through the four worlds the text names here."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §3, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §4
#

pmc:KabbalahAshlagHitpashtutVeHistalkutHaOr a pm:Conceptualizing ;
    rdfs:label "Rule: expansion and departure of light make the vessel"@en, "Regel: Ausbreitung und Abzug des Lichts formen das Gefäß"@de ;
    skos:definition "A great rule about vessels: the light's expansion and its departure are what make a vessel fit for its function."@en ;
    skos:note "Hebrew term in the text: התפשטות האור והסתלקותו (hitpashtut ha-or ve-histalkuto)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §4, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagBittulHaKliBeOro a pm:Conceptualizing ;
    rdfs:label "Vessel annulled while never separated from its light"@en, "Gefäß im Licht aufgehoben, solange nie getrennt"@de ;
    skos:definition "While the vessel has never once parted from its light, it is subsumed in it and nullified like a candle facing a torch, because light (all bestowal) and vessel (all receiving) are opposite; the vessel cannot establish its form."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that does not come about or is lost, and its cause. It names how pmc:KabbalahAshlagHitpashtutVeHistalkutHaOr fails or is lost."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §4, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagQeviutHaKliPresupposesHistalkut a pm:Presupposing ;
    rdfs:label "Departure of light once before the vessel is fixed"@en, "Einmaliger Lichtabzug vor Festlegung des Gefäßes"@de ;
    skos:definition "The receptive will can fix its form only once the light has left it a single time; the longing that follows the departure determines its form, and when the light returns the two are distinguished as vessel and light, body and life."@en ;
    pm:dependentStep pmc:KabbalahAshlagBehinaDaletMalkhut ;
    pm:priorStep pmc:KabbalahAshlagHitpashtutVeHistalkutHaOr ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Without the light's departure the will stays nullified in the light and no distinct vessel exists." ;
    skos:note "The dependent step is the vessel fixed in its form, which §5 places at phase four; the prior step is the rule of expansion and departure."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §4, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagAmokMiKolAmok a pm:Cautioning ;
    rdfs:label "Attention: this point is exceedingly deep"@en, "Achtung: dieser Punkt ist überaus tief"@de ;
    skos:definition "The reader is told to fix attention here because the matter is said to be deeper than anything deep."@en ;
    pm:cautionsAbout pmc:KabbalahAshlagQeviutHaKliPresupposesHistalkut ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §4, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §5
#

pmc:KabbalahAshlagArbaBehinotDeOrYashar a pm:Sequencing ;
    rdfs:label "Four phases of direct light (Hokhma, Bina, Tiferet, Malkhut)"@en, "Vier Stufen des direkten Lichts"@de ;
    skos:definition "The emanated being develops through four phases in fixed sequence: phase 1 Hokhma, phase 2 Bina, phase 3 Tiferet, phase 4 Malkhut; each phase is defined by its relation to the preceding one."@en ;
    rdf:_1 pmc:KabbalahAshlagBehinaAlefHokhma ;
    rdf:_2 pmc:KabbalahAshlagBehinaBetBina ;
    rdf:_3 pmc:KabbalahAshlagBehinaGimelTiferet ;
    rdf:_4 pmc:KabbalahAshlagBehinaDaletMalkhut ;
    pm:seriesStatement "The four phases of direct light come in a fixed order, Hokhma, Bina, Tiferet, Malkhut, and each is what it is through the one before it: the bestowing will of the second arises at the close of the first, the third renews a small receptive will out of the second, and only the fourth, roused by the third, fixes the vessel, so that a vessel exists in full only at the last place." ;
    skos:note "Hebrew term in the text: ארבע בחינות דאור ישר (arbaʿ beḥinot)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §5, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagBehinaAlefHokhma a pm:Conceptualizing ;
    rdfs:label "Phase 1 Hokhma: all light, vessel barely discernible"@en, "Stufe 1 Chochma: ganz Licht, Gefäß kaum erkennbar"@de ;
    skos:definition "Phase one contains the whole emanated being, light and vessel: the great receptive will with the light of Hokhma (also light of Haya), yet it counts as all light, the vessel being mixed in and nullified."@en ;
    skos:note "Hebrew term in the text: אור החכמה / אור החיה (or ha-ḥokhma / or ha-ḥaya)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §5, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagBehinaBetBina a pm:Conceptualizing ;
    rdfs:label "Phase 2 Bina: bestowing will drawing light of Hasadim"@en, "Stufe 2 Bina: Wille zu geben zieht Chassadim"@de ;
    skos:definition "Toward its conclusion the Hokhma vessel strengthens toward equivalence of form toward the upper light and a desire arises to bestow on the Emanator; through it a new light, Hasadim, is drawn, and the vessel almost wholly separates from the light of Hokhma."@en ;
    skos:note "Hebrew term in the text: אור חסדים (or ḥasadim)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §5, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagOrHokhmaBeRatzonGadol a pm:Conceptualizing ;
    rdfs:label "Hokhma light received only in the great receptive will"@en, "Chochma-Licht nur im großen Empfangswillen"@de ;
    skos:definition "Hokhma light is receivable solely in its proper vessel, the full receptive will; a vessel of bestowal therefore holds Hasadim only."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §5, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagOrHasadimDevekut a pm:Conceptualizing ;
    rdfs:label "Light of Hasadim as light of adhesion"@en, "Chassadim-Licht als Licht der Anhaftung"@de ;
    skos:definition "The light of Hasadim is defined as light drawn by force of the emanated being's adhesion with its Emanator."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §5, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagDevekutHashvaatHaTzura a pm:Conceptualizing ;
    rdfs:label "Devekut by equivalence of form"@en, "Dewekut durch Formgleichheit"@de ;
    skos:definition "The bestowing will brings equivalence of form toward the Emanator, and equivalence of form in spiritual matters is adhesion (devekut)."@en ;
    skos:note "Hebrew term in the text: דבקות / השואת הצורה (devekut / hashvaʾat ha-tzura)."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    skos:note "Capacity: the text says this adhesion is reached through equivalence of form; no practice is attached to it at this place."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §5, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagBehinaGimelTiferet a pm:Conceptualizing ;
    rdfs:label "Phase 3 Tiferet: Hasadim with illumination of Hokhma"@en, "Stufe 3 Tiferet: Chassadim mit Chochma-Erleuchtung"@de ;
    skos:definition "Since Hokhma is the core of the emanated being's vitality, phase two at its end draws some Hokhma to shine within Hasadim; this renews a measure of receptive will, a new vessel, named phase three or Tiferet, whose light is mostly Hasadim with a little Hokhma."@en ;
    skos:note "Hebrew term in the text: אור חסדים בהארת חכמה."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §5, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagBehinaDaletMalkhut a pm:Conceptualizing ;
    rdfs:label "Phase 4 Malkhut: completion of the vessel"@en, "Stufe 4 Malchut: Vollendung des Gefäßes"@de ;
    skos:definition "The vessel of phase three in turn is roused to draw Hokhma in full as in phase one; this is longing, the receptive will of phase one plus being separated from that light, so the will is fixed in its completeness; the vessel now precedes the light and phase four is called completion of the vessel, Malkhut."@en ;
    skos:note "Hebrew term in the text: גמר כלי / מלכות (gmar kli / malkhut)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §5, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §6
#

pmc:KabbalahAshlagBehinotKeNegedOlamot a pm:Systematizing ;
    rdfs:label "Correspondence of four phases to four worlds"@en, "Zuordnung der vier Stufen zu den vier Welten"@de ;
    skos:definition "The four phases are the ten sefirot present in every emanated and created thing, both in the whole (that is, ABYA) and in the tiniest detail: phase 1 Hokhma = Atzilut, phase 2 Bina = Beria, phase 3 Tiferet = Yetzira, phase 4 Malkhut = Assiya."@en ;
    pm:compiledBy "Yehuda Leib Ashlag, in the Petiḥa le-Ḥokhmat ha-Qabbala" ;
    dcterms:date "1945"^^xsd:gYear ;
    skos:note "The ordering is the author's: he arranges the Lurianic material he expounds; the date is that of the printing read."@en ;
    skos:note "A correspondence between the four phases and the four worlds, not a series of stages; entered as an ordering."@en ;
    pm:attestedBy pm:compilerInference ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §6, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagShemNeshama a pm:Conceptualizing ;
    rdfs:label "Name \"soul\" implies difference from the Emanator"@en, "Name Seele setzt Abstand vom Emanator voraus"@de ;
    skos:definition "The term neshama is said to imply some difference from the Emanator by which it exits the Infinite into a domain of its own; without vessel-form nothing separates it from His essence, so in Atzilut it is not yet called soul."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §6, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagOlamHaAtzilut a pm:Naming ;
    rdfs:label "Atzilut as wholly divine"@en, "Azilut als vollständig göttlich"@de ;
    skos:definition "Atzilut is held to be complete divinity, since the vessel of phase one is not discernible; even souls of animals passing through it are reckoned as still adhering to His essence."@en ;
    pm:nameForm "ʿOlam ha-Atzilut" ;
    pm:nameRole "world of phase one; all light, no discernible vessel" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §6, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §7
#

pmc:KabbalahAshlagOlamHaBeria a pm:Naming ;
    rdfs:label "Beria: world of the vessel of bestowal; soul named neshama"@en, "Beria: Welt des Gebe-Gefäßes; Seele heißt Neschama"@de ;
    skos:definition "In Beria phase two rules; a soul attaining that vessel is first called neshama, having separated from His essence, yet the vessel is very pure, in equivalence of form, and counts as wholly spiritual."@en ;
    pm:nameForm "ʿOlam ha-Beriʾa" ;
    pm:nameRole "world of phase two (bestowing will)" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §7, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §8
#

pmc:KabbalahAshlagOlamHaYetzira a pm:Naming ;
    rdfs:label "Yetzira: slight coarseness; soul named ruah"@en, "Jezira: geringe Grobheit; Seele heißt Ruach"@de ;
    skos:definition "In Yetzira phase three rules, containing a little receptive will; the soul there is called ruah, its vessel mixed with slight coarseness, yet still spiritual since this coarseness is not enough to make an independent body."@en ;
    pm:nameForm "ʿOlam ha-Yetzira" ;
    pm:nameRole "world of phase three" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §8, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §9
#

pmc:KabbalahAshlagOlamHaAsiyaNefesh a pm:Naming ;
    rdfs:label "Assiya: separate body; light named nefesh"@en, "Assija: getrennter Körper; Licht heißt Nefesch"@de ;
    skos:definition "In Assiya phase four, completion of the vessel, rules; there a body wholly separate from His essence is attained, and its light is called nefesh, meaning light without motion of its own."@en ;
    pm:nameForm "ʿOlam ha-ʿAsiyya / nefesh" ;
    pm:nameRole "world of phase four; nefesh is its light" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §9, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagKolPratKolelABYA a pm:Conceptualizing ;
    rdfs:label "Every detail of reality contains all four worlds"@en, "Jedes Detail enthält alle vier Welten"@de ;
    skos:definition "No small detail of reality exists that is not composed of all of Atzilut, Beria, Yetzira and Assiya."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §9, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §10
#

pmc:KabbalahAshlagYeridatHaNefeshLaGuf a pm:Conceptualizing ;
    rdfs:label "Descent of nefesh into the body; root obscured"@en, "Abstieg der Nefesch in den Körper; Wurzel verdeckt"@de ;
    skos:definition "The life-light clothed in the body is drawn from His essence and, passing through the four worlds, distances itself until it reaches the body, its proper vessel; its light becomes so diminished that its root is no longer discernible."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §10, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmp:KabbalahAshlagTorahUMitzvotAlMenatLeHashpia a pm:Practicing ;
    rdfs:label "Torah and commandments with intention to give contentment to the Maker"@en, "Tora und Gebote in der Absicht, dem Schöpfer Freude zu bereiten"@de ;
    skos:definition "Engage in Torah and the commandments with the intention of bestowing contentment on one's Maker (not for oneself); steps: study and perform, direct the intent toward bestowal, continue progressively."@en ;
    skos:note "Hebrew term in the text: על מנת להשפיע (ʿal menat le-hashpiʿa)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §10, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagHizdakkekhutHaGuf a pm:Conceptualizing ;
    rdfs:label "Purified body fit to receive the full abundance"@en, "Geläuterter Körper, fähig die volle Fülle zu empfangen"@de ;
    skos:definition "Gradual purification of the vessel called body until it becomes fit to receive the great abundance to the entire extent contained in the Thought of Creation."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §10, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagTorahUMitzvotHizdakkekhutHaGuf a pm:Yielding ;
    rdfs:label "Torah with bestowing intent purifies the body-vessel"@en, "Tora mit gebender Absicht läutert das Körpergefäß"@de ;
    skos:definition "Practice of Torah and commandments for the Maker's sake is said to purify the body progressively until it can receive the abundance of the Thought of Creation; linked to the opening dictum of R. Hananya."@en ;
    pm:byPractice pmp:KabbalahAshlagTorahUMitzvotAlMenatLeHashpia ;
    pm:yieldsCapacity pmc:KabbalahAshlagHizdakkekhutHaGuf ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §10, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §11
#

pmc:KabbalahAshlagRuhaniVeGashmi a pm:Conceptualizing ;
    rdfs:label "True definition of spiritual and corporeal"@en, "Wahre Bestimmung von geistig und körperlich"@de ;
    skos:definition "Whatever has a receptive will complete in all its aspects (phase four) is called corporeal and is found in this world; whatever is above that great measure is called spiritual, namely the worlds above this world."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §11, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagAliyotVeYeridotEinamMaqom a pm:Cautioning ;
    rdfs:label "Ascents and descents are not imaginary place"@en, "Auf- und Abstiege sind kein vorgestellter Ort"@de ;
    skos:definition "The reader is warned not to take the rising and falling spoken of in upper worlds as spatial; they concern only the four phases of the receptive will: farther from phase four is higher, nearer to it is lower."@en ;
    pm:cautionsAbout pmc:KabbalahAshlagRuhaniVeGashmi ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §11, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §12
#

pmc:KabbalahAshlagTakhlitHaBeriaPresupposesHizdakkekhut a pm:Presupposing ;
    rdfs:label "Refinement of the will before reaching the goal of creation"@en, "Läuterung des Willens vor Erreichen des Schöpfungsziels"@de ;
    skos:definition "We are commanded to refine the receptive will through Torah and commandments, since without this we will not arrive at the exalted aim of the Thought of Creation."@en ;
    pm:dependentStep pmc:KabbalahAshlagHizdakkekhutHaGuf ;
    pm:priorStep pmp:KabbalahAshlagTorahUMitzvotAlMenatLeHashpia ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "The aim of the Thought of Creation is not reached." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §12, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §13
#

pmc:KabbalahAshlagShinuiHaTzura a pm:Conceptualizing ;
    rdfs:label "Disparity of form separates spiritual entities"@en, "Formunterschied trennt geistige Wesen"@de ;
    skos:definition "As physical things are separated by distance of place, spiritual things are separated by disparity of form; illustrated by two people near or far in their views, who love or hate each other irrespective of physical proximity."@en ;
    skos:note "Hebrew term in the text: שינוי הצורה (shinui ha-tzura)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §13, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagQurvaVeRihuqHaTzura a pm:Conceptualizing ;
    rdfs:label "Nearness, distance, coupling and union as measures of form"@en, "Nähe, Ferne, Paarung, Einung als Maße der Form"@de ;
    skos:definition "All distancing and approach, coupling (zivvug) and union in spiritual matters are only weights of disparity of form: they part according to disparity and cleave according to equivalence."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §13, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagPerudHaRatzonLeQabbel a pm:Conceptualizing ;
    rdfs:label "Receptive will separates the creature from the Emanator"@en, "Empfangswille trennt Geschöpf vom Emanator"@de ;
    skos:definition "Although the receptive will is an obligatory law of the creature and the proper vessel for the goal, it makes the creature wholly separate from the Emanator, because its form is the very opposite of His (He is all bestowal, it all receiving)."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that does not come about or is lost, and its cause. It names how pmc:KabbalahAshlagDevekutHashvaatHaTzura fails or is lost."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §13, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §14
#

pmc:KabbalahAshlagTzimtzumAlef a pm:Conceptualizing ;
    rdfs:label "First restriction (tzimtzum alef)"@en, "Erste Einschränkung (Zimzum Alef)"@de ;
    skos:definition "To save creatures from that great separation, the first restriction separated phase four from all holy partzufim, leaving that large measure of receiving as a vacant space empty of all light."@en ;
    skos:note "Hebrew term in the text: צמצום א' / חלל פנוי (tzimtzum alef / ḥalal panui)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §14, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagMasakh a pm:Conceptualizing ;
    rdfs:label "Masakh: screen corrected on the vessel of Malkhut"@en, "Masach: Schirm auf dem Gefäß der Malchut"@de ;
    skos:definition "All holy partzufim emerged with a corrected screen on their vessel of Malkhut so as not to receive light in phase four."@en ;
    skos:note "Hebrew term in the text: מסך (masakh)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §14, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagZivvugDeHakkaa a pm:Conceptualizing ;
    rdfs:label "Coupling by striking and reflected light"@en, "Paarung durch Schlag und zurückgeworfenes Licht"@de ;
    skos:definition "When upper light extends to the emanated being and the screen pushes it back, this counts as a striking between upper light and screen, and this raises reflected light upward from below, clothing upper light's ten sefirot; the repelled light is called reflected light."@en ;
    skos:note "Hebrew term in the text: זווג דהכאה / אור חוזר (zivvug de-hakkaʾa / or ḥozer)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §14, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagOrHozerKliQabbala a pm:Conceptualizing ;
    rdfs:label "Reflected light becomes the vessel instead of phase four"@en, "Rücklicht wird Gefäß anstelle der vierten Stufe"@de ;
    skos:definition "By clothing the upper light, reflected light becomes a receiving vessel in place of phase four; Malkhut then expands by that measure from above downward, and the lights are clothed within it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §14, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagRoshVeGuf a pm:Conceptualizing ;
    rdfs:label "Head (rosh) and body (guf) of every degree"@en, "Kopf und Körper jeder Stufe"@de ;
    skos:definition "The reflected light rising on the coupling clothes the ten sefirot as head's ten sefirot, which are only roots of vessels with no real clothing; when Malkhut expands downward with it, complete vessels form and lights are actually clothed: this is the body of the degree."@en ;
    skos:note "Hebrew term in the text: ראש / גוף (rosh / guf)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §14, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §15
#

pmc:KabbalahAshlagMashalBaalHaBayitVeOreah a pm:Conceptualizing ;
    rdfs:label "Parable of host and guest: refusal becomes the vessel"@en, "Gleichnis Gastgeber und Gast: Ablehnung wird Gefäß"@de ;
    skos:definition "A guest, though very hungry, refuses food from shame at receiving; when the host presses enough that eating will clearly do the host a great favour, he eats, now feeling himself the giver; the repeated refusals, not the hunger, become the real vessel for the meal."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §15, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagBushaMonaatQabbala a pm:Conceptualizing ;
    rdfs:label "Shame prevents receiving despite adequate appetite"@en, "Scham verhindert Empfangen trotz Hunger"@de ;
    skos:definition "Hunger and appetite, the ordinary vessels, were sufficient yet the guest could not taste anything because of shame; receiving as a plain receiver is blocked."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that does not come about or is lost, and its cause."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §15, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §16
#

pmc:KabbalahAshlagMashalZivvugDeHakkaa a pm:Conceptualizing ;
    rdfs:label "Parable applied to coupling by striking"@en, "Gleichnis auf die Schlagpaarung angewandt"@de ;
    skos:definition "The upper light striking the screen wishing to spread into phase four is likened to the host's pressing; the screen repelling it is likened to the guest's refusal; the reflected light raised by that repelling becomes the new receiving vessel, replacing phase four used before the first restriction."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §16, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagQelippotMetim a pm:Conceptualizing ;
    rdfs:label "Husks and this world use phase four itself: separation, called dead"@en, "Schalen und diese Welt nutzen Stufe 4 selbst: getrennt, tot"@de ;
    skos:definition "This correction exists solely for the holy partzufim of ABYA, not in the husks (qelippot) or this world, in which phase four itself serves as receiving vessel; disparity of form separates them from the upper light, so husks and the wicked are called dead, cut off from the Life of lives through their receptive will."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that does not come about or is lost, and its cause. It names how pmc:KabbalahAshlagOrHozerKliQabbala fails or is lost."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §16, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagQelippot a pm:Naming ;
    rdfs:label "Qelippot (husks)"@en, "Klippot (Schalen)"@de ;
    skos:definition "The husks are held to be structures receiving in phase four itself, separated from the upper light and therefore regarded as dead."@en ;
    pm:nameForm "qelippot" ;
    pm:nameRole "unholy structures that receive in phase four" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §16, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §17
#

pmc:KabbalahAshlagShloshaYesodot a pm:Systematizing ;
    rdfs:label "Three first foundations of the wisdom"@en, "Drei erste Grundlagen der Weisheit"@de ;
    skos:definition "The author lists three foundations: (1) light and vessel; (2) the ten sefirot plus four worlds through which the will must descend; (3) restriction and screen on phase four, replaced by new vessels of reflected light."@en ;
    pm:compiledBy "Yehuda Leib Ashlag, in the Petiḥa le-Ḥokhmat ha-Qabbala" ;
    dcterms:date "1945"^^xsd:gYear ;
    skos:note "The ordering is the author's: he arranges the Lurianic material he expounds; the date is that of the printing read."@en ;
    pm:attestedBy pm:compilerInference ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §17, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagOrHamshakhaKliRatzon a pm:Conceptualizing ;
    rdfs:label "Light as direct extension, vessel as the will that makes emanated"@en, "Licht als direkte Ausdehnung, Gefäß als Wille"@de ;
    skos:definition "Light is a direct extension from His essence; the vessel is the receptive will necessarily included in it, by whose measure the emanated being leaves the category of Emanator."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §17, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagShemoRatzon a pm:Conceptualizing ;
    rdfs:label "Malkhut called \"His Name\" (shemo = ratzon)"@en, "Malchut heißt Sein Name (Schmo = Razon)"@de ;
    skos:definition "The receptive will is Malkhut within the upper light, called His Name, since shemo has the numerical value of ratzon (will)."@en ;
    skos:note "Hebrew term in the text: שמו (shemo) = רצון (ratzon) בגימטריא."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §17, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §18
#

pmc:KabbalahAshlagHokhmaPresupposesShloshaYesodot a pm:Presupposing ;
    rdfs:label "Three foundations before any word of the wisdom"@en, "Drei Grundlagen vor jedem Wort der Weisheit"@de ;
    skos:definition "Understanding the three foundations and their reasons must precede study of this wisdom."@en ;
    pm:dependentStep pmc:KabbalahAshlagHavanatHokhmatHaQabbala ;
    pm:priorStep pmc:KabbalahAshlagShloshaYesodot ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Without them not even one word of this wisdom can be understood." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §18, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmp:KabbalahAshlagHavanaVeShinunHaYesodot a pm:Practicing ;
    rdfs:label "Understand and rehearse the three foundations with their reasons"@en, "Die drei Grundlagen mit Gründen verstehen und wiederholen"@de ;
    skos:definition "Study the three foundations, grasp the reasons given for each, and repeat them until they are well fixed."@en ;
    skos:note "Hebrew term in the text: והבן ושנן."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §18, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagHavanatHokhmatHaQabbala a pm:Conceptualizing ;
    rdfs:label "Understanding of the wisdom of Kabbalah"@en, "Verständnis der Weisheit der Kabbala"@de ;
    skos:definition "Ability to understand the words of this wisdom, said to depend on the three foundations."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §18, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagHavanaVeShinunHavanatHokhma a pm:Yielding ;
    rdfs:label "Rehearsing the foundations yields understanding"@en, "Wiederholung der Grundlagen ergibt Verständnis"@de ;
    skos:definition "Fixing the three foundations is presented as the condition for understanding the terms of the wisdom."@en ;
    pm:byPractice pmp:KabbalahAshlagHavanaVeShinunHaYesodot ;
    pm:yieldsCapacity pmc:KabbalahAshlagHavanatHokhmatHaQabbala ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §18, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagBehinaDaletBeOrHozer a pm:Conceptualizing ;
    rdfs:label "Phase four joins its receiving force to the reflected light"@en, "Stufe 4 muss das Rücklicht mit Empfangskraft begleiten"@de ;
    skos:definition "Although phase four was disqualified as vessel after the restriction, it must join its receiving force to the reflected light, otherwise the reflected light would not be able to serve as receiving vessel at all; in the parable, without appetite the guest could not please the host."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §18, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagQabbalaAlMenatLeHashpia a pm:Conceptualizing ;
    rdfs:label "Receiving in order to bestow"@en, "Empfangen um zu geben"@de ;
    skos:definition "The ordinary receiving vessels, disqualified in their plain form, take on through the force of refusal a new form, receiving for the sake of bestowal, whereby disgrace turns into honour; the content of receiving stays, its form changes."@en ;
    skos:note "Hebrew term in the text: קבלה על מנת להשפיע (qabbala ʿal menat le-hashpiʿa)."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §18, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagAviutNehefkhetLeOrHozer a pm:Conceptualizing ;
    rdfs:label "Coarseness of phase four transmuted into reflected light"@en, "Grobheit der Stufe 4 in Rücklicht umgewandelt"@de ;
    skos:definition "Phase four was disqualified because of its coarseness (disparity of form toward the giver); by the correction of the screen its former form is transformed into reflected light, and all its receiving force passes into the reflected light, which is why it can be a vessel."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §18, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagQashiut a pm:Conceptualizing ;
    rdfs:label "Hardness (qashiut) of the screen"@en, "Härte (Kaschiut) des Schirms"@de ;
    skos:definition "The first of two forces in the screen: hardness, its repelling force toward the upper light; elsewhere glossed as something so hard it lets nothing press into its boundary."@en ;
    skos:note "Hebrew term in the text: קשיות (qashiut)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §18, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagAviut a pm:Conceptualizing ;
    rdfs:label "Coarseness (aviut) of the screen"@en, "Grobheit (Awijut) des Schirms"@de ;
    skos:definition "The second force: coarseness, the measure of phase-four receptive will included in the screen, which through the coupling by striking is turned into purity, i.e. receiving turned into bestowing."@en ;
    skos:note "Hebrew term in the text: עביות (ʿaviut)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §18, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §19
#

pmc:KabbalahAshlagHameshBehinotHaAviut a pm:Sequencing ;
    rdfs:label "Five levels of coarseness in phase four (root to 4)"@en, "Fünf Grobheitsgrade in Stufe 4 (Wurzel bis 4)"@de ;
    skos:definition "Since the first three phases cause the completion of phase four, four measures of receiving are imprinted in it, from phase one (faintest) to phase four (thickest), plus the root (purest); these five are named Keter, Hokhma, Bina, Tiferet, Malkhut."@en ;
    rdf:_1 pmc:KabbalahAshlagAviutShoresh ;
    rdf:_2 pmc:KabbalahAshlagAviutBehinaAlef ;
    rdf:_3 pmc:KabbalahAshlagAviutBehinaBet ;
    rdf:_4 pmc:KabbalahAshlagAviutBehinaGimel ;
    rdf:_5 pmc:KabbalahAshlagAviutBehinaDalet ;
    pm:seriesStatement "Phase four carries five measures of receiving, left in it by the phases that caused it, from the purest root through phases one, two and three to phase four itself, the thickest; each measure has its sense only as a grade of one will, and the five carry the names Keter to Malkhut." ;
    skos:note "Hebrew term in the text: חמש בחינות העביות."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §19, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagAviutShoresh a pm:Conceptualizing ;
    rdfs:label "Root coarseness: the purest measure in phase four, named Keter"@en, "Wurzelgrobheit: das reinste Maß in der vierten Phase, Keter genannt"@de ;
    skos:definition "The root from which the four phases come, held also within phase four as the purest of its five receiving measures; its name is Keter."@en ;
    skos:note "Hebrew term in the text: שורש (shoresh)."@en ;
    skos:note "Written by the integrator as a member of a series the text sets out; see the series node."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §19, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagAviutBehinaAlef a pm:Conceptualizing ;
    rdfs:label "Coarseness of phase one: faintest measure of receiving, named Hokhma"@en, "Grobheit der ersten Phase: schwächstes Maß des Empfangens, Chochma genannt"@de ;
    skos:definition "The thinnest measure of receiving that phase one left imprinted in phase four once it was complete; it bears the name Hokhma."@en ;
    skos:note "Hebrew term in the text: בחינה א' (beḥina alef)."@en ;
    skos:note "Written by the integrator as a member of a series the text sets out; see the series node."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §19, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagAviutBehinaBet a pm:Conceptualizing ;
    rdfs:label "Coarseness of phase two, named Bina"@en, "Grobheit der zweiten Phase, Bina genannt"@de ;
    skos:definition "The measure of receiving from phase two, a little thicker than the one from phase one; it bears the name Bina."@en ;
    skos:note "Hebrew term in the text: בחינה ב' (beḥina bet)."@en ;
    skos:note "Written by the integrator as a member of a series the text sets out; see the series node."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §19, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagAviutBehinaGimel a pm:Conceptualizing ;
    rdfs:label "Coarseness of phase three, named Tiferet"@en, "Grobheit der dritten Phase, Tiferet genannt"@de ;
    skos:definition "The measure of receiving from phase three, thicker again than that of phase two; it bears the name Tiferet."@en ;
    skos:note "Hebrew term in the text: בחינה ג' (beḥina gimel)."@en ;
    skos:note "Written by the integrator as a member of a series the text sets out; see the series node."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §19, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagAviutBehinaDalet a pm:Conceptualizing ;
    rdfs:label "Coarseness of phase four: the thickest, complete measure, named Malkhut"@en, "Grobheit der vierten Phase: das dichteste, vollständige Maß, Malchut genannt"@de ;
    skos:definition "Phase four in its own right, the thickest of the five measures, in which receiving is complete in all it contains; it bears the name Malkhut."@en ;
    skos:note "Hebrew term in the text: בחינה ד' (beḥina dalet)."@en ;
    skos:note "Written by the integrator as a member of a series the text sets out; see the series node."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §19, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §20
#

pmc:KabbalahAshlagHalbashatSefirotQodemTzimtzum a pm:Conceptualizing ;
    rdfs:label "Before restriction each level clothed its corresponding sefira"@en, "Vor Zimzum bekleidete jeder Grad seine Sefira"@de ;
    skos:definition "Before the restriction, when phase four was the vessel for all ten sefirot (the unity of Him with His Name), each of its five levels clothed the matching light of Keter, Hokhma, Bina, Tiferet, Malkhut; hence the five levels of coarseness keep those names after the restriction."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §20, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §21
#

pmc:KabbalahAshlagMasakhMeakkevOr a pm:Conceptualizing ;
    rdfs:label "Screen withholds all light due to Malkhut"@en, "Schirm hält alles Licht für Malchut zurück"@de ;
    skos:definition "The screen lets no upper light pass to Malkhut; whatever light is fit to clothe in Malkhut it holds back and returns; the five levels of coarseness of phase four are joined to the screen's hardness."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §21, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagHameshQomot a pm:Systematizing ;
    rdfs:label "Five couplings and their statures"@en, "Fünf Paarungen und ihre Statur"@de ;
    skos:definition "Coupling on a screen with coarseness of phase 4 raises reflected light reaching stature of Keter; phase 3 to Hokhma; phase 2 to Bina; phase 1 to Tiferet; root only to Malkhut, lacking the first nine."@en ;
    pm:compiledBy "Yehuda Leib Ashlag, in the Petiḥa le-Ḥokhmat ha-Qabbala" ;
    dcterms:date "1945"^^xsd:gYear ;
    skos:note "Hebrew term in the text: קומה (qoma)."@en ;
    skos:note "The ordering is the author's: he arranges the Lurianic material he expounds; the date is that of the printing read."@en ;
    skos:note "The five couplings and their statures form a graded order, but the statures are not entered as nodes of their own in this run; the order is kept here as an ordering and the coarseness levels on which they rest stand as the series pmc:KabbalahAshlagHameshBehinotHaAviut."@en ;
    pm:attestedBy pm:compilerInference ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §21, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagShiurQoma a pm:Conceptualizing ;
    rdfs:label "Stature (qoma) of ten sefirot"@en, "Statur (Koma) der zehn Sefirot"@de ;
    skos:definition "The term stature denotes how far the reflected light suffices to clothe upper light's ten sefirot, named by the highest sefira reached."@en ;
    skos:note "Hebrew term in the text: שיעור קומה (shiʿur qoma)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §21, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §22
#

pmc:KabbalahAshlagEinOrBliKli a pm:Conceptualizing ;
    rdfs:label "No light is attained without a vessel"@en, "Kein Licht wird ohne Gefäß erlangt"@de ;
    skos:definition "It is a known rule that no light is attained without a vessel; hence the number of coarseness levels in the screen fixes the number of lights clothed."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §22, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagHameshKelimDeOrHozer a pm:Conceptualizing ;
    rdfs:label "Five vessels of reflected light replace the five vessels of phase four"@en, "Fünf Rücklicht-Gefäße ersetzen die fünf der Stufe 4"@de ;
    skos:definition "The five vessels that before the restriction were in phase four were included after it in the screen's five levels, and with the reflected light they again become five vessels clothing the ten sefirot."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §22, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagQomaLefiAviut a pm:Conceptualizing ;
    rdfs:label "Stature of each partzuf depends exactly on screen's coarseness"@en, "Statur jedes Parzuf hängt genau an der Grobheit"@de ;
    skos:definition "The stature of every partzuf depends with great precision on how much coarseness its screen holds: phase 4 brings Keter, 3 Hokhma, 2 Bina, 1 Tiferet, root Malkhut."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §22, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §24
#

pmc:KabbalahAshlagErekhHafkhiOrotVeKelim a pm:Conceptualizing ;
    rdfs:label "Inverse relation of lights and vessels"@en, "Umgekehrtes Verhältnis von Lichtern und Gefäßen"@de ;
    skos:definition "Lights and vessels always stand in inverse relation: in vessels the higher grow first (Keter first, Malkhut last), so vessels are listed top-down; in lights the lower enter first (nefesh first, yehida last), so lights are listed bottom-up."@en ;
    skos:note "Hebrew term in the text: ערך הפכי בין אורות לכלים."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §24, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagOrotNaRaNHaY a pm:Sequencing ;
    rdfs:label "Lights NRNHY from below upward"@en, "Lichter NRNChJ von unten nach oben"@de ;
    skos:definition "The lights are ordered nefesh (light of Malkhut), ruah (light of Zeʿir Anpin), neshama, haya, yehida, entering from below upward, matched in the end to vessels Malkhut, Tiferet, Bina, Hokhma, Keter."@en ;
    rdf:_1 pmc:KabbalahAshlagOrHaNefesh ;
    rdf:_2 pmc:KabbalahAshlagOrHaRuah ;
    rdf:_3 pmc:KabbalahAshlagOrHaNeshama ;
    rdf:_4 pmc:KabbalahAshlagOrHaHaya ;
    rdf:_5 pmc:KabbalahAshlagOrHaYehida ;
    pm:seriesStatement "The five lights come into a partzuf from below upward, nefesh first and yehida last, while the vessels grow from above downward; where a light stands at any moment follows from how many vessels have grown, so that the order of entry, and not the name of the light, decides its place until all five vessels are present." ;
    skos:note "Hebrew term in the text: נפש רוח נשמה חיה יחידה (NRNḤY)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §24, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagKenisatOrotBeKelim a pm:Conceptualizing ;
    rdfs:label "Stepwise entry: each new vessel admits a new light, others descend"@en, "Stufenweiser Eintritt: jedes neue Gefäß bringt neues Licht"@de ;
    skos:definition "With one vessel (Keter) only nefesh enters and clothes in Keter; with Keter and Hokhma, ruah enters into Keter and nefesh descends to Hokhma; and so on until with five vessels yehida enters and all lights stand in their proper vessels."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §24, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagOrHaNefesh a pm:Conceptualizing ;
    rdfs:label "Nefesh: the light of Malkhut, first to enter"@en, "Nefesch: das Licht der Malchut, das zuerst eintritt"@de ;
    skos:definition "The lowest of the five lights and the first to come into a partzuf. While only the vessel of Keter has grown, nefesh alone enters and clothes itself in Keter; with every further vessel it moves one vessel down, until with five vessels it stands in Malkhut."@en ;
    skos:note "Hebrew term in the text: נפש (nefesh)."@en ;
    skos:note "Written by the integrator as a member of a series the text sets out; see the series node."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §24, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagOrHaRuah a pm:Conceptualizing ;
    rdfs:label "Ruah: the light of Zeʿir Anpin, second to enter"@en, "Ruach: das Licht des Seʿir Anpin, das als zweites eintritt"@de ;
    skos:definition "The second light, entering when the vessels Keter and Hokhma have grown; it then takes Keter while nefesh goes down to Hokhma, and when all five vessels are present it stands in Tiferet."@en ;
    skos:note "Hebrew term in the text: רוח (ruaḥ)."@en ;
    skos:note "Written by the integrator as a member of a series the text sets out; see the series node."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §24, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagOrHaNeshama a pm:Conceptualizing ;
    rdfs:label "Neshama: third light, entering with the vessel of Bina"@en, "Neschama: drittes Licht, mit dem Gefäß der Bina eintretend"@de ;
    skos:definition "The third light, which enters when the vessel of Bina has grown; at first it clothes in Keter and at the end comes to stand in Bina."@en ;
    skos:note "Hebrew term in the text: נשמה (neshama)."@en ;
    skos:note "Written by the integrator as a member of a series the text sets out; see the series node."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §24, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagOrHaHaya a pm:Conceptualizing ;
    rdfs:label "Haya: fourth light, entering with the vessel of Tiferet"@en, "Chaja: viertes Licht, mit dem Gefäß des Tiferet eintretend"@de ;
    skos:definition "The fourth light, which enters when the fourth vessel, Tiferet, has grown; it first takes Keter and at the end stands in Hokhma."@en ;
    skos:note "Hebrew term in the text: חיה (ḥaya)."@en ;
    skos:note "Written by the integrator as a member of a series the text sets out; see the series node."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §24, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagOrHaYehida a pm:Conceptualizing ;
    rdfs:label "Yehida: highest light, entering last"@en, "Jechida: höchstes Licht, das zuletzt eintritt"@de ;
    skos:definition "The highest light, which can enter only after the fifth vessel, Malkhut, has grown; at that moment every light comes into the vessel that belongs to it, yehida into Keter."@en ;
    skos:note "Hebrew term in the text: יחידה (yeḥida)."@en ;
    skos:note "Written by the integrator as a member of a series the text sets out; see the series node."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §24, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §25
#

pmc:KabbalahAshlagOrotShelaBiMqomam a pm:Conceptualizing ;
    rdfs:label "Lights out of place until all five vessels grow"@en, "Lichter am falschen Ort, bis alle fünf Gefäße da sind"@de ;
    skos:definition "Until all five vessels have grown, the lights stand outside their proper places and stand in inverse value: lacking the vessel of Malkhut, yehida is lacking; lacking Tiferet and Malkhut, yehida and haya are lacking."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §25, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagOrHadashBeKeter a pm:Conceptualizing ;
    rdfs:label "New light always clothes in Keter; receive in the purest vessel"@en, "Neues Licht stets in Keter; Empfang im reinsten Gefäß"@de ;
    skos:definition "Every newly arriving light clothes solely in Keter's vessel, since every receiver must receive in its purest vessel; therefore lights already present must descend one degree to vacate Keter for the new light."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §25, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagShemiratErekhHafkhi a pm:Cautioning ;
    rdfs:label "Keep the inverse rule to avoid confusing lights and vessels"@en, "Die Umkehrregel bewahren, um nicht zu verwechseln"@de ;
    skos:definition "The reader is told to keep this rule in hand and always distinguish whether a statement concerns vessels or lights, so as not to be confused, since their relation is always inverse."@en ;
    pm:cautionsAbout pmc:KabbalahAshlagErekhHafkhiOrotVeKelim ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §25, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §26
#

pmc:KabbalahAshlagAdamQadmon a pm:Naming ;
    rdfs:label "Adam Kadmon: five partzufim preceding the four worlds"@en, "Adam Kadmon: fünf Parzufim vor den vier Welten"@de ;
    skos:definition "Adam Kadmon is presented as the set of five partzufim, issued by five kinds of coupling on the restricted Malkhut, which come before Atzilut, Beria, Yetzira and Assiya."@en ;
    pm:nameForm "Adam Qadmon" ;
    pm:nameRole "first structure after the restriction; five partzufim" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §26, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagPartzuf a pm:Conceptualizing ;
    rdfs:label "Every partzuf has head and body"@en, "Jeder Parzuf hat Kopf und Körper"@de ;
    skos:definition "Reflected light rising from below suffices only for roots of vessels (head's ten sefirot); to complete the vessels Malkhut of the head expands downward in the same stature, forming the body; hence two sets of ten sefirot are always distinguished in every partzuf."@en ;
    skos:note "Hebrew term in the text: פרצוף (partzuf)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §26, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §27
#

pmc:KabbalahAshlagGalgalta a pm:Naming ;
    rdfs:label "First partzuf of Adam Kadmon (Galgalta)"@en, "Erster Parzuf des Adam Kadmon (Galgalta)"@de ;
    skos:definition "Right after the first restriction the upper light came to clothe in Malkhut, the screen of phase four repelled it, and reflected light rose to the stature of Keter: ten sefirot of head, then of body; this completes the first partzuf, later named Galgalta."@en ;
    pm:nameForm "Galgalta (partzuf Keter de-AK)" ;
    pm:nameRole "first partzuf of AK, stature Keter, coupling on phase four" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §27, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §28
#

pmc:KabbalahAshlagABDeAdamQadmon a pm:Naming ;
    rdfs:label "AB of Adam Kadmon"@en, "AB des Adam Kadmon"@de ;
    skos:definition "Coupling on a screen of phase-three coarseness only yields stature Hokhma, head and body, with four vessels and four lights (haya to nefesh), lacking yehida; called AB of Adam Kadmon."@en ;
    pm:nameForm "ʿAV de-Adam Qadmon" ;
    pm:nameRole "second partzuf of AK, stature Hokhma" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §28, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagSaGDeAdamQadmon a pm:Naming ;
    rdfs:label "SaG of Adam Kadmon"@en, "SaG des Adam Kadmon"@de ;
    skos:definition "Coupling on phase-two coarseness yields ten sefirot of stature Bina, lacking the vessels of Zeʿir Anpin and Malkhut and the lights haya and yehida; called partzuf SaG."@en ;
    pm:nameForm "SaG de-Adam Qadmon" ;
    pm:nameRole "third partzuf of AK, stature Bina" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §28, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagMaHUBoNDeAdamQadmon a pm:Naming ;
    rdfs:label "MaH and BoN of Adam Kadmon"@en, "MaH und BoN des Adam Kadmon"@de ;
    skos:definition "Coupling on phase-one coarseness yields stature Tiferet with only ruah and nefesh clothed in the vessels Keter and Hokhma; called partzuf MaH and BoN; the reader is reminded of the inverse value of vessels and lights."@en ;
    pm:nameForm "MaH u-BoN de-Adam Qadmon" ;
    pm:nameRole "fourth and fifth partzuf of AK, stature Tiferet/Zeʿir Anpin" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §28, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §29
#

pmc:KabbalahAshlagHameshPartzufeiAdamQadmon a pm:Sequencing ;
    rdfs:label "AK's five partzufim, Galgalta through BoN"@en, "Fünf Parzufim des AK: Galgalta, AB, SaG, MaH, BoN"@de ;
    skos:definition "The five partzufim are ranked downward, every lower one lacking the highest aspect of its upper (AB lacks yehida, SaG also haya, MaH also neshama), as determined by the coarseness of the screen on which each coupling occurs."@en ;
    rdf:_1 pmc:KabbalahAshlagGalgalta ;
    rdf:_2 pmc:KabbalahAshlagABDeAdamQadmon ;
    rdf:_3 pmc:KabbalahAshlagSaGDeAdamQadmon ;
    rdf:_4 pmc:KabbalahAshlagMaHUBoNDeAdamQadmon ;
    pm:seriesStatement "The partzufim of Adam Kadmon descend in rank, Galgalta, AB, SaG, then MaH and BoN, each born from the purified body-screen of the one above and each missing the highest light of that upper one, so that the stature of a partzuf is set by its place in the line." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §29, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §30
#

pmc:KabbalahAshlagHishtalshelutPresupposesHizdakkekhutHaMasakh a pm:Presupposing ;
    rdfs:label "Purification of the screen before the cascade of degrees"@en, "Läuterung des Schirms vor der Stufenfolge"@de ;
    skos:definition "To understand the descent of degrees in five statures, in AK and in the five partzufim of every world down to Malkhut of Assiya, one must first understand well the purification of the screen of the body in every partzuf of AK, of Nekudim and of the corrected world."@en ;
    pm:dependentStep pmc:KabbalahAshlagHameshPartzufeiAdamQadmon ;
    pm:priorStep pmc:KabbalahAshlagHizdakkekhutHaMasakh ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    skos:note "Entered at prescribed order: the text says this must be understood first but names no consequence of skipping it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §30, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagHizdakkekhutHaMasakh a pm:Conceptualizing ;
    rdfs:label "Purification of the screen (hizdakkekhut ha-masakh)"@en, "Läuterung des Schirms (Hisdakchut ha-Masach)"@de ;
    skos:definition "Purification of the screen of the body is the mechanism by which each partzuf is emanated from the one before it."@en ;
    skos:note "Hebrew term in the text: הזדככות המסך (hizdakkekhut ha-masakh)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §30, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §31
#

pmc:KabbalahAshlagOrMaqifVeOrPenimi a pm:Conceptualizing ;
    rdfs:label "Surrounding light and inner light"@en, "Umgebendes und inneres Licht"@de ;
    skos:definition "Every partzuf or degree has two lights, the surrounding light (or makif) and the inner light (or pnimi)."@en ;
    skos:note "Hebrew term in the text: אור מקיף / אור פנימי (or maqif / or penimi)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §31, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagMalkhutHaMesayyemet a pm:Conceptualizing ;
    rdfs:label "AK bounded above-below: light ends at this world's point"@en, "AK begrenzt: Licht endet am Punkt dieser Welt"@de ;
    skos:definition "The extension of Infinite light into AK does not fill all reality as before the restriction but has a head and an end; in the downward direction its light halts at this world's point, the ending Malkhut."@en ;
    skos:note "Hebrew term in the text: מלכות המסיימת (malkhut ha-mesayyemet)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §31, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagMohaAtzamotGidinBasarVeOr a pm:Conceptualizing ;
    rdfs:label "Ten sefirot from inside out: brain, bones, sinews, flesh, skin"@en, "Zehn Sefirot von innen nach außen"@de ;
    skos:definition "Just as ten sefirot run from above downward, ten sefirot run from inside outward, termed brain, bones, sinews, flesh, skin; the skin (Malkhut) ends the partzuf on the outside."@en ;
    skos:note "Hebrew term in the text: מוחא עצמות גידין בשר ועור."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §31, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagQavDaq a pm:Conceptualizing ;
    rdfs:label "AK as a thin line; inner light versus surrounding light"@en, "AK als dünne Linie; inneres und umgebendes Licht"@de ;
    skos:definition "Relative to the Infinite filling all reality, AK is only like a thin line standing at the centre of the restricted vacant space; the light received is inner light, and the whole great difference from the pre-restriction Infinite light is the surrounding light, which cannot clothe inside the partzuf."@en ;
    skos:note "Hebrew term in the text: קו דק (qav daq)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §31, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §32
#

pmc:KabbalahAshlagEinSofEinoOrMaqif a pm:Cautioning ;
    rdfs:label "Not the Infinite itself is the surrounding light"@en, "Nicht das Unendliche selbst ist das umgebende Licht"@de ;
    skos:definition "The reader is warned not to understand that the Infinite filling reality is itself AK's surrounding light; rather it is the measure repelled by the screen, which the upper light would have clothed in phase four but for the screen."@en ;
    pm:cautionsAbout pmc:KabbalahAshlagQavDaq ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §32, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagEinShinuiBeRuhani a pm:Conceptualizing ;
    rdfs:label "Nothing spiritual changes or vanishes"@en, "Kein Wechsel und kein Verschwinden im Geistigen"@de ;
    skos:definition "Since nothing in the spiritual changes or vanishes, the Infinite's extension to clothe phase four must still be fulfilled; the screen's repelling does not contradict it but fulfils it otherwise, through many couplings across AK and ABYA."@en ;
    skos:note "Hebrew term in the text: אין שינוי והעדר ברוחני."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §32, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagGmarHaTiqqun a pm:Conceptualizing ;
    rdfs:label "Final correction (gmar ha-tikkun)"@en, "Ende der Korrektur (Gmar ha-Tikkun)"@de ;
    skos:definition "The process continues until the final correction, when phase four will be corrected in full completeness by the couplings and then the Infinite will clothe in it as at first."@en ;
    skos:note "Hebrew term in the text: גמר התיקון (gmar ha-tiqqun)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §32, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagOrMaqifAtidLehitlabesh a pm:Conceptualizing ;
    rdfs:label "Surrounding light as destined future clothing"@en, "Umgebendes Licht als künftige Einkleidung"@de ;
    skos:definition "Until then the Infinite light is surrounding light: it is destined to clothe later, and meanwhile shines from outside with a certain illumination that disposes the partzuf to expand by the laws that will bring it to receive that light."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §32, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §33
#

pmc:KabbalahAshlagBitush a pm:Conceptualizing ;
    rdfs:label "Striking (bitush) of inner and surrounding light"@en, "Stoß (Bitusch) von innerem und umgebendem Licht"@de ;
    skos:definition "Because the two lights are opposite and both tied to the screen at the mouth (pe) of the head, they strike each other; this striking brings purification of the screen and loss of its last level of coarseness. The screen at the mouth causes inner and surrounding light alike."@en ;
    skos:note "Hebrew term in the text: ביטוש אור מקיף באור פנימי (bitush)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §33, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §34
#

pmc:KabbalahAshlagBitushBeGufBilvad a pm:Conceptualizing ;
    rdfs:label "Striking occurs only in the body, not in the head"@en, "Stoß nur im Körper, nicht im Kopf"@de ;
    skos:definition "The striking takes place only in the body, where light is clothed in vessels and surrounding light is left outside; in the head reflected light counts only as fine roots, the light there is not bounded inner light, so no striking applies."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §34, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §35
#

pmc:KabbalahAshlagAliyatHaMasakhLePe a pm:Conceptualizing ;
    rdfs:label "Purified screen ascends to the head's mouth"@en, "Geläuterter Schirm steigt zum Mund des Kopfes"@de ;
    skos:definition "The striking goes on until the screen is cleansed by the surrounding light of all its downward coarseness, leaving only the root equal to the screen at the mouth; by equivalence of form it becomes one with that screen, which is called the screen of the body ascending to the mouth."@en ;
    skos:note "Hebrew term in the text: עליית המסך לפה דראש."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §35, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagHashvaatHaTzuraMeyahedet a pm:Conceptualizing ;
    rdfs:label "Equivalence of form makes spiritual entities one"@en, "Formgleichheit macht Geistiges eins"@de ;
    skos:definition "Equivalence of form is known to join spiritual entities into one; nothing then divides the two screens."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §35, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagBenVeToldah a pm:Conceptualizing ;
    rdfs:label "New coupling yields an offspring partzuf (son)"@en, "Neue Paarung bringt einen Sohn-Parzuf hervor"@de ;
    skos:definition "Included again in the coupling at the mouth, the ascended screen undergoes a fresh striking coupling, and a new stature of ten sefirot emerges (AB from the first, SaG from AB, and so on), regarded as son and offspring of the preceding partzuf."@en ;
    skos:note "Hebrew term in the text: בן ותולדה (ben ve-toldah)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §35, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §38
#

pmc:KabbalahAshlagShteiMalkhuyot a pm:Conceptualizing ;
    rdfs:label "Two Malkhuts: coupling Malkhut and ending Malkhut"@en, "Zwei Malchuts: paarende und abschließende"@de ;
    skos:definition "In a partzuf there are two kinds of Malkhut: the coupling one, which by its screen couples with upper light, and the ending one, which by its screen ends the upper light in the body's ten sefirot; they differ as Emanator from emanated."@en ;
    skos:note "Hebrew term in the text: מלכות המזדווגת / מלכות המסיימת."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §38, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagKoahHaTzimtzumBeMasakhDeGuf a pm:Conceptualizing ;
    rdfs:label "Force of restriction revealed only in the ending screen"@en, "Kraft der Begrenzung nur im abschließenden Schirm"@de ;
    skos:definition "The head's Malkhut counts as Emanator to the body since its screen draws and clothes light; all the force of restriction and limit appears only in the screen and Malkhut of the body, so striking happens only there."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §38, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §39
#

pmc:KabbalahAshlagReshimot a pm:Conceptualizing ;
    rdfs:label "Reshimot: residual records left in the screen"@en, "Reschimot: im Schirm zurückbleibende Aufzeichnungen"@de ;
    skos:definition "After purification only fine residues (reshimot) of the body's coarseness remain in the screen, matching the head-screen's coarseness."@en ;
    skos:note "Hebrew term in the text: רשימות (reshimot)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §39, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagHithadshutHaReshimot a pm:Conceptualizing ;
    rdfs:label "Renewed reshimot of the body force descent below the upper's mouth"@en, "Erneuerte Reschimot zwingen zum Abstieg unter den Mund"@de ;
    skos:definition "With the new coupling the reshimot of the body's coarseness are renewed in the screen; the disparity of form reappears, separates it from the upper's mouth and obliges it to descend below; even the new head counts as body relative to the upper, so they are two separate bodies, the new one a branch of the old."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §39, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §40
#

pmc:KabbalahAshlagAvidatBehinaAharona a pm:Conceptualizing ;
    rdfs:label "Striking always loses the last level of coarseness"@en, "Stoß verliert stets den letzten Grobheitsgrad"@de ;
    skos:definition "The striking by its nature makes the screen lose its last level of coarseness entirely, not even a reshimo of it remaining; therefore every lower partzuf is missing the highest light and lowest vessel of its upper and is a separate partzuf by this disparity."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §40, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §42
#

pmc:KabbalahAshlagReshimoDeAviutVeDeHitlabshut a pm:Conceptualizing ;
    rdfs:label "Reshimo of coarseness and reshimo of clothing"@en, "Reschimo der Grobheit und Reschimo der Einkleidung"@de ;
    skos:definition "Residues left in the screen are of two kinds: reshimo of coarseness and reshimo of clothing; purification loses only the coarseness reshimo of the last level, while its clothing reshimo, a very pure aspect insufficient for coupling, remains."@en ;
    skos:note "Hebrew term in the text: רשימו דעביות / רשימו דהתלבשות (reshimo de-ʿaviut / de-hitlabshut)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §42, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §43
#

pmc:KabbalahAshlagZakharUNeqeva a pm:Conceptualizing ;
    rdfs:label "Male and female statures in every head"@en, "Männliche und weibliche Statur in jedem Kopf"@de ;
    skos:definition "The remaining clothing reshimo causes two statures, male and female, within the heads of all partzufim from AB onward and in all of Atzilut."@en ;
    skos:note "Hebrew term in the text: זכר ונקבה (zakhar u-neqeva)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §43, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagHitkallelutHaNeqevaBaZakhar a pm:Conceptualizing ;
    rdfs:label "Inclusion of female in male: stature near Keter"@en, "Einschluss des Weiblichen im Männlichen"@de ;
    skos:definition "In AB the clothing reshimo of phase four, too pure to couple alone, joins the coarseness reshimo of phase three and gains power to couple, giving ten sefirot close to Keter; the coarseness reshimo is called female (bearer of coarseness), the clothing reshimo male (from a higher stature, pure)."@en ;
    skos:note "Hebrew term in the text: התכללות הנקבה בזכר."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §43, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §44
#

pmc:KabbalahAshlagHitkallelutHaZakharBaNeqeva a pm:Conceptualizing ;
    rdfs:label "Inclusion of male in female: stature of the female"@en, "Einschluss des Männlichen im Weiblichen"@de ;
    skos:definition "Then the clothing reshimo is included in the coarseness reshimo and a coupling yields only the female stature, phase three, Hokhma."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §44, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

pmc:KabbalahAshlagQomatZakharRoshBliGuf a pm:Conceptualizing ;
    rdfs:label "Male stature is head without body; partzuf named after female"@en, "Männliche Statur ist Kopf ohne Körper"@de ;
    skos:definition "Coarseness obtained by inclusion suffices to produce a head but not to expand into vessels; so the male stature is only head without body, the body comes from the female stature with its own coarseness, and the partzuf is named after the female since a partzuf's essence is its body."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §44, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §45
#

pmc:KabbalahAshlagYisraelSavaUTevuna a pm:Naming ;
    rdfs:label "Yisrael Sava ve-Tevuna (male stature of MaH)"@en, "Jisrael Saba we-Tewuna"@de ;
    skos:definition "In MaH of AK the male stature, near Bina, from the clothing reshimo of phase two included with phase-one coarseness, bears the name the stature of Yisrael Sava and Tevuna; the female is stature Zeʿir Anpin, and the partzuf is called MaH or six extremities."@en ;
    pm:nameForm "Yisraʾel Sava u-Tevuna" ;
    pm:nameRole "male stature (head without body) in MaH of AK" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §45, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Steinhart 2023 (§1-45), Bnei Baruch" .

#
# §46
#

pmc:KabbalahAshlagHistalkutOrotHaGuf a pm:Conceptualizing ;
    rdfs:label "Striking purifies the body's screen and all body lights depart"@en, "Stoß läutert den Schirm, alle Körperlichter ziehen ab"@de ;
    skos:definition "After a partzuf expands into a body, the striking of surrounding on inner light purifies the screen of the body and all the lights of the body depart; screen and reshimot ascend to the mouth for a new coupling."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that does not come about or is lost, and its cause. It names how pmc:KabbalahAshlagGalgalta fails or is lost."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §46, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §47
#

pmc:KabbalahAshlagHizdakkekhutMadregaAharMadrega a pm:Conceptualizing ;
    rdfs:label "Screen purifies gradually, upper light couples at every stage"@en, "Schirm läutert sich stufenweise, Licht paart jede Stufe"@de ;
    skos:definition "The screen does not purify at once but level by level, from phase four to three, two, one and root; the upper light never stops shining and couples with it in each successive state, producing successive statures Hokhma, Bina, Zeʿir Anpin and Malkhut as each preceding one departs. Stated as a general rule for all degrees."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §47, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §48
#

pmc:KabbalahAshlagEinMiqtzatBeRuhani a pm:Conceptualizing ;
    rdfs:label "Once purification begins, it is complete"@en, "Sobald Läuterung beginnt, ist sie vollständig"@de ;
    skos:definition "As soon as the striking purified the body's screen from phase four, it is reckoned as wholly purified, since there is no partial in the spiritual; once begun it must purify completely, so the force of departure is mixed into all later statures."@en ;
    skos:note "Hebrew term in the text: אין מקצת ברוחני."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that does not come about or is lost, and its cause."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §48, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagNequdot a pm:Conceptualizing ;
    rdfs:label "Statures during purification as points, reflected light and judgment"@en, "Staturen während der Läuterung als Punkte und Gericht"@de ;
    skos:definition "The statures emerging during purification are not true expansions of degrees but aspects of points (nekudot), termed reflected light and din (judgment), because the judgment-force of the lights' departure is already mixed in them."@en ;
    skos:note "Hebrew term in the text: נקודות / דין (nequdot / din)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §48, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §49
#

pmc:KabbalahAshlagTeamimNequdotTaginOtiyot a pm:Sequencing ;
    rdfs:label "Four kinds of lights: taamim, nekudot, tagin, otiyot"@en, "Vier Lichtarten: Teamim, Nekudot, Tagin, Otiot"@de ;
    skos:definition "The first stature in each partzuf is taamim; statures emerging after purification begins are nekudot; reshimot left from taamim lights are tagin; reshimot left from nekudot are otiyot, i.e. vessels. Present in all five partzufim."@en ;
    rdf:_1 pmc:KabbalahAshlagTeamim ;
    rdf:_2 pmc:KabbalahAshlagNequdot ;
    rdf:_3 pmc:KabbalahAshlagTagin ;
    rdf:_4 pmc:KabbalahAshlagOtiyot ;
    pm:seriesStatement "Taamim, nekudot, tagin and otiyot are four kinds of light in a fixed order in every partzuf: the first stature, the statures during purification, what remains of the first, what remains of the second. The last two are named by what they are left over from, and the order holds in all five partzufim." ;
    skos:note "Hebrew term in the text: טעמים נקודות תגין אותיות (TaNTA)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §49, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagTagin a pm:Conceptualizing ;
    rdfs:label "Tagin hover over the letters and sustain them"@en, "Tagin schweben über den Buchstaben und erhalten sie"@de ;
    skos:definition "The tagin, residues of the taamim lights, hover over the letters (vessels) and sustain them."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §49, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagTeamim a pm:Conceptualizing ;
    rdfs:label "Taamim: the first stature of each partzuf"@en, "Teamim: die erste Statur jedes Parzufs"@de ;
    skos:definition "The stature that comes out first in each of the five partzufim Galgalta, AB, SaG, MaH and BoN, before its screen has begun to purify."@en ;
    skos:note "Hebrew term in the text: טעמים (teʿamim)."@en ;
    skos:note "Written by the integrator as a member of a series the text sets out; see the series node."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §49, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagOtiyot a pm:Conceptualizing ;
    rdfs:label "Otiyot: the residues of the nekudot lights, which are vessels"@en, "Otijot: die Reste der Nekudot-Lichter, welche Gefäße sind"@de ;
    skos:definition "What is left behind by the lights of the nekudot statures after they have gone; the text calls these letters and identifies them with the vessels."@en ;
    skos:note "Hebrew term in the text: אותיות (otiyot)."@en ;
    skos:note "Written by the integrator as a member of a series the text sets out; see the series node."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §49, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §50
#

pmc:KabbalahAshlagRoshTokhSof a pm:Systematizing ;
    rdfs:label "Head, interior, end (rosh, tokh, sof) of each partzuf"@en, "Kopf, Inneres, Ende jedes Parzuf"@de ;
    skos:definition "Each partzuf has ten sefirot of head (roots only, above the coupling Malkhut), ten of interior from mouth to navel where lights clothe in vessels, and ten of end from navel to the ending of the toes, where Malkhut ends each sefira until itself, unfit for any light; below is vacant space."@en ;
    pm:compiledBy "Yehuda Leib Ashlag, in the Petiḥa le-Ḥokhmat ha-Qabbala" ;
    dcterms:date "1945"^^xsd:gYear ;
    skos:note "Hebrew term in the text: ראש תוך סוף (RaTaS) / טבור / סיום אצבעות רגלין."@en ;
    skos:note "The ordering is the author's: he arranges the Lurianic material he expounds; the date is that of the printing read."@en ;
    skos:note "Head, interior and end are entered as an ordering and not as a series because the three parts are not entered as nodes of their own in this run; pmc:KabbalahAshlagRoshVeGuf and pmc:KabbalahAshlagKoahHalbashaVeKoahAkkava carry part of them."@en ;
    pm:attestedBy pm:compilerInference ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §50, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagKoahHalbashaVeKoahAkkava a pm:Conceptualizing ;
    rdfs:label "Clothing force acts in interior, withholding force in end"@en, "Einkleidungskraft im Inneren, Hemmkraft im Ende"@de ;
    skos:definition "The coupling Malkhut holds two root forces: clothing (rising reflected light) and withholding (the screen preventing Malkhut from receiving); descending, the first is realised in the interior from mouth to navel, called HGT, the second in the end below the navel, called NHYM."@en ;
    skos:note "Hebrew term in the text: חג\"ת / נהי\"מ."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §50, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §51
#

pmc:KabbalahAshlagTzimtzumAlHokhmaBilvad a pm:Conceptualizing ;
    rdfs:label "Restriction applied only to Hokhma, not to Hasadim"@en, "Einschränkung nur auf Chochma, nicht auf Chassadim"@de ;
    skos:definition "The restriction concerned only the light of Hokhma, whose vessel is the receptive will completed in phase four; on Hasadim there was no restriction, since its vessel is the bestowing will, with freedom from coarseness and from disparity of form, needing no corrections."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §51, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagShevirahBeOrHasadim a pm:Conceptualizing ;
    rdfs:label "Hasadim spreading where Hokhma cannot would break the upper light"@en, "Chassadim ohne Chochma würden das obere Licht brechen"@de ;
    skos:definition "Because Hokhma and Hasadim are one bound light in the upper ten sefirot, Hasadim also stops at Malkhut; had Hasadim spread where Hokhma could not, into the ending Malkhut, a breaking would occur in the upper light, as Hasadim would have to separate wholly from Hokhma; hence the ending Malkhut became vacant even of Hasadim."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that does not come about or is lost, and its cause."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §51, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §52
#

pmc:KabbalahAshlagVavQetzavotBliRosh a pm:Conceptualizing ;
    rdfs:label "Six extremities without head (VaK bli rosh)"@en, "Sechs Enden ohne Kopf (WaK bli Rosch)"@de ;
    skos:definition "The ten sefirot of the end below the navel cannot be Hasadim alone since Hasadim never fully separates from Hokhma; they hold a slight illumination of Hokhma, which is always called six extremities without head."@en ;
    skos:note "Hebrew term in the text: ו\"ק בלי ראש (vav qetzavot beli rosh)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §52, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §53
#

pmc:KabbalahAshlagHaze a pm:Conceptualizing ;
    rdfs:label "Lower partzuf attaches at the chest of the upper"@en, "Unterer Parzuf haftet an der Brust des oberen"@de ;
    skos:definition "The new partzuf's screen should have descended to the upper's navel, its root, but having lost the last coarseness level it retains only phase three, which is called chest (haze); so its coupling Malkhut is rooted only at the upper's chest, attached like branch to root."@en ;
    skos:note "Hebrew term in the text: חזה (ḥaze)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §53, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §54
#

pmc:KabbalahAshlagABMalbishGalgalta a pm:Conceptualizing ;
    rdfs:label "AB clothes Galgalta from mouth to navel"@en, "AB bekleidet Galgalta vom Mund bis zum Nabel"@de ;
    skos:definition "The new screen at the upper's chest raises a head up to the upper's mouth (never clothing the upper's head, being from its body) and spreads a body down only to the upper's navel, since it has no hold in the upper's last phase; so the chest of the first partzuf is AB's mouth and its navel is AB's ending."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §54, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §55
#

pmc:KabbalahAshlagKlalYetziatPartzufim a pm:Conceptualizing ;
    rdfs:label "General rule of partzuf emergence and clothing"@en, "Allgemeine Regel des Hervorgehens und Einkleidens"@de ;
    skos:definition "Every lower partzuf down to the end of Assiya emerges from the purified body-screen of its upper, included in the coupling at the upper's head, then descends to its place of attachment and there produces head and body; differences exist only in how partzufim end."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §55, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §56
#

pmc:KabbalahAshlagTzimtzumNHYDeAK a pm:Conceptualizing ;
    rdfs:label "Restriction of NHY of AK"@en, "Einschränkung von NHJ des AK"@de ;
    skos:definition "The second restriction is also named restriction of AK's NHY, because by the new ending above the navel, at half Tiferet, the TNHY of SaG were emptied of upper light into vacant space."@en ;
    skos:note "Hebrew term in the text: צמצום נה\"י דא\"ק."@en ;
    skos:note "The name stands also as the heading of §56, which opens the account of the second restriction."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §§56 and 60, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §57
#

pmc:KabbalahAshlagEinShoreshLeABYABeAK a pm:Conceptualizing ;
    rdfs:label "No root yet of the four worlds or of the intended correction in Galgalta, AB, SaG"@en, "Noch keine Wurzel der vier Welten in Galgalta, AB, SaG"@de ;
    skos:definition "In AK's first three partzufim not even a place exists for Beria, Yetzira and Assiya, since the inner AK reached this world's point, nor any root of the correction for whose sake the restriction occurred."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §57, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagTakhlitHaTzimtzum a pm:Conceptualizing ;
    rdfs:label "Purpose of the restriction: man turning receiving into bestowal"@en, "Zweck der Einschränkung: Mensch wandelt Empfangen in Geben"@de ;
    skos:definition "The whole aim of the restriction on phase four was its correction, so that receiving light involves no disparity of form: a human body is to be created from phase four and, by Torah and commandments for the Maker's sake, turn its receiving force into receiving for bestowal; that is the final correction, phase four again the vessel in complete adhesion."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §57, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagDevekutGmuraImHaOr a pm:Conceptualizing ;
    rdfs:label "Complete adhesion with the light while receiving"@en, "Vollkommene Anhaftung an das Licht beim Empfangen"@de ;
    skos:definition "Phase four becomes again a receiving vessel for upper light and is at the same time in complete adhesion with it, without any disparity of form: the state called final correction."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §57, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagTorahUMitzvotHipukhHaQabbala a pm:Yielding ;
    rdfs:label "Torah and commandments for the Maker turn receiving into bestowal"@en, "Tora und Gebote wandeln Empfangen in Geben"@de ;
    skos:definition "Engagement in Torah and commandments with intention to give contentment to the Maker is said to invert the receiving force of phase four into bestowal, which equalises receiving with complete bestowal."@en ;
    pm:byPractice pmp:KabbalahAshlagTorahUMitzvotAlMenatLeHashpia ;
    pm:yieldsCapacity pmc:KabbalahAshlagQabbalaAlMenatLeHashpia, pmc:KabbalahAshlagDevekutGmuraImHaOr ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §57, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagHashpaaPresupposesBehinotElyonot a pm:Presupposing ;
    rdfs:label "Man must include higher phases to do deeds of bestowal"@en, "Mensch muss höhere Stufen enthalten, um gebend zu handeln"@de ;
    skos:definition "For this correction man must also be composed of the phases higher than phase four in order to have the capacity for good deeds of bestowal."@en ;
    pm:dependentStep pmc:KabbalahAshlagTorahUMitzvotHipukhHaQabbala ;
    pm:priorStep pmc:KabbalahAshlagBehinaBetBina ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Created only from the vacant space he could not correct his deeds at all, having no spark of bestowal, like beasts." ;
    skos:note "The text speaks of the phases above phase four; the bestowing will of phase two is the first of them to carry bestowal, and is taken as the prior step. Section 58 names the means, the sharing of mercy with judgment, entered at pmc:KabbalahAshlagHashpaaPresupposesShittuf."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §57, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagMetimBeHayeihem a pm:Conceptualizing ;
    rdfs:label "Life wholly for oneself: beasts and the wicked, dead while alive"@en, "Leben nur für sich: Tiere und Frevler, tot im Leben"@de ;
    skos:definition "Without sparks of bestowal man would be like beasts whose whole life is for themselves, or like the wicked sunk in craving to receive for themselves, who even do their kindness for their own sake; they are called dead in their lifetime, being opposite in form to the Life of lives."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that does not come about or is lost, and its cause. It names how pmc:KabbalahAshlagTorahUMitzvotHipukhHaQabbala fails or is lost."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §57, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §58
#

pmc:KabbalahAshlagQodemVeAharSibaVeMesovav a pm:Cautioning ;
    rdfs:label "\"First\" and \"afterwards\" in spiritual matters mean cause and effect"@en, "Zuerst und danach heißt im Geistigen Ursache und Wirkung"@de ;
    skos:definition "The reader is warned that temporal sequence stated of spiritual matters denotes cause and effect, not time."@en ;
    pm:cautionsAbout pmc:KabbalahAshlagShittufMiddatHaRahamimBaDin ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §58, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagShittufMiddatHaRahamimBaDin a pm:Conceptualizing ;
    rdfs:label "Association of the quality of mercy with judgment"@en, "Verbindung der Barmherzigkeit mit dem Gericht"@de ;
    skos:definition "The rabbinic saying that God first thought to create the world with judgment, saw it could not endure, and joined mercy to it, is read thus: AK was emanated with Malkhut alone (judgment, the restricted phase four); since man from phase four could not acquire deeds of bestowal, the Emanator raised the ending force of Malkhut into Bina (mercy) so that phase four includes sparks of bestowal."@en ;
    skos:note "Hebrew term in the text: מדת הדין / מדת הרחמים / שיתוף (middat ha-din / ha-raḥamim / shittuf)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §58, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagHashpaaPresupposesShittuf a pm:Presupposing ;
    rdfs:label "Association of Malkhut in Bina before man can bestow"@en, "Verbindung Malchut-Bina vor dem gebenden Menschen"@de ;
    skos:definition "Through the association, the human body issuing from phase four also contains the quality of bestowal, which is the preparation enabling him to do good deeds for the Maker until all his receiving becomes for bestowal."@en ;
    pm:dependentStep pmc:KabbalahAshlagTorahUMitzvotHipukhHaQabbala ;
    pm:priorStep pmc:KabbalahAshlagShittufMiddatHaRahamimBaDin ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "The world would not endure in the intended correction." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §58, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §59
#

pmc:KabbalahAshlagTzimtzumBet a pm:Conceptualizing ;
    rdfs:label "Second restriction in SaG: new ending at Bina"@en, "Zweite Einschränkung im SaG: neues Ende bei Bina"@de ;
    skos:definition "The association occurred in AK's partzuf SaG and caused the second restriction in the worlds below it: the ending Malkhut rose from SaG's feet to half of Bina of its body (Tiferet), and the coupling Malkhut rose from the mouth to the nostrils of the eyes (half Bina of the head), where the coupling for MaH, the world of Nekudim, took place."@en ;
    skos:note "Hebrew term in the text: צמצום ב' / נקבי עינים (tzimtzum bet / niqvei ʿeinayim)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §59, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §60
#

pmc:KabbalahAshlagAHaP a pm:Conceptualizing ;
    rdfs:label "Ears, nose, mouth (AHP) of SaG's head become body"@en, "Ohren, Nase, Mund des SaG-Kopfes werden Körper"@de ;
    skos:definition "Since the coupling Malkhut rose to the nostrils of the eyes, the head's ten sefirot emerge from there upward, and from there downward counts as body; so the ears, nose and mouth of SaG's head left the head's degree."@en ;
    skos:note "Hebrew term in the text: אח\"פ (AḤaP: ozen ḥotem pe)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §60, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagParsa a pm:Conceptualizing ;
    rdfs:label "Parsa: the new ending at Bina of the body"@en, "Parsa: das neue Ende bei Bina des Körpers"@de ;
    skos:definition "The new ending made where the body's Bina is is called parsa (partition)."@en ;
    skos:note "Hebrew term in the text: פרסא (parsa)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §60, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagOlamHaNequdim a pm:Naming ;
    rdfs:label "World of Nekudim"@en, "Welt der Nekudim"@de ;
    skos:definition "The stature emerging at the nostrils of SaG descended below the inner AK's navel and spread there as head and body; its outer ten sefirot make up the Nekudim world, its internal ones MaH and BoN of AK proper."@en ;
    pm:nameForm "ʿOlam ha-Nequdim" ;
    pm:nameRole "fourth partzuf of AK (MaH), external aspect; emerged by second restriction" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §60, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §62
#

pmc:KabbalahAshlagNequdotDeSaG a pm:Conceptualizing ;
    rdfs:label "Points of SaG descend below the navel by equivalence of form"@en, "Punkte des SaG steigen durch Formgleichheit unter den Nabel"@de ;
    skos:definition "When SaG's screen purified to coarseness of phase one, the points of SaG emerged as six extremities without head, equal in form to the end-sefirot of AK below the navel; since equivalence of form unites, they descended there and mixed with the ZON of AK, functioning as one."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §62, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §63
#

pmc:KabbalahAshlagAviutNikkeretAharHistalkut a pm:Conceptualizing ;
    rdfs:label "Coarseness becomes recognisable only after the light departs"@en, "Grobheit wird erst nach dem Lichtabzug erkennbar"@de ;
    skos:definition "Coarseness is not recognisable in a partzuf while light is clothed in it, only after the light departs; therefore phase two and phase four could mix, causing the second restriction and moving the coupling place to the nostrils of the eyes."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §63, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §64
#

pmc:KabbalahAshlagEinKoahLemalaMiMeqoro a pm:Conceptualizing ;
    rdfs:label "No force can appear above its source"@en, "Keine Kraft erscheint oberhalb ihrer Quelle"@de ;
    skos:definition "Since the association originated only below AK's navel, the Nekudim produced by the second restriction could not spread above the navel, for no force or dominion can be revealed above the place of its origin."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §64, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §65
#

pmc:KabbalahAshlagEinShinuiBeAK a pm:Conceptualizing ;
    rdfs:label "AK itself unchanged: the changes are only raising of MaN"@en, "AK selbst unverändert: nur Aufstieg von MaN"@de ;
    skos:definition "All changes after the second restriction took place solely in the partzuf of SaG's points, not in AK's own TNHY; in AK they count only as raising of feminine waters, i.e. it clothed itself in them to emanate the Nekudim, without any change in itself."@en ;
    skos:note "Functions also as a warning against reading the restriction as alteration of AK."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §65, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §66
#

pmc:KabbalahAshlagMeqomArbaOlamot a pm:Systematizing ;
    rdfs:label "Place of the four worlds within the points of SaG"@en, "Ort der vier Welten in den Punkten des SaG"@de ;
    skos:definition "At the moment of the second restriction the points of SaG divided into four: KHB HGT to its chest = place of Atzilut; two lower thirds of Tiferet = place of Beria; NHY = place of Yetzira; Malkhut = place of Assiya; extending from AK's navel to just above this world's point."@en ;
    pm:compiledBy "Yehuda Leib Ashlag, in the Petiḥa le-Ḥokhmat ha-Qabbala" ;
    dcterms:date "1945"^^xsd:gYear ;
    skos:note "The ordering is the author's: he arranges the Lurianic material he expounds; the date is that of the printing read."@en ;
    skos:note "A correspondence between the four parts of the points of SaG and the places of the four worlds; entered as an ordering."@en ;
    pm:attestedBy pm:compilerInference ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §66, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §67
#

pmc:KabbalahAshlagMeqomAtzilut a pm:Conceptualizing ;
    rdfs:label "Place of Atzilut as place fit for the upper light"@en, "Ort von Azilut als Ort für das obere Licht"@de ;
    skos:definition "The place of Atzilut means the place fit for the expansion of upper light; it ends at half Tiferet on the chest, where the parsa below Atzilut stands."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §67, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagPegamTiferet a pm:Conceptualizing ;
    rdfs:label "Split of Tiferet at the chest; Beria has lesser flaw"@en, "Spaltung des Tiferet an der Brust; Beria geringer beschädigt"@de ;
    skos:definition "Only ZON of the body should have gone below the ending, but the ZON within Bina of the body, being their roots, went out too; so Tiferet split at the chest; its lower two thirds left not on their own account, so their flaw is not great and they became a world of their own, Beria."@en ;
    skos:note "Hebrew term in the text: פגם (pegam)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §67, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §68
#

pmc:KabbalahAshlagPegamMalkhutMeqomAsiya a pm:Conceptualizing ;
    rdfs:label "Malkhut's harsher flaw: place of Assiya; NHY: place of Yetzira"@en, "Malchuts schwererer Makel: Assija; NHJ: Jezira"@de ;
    skos:definition "Of the body's ZON, Malkhut as the feminine has a more severe flaw and becomes the place of Assiya; Zeʿir Anpin (NHY) becomes Yetzira above it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §68, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §71
#

pmc:KabbalahAshlagQatnutVeGadlut a pm:Conceptualizing ;
    rdfs:label "Smallness and greatness (katnut, gadlut) in Nekudim"@en, "Kleinheit und Größe in den Nekudim"@de ;
    skos:definition "The screen of SaG contained two kinds of reshimot, its own and those of AK's ZON below the navel; on its own reshimot the ten sefirot of smallness of Nekudim emerged, on the joined ZON reshimot those of greatness."@en ;
    skos:note "Hebrew term in the text: קטנות / גדלות (qatnut / gadlut)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §71, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §72
#

pmc:KabbalahAshlagQatnutIqar a pm:Conceptualizing ;
    rdfs:label "Smallness is essential; greatness only an addition"@en, "Kleinheit wesentlich, Größe nur Zusatz"@de ;
    skos:definition "The ten sefirot of smallness count as the essence of Nekudim, since they emerged in the order of degrees from the upper's body-screen; those of greatness are only an addition, coming from reshimot joined by the descent below the navel, not in that order."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §72, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §74
#

pmc:KabbalahAshlagKeterDeNequdim a pm:Naming ;
    rdfs:label "Keter of Nekudim"@en, "Keter der Nekudim"@de ;
    skos:definition "From inclusion of the female reshimo (phase one coarseness) in the male (phase two clothing) a stature near Bina, six extremities of Bina, emerges, named the Keter sefira of Nekudim; as male stature it does not spread into body, shining only in the head."@en ;
    pm:nameForm "Keter de-Nequdim" ;
    pm:nameRole "male stature of the head of Nekudim" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §74, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagAbbaVeImmaDeNequdim a pm:Naming ;
    rdfs:label "Abba ve-Imma of Nekudim, back to back"@en, "Abba we-Imma der Nekudim, Rücken an Rücken"@de ;
    skos:definition "When the male is included in the female a stature of Zeʿir Anpin, six extremities without head, emerges, called Abba and Imma of Nekudim back to back; this female stature alone spreads into the body."@en ;
    pm:nameForm "Abba ve-Imma de-Nequdim (aḥor be-aḥor)" ;
    pm:nameRole "female stature of the head of Nekudim, which spreads into the body" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §74, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §75
#

pmc:KabbalahAshlagShaloshMadregotDeNequdim a pm:Sequencing ;
    rdfs:label "Three degrees of Nekudim in smallness: Keter, AVI, seven lower"@en, "Drei Stufen der Nekudim: Keter, AWI, sieben untere"@de ;
    skos:definition "Three degrees stand one beneath another: Keter of Nekudim (six extremities of Bina), Abba ve-Imma (stature Zeʿir Anpin), both head; and the seven lower sefirot HGT NHYM, the body of Nekudim (ZaT)."@en ;
    rdf:_1 pmc:KabbalahAshlagKeterDeNequdim ;
    rdf:_2 pmc:KabbalahAshlagAbbaVeImmaDeNequdim ;
    rdf:_3 pmc:KabbalahAshlagZayinTahtonotDeNequdim ;
    pm:seriesStatement "In smallness the Nekudim stand in three degrees one under the other, Keter, Abba ve-Imma and the seven lower sefirot; the first two are head and the third is body, and front and back vessels are distributed along this order, each degree holding inside it the back vessels of the degree above (§77)." ;
    skos:note "Hebrew term in the text: ז\"ת דנקודים (zayin taḥtonot)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §75, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagZayinTahtonotDeNequdim a pm:Conceptualizing ;
    rdfs:label "The seven lower sefirot of Nekudim: the body below the two head degrees"@en, "Die sieben unteren Sefirot der Nekudim: der Körper unter den beiden Kopfstufen"@de ;
    skos:definition "The third of the three degrees in which the Nekudim stand in smallness: HGT NHYM, which are the body of the Nekudim, set beneath the two degrees that count as head, Keter and Abba ve-Imma."@en ;
    skos:note "Hebrew term in the text: ז\"ת דנקודים (zayin taḥtonot de-nequdim)."@en ;
    skos:note "Written by the integrator as a member of a series the text sets out; see the series node."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §75, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §76
#

pmc:KabbalahAshlagKelimDePanimVeAhorayim a pm:Conceptualizing ;
    rdfs:label "Each degree split into front and back vessels"@en, "Jede Stufe in Vorder- und Rückgefäße gespalten"@de ;
    skos:definition "Because the coupling is at the nostrils of the eyes, the head holds only Keter, Hokhma and upper half of Bina (skull, eyes, nostrils), called front vessels; the AHP (Bina's lower half, ZA, Malkhut) leave the head to the degree below and are called back vessels; every degree split thus."@en ;
    skos:note "Hebrew term in the text: גלגלתא ועינים / כלים דפנים / כלים דאחורים."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §76, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §77
#

pmc:KabbalahAshlagAhorayimDeElyonBeTahton a pm:Conceptualizing ;
    rdfs:label "Each degree holds the back vessels of its upper inside"@en, "Jede Stufe trägt die Rückgefäße der oberen in sich"@de ;
    skos:definition "No degree lacks front and back: the AHP of Keter fell into Abba ve-Imma, those of AVI into the seven lower; each lower degree has in its interior the back vessels of its upper, clothed outside by its own front vessels."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §77, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §78
#

pmc:KabbalahAshlagNefeshRuahBeQatnut a pm:Conceptualizing ;
    rdfs:label "In smallness only nefesh-ruah in each degree"@en, "In der Kleinheit nur Nefesch-Ruach je Stufe"@de ;
    skos:definition "Because the vessels Bina and ZON are missing in each degree, the three upper lights neshama, haya, yehida are missing too; each degree of smallness has only vessels Keter and Hokhma and lights nefesh and ruah."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §78, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §79
#

pmc:KabbalahAshlagAliyyatMayinNuqvin a pm:Conceptualizing ;
    rdfs:label "Raising of feminine waters (MaN)"@en, "Aufstieg der weiblichen Wasser (MaN)"@de ;
    skos:definition "The lights that rose from below AK's navel to the head of SaG, the reshimot of AK's ZON, are called the raising of MaN, a new notion beside the ascent of a purified screen."@en ;
    skos:note "Hebrew term in the text: עלית מיין נוקבין / מ\"ן (ʿaliyyat mayin nuqvin)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §79, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §80
#

pmc:KabbalahAshlagPanimBePanimVeAhorBeAhor a pm:Conceptualizing ;
    rdfs:label "Origin of MaN in Bina and Zeʿir Anpin of direct light"@en, "Ursprung von MaN in Bina und Seir Anpin"@de ;
    skos:definition "When Bina emanated Tiferet it rejoined Hokhma to draw illumination for it; hence whenever the reshimot of Zeʿir Anpin ascend to Bina, Bina joins Hokhma to draw Hokhma for ZA. Without that ascent Bina, being in itself Hasadim and not needing Hokhma, stands back to back with Hokhma; the ascent turns her face to face as female receiving from the male."@en ;
    skos:note "Hebrew term in the text: פנים בפנים / אחור באחור (panim be-fanim / aḥor be-aḥor)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §80, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §81
#

pmc:KabbalahAshlagMohinDeGadlut a pm:Conceptualizing ;
    rdfs:label "Greatness of Nekudim via AB-SaG light"@en, "Größe der Nekudim durch AB-SaG-Licht"@de ;
    skos:definition "The ZON reshimot rising to SaG's head became MaN, so SaG (Bina) coupled with AB (Hokhma); AB gave new light for ZON, which descended below the navel and shone it into the Nekudim: this is the mohin of greatness."@en ;
    skos:note "Hebrew term in the text: מוחין דגדלות (moḥin de-gadlut)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §81, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagMohinDeGadlutShevirah a pm:Conceptualizing ;
    rdfs:label "Mohin of greatness caused the breaking of vessels"@en, "Mochin der Größe verursachten den Bruch der Gefäße"@de ;
    skos:definition "The text states in advance that these mohin of greatness brought about the shattering of the vessels, explained later."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that does not come about or is lost, and its cause. It names how pmc:KabbalahAshlagMohinDeGadlut fails or is lost."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §81, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §82
#

pmc:KabbalahAshlagHearaDeRekhTaburVeYesod a pm:Conceptualizing ;
    rdfs:label "New light reaches Keter via AK's navel, AVI via its Yesod"@en, "Neues Licht über Nabel zu Keter, über Jessod zu AWI"@de ;
    skos:definition "The new light shone first to Keter of Nekudim through AK's navel, where Keter clothes, completing it with upper lights and vessels Bina-ZON; then to Abba ve-Imma through AK's Yesod, where they clothe."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §82, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §83
#

pmc:KabbalahAshlagHaMaqomGorem a pm:Conceptualizing ;
    rdfs:label "\"The place causes\": phase four concealed within Bina"@en, "Der Ort bewirkt: Stufe 4 in Bina verborgen"@de ;
    skos:definition "Although phase four was joined to SaG's screen, its coarseness was hidden within Bina at the nostrils of the eyes, as if absent; so coupling in smallness was only on Bina's own reshimot, yielding six extremities of Bina and full six extremities."@en ;
    skos:note "Hebrew term in the text: המקום גורם (ha-maqom gorem)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §83, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §84
#

pmc:KabbalahAshlagOrABBittulTzimtzumBet a pm:Conceptualizing ;
    rdfs:label "AB light cancels the second restriction in the head of Nekudim"@en, "AB-Licht hebt die zweite Einschränkung im Kopf auf"@de ;
    skos:definition "Since AB has no part in the second restriction, its light reaching the head of Nekudim cancelled it, brought phase four back to the mouth as in the first restriction; AHP returned to their degree, coupling occurred on phase four and the stature of Keter emerged, gaining neshama, haya, yehida and vessels Bina-ZON."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §84, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §85
#

pmc:KabbalahAshlagHeTataa a pm:Conceptualizing ;
    rdfs:label "Shorthand: lower he to nostrils (smallness), AB-SaG light lowering it (greatness)"@en, "Kurzformel: unteres He zu den Nüstern, AB-SaG senkt es"@de ;
    skos:definition "From here the text abbreviates: second restriction and smallness = ascent of the lower he to the nostrils and descent of AHP; greatness = arrival of AB-SaG light lowering the lower he and restoring the AHP. Also HGT to chest correspond to skull-eyes-nostrils (front), lower Tiferet and NHYM to AHP (back)."@en ;
    skos:note "Hebrew term in the text: ה\"ת (he tataʾa) / עלית ה\"ת לנקבי עינים."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §85, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §86
#

pmc:KabbalahAshlagHolamShuruqHiriq a pm:Sequencing ;
    rdfs:label "Three vowel points: holam, shuruk, hiriq"@en, "Drei Vokalpunkte: Cholam, Schuruk, Chirik"@de ;
    skos:definition "The points divide as head, interior, end: upper points above the letters (holam), middle points within the letters (shuruk or melafom, a vav with a dot), lower points beneath the letters (hiriq)."@en ;
    rdf:_1 pmc:KabbalahAshlagHolam ;
    rdf:_2 pmc:KabbalahAshlagShuruq ;
    rdf:_3 pmc:KabbalahAshlagHiriq ;
    pm:seriesStatement "The three points stand as head, interior and end of the letters, holam above, shuruq within, hiriq beneath, and each names by its place a route of the new light relative to the vessels: holam through the navel to Keter without spreading into the body, shuruq through the Yesod to Abba ve-Imma and with them into the body, hiriq the light that the seven lower sefirot take in themselves." ;
    skos:note "Hebrew term in the text: חולם שורק חירק (ḥolam shuruq ḥiriq)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §86, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §87
#

pmc:KabbalahAshlagOtiyotVeNequdot a pm:Conceptualizing ;
    rdfs:label "Letters as vessels, points as lights moving them"@en, "Buchstaben als Gefäße, Punkte als bewegende Lichter"@de ;
    skos:definition "Letters mean vessels, the sefirot of the body; points mean lights that vivify and move the vessels, i.e. the light of Hokhma (haya), the new AB-SaG light that lowers the lower he and raises the AHP back to their degree."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §87, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §88
#

pmc:KabbalahAshlagHolam a pm:Conceptualizing ;
    rdfs:label "Holam: illumination via the navel to Keter of Nekudim"@en, "Cholam: Erleuchtung über den Nabel zu Keter"@de ;
    skos:definition "Illumination through AK's navel reaches only Keter of Nekudim, the male stature that does not spread to the body (letters); hence it shines from above them and is called holam. Illumination through Yesod reaches Abba ve-Imma, whose lights also spread into the body, and is called shuruk, a dot inside the row of letters."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §88, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagShuruq a pm:Conceptualizing ;
    rdfs:label "Shuruq: the new light through the Yesod of AK to Abba ve-Imma and into the body"@en, "Schuruq: das neue Licht durch das Jesod des AK zu Abba ve-Imma und in den Körper"@de ;
    skos:definition "The illumination of the new light that passes through the Yesod of AK to Abba ve-Imma of Nekudim, brings their lower he down from the nostrils of the eyes to the mouth and gives them back their AHP. Because these mohin reach the seven lower sefirot too, which are called letters, the point is written inside the row of letters, as a vav with a dot in it."@en ;
    skos:note "Hebrew term in the text: שורק / מלאפום (shuruq / melafom)."@en ;
    skos:note "Written by the integrator as a member of a series the text sets out; see the series node."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §§88-89, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §90
#

pmc:KabbalahAshlagHiriq a pm:Conceptualizing ;
    rdfs:label "Hiriq: light the seven lower receive to lower the ending he"@en, "Chirik: Licht, das die sieben Unteren zum Senken des Endes erhalten"@de ;
    skos:definition "Hiriq is the new light the seven lower sefirot themselves receive from Abba ve-Imma to bring the ending lower he from their chest down to the end of AK's feet, so that their AHP (the place of BYA) would return and BYA become like Atzilut."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §90, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagShevirahHaKelim a pm:Conceptualizing ;
    rdfs:label "Breaking of the vessels of the seven lower sefirot"@en, "Bruch der Gefäße der sieben unteren Sefirot"@de ;
    skos:definition "The seven lower could not lower the he and cancel the second restriction and parsa: when they drew light into BYA all their vessels broke at once, because the force of the ending he at the parsa was mixed in them; the light had to depart, the vessels shattered, died and dropped into BYA; their front vessels above the parsa broke too, being joined with the back ones in one body."@en ;
    skos:note "Hebrew term in the text: שבירת הכלים (shevirat ha-kelim)."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that does not come about or is lost, and its cause. It names how pmc:KabbalahAshlagHiriq fails or is lost."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §90, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §91
#

pmc:KabbalahAshlagTiqqunHiriq a pm:Conceptualizing ;
    rdfs:label "Correction of hiriq in the world of correction: raising instead of lowering"@en, "Korrektur des Chirik: Heben statt Senken"@de ;
    skos:definition "In the world of correction, when the seven lower of Atzilut receive greatness from Abba ve-Imma, they do not lower the ending he to AK's feet and spread lights down; instead they raise their TNHY from BYA to above the parsa and take the lights there, so that breaking does not recur; thus hiriq serves beneath the letters, at the parsa."@en ;
    skos:note "Correction designed to avoid repeating the failure of A0167."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §91, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §93
#

pmc:KabbalahAshlagAliyatHaTahtonImAHaP a pm:Conceptualizing ;
    rdfs:label "Lower degree attached to upper's AHP rises with them and becomes like the upper"@en, "Untere Stufe steigt mit den AChP und wird wie die obere"@de ;
    skos:definition "When the AB-SaG light lowers the he and a degree recovers its AHP, the lower degree that clung to those AHP in smallness rises with them, since nothing in the spiritual is lost; the lower that ascends to the upper becomes like it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §93, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §94
#

pmc:KabbalahAshlagAliyatZaTLeAVLeMaN a pm:Conceptualizing ;
    rdfs:label "Ascent of the seven lower to AVI as MaN"@en, "Aufstieg der sieben Unteren zu AWI als MaN"@de ;
    skos:definition "The seven lower clothing the AHP of Abba ve-Imma rose with them and became one degree with AVI, receiving their lights; this ascent is called raising of MaN, since as ZON they turn Bina face to face with Hokhma to bestow Hokhma on them."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §94, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §96
#

pmc:KabbalahAshlagEinHeederBeRuhani a pm:Cautioning ;
    rdfs:label "Change of place in spiritual matters is addition, not removal"@en, "Ortswechsel im Geistigen ist Hinzufügung, nicht Entfernung"@de ;
    skos:definition "The reader is warned not to read ascent as in physical relocation: no absence exists in the spiritual; a thing said to move comes to the new place while also remaining in the former one."@en ;
    pm:cautionsAbout pmc:KabbalahAshlagAliyatZaTLeAVLeMaN ;
    skos:note "Hebrew term in the text: אין העדר ברוחני."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §96, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §97
#

pmc:KabbalahAshlagZONYotzimMeAVHafsaqatZivvug a pm:Conceptualizing ;
    rdfs:label "If ZON left AVI, the face-to-face coupling and the mohin would cease"@en, "Verließen SON AWI, endete die Paarung und die Mochin"@de ;
    skos:definition "Were ZON absent from Abba ve-Imma upon returning below, the face-to-face coupling of AVI would stop at once, they would turn back to back, their abundance would cease and the ZON below would lose their mohin; for Bina by nature desires only Hasadim."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that does not come about or is lost, and its cause."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §97, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §98
#

pmc:KabbalahAshlagDaat a pm:Conceptualizing ;
    rdfs:label "Sefira of Daat, new in Nekudim"@en, "Sefira Daat, neu in den Nekudim"@de ;
    skos:definition "In AK there are only KHB ZON; from Nekudim on there is also Daat, counted KHBD ZON. Daat is the ZON who rose as MaN to Hokhma and Bina and remain there after descending, sustaining their face-to-face coupling; it is always called five hasadim (ZA) and five gevurot (Nukva)."@en ;
    skos:note "Hebrew term in the text: ספירת הדעת / ה' חסדים וה' גבורות."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §98, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §100
#

pmc:KabbalahAshlagEserVeLoAhatEsre a pm:Conceptualizing ;
    rdfs:label "Apparent conflict with Sefer Yetzira on ten sefirot"@en, "Scheinbarer Widerspruch zu Sefer Jezira"@de ;
    skos:definition "Against the objection from Sefer Yetzira that the sefirot are ten, not eleven, the author answers that Daat adds nothing: it is a second aspect of ZON (remaining in the head) besides ZON in their place below, so the count stays ten."@en ;
    skos:note "Entered as a concept and not as pm:Disputing: only the author's side is read here; the Sefer Yetzira, which he cites for the objection, was not opened in this run."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §100, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §101
#

pmc:KabbalahAshlagGadlutDeNequdim a pm:Conceptualizing ;
    rdfs:label "Greatness of Nekudim: coupling at Keter, then spread as taamim"@en, "Größe der Nekudim: Paarung auf Keter, dann Teamim"@de ;
    skos:definition "AVI received AB-SaG light via shuruk, lowered their he to the mouth and raised their back vessels with the front vessels of the seven lower; these became MaN, AVI turned face to face, coupling on phase four produced complete ten sefirot of Keter with yehida; this spread down to the body is the taamim of the great partzuf of Nekudim."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §101, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §102
#

pmc:KabbalahAshlagKolKoahBeElyonimBeTahtonim a pm:Conceptualizing ;
    rdfs:label "Every force in upper beings must also be in lower ones"@en, "Jede Kraft der Oberen ist auch in den Unteren"@de ;
    skos:definition "Whatever powers exist in the upper ones necessarily exist in the lower, while in the lower things are added to them; hence Nekudim also has taamim, nekudot, tagin and otiyot."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §102, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §103
#

pmc:KabbalahAshlagDinDeMalkhutHaMesayyemetShevirah a pm:Conceptualizing ;
    rdfs:label "In Nekudim the judgment of the ending Malkhut, not striking, purifies: vessels break"@en, "In Nekudim läutert das Gericht der Malchut: Gefäße brechen"@de ;
    skos:definition "Here the screen purifies not by the striking of surrounding and inner light but by the judgment-force of the ending Malkhut mixed in the vessels; therefore, unlike in Galgalta, AB, SaG, the vessels did not remain empty after the lights left but broke, died and fell to BYA."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that does not come about or is lost, and its cause. It names how pmc:KabbalahAshlagGadlutDeNequdim fails or is lost."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §103, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §104
#

pmc:KabbalahAshlagMelekhHaDaat a pm:Naming ;
    rdfs:label "King of Daat, first king of Nekudim"@en, "König des Daat, erster König der Nekudim"@de ;
    skos:definition "The spread of the seven lower below the mouth of AVI after MaN ascent is called king of Daat, since their root remains in AVI as the Daat coupling them; it is the first king of Nekudim."@en ;
    pm:nameForm "Melekh ha-Daʿat" ;
    pm:nameRole "first of the seven kings; body of the Keter stature of Nekudim" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §104, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagShivaMelakhim a pm:Systematizing ;
    rdfs:label "Seven kings of Nekudim and their sequential breaking"@en, "Sieben Könige der Nekudim und ihr Bruch"@de ;
    skos:definition "Upper light keeps coupling on the remaining coarseness: Keter stature yields king of Daat, Hokhma king of Hesed, Bina king of Gevura, ZA upper third of Tiferet (from AVI); then from YeSHSuT: Hokhma lower two thirds of Tiferet, Bina Netzah-Hod (one king), ZA Yesod, root Malkhut; each draws to BYA, breaks and dies, losing one coarseness level and the back vessels of its head."@en ;
    pm:compiledBy "Yehuda Leib Ashlag, in the Petiḥa le-Ḥokhmat ha-Qabbala" ;
    dcterms:date "1945"^^xsd:gYear ;
    skos:note "Hebrew term in the text: ז' מלכים (shivʿa melakhim)."@en ;
    skos:note "The ordering is the author's: he arranges the Lurianic material he expounds; the date is that of the printing read."@en ;
    skos:note "The breaking of the kings runs in a fixed order from §104 to §109, but of the kings only the first, pmc:KabbalahAshlagMelekhHaDaat, is entered as a node of its own; the order is kept as an ordering in this run."@en ;
    pm:attestedBy pm:compilerInference ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §§104-109, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §105
#

pmc:KabbalahAshlagShevirahMelekhHaDaat a pm:Conceptualizing ;
    rdfs:label "Lights of the king of Daat meet the ending force: vessels die and fall"@en, "Lichter des Daat-Königs treffen die Endkraft: Gefäße sterben"@de ;
    skos:definition "As the head's lights drew down also to the back vessels below the parsa (TNHYM in BYA), the lights met the ending force mixed there, departed entirely to their root, and all vessels of the king of Daat broke front and back, died and fell into BYA; the screen then lost phase-four coarseness."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that does not come about or is lost, and its cause. It names how pmc:KabbalahAshlagMelekhHaDaat fails or is lost."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §105, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagHistalkutHaOrMita a pm:Conceptualizing ;
    rdfs:label "Departure of lights from vessels is death"@en, "Abzug der Lichter aus den Gefäßen ist Tod"@de ;
    skos:definition "The departure of lights from vessels is like departure of life from a physical body, which is called death."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §105, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §106
#

pmc:KabbalahAshlagBittulHaAhorayim a pm:Conceptualizing ;
    rdfs:label "Cancelling of the back vessels of Keter stature from AVI"@en, "Aufhebung der Rückgefäße der Keter-Statur aus AWI"@de ;
    skos:definition "Since coarseness of head and body is one thing (one potential, the other actual), the loss of phase four in the body also ended the Keter coupling in the head; the AHP that completed Keter stature fell again to the seven lower: this is called cancelling of the back vessels."@en ;
    skos:note "Hebrew term in the text: ביטול האחורים (bittul ha-aḥorayim)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §106, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §108
#

pmc:KabbalahAshlagBittulGadlutDeAV a pm:Conceptualizing ;
    rdfs:label "All greatness of AVI cancelled; only front vessels of smallness remain"@en, "Alle Größe von AWI aufgehoben; nur Vorderseiten bleiben"@de ;
    skos:definition "With the four breakings all back vessels of AVI fell; only the skull and eyes of smallness remained; the screen purified fully, rose to the head, and a new stature called YeSHSuT emerged."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §108, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §109
#

pmc:KabbalahAshlagYiSHSuTDeNequdim a pm:Naming ;
    rdfs:label "YeSHSuT of Nekudim"@en, "JeSchSuT der Nekudim"@de ;
    skos:definition "The new head of stature Hokhma, which descends to clothe at the chest of the body of Nekudim and spreads below from there, is called YeSHSuT; with AVI they are counted as AB and SaG of Nekudim."@en ;
    pm:nameForm "YiSHSuT (Yisraʾel Sava u-Tevuna)" ;
    pm:nameRole "second partzuf of Nekudim, head of the lower four kings" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §109, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §110
#

pmc:KabbalahAshlagHistakkelutEinin a pm:Conceptualizing ;
    rdfs:label "In the heads only the back vessels fell; bodies broke front and back"@en, "In den Köpfen fielen nur Rückgefäße; Körper brachen ganz"@de ;
    skos:definition "Four statures emerged in AVI (gazing of the eyes, body of Abba, body of Imma, foundations of AVI) and in YeSHSuT likewise; their four bodies broke front and back, but in the heads the front vessels of smallness remained, only the back vessels of greatness fell."@en ;
    skos:note "Hebrew term in the text: הסתכלות עיינין (histakkelut ʿeinin)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §110, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §112
#

pmc:KabbalahAshlagNitHadshuBeNequdim a pm:Conceptualizing ;
    rdfs:label "What first appears in MaH of AK, the Nekudim world"@en, "Was im vierten Parzuf des AK, der Welt der Nekudim, neu ist"@de ;
    skos:definition "Summing up the four first partzufim of AK, the author states that five things came into being for the first time in its fourth partzuf, MaH, whose outer part is the world of Nekudim: Malkhut sharing in Bina, which is the second restriction; smallness and greatness; the raising of MaN; the Daat that decides between Hokhma and Bina and joins them face to face; and the shattering of the vessels."@en ;
    skos:note "Hebrew term in the text: כי כל אלו נתחדשו בפרצוף הד' דא\"ק."@en ;
    skos:note "Added in the reconciliation of the two passes: the second pass recorded this summary claim and the first did not."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §112, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §113
#

pmc:KabbalahAshlagPeHotemOzenNiqveiEinayimMetzah a pm:Systematizing ;
    rdfs:label "Five coarseness levels named by parts of the head"@en, "Fünf Grobheitsgrade nach Kopfteilen benannt"@de ;
    skos:definition "Phase four = mouth (Galgalta of AK), phase three = nose (AB), phase two = ear (SaG), phase one = nostrils of the eyes (MaH of AK, world of Nekudim), root = skull or forehead (world of correction, the new MaH)."@en ;
    pm:compiledBy "Yehuda Leib Ashlag, in the Petiḥa le-Ḥokhmat ha-Qabbala" ;
    dcterms:date "1945"^^xsd:gYear ;
    skos:note "Hebrew term in the text: פה חוטם אזן נקבי עינים מצח."@en ;
    skos:note "The ordering is the author's: he arranges the Lurianic material he expounds; the date is that of the printing read."@en ;
    skos:note "A correspondence between the five levels of coarseness and the parts of the head; entered as an ordering."@en ;
    pm:attestedBy pm:compilerInference ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §113, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagMaHHaHadash a pm:Naming ;
    rdfs:label "New MaH from the forehead: world of correction, Atzilut"@en, "Neues MaH aus der Stirn: Welt der Korrektur, Azilut"@de ;
    skos:definition "The fifth partzuf of AK, from root coarseness (forehead), has in truth only stature Malkhut (BoN), but since phase-one clothing remained it is called MaH that emerged from the forehead, or the new MaH, distinguished from MaH of the nostrils; it is called world of correction or world of Atzilut."@en ;
    pm:nameForm "MaH ha-ḥadash / ʿOlam ha-Tiqqun" ;
    pm:nameRole "fifth partzuf of AK; world of Atzilut" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §113, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §115
#

pmc:KabbalahAshlagHotamVeNehtam a pm:Conceptualizing ;
    rdfs:label "Partzuf versus world: seal and imprint"@en, "Parzuf und Welt: Siegel und Abdruck"@de ;
    skos:definition "A partzuf is any stature of ten sefirot emerging from the upper's purified body-screen, spreading in head-interior-end with taamim and nekudot, named after its taamim; a world contains all that exists in the next higher world, as an imprint contains its seal."@en ;
    skos:note "Hebrew term in the text: חותם ונחתם (ḥotam ve-neḥtam)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §115, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §116
#

pmc:KabbalahAshlagNequdimOlam a pm:Conceptualizing ;
    rdfs:label "Nekudim is a world because it imprints AK"@en, "Nekudim ist eine Welt, weil es AK abbildet"@de ;
    skos:definition "Galgalta, AB, SaG form one world, AK, of the first restriction; the fourth partzuf became a world by the doubling of phase four in the screen of SaG's points: in greatness it produced Keter, then YeSHSuT, then MaH of Nekudim, mirroring the three partzufim of AK; they are AB SaG MaH because the phase four joined is not complete."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §116, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §117
#

pmc:KabbalahAshlagOlamHaTiqqun a pm:Naming ;
    rdfs:label "Atzilut / world of correction: ends above parsa, mends Nekudim"@en, "Azilut / Welt der Korrektur: endet über der Parsa"@de ;
    skos:definition "The new MaH is imprinted wholly from Nekudim; all its aspects, broken there, are renewed here. It is called Atzilut since it ends entirely above the parsa, and world of correction since what did not endure in Nekudim is corrected and endures here; through it fallen back vessels and the dead ZaT rise to Atzilut."@en ;
    pm:nameForm "ʿOlam ha-Atzilut / ʿOlam ha-Tiqqun" ;
    pm:nameRole "world that corrects the broken Nekudim" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §117, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §118
#

pmc:KabbalahAshlagMiluiKelimDeElyon a pm:Conceptualizing ;
    rdfs:label "Each lower partzuf refills the emptied vessels of its upper"@en, "Jeder untere Parzuf füllt die geleerten Gefäße des oberen"@de ;
    skos:definition "After the body lights of a partzuf depart through purification, the new coupling's stature refills the empty vessels of its upper: AB those of Galgalta, SaG those of AB, MaH those of SaG's points; likewise the new MaH fills the broken vessels of Nekudim."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §118, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §119
#

pmc:KabbalahAshlagBirurBoN a pm:Conceptualizing ;
    rdfs:label "New MaH as male to the Nekudim vessels, which become BoN"@en, "Neues MaH männlich gegenüber den Nekudim-Gefäßen (BoN)"@de ;
    skos:definition "Earlier departures involved no flaw, only purification; in Nekudim the vessels were flawed by the ending force and unfit for light, so they depend wholly on the new MaH to revive, sort and raise them to Atzilut; hence new MaH is male and giver, and the sorted vessels become female to it, named BoN."@en ;
    skos:note "Hebrew term in the text: בירור / ב\"ן (birur / BoN)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §119, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §120
#

pmc:KabbalahAshlagHazaratTzimtzumBet a pm:Conceptualizing ;
    rdfs:label "After the breaking the second restriction returned"@en, "Nach dem Bruch kehrte die zweite Einschränkung zurück"@de ;
    skos:definition "Since all statures of greatness were cancelled and broke and the lights departed, the second restriction was reinstated and phase four rejoined the screen; hence new MaH is again a full world with smallness and greatness."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §120, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §121
#

pmc:KabbalahAshlagIbburYeniqaGadlut a pm:Sequencing ;
    rdfs:label "Development stages: embryo, nursing, second embryo (greatness)"@en, "Entwicklungsstufen: Embryo, Säugen, zweite Empfängnis"@de ;
    skos:definition "The new MaH first emerges in smallness as embryo (ibbur), stature Malkhut from root coarseness, HGT clothed in NHY; descending to its place it receives mohin of nursing (yeniqa), phase-one coarseness, gaining vessels for HGT and stature ZA; then it rises again as MaN in a second embryo and receives mohin of greatness from AB-SaG, completing ten sefirot."@en ;
    rdf:_1 pmc:KabbalahAshlagIbbur ;
    rdf:_2 pmc:KabbalahAshlagYeniqa ;
    rdf:_3 pmc:KabbalahAshlagIbburBet ;
    pm:seriesStatement "The new MaH and each partzuf of Atzilut come to completion through three states in a set order: embryo at the stature of Malkhut, nursing at the stature of Zeʿir Anpin once it has come down to its own place, and a second embryo that brings the mohin of greatness at the stature of Keter. Each state is defined by the coarseness on which it is coupled, and greatness comes only by a renewed rise from the state of nursing." ;
    skos:note "Hebrew term in the text: עיבור / יניקה / מוחין דגדלות (ʿibbur / yeniqa / moḥin)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §§121-122, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagShaloshQavim a pm:Conceptualizing ;
    rdfs:label "Three lines in the stature of Malkhut"@en, "Drei Linien in der Statur der Malchut"@de ;
    skos:definition "In the stature of Malkhut three lines form: the right line called Netzah, the left Hod, the middle Yesod."@en ;
    skos:note "Hebrew term in the text: ג' קוין (shalosh qavim)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §121, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagIbbur a pm:Conceptualizing ;
    rdfs:label "Embryo (ʿibbur): first state of a partzuf of the world of correction"@en, "Embryo (ʿibbur): erster Zustand eines Parzufs der Welt der Berichtigung"@de ;
    skos:definition "The first state of the new MaH and of each partzuf of Atzilut: a stature of Malkhut coupled on the root coarseness that stayed in the screen when it rose to the forehead of its upper; HGT have no vessels of their own yet and are clothed inside NHY."@en ;
    skos:note "Hebrew term in the text: עובר / עיבור (ʿubar / ʿibbur)."@en ;
    skos:note "Written by the integrator as a member of a series the text sets out; see the series node."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §121, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagYeniqa a pm:Conceptualizing ;
    rdfs:label "Nursing (yeniqa): second state, stature of Zeʿir Anpin"@en, "Säugen (jeniqa): zweiter Zustand, Statur des Seʿir Anpin"@de ;
    skos:definition "Once the embryo has had its coupling in the upper and come down to its own place, it takes from the upper the mohin of nursing, coupled on phase-one coarseness with the lower he at the nostrils of the eyes; this gives HGT vessels of their own, they spread out of NHY, and the partzuf reaches the stature of Zeʿir Anpin."@en ;
    skos:note "Hebrew term in the text: מוחין דיניקה (moḥin de-yeniqa)."@en ;
    skos:note "Written by the integrator as a member of a series the text sets out; see the series node."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §121, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §122
#

pmc:KabbalahAshlagAttiq a pm:Naming ;
    rdfs:label "Atik of Atzilut (partzuf Keter)"@en, "Atik von Azilut (Parzuf Keter)"@de ;
    skos:definition "After the second embryo the coupling on phase four at the mouth yields stature Keter with AHP restored: Atzilut's first partzuf, termed partzuf Keter or Atik."@en ;
    pm:nameForm "ʿAttiq" ;
    pm:nameRole "first partzuf of Atzilut, stature Keter" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §122, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagIbburBet a pm:Conceptualizing ;
    rdfs:label "Second embryo (ʿibbur bet): mohin of greatness, stature of Keter"@en, "Zweiter Embryo (ʿibbur bet): Mochin der Größe, Statur des Keter"@de ;
    skos:definition "The partzuf goes up once more to its upper as MaN, which the text calls a second embryo; it receives mohin from AB-SaG of AK, phase four comes back down from the nostrils to the mouth, a coupling there yields ten sefirot at the stature of Keter, and the AHP vessels return to the head. These are its mohin of greatness; the first partzuf to be completed in this way is Atik of Atzilut."@en ;
    skos:note "Hebrew term in the text: עיבור ב' (ʿibbur bet)."@en ;
    skos:note "Written by the integrator as a member of a series the text sets out; see the series node."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §122, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §123
#

pmc:KabbalahAshlagAliyatPanimImAHaPDeElyon a pm:Conceptualizing ;
    rdfs:label "Each next partzuf's front vessels rise with the upper's AHP and receive embryo"@en, "Vorderseiten des nächsten steigen mit den AChP auf"@de ;
    skos:definition "After the breaking each degree's AHP lay in the front vessels of the degree below; when Atik raised its AHP in its second embryo, the skull-eyes of the Hokhma stature rose with them, were corrected together and received their first embryo; the same chain repeats for each following partzuf."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §123, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §124
#

pmc:KabbalahAshlagArikhAnpin a pm:Naming ;
    rdfs:label "Arikh Anpin of Atzilut (partzuf Hokhma)"@en, "Arich Anpin von Azilut (Parzuf Chochma)"@de ;
    skos:definition "The front vessels of Hokhma, after embryo and nursing, rose to Atik's head for their second embryo; phase three returned to the mouth, ten sefirot of stature Hokhma emerged: partzuf Arikh Anpin."@en ;
    pm:nameForm "Arikh Anpin" ;
    pm:nameRole "second partzuf of Atzilut, stature Hokhma" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §124, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §125
#

pmc:KabbalahAshlagAbbaVeImmaDeAtzilut a pm:Naming ;
    rdfs:label "Abba ve-Imma and YeSHSuT of Atzilut (partzuf Bina)"@en, "Abba we-Imma und JeSchSuT von Azilut"@de ;
    skos:definition "The front vessels of Bina rose with Arikh Anpin's AHP and, after their second embryo in its head, completed partzuf Bina, called AVI and YeSHSuT: its upper three are AVI, its seven lower YeSHSuT."@en ;
    pm:nameForm "Abba ve-Imma / YiSHSuT" ;
    pm:nameRole "third partzuf of Atzilut, stature Bina" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §125, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §126
#

pmc:KabbalahAshlagZON a pm:Naming ;
    rdfs:label "Zeʿir Anpin and Nukva (ZON) of Atzilut"@en, "Seir Anpin und Nukwa (SON) von Azilut"@de ;
    skos:definition "The front vessels of ZON rose with AVI's AHP and received first embryo and nursing; thereby ZON are completed in six extremities for ZA and a point for the Nukva."@en ;
    pm:nameForm "Zeʿir Anpin ve-Nuqva (ZON)" ;
    pm:nameRole "fourth and fifth partzuf of Atzilut, permanent state of six extremities and point" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §126, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagHameshPartzufeiAtzilut a pm:Sequencing ;
    rdfs:label "Five permanent partzufim of Atzilut"@en, "Fünf feste Parzufim von Azilut"@de ;
    skos:definition "New MaH's five partzufim in their fixed state: Atik (Keter), Arikh Anpin (Hokhma), AVI (Bina), ZON (six extremities and a point)."@en ;
    rdf:_1 pmc:KabbalahAshlagAttiq ;
    rdf:_2 pmc:KabbalahAshlagArikhAnpin ;
    rdf:_3 pmc:KabbalahAshlagAbbaVeImmaDeAtzilut ;
    rdf:_4 pmc:KabbalahAshlagZON ;
    pm:seriesStatement "Atik, Arikh Anpin, Abba ve-Imma with YeSHSuT, and Zeʿir Anpin with Nukva are the fixed partzufim of Atzilut in the order Keter, Hokhma, Bina and the six extremities with the point; each next one is completed through embryo, nursing and second embryo by rising with the AHP of the one above it (§123), so none comes to completion before its upper." ;
    skos:note "Hebrew term in the text: קביעות (qeviʿut)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §126, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagMohinHaQevuim a pm:Conceptualizing ;
    rdfs:label "Fixed mohin of Atzilut never diminish"@en, "Feste Mochin von Azilut nehmen nie ab"@de ;
    skos:definition "In the five statures of the new MaH no diminution ever occurs: the deeds of the lower ones do not reach the upper three to blemish them, and in ZON they reach only the back vessels acquired in greatness, not the front vessels; hence these are the fixed mohin of Atzilut."@en ;
    skos:note "Hebrew term in the text: מוחין הקבועים (moḥin ha-qevuʿim)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §126, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagPegamAhorayimDeZON a pm:Conceptualizing ;
    rdfs:label "Deeds of the lower can blemish the back vessels of ZON"@en, "Taten der Unteren können die Rückgefäße von SON beschädigen"@de ;
    skos:definition "Zeʿir Anpin and Nukva are reached by the deeds of the lower beings, but only in their back vessels obtained at greatness; these can be blemished and lost."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that does not come about or is lost, and its cause. It names how pmc:KabbalahAshlagMohinHaQevuim fails or is lost."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §126, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §127
#

pmc:KabbalahAshlagAqudim a pm:Naming ;
    rdfs:label "Akudim: AK above the navel"@en, "Akudim: AK oberhalb des Nabels"@de ;
    skos:definition "The region of AK above the navel belongs to the first restriction and is called Akudim; Atik, though not itself governed by the second restriction, clothes AK only below the navel, ending with AK's feet, yet in its bond with the other partzufim it ends above the parsa."@en ;
    pm:nameForm "ʿAqudim" ;
    pm:nameRole "AK above the navel, domain of the first restriction" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §127, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §128
#

pmc:KabbalahAshlagSederHalbashatAtzilut a pm:Conceptualizing ;
    rdfs:label "Clothing order of the partzufim of Atzilut"@en, "Einkleidungsordnung der Parzufim von Azilut"@de ;
    skos:definition "Arikh Anpin begins at the mouth of Atik's head and clothes Atik's seven lower, ending above the parsa; AVI begin at the mouth of AA's head and end above AA's navel; ZON begin at AA's navel and end level with AA, above the parsa."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §128, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §129
#

pmc:KabbalahAshlagMaHUBoN a pm:Conceptualizing ;
    rdfs:label "Each new-MaH stature sorts Nekudim vessels as its female (BoN)"@en, "Jede Statur des neuen MaH wählt Nekudim-Gefäße als Weibliches"@de ;
    skos:definition "Each of the five statures of new MaH, as it emerged, sorted and joined to itself part of the Nekudim vessels as its female: Atik the upper halves of the upper three of Nekudim and roots of their seven lower (front-and-back); AA the lower half of Keter (right-left); AVI the lower halves of Hokhma-Bina; YeSHSuT their Malkhuts; ZON the front vessels of the seven lower from BYA."@en ;
    skos:note "Hebrew term in the text: מ\"ה וב\"ן (MaH u-BoN)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §129, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §130
#

pmc:KabbalahAshlagAttiqNotelKelimBliPegam a pm:Conceptualizing ;
    rdfs:label "Atik takes only unflawed vessels; flawed ones go to lower partzufim"@en, "Atik nimmt nur unbeschädigte Gefäße"@de ;
    skos:definition "Atik, the first head of Atzilut and very exalted, joined only the front vessels of the upper three of Nekudim, untouched by any flaw at the breaking; the lower half of Keter, flawed by its fall and cancellation, was unfit for Atik and was taken by Arikh Anpin."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §130, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §134
#

pmc:KabbalahAshlagHashlamaMinAlef a pm:Conceptualizing ;
    rdfs:label "First kind of completion: by ascent and inclusion in the upper"@en, "Erste Art der Vervollständigung: durch Aufstieg ins Obere"@de ;
    skos:definition "A degree may complete its ten sefirot for greatness by rising and being included in its upper: when Keter regained its AHP via the navel (holam), AVI attached to them rose too and were completed by inclusion; this gives only an illumination of their AHP, sufficient while in the upper's place, not when back in their own."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §134, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §135
#

pmc:KabbalahAshlagHashlamaMinBet a pm:Conceptualizing ;
    rdfs:label "Second kind of completion: by the degree's own power"@en, "Zweite Art: aus eigener Kraft"@de ;
    skos:definition "A degree completes itself by its own power when it lowers its own he and raises its own actual AHP (as AVI by shuruk via Yesod); the seven lower would likewise have been completed by lowering the ending he to AK's feet had they not broken."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §135, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §138
#

pmc:KabbalahAshlagKolHaZakhNivrarTehila a pm:Conceptualizing ;
    rdfs:label "Fixed mohin of Atzilut are of the first kind; the purer is sorted first"@en, "Feste Mochin sind erster Art; das Reinere wird zuerst gewählt"@de ;
    skos:definition "The AHP sorted for the fixed Atzilut's five partzufim were of the first kind (like holam), so although their heads have full ten sefirot, no upper three reach their bodies, all bodies being six extremities without head; the reason given is that the purer is always sorted first."@en ;
    skos:note "Hebrew term in the text: כל הזך נברר תחילה."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §138, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §139
#

pmc:KabbalahAshlagAtzilutVavQetzavotDeAK a pm:Conceptualizing ;
    rdfs:label "Atzilut is only six extremities of AK; a degree judged by its body"@en, "Azilut ist nur WaK des AK; Stufe nach Körper beurteilt"@de ;
    skos:definition "In AK all that emerged in the heads also spread into the bodies; since the essence of a degree is judged by its spread below the mouth, all Atzilut's five partzufim count as six extremities (MaH) of AK's five partzufim, each lacking neshama, haya, yehida of its counterpart; YeSHSuT and ZON are always one degree, head and body."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §139, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §141
#

pmp:KabbalahAshlagHaalatMaNMiMaasimTovim a pm:Practicing ;
    rdfs:label "Raising feminine waters through good deeds"@en, "Aufsteigen der weiblichen Wasser durch gute Taten"@de ;
    skos:definition "The lower beings perform good deeds, thereby raising MaN to the partzufim of Atzilut, which sorts the second kind of completion for AVI so that mohin flow down to the bodies and ZON."@en ;
    skos:note "Hebrew term in the text: העלאת מ\"ן ממעשים טובים."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §141, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagAliyatHaOlamot a pm:Conceptualizing ;
    rdfs:label "Drawing upper three mohin into the bodies of Atzilut (ascent of worlds)"@en, "Ziehen der oberen drei Mochin in die Körper (Weltaufstieg)"@de ;
    skos:definition "Through MaN Atzilut's five partzufim gain the upper three in their bodies too, rise and clothe AK's five partzufim (Atik on Keter, AA on AB, AVI on SaG, ZON on MaH-BoN), each receiving neshama, haya, yehida from its counterpart."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §141, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagHaalatMaNAliyatHaOlamot a pm:Yielding ;
    rdfs:label "Good deeds raising MaN yield the ascent of Atzilut"@en, "Gute Taten mit MaN bewirken den Aufstieg von Azilut"@de ;
    skos:definition "Raising MaN by the lower ones' good deeds is said to produce the second kind of completion and the ascent of the worlds."@en ;
    pm:byPractice pmp:KabbalahAshlagHaalatMaNMiMaasimTovim ;
    pm:yieldsCapacity pmc:KabbalahAshlagAliyatHaOlamot ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §141, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §142
#

pmc:KabbalahAshlagMohinDeAliya a pm:Conceptualizing ;
    rdfs:label "Mohin of ascent during the six thousand years"@en, "Mochin des Aufstiegs in den sechstausend Jahren"@de ;
    skos:definition "For ZON these mohin are only of the first kind (illumination of AHP while in AVI's place); hence all mohin ZON attain in the six thousand years are mohin of ascent: they have upper-three mohin only when raised to that place, and without ascent none; the second kind for ZON comes only at the final correction."@en ;
    skos:note "Hebrew term in the text: מוחין דעליה / שתא אלפי שני."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §142, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §143
#

pmc:KabbalahAshlagGiluiMelekhHaMashiah a pm:Conceptualizing ;
    rdfs:label "Final correction: Atzilut's ending equals AK's; the Messiah revealed"@en, "Ende der Korrektur: Azilut endet wie AK; Messias offenbart"@de ;
    skos:definition "In the future final correction ZON will obtain the second kind of completion, lower the ending he from the parsa to the end of AK's feet, rejoin their TNHY from BYA to Atzilut, so the ending of Atzilut equals that of AK; then the King Messiah will be revealed (his feet standing on the Mount of Olives)."@en ;
    skos:note "Counted as a sign of success: the text announces it as the mark of completion."@en ;
    skos:note "Announced sign of completion; until then correction proceeds only by ascent."@en ;
    skos:note "The text announces it of the future and gives no sign by which a reader could recognise it before the end; it is the only sign of success the work names."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §143, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagTiqqunDeRekhAliya a pm:Conceptualizing ;
    rdfs:label "In the six thousand years correction only by ascent"@en, "In sechstausend Jahren Korrektur nur durch Aufstieg"@de ;
    skos:definition "During the six thousand years the worlds are corrected only by way of ascent, not by lowering the ending in place."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §143, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §144
#

pmc:KabbalahAshlagShevaBehinotBYA a pm:Systematizing ;
    rdfs:label "Seven principles of the worlds Beria, Yetzira, Assiya"@en, "Sieben Grundsätze der Welten BJA"@de ;
    skos:definition "The author sets out seven aspects of BYA: (1) origin of their place; (2) statures and position at first emanation from Atzilut's Nukva; (3) additional mohin before Adam's sin; (4) mohin remaining and place of fall after the sin; (5) mohin of Imma after the fall; (6) back partzufim of Atzilut clothed in BYA as soul of soul; (7) Malkhut of Atzilut becoming Atik for BYA."@en ;
    pm:compiledBy "Yehuda Leib Ashlag, in the Petiḥa le-Ḥokhmat ha-Qabbala" ;
    dcterms:date "1945"^^xsd:gYear ;
    skos:note "The ordering is the author's: he arranges the Lurianic material he expounds; the date is that of the printing read."@en ;
    pm:attestedBy pm:compilerInference ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §144, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §146
#

pmc:KabbalahAshlagAmidatBYABeLeidatam a pm:Conceptualizing ;
    rdfs:label "Initial standing of BYA at their birth from Atzilut's Nukva"@en, "Anfangsstellung von BJA bei ihrer Geburt"@de ;
    skos:definition "At that time ZA had haya from Abba and clothed upper AVI, Nukva had neshama and clothed Imma (YeSHSuT); Nukva, counting as Imma, sorted and emanated Beria, which therefore stood where Atzilut's ZA stands; Yetzira, from Beria, stood partly at the Nukva's place; Assiya at the present Beria and upper Yetzira."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §146, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §148
#

pmc:KabbalahAshlagNuqvaPanimBePanim a pm:Conceptualizing ;
    rdfs:label "Nukva face to face equals ZA; back to back holds only four sefirot"@en, "Nukwa von Angesicht gleich SA; Rücken an Rücken nur vier Sefirot"@de ;
    skos:definition "The Nukva has two states: face to face her stature equals ZA; back to back she spans just ZA's four sefirot TNHY; since all worlds were then back to back, only Yetzira's first four stood in the Nukva's place."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §148, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §149
#

pmc:KabbalahAshlagMedorHaQelippot a pm:Naming ;
    rdfs:label "Dwelling of the husks (fourteen sefirot)"@en, "Wohnstätte der Schalen (vierzehn Sefirot)"@de ;
    skos:definition "The fourteen sefirot comprising present NHYM of Yetzira and all ten of present Assiya were then empty of holiness and became the dwelling of the husks; the holy worlds ended at the chest of present Yetzira."@en ;
    pm:nameForm "Medor ha-Qelippot" ;
    pm:nameRole "region below the holy worlds occupied by husks" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §149, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §150
#

pmc:KabbalahAshlagAdamHaRishon a pm:Naming ;
    rdfs:label "Adam ha-Rishon"@en, "Adam ha-Rischon"@de ;
    skos:definition "The first man, held to be born at the fifth hour of the Sabbath eve; his sin concerning the tree of knowledge blemished the worlds BYA."@en ;
    pm:nameForm "Adam ha-Rishon" ;
    pm:nameRole "first man whose birth coincides with an ascent of the worlds and whose sin caused their fall" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §150, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagTosefetShabbat a pm:Conceptualizing ;
    rdfs:label "Two ascents before the sin through the Sabbath addition"@en, "Zwei Aufstiege vor der Sünde durch Schabbat-Zusatz"@de ;
    skos:definition "By the illumination of the Sabbath addition the worlds had two ascents: at the fifth hour of Sabbath eve ZA gained yehida and clothed AA, Nukva haya clothing AVI, Beria rose to YeSHSuT, Yetzira to ZA, Assiya partly to Nukva and Beria; at twilight of Sabbath eve the rest of Assiya rose too, Yetzira and Assiya standing in Atzilut at the place of ZON, face to face."@en ;
    skos:note "Hebrew term in the text: תוספת שבת (tosefet shabbat)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §150, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §151
#

pmc:KabbalahAshlagHetEtzHaDaat a pm:Conceptualizing ;
    rdfs:label "Sin concerning the tree of knowledge: additional mohin depart, BYA fall"@en, "Sünde am Baum der Erkenntnis: Zusatz-Mochin weichen, BJA fallen"@de ;
    skos:definition "Owing to the flaw caused by the sin concerning the tree of knowledge all additional mohin gained by the two ascents left the worlds; ZON returned to six extremities and point; BYA kept only their original mohin, lost all aspect of Atzilut and fell below the parsa, with the last four of Yetzira and all Assiya standing in the place of the husks."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that does not come about or is lost, and its cause. It names how pmc:KabbalahAshlagTosefetShabbat fails or is lost."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §151, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §152
#

pmc:KabbalahAshlagMohinDeImmaBeBYA a pm:Conceptualizing ;
    rdfs:label "Mohin of Imma received by BYA in their fallen place"@en, "Mochin der Imma für BJA am Ort ihres Falls"@de ;
    skos:definition "After the fall BYA had only six extremities; YeSHSuT clothed in Atzilut's ZON and coupled, bestowing neshama mohin: Beria received complete ten sefirot of stature Bina, Yetzira six extremities, Assiya only back to back."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §152, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §153
#

pmc:KabbalahAshlagNeshamaLiNeshama a pm:Conceptualizing ;
    rdfs:label "Soul of soul from the back partzuf of the Nukva at the diminution of the moon"@en, "Seele der Seele aus dem Rücken-Parzuf der Nukwa"@de ;
    skos:definition "When the moon was diminished, the back partzuf of Atzilut's Nukva fell and clothed in BYA; it comprises embryo, nursing and mohin: mohin fell to Beria, nursing to Yetzira, embryo to Assiya, becoming soul of soul (haya) for all BYA partzufim."@en ;
    skos:note "Hebrew term in the text: מיעוט הירח / נשמה לנשמה (miʿut ha-yareaḥ / neshama li-neshama)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §153, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §154
#

pmc:KabbalahAshlagOrotDeBYAHayom a pm:Conceptualizing ;
    rdfs:label "Composition of the lights of BYA today"@en, "Zusammensetzung der Lichter von BJA heute"@de ;
    skos:definition "The back of the Nukva's Keter became Atik for BYA; so the present lights of BYA are: six extremities from what remained after Adam's sin, neshama from mohin of Imma, haya from the back of the nine lower of the Nukva, and yehida from the back of the Nukva's Keter."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §154, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §155
#

pmc:KabbalahAshlagAKVeAtzilutTzimtzumAlefVeBet a pm:Conceptualizing ;
    rdfs:label "AK versus Atzilut: first versus second restriction"@en, "AK und Azilut: erste und zweite Einschränkung"@de ;
    skos:definition "AK partzufim belong to the first restriction: each degree has complete ten sefirot with only one vessel, Malkhut, the first nine being lights alone; Atzilut belongs to the second restriction (mercy joined with judgment), reducing statures to skull-eyes, vessels Keter-Hokhma, six extremities without head, lights nefesh-ruah."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §155, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §156
#

pmc:KabbalahAshlagMohinDeGadlutLeRoshim a pm:Conceptualizing ;
    rdfs:label "Mohin of greatness serve only the heads of Atzilut"@en, "Mochin der Größe dienen nur den Köpfen von Azilut"@de ;
    skos:definition "The AB-SaG illumination gained in the second embryo benefits only the heads' ten sefirot; it does not pass below the mouth to the bodies, which stay under the second restriction; hence all Atzilut's five partzufim count as stature MaH and clothe AK from its navel down, each receiving from the MaH of its AK counterpart."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §156, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §158
#

pmc:KabbalahAshlagAtzilutKeNegedAK a pm:Cautioning ;
    rdfs:label "Atzilut partzufim are aligned with, not clothing, their AK counterparts"@en, "Azilut-Parzufim stehen gegenüber, nicht in, ihren AK-Pendants"@de ;
    skos:definition "The reader is warned not to take literally that each Atzilut partzuf clothes its counterpart in AK, which is impossible since both sets clothe one another; rather each stature is aligned opposite its counterpart from which it receives; the author refers to his diagram of the tree (figure 3)."@en ;
    pm:cautionsAbout pmc:KabbalahAshlagMohinDeGadlutLeRoshim ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §158, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §159
#

pmc:KabbalahAshlagShaloshDargotMaN a pm:Systematizing ;
    rdfs:label "Three grades of MaN and resulting mohin"@en, "Drei Grade von MaN und ihre Mochin"@de ;
    skos:definition "MaN of phase-two coarseness yields stature Bina (SaG), mohin of neshama; of phase three, Hokhma (AB), mohin of haya; of phase four, Keter (Galgalta), mohin of yehida."@en ;
    pm:compiledBy "Yehuda Leib Ashlag, in the Petiḥa le-Ḥokhmat ha-Qabbala" ;
    dcterms:date "1945"^^xsd:gYear ;
    skos:note "The ordering is the author's: he arranges the Lurianic material he expounds; the date is that of the printing read."@en ;
    skos:note "The same three grades of MaN that the series pmc:KabbalahAshlagShaloshAliyot carries, stated here as a correspondence between grade of MaN and mohin; entered as an ordering."@en ;
    pm:attestedBy pm:compilerInference ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §159, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §160
#

pmc:KabbalahAshlagHaalatMaNPresupposesNaRaNDeTzaddiqim a pm:Presupposing ;
    rdfs:label "Only righteous NRN, included of BYA, can raise MaN"@en, "Nur NRN der Gerechten können MaN erheben"@de ;
    skos:definition "Those lower beings fit to raise MaN are only the nefesh-ruah-neshama of the righteous, already included of BYA, who can raise MaN to Atzilut's ZON as their upper."@en ;
    pm:dependentStep pmp:KabbalahAshlagHaalatMaNMiMaasimTovim ;
    pm:priorStep pmc:KabbalahAshlagNishmotTzaddiqimBeBYA ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    skos:note "Hebrew term in the text: נר\"ן דצדיקים (NaRaN de-tzaddiqim)."@en ;
    skos:note "Entered at prescribed order: the text restricts who can raise MaN but names no consequence for others who try. The prior step is the souls of the righteous clothed in BYA, which §174 describes."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §160, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagMohinHadashimMeEinSof a pm:Conceptualizing ;
    rdfs:label "New mohin only from the Infinite; MaN only to the adjacent upper"@en, "Neue Mochin nur aus dem Unendlichen; MaN nur zum nächsten Oberen"@de ;
    skos:definition "MaN rises from ZON to AVI and upward to AK; then upper light descends from the Infinite on it, a stature forms by the MaN's coarseness, and mohin descend degree by degree through AK and Atzilut to ZON, who give them to the righteous. Rule: every renewal of mohin comes only from the Infinite, and a degree can raise MaN to or receive from only its adjacent upper."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §160, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §161
#

pmc:KabbalahAshlagQabbalatHaTahtonimPresupposesGidulHaElyonim a pm:Presupposing ;
    rdfs:label "Lower ones receive only after all upper partzufim have grown through them"@en, "Untere empfangen erst, wenn alle Oberen gewachsen sind"@de ;
    skos:definition "The lower ones cannot receive anything from Atzilut's ZON before all upper partzufim of Atzilut and AK have grown by their means, since the mohin must cascade through them."@en ;
    pm:dependentStep pmc:KabbalahAshlagNaRaNHaYDeTzaddiqim ;
    pm:priorStep pmc:KabbalahAshlagAliyatHaOlamot ;
    pm:prerequisiteStrength pm:statedNecessity ;
    pm:consequenceOfSkipping "Nothing would reach the souls of the righteous." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §161, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagNerMiNer a pm:Conceptualizing ;
    rdfs:label "Transmission without loss: candle from candle; root stays, branch extends"@en, "Übertragung ohne Verlust: Kerze an Kerze"@de ;
    skos:definition "Passing from place to place in the spiritual means remaining at the origin as well, like lighting one candle from another; the root of the light stays at its origin while merely a branch extends to the second; so every degree the abundance passes through is enlarged by it."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §161, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §162
#

pmc:KabbalahAshlagTiqqunHaMaasimAliyatOlamot a pm:Yielding ;
    rdfs:label "Improving deeds raises worlds and degrees"@en, "Bessere Taten heben Welten und Stufen"@de ;
    skos:definition "When the lower ones improve their deeds, raise MaN and draw abundance, all worlds and degrees through which it passes grow and rise."@en ;
    pm:byPractice pmp:KabbalahAshlagHaalatMaNMiMaasimTovim ;
    pm:yieldsCapacity pmc:KabbalahAshlagAliyatHaOlamot ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §162, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagQilqulHaMaasim a pm:Conceptualizing ;
    rdfs:label "Spoiled deeds: MaN spoiled, mohin depart, worlds descend"@en, "Verdorbene Taten: MaN verdorben, Mochin weichen"@de ;
    skos:definition "When the lower ones again spoil their deeds, their MaN is corrupted and the mohin depart even from the upper degrees, since transmission for the lower ones stops; the worlds fall back to their fixed state."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that does not come about or is lost, and its cause. It names how pmp:KabbalahAshlagHaalatMaNMiMaasimTovim and pmc:KabbalahAshlagTiqqunHaMaasimAliyatOlamot fail or are lost."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §162, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §163
#

pmc:KabbalahAshlagQavEinSof a pm:Conceptualizing ;
    rdfs:label "Line of the Infinite and surrounding lights of AK"@en, "Linie des Unendlichen und umgebende Lichter des AK"@de ;
    skos:definition "In the fixed state Galgalta of AK is clothed by AB, SaG, MaH and BoN, ending above this world's point; around it the surrounding lights from the Infinite, without bound; as the Infinite surrounds it, it also clothes within it, called the line of the Infinite."@en ;
    skos:note "Hebrew term in the text: קו א\"ס (qav Ein Sof)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §163, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagShaloshAliyot a pm:Sequencing ;
    rdfs:label "Three general ascents within the six thousand years"@en, "Drei allgemeine Aufstiege in den sechstausend Jahren"@de ;
    skos:definition "From the fixed state up to the greatest height possible before the final correction there are in general only three ascents, divided into many details."@en ;
    rdf:_1 pmc:KabbalahAshlagAliyaRishona ;
    rdf:_2 pmc:KabbalahAshlagAliyaShniya ;
    rdf:_3 pmc:KabbalahAshlagAliyaShlishit ;
    pm:seriesStatement "Within the six thousand years the worlds rise from their fixed state in three general ascents, brought by MaN whose coarseness is of phase two, then of three, then of four, and adding in turn neshama, haya and yehida; each ascent is defined by its grade of MaN and by the light it adds, and the third is the height the worlds can reach before the final correction." ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §§163-173, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §165
#

pmc:KabbalahAshlagMatzavHaQavua a pm:Conceptualizing ;
    rdfs:label "Fixed state of AK and ABYA, never diminished"@en, "Fester Zustand von AK und ABJA"@de ;
    skos:definition "Atzilut stands from below AK's navel to above the parsa, BYA from the parsa to this world's point; this fixed state never diminishes, and in it all partzufim and worlds are only six extremities without head; even AK relative to its surrounding lights lacks the upper three."@en ;
    skos:note "Hebrew term in the text: מצב הקבוע."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §165, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §166
#

pmc:KabbalahAshlagAliyaRishona a pm:Conceptualizing ;
    rdfs:label "Ascents hinge on MaN raised from below; first ascent by phase-two MaN"@en, "Aufstiege hängen am MaN der Unteren; erster durch MaN der Stufe 2"@de ;
    skos:definition "Three general ascents complete the worlds in the missing neshama, haya, yehida, and depend on the raising of MaN by the lower ones. In the first, MaN of phase-two coarseness sorts the AHP of stature Bina (neshama) of the second kind, which shine also to bodies as in AK."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §166, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §168
#

pmc:KabbalahAshlagMatzavBeAliyaRishona a pm:Conceptualizing ;
    rdfs:label "Positions in the first ascent"@en, "Stellungen im ersten Aufstieg"@de ;
    skos:definition "With the Bina mohin Atik rises to clothe the Bina of AK, AA the fixed head of Atik, AVI the upper three of fixed AA, YeSHSuT and ZON the fixed AVI; the righteous receive the neshama mohin of Atzilut; Beria clothes Atzilut's Nukva (receiving nefesh of Atzilut), Yetzira clothes fixed Beria, Assiya clothes Yetzira. The author refers to diagram 7 of his tree."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §168, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagNaRaNHaYDeTzaddiqim a pm:Conceptualizing ;
    rdfs:label "Souls of the righteous attain neshama, haya, yehida of Atzilut"@en, "Seelen der Gerechten erlangen Neschama, Chaja, Jechida von Azilut"@de ;
    skos:definition "Through the three ascents the righteous NRN receive successively the mohin of neshama, the light of haya, and the light of yehida from Atzilut's ZON, i.e. the upper three they lack in the fixed state."@en ;
    skos:note "Hebrew term in the text: נרנח\"י (NaRaNḤaY)."@en ;
    skos:note "Counted as a capacity: a state the text holds attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §168, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagHaalatMaNNaRaNHaY a pm:Yielding ;
    rdfs:label "Raising MaN of increasing coarseness yields NRNHY for the righteous"@en, "MaN wachsender Grobheit ergibt NRNChJ für die Gerechten"@de ;
    skos:definition "MaN raised by the righteous of phase two, three and four coarseness is said to bring them neshama, haya and yehida respectively."@en ;
    pm:byPractice pmp:KabbalahAshlagHaalatMaNMiMaasimTovim ;
    pm:yieldsCapacity pmc:KabbalahAshlagNaRaNHaYDeTzaddiqim ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §168, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §170
#

pmc:KabbalahAshlagAliyaShniya a pm:Conceptualizing ;
    rdfs:label "Second ascent by phase-three MaN"@en, "Zweiter Aufstieg durch MaN der Stufe 3"@de ;
    skos:definition "MaN of phase three sorts AHP of stature Hokhma (haya): Atik clothes the upper three of AB of AK, AA those of SaG, AVI fixed Atik, YeSHSuT fixed AA, ZON the upper three of AVI; the righteous receive haya; Beria clothes ZA of Atzilut (ruah), Yetzira the Nukva (nefesh), Assiya Beria, so that Assiya is completed with all NRN of BYA."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §170, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §172
#

pmc:KabbalahAshlagAliyaShlishit a pm:Conceptualizing ;
    rdfs:label "Third ascent by phase-four MaN"@en, "Dritter Aufstieg durch MaN der Stufe 4"@de ;
    skos:definition "MaN of phase four sorts AHP of stature Keter (yehida): Atik clothes the upper three of Galgalta, AA of AB, AVI of SaG, YeSHSuT of MaH, ZON of BoN of AK; the righteous receive yehida from ZON; Beria clothes YeSHSuT (neshama of Atzilut), Yetzira ZA (ruah), Assiya the Nukva (nefesh)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §172, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §173
#

pmc:KabbalahAshlagMatzavBeAliyaShlishit a pm:Conceptualizing ;
    rdfs:label "State at the third ascent: Atzilut completed, BYA above the parsa"@en, "Zustand im dritten Aufstieg: Azilut vollständig, BJA über der Parsa"@de ;
    skos:definition "At the third ascent each of Atzilut's five partzufim is completed with neshama, haya, yehida from its AK counterpart; the righteous gain their missing upper three; BYA, which in the fixed state hold only NRN of Hasadim cut off from Hokhma by the parsa, rise above it and have NRN of Atzilut, Hokhma shining in their Hasadim."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §173, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §174
#

pmc:KabbalahAshlagNishmotTzaddiqimBeBYA a pm:Conceptualizing ;
    rdfs:label "Souls of the righteous permanently clothe BYA; worlds grow by their reception"@en, "Seelen der Gerechten bekleiden BJA; Welten wachsen mit ihrem Empfang"@de ;
    skos:definition "In the fixed state the righteous NRN clothe only BYA: nefesh the ten sefirot of Assiya, ruah of Yetzira, neshama of Beria; what they receive from ZON reaches them only through BYA; therefore BYA grow only by the measure of abundance the righteous receive, according to the MaN they sort."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §174, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §175
#

pmc:KabbalahAshlagGimelRishonotRaqBeMaN a pm:Conceptualizing ;
    rdfs:label "Beyond six extremities only by MaN of the righteous and by ascent"@en, "Über WaK nur durch MaN der Gerechten und Aufstieg"@de ;
    skos:definition "In the fixed state everything, even the righteous souls, is only six extremities; all mohin beyond that come only through MaN raised by the righteous and can be received only by the lower rising to the upper's place, since for the bodies these are still first-kind sortings; the second kind for the seven lower comes only at the final correction."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §175, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagMeqomBYAReiqBeAliya a pm:Conceptualizing ;
    rdfs:label "When BYA ascend, their fixed place is empty; husks below the chest of Yetzira"@en, "Steigen BJA auf, ist ihr Ort leer; Schalen unter der Brust von Jezira"@de ;
    skos:definition "When BYA rise to Atzilut their fixed place below the parsa is left empty of holy light; above the chest of Yetzira there is then neither holiness nor husks, below it there are husks, since that is their dwelling (holiness descended there only through Adam's sin)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §175, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §176
#

pmc:KabbalahAshlagMohinEinamQevuim a pm:Conceptualizing ;
    rdfs:label "Mohin beyond six extremities are not fixed: they depend on deeds"@en, "Mochin über WaK sind nicht fest: sie hängen an Taten"@de ;
    skos:definition "Since the mohin above six extremities come only through the lower ones' MaN, they are not permanent in the partzufim; when the lower spoil their deeds they depart. The fixed mohin set by the Emanator never change, since they are neither enlarged nor blemished by the lower."@en ;
    skos:note "Counted as a failure condition: the text names an outcome that does not come about or is lost, and its cause. It names how pmc:KabbalahAshlagAliyatHaOlamot fails or is lost."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §176, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §177
#

pmc:KabbalahAshlagAliyotLefiMaHDekhurin a pm:Conceptualizing ;
    rdfs:label "Ascents reckoned by the male MaH partzufim only"@en, "Aufstiege nur nach den männlichen MaH-Parzufim berechnet"@de ;
    skos:definition "Against the difficulty that AA of BoN is Keter and AVI Hokhma of Nekudim, the author answers that BoN partzufim are female with no receiving of their own; ascents (attainment of mohin from above) are reckoned only for the male MaH partzufim; AA of MaH has only Hokhma and AVI of MaH only Bina, so their counterparts are AB and SaG of AK, while Keter of AK relates to Atik alone."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §177, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §178
#

pmc:KabbalahAshlagSullamHaMadregot a pm:Conceptualizing ;
    rdfs:label "Ladder of degrees never changes through ascents"@en, "Stufenleiter ändert sich durch Aufstiege nie"@de ;
    skos:definition "The ladder of degrees as in the fixed mohin never changes through the ascents: since the righteous can receive only when all upper ones transmit from the Infinite, as one degree rises all degrees up to the Infinite rise with it, each to its upper, so relative order is preserved (illustrated in diagrams 3 onward of the tree)."@en ;
    skos:note "Hebrew term in the text: סולם המדרגות (sullam ha-madregot)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §178, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §179
#

pmc:KabbalahAshlagOmdimBiMqomamQavua a pm:Conceptualizing ;
    rdfs:label "Ascended partzufim also remain in their fixed place; three degrees shine together"@en, "Aufgestiegene bleiben auch am festen Ort; drei Stufen leuchten zugleich"@de ;
    skos:definition "Even after ascending, partzufim leave their whole degree in the fixed or former place, nothing in spiritual matters being lost; so e.g. the upper three of AA, AVI and YeSHSuT shine at once in one place; one must always distinguish an ascent relative to the uppers in their fixed state and relative to the uppers that also rose."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §179, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §180
#

pmc:KabbalahAshlagKlalUFeratShavim a pm:Systematizing ;
    rdfs:label "General and particular are alike: every detail divides into Keter and ABYA"@en, "Allgemeines und Einzelnes gleich: jedes Detail in Keter und ABJA"@de ;
    skos:definition "As reality in general is five worlds (AK = Keter; ABYA = Hokhma, Bina, ZON), every smallest detail contains all five: the head of each partzuf is its Keter (AK), mouth to chest its Atzilut, chest to navel its Beria, navel to the end of the feet its Yetzira and Assiya."@en ;
    pm:compiledBy "Yehuda Leib Ashlag, in the Petiḥa le-Ḥokhmat ha-Qabbala" ;
    dcterms:date "1945"^^xsd:gYear ;
    skos:note "Hebrew term in the text: כלל ופרט שוים (kelal u-ferat shavim)."@en ;
    skos:note "The ordering is the author's: he arranges the Lurianic material he expounds; the date is that of the printing read."@en ;
    skos:note "A correspondence between the general and the particular, not a series of stages; entered as an ordering."@en ;
    pm:attestedBy pm:compilerInference ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §180, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §181
#

pmc:KabbalahAshlagKinuyim a pm:Conceptualizing ;
    rdfs:label "Many designations of the ten sefirot"@en, "Viele Bezeichnungen der zehn Sefirot"@de ;
    skos:definition "The ten sefirot are variously called skull-eyes and AHP; KHB ZON; NRNHY; the yod's tip plus four letters; simple HaVaYaH and AB, SaG, MaH, BoN; AA, AVI, ZON; AK with ABYA, or Keter with ABYA; Malkhut of Keter is called mouth, of Atzilut chest, of Beria navel, of Yetzira crown of Yesod, Malkhut of the whole end of the feet."@en ;
    skos:note "Hebrew term in the text: כינויים (kinuyim)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §181, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagMilluim a pm:Conceptualizing ;
    rdfs:label "Four fillings of HaVaYaH: AB, SaG, MaH, BoN"@en, "Vier Füllungen von HWYH: AB, SaG, MaH, BoN"@de ;
    skos:definition "AB, SaG, MaH and BoN are four ways of spelling out the letters of the Tetragrammaton (with yod, mixed yod/alef, alef, and he fillings respectively), whose numerical values give the names."@en ;
    skos:note "Hebrew term in the text: מילואים (milluʾim)."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §181, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §182
#

pmc:KabbalahAshlagShinuiShemShteiHorayot a pm:Conceptualizing ;
    rdfs:label "Every change of name carries two indications"@en, "Jede Namensänderung trägt zwei Hinweise"@de ;
    skos:definition "Each changed designation of a sefira indicates both its equivalence to the sefira it is attributed to and its difference from it, for which it received a special name; e.g. Infinite, every head, all five AK partzufim, Atik and AA are all called Keter, alike in one respect and far apart in another."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §182, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

pmc:KabbalahAshlagOrBliKliEinSof a pm:Conceptualizing ;
    rdfs:label "Light not clothed in a vessel counts as Infinite; no grasp of first-restriction vessels"@en, "Unbekleidetes Licht gilt als Unendliches; kein Zugriff auf Gefäße der ersten Einschränkung"@de ;
    skos:definition "Rule: upper light not yet clothed in any vessel counts as Infinite; hence all five AK partzufim are, relative to the world of correction, light without vessel, since we have no grasp at all of first-restriction vessels."@en ;
    skos:note "Statement on the limits of what is attainable."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §182, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §183
#

pmc:KabbalahAshlagKeterABYAPanimAhorayim a pm:Conceptualizing ;
    rdfs:label "Keter-ABYA naming marks the front/back division from the second restriction"@en, "Keter-ABJA bezeichnet die Teilung durch die zweite Einschränkung"@de ;
    skos:definition "The specific indication of naming the ten sefirot Keter and ABYA is their division into front and back vessels made by the second restriction: the parsa at the chest divides each degree so that above the chest is Atzilut and below it BYA."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §183, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §184
#

pmc:KabbalahAshlagAKRoshVeABYA a pm:Conceptualizing ;
    rdfs:label "AK itself divided into head and ABYA"@en, "AK selbst in Kopf und ABJA geteilt"@de ;
    skos:definition "The division begins in AK, but there the parsa came down to its navel: Galgalta is the head, AB and SaG ending above the navel are its Atzilut, MaH and BoN below the navel its BYA."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §184, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §185
#

pmc:KabbalahAshlagAtzilutRoshVeABYA a pm:Conceptualizing ;
    rdfs:label "Atzilut divided into head and ABYA; parsa at AA's chest"@en, "Azilut in Kopf und ABJA geteilt; Parsa an der Brust des AA"@de ;
    skos:definition "AA is the head of Atzilut; upper AVI (AB) from AA's mouth to its chest are Atzilut of Atzilut, with the parsa at the chest, its true place; YeSHSuT (SaG) from chest to navel are its Beria; ZON (MaH-BoN) from navel to the end are its Yetzira and Assiya."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §185, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §186
#

pmc:KabbalahAshlagGalgaltaABSaGRoshHaOlamot a pm:Conceptualizing ;
    rdfs:label "Overall: Galgalta-AB-SaG as head of all worlds"@en, "Gesamt: Galgalta-AB-SaG als Kopf aller Welten"@de ;
    skos:definition "In the totality of worlds AK's Galgalta, AB and SaG form the general head; Atzilut's five partzufim from AK's navel to the general parsa are general Atzilut; below the parsa stand the general BYA."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
    dcterms:source "Ashlag, Petiḥa le-Ḥokhmat ha-Qabbala, §186, Hebrew text of the Jerusalem 1945 printing with the Sulam commentary on the Zohar as given in the Sefaria library (edition from Sefaria's version record; no title page in the text layer); translations compared: Bnei Baruch; Steinhart 2023 covers §1-45 only" .

#
# §187
#

pmc:KabbalahAshlagMalkhutDeMalkhutDeAsiya a pm:Conceptualizing ;
    rdfs:label "Even Malkhut of Malkhut of Assiya divides into head and ABYA"@en, "Selbst Malchut der Malchut in Assija teilt sich in Kopf und ABJA"@de ;
    skos:definition "Every degree of the finest detail in every world divides into head and ABYA, down to Malkhut of Malkhut of Assiya: head and body, the body divided at chest, navel and end of feet; HGT to chest = Atzilut, lower Tiferet = Beria, NHY = Yetzira, Malkhut = Assiya."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Kabbalah ;
    pm:fromWork pmw:PetihaLeHokhmatHaQabbala ;
