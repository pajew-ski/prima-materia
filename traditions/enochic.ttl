pmc:ShemihazahTeachesRootCutting a pm:Attributing ;
    rdfs:label "Shemihazah discloses root-cutting"@en, "Schemichasa offenbart das Wurzelschneiden"@de ;
    pm:ascribedTo pmc:Shemihazah ;
