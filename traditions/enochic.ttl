    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Enochic ;
    dcterms:source "1 Enoch 8:3 (Ethiopic; Charles 1912)" .

pmc:BaraqelTeachesAstrology a pm:Attributing ;
    rdfs:label "Baraqel discloses astrology"@en, "Baraqel offenbart die Astrologie"@de ;
    pm:ascribedTo pmc:Baraqel ;
    pm:ascribedCapacity pmc:Astrology ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Enochic ;
    dcterms:source "1 Enoch 8:3 (Ethiopic; Charles 1912)" .

pmc:KokabelTeachesConstellations a pm:Attributing ;
    rdfs:label "Kokabel discloses the constellations"@en, "Kokabel offenbart die Sternbilder"@de ;
    pm:ascribedTo pmc:Kokabel ;
    pm:ascribedCapacity pmc:Constellations ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Enochic ;
    dcterms:source "1 Enoch 8:3 (Ethiopic; Charles 1912)" .

pmc:EzeqeelTeachesKnowledgeOfClouds a pm:Attributing ;
    rdfs:label "Ezeqeel discloses the knowledge of the clouds"@en, "Ezeqeel offenbart die Wolkenkunde"@de ;
    pm:ascribedTo pmc:Ezeqeel ;
    pm:ascribedCapacity pmc:KnowledgeOfClouds ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Enochic ;
    dcterms:source "1 Enoch 8:3 (Ethiopic; Charles 1912)" .

pmc:AraqielTeachesSignsOfTheEarth a pm:Attributing ;
    rdfs:label "Araqiel discloses the signs of the earth"@en, "Araqiel offenbart die Zeichen der Erde"@de ;
    pm:ascribedTo pmc:Araqiel ;
    pm:ascribedCapacity pmc:SignsOfTheEarth ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Enochic ;
    dcterms:source "1 Enoch 8:3 (Ethiopic; Charles 1912)" .

pmc:ShamsielTeachesSignsOfTheSun a pm:Attributing ;
    rdfs:label "Shamsiel discloses the signs of the sun"@en, "Schamsiel offenbart die Zeichen der Sonne"@de ;
    pm:ascribedTo pmc:Shamsiel ;
    pm:ascribedCapacity pmc:SignsOfTheSun ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Enochic ;
    dcterms:source "1 Enoch 8:3 (Ethiopic; Charles 1912)" .

pmc:SarielTeachesCourseOfTheMoon a pm:Attributing ;
    rdfs:label "Sariel discloses the course of the moon"@en, "Sariel offenbart den Lauf des Mondes"@de ;
    pm:ascribedTo pmc:Sariel ;
    pm:ascribedCapacity pmc:CourseOfTheMoon ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Enochic ;
    dcterms:source "1 Enoch 8:3 (Ethiopic; Charles 1912)" .

#
# Ascriptions — Book of the Watchers, Aramaic-Greek reconstruction
#
# Four positions in the same list where the witnesses disagree about the
# content of the teaching. They are held separately rather than merged: a
# merged node would report a text that neither witness gives.
#

pmc:BaraqelTeachesSignsOfLightning a pm:Attributing ;
    rdfs:label "Baraqel discloses the signs of the lightning flashes"@en, "Baraqel offenbart die Zeichen der Blitze"@de ;
    pm:ascribedTo pmc:Baraqel ;
    pm:ascribedCapacity pmc:SignsOfLightning ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Enochic ;
    skos:note "Stands in the position the Ethiopic fills with astrology."@en ;
    dcterms:source "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)" .

pmc:KokabelTeachesSignsOfTheStars a pm:Attributing ;
    rdfs:label "Kokabel discloses the signs of the stars"@en, "Kokabel offenbart die Zeichen der Sterne"@de ;
    pm:ascribedTo pmc:Kokabel ;
    pm:ascribedCapacity pmc:SignsOfTheStars ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Enochic ;
    skos:note "Stands in the position the Ethiopic fills with the constellations."@en ;
    dcterms:source "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)" .

pmc:ZiqelTeachesSignsOfShootingStars a pm:Attributing ;
    rdfs:label "Ziqel discloses the signs of the shooting stars"@en, "Ziqel offenbart die Zeichen der Sternschnuppen"@de ;
    pm:ascribedTo pmc:Ziqel ;
    pm:ascribedCapacity pmc:SignsOfShootingStars ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Enochic ;
    skos:note "Stands in the position the Ethiopic fills with Ezeqeel and the knowledge of the clouds."@en ;
    dcterms:source "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)" .

pmc:SarielTeachesSignsOfTheMoon a pm:Attributing ;
    rdfs:label "Sariel discloses the signs of the moon"@en, "Sariel offenbart die Zeichen des Mondes"@de ;
    pm:ascribedTo pmc:Sariel ;
    pm:ascribedCapacity pmc:SignsOfTheMoon ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Enochic ;
    skos:note "Given under the name Sahriel; stands in the position the Ethiopic fills with the course of the moon."@en ;
    dcterms:source "1 Enoch 8:3 (Aramaic/Greek reconstruction; Nickelsburg 2001)" .

#
# Ascriptions — Book of Parables
#
# No fragment of chapters 37-71 has been identified among the Qumran Aramaic
# manuscripts. These four ascriptions rest on the Ethiopic alone, and each
# says so, because the reach of the manuscript record belongs to the
# provenance of the claim and not to a footnote about it.
#

pmc:GadreelTeachesWeaponsOfDeath a pm:Attributing ;
    rdfs:label "Gadreel discloses the weapons of death"@en, "Gadreel offenbart die Waffen des Todes"@de ;
    pm:ascribedTo pmc:Gadreel ;
    pm:ascribedCapacity pmc:WeaponsOfDeath ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Enochic ;
    skos:note "Book of Parables; no Aramaic fragment of chapters 37-71 is attested at Qumran."@en ;
    dcterms:source "1 Enoch 69:6 (Ethiopic; Charles 1912)", "J.T. Milik, The Books of Enoch: Aramaic Fragments of Qumrân Cave 4 (Oxford, 1976)" .

pmc:PenemueTeachesBitterAndSweet a pm:Attributing ;
    rdfs:label "Penemue discloses bitter and sweet"@en, "Penemue offenbart bitter und süß"@de ;
    pm:ascribedTo pmc:Penemue ;
    pm:ascribedCapacity pmc:DiscernmentOfBitterAndSweet ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Enochic ;
    skos:note "Book of Parables; no Aramaic fragment of chapters 37-71 is attested at Qumran."@en ;
    dcterms:source "1 Enoch 69:8 (Ethiopic; Charles 1912)", "J.T. Milik, The Books of Enoch: Aramaic Fragments of Qumrân Cave 4 (Oxford, 1976)" .

