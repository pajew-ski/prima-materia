pmc:TheosophyArousalYieldsConscientiam a pm:Yielding ;
    pm:fromWork pmw:TheInnerLife ;
    rdfs:label "Arousing the fire through the crown centre yields unbroken consciousness"@en, "Das Feuer durch das Scheitelzentrum zu fuehren bringt ununterbrochenes Bewusstsein hervor"@de ;
