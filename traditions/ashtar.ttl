pmc:AshtarTransmissionThoughtAsLineYielding a pm:Yielding ;
    rdfs:label "Thought used as a line of light is said to reach the Ever Presence"@en, "Als Lichtlinie gebrauchtes Denken soll die Immerwährende Gegenwart erreichen"@de ;
    pm:byPractice pmp:AshtarTransmissionThoughtAsLine ;
    pm:yieldsCapacity pmc:AshtarTransmissionContactWithTheEverPresence ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:AshtarTransmission ;
