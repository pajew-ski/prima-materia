pmc:AshtarTransmissionJoiningHandsYielding a pm:Yielding ;
    rdfs:label "Joining hands is said to let the group receive and feel the substance beam"@en, "Das Händefassen soll die Gruppe den Substanzstrahl empfangen und fühlen lassen"@de ;
    skos:note "Noot excepts the times when projections from Lem and Cor are coming in; the work does not say what happens then."@en ;
    pm:byPractice pmp:AshtarTransmissionJoiningHands ;
    pm:yieldsCapacity pmc:AshtarTransmissionInnerPerception ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:AshtarTransmission ;
    pm:fromWork pmw:AshtarTransmissionIRodeAFlyingSaucer ;
