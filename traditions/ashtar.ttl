pmc:AshtarTransmissionInnerVoiceYielding a pm:Yielding ;
    rdfs:label "Listening to the inner voice is said to let the reader recognize truth"@en, "Das Hören auf die innere Stimme soll den Leser Wahrheit erkennen lassen"@de ;
    pm:byPractice pmp:AshtarTransmissionInnerVoice ;
    pm:yieldsCapacity pmc:AshtarTransmissionRecognizingTruth ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:AshtarTransmission ;
