pmc:AshtarTransmissionRayYielding a pm:Yielding ;
    rdfs:label "The rayed substance is said to benefit the body and to better the reception"@en, "Die gestrahlte Substanz soll dem Körper nützen und den Empfang verbessern"@de ;
    skos:note "Two messages, Dulac's for the body and Portla's for reception. The only bodily act asked of the group is to be present."@en ;
    pm:byPractice pmp:AshtarTransmissionReceivingTheRay ;
    pm:yieldsCapacity pmc:AshtarTransmissionBodilyBenefit, pmc:AshtarTransmissionInnerPerception ;
    pm:attestedBy pm:textualAttestation ;
