pmc:TranserfingKrishnaAsHigherManifestationCh17 a pm:Naming ;
    rdfs:label "Krishna as a higher manifestation of the Lord"@en, "Krishna als höhere Erscheinung des Herrn"@de ;
    skos:definition "Held, with Jesus, Mohammed and Buddha, to be a higher manifestation of the Lord, of whom ordinary people are lesser manifestations."@en ;
    pm:nameForm "Krishna" ;
    pm:nameRole "higher manifestation of the Lord" ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
