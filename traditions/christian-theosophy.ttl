pmc:ChristianTheosophyStundeSchweigensFuehrtHoerenGoettlicher a pm:Yielding ;
    rdfs:label "Hour of silence yields hearing unspeakable divine words"@en, "Stunde des Schweigens führt zum Hören göttlicher Worte"@de ;
    skos:definition "One hour of silence from willing and thinking yields hearing unspeakable words of God."@en ;
    pm:byPractice pmp:ChristianTheosophyStundeSchweigenWollenSinnen ;
