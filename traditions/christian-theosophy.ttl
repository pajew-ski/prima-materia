pmc:ChristianTheosophyEwigen a pm:Conceptualizing ;
    rdfs:label "Being in the eternal One"@en, "Im ewigen Einen sein"@de ;
    skos:definition "Being in the eternal One (God himself) and feeling the highest virtue of love."@en ;
    skos:note "Term as printed: das ewige Ein."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChristianTheosophy ;
    pm:fromWork pmw:VomUebersinnlichenLeben ;
