pmp:ChristianTheosophyStillstehenSinnenWollenSelbheit a pm:Practicing ;
    rdfs:label "Standing still from selfhood's thinking and willing"@en, "Stillstehen vom Sinnen und Wollen der Selbheit"@de ;
    skos:definition "Halt all mental activity and wanting that belong to one's selfhood (Selbheit)."@en ;
    skos:note "Term as printed: Selbheit; stille stehen."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChristianTheosophy ;
