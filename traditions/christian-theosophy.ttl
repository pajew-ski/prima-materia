pmc:ChristianTheosophyHassWeltGegenGewandelten a pm:Cautioning ;
    rdfs:label "The world's hatred toward the changed person"@en, "Hass der Welt gegen den Gewandelten"@de ;
    skos:definition "Warning raised and accepted: the world will hate and despise such a person because he must contradict it and live and act differently."@en ;
    pm:cautionsAbout pmp:ChristianTheosophyStuendigerAbbruchWillensKreaturen ;
    pm:attestedBy pm:textualAttestation ;
