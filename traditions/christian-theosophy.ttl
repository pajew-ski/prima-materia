pmp:ChristianTheosophyAugenblickKreaturlosenOrt a pm:Practicing ;
    rdfs:label "A moment cast into the creatureless place"@en, "Ein Augenblick im kreaturlosen Ort"@de ;
    skos:definition "For a single moment throw oneself into that where no creature dwells; then one hears what God speaks."@en ;
    skos:note "Verb garbled in OCR (\"in das ed\"); the parallel wording in §15 uses \"dahin schwingen\"."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChristianTheosophy ;
