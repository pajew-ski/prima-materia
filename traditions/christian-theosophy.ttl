pmc:ChristianTheosophyZeichenLiebeBrenntSeeleLeib a pm:Conceptualizing ;
    rdfs:label "Sign: love burning in soul and body"@en, "Zeichen: Liebe brennt in Seele und Leib"@de ;
    skos:definition "Announced sign: once this great love is lit within, one feels it in soul and body; it burns as no fire can."@en ;
    skos:note "Counted as a sign of success, announced in advance."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChristianTheosophy ;
    pm:fromWork pmw:VomUebersinnlichenLeben ;
