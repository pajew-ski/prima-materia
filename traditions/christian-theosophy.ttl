pmp:ChristianTheosophyStuendigerAbbruchWillensKreaturen a pm:Practicing ;
    rdfs:label "An hour's break of the will from all creatures"@en, "Stündiger Abbruch des Willens von allen Kreaturen"@de ;
    skos:definition "Let the will break itself off from all creatures for one hour and swing itself to where no creature is."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChristianTheosophy ;
    pm:fromWork pmw:VomUebersinnlichenLeben ;
