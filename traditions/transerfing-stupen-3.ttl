pmc:TranserfingSensingTheEnergyFlowDevelopsCh11 a pm:Conceptualizing ;
    rdfs:label "Sensing the energy flow develops"@en, "Das Spüren des Energieflusses entwickelt sich"@de ;
    skos:definition "Announced: the central meridians will soon be felt physically, tangibly if not as directly as touch."@en ;
    skos:note "Sign of success announced in advance: announced for pmp:TranserfingEnergyFountainsAndProtectiveSphereCh11."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
    pm:fromWork pmw:TranserfingStupen3 ;
