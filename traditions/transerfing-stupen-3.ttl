pmc:TranserfingPreventDepressionKeepingIntentionEnergyUpCh15 a pm:Cautioning ;
    rdfs:label "Prevent depression by keeping intention energy up"@en, "Depression vorbeugen durch hohe Absichtsenergie"@de ;
    skos:definition "A depressed state signals very low intention energy; better to keep energy healthy from the start and so avoid falling into it."@en ;
    skos:note "The energy meant is pmc:TranserfingEnergiyaNamereniya."@en ;
    pm:cautionsAbout pmc:TranserfingAsymmetryDarkeningBrighteningCh15 ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:Transerfing ;
