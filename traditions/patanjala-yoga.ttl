@prefix pm:      <https://pajew.ski/prima-materia/ontology#> .
@prefix pmt:     <https://pajew.ski/prima-materia/traditions/> .
@prefix pmc:     <https://pajew.ski/prima-materia/concepts/> .
@prefix pmp:     <https://pajew.ski/prima-materia/practices/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#
# prima-materia — Pātañjala Yoga
#
# The claim form here differs from the Enochic one. Nothing is ascribed to a
# named figure: the text says that a practice yields a capacity. That is why
# these nodes are pm:Practicing with pm:yieldsCapacity and not pm:Attributing.
#

pmt:PatanjalaYoga a pm:Tradition ;
    rdfs:label "Pātañjala Yoga"@en, "Pātañjala-Yoga"@de ;
    skos:definition "The transmission of the Yogasūtra of Patañjali and its commentarial literature."@en ;
    skos:note "Edition finding, prima-materia#45. Only Yogasūtra III.38 carries the edition it was read from; it was reopened in the Sanskrit for that purpose. For every other citation in this file, and for the Yogabhāṣya, the edition or translation the passage was read from is not recoverable: the session that entered them did not record it, and it cannot be reconstructed from the wording of the nodes. It is stated here rather than guessed, because an edition entered by inference would be a claim about the compiler's work that is not true. Until the passages are reopened, the verse numbers in this file stand on the received four-pāda division and nothing further."@en ;
    dcterms:source "Patañjali, Yogasūtra" .

#
# Practices
#

pmp:Samyama a pm:Practicing ;
    rdfs:label "Saṃyama"@en, "Saṃyama"@de ;
    skos:definition "The combined application of dhāraṇā, dhyāna and samādhi to a single object, presented as the general operator from which the capacities of the third chapter follow."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:PatanjalaYoga ;
    dcterms:source "Patañjali, Yogasūtra III.1-3" .

#
# Yielding claims
#
# One node per pairing, each with the verse that carries it. The general
# operator is the same throughout; what differs is the object it is applied
# to and the capacity said to follow, and that difference is what a later
# protocol would have to test one pairing at a time.
#

pmc:SamyamaYieldsParacittaJnana a pm:Yielding ;
    rdfs:label "Saṃyama on the presented idea yields knowledge of another mind"@en, "Saṃyama auf die Vorstellung bringt Kenntnis fremden Bewusstseins hervor"@de ;
    pm:byPractice pmp:Samyama ;
    pm:yieldsCapacity pmc:ParacittaJnana ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:PatanjalaYoga ;
    dcterms:source "Patañjali, Yogasūtra III.19" .

pmc:SamyamaYieldsDivyaCaksus a pm:Yielding ;
    rdfs:label "Saṃyama on the sun yields knowledge of the world"@en, "Saṃyama auf die Sonne bringt Weltkenntnis hervor"@de ;
    pm:byPractice pmp:Samyama ;
    pm:yieldsCapacity pmc:DivyaCaksus ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:PatanjalaYoga ;
    dcterms:source "Patañjali, Yogasūtra III.26" .

pmc:SamyamaYieldsDivyaSrotra a pm:Yielding ;
    rdfs:label "Saṃyama yields the divine ear"@en, "Saṃyama bringt das göttliche Ohr hervor"@de ;
    pm:byPractice pmp:Samyama ;
    pm:yieldsCapacity pmc:DivyaSrotra ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:PatanjalaYoga ;
    dcterms:source "Patañjali, Yogasūtra III.41" .

pmc:SamyamaYieldsParakayaPravesa a pm:Yielding ;
    rdfs:label "Saṃyama yields entry into another body"@en, "Saṃyama bringt den Eintritt in einen anderen Körper hervor"@de ;
    pm:byPractice pmp:Samyama ;
    pm:yieldsCapacity pmc:ParakayaPravesa ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:PatanjalaYoga ;
    dcterms:source "Patañjali, Yogasūtra III.38 (Sanskrit sūtra text; received four-pāda numbering)" .

pmp:Pranayama a pm:Practicing ;
    rdfs:label "Prāṇāyāma"@en, "Prāṇāyāma"@de ;
    skos:definition "The regulation of the breath as a distinct limb of practice, following posture and preceding the withdrawal of the senses."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:PatanjalaYoga ;
    dcterms:source "Patañjali, Yogasūtra II.49-53" .

#
# Capacities
#

pmc:ParacittaJnana a pm:Conceptualizing ;
    rdfs:label "Knowledge of another mind"@en, "Kenntnis fremden Bewusstseins"@de ;
    skos:definition "Knowledge of the contents of another consciousness, said to follow from saṃyama on the presented idea."@en ;
    pm:withinTradition pmt:PatanjalaYoga ;
    dcterms:source "Patañjali, Yogasūtra III.19" .

pmc:DivyaCaksus a pm:Conceptualizing ;
    rdfs:label "Divine eye"@en, "Göttliches Auge"@de ;
    skos:definition "Perception of what is distant, hidden or obstructed."@en ;
    pm:withinTradition pmt:PatanjalaYoga ;
    dcterms:source "Patañjali, Yogasūtra III.26" .

pmc:DivyaSrotra a pm:Conceptualizing ;
    rdfs:label "Divine ear"@en, "Göttliches Ohr"@de ;
    skos:definition "Hearing beyond the range of the physical ear."@en ;
    pm:withinTradition pmt:PatanjalaYoga ;
    dcterms:source "Patañjali, Yogasūtra III.41" .

pmc:ParakayaPravesa a pm:Conceptualizing ;
    rdfs:label "Entering another body"@en, "Eintritt in einen anderen Körper"@de ;
    skos:definition "The transfer of the seat of awareness into a body other than one's own."@en ;
    pm:withinTradition pmt:PatanjalaYoga ;
    dcterms:source "Patañjali, Yogasūtra III.38 (Sanskrit sūtra text; received four-pāda numbering)" .

#
# Prerequisite claims, and one ordering act
#
# The interesting finding here is negative. The often repeated claim that the
# eight limbs must be traversed in order is not in the sūtra that lists them:
# II.29 is a bare enumeration. What the base text does set is a ranking, and
# a ranking is not a necessity. The difference is recorded rather than
# smoothed, because the smoothing is how a modern pedagogy acquired an
# ancient warrant it was never given.
#

pmc:AstangaLimbs a pm:Conceptualizing ;
    rdfs:label "The eight limbs"@en, "Die acht Glieder"@de ;
    skos:definition "Restraint, observance, posture, breath regulation, withdrawal of the senses, concentration, meditation and absorption, listed together in a single sūtra."@en ;
    skos:note "The sūtra names them and says nothing about traversing them in order."@en ;
    pm:withinTradition pmt:PatanjalaYoga ;
    dcterms:source "Patañjali, Yogasūtra II.29" .

pmc:SamyamaIsInnerToThePrecedingLimbs a pm:Presupposing ;
    rdfs:label "The three inner limbs are inner to the preceding five"@en, "Die drei inneren Glieder sind innerlicher als die vorhergehenden fünf"@de ;
    pm:dependentStep pmp:Samyama ;
    pm:priorStep pmc:AstangaLimbs ;
    pm:prerequisiteStrength pm:prescribedOrder ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:PatanjalaYoga ;
    skos:note "The base text ranks the last three limbs as inner with respect to the preceding five, and then ranks even those three as outer with respect to the seedless absorption. It sets a relation of inner and outer, not a rule that one cannot be attempted before the other, and it says nothing about what follows from disregarding the ranking."@en ;
    dcterms:source "Patañjali, Yogasūtra III.7", "Patañjali, Yogasūtra III.8" .

pmc:LightOfKnowledge a pm:Conceptualizing ;
    rdfs:label "The light of knowledge"@en, "Das Leuchten der Erkenntnis"@de ;
    skos:definition "What is said to arise, on the wearing away of impurity, and to continue up to discriminative discernment."@en ;
    pm:withinTradition pmt:PatanjalaYoga ;
    dcterms:source "Patañjali, Yogasūtra II.28" .

pmp:PracticeOfTheLimbs a pm:Practicing ;
    rdfs:label "Practice of the limbs"@en, "Übung der Glieder"@de ;
    skos:definition "The performance of the eight limbs, taken together as one course of practice."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:PatanjalaYoga ;
    dcterms:source "Patañjali, Yogasūtra II.28" .

pmc:LimbPracticeYieldsLightOfKnowledge a pm:Yielding ;
    rdfs:label "Practice of the limbs yields the light of knowledge"@en, "Die Übung der Glieder bringt das Leuchten der Erkenntnis hervor"@de ;
    pm:byPractice pmp:PracticeOfTheLimbs ;
    pm:yieldsCapacity pmc:LightOfKnowledge ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:PatanjalaYoga ;
    skos:note "The sūtra makes the arising conditional on the wearing away of impurity, which is itself said to come from the practice. The condition is part of the claim and is not to be dropped when the claim is quoted."@en ;
    dcterms:source "Patañjali, Yogasūtra II.28" .

pmc:LimbOrderDispute a pm:Disputing ;
    rdfs:label "Whether the limbs must be traversed in order"@en, "Ob die Glieder der Reihe nach zu durchlaufen sind"@de ;
    skos:definition "A disagreement about whether the eight limbs form a sequence that must be climbed. The sūtra that names them enumerates and says nothing about order; the commentarial layer introduces the categories of outer and inner limb, and later teaching hardens these into a rule of practice."@en ;
    skos:note "The disagreement is not between two traditions but between a base text and its readers, which is the commonest shape a dispute takes in this collection and the easiest to lose, because the readers usually win by default."@en ;
    pm:disputedClaim pmc:AstangaLimbs ;
    pm:attestedBy pm:textualAttestation ;
    dcterms:source "Patañjali, Yogasūtra II.29", "Vyāsa, Yogabhāṣya on Yogasūtra II.29" .

pmc:SerialReadingOfTheEightLimbs a pm:Systematizing ;
    rdfs:label "The serial reading of the eight limbs"@en, "Die serielle Lesart der acht Glieder"@de ;
    skos:definition "The reading of the eight limbs as a ladder that must be climbed in order, each limb a precondition of the next."@en ;
    skos:note "The inner and outer categories come from the commentarial layer, and the hardening of the ranking into a rule of practice belongs to twentieth-century yoga pedagogy. Recorded here so that the reading is available as what it is. The base text at II.29 enumerates and does not order."@en ;
    pm:ordersClaim pmc:AstangaLimbs ;
    pm:compiledBy "The commentarial tradition, sharpened in twentieth-century yoga pedagogy" ;
    pm:attestedBy pm:compilerInference ;
    dcterms:date "20th century" ;
    dcterms:source "Patañjali, Yogasūtra II.29" .

#
# Caution
#

pmc:SiddhisAsObstacle a pm:Cautioning ;
    rdfs:label "The powers are obstacles to samādhi"@en, "Die Kräfte sind Hindernisse für samādhi"@de ;
    skos:definition "The capacities of the third chapter are named obstacles with respect to samādhi and attainments only with respect to the outward-turned state. The tradition that catalogues them is the same one that warns against them."@en ;
    pm:cautionsAbout pmc:ParacittaJnana, pmc:DivyaCaksus, pmc:DivyaSrotra, pmc:ParakayaPravesa ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:PatanjalaYoga ;
    dcterms:source "Patañjali, Yogasūtra III.37" .

#
# Placement on the awareness axes.
#

pmc:SamyamaIsWithdrawnAbsorption a pm:Situating ;
    rdfs:label "Saṃyama is withdrawn absorption"@en, "Saṃyama ist abgezogene Vertiefung"@de ;
    pm:situatedNode pmp:Samyama ;
    pm:axisValue pm:withdrawnAbsorption ;
    pm:situationGround "The three members are defined in sequence as the binding of the mind to one place, an unbroken flow of attention to that same place, and the same again with the object alone shining forth; the fourth sūtra names the three taken together on one object as saṃyama. That is the criterion this value states — awake, the senses off their objects, attention held on a single one — given in the base text rather than inferred from the capacities. The withdrawal of the senses is a separate limb preceding the three."@en ;
    skos:note "Numbering. The three members stand at III.1-3 and their combination at III.4 in the received division; the practice node in this file cites III.1-3 alone. See prima-materia#456."@en ;
    pm:attestedBy pm:compilerInference ;
    dcterms:source "Patañjali, Yogasūtra III.1-4" .

pmc:SamyamaHoldsOwnAgency a pm:Situating ;
    rdfs:label "Saṃyama holds its own agency"@en, "Saṃyama behält die eigene Trägerschaft"@de ;
    pm:situatedNode pmp:Samyama ;
    pm:axisValue pm:ownAgency ;
    pm:situationGround "The base text has the practitioner bind his own mind and hold it, and the capacities of the third chapter are said to follow from his doing so. Nothing in these sūtras has another speak or act through him; what is claimed is credited to the practice."@en ;
    pm:attestedBy pm:compilerInference ;
    dcterms:source "Patañjali, Yogasūtra III.1-4" .

pmc:SamyamaIsByEffort a pm:Situating ;
    rdfs:label "Saṃyama is attained by effort"@en, "Saṃyama wird durch Anstrengung erlangt"@de ;
    pm:situatedNode pmp:Samyama ;
    pm:axisValue pm:byEffort ;
    pm:situationGround "The practice is the deliberate application of three named means to one object, and the text elsewhere makes the arising of knowledge conditional on the wearing away of impurity through the practice of the limbs. Nothing here arrives unworked for."@en ;
    pm:attestedBy pm:compilerInference ;
    dcterms:source "Patañjali, Yogasūtra III.1-4", "Patañjali, Yogasūtra II.28" .

pmc:SamyamaLocusNotStated a pm:Situating ;
    rdfs:label "Saṃyama does not state a locus"@en, "Saṃyama gibt keinen Ort an"@de ;
    pm:situatedNode pmp:Samyama ;
    pm:axisValue pm:locusNotStated ;
    pm:situationGround "The four sūtras were read for this question and are silent on it: they place the attention on an object and say nothing about where the awareness itself is held to be. That the collection has one capacity of displaced locus at III.38 does not settle the operator, which is applied to near and distant objects alike."@en ;
    pm:attestedBy pm:compilerInference ;
    dcterms:source "Patañjali, Yogasūtra III.1-4" .

pmc:ParakayaPravesaIsWithdrawnAbsorption a pm:Situating ;
    rdfs:label "Entering another body is performed in withdrawn absorption"@en, "Der Eintritt in einen anderen Körper geschieht in abgezogener Vertiefung"@de ;
    pm:situatedNode pmc:ParakayaPravesa ;
    pm:axisValue pm:withdrawnAbsorption ;
    pm:situationGround "The sūtra makes the entry follow from saṃyama, and the state saṃyama names is fixed by III.1-4. The placement is inherited from the operator the source itself binds the capacity to, and not read off the capacity."@en ;
    pm:attestedBy pm:compilerInference ;
    dcterms:source "Patañjali, Yogasūtra III.38 (Sanskrit sūtra text; received four-pāda numbering)", "Patañjali, Yogasūtra III.1-4" .

pmc:ParakayaPravesaIsDisplaced a pm:Situating ;
    rdfs:label "Entering another body is a displaced locus"@en, "Der Eintritt in einen anderen Körper ist ein verlagerter Ort"@de ;
    pm:situatedNode pmc:ParakayaPravesa ;
    pm:axisValue pm:displacedLocus ;
    pm:situationGround "The sūtra has the seat of awareness transferred into a body other than the practitioner's own. The awareness is thereby located away from the body it started in, which is the criterion this value names."@en ;
    pm:attestedBy pm:compilerInference ;
    dcterms:source "Patañjali, Yogasūtra III.38 (Sanskrit sūtra text; received four-pāda numbering)" .
