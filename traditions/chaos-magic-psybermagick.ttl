pmc:ChaosMagicPsyberInvestmentYieldsWealth a pm:Yielding ;
    rdfs:label "Sacrificing money only on opportunities that make money brings money"@en, "Geld nur für Gelegenheiten opfern, die Geld bringen, bringt Geld"@de ;
    skos:definition "If you want money, then sacrifice it only on opportunities which will make money."@en ;
    pm:byPractice pmp:ChaosMagicPsyberInvestNotSacrifice ;
    pm:yieldsCapacity pmc:ChaosMagicPsyberWealth ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:ChaosMagic ;
