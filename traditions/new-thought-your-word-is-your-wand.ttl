pmc:NewThoughtShinnImagingFacultyIsTheCreativeFaculty a pm:Conceptualizing ;
    rdfs:label "The imaging faculty is the creative faculty"@en, "Die Vorstellungskraft ist die schöpferische Kraft"@de ;
    skos:definition "What the mind pictures is what creates; hence words should be chosen that bring a vivid picture."@en ;
    skos:note "Author's term: \"The imaging faculty is the creative faculty\"."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnYourWordIsYourWand ;
