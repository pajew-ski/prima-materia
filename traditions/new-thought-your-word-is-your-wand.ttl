#
# Conclusion
#

pmp:NewThoughtShinnChooseTheAffirmationWhichAppealsToYou a pm:Practicing ;
    rdfs:label "Choosing the affirmation that appeals most and waving it over the situation"@en, "Die ansprechendste Affirmation wählen und über die Lage schwingen"@de ;
    skos:definition "The reader picks the affirmation that most appeals and applies it to the confronting situation as a magic wand."@en ;
    skos:note "Author's term: \"Choose the affirmation which appeals to you the most\"."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnYourWordIsYourWand ;
