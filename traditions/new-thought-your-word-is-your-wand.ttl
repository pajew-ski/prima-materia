pmc:NewThoughtShinnHappinessMustBeEarned a pm:Conceptualizing ;
    rdfs:label "Happiness must be earned"@en, "Glück muss verdient werden"@de ;
    skos:definition "Happiness is not given; it is earned by perfect control of the emotional nature."@en ;
    skos:note "Author's term: \"happiness must be earned\"."@en ;
    pm:attestedBy pm:textualAttestation ;
