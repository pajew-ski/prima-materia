pmp:NewThoughtShinnIDenyDebt a pm:Practicing ;
    rdfs:label "Denial of debt (as creditor), sending love and forgiveness"@en, "Verneinung der Schuld (als Gläubiger), mit Liebe und Vergebung"@de ;
    skos:definition "Denying debt since there is none in Divine Mind, declaring all squared and sending the debtor love and forgiveness."@en ;
    skos:note "Author's term: \"I deny debt\"."@en ;
    pm:attestedBy pm:firstPersonReport ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnYourWordIsYourWand ;
