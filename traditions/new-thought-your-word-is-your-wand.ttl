    rdfs:label "Forgiveness and good-will"@en, "Vergebung und Wohlwollen"@de ;
    skos:definition "Letting go of resentment by becoming harmonious and forgiving toward the one resented."@en ;
    skos:note "Author's term: \"only forgiveness and good-will can cure you\"."@en ;
    pm:attestedBy pm:thirdPartyAscription ;
