#
# Faith
#

pmc:NewThoughtShinnFaithKnowsItHasAlreadyReceived a pm:Conceptualizing ;
    rdfs:label "Hope looks forward, Faith knows it has already received"@en, "Hoffnung blickt voraus, Glaube weiß, dass er schon empfangen hat"@de ;
    skos:definition "Faith differs from hope in that it takes the thing as already received and acts accordingly."@en ;
    skos:note "Author's term: \"Faith knows it has already received\"."@en ;
