pmc:NewThoughtShinnYourWordIsGodInAction a pm:Conceptualizing ;
    rdfs:label "Your word is God in action"@en, "Dein Wort ist Gott in Aktion"@de ;
    skos:definition "The spoken word is divine power acting and will not return void."@en ;
    skos:note "Author's term: \"your word is God in action\"."@en ;
    skos:note "Grounded in Isaiah 55:11; Romans 10:18 as interpreted by the author."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
    pm:fromWork pmw:ScovelShinnYourWordIsYourWand ;
