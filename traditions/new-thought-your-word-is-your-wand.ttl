pmc:NewThoughtShinnMustShowActiveFaith a pm:Presupposing ;
    rdfs:label "Active faith before manifestation"@en, "Tätiger Glaube vor der Manifestation"@de ;
    skos:definition "The answer to prayer manifests only when active faith is shown; the room would never be rented until the lamp was bought."@en ;
    pm:dependentStep pmc:NewThoughtShinnAnswerToHisPrayerManifest ;
    pm:priorStep pmp:NewThoughtShinnShowActiveFaith ;
    pm:prerequisiteStrength pm:statedNecessity ;
