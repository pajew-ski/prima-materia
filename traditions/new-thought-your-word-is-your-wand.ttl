pmp:NewThoughtShinnSeesHimselfAsGodSeesHim a pm:Practicing ;
    rdfs:label "Seeing oneself as God sees one"@en, "Sich sehen, wie Gott einen sieht"@de ;
    skos:definition "Holding the image of oneself made in God's likeness and image."@en ;
    skos:note "Author's term: \"sees himself as God sees him\"."@en ;
    skos:note "Grounded in Genesis 1:27 as interpreted by the author."@en ;
    pm:attestedBy pm:textualAttestation ;
    pm:withinTradition pmt:NewThought ;
