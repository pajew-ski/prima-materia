@prefix pm:      <https://pajew.ski/prima-materia/ontology#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#
# prima-materia — SHACL validation shapes
#

#
# Every class declared in the ontology must carry at least one
# language-tagged rdfs:label and one skos:definition. Named "ProcessShape"
# per SPEC §5; in practice it applies to every owl:Class so that
# AwarenessContext and AwarenessSpace are covered as well.
#
pm:ProcessShape a sh:NodeShape ;
    sh:targetClass owl:Class ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:message "Every class requires at least one language-tagged rdfs:label."
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 1 ;
        sh:message "Every class requires a skos:definition."
    ] .

#
# Every instance of pm:Conceptualizing must carry a source reference and a
# tradition assignment.
#
pm:ConceptInstanceShape a sh:NodeShape ;
    sh:targetClass pm:Conceptualizing ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:message "Every concept instance requires at least one dcterms:source."
    ] ;
    sh:property [
        sh:path pm:withinTradition ;
        sh:minCount 1 ;
        sh:message "Every concept must be situated within at least one tradition."
    ] .

#
# Every attribution declares how it entered the record and which work carries
# it. This is the constraint the whole project rests on: a claim whose
# non-evidence is correctly recorded asserts nothing it does not exhibit.
#
pm:AttributionShape a sh:NodeShape ;
    sh:targetClass pm:Attributing ;
    sh:property [
        sh:path pm:attestedBy ;
        sh:minCount 1 ;
        sh:message "Every attribution must declare how it entered the record."
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:message "Every attribution requires at least one dcterms:source."
    ] .

#
# An order may be the compiler's; the claim being ordered may not.
#
pm:CompilerInferenceScopeShape a sh:NodeShape ;
    sh:targetClass pm:Attributing ;
    sh:not [
        a sh:NodeShape ;
        sh:property [
            sh:path pm:attestedBy ;
            sh:hasValue pm:compilerInference
        ]
    ] ;
    sh:message "Compiler inference attests an ordering act (pm:Systematizing), never the claim being ordered." .

#
# An order imposed in the present is indistinguishable from an order found in
# the source unless it carries its author and its date.
#
pm:SystematizationShape a sh:NodeShape ;
    sh:targetClass pm:Systematizing ;
    sh:property [
        sh:path pm:compiledBy ;
        sh:minCount 1 ;
        sh:message "Every ordering act names the compiler who performed it."
    ] ;
    sh:property [
        sh:path dcterms:date ;
        sh:minCount 1 ;
        sh:message "Every ordering act carries the date on which it was performed."
    ] .

#
# Undifferentiated, a correspondence measures reception history. It must state
# either the route of contact that explains it or the attestation that has none.
#
pm:ConvergenceShape a sh:NodeShape ;
    sh:targetClass pm:Converging ;
    sh:or (
        [ sh:property [ sh:path pm:transmissionPath ; sh:minCount 1 ] ]
        [ sh:property [ sh:path pm:independentAttestation ; sh:minCount 1 ] ]
    ) ;
    sh:message "A convergence states either a documented transmission path or an attestation without one." .

#
# A claim of independent attestation must carry the fact that makes it
# checkable. The burden is reversed on purpose: feedback from a published
# account back into the field it describes can almost never be demonstrated,
# so a predicate marking only the demonstrated cases would let the ordinary
# case pass in silence. Nothing here devalues reception — the ground exists
# so that the same statement is not counted twice.
#
pm:IndependenceGroundShape a sh:NodeShape ;
    sh:targetClass pm:Converging ;
    sh:or (
        [ sh:property [ sh:path pm:independenceGround ; sh:minCount 1 ] ]
        [ sh:not [ sh:property [ sh:path pm:independentAttestation ; sh:minCount 1 ] ] ]
    ) ;
    sh:message "A convergence asserting pm:independentAttestation must state its pm:independenceGround: when the testimony relied on was fixed or gathered, and against which publication or route that date stands." .

#
# A reworking claims that a station added something. It must point at what.
# An addition that cannot be pointed at is an assertion about a chain and not
# a link in it, and the whole value of the class is that its instances are
# countable.
#
pm:ReworkingShape a sh:NodeShape ;
    sh:targetClass pm:Reworking ;
    sh:property [
        sh:path pm:reworkedClaim ;
        sh:minCount 1 ;
        sh:message "Every reworking must name the claim that was taken over."
    ] ;
    sh:property [
        sh:path pm:receivedFrom ;
        sh:minCount 1 ;
        sh:message "Every reworking must name the transmission the claim was taken over from."
    ] ;
    sh:property [
        sh:path pm:addedElement ;
        sh:minCount 1 ;
        sh:message "Every reworking must point at the node carrying what it added."
    ] ;
    sh:property [
        sh:path pm:attestedBy ;
        sh:minCount 1 ;
        sh:message "Every reworking must declare how it entered the record."
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:message "Every reworking requires at least one dcterms:source."
    ] ;
    sh:property [
        sh:path pm:withinTradition ;
        sh:minCount 1 ;
        sh:message "Every reworking must name the tradition that performed it."
    ] .

#
# A protocol that names no author, or no date on which its count was last
# carried forward, claims a scrutiny it does not document.
#
pm:TestingShape a sh:NodeShape ;
    sh:targetClass pm:Testing ;
    sh:property [
        sh:path pm:examinationState ;
        sh:minCount 1 ;
        sh:message "Every protocol must state how far the examination has been carried."
    ] ;
    sh:property [
        sh:path pm:examinedBy ;
        sh:minCount 1 ;
        sh:message "Every protocol must name who devised or carried it."
    ] ;
    sh:property [
        sh:path pm:protocolUpdated ;
        sh:minCount 1 ;
        sh:message "A protocol must state the date its count was last carried forward."
    ] .

#
# The falsifying condition may be absent in exactly one case: where the state
# says outright that no procedure has been devised. Everywhere else its
# absence would let a claim drift silently from unexamined to examined and
# unsupported, which are not the same finding and must never read alike.
#
pm:FalsifierRequiredShape a sh:NodeShape ;
    sh:targetClass pm:Testing ;
    sh:or (
        [ sh:property [ sh:path pm:falsifiedBy ; sh:minCount 1 ] ]
        [ sh:property [ sh:path pm:examinationState ; sh:hasValue pm:noProcedureDevised ] ]
    ) ;
    sh:message "A protocol needs a stated falsifying condition unless its state is pm:noProcedureDevised." .

#
# A verdict that a claim says nothing must name what it fails to say. Without
# that, pm:claimDoesNotDiscriminate becomes the comfortable place to file every
# claim the examiner found unsatisfying, and the record would report on the
# examiner's patience instead of on the claims.
#
pm:UndividedOutcomesRequiredShape a sh:NodeShape ;
    sh:targetClass pm:Testing ;
    sh:or (
        [ sh:not [ sh:property [
            sh:path pm:examinationState ;
            sh:hasValue pm:claimDoesNotDiscriminate ;
            sh:minCount 1 ] ] ]
        [ sh:property [ sh:path pm:undividedOutcomes ; sh:minCount 1 ] ]
    ) ;
    sh:message "A protocol whose state is pm:claimDoesNotDiscriminate must name the outcomes the claim treats alike." .

#
# Evidence admitted without a search for opposition is one report taken for
# the world. These three shapes make the omission impossible rather than
# merely forbidden: the prose rule was written and broken in the same day.
#
pm:CounterSearchRequiredShape a sh:NodeShape ;
    sh:targetClass pm:Testing ;
    sh:or (
        [ sh:not [ sh:property [ sh:path pm:evidenceFrom ; sh:minCount 1 ] ] ]
        [ sh:property [ sh:path pm:counterSearch ; sh:minCount 1 ] ]
    ) ;
    sh:message "A protocol citing evidence must state how far the search for opposing work has been carried." .

pm:CounterSearchNoteRequiredShape a sh:NodeShape ;
    sh:targetClass pm:Testing ;
    sh:or (
        [ sh:not [ sh:property [ sh:path pm:counterSearch ; sh:minCount 1 ] ] ]
        [ sh:property [ sh:path pm:counterSearchNote ; sh:minCount 1 ] ]
    ) ;
    sh:message "A counter-search state must be accompanied by a note saying what was searched and what came back." .

#
# The state that carries the weight. A protocol may report cases only if
# somebody looked for the work that would unsettle them.
#
# pm:claimDoesNotDiscriminate is deliberately not in this list. It reports no
# cases: it says that the wording of the claim excludes no outcome, which is
# read off the claim and not off evidence, so there is nothing for a
# counter-search to search. Requiring one here forced the weaker
# pm:procedureWithoutCases onto verdicts that had actually been reached, and
# the record then understated its own work. The burden of that state is
# carried by pm:UndividedOutcomesRequiredShape, which demands the outcomes the
# claim treats alike; and a protocol that cites evidence is held to the
# counter-search by pm:CounterSearchRequiredShape whatever its state. See
# prima-materia#499.
#
pm:CasesRequireCounterSearchShape a sh:NodeShape ;
    sh:targetClass pm:Testing ;
    sh:or (
        [ sh:not [ sh:property [
            sh:path pm:examinationState ;
            sh:in ( pm:casesWithoutDeviation pm:casesWithDeviation ) ;
            sh:minCount 1 ] ] ]
        [ sh:property [
            sh:path pm:counterSearch ;
            sh:not [ sh:hasValue pm:counterSearchNotCarried ] ;
            sh:minCount 1 ] ]
    ) ;
    sh:message "A protocol reporting cases must have carried the counter-search; set procedureWithoutCases until it has." .

#
# A dispute cites every side it reports. One source is not a disagreement,
# it is a position; recording it as a dispute would let the record decide
# the matter by which side it happened to read.
#
pm:DisputingShape a sh:NodeShape ;
    sh:targetClass pm:Disputing ;
    sh:property [
        sh:path pm:disputedClaim ;
        sh:minCount 1 ;
        sh:message "Every dispute must name what is at issue."
    ] ;
    sh:property [
        sh:path pm:attestedBy ;
        sh:minCount 1 ;
        sh:message "Every dispute must declare how it entered the record."
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 2 ;
        sh:message "Every dispute must cite at least two sources, one for each side it reports."
    ] .

#
# A prerequisite claim must say which step, which prior step, and on what
# strength. Without the strength the claim is unusable: an order and a
# necessity would read alike, and the graph would lend ancient warrant to
# sequences no source ever made binding.
#
pm:PresupposingShape a sh:NodeShape ;
    sh:targetClass pm:Presupposing ;
    sh:property [
        sh:path pm:dependentStep ;
        sh:minCount 1 ;
        sh:message "Every prerequisite claim must name the step that depends."
    ] ;
    sh:property [
        sh:path pm:priorStep ;
        sh:minCount 1 ;
        sh:message "Every prerequisite claim must name the step required first."
    ] ;
    sh:property [
        sh:path pm:prerequisiteStrength ;
        sh:minCount 1 ;
        sh:message "Every prerequisite claim must state how firmly the source sets it."
    ] ;
    sh:property [
        sh:path pm:attestedBy ;
        sh:minCount 1 ;
        sh:message "Every prerequisite claim must declare how it entered the record."
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:message "Every prerequisite claim requires at least one dcterms:source."
    ] .

#
# Claiming that a source sets a necessity obliges the claimant to say what
# the source says goes wrong without it. A necessity for which no consequence
# can be quoted is an order that somebody read as a necessity, and belongs
# under pm:prescribedOrder instead.
#
pm:StatedNecessityShape a sh:NodeShape ;
    sh:targetClass pm:Presupposing ;
    sh:or (
        [ sh:property [ sh:path pm:consequenceOfSkipping ; sh:minCount 1 ] ]
        [ sh:not [ sh:property [ sh:path pm:prerequisiteStrength ; sh:hasValue pm:statedNecessity ] ] ]
    ) ;
    sh:message "A prerequisite of strength pm:statedNecessity must state the consequence of skipping." .

#
# Evidence is literature too. A modern study enters the record by the same
# rule as a received work: as something a reader can obtain, not as a place.
#
pm:EvidenceIsLiteratureShape a sh:NodeShape ;
    sh:targetSubjectsOf pm:evidenceFrom ;
    sh:property [
        sh:path pm:evidenceFrom ;
        sh:nodeKind sh:Literal ;
        sh:not [ sh:pattern "^https?://" ] ;
        sh:message "pm:evidenceFrom carries a bibliographic reference or a work identifier, never a URL."
    ] .

#
# A practice is a claim about what a tradition does, and carries the same
# burden as a claim about what it holds.
#
pm:PracticeShape a sh:NodeShape ;
    sh:targetClass pm:Practicing ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:message "Every practice requires at least one dcterms:source."
    ] ;
    sh:property [
        sh:path pm:withinTradition ;
        sh:minCount 1 ;
        sh:message "Every practice must be situated within at least one tradition."
    ] .

#
# The claim that a practice produces a capacity is the one the project exists
# to sort. It therefore carries the full burden: which practice, which
# capacity, how it entered the record, and which work says so.
#
pm:YieldingShape a sh:NodeShape ;
    sh:targetClass pm:Yielding ;
    sh:property [
        sh:path pm:byPractice ;
        sh:minCount 1 ;
        sh:message "Every yielding claim must name the practice it proceeds from."
    ] ;
    sh:property [
        sh:path pm:yieldsCapacity ;
        sh:minCount 1 ;
        sh:message "Every yielding claim must name the capacity it arrives at."
    ] ;
    sh:property [
        sh:path pm:attestedBy ;
        sh:minCount 1 ;
        sh:message "Every yielding claim must declare how it entered the record."
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:message "Every yielding claim requires at least one dcterms:source."
    ] .

#
# A warning without its object is a mood, not a claim.
#
pm:CautioningShape a sh:NodeShape ;
    sh:targetClass pm:Cautioning ;
    sh:property [
        sh:path pm:cautionsAbout ;
        sh:minCount 1 ;
        sh:message "Every caution must name what it warns against."
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:message "Every caution requires at least one dcterms:source."
    ] .

#
# A claim read through an intermediary must name the intermediary. Without
# this the mode would be a label that costs nothing: a node could declare
# itself second-hand and leave unsaid whose hand it passed through, which is
# the only part a later reader can actually check.
#
pm:MediatedAttestationShape a sh:NodeShape ;
    sh:targetSubjectsOf pm:attestedBy ;
    sh:or (
        [ sh:property [ sh:path pm:readVia ; sh:minCount 1 ] ]
        [ sh:not [ sh:property [ sh:path pm:attestedBy ; sh:hasValue pm:mediatedAttestation ] ] ]
    ) ;
    sh:message "A claim attested by pm:mediatedAttestation must name the work it was read in with pm:readVia." .

#
# A field claim must state the gathering it rests on. Without it the mode
# would be the cheap way past the source rule: a node could call itself field
# attestation and leave unsaid who spoke, who wrote it down, when, where and
# in which language, which is the whole of what a later reader has to go on
# where no earlier text exists.
#
pm:FieldAttestationShape a sh:NodeShape ;
    sh:targetSubjectsOf pm:attestedBy ;
    sh:or (
        [ sh:property [ sh:path pm:fieldRecord ; sh:minCount 1 ] ]
        [ sh:not [ sh:property [ sh:path pm:attestedBy ; sh:hasValue pm:fieldAttestation ] ] ]
    ) ;
    sh:message "A claim attested by pm:fieldAttestation must state the gathering with pm:fieldRecord: who spoke or that the speaker is withheld, who recorded, when, where, in which language, and whether the original wording is carried." .

#
# A receiving states who received, whom the work claims spoke, and under what
# circumstances. The last is the one that can be weighed; a node carrying only
# the first two repeats the title page.
#
pm:ReceivingShape a sh:NodeShape ;
    sh:targetClass pm:Receiving ;
    sh:property [
        sh:path pm:receivedBy ;
        sh:minCount 1 ;
        sh:message "Every receiving must name the person through whom the wording was received."
    ] ;
    sh:property [
        sh:path pm:claimedSpeaker ;
        sh:minCount 1 ;
        sh:message "Every receiving must name the speaker the work claims, as the work gives it."
    ] ;
    sh:property [
        sh:path pm:receptionCircumstance ;
        sh:minCount 1 ;
        sh:message "Every receiving must state the circumstances of the receiving: the state claimed, who questioned, who took it down, and whether a record of the proceeding survives."
    ] ;
    sh:property [
        sh:path pm:attestedBy ;
        sh:minCount 1 ;
        sh:message "Every receiving must declare how it entered the record."
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:message "Every receiving requires at least one dcterms:source, naming the work a reader can obtain and not the speaker it claims."
    ] .

#
# The claimed speaker is a literal on purpose. Pointing it at a named being
# would let the graph hold as a bearer what the node exists to record as a
# claim, and the assertion would then be true by the shape of its own entry.
#
pm:ClaimedSpeakerIsALiteralShape a sh:NodeShape ;
    sh:targetSubjectsOf pm:claimedSpeaker ;
    sh:property [
        sh:path pm:claimedSpeaker ;
        sh:nodeKind sh:Literal ;
        sh:message "pm:claimedSpeaker carries the speaker as the work gives it, as a literal. A reference to a named being would grant the claim the very thing it asserts."
    ] .

#
# The intermediary is literature too, by the same rule as the source and the
# evidence: something a reader can obtain, not a place that may move.
#
pm:ReadViaIsLiteratureShape a sh:NodeShape ;
    sh:targetSubjectsOf pm:readVia ;
    sh:property [
        sh:path pm:readVia ;
        sh:nodeKind sh:Literal ;
        sh:not [ sh:pattern "^https?://" ] ;
        sh:message "pm:readVia carries a bibliographic reference to the work the passage was read in, never a URL."
    ] .

#
# The principal corpus is literature by the same rule as everything else that
# names a work. pm:SourceIsLiteratureShape reaches only dcterms:source, so the
# predicate that carries a registration's whole content stood unguarded.
#
pm:PrincipalCorpusIsLiteratureShape a sh:NodeShape ;
    sh:targetSubjectsOf pm:principalCorpus ;
    sh:property [
        sh:path pm:principalCorpus ;
        sh:nodeKind sh:Literal ;
        sh:not [ sh:pattern "^https?://" ] ;
        sh:message "pm:principalCorpus names the works a transmission lies in, as literature, never a URL."
    ] .

#
# A registration is not a witness, and the prohibition that keeps it one is
# that it may name no source. A source names a passage that was read, with the
# edition it was read in; at pm:corpusNamed nothing has been read. A registered
# node carrying a source would be indistinguishable from a worked tradition,
# and the denominator the registration exists for would be unreadable again —
# under-representation and non-existence would look alike, which is the exact
# condition SPEC §14 introduced the state to end. The pattern is taken from
# pm:PositingIsNotAWitnessShape, which guards the same confusion one layer
# down.
#
pm:RegistrationIsNotAWitnessShape a sh:NodeShape ;
    sh:targetSubjectsOf pm:coverageState ;
    sh:or (
        [ sh:not [ sh:property [ sh:path pm:coverageState ; sh:hasValue pm:corpusNamed ] ] ]
        [ sh:property [ sh:path dcterms:source ; sh:maxCount 0 ] ]
    ) ;
    sh:message "A tradition at pm:corpusNamed claims no dcterms:source: nothing has been read there. It names its works with pm:principalCorpus instead." .

#
# The rule that costs the most if it is only a definition. ontology/coverage.ttl
# says of pm:corpusNamed that a tradition in that state witnesses nothing and
# may not be counted as a party to a convergence — and until now nothing
# enforced it. A convergence asserting independent attestation on a registered
# tradition validated cleanly, which is the most expensive mistake available in
# this holding, because it does not look like a mistake: pm:independentAttestation
# is the one predicate that turns an agreement into a countable witness.
#
# It was already close. In convergences/recitation-exactness.ttl, Zuni and
# Navajo had to be lifted off pm:corpusNamed by hand before the convergence was
# admissible, and nothing said so except the definition somebody happened to
# have read.
#
pm:RegisteredTraditionIsNoWitnessShape a sh:NodeShape ;
    sh:targetClass pm:Converging ;
    sh:property [
        sh:path pm:independentAttestation ;
        sh:node [
            a sh:NodeShape ;
            sh:not [ sh:property [ sh:path pm:coverageState ; sh:hasValue pm:corpusNamed ] ]
        ] ;
        sh:message "A tradition at pm:corpusNamed witnesses nothing and may not be named as independent attestation. Work it to a read passage first."
    ] ;
    sh:property [
        sh:path ( pm:convergingConcept pm:withinTradition ) ;
        sh:node [
            a sh:NodeShape ;
            sh:not [ sh:property [ sh:path pm:coverageState ; sh:hasValue pm:corpusNamed ] ]
        ] ;
        sh:message "A concept in a convergence may not belong to a tradition still at pm:corpusNamed. The registration names a corpus; it does not attest a passage."
    ] .

#
# Sources are literature, not links. A URL names a location that changes and
# that only its author can vouch for; a work names something a reader can
# obtain independently of this graph. The rule is machine-checked here rather
# than left to the discipline of whoever writes the next node.
#
pm:SourceIsLiteratureShape a sh:NodeShape ;
    sh:targetSubjectsOf dcterms:source ;
    sh:property [
        sh:path dcterms:source ;
        sh:nodeKind sh:Literal ;
        sh:not [ sh:pattern "^https?://" ] ;
        sh:message "dcterms:source carries a bibliographic reference to a received work, never a URL."
    ] .

#
# An origination that names only its author and its work is a bibliography.
# What makes it a finding is the ascription the claim circulates under and
# does not have, so that is required too.
#
pm:OriginationShape a sh:NodeShape ;
    sh:targetClass pm:Originating ;
    sh:property [
        sh:path pm:originatedBy ;
        sh:minCount 1 ;
        sh:message "Every origination names the author with whom the claim begins."
    ] ;
    sh:property [
        sh:path dcterms:date ;
        sh:minCount 1 ;
        sh:message "Every origination carries the date of the work it begins in."
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:message "Every origination names the work in which the claim first stands."
    ] ;
    sh:property [
        sh:path pm:circulatesAs ;
        sh:minCount 1 ;
        sh:message "Every origination states the ascription the claim circulates under. Without it the node is a bibliography and not a finding."
    ] .

#
# A posited claim is in the graph on sufferance. It witnesses nothing, so it
# must not look as though it did: no source, no tradition. The two prohibitions
# are the whole safeguard, because a node that carried either would be
# indistinguishable from a witness at the point where somebody reads it.
#
pm:PositingIsNotAWitnessShape a sh:NodeShape ;
    sh:targetClass pm:Positing ;
    sh:property [
        sh:path dcterms:source ;
        sh:maxCount 0 ;
        sh:message "A posited claim claims no source. What it rests on is stated with pm:positedIn, which names an identifier and not a work."
    ] ;
    sh:property [
        sh:path pm:withinTradition ;
        sh:maxCount 0 ;
        sh:message "A posited claim belongs to no tradition. Assigning one would make an examined claim look like a transmitted one."
    ] ;
    sh:property [
        sh:path pm:positedIn ;
        sh:minCount 1 ;
        sh:message "A posited claim states where it was put forward."
    ] .

#
# No object of examination without an examination. Without this the class
# becomes the channel through which an unpublished draft enters the record
# after all, and the direction the project runs in is reversed.
#
pm:PositingRequiresExaminationShape a sh:NodeShape ;
    sh:targetClass pm:Positing ;
    sh:property [
        sh:path [ sh:inversePath pm:tests ] ;
        sh:minCount 1 ;
        sh:message "A posited claim may exist only where a pm:Testing node points at it. A claim nobody is examining has no business in the graph."
    ] .

#
# A generalization exhibits what it is: the statement it makes, the attested
# claims it was formed from, and the fact that the step is the compiler's.
# Compiler inference is required here rather than forbidden — the opposite of
# what pm:Attributing demands — because nobody transmitted this sentence, and
# a node claiming otherwise would report a witness that does not exist.
#
pm:GeneralizationShape a sh:NodeShape ;
    sh:targetClass pm:Generalizing ;
    sh:property [
        sh:path pm:generalizedStatement ;
        sh:minCount 1 ;
        sh:message "Every generalization must state the claim it makes."
    ] ;
    sh:property [
        sh:path pm:generalizedFrom ;
        sh:minCount 2 ;
        sh:message "Every generalization must point at least two attested claims it was formed from. One claim generalized is one claim restated."
    ] ;
    sh:property [
        sh:path pm:attestedBy ;
        sh:hasValue pm:compilerInference ;
        sh:message "A generalization is attested by pm:compilerInference and by nothing else. No source states it."
    ] .

#
# The prohibition that keeps the layers apart. A generalization naming a work
# or a tradition would read as transmitted at the point where somebody loads
# the graph, and the difference between what a tradition says and what was
# concluded from several traditions is the one this class exists to hold.
#
pm:GeneralizationIsNotAWitnessShape a sh:NodeShape ;
    sh:targetClass pm:Generalizing ;
    sh:property [
        sh:path dcterms:source ;
        sh:maxCount 0 ;
        sh:message "A generalization claims no source. What it rests on is stated with pm:generalizedFrom, which points at claims that carry their own."
    ] ;
    sh:property [
        sh:path pm:withinTradition ;
        sh:maxCount 0 ;
        sh:message "A generalization belongs to no tradition. It was formed from several, and assigning it to one would credit a transmission with a step it never took."
    ] .

#
# The lock. Every claim a generalization is formed from must itself name a
# work, so the derivation terminates in passages a reader can obtain. This is
# what keeps the class from becoming the route by which an unpublished method
# draft enters the record after all: a sentence nobody attested has nothing
# for pm:generalizedFrom to point at.
#
pm:GeneralizationRestsOnAttestedNodesShape a sh:NodeShape ;
    sh:targetClass pm:Generalizing ;
    sh:property [
        sh:path pm:generalizedFrom ;
        sh:node [
            a sh:NodeShape ;
            sh:property [
                sh:path dcterms:source ;
                sh:minCount 1
            ]
        ] ;
        sh:message "Every claim a generalization is formed from must itself name a work. A derivation that terminates in something unattested is an assertion wearing a chain."
    ] .

#
# A naming carries the full burden of a claim, because it is one: a work says
# that this being is called this and is of this kind. The two properties
# beyond the usual four are what make the node comparable at all — a form
# without its edition cannot be set beside another form, and a bearer without
# the term its own tradition uses has been harmonised by whoever left it out.
#
pm:NamingShape a sh:NodeShape ;
    sh:targetClass pm:Naming ;
    sh:property [
        sh:path pm:nameForm ;
        sh:minCount 1 ;
        sh:message "Every naming must give the name as the cited edition spells it."
    ] ;
    sh:property [
        sh:path pm:nameRole ;
        sh:minCount 1 ;
        sh:message "Every naming must say what the naming tradition takes the bearer to be, in that tradition's own term."
    ] ;
    sh:property [
        sh:path pm:attestedBy ;
        sh:minCount 1 ;
        sh:message "Every naming must declare how it entered the record."
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:message "Every naming requires at least one dcterms:source."
    ] ;
    sh:property [
        sh:path pm:withinTradition ;
        sh:minCount 1 ;
        sh:message "Every naming must name the tradition that names the bearer. A name belongs to whoever gave it."
    ] .

#
# Scales — declaration and closure
#
# rdfs:range states an intention and constrains nothing. Until these shapes
# existed, pm:attestedBy pm:textualAttestaton validated cleanly, and so did an
# invented value that no scale declares: the node passed every minCount, the
# graph compiled, and the mistake showed up only as a value that never
# appeared in a query. Ten properties were exposed to that.
#

pm:ScaleDeclarationShape a sh:NodeShape ;
    sh:targetClass pm:Scale ;
    sh:property [
        sh:path pm:scaleFamily ;
        sh:minCount 1 ;
        sh:message "Every scale must declare which family it belongs to. A value about the state of the record, a value about the firmness of a source and a value about the subject matter are read differently, and a scale that does not say which it is invites all three readings."
    ] .

pm:AttestationValueShape a sh:NodeShape ;
    sh:targetSubjectsOf pm:attestedBy ;
    sh:property [
        sh:path pm:attestedBy ;
        sh:in ( pm:textualAttestation pm:firstPersonReport pm:protocolledPractice pm:thirdPartyAscription pm:compilerInference pm:mediatedAttestation pm:fieldAttestation ) ;
        sh:message "pm:attestedBy takes a declared mode of attestation from pm:Attesting and nothing else."
    ] .

pm:ExaminationStateValueShape a sh:NodeShape ;
    sh:targetSubjectsOf pm:examinationState ;
    sh:property [
        sh:path pm:examinationState ;
        sh:in ( pm:noProcedureDevised pm:procedureWithoutCases pm:casesWithoutDeviation pm:casesWithDeviation pm:claimDoesNotDiscriminate ) ;
        sh:message "pm:examinationState takes a declared examination state from pm:ExaminationState and nothing else."
    ] .

pm:CounterSearchValueShape a sh:NodeShape ;
    sh:targetSubjectsOf pm:counterSearch ;
    sh:property [
        sh:path pm:counterSearch ;
        sh:in ( pm:counterSearchNotCarried pm:counterSearchFoundNothing pm:counterSearchFoundOpposition ) ;
        sh:message "pm:counterSearch takes a declared counter-search state from pm:CounterSearchState and nothing else."
    ] .

pm:CoverageStateValueShape a sh:NodeShape ;
    sh:targetSubjectsOf pm:coverageState ;
    sh:property [
        sh:path pm:coverageState ;
        sh:in ( pm:corpusNamed pm:workOpened pm:placesEntered pm:corpusHarvested ) ;
        sh:message "pm:coverageState takes a declared coverage state from pm:CoverageState and nothing else."
    ] .

pm:ContactRouteValueShape a sh:NodeShape ;
    sh:targetSubjectsOf pm:contactRoute ;
    sh:property [
        sh:path pm:contactRoute ;
        sh:in ( pm:contactRouteUndecided pm:contactRouteDocumented pm:contactRouteDisputed pm:contactRouteAbsent ) ;
        sh:message "pm:contactRoute takes a declared contact route from pm:ContactRoute and nothing else."
    ] .

pm:PrerequisiteStrengthValueShape a sh:NodeShape ;
    sh:targetSubjectsOf pm:prerequisiteStrength ;
    sh:property [
        sh:path pm:prerequisiteStrength ;
        sh:in ( pm:statedNecessity pm:prescribedOrder pm:presentationOrder ) ;
        sh:message "pm:prerequisiteStrength takes a declared prerequisite strength from pm:PrerequisiteStrength and nothing else."
    ] .

pm:MethodOrientationValueShape a sh:NodeShape ;
    sh:targetSubjectsOf pm:methodOrientation ;
    sh:property [
        sh:path pm:methodOrientation ;
        sh:in ( pm:conformingMethod pm:transgressiveMethod pm:normDistinctionDeclined pm:methodNotStated ) ;
        sh:message "pm:methodOrientation takes a declared method orientation from pm:MethodOrientation and nothing else."
    ] .

pm:TelicOrientationValueShape a sh:NodeShape ;
    sh:targetSubjectsOf pm:telicOrientation ;
    sh:property [
        sh:path pm:telicOrientation ;
        sh:in ( pm:unitiveTelos pm:separativeTelos pm:individuatingTelos pm:conjugalTelos pm:selfBoundaryDeclined pm:telosNotStated ) ;
        sh:message "pm:telicOrientation takes a declared telic orientation from pm:TelicOrientation and nothing else."
    ] .

pm:AwarenessSpaceValueShape a sh:NodeShape ;
    sh:targetSubjectsOf pm:hasAwarenessSpace ;
    sh:property [
        sh:path pm:hasAwarenessSpace ;
        sh:in ( pm:individualAwareness pm:dyadicAwareness pm:collectiveAwareness pm:universalAwareness ) ;
        sh:message "pm:hasAwarenessSpace takes a declared awareness space from pm:AwarenessSpace and nothing else."
    ] .

#
# Placement on an awareness axis
#
# The ground is required for the same reason the counter-search note is: a
# placement nobody can check is a placement nobody can contradict, and the
# axes exist so that a compiler's reading stays visible as one.
#

pm:SituatingShape a sh:NodeShape ;
    sh:targetClass pm:Situating ;
    sh:property [
        sh:path pm:situatedNode ;
        sh:minCount 1 ;
        sh:message "Every placement must name the node it places."
    ] ;
    sh:property [
        sh:path pm:axisValue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( pm:outwardWaking pm:withdrawnAbsorption pm:sleepThreshold pm:dreamingWithin pm:objectlessDepth pm:anchoringDeclined pm:anchoringNotStated pm:anchoringUnbound
                 pm:embodiedLocus pm:displacedLocus pm:locusDeclined pm:locusNotStated
                 pm:ownAgency pm:cededAgency pm:agencyDeclined pm:agencyNotStated
                 pm:byEffort pm:notByEffort pm:acquisitionDeclined pm:acquisitionNotStated
                 pm:transientState pm:abidingState pm:durationDeclined pm:durationNotStated ) ;
        sh:message "Every placement carries exactly one declared axis value. Two axes are two placements."
    ] ;
    sh:property [
        sh:path pm:situationGround ;
        sh:minCount 1 ;
        sh:message "Every placement must state what in the source carries it."
    ] ;
    sh:property [
        sh:path pm:attestedBy ;
        sh:minCount 1 ;
        sh:message "Every placement must declare how it entered the record. Normally pm:compilerInference: the source describes a condition, the coordinate is the compiler's."
    ] .

#
# Static-substance classes are forbidden. The shape targets the four
# blacklisted URIs directly; if any of them is ever asserted as owl:Class,
# validation fails.
#
pm:NoSubstanceClassesShape a sh:NodeShape ;
    sh:targetNode pm:Symbol, pm:Concept, pm:Entity, pm:Object ;
    sh:not [
        sh:property [
            sh:path rdf:type ;
            sh:hasValue owl:Class
        ]
    ] ;
    sh:message "Static substance classes (pm:Symbol, pm:Concept, pm:Entity, pm:Object) are forbidden. Use process classes instead (pm:Symbolizing, pm:Conceptualizing, etc.)." .
