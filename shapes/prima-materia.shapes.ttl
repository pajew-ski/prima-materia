@prefix pm:      <https://pajew.ski/prima-materia/ontology#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#
# prima-materia — SHACL validation shapes
#

#
# Every class declared in the ontology must carry at least one
# language-tagged rdfs:label and one skos:definition. Named "ProcessShape"
# per SPEC §5; in practice it applies to every owl:Class so that
# AwarenessContext and AwarenessSpace are covered as well.
#
pm:ProcessShape a sh:NodeShape ;
    sh:targetClass owl:Class ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:message "Every class requires at least one language-tagged rdfs:label."
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 1 ;
        sh:message "Every class requires a skos:definition."
    ] .

#
# Every instance of pm:Conceptualizing must carry a source reference and a
# tradition assignment.
#
pm:ConceptInstanceShape a sh:NodeShape ;
    sh:targetClass pm:Conceptualizing ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:message "Every concept instance requires at least one dcterms:source."
    ] ;
    sh:property [
        sh:path pm:withinTradition ;
        sh:minCount 1 ;
        sh:message "Every concept must be situated within at least one tradition."
    ] .

#
# Every attribution declares how it entered the record and which work carries
# it. This is the constraint the whole project rests on: a claim whose
# non-evidence is correctly recorded asserts nothing it does not exhibit.
#
pm:AttributionShape a sh:NodeShape ;
    sh:targetClass pm:Attributing ;
    sh:property [
        sh:path pm:attestedBy ;
        sh:minCount 1 ;
        sh:message "Every attribution must declare how it entered the record."
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:message "Every attribution requires at least one dcterms:source."
    ] .

#
# An order may be the compiler's; the claim being ordered may not.
#
pm:CompilerInferenceScopeShape a sh:NodeShape ;
    sh:targetClass pm:Attributing ;
    sh:not [
        a sh:NodeShape ;
        sh:property [
            sh:path pm:attestedBy ;
            sh:hasValue pm:compilerInference
        ]
    ] ;
    sh:message "Compiler inference attests an ordering act (pm:Systematizing), never the claim being ordered." .

#
# An order imposed in the present is indistinguishable from an order found in
# the source unless it carries its author and its date.
#
pm:SystematizationShape a sh:NodeShape ;
    sh:targetClass pm:Systematizing ;
    sh:property [
        sh:path pm:compiledBy ;
        sh:minCount 1 ;
        sh:message "Every ordering act names the compiler who performed it."
    ] ;
    sh:property [
        sh:path dcterms:date ;
        sh:minCount 1 ;
        sh:message "Every ordering act carries the date on which it was performed."
    ] .

#
# Undifferentiated, a correspondence measures reception history. It must state
# either the route of contact that explains it or the attestation that has none.
#
pm:ConvergenceShape a sh:NodeShape ;
    sh:targetClass pm:Converging ;
    sh:or (
        [ sh:property [ sh:path pm:transmissionPath ; sh:minCount 1 ] ]
        [ sh:property [ sh:path pm:independentAttestation ; sh:minCount 1 ] ]
    ) ;
    sh:message "A convergence states either a documented transmission path or an attestation without one." .

#
# A protocol that names no author, or no date on which its count was last
# carried forward, claims a scrutiny it does not document.
#
pm:TestingShape a sh:NodeShape ;
    sh:targetClass pm:Testing ;
    sh:property [
        sh:path pm:examinationState ;
        sh:minCount 1 ;
        sh:message "Every protocol must state how far the examination has been carried."
    ] ;
    sh:property [
        sh:path pm:examinedBy ;
        sh:minCount 1 ;
        sh:message "Every protocol must name who devised or carried it."
    ] ;
    sh:property [
        sh:path pm:protocolUpdated ;
        sh:minCount 1 ;
        sh:message "A protocol must state the date its count was last carried forward."
    ] .

#
# The falsifying condition may be absent in exactly one case: where the state
# says outright that no procedure has been devised. Everywhere else its
# absence would let a claim drift silently from unexamined to examined and
# unsupported, which are not the same finding and must never read alike.
#
pm:FalsifierRequiredShape a sh:NodeShape ;
    sh:targetClass pm:Testing ;
    sh:or (
        [ sh:property [ sh:path pm:falsifiedBy ; sh:minCount 1 ] ]
        [ sh:property [ sh:path pm:examinationState ; sh:hasValue pm:noProcedureDevised ] ]
    ) ;
    sh:message "A protocol needs a stated falsifying condition unless its state is pm:noProcedureDevised." .

#
# Evidence is literature too. A modern study enters the record by the same
# rule as a received work: as something a reader can obtain, not as a place.
#
pm:EvidenceIsLiteratureShape a sh:NodeShape ;
    sh:targetSubjectsOf pm:evidenceFrom ;
    sh:property [
        sh:path pm:evidenceFrom ;
        sh:nodeKind sh:Literal ;
        sh:not [ sh:pattern "^https?://" ] ;
        sh:message "pm:evidenceFrom carries a bibliographic reference or a work identifier, never a URL."
    ] .

#
# A practice is a claim about what a tradition does, and carries the same
# burden as a claim about what it holds.
#
pm:PracticeShape a sh:NodeShape ;
    sh:targetClass pm:Practicing ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:message "Every practice requires at least one dcterms:source."
    ] ;
    sh:property [
        sh:path pm:withinTradition ;
        sh:minCount 1 ;
        sh:message "Every practice must be situated within at least one tradition."
    ] .

#
# The claim that a practice produces a capacity is the one the project exists
# to sort. It therefore carries the full burden: which practice, which
# capacity, how it entered the record, and which work says so.
#
pm:YieldingShape a sh:NodeShape ;
    sh:targetClass pm:Yielding ;
    sh:property [
        sh:path pm:byPractice ;
        sh:minCount 1 ;
        sh:message "Every yielding claim must name the practice it proceeds from."
    ] ;
    sh:property [
        sh:path pm:yieldsCapacity ;
        sh:minCount 1 ;
        sh:message "Every yielding claim must name the capacity it arrives at."
    ] ;
    sh:property [
        sh:path pm:attestedBy ;
        sh:minCount 1 ;
        sh:message "Every yielding claim must declare how it entered the record."
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:message "Every yielding claim requires at least one dcterms:source."
    ] .

#
# A warning without its object is a mood, not a claim.
#
pm:CautioningShape a sh:NodeShape ;
    sh:targetClass pm:Cautioning ;
    sh:property [
        sh:path pm:cautionsAbout ;
        sh:minCount 1 ;
        sh:message "Every caution must name what it warns against."
    ] ;
    sh:property [
        sh:path dcterms:source ;
        sh:minCount 1 ;
        sh:message "Every caution requires at least one dcterms:source."
    ] .

#
# Sources are literature, not links. A URL names a location that changes and
# that only its author can vouch for; a work names something a reader can
# obtain independently of this graph. The rule is machine-checked here rather
# than left to the discipline of whoever writes the next node.
#
pm:SourceIsLiteratureShape a sh:NodeShape ;
    sh:targetSubjectsOf dcterms:source ;
    sh:property [
        sh:path dcterms:source ;
        sh:nodeKind sh:Literal ;
        sh:not [ sh:pattern "^https?://" ] ;
        sh:message "dcterms:source carries a bibliographic reference to a received work, never a URL."
    ] .

#
# Static-substance classes are forbidden. The shape targets the four
# blacklisted URIs directly; if any of them is ever asserted as owl:Class,
# validation fails.
#
pm:NoSubstanceClassesShape a sh:NodeShape ;
    sh:targetNode pm:Symbol, pm:Concept, pm:Entity, pm:Object ;
    sh:not [
        sh:property [
            sh:path rdf:type ;
            sh:hasValue owl:Class
        ]
    ] ;
    sh:message "Static substance classes (pm:Symbol, pm:Concept, pm:Entity, pm:Object) are forbidden. Use process classes instead (pm:Symbolizing, pm:Conceptualizing, etc.)." .
