@prefix pm:      <https://pajew.ski/prima-materia/ontology#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

#
# prima-materia — provenance and testing
#
# The graph holds no truths, only claims with an origin. These classes carry
# that origin: who ascribed what to whom, how the ascription entered the
# record, who imposed an order the material itself did not carry, where
# traditions correspond without a route of contact between them, and under
# what condition a claim would count as refuted.
#
# The distinction these classes exist for is the one a wiki cannot hold: a
# claim and the reason it is in the record are separate facts, and the second
# is the one that decays silently when it is not modelled.
#

#
# Classes
#

pm:Attributing a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Attributing"@en, "Zuschreiben"@de ;
    skos:definition "The act of ascribing a capacity, property, or deed to a subject. A lost faculty is never a finding; it is an ascription made in a work, and the work is what the graph can hold."@en .

pm:Attesting a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Attesting"@en, "Bezeugen"@de ;
    skos:definition "The act by which a claim entered the record. Instances of this class are modes of entry, not claims; a claim points at one of them through pm:attestedBy."@en ;
    skos:note "Orthogonal to pm:AwarenessContext, which describes the state the asserter was in rather than the route by which the assertion reached the record."@en .

pm:Systematizing a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Systematizing"@en, "Systematisieren"@de ;
    skos:definition "The act of imposing an order on material that did not carry it: a list, a sequence, a correspondence table. Named, dated, and attributed to the compiler who performed it, never to the source that is being ordered."@en .

pm:Converging a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Converging"@en, "Konvergieren"@de ;
    skos:definition "A structural correspondence observed across traditions, held as a node so that it can carry its routes of transmission and its counterexamples instead of asserting universality."@en ;
    skos:note "Most apparent universality in the Western esoteric record is diffusion from few sources. A graph that counts a citation chain as independent confirmation measures reception history and reports it as structure."@en ;
    skos:note "That is a warning against one way of counting and not against reception itself. Reception history is a finding of its own: how many transmissions carry a claim at all, and how deeply the paths between them branch, are two separate numbers and neither cancels the other. Many witnesses on one cable is a different map from many witnesses on three, and both are more informative than the earlier arrangement, in which the first case was simply not shown. The one thing the graph must be able to do is say which of the two maps a reader is looking at: dense transmission and strong effect must never look alike, or the gate of authority returns in statistical dress."@en ;
    skos:note "Independence is also a weaker instrument than it looks, and this is the reason breadth is held beside it rather than under it. It guards against none of the three commonest sources of agreement: a shared physiology that produces the same experience wherever the same thing is done to a body, a structural necessity of the subject matter that makes any competent version converge, and the form of graded institutions, which resemble one another because institutions with grades do. What decides in the end is what can be reproduced, and independence is a way of sorting candidates for that, not a verdict."@en ;
    skos:note "Every instance is an ordering made by a compiler and carries pm:compilerInference, never textual attestation. No source says that the concepts correspond; the correspondence is the reading, and it is held as a node so that it can be argued with. Its sources are the sources of the concepts it brings together, and they attest those concepts and not their correspondence."@en .

pm:Reworking a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Reworking"@en, "Bearbeiten"@de ;
    skos:definition "The act, within one tradition, of taking over a claim from another and adding to it something the source it came from does not contain: a term, a consequence, a caution, a sign, a condition of failure."@en ;
    skos:note "The class exists because reception is two things and the record could not tell them apart. Textual transmission is somebody copying a sentence, and it shows that the sentence was handed on. Operative uptake is somebody taking the instruction, carrying it out, and afterwards writing what was not in the exemplar. Only the second turns a chain of copies into a series of attempts, and only the second is proof against feedback: what makes the Dogon Sirius case weak is not that it is received but that nothing was added at the second station which was not already in the question."@en ;
    skos:note "This is therefore the quantity worth counting, and it is not the number of independent witnesses. A tradition that takes over a claim about an effect and attaches a condition of failure to it has delivered more than three that pass it on word for word — and the addition is the material a pm:falsifiedBy is made from, so the examining layer comes out of the reception history rather than against it."@en ;
    skos:note "Deliberately expensive: pm:addedElement points at a node, so the addition has to be entered before the reworking can be claimed. A station that added something and cannot say what added nothing that this graph can use. As with pm:Testing, absence is informative and is not to be stubbed: no instance means nobody has shown an addition, not that none was made."@en ;
    skos:note "Distinct from pm:Systematizing, which is an ordering act performed by an editor in the present and named as his. A reworking is an act inside a transmission, attested in a work like any other claim, and it belongs to the tradition that performed it."@en .

pm:Testing a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Testing"@en, "Prüfen"@de ;
    skos:definition "An ongoing attempt to fail a claim under a stated condition. A protocol that names no condition under which the claim would be refuted is not a test of it."@en ;
    skos:note "An instance exists only where somebody has taken the examination up, and its absence is therefore informative rather than empty: it says that no procedure has been taken up, not that the claim has been examined and found wanting. A stub for every claim in the collection would double the graph and say nothing the absence does not already say."@en .

pm:Yielding a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Yielding"@en, "Hervorbringen"@de ;
    skos:definition "The claim, made within a tradition, that a named practice produces a named capacity."@en ;
    skos:note "Held as a node and not as an edge for the same reason pm:Attributing is: only a node can carry its own source, its own mode of attestation, and a protocol that tries to fail it. A bare edge would make every such claim look alike, whatever it rests on, and would leave nothing for pm:Testing to point at. The question of which capacities a practice actually develops is answerable only where the pairing itself is addressable."@en .

pm:Cautioning a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Cautioning"@en, "Warnen"@de ;
    skos:definition "The act, within a tradition, of warning against a capacity, a practice, or the pursuit of either."@en ;
    skos:note "Held as a node rather than as commentary, because what a tradition warns against is part of what it teaches. A record that carries only the capacities and not the cautions misreports the tradition it claims to hold."@en .

pm:Presupposing a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Presupposing"@en, "Voraussetzen"@de ;
    skos:definition "The claim, made within a tradition, that one step of a path presupposes another: that a practice, state or capacity is not reached except by way of something else."@en ;
    skos:note "A node and not an edge, for the same reason as pm:Attributing and pm:Yielding. A prerequisite claim differs enormously in what carries it, and the difference is not visible on an edge. It matters whether a text sets an order or a reader inferred one from the order of the chapters."@en .

pm:Disputing a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Disputing"@en, "Bestreiten"@de ;
    skos:definition "A disagreement about a claim, carried on within a tradition, between traditions, or among the scholars who edit their texts."@en ;
    skos:note "Without this class a disagreement can only be recorded by silently preferring one side, or by leaving the claim out because it is contested. Both losses are worse than the disagreement. A dispute node names what is at issue and cites each side, and a dispute with only one source cited is not a dispute."@en .

pm:PrerequisiteStrength a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Prerequisite Strength"@en, "Stärke der Voraussetzung"@de ;
    skos:definition "How firmly a source sets a prerequisite: as a necessity, as an instruction, or merely by the order in which it presents its material."@en ;
    skos:note "The three must not collapse. A list of eight limbs in the order given is not the same claim as a sentence saying that the eighth is unreachable without the seventh, and reading the first as the second is the commonest way a modern system acquires an ancient warrant it never had."@en .

pm:statedNecessity a pm:PrerequisiteStrength ;
    rdfs:label "Stated necessity"@en, "Ausdrücklich gesetzte Notwendigkeit"@de ;
    skos:definition "The source says what fails to happen without the prior step: that the later step is not possible, or does not arise, or turns harmful."@en .

pm:prescribedOrder a pm:PrerequisiteStrength ;
    rdfs:label "Prescribed order"@en, "Angeordnete Reihenfolge"@de ;
    skos:definition "The source instructs that one comes before the other, without saying what follows from disregarding it."@en .

pm:presentationOrder a pm:PrerequisiteStrength ;
    rdfs:label "Presentation order"@en, "Darstellungsreihenfolge"@de ;
    skos:definition "The source only presents the material in a sequence. Any necessity is the reader's, and belongs to whoever read it that way."@en .

pm:ExaminationState a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Examination State"@en, "Prüfstand"@de ;
    skos:definition "The standing of a protocol: how far the attempt to fail a claim has actually been carried."@en ;
    skos:note "The first two states and the third must never collapse into one another. A claim nobody has devised a way to examine is not a claim that has been examined and found wanting. A record that reports both as unsupported would not be reporting on the claims but on the reach of its own instruments."@en .

pm:noProcedureDevised a pm:ExaminationState ;
    rdfs:label "No procedure devised"@en, "Kein Verfahren ersonnen"@de ;
    skos:definition "Nobody has stated a condition under which the claim would count as refuted. This is a statement about the means of examination, not about the claim."@en .

pm:procedureWithoutCases a pm:ExaminationState ;
    rdfs:label "Procedure without cases"@en, "Verfahren ohne Fälle"@de ;
    skos:definition "A falsifying condition is stated and no case has yet been recorded against it."@en .

pm:casesWithoutDeviation a pm:ExaminationState ;
    rdfs:label "Cases without deviation"@en, "Fälle ohne Abweichung"@de ;
    skos:definition "Cases have been recorded and show no deviation from the stated base rate."@en .

pm:casesWithDeviation a pm:ExaminationState ;
    rdfs:label "Cases with deviation"@en, "Fälle mit Abweichung"@de ;
    skos:definition "Cases have been recorded and show a deviation from the stated base rate. What deviates is what the protocol measured, which is rarely the whole of what the claim asserts."@en .

pm:claimDoesNotDiscriminate a pm:ExaminationState ;
    rdfs:label "Claim does not discriminate"@en, "Behauptung unterscheidet nicht"@de ;
    skos:definition "Cases have been recorded, they show no deviation, and the claim is nonetheless uninformative: it is worded so that outcomes which differ from one another all satisfy it equally."@en ;
    skos:note "The fifth state and the least obvious. It is not a milder pm:casesWithoutDeviation. There the claim said something and the cases bore it out; here the cases bear it out because the claim did not say enough to be borne out against anything. Recording such a protocol as cases without deviation would enter a success where an examination in fact found the claim empty, and a reader counting confirmations would count this one."@en ;
    skos:note "The distinction that decides which of the two applies is not how strong the evidence is but whether an outcome exists that the claim would have ruled out. If the claim covers a result and its opposite alike, it discriminates nothing and belongs here, however well the cases fit."@en ;
    skos:note "This state exists because a case forced it. A claim that coupling an intended state to a strong affect shifts the threshold for risk is confirmed by the evidence and useless to whoever acts on it, because fear and anger are both strong and move that threshold in opposite directions. See prima-materia#141."@en .

#
# Modes of attestation
#

pm:textualAttestation a pm:Attesting ;
    rdfs:label "Textual attestation"@en, "Textzeugnis"@de ;
    skos:definition "The claim stands in a received work, at a passage that can be cited and read independently of this graph."@en .

pm:firstPersonReport a pm:Attesting ;
    rdfs:label "First-person report"@en, "Erfahrungsbericht"@de ;
    skos:definition "An experiential account given in the first person by the one who had it, recorded once."@en .

pm:protocolledPractice a pm:Attesting ;
    rdfs:label "Protocolled practice"@en, "Protokollierte Praxis"@de ;
    skos:definition "A practice repeated under a stated procedure that records its failures alongside its successes."@en .

pm:thirdPartyAscription a pm:Attesting ;
    rdfs:label "Third-party ascription"@en, "Fremdzuschreibung"@de ;
    skos:definition "One party ascribes the capacity to another, who does not report it. Common for capacities said to be lost, since no bearer remains to be asked."@en .

pm:compilerInference a pm:Attesting ;
    rdfs:label "Compiler inference"@en, "Schluss des Bearbeiters"@de ;
    skos:definition "A conclusion drawn by an editor or compiler that the source does not state."@en ;
    skos:note "Admissible as attestation of an ordering act, never of the claim being ordered. Enforced by pm:AttributionShape."@en .

pm:mediatedAttestation a pm:Attesting ;
    rdfs:label "Mediated attestation"@en, "Vermitteltes Zeugnis"@de ;
    skos:definition "The claim stands in a received work at a passage that can be named, but the passage was read in a second work that quotes or reports it, because the first could not be obtained."@en ;
    skos:note "Weaker than pm:textualAttestation and stronger than nothing, and the record has to be able to say which of the two it has. A claim read through an intermediary carries that intermediary's selection, its translation and its silence; a reader who cannot see that the passage came second-hand cannot weigh any of it."@en ;
    skos:note "Admissible only where the work itself is out of reach — not digitised, out of print, held internally, in a language not commanded. Effort is not a reason: the mode exists so that unreachable material can enter at its true strength, not so that reachable material can enter cheaply. See SPEC §10 and SPEC §15."@en ;
    skos:note "Every claim carrying this mode must name the intermediary with pm:readVia, enforced by pm:MediatedAttestationShape. dcterms:source keeps naming the work that carries the claim, because that is what a later reader must obtain; pm:readVia names what the writer of the node actually had in front of him. Collapsing the two would hide exactly the fact this mode exists to record."@en .

pm:fieldAttestation a pm:Attesting ;
    rdfs:label "Field attestation"@en, "Feldzeugnis"@de ;
    skos:definition "The claim was taken down from a speaker in a transmission that commits nothing to writing, and the record of that taking down is the first fixation there is. The work a reader obtains is the field report; there is no earlier text behind it."@en ;
    skos:note "Distinct from pm:mediatedAttestation, and the difference is the whole reason for a separate mode. There the work exists and could not be obtained, so pm:readVia names whose reading stands between the claim and this graph. Here no such work exists: the transmission is oral, and the report is not an intermediary but the first witness. Fusing the two would enter every oral transmission as second-hand material about a text nobody can name."@en ;
    skos:note "The mode exists because its absence had a direction. SPEC §10 asks for a received work with a passage, and the transmissions that carry no text are precisely those with no documented route to what this graph already holds — the only ones that can ever bear pm:independentAttestation. Leaving them at pm:corpusNamed for want of an admissible mode would have made the record report that only scribal cultures transmitted this knowledge, and every convergence claim of the project a claim about Eurasia. See prima-materia#91."@en ;
    skos:note "It is not the mode for modern research. An ethnography enters here where it takes down testimony; where it runs a procedure with an outcome that could have fallen out otherwise, it is evidence and enters at pm:evidenceFrom on a pm:Testing node. A corpus that does both goes in twice, under different predicates. The line runs by function and not by the discipline of the writer, as SPEC §14 has it."@en ;
    skos:note "Every claim carrying this mode must state the gathering with pm:fieldRecord, enforced by pm:FieldAttestationShape. Without it a field claim would be a citation of a book with no way to see how far it stands from the speaker."@en ;
    skos:note "Restricted knowledge is a separate question and this mode does not settle it. Where a transmission holds material back as its own property rather than as a gate of authority, the criterion of SPEC §0 does not apply unchanged and a CC0 release would be an appropriation. The outcome may be that such a transmission stays at pm:corpusNamed permanently, and that is a finding and not an omission."@en .

#
# Properties of attribution
#

pm:attestedBy a owl:ObjectProperty ;
    rdfs:label "attested by"@en, "bezeugt durch"@de ;
    rdfs:range pm:Attesting ;
    skos:definition "Declares by which route a claim entered the record. Mandatory on every attribution, so that non-evidence cannot be forgotten."@en .

pm:readVia a owl:DatatypeProperty ;
    rdfs:label "read via"@en, "gelesen über"@de ;
    skos:definition "The work in which the passage was actually read, given as a bibliographic reference, where that work is not the one carrying the claim."@en ;
    skos:note "Deliberately separate from dcterms:source, for the same reason pm:evidenceFrom is. dcterms:source names what a reader must obtain to check the claim; this names what the writer of the node had in front of him. A record that fused them would report second-hand reading as first-hand and would lose the one distinction that makes an unreachable source admissible at all."@en ;
    skos:note "Required wherever pm:attestedBy is pm:mediatedAttestation. Carries a bibliographic reference and never a URL, enforced by pm:ReadViaIsLiteratureShape."@en .

pm:fieldRecord a owl:DatatypeProperty ;
    rdfs:label "field record"@en, "Aufnahmelage"@de ;
    skos:definition "How the cited passage was taken down: who spoke, or that the speaker is expressly withheld; who recorded; when and where; in which language; and whether the wording in the language of the telling is carried in the work or only a translation."@en ;
    skos:note "Required wherever pm:attestedBy is pm:fieldAttestation, enforced by pm:FieldAttestationShape. Prose and not a scale, for the reason pm:independenceGround is prose: there is no threshold at which a gathering becomes sound, and a scale would counterfeit a check. What the sentence is worth is decided by whoever reads it."@en ;
    skos:note "It names the gathering of this passage, not the standing of the corpus. The situation of a whole ethnographic tradition — span of the fieldwork against the year of publication, how many informants, whether the same people were revisited, whether material was delivered between visits, whether the recorder stood in a milieu already expecting what he found — belongs as a skos:note on the pm:Tradition instance. See prima-materia#260. The two are needed together: one says how far this sentence stands from its speaker, the other how far the corpus stands from the transmission."@en .

pm:ascribedCapacity a owl:ObjectProperty ;
    rdfs:label "ascribed capacity"@en, "zugeschriebenes Vermögen"@de ;
    rdfs:domain pm:Attributing ;
    rdfs:range pm:Conceptualizing ;
    skos:definition "The capacity that an attribution ascribes."@en .

pm:ascribedTo a owl:ObjectProperty ;
    rdfs:label "ascribed to"@en, "zugeschrieben an"@de ;
    rdfs:domain pm:Attributing ;
    skos:definition "The bearer to whom the capacity is ascribed: a named figure, a class of beings, humanity before a stated event."@en .

#
# Properties of ordering
#

pm:compiledBy a owl:DatatypeProperty ;
    rdfs:label "compiled by"@en, "geordnet von"@de ;
    rdfs:domain pm:Systematizing ;
    skos:definition "The named compiler who performed the ordering act. Without it, an order made in the present is indistinguishable from an order found in the source."@en .

pm:ordersClaim a owl:ObjectProperty ;
    rdfs:label "orders claim"@en, "ordnet Behauptung"@de ;
    rdfs:domain pm:Systematizing ;
    skos:definition "A claim that this ordering act groups. The claims keep their own attestation; only the grouping belongs to the compiler."@en .

#
# Properties of convergence
#

pm:convergingConcept a owl:ObjectProperty ;
    rdfs:label "converging concept"@en, "konvergierender Begriff"@de ;
    rdfs:domain pm:Converging ;
    rdfs:range pm:Conceptualizing ;
    skos:definition "A concept that participates in the observed correspondence."@en .

pm:transmissionPath a owl:DatatypeProperty ;
    rdfs:label "transmission path"@en, "Übertragungsweg"@de ;
    rdfs:domain pm:Converging ;
    skos:definition "A documented route of historical contact between the traditions in which the correspondence appears."@en ;
    skos:note "The earlier definition here said that the presence of a route downgrades the correspondence from convergence to reception. That was a judgement wearing the clothes of a definition, and it is withdrawn. A route says how a claim travelled, not whether anything was in it. Survival through many hands is selection, because most claims do not survive it, and a record that treats transmission as noise throws away the only evidence it has about what kept being worth copying."@en ;
    skos:note "What the route does decide is narrower and stays in force: an agreement reached along it may not be counted as independent attestation, because the same statement would be counted twice. Both may stand on one node, and on several they already do. The route bars a particular way of counting; it does not devalue the correspondence."@en .

pm:independentAttestation a owl:ObjectProperty ;
    rdfs:label "independent attestation"@en, "unabhängige Bezeugung"@de ;
    rdfs:domain pm:Converging ;
    rdfs:range pm:Tradition ;
    skos:definition "A tradition attesting the correspondence for which no route of contact is documented, so that its testimony is not the same statement counted a second time."@en ;
    skos:note "The earlier definition called this the only kind of attestation that makes a correspondence a finding. It is not: it is the kind that makes the count honest. A correspondence carried by reception is still a finding about what was carried; what it may not be is a tally of independent witnesses."@en .

pm:independenceGround a owl:DatatypeProperty ;
    rdfs:label "ground of independence"@en, "Grund der Unabhängigkeit"@de ;
    rdfs:domain pm:Converging ;
    skos:definition "The statement that carries a claim of independent attestation: when the testimony relied on was fixed or gathered, and against which publication or route that date stands."@en ;
    skos:note "Required wherever pm:independentAttestation is set, enforced by pm:IndependenceGroundShape. The burden is reversed on purpose. Feedback from a published account back into the field it describes can almost never be demonstrated, so a predicate that marked only the demonstrated cases would let the ordinary case pass in silence — the failure pm:CoverageState and pm:ExaminationState exist to prevent. A claim of independence must instead carry the fact that makes it checkable."@en ;
    skos:note "The date alone does not settle it, and the sentence must say more where more is at stake. Feedback within a single enquiry — few informants, several years, the same team returning, material gathered by an informant between visits — precedes any publication and no date catches it. Where the corpus was fixed that way, the ground states the gathering situation as well. Whether it does so honestly is settled at the merge and not by a shape; naming that limit is better than a guard that pretends to check it."@en .

#
# Properties of reworking
#

pm:reworkedClaim a owl:ObjectProperty ;
    rdfs:label "reworked claim"@en, "bearbeitete Behauptung"@de ;
    rdfs:domain pm:Reworking ;
    skos:definition "The claim that was taken over, as it stands in the tradition performing the reworking."@en .

pm:receivedFrom a owl:ObjectProperty ;
    rdfs:label "received from"@en, "übernommen von"@de ;
    rdfs:domain pm:Reworking ;
    rdfs:range pm:Tradition ;
    skos:definition "The transmission the claim was taken over from. The work and the place stay in dcterms:source; this names the transmission, so that the depth of a chain can be counted."@en .

pm:addedElement a owl:ObjectProperty ;
    rdfs:label "added element"@en, "hinzugefügtes Element"@de ;
    rdfs:domain pm:Reworking ;
    skos:definition "The node carrying what this station added and the exemplar does not have. Required: an addition that cannot be pointed at is an assertion about a chain and not a link in it."@en .

#
# Properties of practice and caution
#

pm:byPractice a owl:ObjectProperty ;
    rdfs:label "by practice"@en, "durch Praxis"@de ;
    rdfs:domain pm:Yielding ;
    rdfs:range pm:Practicing ;
    skos:definition "The practice a yielding claim proceeds from."@en .

pm:yieldsCapacity a owl:ObjectProperty ;
    rdfs:label "yields capacity"@en, "bringt Vermögen hervor"@de ;
    rdfs:domain pm:Yielding ;
    rdfs:range pm:Conceptualizing ;
    skos:definition "The capacity a yielding claim arrives at. That the tradition says so is the claim; that the practice produces it is not asserted."@en .

pm:cautionsAbout a owl:ObjectProperty ;
    rdfs:label "cautions about"@en, "warnt vor"@de ;
    rdfs:domain pm:Cautioning ;
    skos:definition "The capacity, practice or pursuit a warning is directed at."@en .

#
# Properties of testing
#

pm:disputedClaim a owl:ObjectProperty ;
    rdfs:label "disputed claim"@en, "strittiger Gegenstand"@de ;
    rdfs:domain pm:Disputing ;
    skos:definition "What the disagreement is about."@en .

pm:dependentStep a owl:ObjectProperty ;
    rdfs:label "dependent step"@en, "abhängiger Schritt"@de ;
    rdfs:domain pm:Presupposing ;
    skos:definition "The later step: the practice, state or capacity said not to be reached without the prior one."@en .

pm:priorStep a owl:ObjectProperty ;
    rdfs:label "prior step"@en, "vorausgesetzter Schritt"@de ;
    rdfs:domain pm:Presupposing ;
    skos:definition "The earlier step the later one is said to require."@en .

pm:prerequisiteStrength a owl:ObjectProperty ;
    rdfs:label "prerequisite strength"@en, "Stärke der Voraussetzung"@de ;
    rdfs:domain pm:Presupposing ;
    rdfs:range pm:PrerequisiteStrength ;
    skos:definition "How firmly the source sets the prerequisite."@en .

pm:consequenceOfSkipping a owl:DatatypeProperty ;
    rdfs:label "consequence of skipping"@en, "Folge des Überspringens"@de ;
    rdfs:domain pm:Presupposing ;
    skos:definition "What the source says happens if the prior step is passed over."@en ;
    skos:note "Required wherever the strength is pm:statedNecessity. Claiming that a text sets a necessity obliges the claimant to say what the text says goes wrong without it; a necessity nobody can quote a consequence for is an order read as a necessity."@en .

pm:examinationState a owl:ObjectProperty ;
    rdfs:label "examination state"@en, "Prüfstand"@de ;
    rdfs:domain pm:Testing ;
    rdfs:range pm:ExaminationState ;
    skos:definition "How far the attempt to fail the claim has been carried."@en .

pm:CounterSearchState a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Counter-Search State"@en, "Stand der Gegensuche"@de ;
    skos:definition "How far the attempt to find work opposing the evidence has been carried."@en ;
    skos:note "A study cited under pm:evidenceFrom is a party and not an instance. It carries its own claim, its own method and its own critics, and a protocol that admits it without looking for opposition has not examined the claim against the world but against one report of the world. That is the same error as testing a transmission against this holding instead of against its source, which SPEC §13 forbids, and it is easier to commit because a study looks like a verdict."@en ;
    skos:note "The state exists because the prose rule did not hold. It was written into AGENTS.md on 2026-09-02 after evidence was entered unread, and within the same session evidence was entered again without any search for opposition. A rule that has to be remembered at the moment of writing is a rule that fails at the moment of haste."@en .

pm:counterSearchNotCarried a pm:CounterSearchState ;
    rdfs:label "Counter-search not carried"@en, "Gegensuche nicht geführt"@de ;
    skos:definition "No attempt has been made to find work that contradicts, fails to replicate, or supersedes the evidence cited."@en .

pm:counterSearchFoundNothing a pm:CounterSearchState ;
    rdfs:label "Counter-search found nothing"@en, "Gegensuche ohne Fund"@de ;
    skos:definition "A search for opposing or non-replicating work was carried and returned nothing. This is a statement about the search, and the note must say what was searched."@en .

pm:counterSearchFoundOpposition a pm:CounterSearchState ;
    rdfs:label "Counter-search found opposition"@en, "Gegensuche mit Fund"@de ;
    skos:definition "A search returned work that contradicts the evidence, fails to replicate it, or narrows its reach. What was found belongs in the note and, where it bears on the finding, in the protocol's own notes."@en .

pm:counterSearch a owl:ObjectProperty ;
    rdfs:label "counter-search"@en, "Gegensuche"@de ;
    rdfs:domain pm:Testing ;
    rdfs:range pm:CounterSearchState ;
    skos:definition "How far the search for work opposing the cited evidence has been carried."@en ;
    skos:note "Required wherever pm:evidenceFrom is set, enforced by pm:CounterSearchRequiredShape. A protocol that records no state here is not neutral about the question; it has not asked it."@en .

pm:counterSearchNote a owl:DatatypeProperty ;
    rdfs:label "counter-search note"@en, "Notiz zur Gegensuche"@de ;
    rdfs:domain pm:Testing ;
    skos:definition "What was searched for and what came back, stated so that the search itself can be judged."@en ;
    skos:note "Required wherever pm:counterSearch is set, enforced by pm:CounterSearchNoteRequiredShape. Without it, pm:counterSearchFoundNothing is indistinguishable from a search nobody ran, and it is the state a hasty protocol would reach for."@en .

pm:undividedOutcomes a owl:DatatypeProperty ;
    rdfs:label "undivided outcomes"@en, "nicht geschiedene Ausgänge"@de ;
    rdfs:domain pm:Testing ;
    skos:definition "The differing outcomes that the claim treats alike, named so that the charge of saying nothing is itself checkable."@en ;
    skos:note "Required wherever the state is pm:claimDoesNotDiscriminate, enforced by pm:UndividedOutcomesRequiredShape. The burden falls on the examiner for the same reason it does at pm:independenceGround: a verdict that a claim says nothing is easy to reach and hard to contest, and one that names no pair of outcomes it fails to separate is an opinion about the claim rather than a finding about it."@en .

pm:examinedBy a owl:DatatypeProperty ;
    rdfs:label "examined by"@en, "geprüft von"@de ;
    rdfs:domain pm:Testing ;
    skos:definition "Who devised or carried the protocol. A protocol without a named author is unaccountable, and an unaccountable protocol is not evidence of anything."@en .

pm:evidenceFrom a owl:DatatypeProperty ;
    rdfs:label "evidence from"@en, "Evidenz aus"@de ;
    rdfs:domain pm:Testing ;
    skos:definition "A modern work bearing on the claim under examination, given as a bibliographic reference or a work identifier."@en ;
    skos:note "Deliberately not dcterms:source. A modern study is never a witness to a tradition and must never appear as the source of one of its claims; it bears on a claim only as evidence inside an examination. Keeping the two predicates apart is what allows research to enter the record at all without loosening the rule that sources are received works."@en .

pm:tests a owl:ObjectProperty ;
    rdfs:label "tests"@en, "prüft"@de ;
    rdfs:domain pm:Testing ;
    skos:definition "The claim this protocol attempts to fail."@en .

pm:falsifiedBy a owl:DatatypeProperty ;
    rdfs:label "falsified by"@en, "widerlegt durch"@de ;
    rdfs:domain pm:Testing ;
    skos:definition "The stated condition under which the claim counts as refuted."@en .

pm:baseRate a owl:DatatypeProperty ;
    rdfs:label "base rate"@en, "Basisrate"@de ;
    rdfs:domain pm:Testing ;
    skos:definition "The rate against which observed outcomes are compared, with the population it was taken from."@en .

pm:caseCount a owl:DatatypeProperty ;
    rdfs:label "case count"@en, "Fallzahl"@de ;
    rdfs:domain pm:Testing ;
    rdfs:range xsd:integer ;
    skos:definition "The number of cases recorded under this protocol so far."@en .

pm:protocolUpdated a owl:DatatypeProperty ;
    rdfs:label "protocol updated"@en, "Protokollstand"@de ;
    rdfs:domain pm:Testing ;
    rdfs:range xsd:date ;
    skos:definition "The date on which the count was last carried forward. A protocol without this date claims a scrutiny it does not document."@en .

#
# Claims with no substrate under them
#
# Two classes for the case the rest of this file cannot hold. pm:Systematizing
# orders material that was already there and points at it; pm:Testing tries to
# fail a claim and points at it. Both presuppose that the thing pointed at is in
# the graph. The most valuable cases are exactly the ones where it is not.
#
# A modern scale that ranks emotions by reach orders no tradition, because no
# tradition ranks them. A draft nobody published makes claims that a protocol
# could address, but the draft itself cannot enter as a source. Left as they
# were, both would either stay out of the record or be forced into a class
# whose meaning breaks under them.
#

pm:Originating a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Originating"@en, "Urheben"@de ;
    skos:definition "The act of first putting forward a claim that no transmission carries, in a work that can be named and dated, where the claim afterwards circulates as though it were old."@en ;
    skos:note "Distinct from pm:Systematizing, which arranges material that was already there and names what it arranges. An origination arranges nothing: the claim begins with it. Holding the two apart is what keeps the record from reporting an invention as an ordering of something ancient, which is the commonest way a modern construction acquires a warrant."@en ;
    skos:note "The circulating ascription is the point of the class, not an addendum to it. A node that names only the author and the work is a bibliography; a node that also names what the claim is taken for is the finding, and it is the kind of finding this project exists to make."@en .

pm:Positing a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Positing"@en, "Setzen"@de ;
    skos:definition "A claim held in the graph solely so that a protocol has something to address. It witnesses no transmission, claims no source, and belongs to no tradition."@en ;
    skos:note "The class exists because a protocol needs an object and because the claims most worth examining are often the ones no received work carries. It is deliberately narrow: an instance may exist only where a pm:Testing points at it, enforced by pm:PositingRequiresExaminationShape. Without that restriction the class would become the channel through which an unpublished draft enters the record after all, and the direction the project runs in would be reversed."@en .

#
# Properties of origination
#

pm:originatedBy a owl:DatatypeProperty ;
    rdfs:label "originated by"@en, "aufgestellt von"@de ;
    rdfs:domain pm:Originating ;
    skos:definition "The named author with whom the claim begins."@en .

pm:circulatesAs a owl:DatatypeProperty ;
    rdfs:label "circulates as"@en, "zirkuliert als"@de ;
    rdfs:domain pm:Originating ;
    skos:definition "The ascription under which the claim is commonly reported: the tradition, the age or the authority it is credited to and does not have."@en .

#
# Properties of positing
#

pm:positedIn a owl:DatatypeProperty ;
    rdfs:label "posited in"@en, "gesetzt in"@de ;
    rdfs:domain pm:Positing ;
    skos:definition "Where the claim was put forward, given as an identifier rather than as a bibliographic reference: an issue number, a draft designation. Deliberately not dcterms:source, because what is named here is not a work a reader can obtain and must never be counted as one."@en .

#
# The claim of a speaker other than the writer
#
# A body of material in which a person reports speech he does not ascribe to
# himself puts a claim into the record that none of the existing modes
# carries. pm:firstPersonReport attests what somebody reports of himself;
# pm:thirdPartyAscription ascribes a capacity to another. Here both hold at
# once and neither alone: the report is first-hand, the claimed speaker is
# somebody else, and that somebody cannot be questioned.
#
# The consequence of leaving it unmodelled is not a gap but a silent verdict.
# The ascription migrates into dcterms:source, and a reference of the form
# "Ra, session 41" settles the contested question by the shape of a citation,
# unnoticed, because it looks like every other reference to a work. The
# source must name what a reader can obtain: editor, title, session. Who
# spoke in that session is a claim about the work and gets a node.
#
# The claim is therefore held here and not as a mode of attestation. The
# sentences in the work are attested textually, because they stand there; what
# is asserted beyond that is the authorship, and it is asserted by the work
# about itself. The node attests the receiving and never the content of what
# was received — the same boundary pm:compilerInference is held to, and for
# the same reason. See prima-materia#95.
#

pm:Receiving a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Receiving"@en, "Empfangen"@de ;
    skos:definition "The claim, made in or about a work, that its wording was received from a speaker other than the person who wrote or spoke it down."@en ;
    skos:note "Distinct from pm:Originating, which names the author with whom a claim begins and the ascription it circulates under. A receiving makes no finding about who really composed the material; it records that the work claims a speaker, so that the claim is addressable, countable and disputable instead of riding invisibly in a citation."@en ;
    skos:note "Whether an agreement between two such corpora can ever be more than reception is a separate question and a hard one. The route is documented across the whole block: the vocabulary runs on from Theosophy. A convergence there needs the demonstration that a receiver did not know the earlier literature, and that demonstration is expensive and rare."@en .

pm:receivedBy a owl:DatatypeProperty ;
    rdfs:label "received by"@en, "empfangen durch"@de ;
    rdfs:domain pm:Receiving ;
    skos:definition "The person through whom the wording was received, named as the work names them."@en .

pm:claimedSpeaker a owl:DatatypeProperty ;
    rdfs:label "claimed speaker"@en, "behaupteter Sprecher"@de ;
    rdfs:domain pm:Receiving ;
    skos:definition "The speaker the work claims for the wording, given as the work gives it. A literal and not a link to a named being: what is recorded is the claim, and typing it as a bearer would grant the claim the thing it is asserting."@en .

pm:receptionCircumstance a owl:DatatypeProperty ;
    rdfs:label "reception circumstance"@en, "Umstand des Empfangs"@de ;
    skos:definition "The circumstances of the receiving: the state the receiver is said to have been in, who put the questions, who took the wording down, and whether a record of the proceeding itself exists beyond the edited text."@en ;
    skos:note "Required on every receiving, enforced by pm:ReceivingShape. Without it the node says only that a speaker is claimed, which a reader could have guessed from the title; with it the claim can be weighed against the ones this literature makes about itself."@en .

#
# The derived claim
#
# The layer between what the traditions say and what a protocol can address.
# A tradition says that this practice yields this capacity, and that claim
# carries a work and a passage. The statement worth examining says that
# practices of a kind yield an effect of a kind, and no source says it: it is
# formed from several attested claims and belongs to none of them.
#
# Without a class for it the layer had two bad homes. As pm:Converging it
# would be a correspondence between concepts, which asserts nothing about the
# world and cannot be failed. As pm:Positing it could exist only where a
# pm:Testing already pointed at it, so the set of claims awaiting examination
# could never be written down — the queue would presuppose the work it exists
# to order.
#

pm:Generalizing a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Generalizing"@en, "Verallgemeinern"@de ;
    skos:definition "The act of forming, from several attested claims, one statement that no source makes: a claim about a kind of practice or a kind of effect, worded so that an outcome could contradict it."@en ;
    skos:note "It carries a derivation instead of an origin, and the derivation is checkable in the same way a source is. pm:generalizedFrom points at the attested nodes it was formed from, so a reader can go back to the passages and disagree with the step rather than with the conclusion alone."@en ;
    skos:note "That is also the whole safeguard against the direction the project must not run in. An unpublished draft has no attested predecessors: a sentence from a method draft cannot be generalized into the graph, because there is nothing for pm:generalizedFrom to point at. The class is therefore open where pm:Positing had to be locked, and locked where pm:Positing is open."@en ;
    skos:note "No instance may carry dcterms:source or pm:withinTradition. A generalization that named a work would report as transmitted what no transmission says, and that is the one confusion this layer exists to prevent."@en ;
    skos:note "The absence of a pm:Testing pointing at a generalization is not a defect and is deliberately not enforced. It is the queue: the generalizations nobody has taken up are exactly the ones a run should reach for, and a shape that required a protocol would make the queue unwritable, as it does for pm:Positing."@en .

#
# Properties of generalization
#

pm:generalizedStatement a owl:DatatypeProperty ;
    rdfs:label "generalized statement"@en, "verallgemeinerte Aussage"@de ;
    rdfs:domain pm:Generalizing ;
    skos:definition "The claim itself, stated in the abstract and worded so that a result could contradict it."@en ;
    skos:note "A wording that covers an outcome and its opposite alike is the failure pm:claimDoesNotDiscriminate records after the fact. Here the cost is lower: it can be caught while the sentence is being written."@en .

pm:generalizedFrom a owl:ObjectProperty ;
    rdfs:label "generalized from"@en, "verallgemeinert aus"@de ;
    rdfs:domain pm:Generalizing ;
    skos:definition "An attested claim the generalization was formed from. At least two are required, and each must itself name a work."@en ;
    skos:note "Two is a floor and not a target. How many attested claims a generalization rests on, and how far apart their traditions stand, are the numbers that make one worth examining before another — the same distinction pm:Converging draws between many witnesses on one cable and many on three."@en .

#
# Placement on an awareness axis
#
# A source describes a condition; it does not name a coordinate. Reading
# "from the fourth absorption" as withdrawn absorption is an identification,
# and by Parameter 5 an identification that carries an attestation mode cannot
# ride on an edge. It is therefore a node, like every other claim form here,
# and for the same reason: on an edge a compiler's reading and a source's own
# words would look alike.
#
# Two consequences worth stating, because they are what the class is for.
# The reading can be disputed without touching the claim it situates, exactly
# as pm:Converging can be disputed without touching what it joins. And the
# absence of a placement means nobody asked, while a placement on a
# not-stated value means somebody asked and the source is silent — the same
# asymmetry pm:Testing keeps between no procedure devised and a procedure
# that found nothing.
#

pm:Situating a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Situating"@en, "Verorten"@de ;
    skos:definition "The placement of a claim, a practice or a capacity at a value on an awareness axis. The node records the compiler's identification of a described condition with a coordinate, not the description itself."@en ;
    skos:note "Normally attested by pm:compilerInference. Textual attestation is available only where the source itself draws the distinction the axis draws — the Sufi division of what descends from what is attained is the clear case — and even then the wording that carries it belongs in pm:situationGround."@en .

pm:situatedNode a owl:ObjectProperty ;
    rdfs:label "situated node"@en, "verorteter Knoten"@de ;
    rdfs:domain pm:Situating ;
    skos:definition "The node being placed: a practice, a capacity claim, a concept or a prerequisite claim."@en .

pm:axisValue a owl:ObjectProperty ;
    rdfs:label "axis value"@en, "Achsenwert"@de ;
    rdfs:domain pm:Situating ;
    rdfs:range pm:AwarenessValue ;
    skos:definition "The coordinate the node is placed at. One value per node; a claim placed on two axes is two placements, and a claim placed at two values on one axis is either two claims or a dispute."@en .

pm:situationGround a owl:DatatypeProperty ;
    rdfs:label "situation ground"@en, "Verortungsgrund"@de ;
    rdfs:domain pm:Situating ;
    skos:definition "What in the source carries the placement, in the compiler's words: the condition the passage describes, and why it is read as this coordinate."@en ;
    skos:note "Required. Without it a placement is a bare assignment, and a later reader can neither check it nor contradict it — the same reason pm:counterSearchNote is required as soon as a counter-search state is set."@en .
