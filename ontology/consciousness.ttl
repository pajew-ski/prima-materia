@prefix pm:      <https://pajew.ski/prima-materia/ontology#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

#
# prima-materia — the awareness axes
#
# What stood here before was a single flat list holding two incompatible
# things: four states of a human being taken from the Māṇḍūkya Upaniṣad, and
# two modes of assertion that pm:attestedBy already carries in full. Nothing
# in the holdings ever pointed at any of them. The cause was not neglect. A
# flat list cannot record that a practice is performed with the senses
# withdrawn while the awareness stays in the body and the agency stays with
# the practitioner, because those are three answers and the list had one slot.
#
# The states are therefore modelled as four independent axes. Each is a scale
# in the sense of ontology/scales.ttl, family pm:subjectAxis, and each carries
# a declining value and a not-stated value for the reasons given there.
#
# Two things this file does not do, both deliberately.
#
# It does not carry dcterms:source. An axis is vocabulary: it asserts nothing
# and states what would count as an instance. The earlier file cited Māṇḍūkya
# verses on its values, which made a coordinate look like a tradition's claim
# and put an Advaita doctrine in the position of the frame every other
# tradition is measured against. The states are available to anyone and are
# not owned by whoever first wrote them down; the terms in which a tradition
# names them are that tradition's claim and belong in its own file, as
# pm:Naming or pm:Conceptualizing nodes with a passage and an edition.
#
# It does not carry a value for turīya. The three of the four Māṇḍūkya states
# that are on an axis are here under other names; the fourth is not a further
# position on that axis but a claim that a single awareness underlies the
# other three. That is a doctrine, it is contested between traditions, and it
# belongs in traditions/upanisadic.ttl as a claim with a passage, not in the
# coordinate system.
#

pm:AwarenessValue a owl:Class ;
    rdfs:label "Awareness Axis Value"@en, "Wert einer Bewusstseinsachse"@de ;
    skos:definition "A value on one of the awareness axes. The class exists so that a single constraint can keep pm:axisValue to the declared coordinates; every value below carries it alongside the axis it belongs to."@en .

#
# Axis 1 — sensory anchoring
#
# The decision criterion: what the source says about the relation between the
# practitioner's attention and the ordinary sensory channel. This is the axis
# most methods are actually bound to, and the one the Māṇḍūkya list came
# closest to without covering it, because it has no place for the waking state
# with the senses withdrawn in which most of the holdings' capacities are
# said to be exercised.
#

pm:SensoryAnchoring a owl:Class ;
    rdfs:label "Sensory Anchoring"@en, "Sinnesbindung"@de ;
    skos:definition "The axis on which the relation of awareness to the ordinary sensory channel is placed, from outward waking perception through withdrawal, the edge of sleep and dreaming to a condition in which no object is apprehended."@en .

pm:outwardWaking a pm:SensoryAnchoring, pm:AwarenessValue ;
    rdfs:label "Outward waking"@en, "Nach außen gerichtetes Wachen"@de ;
    skos:definition "Awareness turned to the senses and to the world they report, with the body in ordinary use."@en ;
    skos:note "Set this where the source has the act performed openly, in the world, among others: an invocation spoken aloud, a divination read off an object, a healing performed by touch. The Māṇḍūkya calls this jāgrat."@en .

pm:withdrawnAbsorption a pm:SensoryAnchoring, pm:AwarenessValue ;
    rdfs:label "Withdrawn absorption"@en, "Abgezogene Vertiefung"@de ;
    skos:definition "Awake and not asleep, with the senses withdrawn from their objects and attention held on a single one. The condition the handbooks of concentration describe and require."@en ;
    skos:note "Set this where the source binds the act to a named degree of absorption, to a suspension of the breath, or to a prayer of the heart held past the point at which the outward senses report. This value has no counterpart in the fourfold list, which is the main reason that list could not be used."@en .

pm:sleepThreshold a pm:SensoryAnchoring, pm:AwarenessValue ;
    rdfs:label "Sleep threshold"@en, "Schlafschwelle"@de ;
    skos:definition "The passage between waking and sleeping in either direction, in which the sensory channel is partly detached and the body may already be immobile while awareness continues."@en ;
    skos:note "Set this where the source describes the condition rather than the clock: sleep departing and waking beginning, an inability to move, a luminosity at the moment of falling asleep. The holdings already carry the finding that this state is well attested as a place of reception and not as a place where a faculty is exercised; see convergences/threshold-of-sleep.ttl."@en .

pm:dreamingWithin a pm:SensoryAnchoring, pm:AwarenessValue ;
    rdfs:label "Dreaming within"@en, "Im Traum"@de ;
    skos:definition "Awareness of objects generated inwardly, with the sensory channel detached. Whether the dreamer knows he dreams is a separate question and not this axis."@en ;
    skos:note "The Māṇḍūkya calls this svapna. Lucidity is deliberately not a value here: it varies within the state rather than replacing it, and a source that trains recognition inside the dream is placed here and says so in its own words."@en .

pm:objectlessDepth a pm:SensoryAnchoring, pm:AwarenessValue ;
    rdfs:label "Objectless depth"@en, "Gegenstandslose Tiefe"@de ;
    skos:definition "A condition in which no object at all is apprehended, whether reached in sleep or in a cessation described by a handbook of absorption."@en ;
    skos:note "The Māṇḍūkya calls this suṣupti. A source that has something exercised here is worth a second look before it is entered, because most traditions place their capacities short of it."@en .

pm:anchoringDeclined a pm:SensoryAnchoring, pm:AwarenessValue ;
    rdfs:label "Anchoring distinction declined"@en, "Sinnesbindung als Unterscheidung abgelehnt"@de ;
    skos:definition "The tradition holds that the distinction this axis draws does not apply to what it teaches: nothing is to be withdrawn from and no state is to be entered, because whatever arises is taken as the way."@en ;
    skos:note "A positive claim about a tradition and not a gap in the record. It needs a passage like any other claim; the same shape as pm:normDistinctionDeclined and pm:selfBoundaryDeclined on the two orientation axes."@en .

pm:anchoringNotStated a pm:SensoryAnchoring, pm:AwarenessValue ;
    rdfs:label "Anchoring not stated"@en, "Sinnesbindung nicht angegeben"@de ;
    skos:definition "The source was read for this question and does not answer it."@en ;
    skos:note "Not the same as an untagged node, and the difference is what makes a query of the form 'only in this state' readable at all. No placement means nobody asked; this value means somebody asked and the source is silent."@en .

#
# Axis 2 — locus of awareness
#

pm:AwarenessLocus a owl:Class ;
    rdfs:label "Awareness Locus"@en, "Ort des Bewusstseins"@de ;
    skos:definition "The axis on which a source's account of where the awareness is located during the act is placed: with the body, or apart from it."@en .

pm:embodiedLocus a pm:AwarenessLocus, pm:AwarenessValue ;
    rdfs:label "Embodied"@en, "Im Körper"@de ;
    skos:definition "Awareness is located where the body is, whatever it perceives at a distance."@en ;
    skos:note "Distant sight reported from a motionless practitioner is embodied. The axis asks where the seer is, not how far he sees."@en .

pm:displacedLocus a pm:AwarenessLocus, pm:AwarenessValue ;
    rdfs:label "Displaced"@en, "Verlagert"@de ;
    skos:definition "The source has the awareness, or a body made of mind, leave the place of the physical body and act elsewhere."@en ;
    skos:note "The holdings already gather the material for this value across traditions; see convergences/stream.ttl and examinations/displacement.ttl."@en .

pm:locusDeclined a pm:AwarenessLocus, pm:AwarenessValue ;
    rdfs:label "Locus distinction declined"@en, "Ortsunterscheidung abgelehnt"@de ;
    skos:definition "The tradition holds that the distinction between an awareness in the body and an awareness apart from it does not apply, because it does not grant the localisation the axis presupposes."@en .

pm:locusNotStated a pm:AwarenessLocus, pm:AwarenessValue ;
    rdfs:label "Locus not stated"@en, "Ort nicht angegeben"@de ;
    skos:definition "The source was read for this question and does not answer it."@en .

#
# Axis 3 — holding of agency
#

pm:AgencyHolding a owl:Class ;
    rdfs:label "Agency Holding"@en, "Trägerschaft der Handlung"@de ;
    skos:definition "The axis on which a source's account of who acts is placed: the practitioner, or another to whom the practitioner has yielded."@en .

pm:ownAgency a pm:AgencyHolding, pm:AwarenessValue ;
    rdfs:label "Own agency"@en, "Eigene Trägerschaft"@de ;
    skos:definition "The practitioner acts, and what comes of it is credited to the practice."@en .

pm:cededAgency a pm:AgencyHolding, pm:AwarenessValue ;
    rdfs:label "Ceded agency"@en, "Abgetretene Trägerschaft"@de ;
    skos:definition "The source has another speak or act through the practitioner, who is described as receiving, carrying or being ridden rather than as doing."@en ;
    skos:note "The axis records the account the source gives, not a verdict on it. A tradition that credits a spirit and one that credits a trained faculty differ in what they claim, and that difference is worth holding whatever either claim is worth."@en .

pm:agencyDeclined a pm:AgencyHolding, pm:AwarenessValue ;
    rdfs:label "Agency distinction declined"@en, "Trägerschaftsunterscheidung abgelehnt"@de ;
    skos:definition "The tradition holds that the distinction between acting and being acted through does not apply to what it teaches."@en .

pm:agencyNotStated a pm:AgencyHolding, pm:AwarenessValue ;
    rdfs:label "Agency not stated"@en, "Trägerschaft nicht angegeben"@de ;
    skos:definition "The source was read for this question and does not answer it."@en .

#
# Axis 4 — acquisition, and Axis 5 — duration
#
# These two stood as one axis until the first rollout of placements, under the
# name pm:StatePersistence, with occasioned at one end and established at the
# other. The Sufi handbooks fit it, because they happen to answer both
# questions the same way: the aḥwāl are neither worked for nor kept, the
# maqāmāt are both. The Inuit material broke it. Second sight is reported as a
# standing property of a person and expressly not as the outcome of an
# exercise — not attained, and not passing either. One axis had no place for
# it, and the two ends were carrying two questions between them.
#
# That is the same fault as the flat state list this file replaced, one level
# down, and it is corrected the same way. Whether a condition is worked for
# and whether it lasts are independent, and a source can answer one and not
# the other. See prima-materia#439.
#

pm:StateAcquisition a owl:Class ;
    rdfs:label "State Acquisition"@en, "Erwerb des Zustands"@de ;
    skos:definition "The axis on which a source's account of how a condition comes to someone is placed: through effort directed at it, or not."@en .

pm:byEffort a pm:StateAcquisition, pm:AwarenessValue ;
    rdfs:label "By effort"@en, "Durch Anstrengung"@de ;
    skos:definition "The source has the condition attained by practice directed at attaining it."@en ;
    skos:note "This is the end of the axis where prerequisite chains are to be expected, and where their absence is worth a question. The Sufi handbooks call these maqāmāt and enumerate them in a set order."@en .

pm:notByEffort a pm:StateAcquisition, pm:AwarenessValue ;
    rdfs:label "Not by effort"@en, "Nicht durch Anstrengung"@de ;
    skos:definition "The source has the condition arrive without being worked for: given, inherited, conferred at birth, or descending on the wayfarer as a gift."@en ;
    skos:note "Where a source says this, a missing prerequisite claim is a doctrine and not an omission. The Sufi handbooks say it outright of the aḥwāl; the Inuit narrative says it of second sight in another way, by reporting the capacity as something a person has."@en .

pm:acquisitionDeclined a pm:StateAcquisition, pm:AwarenessValue ;
    rdfs:label "Acquisition distinction declined"@en, "Erwerbsunterscheidung abgelehnt"@de ;
    skos:definition "The tradition holds that the distinction between what is worked for and what is given does not apply to what it teaches."@en .

pm:acquisitionNotStated a pm:StateAcquisition, pm:AwarenessValue ;
    rdfs:label "Acquisition not stated"@en, "Erwerb nicht angegeben"@de ;
    skos:definition "The source was read for this question and does not answer it."@en .

pm:StateDuration a owl:Class ;
    rdfs:label "State Duration"@en, "Dauer des Zustands"@de ;
    skos:definition "The axis on which a source's account of how long a condition holds is placed: passing of itself, or abiding once it is there."@en .

pm:transientState a pm:StateDuration, pm:AwarenessValue ;
    rdfs:label "Transient"@en, "Vergehend"@de ;
    skos:definition "The source has the condition pass of itself, so that it must be entered again rather than merely kept."@en ;
    skos:note "A capacity said to come and go is a different object of examination from one said to last: it is tested against frequency and occasion, not against a course of training."@en .

pm:abidingState a pm:StateDuration, pm:AwarenessValue ;
    rdfs:label "Abiding"@en, "Bleibend"@de ;
    skos:definition "The source has the condition remain with the one who has it, whether it was worked for or not."@en .

pm:durationDeclined a pm:StateDuration, pm:AwarenessValue ;
    rdfs:label "Duration distinction declined"@en, "Dauerunterscheidung abgelehnt"@de ;
    skos:definition "The tradition holds that the distinction between a passing and an abiding condition does not apply to what it teaches."@en .

pm:durationNotStated a pm:StateDuration, pm:AwarenessValue ;
    rdfs:label "Duration not stated"@en, "Dauer nicht angegeben"@de ;
    skos:definition "The source was read for this question and does not answer it."@en .
