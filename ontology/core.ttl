@prefix pm:      <https://pajew.ski/prima-materia/ontology#> .
@prefix pmt:     <https://pajew.ski/prima-materia/traditions/> .
@prefix pmc:     <https://pajew.ski/prima-materia/concepts/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

#
# prima-materia — core meta-ontology
#
# Every main class is a gerund (process noun). Static-substance classes
# (Symbol, Concept, Entity, Object) are deliberately absent and are
# blacklisted by SHACL.
#

<https://pajew.ski/prima-materia/ontology> a owl:Ontology ;
    dcterms:title "prima-materia core ontology"@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    rdfs:comment "Consciousness-first meta-ontology. Processes, not substances."@en .

#
# Root process class
#

pm:Process a owl:Class ;
    rdfs:label "Process"@en, "Prozess"@de ;
    skos:definition "The root class of all ongoing acts modelled by prima-materia. Every substantive class in the ontology is a subclass of pm:Process."@en .

#
# Core process subclasses
#

pm:Symbolizing a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Symbolizing"@en, "Symbolisieren"@de ;
    skos:definition "The act of one form standing for another within awareness."@en .

pm:Manifesting a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Manifesting"@en, "Manifestieren"@de ;
    skos:definition "The emergence of a form out of a prior undifferentiated ground."@en .

pm:Perceiving a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Perceiving"@en, "Wahrnehmen"@de ;
    skos:definition "The act of apprehending form within an awareness context."@en .

pm:Practicing a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Practicing"@en, "Praktizieren"@de ;
    skos:definition "An operative procedure enacted within a tradition."@en .

pm:Tradition a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Tradition"@en, "Tradition"@de ;
    skos:definition "A knowledge tradition understood as an ongoing act of transmission rather than a static corpus."@en .

pm:Conceptualizing a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Conceptualizing"@en, "Begriffsbildung"@de ;
    skos:definition "The formation of a concept as an act within awareness; instances of this class are concept nodes such as pmc:Pleroma or pmc:Hen."@en .

pm:Relating a owl:Class ;
    rdfs:subClassOf pm:Process ;
    rdfs:label "Relating"@en, "Beziehen"@de ;
    skos:definition "The act of placing one concept in relation to another."@en .

#
# pm:MeaningCluster and pm:hasClusterMember stood here and are struck. From
# Phase 0 to the day they were removed, no node in the holdings was a member of
# a cluster. Their purpose was embedding as a vector, and while there is no
# embedding the class asserted an intention rather than holding anything: a
# construction that points at nothing for that long is no longer foresight.
#
# The Sphoṭa principle they were meant to carry is not withdrawn as a reading;
# what is withdrawn is the claim that this graph implements it. Should a first
# cluster ever actually be formed — the aeon system and the series of
# absorptions were the candidates SPEC itself named — the class comes back with
# its member, and not before. See prima-materia#436.
#

#
# The awareness axes live in ontology/consciousness.ttl. The single class
# pm:AwarenessContext that stood here mixed two questions — the state a person
# was in, and the mode in which an assertion entered the record — and pointed
# at nothing in the holdings for as long as it existed. The second question is
# pm:attestedBy and always was; the first is four axes, because it is four
# questions. See prima-materia#401.
#

#
# pm:AwarenessSpace with its four values, and pm:hasAwarenessSpace, stood here
# and are struck. Like the two constructions above they date from Phase 0 and
# no node ever pointed at them.
#
# The distinction they drew is real: a practice performed alone, one binding
# two people, and a collective ceremony differ, and the holdings carry all
# three kinds. What was wrong was the granularity, and it is the same defect
# that killed pm:AwarenessContext. pm:hasAwarenessSpace is an edge, so a
# compiler's reading and a source's own words would look alike on it, and the
# assignment could be neither grounded nor disputed. The axis also had neither
# a declining value nor a not-stated value (prima-materia#433), so an
# unassigned node and a source read and silent were indistinguishable.
#
# Should the reach of a practice be wanted, it comes back as an axis under
# pm:Situating, with a ground, a declining value and a not-stated value, like
# the five that work. Adding those values to an edge nobody uses would have
# been vocabulary for holdings that do not exist. See prima-materia#436.
#

#
# Core properties
#

pm:withinTradition a owl:ObjectProperty ;
    rdfs:label "within tradition"@en ;
    rdfs:range pm:Tradition ;
    skos:definition "Associates a process instance with the tradition in which it is situated."@en .

pm:analogueConcept a owl:ObjectProperty ;
    rdfs:label "analogue concept"@en ;
    rdfs:domain pm:Conceptualizing ;
    rdfs:range pm:Conceptualizing ;
    skos:definition "A cross-tradition structural analogue, weaker than owl:sameAs and distinct from skos:closeMatch in that it asserts role-in-process similarity rather than lexical overlap."@en .

pm:hasSymbolicForm a owl:ObjectProperty ;
    rdfs:label "has symbolic form"@en ;
    rdfs:range pm:Symbolizing ;
    skos:definition "Associates a concept with one or more symbolic representations (sigils, diagrams, glyphs)."@en .

# pm:hasClusterMember and pm:hasAwarenessSpace stood here and are struck with
# the classes they served. See the two notes above.
