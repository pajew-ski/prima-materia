@prefix pm:      <https://pajew.ski/prima-materia/ontology#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

#
# prima-materia — coverage and contact vocabulary
#
# Why this exists. Until now a tradition was either in the graph, and then it
# carried nodes, or absent, and then nothing said so. Both readings of an
# absence were available at once: the corpus is thin, or nobody has opened it.
# That is the same confusion pm:ExaminationState was built to prevent on the
# examination axis, and it is prevented here the same way, by a controlled
# scale that a reader can see.
#
# A registered tradition is therefore not a thin file. It is a named corpus
# with a stated coverage state, and the state says outright that no passage
# has been read. What it buys is a denominator: over- and under-representation
# become countable, because the graph now holds what is missing as well as
# what is present.
#

pm:CoverageState a owl:Class ;
    rdfs:label "Coverage state"@en, "Erschließungsstand"@de ;
    skos:definition "How far the corpus of a tradition has been carried into the graph. The scale exists so that a transmission nobody has opened and a transmission whose corpus is genuinely thin never read alike."@en .

pm:corpusNamed a pm:CoverageState ;
    rdfs:label "Corpus named"@en, "Korpus benannt"@de ;
    skos:definition "The transmission is registered and its principal corpus is named. No passage has been read, no edition has been settled, and no node stands under it. A tradition in this state witnesses nothing and may not be counted as a party to a convergence."@en .

pm:workOpened a pm:CoverageState ;
    rdfs:label "Work opened"@en, "Werk geöffnet"@de ;
    skos:definition "A work of the corpus has been obtained and read and its edition is settled, but no passage has yet been entered as a node."@en .

pm:placesEntered a pm:CoverageState ;
    rdfs:label "Places entered"@en, "Stellen eingetragen"@de ;
    skos:definition "At least one passage has been read in a named edition and entered as a node. This is the state in which a tradition begins to witness."@en .

pm:corpusHarvested a pm:CoverageState ;
    rdfs:label "Corpus harvested"@en, "Korpus geerntet"@de ;
    skos:definition "The harvest has been carried out for the works actually opened, and what was left unread is recorded. The state claims completeness for what was opened, never for the corpus."@en .

pm:ContactRoute a owl:Class ;
    rdfs:label "Contact route"@en, "Kontaktweg"@de ;
    skos:definition "Whether a route of transmission is known between a tradition and those the graph already holds. It decides whether an agreement may be read as independent attestation or only as reception, and it is therefore a property of the tradition and not of the individual correspondence."@en .

pm:contactRouteDocumented a pm:ContactRoute ;
    rdfs:label "Contact route documented"@en, "Kontaktweg belegt"@de ;
    skos:definition "A route of transmission to traditions already held is documented. Agreement with them counts as reception."@en .

pm:contactRouteDisputed a pm:ContactRoute ;
    rdfs:label "Contact route disputed"@en, "Kontaktweg strittig"@de ;
    skos:definition "A route has been proposed and is contested in the scholarship. Agreement counts as neither reception nor independent attestation until the dispute is entered as its own node."@en .

pm:contactRouteAbsent a pm:ContactRoute ;
    rdfs:label "Contact route absent"@en, "Kein Kontaktweg"@de ;
    skos:definition "No route is available for the period in which the corpus was fixed. Agreement with traditions already held is a candidate for independent attestation."@en .

pm:contactRouteUndecided a pm:ContactRoute ;
    rdfs:label "Contact route undecided"@en, "Kontaktweg unentschieden"@de ;
    skos:definition "The question has not been carried out. Registered explicitly rather than left absent, because an unstated contact route and a route shown to be absent are the difference between a witness and a candidate."@en .

pm:coverageState a owl:ObjectProperty ;
    rdfs:label "coverage state"@en ;
    rdfs:domain pm:Tradition ;
    rdfs:range pm:CoverageState ;
    skos:definition "How far the corpus of this tradition has been carried into the graph."@en .

pm:contactRoute a owl:ObjectProperty ;
    rdfs:label "contact route"@en ;
    rdfs:domain pm:Tradition ;
    rdfs:range pm:ContactRoute ;
    skos:definition "The state of the contact question between this tradition and those the graph already holds."@en .

pm:principalCorpus a owl:DatatypeProperty ;
    rdfs:label "principal corpus"@en ;
    rdfs:domain pm:Tradition ;
    skos:definition "The works in which this transmission is chiefly carried, named so that a later reader can find them."@en ;
    skos:note "Kept as the readable listing once a tradition names its works with pm:corpusWork. The literal is what a reader sees; the identifiers are what a query can join."@en ;
    skos:note "Deliberately not dcterms:source. A source carries a passage that was read, with its place and its edition; this names a corpus that was not read. Using dcterms:source here would let a registration claim a textual knowledge it does not have. The literature rule applies all the same: a work, never a URL."@en .

#
# Works as identifiers
#
# pm:principalCorpus and dcterms:source both name works, and both are
# literals. Nothing joins them: whether a named work has had a single passage
# entered could only be guessed by comparing strings, and the guess failed in
# both directions when it was measured (prima-materia#737). A tradition at
# pm:placesEntered therefore dropped out of every queue however many of its
# works were still unopened.
#
# The join is an identifier and nothing more. A work gets an IRI under
# works/, the tradition points at the works of its corpus, and every node
# that names a source points at the work that source is in. Whether a work of
# a corpus has been opened is then an exact query (queries/unopened-works.rq).
# How much of it has been read is deliberately not modelled: the graph holds no
# division of a work to count against, and one is added when a question needs
# it and not before.
#
# The work is typed dcterms:BibliographicResource and not with a class of this
# ontology. The class that dcterms:source already presupposes for its referent
# exists, and a pm: class for a book would either be a static substance class,
# which SPEC §3 forbids, or a gerund pretending a book is a process.
#
# Migration runs tradition by tradition. A tradition that names one work with
# pm:corpusWork is migrated, and from then on every node of it that names a
# source must say which work (pm:FromWorkRequiredShape). The traditions not yet
# migrated are themselves a query (queries/work-migration-backlog.rq), so the
# backlog needs no list.
#

pm:corpusWork a owl:ObjectProperty ;
    rdfs:label "corpus work"@en, "Korpuswerk"@de ;
    rdfs:domain pm:Tradition ;
    rdfs:range dcterms:BibliographicResource ;
    skos:definition "A work in which this transmission is chiefly carried, as an identifier. The identifier counterpart of pm:principalCorpus, which stays as the readable listing."@en ;
    skos:note "Says nothing about whether the work was read. That follows from whether any node points at the work with pm:fromWork."@en .

pm:fromWork a owl:ObjectProperty ;
    rdfs:label "from work"@en, "aus Werk"@de ;
    rdfs:range dcterms:BibliographicResource ;
    skos:definition "The work that a dcterms:source of this node lies in. A node whose sources lie in two works carries both."@en ;
    skos:note "It does not replace dcterms:source. The source keeps the passage and the edition; this carries only the identity of the work, which a literal cannot carry without a string comparison."@en .
